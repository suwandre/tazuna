{
  "tazuna_plugin": 1,
  "id": "cache-meter",
  "files": {
    "manifest.json": "{\n  \"title\": \"Cache meter\",\n  \"description\": \"How much of the conversation was read from the prompt cache, and each turn's share\",\n  \"slot\": \"rail\",\n  \"api\": 1\n}",
    "index.html": "<style>\n.big{font:600 20px/1.2 var(--font-mono);color:var(--ink)}\n.sub{color:var(--muted);font-size:11.5px;margin-top:2px}\n.bars{display:flex;align-items:flex-end;gap:2px;height:36px;margin-top:8px}\n.bars i{flex:1;max-width:10px;background:var(--accent);min-height:2px;border-radius:1px}\n.bars i.miss{background:var(--warn)}\n</style>\n<div class=\"big\" id=\"pct\">\u2013</div>\n<div class=\"sub\" id=\"note\">no turns yet</div>\n<div class=\"bars\" id=\"bars\" aria-hidden=\"true\"></div>\n<script>\nfunction draw(d) {\n  var u = d.session && d.session.usage, read = u ? u.input + u.cache_write + u.cache_read : 0;\n  document.getElementById(\"pct\").textContent = read ? Math.round(100 * u.cache_read / read) + \"% read from cache\" : \"\u2013\";\n  var t = d.turns || [];\n  document.getElementById(\"note\").textContent = t.length ? t.length + \" turns \u00b7 a bar each, orange: under half cached (re-sent at full price)\" : \"no turns yet\";\n  var b = document.getElementById(\"bars\");\n  b.innerHTML = \"\";\n  t.slice(-30).forEach(function (x) {\n    var c = x.cached == null ? 0 : x.cached, i = document.createElement(\"i\");\n    i.style.height = Math.max(2, Math.round(36 * c)) + \"px\";\n    if (c < 0.5) i.className = \"miss\";\n    i.title = Math.round(100 * c) + \"% cached \u00b7 $\" + x.cost.toFixed(4);\n    b.appendChild(i);\n  });\n  parent.postMessage({ type: \"tazuna-height\", height: document.body.scrollHeight + 4 }, \"*\");\n}\nwindow.addEventListener(\"message\", function (e) { if (e.data && e.data.type === \"tazuna\" && e.data.data) draw(e.data.data); });\n</script>\n"
  }
}
