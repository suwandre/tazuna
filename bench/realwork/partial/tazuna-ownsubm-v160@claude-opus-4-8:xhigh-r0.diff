+// writeZipWithSymlink builds a zip file with symlinks for testing
+func writeZipWithSymlink(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+
+	// Create a regular file
+	w, err := zw.Create("file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file content"))
+	require.NoError(t, err)
+
+	// Create a symlink entry
+	// In ZIP format, symlinks are stored with the link target as content
+	fh := &zip.FileHeader{
+		Name:   "link.txt",
+		Method: zip.Store,
+	}
+	fh.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(fh)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// Symlinks without --links flag should be skipped
+func TestSymlinkSkippedWithoutFlag(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipWithSymlink(t, dir, "test.zip")
+
+	// Make sure --links is not set
+	ci := fs.GetConfig(ctx)
+	oldLinks := ci.Links
+	ci.Links = false
+	defer func() { ci.Links = oldLinks }()
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	remotes := allRemotes(t, f)
+	// Only the regular file should be listed
+	assert.Equal(t, []string{"file.txt"}, remotes)
+}
