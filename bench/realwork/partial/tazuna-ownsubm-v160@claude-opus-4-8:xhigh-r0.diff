+// Symlinks without --links flag should be skipped
+func TestSymlinkSkippedWithoutFlag(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	// Make sure --links is not set
+	ci := fs.GetConfig(ctx)
+	oldLinks := ci.Links
+	ci.Links = false
+	defer func() { ci.Links = oldLinks }()
+
+	f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	// Only the regular file should be listed
+	require.Len(t, entries, 1)
+	assert.Equal(t, "file.txt", entries[0].Remote())
+}
+
+// Symlinks with --links flag should be listed with .rclonelink suffix
+func TestSymlinkWithFlag(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	// Enable --links flag
+	ci := fs.GetConfig(ctx)
+	oldLinks := ci.Links
+	ci.Links = true
+	defer func() { ci.Links = oldLinks }()
+
+	f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	// Both the file and symlink should be listed
+	require.Len(t, entries, 2)
+
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.Contains(t, remotes, "file.txt")
+	assert.Contains(t, remotes, "link.txt.rclonelink")
+
+	// Check that NewObject can find the symlink
+	obj, err := f.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "link.txt.rclonelink", obj.Remote())
+	// The size should be the length of the link target
+	assert.Equal(t, int64(8), obj.Size()) // len("file.txt")
+
+	// Open the symlink and read its content (the target path)
+	rc, err := obj.Open(ctx)
+	require.NoError(t, err)
+	defer rc.Close()
+	content, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", string(content))
+}
+
+// Looking up a symlink without .rclonelink suffix should fail
+func TestSymlinkLookupWithoutSuffix(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	// Enable --links flag
+	ci := fs.GetConfig(ctx)
+	oldLinks := ci.Links
+	ci.Links = true
+	defer func() { ci.Links = oldLinks }()
+
+	f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+
+	// Looking up the symlink without suffix should fail
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.Equal(t, fs.ErrorObjectNotFound, err)
+}
