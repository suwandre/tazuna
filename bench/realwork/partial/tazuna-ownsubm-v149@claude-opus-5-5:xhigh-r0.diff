 	_ fs.Fs        = (*Fs)(nil)
 	_ fs.UnWrapper = (*Fs)(nil)
 	_ fs.Wrapper   = (*Fs)(nil)
 	_ fs.Object    = (*Object)(nil)
+	_ fs.Object    = (*LinkObject)(nil)
 )
