+// Convert a FileInfo into a LinkObject from native dir
+func (f *Fs) linkObjectFromFileInfo(nativeDir string, item os.FileInfo) *LinkObject {
+	nativePath := path.Join(nativeDir, item.Name())
+	// For squashfs symlinks, the file content is the target path
+	// Read it to get the actual size
+	size := item.Size()
+	if fh, err := f.sqfs.OpenFile(toIOFS(nativePath), os.O_RDONLY); err == nil {
+		if targetBytes, err := io.ReadAll(fh); err == nil {
+			size = int64(len(targetBytes))
+		}
+		fh.Close()
+	}
+	return &LinkObject{
+		fs:         f,
+		remote:     f.fromNative(nativeDir, item.Name()) + fs.LinkSuffix,
+		size:       size,
+		modTime:    item.ModTime(),
+		nativePath: nativePath,
+	}
+}
