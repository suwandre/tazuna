+// Test symlink with range/seek options
+func TestReadZipSymlinkRangeSeek(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	
+	linkHeader := &zip.FileHeader{
+		Name:   "link.txt",
+		Method: zip.Deflate,
+	}
+	linkHeader.SetMode(os.ModeSymlink | 0o755)
+	w, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("target/path"))
+	require.NoError(t, err)
+	
+	require.NoError(t, zw.Close())
+	name := "test.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	
+	obj, err := f.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	
+	// Test with SeekOption
+	rc, err := obj.Open(ctx, &fs.SeekOption{Offset: 7})
+	require.NoError(t, err)
+	content, err := io.ReadAll(rc)
+	rc.Close()
+	require.NoError(t, err)
+	assert.Equal(t, "path", string(content))
+	
+	// Test with RangeOption
+	rc, err = obj.Open(ctx, &fs.RangeOption{Start: 0, End: 5})
+	require.NoError(t, err)
+	content, err = io.ReadAll(rc)
+	rc.Close()
+	require.NoError(t, err)
+	assert.Equal(t, "target", string(content))
+}
