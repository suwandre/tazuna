+// Test that a regular file with .rclonelink in its name stays a regular file
+func TestReadZipRclonelinkInName(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	
+	// Create a zip with a regular file named "test.rclonelink"
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	
+	w, err := zw.CreateHeader(&zip.FileHeader{
+		Name:   "test.rclonelink",
+		Method: zip.Deflate,
+	})
+	require.NoError(t, err)
+	_, err = w.Write([]byte("regular file content"))
+	require.NoError(t, err)
+	
+	require.NoError(t, zw.Close())
+	name := "test.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	
+	remotes := allRemotes(t, f)
+	assert.Equal(t, []string{"test.rclonelink"}, remotes)
+	
+	// Verify it's treated as a regular file
+	obj, err := f.NewObject(ctx, "test.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(20), obj.Size())
+	
+	rc, err := obj.Open(ctx)
+	require.NoError(t, err)
+	defer rc.Close()
+	
+	content, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	assert.Equal(t, "regular file content", string(content))
+}
