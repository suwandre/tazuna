+// Test that hostile archives (symlinks pointing outside the archive)
+// are handled safely
+func TestReadZipHostileSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	
+	// Create a zip with a symlink pointing outside the archive
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	
+	// Regular file
+	w, err := zw.CreateHeader(&zip.FileHeader{
+		Name:   "file.txt",
+		Method: zip.Deflate,
+	})
+	require.NoError(t, err)
+	_, err = w.Write([]byte("safe content"))
+	require.NoError(t, err)
+	
+	// Symlink pointing outside the archive (absolute path)
+	linkHeader := &zip.FileHeader{
+		Name:   "evil.txt",
+		Method: zip.Deflate,
+	}
+	linkHeader.SetMode(os.ModeSymlink | 0o755)
+	w, err = zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("/etc/passwd"))
+	require.NoError(t, err)
+	
+	// Symlink pointing outside using ..
+	linkHeader2 := &zip.FileHeader{
+		Name:   "evil2.txt",
+		Method: zip.Deflate,
+	}
+	linkHeader2.SetMode(os.ModeSymlink | 0o755)
+	w, err = zw.CreateHeader(linkHeader2)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("../../../../etc/passwd"))
+	require.NoError(t, err)
+	
+	require.NoError(t, zw.Close())
+	name := "hostile.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	
+	remotes := allRemotes(t, f)
+	// The symlinks should be listed with .rclonelink suffix
+	assert.Contains(t, remotes, "evil.txt.rclonelink")
+	assert.Contains(t, remotes, "evil2.txt.rclonelink")
+	
+	// Verify the symlink targets are preserved as-is (not sanitized)
+	// This is correct because the symlink target is stored verbatim
+	// and the safety check happens when the symlink is dereferenced
+	obj, err := f.NewObject(ctx, "evil.txt.rclonelink")
+	require.NoError(t, err)
+	rc, err := obj.Open(ctx)
+	require.NoError(t, err)
+	defer rc.Close()
+	target, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	assert.Equal(t, "/etc/passwd", string(target))
+	
+	obj2, err := f.NewObject(ctx, "evil2.txt.rclonelink")
+	require.NoError(t, err)
+	rc2, err := obj2.Open(ctx)
+	require.NoError(t, err)
+	defer rc2.Close()
+	target2, err := io.ReadAll(rc2)
+	require.NoError(t, err)
+	assert.Equal(t, "../../../../etc/passwd", string(target2))
+	
+	// The actual safety is in the local backend when writing
+	// symlinks with rclone copy --links. The archive backend
+	// correctly exposes the symlink targets as stored in the archive.
+}
