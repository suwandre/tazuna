+// Test symlink handling with --links flag
+func TestReadZipSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	
+	// Create a zip with a regular file and a symlink
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	
+	// Regular file
+	w, err := zw.CreateHeader(&zip.FileHeader{
+		Name:   "file.txt",
+		Method: zip.Deflate,
+	})
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file content"))
+	require.NoError(t, err)
+	
+	// Symlink to file.txt
+	linkHeader := &zip.FileHeader{
+		Name:   "link.txt",
+		Method: zip.Deflate,
+	}
+	// Set the symlink mode (0o120755)
+	linkHeader.SetMode(os.ModeSymlink | 0o755)
+	w, err = zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+	
+	require.NoError(t, zw.Close())
+	name := "test.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	
+	// Test without --links: symlinks should be skipped
+	t.Run("WithoutLinks", func(t *testing.T) {
+		// Reset config to ensure --links is false
+		ctx, ci := fs.AddConfig(ctx)
+		ci.Links = false
+		
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		
+		remotes := allRemotes(t, f)
+		assert.Equal(t, []string{"file.txt"}, remotes)
+	})
+	
+	// Test with --links: symlinks should be included with .rclonelink suffix
+	t.Run("WithLinks", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(ctx)
+		ci.Links = true
+		
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		
+		remotes := allRemotes(t, f)
+		assert.Equal(t, []string{"file.txt", "link.txt.rclonelink"}, remotes)
+		
+		// Verify the symlink object can be opened and contains the target
+		obj, err := f.NewObject(ctx, "link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(8), obj.Size()) // "file.txt" is 8 bytes
+		
+		rc, err := obj.Open(ctx)
+		require.NoError(t, err)
+		defer rc.Close()
+		
+		target, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", string(target))
+	})
+}
