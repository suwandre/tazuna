+// TestHead_WALMultiRef_ReplayKeepsChunksOfMergedSeries checks that m-mapped chunks
+// written for a series whose duplicate WAL refs were merged by an earlier replay
+// survive the next replay.
+func TestHead_WALMultiRef_ReplayKeepsChunksOfMergedSeries(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		// Whether the second ref has an m-mapped in-order chunk on disk.
+		mmapSecondRef bool
+	}{
+		{name: "second ref without m-mapped chunks"},
+		{name: "second ref with m-mapped chunks", mmapSecondRef: true},
+	} {
+		for name, scenario := range sampleTypeScenarios {
+			t.Run(tc.name+"/"+name, func(t *testing.T) {
+				dir := t.TempDir()
+				lset := labels.FromStrings("foo", "bar")
+				// Mimics the DB, which initialises the head with the max time of the last block.
+				const minValidTime = 1600
+
+				opts := DefaultHeadOptions()
+				opts.ChunkRange = 1000
+				opts.ChunkDirRoot = dir
+				opts.OutOfOrderCapMax.Store(4)
+				opts.OutOfOrderTimeWindow.Store(10000)
+
+				openHead := func(minValidTime int64) *Head {
+					wal, err := wlog.New(nil, nil, filepath.Join(dir, "wal"), compression.None)
+					require.NoError(t, err)
+					wbl, err := wlog.New(nil, nil, filepath.Join(dir, wlog.WblDirName), compression.None)
+					require.NoError(t, err)
+					h, err := NewHead(nil, nil, wal, wbl, opts, nil)
+					require.NoError(t, err)
+					require.NoError(t, h.Init(minValidTime))
+					return h
+				}
+				var expSamples []chunks.Sample
+				appendSample := func(h *Head, ts int64, expected bool) storage.SeriesRef {
+					app := h.Appender(context.Background())
+					ref, s, err := scenario.appendFunc(app, lset, ts, ts)
+					require.NoError(t, err)
+					require.NoError(t, app.Commit())
+					if expected {
+						expSamples = append(expSamples, s)
+					}
+					return ref
+				}
+
+				// The first ref is m-mapped, then truncated out of the head as if compacted.
+				h := openHead(0)
+				ref1 := appendSample(h, 100, false)
+				appendSample(h, 1500, false)
+				require.NoError(t, h.Truncate(minValidTime))
+
+				// The same labels are recreated under a second ref.
+				ref2 := appendSample(h, 1700, true)
+				require.NotEqual(t, ref1, ref2)
+				if tc.mmapSecondRef {
+					appendSample(h, 2100, true)
+				}
+				require.NoError(t, h.Close())
+
+				// The replay merges both refs onto the first one. Write in-order and
+				// out-of-order m-mapped chunks under the live ref.
+				h = openHead(minValidTime)
+				appendSample(h, 3500, true)
+				for ts := int64(2200); ts < 3200; ts += 100 {
+					appendSample(h, ts, true)
+				}
+				require.Positive(t, prom_testutil.ToFloat64(h.metrics.chunks))
+				require.NoError(t, h.Close())
+
+				slices.SortFunc(expSamples, func(a, b chunks.Sample) int { return int(a.T() - b.T()) })
+				// Replay twice to also check that the replay did not write
+				// overlapping chunks that break the next replay.
+				for range 2 {
+					h = openHead(minValidTime)
+					require.Equal(t, 0.0, prom_testutil.ToFloat64(h.metrics.mmapChunkCorruptionTotal))
+
+					q, err := NewBlockQuerier(NewRangeHead(h, 0, 5000), 0, 5000)
+					require.NoError(t, err)
+					q = NewHeadAndOOOQuerier(0, 0, 5000, h, h.oooIso.TrackReadAfter(0), q)
+					series := query(t, q, labels.MustNewMatcher(labels.MatchEqual, "foo", "bar"))
+					requireEqualSamples(t, lset.String(), expSamples, series[lset.String()], requireEqualSamplesIgnoreCounterResets)
+					require.NoError(t, h.Close())
+				}
+			})
+		}
+	}
+}
