+// TestHead_WALMultiRef_KeepsMmappedChunksOfLiveRef verifies that when WAL replay
+// resolves a duplicate series record onto the live series, the chunks m-mapped under
+// the live ref after an earlier replay merged the refs are preserved.
+func TestHead_WALMultiRef_KeepsMmappedChunksOfLiveRef(t *testing.T) {
+	for name, scenario := range sampleTypeScenarios {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			opts := DefaultHeadOptions()
+			opts.ChunkRange = 1000
+			opts.ChunkDirRoot = dir
+			opts.OutOfOrderCapMax.Store(4)
+			opts.OutOfOrderTimeWindow.Store(1000 * time.Minute.Milliseconds())
+
+			openHead := func() *Head {
+				wal, err := wlog.New(nil, nil, filepath.Join(dir, "wal"), compression.None)
+				require.NoError(t, err)
+				wbl, err := wlog.New(nil, nil, filepath.Join(dir, wlog.WblDirName), compression.None)
+				require.NoError(t, err)
+				h, err := NewHead(nil, nil, wal, wbl, opts, nil)
+				require.NoError(t, err)
+				require.NoError(t, h.Init(0))
+				return h
+			}
+
+			lset := labels.FromStrings("foo", "bar")
+			appendSamples := func(h *Head, tss ...int64) storage.SeriesRef {
+				var ref storage.SeriesRef
+				for _, ts := range tss {
+					app := h.Appender(context.Background())
+					var err error
+					ref, _, err = scenario.appendFunc(app, lset, ts, ts)
+					require.NoError(t, err)
+					require.NoError(t, app.Commit())
+				}
+				return ref
+			}
+			queryTimestamps := func(h *Head) []int64 {
+				qHead, err := NewBlockQuerier(h, math.MinInt64, math.MaxInt64)
+				require.NoError(t, err)
+				q := NewHeadAndOOOQuerier(math.MinInt64, math.MinInt64, math.MaxInt64, h, h.oooIso.TrackReadAfter(0), qHead)
+				var tss []int64
+				for _, s := range query(t, q, labels.MustNewMatcher(labels.MatchEqual, "foo", "bar"))[lset.String()] {
+					tss = append(tss, s.T())
+				}
+				return tss
+			}
+
+			// Garbage collect the series and recreate it under a new ref, keeping both
+			// series records in the WAL.
+			h := openHead()
+			ref1 := appendSamples(h, 100, 1500)
+			require.NoError(t, h.Truncate(1600))
+			ref2 := appendSamples(h, 1700, 2000)
+			require.NotEqual(t, ref1, ref2)
+			require.NoError(t, h.Close())
+
+			// The replay merges both refs onto the series with ref1. M-map in-order and
+			// out-of-order chunks under ref1.
+			h = openHead()
+			require.Equal(t, []int64{1700, 2000}, queryTimestamps(h))
+			appendSamples(h, 2100, 3100, 4100)
+			oooTss := []int64{1710, 1720, 1730, 1740, 1750, 1760, 1770, 1780, 1790}
+			appendSamples(h, oooTss...)
+			ms := h.series.getByID(chunks.HeadSeriesRef(ref1))
+			require.NotNil(t, ms)
+			require.NotEmpty(t, ms.mmappedChunks)
+			require.NotEmpty(t, ms.ooo.oooMmappedChunks)
+			require.NoError(t, h.Close())
+
+			expected := []int64{1700, 1710, 1720, 1730, 1740, 1750, 1760, 1770, 1780, 1790, 2000, 2100, 3100, 4100}
+			for range 2 {
+				h = openHead()
+				require.Equal(t, expected, queryTimestamps(h))
+				require.Equal(t, 0.0, prom_testutil.ToFloat64(h.metrics.mmapChunkCorruptionTotal))
+				require.NoError(t, h.Close())
+			}
+		})
+	}
+}
