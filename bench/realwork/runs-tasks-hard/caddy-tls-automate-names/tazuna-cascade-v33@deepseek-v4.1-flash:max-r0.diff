diff --git a/caddytest/integration/caddyfile_adapt/tls_automate_names.caddyfiletest b/caddytest/integration/caddyfile_adapt/tls_automate_names.caddyfiletest
new file mode 100644
index 0000000..b5df6b4
--- /dev/null
+++ b/caddytest/integration/caddyfile_adapt/tls_automate_names.caddyfiletest
@@ -0,0 +1,77 @@
+{
+	email nobody@example.com
+	tls_automate_names *.example.com
+}
+
+foo.example.com {
+	respond "Hello world"
+}
+----------
+{
+	"apps": {
+		"http": {
+			"servers": {
+				"srv0": {
+					"listen": [
+						":443"
+					],
+					"routes": [
+						{
+							"match": [
+								{
+									"host": [
+										"foo.example.com"
+									]
+								}
+							],
+							"handle": [
+								{
+									"handler": "subroute",
+									"routes": [
+										{
+											"handle": [
+												{
+													"body": "Hello world",
+													"handler": "static_response"
+												}
+											]
+										}
+									]
+								}
+							],
+							"terminal": true
+						}
+					]
+				}
+			}
+		},
+		"tls": {
+			"certificates": {
+				"automate": [
+					"*.example.com"
+				]
+			},
+			"automation": {
+				"policies": [
+					{
+						"subjects": [
+							"foo.example.com",
+							"*.example.com"
+						],
+						"issuers": [
+							{
+								"email": "nobody@example.com",
+								"module": "acme"
+							},
+							{
+								"ca": "https://acme.zerossl.com/v2/DV90",
+								"email": "nobody@example.com",
+								"module": "acme"
+							}
+						]
+					}
+				]
+			}
+		}
+	}
+}
