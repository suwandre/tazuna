@@ -513,6 +539,86 @@ func (st ServerType) buildTLSApp(
 
 type acmeCapable interface{ GetACMEIssuer() *caddytls.ACMEIssuer }
 
+// buildTLSAutomateNamesPolicies returns the automation policies for the
+// names in the tls_automate_names global option which are not already
+// subjects of an automation policy in tlsApp. The policies are built the
+// same way as for a site block with those names: global options apply,
+// and names that don't qualify for a public certificate get the internal
+// issuer (unless an issuer is configured globally).
+func buildTLSAutomateNamesPolicies(
+	tlsApp *caddytls.TLS,
+	options map[string]any,
+	warnings []caddyconfig.Warning,
+) ([]*caddytls.AutomationPolicy, error) {
+	names, ok := options["tls_automate_names"].([]string)
+	if !ok || len(names) == 0 {
+		return nil, nil
+	}
+
+	existingSubjects := make(map[string]struct{})
+	if tlsApp.Automation != nil {
+		for _, ap := range tlsApp.Automation.Policies {
+			for _, s := range ap.SubjectsRaw {
+				existingSubjects[strings.ToLower(s)] = struct{}{}
+			}
+		}
+	}
+
+	var subjects []string
+	for _, name := range names {
+		name = strings.ToLower(name)
+		if _, ok := existingSubjects[name]; ok || slices.Contains(subjects, name) {
+			continue
+		}
+		if !certmagic.SubjectQualifiesForCert(name) {
+			return nil, fmt.Errorf("tls_automate_names: subject does not qualify for certificate: '%s'", name)
+		}
+		subjects = append(subjects, name)
+	}
+	if len(subjects) == 0 {
+		return nil, nil
+	}
+	sort.Strings(subjects) // solely for deterministic test results
+
+	ap, err := newBaseAutomationPolicy(options, warnings, true)
+	if err != nil {
+		return nil, err
+	}
+	if renewalWindowRatio, ok := options["renewal_window_ratio"].(float64); ok {
+		ap.RenewalWindowRatio = renewalWindowRatio
+	}
+	ap.SubjectsRaw = subjects
+
+	// with no issuer configured, separate out the names that can't get
+	// a publicly-trusted certificate so that they use the internal issuer;
+	// unlike with site blocks, auto-HTTPS won't see these names, so the
+	// internal issuer has to be set explicitly
+	if len(ap.Issuers) > 0 {
+		return []*caddytls.AutomationPolicy{ap}, nil
+	}
+	var internal, external []string
+	for _, s := range subjects {
+		if isTailscaleDomain(s) || subjectQualifiesForPublicCert(ap, s) {
+			external = append(external, s)
+		} else {
+			internal = append(internal, s)
+		}
+	}
+	internalIssuer := []json.RawMessage{json.RawMessage(`{"module":"internal"}`)}
+	if len(external) == 0 {
+		ap.IssuersRaw = internalIssuer
+		return []*caddytls.AutomationPolicy{ap}, nil
+	}
+	if len(internal) == 0 {
+		return []*caddytls.AutomationPolicy{ap}, nil
+	}
+	ap.SubjectsRaw = external
+	internalAP := *ap
+	internalAP.SubjectsRaw = internal
+	internalAP.IssuersRaw = internalIssuer
+	return []*caddytls.AutomationPolicy{ap, &internalAP}, nil
+}
