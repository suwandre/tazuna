+func TestGlobalTLSAutomateNamesOption(t *testing.T) {
+	type tlsOutput struct {
+		Apps struct {
+			HTTP json.RawMessage `json:"http"`
+			TLS  struct {
+				Certificates map[string]json.RawMessage `json:"certificates"`
+				Automation   json.RawMessage            `json:"automation"`
+			} `json:"tls"`
+		} `json:"apps"`
+	}
+	adapt := func(input string) (tlsOutput, error) {
+		var out tlsOutput
+		adapter := caddyfile.Adapter{ServerType: ServerType{}}
+		b, _, err := adapter.Adapt([]byte(input), nil)
+		if err != nil {
+			return out, err
+		}
+		err = json.Unmarshal(b, &out)
+		return out, err
+	}
+
+	for i, tc := range []struct {
+		input string
+		// equivalent config using a site block instead; when set, the
+		// automation policies must be the same
+		equivalent     string
+		expectAutomate string
+		expectHTTP     bool
+		expectError    bool
+	}{
+		{
+			input: `{
+				email nobody@example.com
+				tls_automate_names *.example.com
+			}
+			foo.example.com {
+				respond "Real site"
+			}`,
+			equivalent: `{
+				email nobody@example.com
+			}
+			*.example.com {
+			}
+			foo.example.com {
+				respond "Real site"
+			}`,
+			expectAutomate: `["*.example.com"]`,
+			expectHTTP:     true,
+		},
+		{
+			input: `{
+				tls_automate_names b.example.com a.example.com
+				tls_automate_names c.example.com A.example.com
+			}`,
+			expectAutomate: `["a.example.com","b.example.com","c.example.com"]`,
+		},
+		{
+			input: `{
+				key_type p256
+				tls_automate_names example.com
+			}
+			http://example.com {
+			}`,
+			equivalent: `{
+				key_type p256
+			}
+			https://example.com {
+			}`,
+			expectAutomate: `["example.com"]`,
+			expectHTTP:     true,
+		},
+		{
+			input: `{
+				tls_automate_names example.com
+			}
+			example.com {
+				tls {
+					key_type rsa2048
+				}
+			}`,
+			equivalent: `example.com {
+				tls {
+					key_type rsa2048
+				}
+			}`,
+			expectAutomate: `["example.com"]`,
+			expectHTTP:     true,
+		},
+		{
+			input: `{
+				tls_automate_names
+			}`,
+			expectError: true,
+		},
+	} {
+		actual, err := adapt(tc.input)
+		if tc.expectError {
+			if err == nil {
+				t.Errorf("Test %d: expected error but got none", i)
+			}
+			continue
+		}
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if got := string(actual.Apps.TLS.Certificates["automate"]); got != tc.expectAutomate {
+			t.Errorf("Test %d: expected automated names %s, got %s", i, tc.expectAutomate, got)
+		}
+		if hasHTTP := actual.Apps.HTTP != nil; hasHTTP != tc.expectHTTP {
+			t.Errorf("Test %d: expected http app: %v, got: %v", i, tc.expectHTTP, hasHTTP)
+		}
+		if tc.equivalent == "" {
+			continue
+		}
+		expected, err := adapt(tc.equivalent)
+		if err != nil {
+			t.Errorf("Test %d: unexpected error adapting equivalent config: %v", i, err)
+			continue
+		}
+		if string(actual.Apps.TLS.Automation) != string(expected.Apps.TLS.Automation) {
+			t.Errorf("Test %d: expected automation %s, got %s", i, expected.Apps.TLS.Automation, actual.Apps.TLS.Automation)
+		}
+	}
+}
