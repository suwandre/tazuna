+// parseOptTLSAutomateNames parses the tls_automate_names global option.
+// Repeating the option appends to the list of names. Syntax:
+//
+//	tls_automate_names <names...>
+func parseOptTLSAutomateNames(d *caddyfile.Dispenser, existing any) (any, error) {
+	d.Next() // consume option name
+	names := d.RemainingArgs()
+	if len(names) == 0 {
+		return nil, d.ArgErr()
+	}
+	if d.NextBlock(0) {
+		return nil, d.Err("tls_automate_names does not accept a block")
+	}
+	existingNames, _ := existing.([]string)
+	return append(existingNames, names...), nil
+}
