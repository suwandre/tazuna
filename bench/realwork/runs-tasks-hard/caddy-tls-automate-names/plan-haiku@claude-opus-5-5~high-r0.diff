+	// names configured with the tls_automate_names global option are
+	// automated just like the names of a site block, but without a route;
+	// if a name already has an automation policy (from its site block),
+	// that policy wins and we only make sure the name gets automated
+	if automateNames, ok := options["tls_automate_names"].([]string); ok {
+		ap, err := newBaseAutomationPolicy(options, warnings, true)
+		if err != nil {
+			return nil, warnings, err
+		}
+		subjectsWithAP := make(map[string]struct{})
+		if tlsApp.Automation != nil {
+			for _, existingAP := range tlsApp.Automation.Policies {
+				for _, s := range existingAP.SubjectsRaw {
+					subjectsWithAP[s] = struct{}{}
+				}
+			}
+		}
+		for _, s := range internalAP.SubjectsRaw {
+			subjectsWithAP[s] = struct{}{}
+		}
+		var external, internal []string
+		for _, name := range automateNames {
+			if !certmagic.SubjectQualifiesForCert(name) {
+				return nil, warnings, fmt.Errorf("tls_automate_names: subject does not qualify for certificate: '%s'", name)
+			}
+			if !slices.Contains(al, name) {
+				al = append(al, name)
+			}
+			if _, ok := subjectsWithAP[name]; ok {
+				continue
+			}
+			subjectsWithAP[name] = struct{}{}
+			// unlike names of a site block, these names won't get the internal
+			// issuer implicitly from the HTTP app, so we must set it explicitly
+			if len(ap.Issuers) == 0 && !isTailscaleDomain(name) && !subjectQualifiesForPublicCert(ap, name) {
+				internal = append(internal, name)
+			} else {
+				external = append(external, name)
+			}
+		}
+		if len(external) > 0 || len(internal) > 0 {
+			if tlsApp.Automation == nil {
+				tlsApp.Automation = new(caddytls.AutomationConfig)
+			}
+		}
+		if len(internal) > 0 {
+			internalNamesAP := *ap
+			internalNamesAP.SubjectsRaw = internal
+			internalNamesAP.IssuersRaw = []json.RawMessage{caddyconfig.JSONModuleObject(caddytls.InternalIssuer{}, "module", "internal", &warnings)}
+			tlsApp.Automation.Policies = append(tlsApp.Automation.Policies, &internalNamesAP)
+		}
+		if len(external) > 0 {
+			ap.SubjectsRaw = external
+			tlsApp.Automation.Policies = append(tlsApp.Automation.Policies, ap)
+		}
+	}
 	slices.Sort(al) // to stabilize the adapt output
 	if len(al) > 0 {
 		tlsApp.CertificatesRaw["automate"] = caddyconfig.JSON(al, &warnings)
