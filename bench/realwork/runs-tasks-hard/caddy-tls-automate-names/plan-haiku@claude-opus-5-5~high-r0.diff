+func parseOptTLSAutomateNames(d *caddyfile.Dispenser, existing any) (any, error) {
+	d.Next() // consume option name
+	var names []string
+	if existing != nil {
+		names = existing.([]string)
+	}
+	args := d.RemainingArgs()
+	if len(args) == 0 {
+		return nil, d.ArgErr()
+	}
+	for _, name := range args {
+		names = append(names, strings.ToLower(name))
+	}
+	return names, nil
+}
