 package httpcaddyfile
 
 import (
+	"encoding/json"
+	"strings"
 	"testing"
 
 	"github.com/caddyserver/caddy/v2/caddyconfig/caddyfile"
 	"github.com/caddyserver/caddy/v2/modules/caddytls"
 )
 
+func TestTLSAutomateNamesMatchesDummySiteBlock(t *testing.T) {
+	adaptTLSApp := func(input string) map[string]json.RawMessage {
+		t.Helper()
+		adapter := caddyfile.Adapter{ServerType: ServerType{}}
+		out, _, err := adapter.Adapt([]byte(input), nil)
+		if err != nil {
+			t.Fatalf("adapting Caddyfile: %v", err)
+		}
+		var cfg struct {
+			Apps map[string]json.RawMessage `json:"apps"`
+		}
+		if err := json.Unmarshal(out, &cfg); err != nil {
+			t.Fatalf("unmarshaling adapted config: %v", err)
+		}
+		var tlsApp map[string]json.RawMessage
+		if err := json.Unmarshal(cfg.Apps["tls"], &tlsApp); err != nil {
+			t.Fatalf("unmarshaling tls app: %v", err)
+		}
+		return tlsApp
+	}
+
+	withDummySite := adaptTLSApp(`{
+	email nobody@example.com
+}
+
+*.example.com {
+}
+
+foo.example.com {
+	respond "Real site"
+}
+`)
+	withOption := adaptTLSApp(`{
+	email nobody@example.com
+	tls_automate_names *.example.com
+}
+
+foo.example.com {
+	respond "Real site"
+}
+`)
+
+	if string(withOption["automation"]) != string(withDummySite["automation"]) {
+		t.Errorf("expected automation config %s, got %s", withDummySite["automation"], withOption["automation"])
+	}
+	if expected := `["*.example.com"]`; !strings.Contains(string(withOption["certificates"]), expected) {
+		t.Errorf("expected automate loader to contain %s, got %s", expected, withOption["certificates"])
+	}
+}
+
+func TestTLSAutomateNamesRequiresArgs(t *testing.T) {
+	adapter := caddyfile.Adapter{ServerType: ServerType{}}
+	_, _, err := adapter.Adapt([]byte("{\n\ttls_automate_names\n}\n"), nil)
+	if err == nil {
+		t.Fatal("expected error for tls_automate_names without arguments")
+	}
+}
