+func TestTLSAutomateNamesGlobalOption(t *testing.T) {
+	for i, tc := range []struct {
+		input   string
+		tls     string // expected compact JSON of the tls app
+		hasHTTP bool
+		wantErr bool
+	}{
+		{
+			// no site blocks: only the tls app; empty default policy is dropped
+			input: "{\n\ttls_automate_names example.com\n}\n",
+			tls:   `{"certificates":{"automate":["example.com"]}}`,
+		},
+		{
+			// repeated option appends; names are lowercased and deduplicated;
+			// internal names get the internal issuer
+			input: "{\n\ttls_automate_names example.com localhost 127.0.0.1\n\ttls_automate_names Example.com\n}\n",
+			tls:   `{"certificates":{"automate":["127.0.0.1","example.com","localhost"]},"automation":{"policies":[{"subjects":["127.0.0.1","localhost"],"issuers":[{"module":"internal"}]}]}}`,
+		},
+		{
+			// global email applies; names with an http:// site block are still
+			// automated and get a policy; auto_https off still lists the names
+			input:   "{\n\temail a@b.c\n\tauto_https off\n\ttls_automate_names example.com localhost\n}\nhttp://example.com {\n}\nb.example.com {\n\ttls internal\n}\n",
+			tls:     `{"certificates":{"automate":["example.com","localhost"]},"automation":{"policies":[{"subjects":["b.example.com","localhost"],"issuers":[{"module":"internal"}]},{"subjects":["example.com"],"issuers":[{"email":"a@b.c","module":"acme"},{"ca":"https://acme.zerossl.com/v2/DV90","email":"a@b.c","module":"acme"}]}]}}`,
+			hasHTTP: true,
+		},
+		{
+			// a site block's own TLS settings win for a listed name
+			input:   "{\n\ttls_automate_names b.example.com c.example.com\n}\nb.example.com {\n\ttls {\n\t\tissuer acme {\n\t\t\tdir https://ca.example.net/dir\n\t\t}\n\t}\n}\n",
+			tls:     `{"certificates":{"automate":["b.example.com","c.example.com"]},"automation":{"policies":[{"subjects":["b.example.com"],"issuers":[{"ca":"https://ca.example.net/dir","module":"acme"}]}]}}`,
+			hasHTTP: true,
+		},
+		{
+			input:   "{\n\ttls_automate_names\n}\n",
+			wantErr: true,
+		},
+	} {
+		adapter := caddyfile.Adapter{ServerType: ServerType{}}
+		out, _, err := adapter.Adapt([]byte(tc.input), nil)
+		if tc.wantErr {
+			if err == nil {
+				t.Errorf("Test %d: expected error but got none", i)
+			}
+			continue
+		}
+		if err != nil {
+			t.Fatalf("Test %d: adapting Caddyfile: %v", i, err)
+		}
+		var cfg struct {
+			Apps map[string]json.RawMessage `json:"apps"`
+		}
+		if err := json.Unmarshal(out, &cfg); err != nil {
+			t.Fatalf("Test %d: unmarshaling adapted config: %v", i, err)
+		}
+		if _, ok := cfg.Apps["http"]; ok != tc.hasHTTP {
+			t.Errorf("Test %d: expected http app present=%v, got %v", i, tc.hasHTTP, ok)
+		}
+		if got := string(cfg.Apps["tls"]); got != tc.tls {
+			t.Errorf("Test %d: expected tls app:\n%s\ngot:\n%s", i, tc.tls, got)
+		}
+	}
+}
