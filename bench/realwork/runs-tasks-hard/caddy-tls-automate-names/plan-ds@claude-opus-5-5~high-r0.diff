+func parseOptTLSAutomateNames(d *caddyfile.Dispenser, existingVal any) (any, error) {
+	d.Next() // consume option name
+	names := d.RemainingArgs()
+	if len(names) == 0 {
+		return nil, d.ArgErr()
+	}
+	for i := range names {
+		names[i] = strings.ToLower(names[i])
+	}
+	if existing, ok := existingVal.([]string); ok {
+		names = append(slices.Clone(existing), names...)
+	}
+	return names, nil
+}
