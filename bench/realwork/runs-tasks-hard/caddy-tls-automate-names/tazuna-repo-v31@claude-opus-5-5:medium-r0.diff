diff --git a/caddyconfig/httpcaddyfile/options_test.go b/caddyconfig/httpcaddyfile/options_test.go
index 50b431d..7af558f 100644
--- a/caddyconfig/httpcaddyfile/options_test.go
+++ b/caddyconfig/httpcaddyfile/options_test.go
@@ -2,6 +2,7 @@ package httpcaddyfile
 
 import (
 	"encoding/json"
+	"slices"
 	"testing"
 	"time"
 
@@ -291,3 +292,61 @@ func TestMergeACMEIssuers(t *testing.T) {
 		t.Fatalf("expected base roots to remain unchanged, got %v", base.TrustedRootsPEMFiles)
 	}
 }
+
+func TestGlobalTLSAutomateNamesOption(t *testing.T) {
+	for i, tc := range []struct {
+		input       string
+		expected    []string
+		expectError bool
+	}{
+		{
+			input: `{
+				tls_automate_names *.example.com
+			}`,
+			expected: []string{"*.example.com"},
+		},
+		{
+			input: `{
+				tls_automate_names a.example.com b.example.com
+				tls_automate_names c.example.com a.example.com
+			}`,
+			expected: []string{"a.example.com", "b.example.com", "c.example.com"},
+		},
+		{
+			input: `{
+				tls_automate_names
+			}`,
+			expectError: true,
+		},
+	} {
+		adapter := caddyfile.Adapter{
+			ServerType: ServerType{},
+		}
+		_, _, err := adapter.Adapt([]byte(tc.input), nil)
+		if tc.expectError {
+			if err == nil {
+				t.Errorf("Test %d: expected error but got none", i)
+			}
+			continue
+		}
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+
+		// parse the global options block directly to check the accumulated value
+		serverBlocks, err := caddyfile.Parse("Caddyfile", []byte(tc.input))
+		if err != nil {
+			t.Fatalf("Test %d: parsing: %v", i, err)
+		}
+		sbs := []serverBlock{{block: serverBlocks[0], pile: make(map[string][]ConfigValue)}}
+		options := make(map[string]any)
+		if _, err := (ServerType{}).evaluateGlobalOptionsBlock(sbs, options); err != nil {
+			t.Fatalf("Test %d: evaluating global options: %v", i, err)
+		}
+		actual, _ := options["tls_automate_names"].([]string)
+		if !slices.Equal(actual, tc.expected) {
+			t.Errorf("Test %d: expected %v, got %v", i, tc.expected, actual)
+		}
+	}
+}
