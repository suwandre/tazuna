+// parseOptTLSAutomateNames parses the tls_automate_names global option.
+// Repeated occurrences append to the list of names. Syntax:
+//
+//	tls_automate_names <names...>
+func parseOptTLSAutomateNames(d *caddyfile.Dispenser, existing any) (any, error) {
+	d.Next() // consume option name
+	var names []string
+	if existing != nil {
+		names = existing.([]string)
+	}
+	newNames := d.RemainingArgs()
+	if len(newNames) == 0 {
+		return nil, d.ArgErr()
+	}
+	for _, name := range newNames {
+		if !slices.Contains(names, name) {
+			names = append(names, name)
+		}
+	}
+	return names, nil
+}
