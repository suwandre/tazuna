+// updateWBLExpiry records that the WBL segment with index segment references the series id, which is no longer
+// in the head. The WAL series record for id is kept until the WBL is truncated past that segment.
+func (h *Head) updateWBLExpiry(id chunks.HeadSeriesRef, segment int) {
+	h.walExpiriesMtx.Lock()
+	defer h.walExpiriesMtx.Unlock()
+
+	if cur, ok := h.wblExpiries[id]; !ok || segment > cur {
+		h.wblExpiries[id] = segment
+	}
+}
