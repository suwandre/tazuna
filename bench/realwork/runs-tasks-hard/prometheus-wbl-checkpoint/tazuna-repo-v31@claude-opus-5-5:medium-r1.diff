+// TestWBLReplayAfterCheckpointWithDuplicateSeries checks that a WAL checkpoint keeps the series record of a
+// duplicate series that only WBL records still reference, until out-of-order compaction truncates the WBL.
+func TestWBLReplayAfterCheckpointWithDuplicateSeries(t *testing.T) {
+	for name, scenario := range sampleTypeScenarios {
+		t.Run(name, func(t *testing.T) {
+			testWBLReplayAfterCheckpointWithDuplicateSeries(t, scenario)
+		})
+	}
+}
+
+func testWBLReplayAfterCheckpointWithDuplicateSeries(t *testing.T, scenario sampleTypeScenario) {
+	opts := DefaultOptions()
+	opts.OutOfOrderTimeWindow = 60 * time.Minute.Milliseconds()
+
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	series1 := labels.FromStrings("foo", "bar1")
+	var allSamples []chunks.Sample
+	addSample := func(mins int64) {
+		app := db.Appender(context.Background())
+		ts := mins * time.Minute.Milliseconds()
+		_, s, err := scenario.appendFunc(app, series1, ts, ts)
+		require.NoError(t, err)
+		allSamples = append(allSamples, s)
+		require.NoError(t, app.Commit())
+	}
+	verifySamples := func() {
+		sort.Slice(allSamples, func(i, j int) bool {
+			return allSamples[i].T() < allSamples[j].T()
+		})
+		q, err := db.Querier(math.MinInt64, math.MaxInt64)
+		require.NoError(t, err)
+		actRes := query(t, q, labels.MustNewMatcher(labels.MatchEqual, "foo", "bar1"))
+		requireEqualSeries(t, map[string][]chunks.Sample{series1.String(): allSamples}, actRes, true)
+	}
+	reopen := func() {
+		require.NoError(t, db.Close())
+		db = newTestDB(t, withDir(db.Dir()), withOpts(opts))
+		db.DisableCompactions()
+	}
+	hour := time.Hour.Milliseconds()
+
+	// Compact the series into a block. The head drops the series.
+	addSample(60)
+	require.NoError(t, db.CompactHead(NewRangeHead(db.head, 0, 2*hour-1)))
+	require.Nil(t, db.head.series.getByHash(series1.Hash(), series1))
+
+	// The head creates the series again under a new reference, and logs an out-of-order sample for it to the WBL.
+	addSample(180)
+	addSample(150)
+	newRef := db.head.series.getByHash(series1.Hash(), series1).ref
+
+	// On replay both series records map onto one series, and the new reference becomes a duplicate.
+	reopen()
+	require.NotEqual(t, newRef, db.head.series.getByHash(series1.Hash(), series1).ref)
+	verifySamples()
+
+	// Compact the in-order head and write a WAL checkpoint, but do not compact the out-of-order head.
+	addSample(300)
+	for range 3 {
+		_, err := db.head.wal.NextSegment()
+		require.NoError(t, err)
+	}
+	require.NoError(t, db.CompactHead(NewRangeHead(db.head, 2*hour, 4*hour-1)))
+	_, cpIdx, err := wlog.LastCheckpoint(db.head.wal.Dir())
+	require.NoError(t, err)
+	require.GreaterOrEqual(t, cpIdx, 0)
+
+	reopen()
+	verifySamples()
+	require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.wblReplayUnknownRefsTotal.WithLabelValues("series")))
+	require.Contains(t, db.head.wblExpiries, newRef)
+
+	// Out-of-order compaction truncates the WBL, so the duplicate series record is no longer needed.
+	require.NoError(t, db.CompactOOOHead(context.Background()))
+	require.Empty(t, db.head.wblExpiries)
+	verifySamples()
+
+	reopen()
+	verifySamples()
+	require.Empty(t, db.head.wblExpiries)
+}
