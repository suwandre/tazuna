+// TestWBLReplayDuplicateSeriesRecordKeptInCheckpoint checks that a WAL checkpoint keeps the series
+// record of a duplicate series ref while the WBL still uses that ref.
+//
+// The series is dropped from the head and created again under a new ref, which an out-of-order
+// sample in the WBL uses. After a restart, WAL replay maps the new ref onto the series of the old
+// ref. An in-order head compaction then writes a checkpoint with a mint above everything the WAL
+// holds for the new ref. The test restarts before out-of-order compaction runs.
+func TestWBLReplayDuplicateSeriesRecordKeptInCheckpoint(t *testing.T) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.OutOfOrderTimeWindow = 2 * chunkRange
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	lbls := labels.FromStrings("foo", "bar")
+	other := labels.FromStrings("foo", "other")
+	appendSample := func(db *DB, l labels.Labels, ts int64) storage.SeriesRef {
+		t.Helper()
+		app := db.Appender(context.Background())
+		ref, err := app.Append(0, l, ts, float64(ts))
+		require.NoError(t, err)
+		require.NoError(t, app.Commit())
+		return ref
+	}
+	reopen := func() {
+		t.Helper()
+		require.NoError(t, db.Close())
+		db = newTestDB(t, withDir(db.Dir()), withOpts(opts))
+		db.DisableCompactions()
+	}
+	expectSamples := func() {
+		t.Helper()
+		q, err := db.Querier(math.MinInt64, math.MaxInt64)
+		require.NoError(t, err)
+		expected := []chunks.Sample{sample{t: 100, f: 100}, sample{t: 1200, f: 1200}, sample{t: 1800, f: 1800}}
+		require.Equal(t, map[string][]chunks.Sample{lbls.String(): expected}, query(t, q, labels.MustNewMatcher(labels.MatchEqual, "foo", "bar")))
+	}
+
+	oldRef := appendSample(db, lbls, 100)
+	appendSample(db, other, 1700)
+	// Compacting [0, 1000) drops the series from the head.
+	require.NoError(t, db.Compact(context.Background()))
+	require.Nil(t, db.head.series.getByID(chunks.HeadSeriesRef(oldRef)))
+
+	// The series comes back under a new ref, which the out-of-order sample uses in the WBL.
+	newRef := appendSample(db, lbls, 1800)
+	require.NotEqual(t, oldRef, newRef)
+	appendSample(db, lbls, 1200)
+
+	// Roll the WAL, so that the next checkpoint covers the segments that hold both series records.
+	for range 30 {
+		_, err := db.head.wal.NextSegment()
+		require.NoError(t, err)
+	}
+
+	// WAL replay maps the new ref onto the series of the old ref.
+	reopen()
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(oldRef)))
+	require.Nil(t, db.head.series.getByID(chunks.HeadSeriesRef(newRef)))
+
+	// Run the in-order part of DB.Compact: write the block [1000, 2000) and checkpoint the WAL.
+	_, lastIdx, err := wlog.LastCheckpoint(db.head.wal.Dir())
+	if errors.Is(err, record.ErrNotFound) {
+		lastIdx = -1
+	} else {
+		require.NoError(t, err)
+	}
+	appendSample(db, other, 3500)
+	require.NoError(t, db.CompactHead(NewRangeHead(db.head, 1000, 1999)))
+	_, idx, err := wlog.LastCheckpoint(db.head.wal.Dir())
+	require.NoError(t, err)
+	require.Greater(t, idx, lastIdx, "head compaction must write a new checkpoint")
+
+	// Restart before out-of-order compaction.
+	reopen()
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(db.head.metrics.wblReplayUnknownRefsTotal.WithLabelValues("series")))
+	expectSamples()
+
+	// Out-of-order compaction truncates the WBL segments that use the new ref, so the WAL no longer needs to keep its record.
+	require.NoError(t, db.CompactOOOHead(context.Background()))
+	db.head.walExpiriesMtx.Lock()
+	require.NotContains(t, db.head.wblExpiries, chunks.HeadSeriesRef(newRef))
+	db.head.walExpiriesMtx.Unlock()
+	require.False(t, db.head.keepSeriesInWALCheckpointFn(math.MaxInt64)(chunks.HeadSeriesRef(newRef)))
+
+	reopen()
+	expectSamples()
+	db.head.walExpiriesMtx.Lock()
+	require.Empty(t, db.head.wblExpiries)
+	db.head.walExpiriesMtx.Unlock()
+}
