+// updateWBLExpiry records that the WBL segment uses the series ref, keeping the higher of the current segment and segment.
+func (h *Head) updateWBLExpiry(id chunks.HeadSeriesRef, segment int) {
+	h.walExpiriesMtx.Lock()
+	defer h.walExpiriesMtx.Unlock()
+
+	if cur, ok := h.wblExpiries[id]; !ok || segment > cur {
+		h.wblExpiries[id] = segment
+	}
+}
