+func TestCompareNumbers(t *testing.T) {
+	c := qt.New(t)
+
+	for i, test := range []struct {
+		a, b   any
+		result int
+		ok     bool
+	}{
+		{1, 1.0, 0, true},
+		{int64(9007199254740993), float64(9007199254740992), 1, true},
+		{float64(9007199254740992), int64(9007199254740993), -1, true},
+		{uint64(math.MaxUint64), -1, 1, true},
+		{-1, uint64(math.MaxUint64), -1, true},
+		{uint64(math.MaxUint64), float64(1 << 64), -1, true},
+		{int64(math.MaxInt64), float64(1 << 63), -1, true},
+		{int64(math.MinInt64), float64(-(1 << 63)), 0, true},
+		{1, 1.5, -1, true},
+		{-1, -1.5, 1, true},
+		{uint(4), 4.0, 0, true},
+		{1, math.Inf(1), -1, true},
+		{1, math.Inf(-1), 1, true},
+		{float32(1), float64(1), 0, true},
+		{1, math.NaN(), 0, false},
+		{1, "1", 0, false},
+	} {
+		got, ok := CompareNumbers(reflect.ValueOf(test.a), reflect.ValueOf(test.b))
+		c.Assert(ok, qt.Equals, test.ok, qt.Commentf("[%d]", i))
+		c.Assert(got, qt.Equals, test.result, qt.Commentf("[%d]", i))
+	}
+}
