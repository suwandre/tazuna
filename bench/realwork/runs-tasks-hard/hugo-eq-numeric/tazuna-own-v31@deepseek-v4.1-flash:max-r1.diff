+// Tests that eq/ne/lt/le/gt/ge agree for numerically equal values of
+// different numeric types. See issue 14094.
+func TestCompareNumericConsistency(t *testing.T) {
+	t.Parallel()
+	c := qt.New(t)
+
+	n := New(time.UTC, false)
+
+	for _, pair := range [][2]any{
+		{1, 1.0},
+		{1.0, 1},
+		{0, 0.0},
+		{-1, -1.0},
+		{int64(3), float64(3)},
+		{uint(4), 4.0},
+		{int64(9007199254740993), float64(9007199254740992)},
+		{uint64(math.MaxUint64), -1},
+	} {
+		a, b := pair[0], pair[1]
+		eq, ne := n.Eq(a, b), n.Ne(a, b)
+		lt, le := n.Lt(a, b), n.Le(a, b)
+		gt, ge := n.Gt(a, b), n.Ge(a, b)
+
+		msg := qt.Commentf("%v vs %v", a, b)
+		c.Assert(eq, qt.Equals, !ne, msg)
+		c.Assert(le, qt.Equals, lt || eq, msg)
+		c.Assert(ge, qt.Equals, gt || eq, msg)
+		c.Assert(lt && gt, qt.IsFalse, msg)
+		c.Assert(lt || eq || gt, qt.IsTrue, msg)
+	}
+}
