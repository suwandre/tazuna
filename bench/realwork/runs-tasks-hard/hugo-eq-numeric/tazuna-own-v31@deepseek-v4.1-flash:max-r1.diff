@@ -13,6 +13,11 @@
 
 package compare
 
+import (
+	"math"
+	"reflect"
+)
+
 // Eqer can be used to determine if this value is equal to the other.
 // The semantics of equals is that the two value are interchangeable
 // in the Hugo templates.
@@ -65,3 +70,171 @@ func ProbablyEq(v1, v2 any) bool {
 
 	return false
 }
+
+// CompareNumbers compares the numeric values v1 and v2 exactly.
+// It returns -1 if v1 is less than, 0 if equal, and 1 if greater than v2.
+// Both values must be of a numeric kind.
+func CompareNumbers(v1, v2 reflect.Value) int {
+	k1, k2 := v1.Kind(), v2.Kind()
+	if isInt(k1) {
+		if isInt(k2) {
+			return cmpInt(v1.Int(), v2.Int())
+		}
+		if isUint(k2) {
+			return compareIntUint(v1.Int(), v2.Uint())
+		}
+		return compareIntFloat(v1.Int(), v2.Float())
+	}
+	if isUint(k1) {
+		if isInt(k2) {
+			return -compareIntUint(v2.Int(), v1.Uint())
+		}
+		if isUint(k2) {
+			return cmpUint(v1.Uint(), v2.Uint())
+		}
+		return compareUintFloat(v1.Uint(), v2.Float())
+	}
+	if isInt(k2) {
+		return -compareIntFloat(v2.Int(), v1.Float())
+	}
+	if isUint(k2) {
+		return -compareUintFloat(v2.Uint(), v1.Float())
+	}
+	if v1.Float() < v2.Float() {
+		return -1
+	}
+	if v1.Float() > v2.Float() {
+		return 1
+	}
+	return 0
+}
+
+// EqNumber reports whether v1 and v2 are numerically equal.
+// It returns false if either value is not a number.
+func EqNumber(v1, v2 any) bool {
+	av, aok := numValue(v1)
+	bv, bok := numValue(v2)
+	if !aok || !bok {
+		return false
+	}
+	return CompareNumbers(av, bv) == 0
+}
+
+func numValue(v any) (reflect.Value, bool) {
+	if v == nil {
+		return reflect.Value{}, false
+	}
+	rv := reflect.ValueOf(v)
+	for rv.Kind() == reflect.Interface || rv.Kind() == reflect.Pointer {
+		if rv.IsNil() {
+			return reflect.Value{}, false
+		}
+		rv = rv.Elem()
+	}
+	return rv, isInt(rv.Kind()) || isUint(rv.Kind()) || isFloat(rv.Kind())
+}
+
+func isFloat(k reflect.Kind) bool {
+	return k == reflect.Float32 || k == reflect.Float64
+}
+
+func isInt(k reflect.Kind) bool {
+	switch k {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return true
+	}
+	return false
+}
+
+func isUint(k reflect.Kind) bool {
+	switch k {
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return true
+	}
+	return false
+}
+
+func cmpInt(a, b int64) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	}
+	return 0
+}
+
+func cmpUint(a, b uint64) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	}
+	return 0
+}
+
+func compareIntUint(i int64, u uint64) int {
+	if i < 0 {
+		return -1
+	}
+	return cmpUint(uint64(i), u)
+}
+
+// compareIntFloat compares i with f without the precision loss of converting i to float64.
+func compareIntFloat(i int64, f float64) int {
+	if math.IsNaN(f) {
+		return 1
+	}
+	if f == math.Inf(1) {
+		return -1
+	}
+	if f == math.Inf(-1) {
+		return 1
+	}
+	fi, frac := math.Modf(f)
+	if fi < -9.223372036854776e18 {
+		return 1
+	}
+	if fi >= 9.223372036854776e18 {
+		return -1
+	}
+	if c := cmpInt(i, int64(fi)); c != 0 {
+		return c
+	}
+	switch {
+	case frac > 0:
+		return -1
+	case frac < 0:
+		return 1
+	}
+	return 0
+}
+
+// compareUintFloat compares u with f without the precision loss of converting u to float64.
+func compareUintFloat(u uint64, f float64) int {
+	if math.IsNaN(f) {
+		return 1
+	}
+	if f == math.Inf(1) {
+		return -1
+	}
+	if f == math.Inf(-1) {
+		return 1
+	}
+	if f < 0 {
+		return 1
+	}
+	if f >= 1.8446744073709552e19 {
+		return -1
+	}
+	fu := math.Trunc(f)
+	ui := uint64(fu)
+	if c := cmpUint(u, ui); c != 0 {
+		return c
+	}
+	if f > fu {
+		return -1
+	}
+	return 0
+}
