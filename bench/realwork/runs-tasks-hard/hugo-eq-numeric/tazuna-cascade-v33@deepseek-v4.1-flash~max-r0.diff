index 9b8a08b..3afa050 100644
--- a/hugolib/template_test.go
+++ b/hugolib/template_test.go
@@ -652,3 +652,39 @@ page.html.d
 
 	b.AssertFileContent("public/p1/index.b", "page.html.b")
 }
+
+func TestTemplateCompareNumbersMixedTypes(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+
+[params]
+bigint = 9007199254740993
+bigfloat = 9007199254740992.0
+-- layouts/home.html --
+eq 1 1.0 = {{ eq 1 1.0 }}
+ne 1 1.0 = {{ ne 1 1.0 }}
+lt 1 1.0 = {{ lt 1 1.0 }}
+le 1 1.0 = {{ le 1 1.0 }}
+gt 1 1.0 = {{ gt 1 1.0 }}
+ge 1 1.0 = {{ ge 1 1.0 }}
+eq big = {{ eq site.Params.bigint site.Params.bigfloat }}
+gt big = {{ gt site.Params.bigint site.Params.bigfloat }}
+lt big = {{ lt site.Params.bigfloat site.Params.bigint }}
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"eq 1 1.0 = true",
+		"ne 1 1.0 = false",
+		"lt 1 1.0 = false",
+		"le 1 1.0 = true",
+		"gt 1 1.0 = false",
+		"ge 1 1.0 = true",
+		"eq big = false",
+		"gt big = true",
+		"lt big = true",
+	)
+}
