+
+package hreflect
+
+import (
+	"math"
+	"math/big"
+	"reflect"
+	"testing"
+
+	qt "github.com/frankban/quicktest"
+)
+
+func TestCompareNumbers(t *testing.T) {
+	c := qt.New(t)
+
+	for _, test := range []struct {
+		a, b   any
+		expect int
+		ok     bool
+	}{
+		{1, 1, 0, true},
+		{1, 1.0, 0, true},
+		{1.0, 1, 0, true},
+		{1, 2.0, -1, true},
+		{-1, -1.0, 0, true},
+		{0, 0.0, 0, true},
+		{1.5, 1, 1, true},
+		{1, 1.5, -1, true},
+		{-1.5, -1, -1, true},
+		{-1, -1.5, 1, true},
+		{int8(4), uint16(4), 0, true},
+		{uint32(4), uint64(3), 1, true},
+		{uint64(4), uint32(5), -1, true},
+		{-1, uint64(0), -1, true},
+		{uint64(0), -1, 1, true},
+		{uint64(math.MaxUint64), -1, 1, true},
+		{-1, uint64(math.MaxUint64), -1, true},
+		{int64(math.MaxInt64), float64(math.MaxInt64), -1, true},
+		{int64(math.MinInt64), float64(math.MinInt64), 0, true},
+		{uint64(math.MaxUint64), float64(math.MaxUint64), -1, true},
+		{uint64(math.MaxUint64), float64(1<<64 - 2048), 1, true},
+		{int64(9007199254740993), float64(9007199254740992), 1, true},
+		{float64(9007199254740992), int64(9007199254740993), -1, true},
+		{float32(1.5), int64(1), 1, true},
+		{int64(-1), float32(-1.5), 1, true},
+		{math.Inf(1), uint64(math.MaxUint64), 1, true},
+		{math.Inf(-1), int64(math.MinInt64), -1, true},
+		{math.NaN(), 1, 0, false},
+		{1, math.NaN(), 0, false},
+		{math.NaN(), math.NaN(), 0, false},
+	} {
+		got, ok := CompareNumbers(reflect.ValueOf(test.a), reflect.ValueOf(test.b))
+		c.Assert(ok, qt.Equals, test.ok, qt.Commentf("%v vs %v", test.a, test.b))
+		c.Assert(got, qt.Equals, test.expect, qt.Commentf("%v vs %v", test.a, test.b))
+
+		got, ok = CompareNumbers(reflect.ValueOf(test.b), reflect.ValueOf(test.a))
+		c.Assert(ok, qt.Equals, test.ok, qt.Commentf("%v vs %v", test.b, test.a))
+		c.Assert(got, qt.Equals, -test.expect, qt.Commentf("%v vs %v", test.b, test.a))
+	}
+}
+
+func TestCompareNumbersAgainstBigRat(t *testing.T) {
+	c := qt.New(t)
+
+	toRat := func(v any) *big.Rat {
+		switch vv := v.(type) {
+		case int64:
+			return new(big.Rat).SetInt64(vv)
+		case uint64:
+			return new(big.Rat).SetUint64(vv)
+		case float64:
+			return new(big.Rat).SetFloat64(vv)
+		}
+		panic("bad type")
+	}
+
+	// Cover the boundaries where int64/uint64/float64 conversions
+	// typically lose precision.
+	all := []any{
+		int64(math.MinInt64), int64(math.MinInt64 + 1), int64(-1<<53 - 1), int64(-1) << 53,
+		int64(-1), int64(0), int64(1), int64(1) << 53, int64(1)<<53 + 1, int64(math.MaxInt64 - 1), int64(math.MaxInt64),
+		uint64(0), uint64(1), uint64(1) << 53, uint64(1)<<53 + 1, uint64(math.MaxInt64), uint64(math.MaxInt64) + 1,
+		uint64(1)<<63 + 1, uint64(math.MaxUint64 - 2047), uint64(math.MaxUint64),
+		float64(math.MinInt64), -float64(1<<53) - 2, -1.5, -1.0, -0.5, math.Copysign(0, -1),
+		0.0, 0.5, 1.0, 1.5, float64(1 << 53), float64(1<<53 + 2), float64(math.MaxInt64), float64(math.MaxUint64),
+	}
+
+	for _, a := range all {
+		for _, b := range all {
+			got, ok := CompareNumbers(reflect.ValueOf(a), reflect.ValueOf(b))
+			c.Assert(ok, qt.IsTrue, qt.Commentf("%v (%T) vs %v (%T)", a, a, b, b))
+			c.Assert(got, qt.Equals, toRat(a).Cmp(toRat(b)), qt.Commentf("%v (%T) vs %v (%T)", a, a, b, b))
+		}
+	}
+}
