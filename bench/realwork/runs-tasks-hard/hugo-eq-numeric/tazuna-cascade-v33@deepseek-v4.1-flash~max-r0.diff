+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package hreflect
+
+import (
+	"cmp"
+	"math"
+	"reflect"
+)
+
+// CompareNumbers compares the numbers a and b exactly and returns
+// -1 if a < b, 0 if a == b and 1 if a > b.
+// The second return value is false if the comparison is unordered,
+// which can only happen if one of the values is NaN.
+// a and b must be of a numeric kind.
+func CompareNumbers(a, b reflect.Value) (int, bool) {
+	ak, bk := a.Kind(), b.Kind()
+	switch {
+	case IsInt(ak) && IsInt(bk):
+		return cmp.Compare(a.Int(), b.Int()), true
+	case IsUint(ak) && IsUint(bk):
+		return cmp.Compare(a.Uint(), b.Uint()), true
+	case IsInt(ak) && IsUint(bk):
+		ai := a.Int()
+		if ai < 0 {
+			return -1, true
+		}
+		return cmp.Compare(uint64(ai), b.Uint()), true
+	case IsUint(ak) && IsInt(bk):
+		bi := b.Int()
+		if bi < 0 {
+			return 1, true
+		}
+		return cmp.Compare(a.Uint(), uint64(bi)), true
+	case IsFloat(ak) && IsFloat(bk):
+		af, bf := a.Float(), b.Float()
+		if math.IsNaN(af) || math.IsNaN(bf) {
+			return 0, false
+		}
+		return cmp.Compare(af, bf), true
+	case IsFloat(ak):
+		return compareFloatInteger(a.Float(), b)
+	default:
+		c, ok := compareFloatInteger(b.Float(), a)
+		return -c, ok
+	}
+}
+
+// compareFloatInteger compares the float64 f with the integer i.
+func compareFloatInteger(f float64, i reflect.Value) (int, bool) {
+	if math.IsNaN(f) {
+		return 0, false
+	}
+	if IsInt(i.Kind()) {
+		iv := i.Int()
+		if f < math.MinInt64 {
+			return -1, true
+		}
+		if f >= math.MaxInt64 {
+			return 1, true
+		}
+		t := math.Trunc(f)
+		if ti := int64(t); ti != iv {
+			return cmp.Compare(ti, iv), true
+		}
+		return cmp.Compare(f, t), true
+	}
+	uv := i.Uint()
+	if f < 0 {
+		return -1, true
+	}
+	if f >= math.MaxUint64 {
+		return 1, true
+	}
+	t := math.Trunc(f)
+	if tu := uint64(t); tu != uv {
+		return cmp.Compare(tu, uv), true
+	}
+	return cmp.Compare(f, t), true
+}
