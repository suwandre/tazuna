+package hreflect
+
+import (
+	"math"
+	"reflect"
+	"testing"
+
+	qt "github.com/frankban/quicktest"
+)
+
+func TestCompareNumbers(t *testing.T) {
+	c := qt.New(t)
+
+	for _, test := range []struct {
+		a, b any
+		want int
+		ok   bool
+	}{
+		{1, 1.0, 0, true},
+		{1, 2.0, -1, true},
+		{2.5, 2, 1, true},
+		{-0.5, uint(0), -1, true},
+		{uint(0), math.Copysign(0, -1), 0, true},
+		{int64(9007199254740993), float64(9007199254740992), 1, true},
+		{uint64(9007199254740993), float64(9007199254740992), 1, true},
+		{uint64(math.MaxUint64), -1, 1, true},
+		{int64(math.MinInt64), uint64(math.MaxUint64), -1, true},
+		{uint64(math.MaxUint64), uint64(math.MaxUint64), 0, true},
+		{int64(math.MaxInt64), float64(math.MaxInt64), -1, true},
+		{float64(math.MinInt64), int64(math.MinInt64), 0, true},
+		{float64(math.MinInt64) * 2, int64(math.MinInt64), -1, true},
+		{float64(math.MaxUint64), uint64(math.MaxUint64), 1, true},
+		{math.Inf(-1), uint8(0), -1, true},
+		{math.NaN(), 1, 0, false},
+		{1, math.NaN(), 0, false},
+		{1, "1", 0, false},
+	} {
+		got, ok := CompareNumbers(reflect.ValueOf(test.a), reflect.ValueOf(test.b))
+		c.Assert(ok, qt.Equals, test.ok, qt.Commentf("%v vs %v", test.a, test.b))
+		c.Assert(got, qt.Equals, test.want, qt.Commentf("%v vs %v", test.a, test.b))
+	}
+}
