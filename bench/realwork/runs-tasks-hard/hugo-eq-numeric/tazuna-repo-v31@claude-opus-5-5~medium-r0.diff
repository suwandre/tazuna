+
+func TestCompareIntWithEqualFloat(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/home.html --
+eq: {{ eq 1 1.0 }}|ne: {{ ne 1 1.0 }}|lt: {{ lt 1 1.0 }}|le: {{ le 1 1.0 }}|gt: {{ gt 1 1.0 }}|ge: {{ ge 1 1.0 }}|
+{{ $s := slice (dict "n" 1) (dict "n" 2.0) (dict "n" 2.5) }}
+where eq: {{ range where $s "n" "eq" 2 }}{{ .n }} {{ end }}|
+where ne: {{ range where $s "n" "ne" 2 }}{{ .n }} {{ end }}|
+where lt: {{ range where $s "n" "<" 2 }}{{ .n }} {{ end }}|
+where gt: {{ range where $s "n" ">" 2 }}{{ .n }} {{ end }}|
+`
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"eq: true|ne: false|lt: false|le: true|gt: false|ge: true|",
+		"where eq: 2 |",
+		"where ne: 1 2.5 |",
+		"where lt: 1 |",
+		"where gt: 2.5 |",
+	)
+}
