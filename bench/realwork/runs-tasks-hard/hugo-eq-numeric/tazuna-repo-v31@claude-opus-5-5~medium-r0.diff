+package hreflect
+
+import (
+	"cmp"
+	"math"
+	"reflect"
+)
+
+// CompareNumbers compares the numbers a and b exactly, without rounding or overflow,
+// returning -1, 0 or 1.
+// It returns false if either value is not a number or is NaN.
+func CompareNumbers(a, b reflect.Value) (int, bool) {
+	ak, bk := a.Kind(), b.Kind()
+	if !IsNumber(ak) || !IsNumber(bk) {
+		return 0, false
+	}
+	switch {
+	case IsFloat(ak) && IsFloat(bk):
+		x, y := a.Float(), b.Float()
+		if math.IsNaN(x) || math.IsNaN(y) {
+			return 0, false
+		}
+		return cmp.Compare(x, y), true
+	case IsFloat(ak):
+		return compareFloatInteger(a.Float(), b)
+	case IsFloat(bk):
+		c, ok := compareFloatInteger(b.Float(), a)
+		return -c, ok
+	case IsInt(ak) && IsInt(bk):
+		return cmp.Compare(a.Int(), b.Int()), true
+	case IsUint(ak) && IsUint(bk):
+		return cmp.Compare(a.Uint(), b.Uint()), true
+	case IsInt(ak):
+		return compareIntUint(a.Int(), b.Uint()), true
+	default:
+		return -compareIntUint(b.Int(), a.Uint()), true
+	}
+}
+
+func compareIntUint(i int64, u uint64) int {
+	if i < 0 {
+		return -1
+	}
+	return cmp.Compare(uint64(i), u)
+}
+
+// compareFloatInteger compares f with the signed or unsigned integer v.
+func compareFloatInteger(f float64, v reflect.Value) (int, bool) {
+	if math.IsNaN(f) {
+		return 0, false
+	}
+	t := math.Trunc(f)
+	if IsInt(v.Kind()) {
+		switch {
+		case f < math.MinInt64:
+			return -1, true
+		case f >= -math.MinInt64:
+			return 1, true
+		}
+		if c := cmp.Compare(int64(t), v.Int()); c != 0 {
+			return c, true
+		}
+	} else {
+		switch {
+		case f < 0:
+			return -1, true
+		case f >= 1<<64:
+			return 1, true
+		}
+		if c := cmp.Compare(uint64(t), v.Uint()); c != 0 {
+			return c, true
+		}
+	}
+	return cmp.Compare(f, t), true
+}
