+func TestPathFromDiffGitLine(t *testing.T) {
+	scenarios := []struct {
+		name     string
+		line     string
+		expected string
+	}{
+		{"plain", "diff --git a/file.go b/file.go", "file.go"},
+		{"path with a space", "diff --git a/with space.go b/with space.go", "with space.go"},
+		{
+			name: "mnemonic prefixes", line: "diff --git i/file.go w/file.go",
+			expected: "file.go",
+		},
+		{
+			name: "path containing something like a prefix", line: "diff --git a/x b/x b/x b/x",
+			expected: "x b/x",
+		},
+		{
+			name: "mnemonic path containing something like a prefix", line: "diff --git i/x w/x w/x w/x",
+			expected: "x w/x",
+		},
+		{"quoted", `diff --git "a/caf\303\251 x.go" "b/caf\303\251 x.go"`, "café x.go"},
+		{
+			name: "quoted with mnemonic prefixes", line: `diff --git "i/caf\303\251.go" "w/caf\303\251.go"`,
+			expected: "café.go",
+		},
+		// Only a section without a "rename to" or "copy to" line gets here, and in
+		// that section both sides name the same path.
+		{
+			name: "different paths", line: "diff --git a/old.go b/new.go",
+			expected: "",
+		},
+		{"no prefixes", "diff --git file.go file.go", ""},
+	}
+
+	for _, s := range scenarios {
+		t.Run(s.name, func(t *testing.T) {
+			assert.Equal(t, s.expected, pathFromDiffGitLine(s.line))
