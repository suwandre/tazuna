diff --git a/pkg/commands/git_commands/git_command_builder.go b/pkg/commands/git_commands/git_command_builder.go
index a4bd734..8f3815f 100644
--- a/pkg/commands/git_commands/git_command_builder.go
+++ b/pkg/commands/git_commands/git_command_builder.go
@@ -144,6 +144,23 @@ func (self *GitCommandBuilder) NoLineEndingConversion() *GitCommandBuilder {
 		Config("core.safecrlf=false")
 }
 
+// StandardDiffPrefixes makes git write the two sides of a diff with the standard
+// a/ and b/ prefixes, whatever the user configured: diff.noprefix,
+// diff.mnemonicPrefix, and custom diff.srcPrefix/diff.dstPrefix settings all say
+// otherwise, and no one of them overrules the others. A diff whose paths we read
+// back — to build a patch to apply, or to tell which file a row of a rendered diff
+// belongs to — has to carry a prefix we know how to strip.
+//
+// This goes through config rather than --src-prefix/--dst-prefix because git stash
+// show mishandles those arguments, dropping the prefixes rather than setting them.
+func (self *GitCommandBuilder) StandardDiffPrefixes() *GitCommandBuilder {
+	return self.
+		Config("diff.noprefix=false").
+		Config("diff.mnemonicPrefix=false").
+		Config("diff.srcPrefix=a/").
+		Config("diff.dstPrefix=b/")
+}
+
 func (self *GitCommandBuilder) AddCommonDiffArgs(diffRendererConfigManager *config.DiffRendererConfigManager, userConfig *config.UserConfig, mode DiffMode) *GitCommandBuilder {
 	contextSize := userConfig.Git.DiffContextSize
 	useExtDiff := mode == DiffModeRendered && diffRendererConfigManager.GetDiffRendererType() == config.DiffRendererType_ExtDiff
