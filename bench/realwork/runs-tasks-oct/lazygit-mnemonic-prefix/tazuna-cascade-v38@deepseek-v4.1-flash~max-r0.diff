diff --git a/pkg/integration/tests/main_view/stage_hunk_with_mnemonic_prefix.go b/pkg/integration/tests/main_view/stage_hunk_with_mnemonic_prefix.go
new file mode 100644
index 0000000..c75b215
--- /dev/null
+++ b/pkg/integration/tests/main_view/stage_hunk_with_mnemonic_prefix.go
@@ -0,0 +1,43 @@
+package main_view
+
+import (
+	"github.com/jesseduffield/lazygit/pkg/config"
+	. "github.com/jesseduffield/lazygit/pkg/integration/components"
+)
+
+var StageHunkWithMnemonicPrefix = NewIntegrationTest(NewIntegrationTestArgs{
+	Description:  "Staging a hunk from the focused diff works when diff.mnemonicPrefix is set",
+	ExtraCmdArgs: []string{},
+	Skip:         false,
+	SetupConfig:  func(cfg *config.AppConfig) {},
+	SetupRepo: func(shell *Shell) {
+		shell.CreateFileAndAdd("file1", "one\ntwo\nthree\n")
+		shell.Commit("one")
+
+		// With mnemonic prefixes, git spells the diff's two sides i/ and w/
+		// instead of a/ and b/.
+		shell.SetConfig("diff.mnemonicPrefix", "true")
+		shell.UpdateFile("file1", "one\nTWO\nthree\n")
+	},
+	Run: func(t *TestDriver, keys config.KeybindingConfig) {
+		t.Views().Files().
+			IsFocused().
+			Press(keys.Universal.FocusMainView)
+
+		t.Views().Main().
+			IsFocused().
+			SelectedLines(
+				Contains("-two"),
+				Contains("+TWO"),
+			).
+			PressPrimaryAction()
+
+		t.Views().Secondary().ContainsLines(
+			Contains("-two"),
+			Contains("+TWO"),
+		)
+		t.Views().Files().Lines(
+			Contains("M  file1"),
+		)
+	},
+})
