+func TestPathFromDiffHeader(t *testing.T) {
+	scenarios := []struct {
+		name     string
+		header   []string
+		expected string
+	}{
+		{
+			"mnemonic prefixes on the +++ line",
+			[]string{"diff --git i/file.go w/file.go", "index 1111111..2222222 100644", "--- i/file.go", "+++ w/file.go"},
+			"file.go",
+		},
+		{
+			"mnemonic prefix on the --- line of a deleted file",
+			[]string{"diff --git c/gone.go i/gone.go", "deleted file mode 100644", "index 1111111..0000000", "--- c/gone.go", "+++ /dev/null"},
+			"gone.go",
+		},
+		{
+			"mode change",
+			[]string{"diff --git i/run.sh w/run.sh", "old mode 100644", "new mode 100755"},
+			"run.sh",
+		},
+		{
+			"binary file",
+			[]string{"diff --git c/img.png i/img.png", "index 1111111..2222222 100644", "Binary files c/img.png and i/img.png differ"},
+			"img.png",
+		},
+		{
+			"quoted paths on the diff --git line",
+			[]string{`diff --git "i/caf\303\251.go" "w/caf\303\251.go"`, "old mode 100644", "new mode 100755"},
+			"café.go",
+		},
+		{
+			"path with a space on the diff --git line",
+			[]string{"diff --git a/with space.go b/with space.go", "old mode 100644", "new mode 100755"},
+			"with space.go",
+		},
+		{
+			"path containing what looks like the separator",
+			[]string{"diff --git a/x b/y b/x b/y", "old mode 100644", "new mode 100755"},
+			"x b/y",
+		},
+		{
+			"diff --git line whose halves name different paths",
+			[]string{"diff --git a/one.go b/two.go", "old mode 100644", "new mode 100755"},
+			"",
+		},
+		{
+			"rename without a content change",
+			[]string{"diff --git i/old.go w/new.go", "similarity index 100%", "rename from old.go", "rename to new.go"},
+			"new.go",
+		},
+		{
+			"quoted rename without a content change",
+			[]string{`diff --git "a/caf\303\251 old.go" "b/caf\303\251 new.go"`, "similarity index 100%", `rename from "caf\303\251 old.go"`, `rename to "caf\303\251 new.go"`},
+			"café new.go",
+		},
+		{
+			"copy without a content change",
+			[]string{"diff --git c/a.go i/b.go", "similarity index 100%", "copy from a.go", "copy to b.go"},
+			"b.go",
+		},
+	}
+
+	for _, s := range scenarios {
+		t.Run(s.name, func(t *testing.T) {
+			assert.Equal(t, s.expected, pathFromDiffHeader(s.header))
+		})
+	}
+}
