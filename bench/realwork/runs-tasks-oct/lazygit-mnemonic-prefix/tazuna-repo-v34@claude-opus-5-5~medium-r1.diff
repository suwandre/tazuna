+++ b/pkg/integration/tests/main_view/stage_lines_with_mnemonic_prefix.go
@@ -0,0 +1,63 @@
+package main_view
+
+import (
+	"github.com/jesseduffield/lazygit/pkg/config"
+	. "github.com/jesseduffield/lazygit/pkg/integration/components"
+)
+
+var StageLinesWithMnemonicPrefix = NewIntegrationTest(NewIntegrationTestArgs{
+	Description:  "Staging and unstaging lines from the main view works with diff.mnemonicPrefix set",
+	ExtraCmdArgs: []string{},
+	Skip:         false,
+	SetupConfig: func(config *config.AppConfig) {
+		config.GetUserConfig().Gui.UseHunkModeInDiffView = false
+	},
+	SetupRepo: func(shell *Shell) {
+		shell.CreateFileAndAdd("myfile", "1st\n2nd\n3rd\n")
+		shell.Commit("Add file")
+		shell.UpdateFile("myfile", "1st changed\n2nd\n3rd changed\n")
+
+		shell.SetConfig("diff.mnemonicPrefix", "true")
+	},
+	Run: func(t *TestDriver, keys config.KeybindingConfig) {
+		t.Views().Files().
+			IsFocused().
+			Press(keys.Universal.FocusMainView)
+
+		t.Views().Main().
+			IsFocused().
+			SelectedLine(Equals("-1st")).
+			Press(keys.Universal.ToggleRangeSelect).
+			SelectNextItem().
+			PressPrimaryAction().
+			Content(
+				Contains(" 1st changed\n 2nd\n-3rd\n+3rd changed"),
+			).
+			SelectedLine(Equals("-3rd"))
+
+		t.Views().Secondary().
+			Content(
+				Contains("-1st\n+1st changed").DoesNotContain("3rd changed"),
+			)
+
+		t.Views().Main().
+			Press(keys.Universal.TogglePanel)
+
+		t.Views().Secondary().
+			IsFocused().
+			SelectedLine(Equals("-1st")).
+			Press(keys.Universal.ToggleRangeSelect).
+			SelectNextItem().
+			PressPrimaryAction()
+
+		t.Views().Main().
+			Content(
+				Contains("-1st\n+1st changed"),
+			)
+
+		t.Views().Files().
+			Lines(
+				Contains(" M myfile"),
+			)
+	},
+})
