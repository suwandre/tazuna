diff --git a/pkg/commands/git_commands/git_command_builder.go b/pkg/commands/git_commands/git_command_builder.go
index a4bd734..99a0d0e 100644
--- a/pkg/commands/git_commands/git_command_builder.go
+++ b/pkg/commands/git_commands/git_command_builder.go
@@ -161,6 +161,20 @@ func (self *GitCommandBuilder) AddCommonDiffArgs(diffRendererConfigManager *conf
 		ArgIf(mode == DiffModeRendered, diffRendererConfigManager.GetRawGitArgs()...)
 }
 
+// DiffPathPrefixes makes git put the a/ and b/ prefixes on the paths of a diff
+// whatever the user's diff config says, because we read the paths back out of
+// the diff, and git apply strips one leading component from each of them.
+//
+// This overrides the config rather than passing --src-prefix and --dst-prefix,
+// because git stash show mangles those options.
+func (self *GitCommandBuilder) DiffPathPrefixes() *GitCommandBuilder {
+	return self.
+		Config("diff.noprefix=false").
+		Config("diff.mnemonicPrefix=false").
+		Config("diff.srcPrefix=a/").
+		Config("diff.dstPrefix=b/")
+}
+
 func (self *GitCommandBuilder) ToArgv() []string {
 	return append([]string{"git"}, self.args...)
 }
