+func TestPathFromDiffGitLine(t *testing.T) {
+	scenarios := []struct {
+		name     string
+		line     string
+		expected string
+	}{
+		{"plain", "diff --git a/file.go b/file.go", "file.go"},
+		{"mnemonic sides", "diff --git i/file.go w/file.go", "file.go"},
+		{"subdirectory", "diff --git a/dir/file.go b/dir/file.go", "dir/file.go"},
+		// git only quotes a path when it has characters it can't print, not
+		// when it merely has a space, so the two paths are told apart by
+		// finding the split whose halves name the same path.
+		{"path with a space", "diff --git a/with space.go b/with space.go", "with space.go"},
+		{"mnemonic path with a space", "diff --git i/with space.go w/with space.go", "with space.go"},
+		// A path that itself reads like the start of another path must not
+		// fool the split either.
+		{"path reading like a path", "diff --git a/x b/y b/x b/y", "x b/y"},
+		{"mnemonic path reading like a path", "diff --git i/x w/y w/x w/y", "x w/y"},
+		{"quoted paths", `diff --git "a/caf\303\251.go" "b/caf\303\251.go"`, "café.go"},
+		{"quoted paths with a space", `diff --git "a/caf\303\251 old.go" "b/caf\303\251 old.go"`, "café old.go"},
