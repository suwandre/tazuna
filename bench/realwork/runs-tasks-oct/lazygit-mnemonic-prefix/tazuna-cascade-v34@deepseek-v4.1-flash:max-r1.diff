--- /dev/null
+++ b/pkg/integration/tests/main_view/stage_and_unstage_with_mnemonic_prefix.go
@@ -0,0 +1,52 @@
+package main_view
+
+import (
+	"github.com/jesseduffield/lazygit/pkg/config"
+	. "github.com/jesseduffield/lazygit/pkg/integration/components"
+)
+
+var StageAndUnstageWithMnemonicPrefix = NewIntegrationTest(NewIntegrationTestArgs{
+	Description:  "Staging and unstaging a hunk works when git is configured with diff.mnemonicPrefix",
+	ExtraCmdArgs: []string{},
+	Skip:         false,
+	SetupConfig: func(cfg *config.AppConfig) {
+		cfg.GetUserConfig().Gui.UseHunkModeInDiffView = true
+	},
+	SetupRepo: func(shell *Shell) {
+		shell.CreateFileAndAdd("file1", "one\ntwo\nthree\n")
+		shell.Commit("one")
+
+		shell.SetConfig("diff.mnemonicPrefix", "true")
+		shell.UpdateFile("file1", "one\nTWO\nthree\n")
+	},
+	Run: func(t *TestDriver, keys config.KeybindingConfig) {
+		t.Views().Files().
+			IsFocused().
+			Lines(
+				Contains("file1").IsSelected(),
+			).
+			Press(keys.Universal.FocusMainView)
+
+		// Stage the hunk from the unstaged diff, which git spells with mnemonic
+		// prefixes.
+		t.Views().Main().
+			IsFocused().
+			PressPrimaryAction()
+
+		t.Views().Files().Lines(
+			Contains("M  file1"),
+		)
+
+		// Nothing is unstaged any more, so the staged side is the only one and
+		// the focus has followed the file's remaining changes into it. The same
+		// key takes the hunk back out of the index.
+		t.Views().Secondary().
+			IsFocused().
+			Title(Equals("Staged changes")).
+			PressPrimaryAction()
+
+		t.Views().Files().Lines(
+			Contains(" M file1"),
+		)
+	},
+})
