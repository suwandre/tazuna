+	// A copy with no content change states its path the same way a rename does.
+	pureCopy := strings.Split(`diff --git c/src.txt i/dst.txt
+similarity index 100%
+copy from src.txt
+copy to dst.txt`, "\n")
+
+	result, ok = parseDiffLineFromBuffer(pureCopy, 2)
+	assert.True(t, ok)
+	assert.Equal(t, parsedDiffLine{Path: "dst.txt", Type: types.DiffLineFileHeader, NewLine: 1}, result)
