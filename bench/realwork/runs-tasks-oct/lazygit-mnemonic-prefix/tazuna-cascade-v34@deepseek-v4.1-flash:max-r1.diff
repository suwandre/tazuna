@@ -144,6 +144,16 @@ func (self *GitCommandBuilder) NoLineEndingConversion() *GitCommandBuilder {
 		Config("core.safecrlf=false")
 }
 
+// ExplicitDiffPrefixes asks git for the standard a/ and b/ path prefixes on the
+// paths of a diff, whatever the user configured: diff.noprefix, diff.mnemonicPrefix
+// and diff.srcPrefix/diff.dstPrefix all change what git would write otherwise.
+// lazygit reads the path of a diff line out of its header by stripping the prefix,
+// and turns parts of a diff into patches, so the prefix has to be one it knows.
+// Passing the prefixes as arguments overrides all three settings.
+func (self *GitCommandBuilder) ExplicitDiffPrefixes() *GitCommandBuilder {
+	return self.Arg("--src-prefix=a/", "--dst-prefix=b/")
+}
+
