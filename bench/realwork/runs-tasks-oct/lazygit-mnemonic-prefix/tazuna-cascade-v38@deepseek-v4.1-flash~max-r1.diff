diff --git a/pkg/commands/git_commands/git_command_builder.go b/pkg/commands/git_commands/git_command_builder.go
index a4bd734..38b1731 100644
--- a/pkg/commands/git_commands/git_command_builder.go
+++ b/pkg/commands/git_commands/git_command_builder.go
@@ -144,11 +144,27 @@ func (self *GitCommandBuilder) NoLineEndingConversion() *GitCommandBuilder {
 		Config("core.safecrlf=false")
 }
 
+// EnsureDiffPrefixes makes git put its default "a/" and "b/" prefixes on the paths
+// of a diff, whatever pair the user's configuration would otherwise produce. The
+// diff parser strips one prefix component off a header path to get at the
+// repo-relative path, so there has to be one: diff.noprefix leaves none,
+// diff.mnemonicPrefix names a changing pair ("i/" and "w/", "c/" and "i/", ...), and
+// diff.srcPrefix/diff.dstPrefix may name anything. A command-line option such as
+// --no-prefix still overrides all of this, which the custom-patch diff relies on.
+func (self *GitCommandBuilder) EnsureDiffPrefixes() *GitCommandBuilder {
+	return self.
+		Config("diff.dstPrefix=b/").
+		Config("diff.srcPrefix=a/").
+		Config("diff.mnemonicPrefix=false").
+		Config("diff.noprefix=false")
+}
+
 func (self *GitCommandBuilder) AddCommonDiffArgs(diffRendererConfigManager *config.DiffRendererConfigManager, userConfig *config.UserConfig, mode DiffMode) *GitCommandBuilder {
 	contextSize := userConfig.Git.DiffContextSize
 	useExtDiff := mode == DiffModeRendered && diffRendererConfigManager.GetDiffRendererType() == config.DiffRendererType_ExtDiff
 
 	return self.
+		EnsureDiffPrefixes().
 		ArgIfElse(useExtDiff, "--ext-diff", "--no-ext-diff").
 		Arg(fmt.Sprintf("--unified=%d", contextSize)).
 		// Ignoring whitespace is about what the user wants to see, so it holds for a raw
