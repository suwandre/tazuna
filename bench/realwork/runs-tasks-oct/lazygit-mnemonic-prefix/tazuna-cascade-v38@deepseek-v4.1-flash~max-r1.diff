+	quoted := strings.Split(`diff --git "i/caf\303\251.go" "w/caf\303\251.go"
+index 1111111..2222222 100644
+--- "i/caf\303\251.go"
++++ "w/caf\303\251.go"
+@@ -1 +1,2 @@
+ one
++two`, "\n")
+
+	result, ok = parseDiffLineFromBuffer(quoted, 6)
+	assert.True(t, ok)
+	assert.Equal(t, parsedDiffLine{Path: "café.go", Type: types.DiffLineAdded, NewLine: 2}, result)
+}
+
