+package stash
+
+import (
+	"github.com/jesseduffield/lazygit/pkg/config"
+	. "github.com/jesseduffield/lazygit/pkg/integration/components"
+)
+
+var StashStagedWithNoPrefix = NewIntegrationTest(NewIntegrationTestArgs{
+	Description:  "Stashing staged changes works when diff.noprefix is set, which only affects the fallback used before git 2.35",
+	ExtraCmdArgs: []string{},
+	// Later versions stash with `git stash push --staged`, which writes no patch
+	// for us to read; the fallback does, and has to ask for a prefix on it.
+	GitVersion:  Before("2.35.0"),
+	Skip:        false,
+	SetupConfig: func(config *config.AppConfig) {},
+	SetupRepo: func(shell *Shell) {
+		shell.CreateFileAndAdd("file-staged", "content")
+		shell.CreateFileAndAdd("file-unstaged", "content")
+		shell.EmptyCommit("initial commit")
+		shell.UpdateFileAndAdd("file-staged", "new content")
+		shell.UpdateFile("file-unstaged", "new content")
+
+		shell.SetConfig("diff.noprefix", "true")
+		shell.SetConfig("diff.mnemonicPrefix", "true")
+	},
+	Run: func(t *TestDriver, keys config.KeybindingConfig) {
+		t.Views().Files().
+			IsFocused().
+			Press(keys.Files.ViewStashOptions)
+
+		t.ExpectPopup().Menu().Title(Equals("Stash options")).Select(MatchesRegexp("Stash staged changes$")).Confirm()
+
+		t.ExpectPopup().Prompt().Title(Equals("Stash changes")).Type("my stashed file").Confirm()
+
+		t.Views().Stash().
+			Lines(
+				Contains("my stashed file"),
+			)
+
+		// The staged change went into the stash and the unstaged one is still
+		// where it was.
+		t.Views().Files().
+			Lines(
+				Equals(" M file-unstaged"),
+			)
+	},
+})
