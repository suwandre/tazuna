+package main_view
+
+import (
+	"github.com/jesseduffield/lazygit/pkg/config"
+	. "github.com/jesseduffield/lazygit/pkg/integration/components"
+)
+
+var StageDiffLinesWithMnemonicPrefix = NewIntegrationTest(NewIntegrationTestArgs{
+	Description:  "Stage a line of the working tree's diff when diff.mnemonicPrefix is set",
+	ExtraCmdArgs: []string{},
+	Skip:         false,
+	SetupConfig: func(cfg *config.AppConfig) {
+		cfg.GetUserConfig().Gui.UseHunkModeInDiffView = false
+	},
+	SetupRepo: func(shell *Shell) {
+		shell.CreateFileAndAdd("file1", "one\ntwo\nthree\n")
+		shell.Commit("one")
+
+		// git names the sides of this diff "i/" and "w/" rather than "a/" and
+		// "b/"; the paths still have to resolve to the repo's files.
+		shell.SetConfig("diff.mnemonicPrefix", "true")
+
+		shell.UpdateFile("file1", "one\ntwo changed\nthree\nfour\n")
+	},
+	Run: func(t *TestDriver, keys config.KeybindingConfig) {
+		t.Views().Files().
+			IsFocused().
+			Lines(
+				Contains("file1").IsSelected(),
+			).
+			Press(keys.Universal.FocusMainView)
+
+		t.Views().Main().
+			IsFocused().
+			NavigateToLine(Contains("+four")).
+			PressPrimaryAction()
+
+		t.Views().Secondary().ContainsLines(
+			Contains("+four"),
+		)
+		t.Views().Main().Content(DoesNotContain("+four"))
+
+		// Taking the line back out of the index goes through the same path
+		// resolution on the staged side of the diff.
+		t.Views().Main().Press(keys.Universal.TogglePanel)
+		t.Views().Secondary().
+			IsFocused().
+			NavigateToLine(Contains("+four")).
+			PressPrimaryAction()
+
+		t.Views().Main().
+			IsFocused().
+			ContainsLines(
+				Contains("+four"),
+			)
+		t.Views().Secondary().IsInvisible()
+	},
+})
