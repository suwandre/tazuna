+// newUnixSocket starts tracking the newly-bound unix socket ln, with
+// one reference held by ln, so that it can be reused later.
+func newUnixSocket(key, address string, ln io.Closer) (*unixSocket, error) {
+	filer, ok := ln.(interface{ File() (*os.File, error) })
+	if !ok {
+		return nil, fmt.Errorf("unsupported unix socket type: %T", ln)
+	}
+	file, err := filer.File() // does dup() deep down
+	if err != nil {
+		return nil, err
+	}
+	sock := &unixSocket{key: key, file: file, refs: 1}
+	// abstract sockets have no file to remove
+	if !strings.HasPrefix(address, "@") {
+		sock.path = address
+	}
+
+	unixSocketsStateMu.Lock()
+	unixSockets[key] = sock
+	unixSocketsStateMu.Unlock()
+
+	return sock, nil
+}
+
+// wrapUnixSocket wraps ln, which holds a reference to sock, so that
+// closing it releases that reference and decrements the usage pool
+// counter. If ln can't be wrapped, it is closed and the reference released.
+func wrapUnixSocket(ln io.Closer, sock *unixSocket) (any, error) {
+	switch ln := ln.(type) {
+	case *net.UnixListener:
+		// we do our own "unlink on close", since the socket may be shared
+		ln.SetUnlinkOnClose(false)
+		return &deleteListener{Listener: &unixListener{UnixListener: ln, sock: sock}, lnKey: sock.key}, nil
+	case *net.UnixConn:
+		return &deletePacketConn{PacketConn: &unixConn{UnixConn: ln, sock: sock}, lnKey: sock.key}, nil
+	}
+	_ = ln.Close()
+	sock.release()
+	return nil, fmt.Errorf("unsupported unix socket type: %T", ln)
 }
 
