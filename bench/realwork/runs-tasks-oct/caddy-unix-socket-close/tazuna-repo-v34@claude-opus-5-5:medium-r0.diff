+
+//go:build unix && !solaris
+
+package caddy
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+)
+
+// shortTempDir returns a temporary directory with a path short
+// enough for unix socket addresses (t.TempDir can be too long).
+func shortTempDir(t *testing.T) string {
+	t.Helper()
+	dir, err := os.MkdirTemp("/tmp", "caddy")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	return dir
+}
+
+func listenUnixForTest(t *testing.T, network, address string) io.Closer {
+	t.Helper()
+	na := NetworkAddress{Network: network, Host: address}
+	ln, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listening on %s/%s: %v", network, address, err)
+	}
+	return ln.(io.Closer)
+}
+
+// assertServing checks that ln accepts a connection made to path.
+func assertServing(t *testing.T, ln io.Closer, path string) {
+	t.Helper()
+	accepted := make(chan error, 1)
+	go func() {
+		conn, err := ln.(net.Listener).Accept()
+		if err == nil {
+			conn.Close()
+		}
+		accepted <- err
+	}()
+	conn, err := net.DialTimeout("unix", path, time.Second)
+	if err != nil {
+		t.Fatalf("expected %s to accept connections: %v", path, err)
+	}
+	conn.Close()
+	select {
+	case err := <-accepted:
+		if err != nil {
+			t.Fatalf("accept: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("timed out waiting for accept")
+	}
+}
+
+func assertNotListening(t *testing.T, path string) {
+	t.Helper()
+	conn, err := net.DialTimeout("unix", path, time.Second)
+	if err == nil {
+		conn.Close()
+		t.Fatalf("expected %s to refuse connections", path)
+	}
+}
+
+func assertFileExists(t *testing.T, path string, want bool) {
+	t.Helper()
+	_, err := os.Lstat(path)
+	if exists := err == nil; exists != want {
+		t.Fatalf("expected file %s to exist=%t, but stat returned %v", path, want, err)
+	}
+}
+
+func TestUnixSocketCloseStopsListeningAndRemovesFile(t *testing.T) {
+	path := filepath.Join(shortTempDir(t), "s.sock")
+
+	ln := listenUnixForTest(t, "unix", path)
+	assertServing(t, ln, path)
+
+	if err := ln.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	assertNotListening(t, path)
+	assertFileExists(t, path, false)
+	if _, ok := unixSockets[listenerKey("unix", path)]; ok {
+		t.Fatal("socket still tracked after close")
+	}
+}
+
+func TestUnixgramSocketCloseRemovesFile(t *testing.T) {
+	path := filepath.Join(shortTempDir(t), "s.sock")
+
+	pc := listenUnixForTest(t, "unixgram", path)
+	if _, ok := pc.(net.PacketConn); !ok {
+		t.Fatalf("expected a net.PacketConn, got %T", pc)
+	}
+	assertFileExists(t, path, true)
+
+	// a second holder keeps the socket and its file alive
+	pc2 := listenUnixForTest(t, "unixgram", path)
+	if err := pc.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	assertFileExists(t, path, true)
+
+	if err := pc2.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	assertFileExists(t, path, false)
+	if _, ok := unixSockets[listenerKey("unixgram", path)]; ok {
+		t.Fatal("socket still tracked after close")
+	}
+}
+
+func TestUnixSocketSharedUntilLastClose(t *testing.T) {
+	for _, closeNewestFirst := range []bool{false, true} {
+		path := filepath.Join(shortTempDir(t), "s.sock")
+
+		first := listenUnixForTest(t, "unix", path)
+		second := listenUnixForTest(t, "unix", path)
+		toClose, remaining := first, second
+		if closeNewestFirst {
+			toClose, remaining = second, first
+		}
+
+		if err := toClose.Close(); err != nil {
+			t.Fatalf("close: %v", err)
+		}
+		assertFileExists(t, path, true)
+		assertServing(t, remaining, path)
+
+		// the socket can still be reused by another holder
+		third := listenUnixForTest(t, "unix", path)
+		if err := remaining.Close(); err != nil {
+			t.Fatalf("close: %v", err)
+		}
+		assertFileExists(t, path, true)
+		assertServing(t, third, path)
+
+		if err := third.Close(); err != nil {
+			t.Fatalf("close: %v", err)
+		}
+		assertNotListening(t, path)
+		assertFileExists(t, path, false)
+	}
+}
+
+func TestUnixSocketDoubleClose(t *testing.T) {
+	path := filepath.Join(shortTempDir(t), "s.sock")
+	key := listenerKey("unix", path)
+
+	first := listenUnixForTest(t, "unix", path)
+	second := listenUnixForTest(t, "unix", path)
+	if refs, _ := listenerPool.References(key); refs != 2 {
+		t.Fatalf("expected 2 usage pool references, got %d", refs)
+	}
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("first close: %v", err)
+	}
+	if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("expected second close to return net.ErrClosed, got %v", err)
+	}
+
+	// the second close must not have released the other holder's reference
+	if refs, _ := listenerPool.References(key); refs != 1 {
+		t.Fatalf("expected 1 usage pool reference, got %d", refs)
+	}
+	assertFileExists(t, path, true)
+	assertServing(t, second, path)
+
+	if err := second.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	if err := second.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("expected second close to return net.ErrClosed, got %v", err)
+	}
+	assertFileExists(t, path, false)
+}
+
+// TestUnixSocketCloseRacingListen simulates a reload, where the old
+// config's listener is closed while the new config listens on the
+// same path.
+func TestUnixSocketCloseRacingListen(t *testing.T) {
+	path := filepath.Join(shortTempDir(t), "s.sock")
+
+	old := listenUnixForTest(t, "unix", path)
+	for i := 0; i < 200; i++ {
+		var (
+			wg     sync.WaitGroup
+			newLn  any
+			lnErr  error
+			na     = NetworkAddress{Network: "unix", Host: path}
+			closed = make(chan struct{})
+		)
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			_ = old.Close()
+			close(closed)
+		}()
+		go func() {
+			defer wg.Done()
+			newLn, lnErr = na.Listen(context.Background(), 0, net.ListenConfig{})
+		}()
+		wg.Wait()
+		<-closed
+		if lnErr != nil {
+			t.Fatalf("iteration %d: listen: %v", i, lnErr)
+		}
+		old = newLn.(io.Closer)
+		assertFileExists(t, path, true)
+		assertServing(t, old, path)
+	}
+	if err := old.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	assertFileExists(t, path, false)
+}
+
+func TestAbstractUnixSocketCloseDoesNotUnlink(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract unix sockets are only supported on linux")
+	}
+	dir := shortTempDir(t)
+	t.Chdir(dir)
+
+	// a regular file whose relative path matches the abstract name
+	name := "@caddy-abstract-test"
+	if err := os.WriteFile(name, []byte("keep"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	first := listenUnixForTest(t, "unix", name)
+	second := listenUnixForTest(t, "unix", name)
+	assertServing(t, second, name)
+	if err := first.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	if err := second.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	assertNotListening(t, name)
+	assertFileExists(t, filepath.Join(dir, name), true)
+}
