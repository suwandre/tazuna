+// unixSocket is a unix domain socket that may be shared by several
+// listeners or packet conns, for example across config reloads. Each
+// holder has its own copy of the file descriptor; file is one more
+// copy, kept so that new holders can be made from it. The socket is
+// closed and its file removed when the last holder closes.
+type unixSocket struct {
+	key  string
+	path string // empty for abstract sockets, which have no file
+	file *os.File
+	refs int // guarded by unixSocketsStateMu
+}
+
+// release drops one reference to the socket. When the last reference
+// is dropped, the socket is closed and its file is removed.
+func (us *unixSocket) release() {
+	unixSocketsStateMu.Lock()
+	defer unixSocketsStateMu.Unlock()
+
+	us.refs--
+	if us.refs > 0 {
+		return
+	}
+	_ = us.file.Close()
+	if unixSockets[us.key] != us {
+		return
+	}
+	delete(unixSockets, us.key)
+	// unlink while still holding the lock, so that a new socket
+	// bound to the same path can't have its file removed by us
+	if us.path != "" {
+		_ = syscall.Unlink(us.path)
+	}
+}
