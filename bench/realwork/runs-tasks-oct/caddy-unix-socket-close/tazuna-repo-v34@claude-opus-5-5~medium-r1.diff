+// unixSocket is the state shared by all holders of a reusable unix socket.
+// Its fields are guarded by unixSocketsMu.
+type unixSocket struct {
+	// file is our own copy of the socket's file descriptor; new holders
+	// are made from it, and it is closed when the last holder closes
+	file *os.File
+
+	// path is the socket file to remove when the last holder closes;
+	// it is empty for abstract sockets, which have no file
+	path string
+
+	mapKey   string
+	datagram bool
+	refs     int
+}
+
+// newUnixSocket registers sock, a newly-created unix socket bound to
+// addr, as reusable under mapKey. The caller must hold unixSocketsMu.
+func newUnixSocket(sock interface{ File() (*os.File, error) }, mapKey, addr string, datagram bool) (*unixSocket, error) {
+	file, err := sock.File() // does dup() deep down
+	if err != nil {
+		return nil, err
+	}
+	s := &unixSocket{
+		file:     file,
+		mapKey:   mapKey,
+		datagram: datagram,
+		refs:     1,
+	}
+	if !isAbstractUnixSocket(addr) {
+		s.path = addr
+	}
+	unixSockets[mapKey] = s
+	return s, nil
+}
+
+// release drops one reference to the socket. When the last one is
+// dropped, the socket file is removed and the socket is closed.
+func (s *unixSocket) release() {
+	unixSocketsMu.Lock()
+	defer unixSocketsMu.Unlock()
+
+	s.refs--
+	if s.refs > 0 {
+		return
+	}
+	if unixSockets[s.mapKey] == s {
+		delete(unixSockets, s.mapKey)
+	}
+	if s.path != "" {
+		_ = syscall.Unlink(s.path)
+	}
+	_ = s.file.Close()
+}
+
