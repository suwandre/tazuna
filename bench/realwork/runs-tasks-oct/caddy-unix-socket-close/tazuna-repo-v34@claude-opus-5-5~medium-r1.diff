+
+//go:build unix && !solaris
+
+package caddy
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+)
+
+// unixSocketPath returns a socket path in a fresh temporary directory.
+// It avoids t.TempDir because socket paths are limited to ~104 bytes.
+func unixSocketPath(t *testing.T) string {
+	t.Helper()
+	dir, err := os.MkdirTemp("", "caddy-uds")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	return filepath.Join(dir, "s.sock")
+}
+
+func listenUnixTest(t *testing.T, network, path string) io.Closer {
+	t.Helper()
+	ln, err := NetworkAddress{Network: network, Host: path}.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listening on %s/%s: %v", network, path, err)
+	}
+	return ln.(io.Closer)
+}
+
+// pendingConn connects to the socket at path without the server accepting it,
+// so the connection only stays alive as long as the socket is open.
+func pendingConn(t *testing.T, path string) net.Conn {
+	t.Helper()
+	conn, err := net.Dial("unix", path)
+	if err != nil {
+		t.Fatalf("dialing %s: %v", path, err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	return conn
+}
+
+// assertSocketClosed checks that conn, a not-yet-accepted connection,
+// was dropped because its listening socket was closed.
+func assertSocketClosed(t *testing.T, conn net.Conn) {
+	t.Helper()
+	_ = conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+	_, err := conn.Read(make([]byte, 1))
+	var netErr net.Error
+	if errors.As(err, &netErr) && netErr.Timeout() {
+		t.Fatal("listening socket is still open after its last holder closed")
+	}
+	if err == nil {
+		t.Fatal("expected read error from dropped connection")
+	}
+}
+
+func assertNoFile(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Lstat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("expected socket file %s to be removed, got: %v", path, err)
+	}
+}
+
+func assertFile(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Lstat(path); err != nil {
+		t.Fatalf("expected socket file %s to exist: %v", path, err)
+	}
+}
+
+func assertAccepts(t *testing.T, ln io.Closer, path string) {
+	t.Helper()
+	accepted := make(chan error, 1)
+	go func() {
+		conn, err := ln.(net.Listener).Accept()
+		if err == nil {
+			conn.Close()
+		}
+		accepted <- err
+	}()
+	conn, err := net.DialTimeout("unix", path, 2*time.Second)
+	if err != nil {
+		t.Fatalf("dialing %s: %v", path, err)
+	}
+	conn.Close()
+	select {
+	case err := <-accepted:
+		if err != nil {
+			t.Fatalf("accepting on %s: %v", path, err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatalf("timed out accepting on %s", path)
+	}
+}
+
+func TestUnixListenerCloseStopsListeningAndRemovesFile(t *testing.T) {
+	path := unixSocketPath(t)
+	ln := listenUnixTest(t, "unix", path)
+	conn := pendingConn(t, path)
+
+	if err := ln.Close(); err != nil {
+		t.Fatalf("closing listener: %v", err)
+	}
+
+	assertSocketClosed(t, conn)
+	assertNoFile(t, path)
+	if _, err := net.Dial("unix", path); err == nil {
+		t.Fatal("expected dial to fail after close")
+	}
+}
+
+func TestUnixListenerSharedUntilLastClose(t *testing.T) {
+	path := unixSocketPath(t)
+	first := listenUnixTest(t, "unix", path)
+	second := listenUnixTest(t, "unix", path) // reuses the first socket
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("closing first listener: %v", err)
+	}
+	assertFile(t, path)
+	assertAccepts(t, second, path)
+
+	conn := pendingConn(t, path)
+	if err := second.Close(); err != nil {
+		t.Fatalf("closing second listener: %v", err)
+	}
+	assertSocketClosed(t, conn)
+	assertNoFile(t, path)
+}
+
+func TestUnixListenerReuseAfterNewestClosed(t *testing.T) {
+	path := unixSocketPath(t)
+	first := listenUnixTest(t, "unix", path)
+	second := listenUnixTest(t, "unix", path)
+
+	// closing the newest holder first (e.g. a failed config load) must
+	// not break reusing the socket for the next one
+	if err := second.Close(); err != nil {
+		t.Fatalf("closing second listener: %v", err)
+	}
+	third := listenUnixTest(t, "unix", path)
+	if err := first.Close(); err != nil {
+		t.Fatalf("closing first listener: %v", err)
+	}
+	assertFile(t, path)
+	assertAccepts(t, third, path)
+	if err := third.Close(); err != nil {
+		t.Fatalf("closing third listener: %v", err)
+	}
+	assertNoFile(t, path)
+}
+
+func TestUnixSocketDoubleClose(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			path := unixSocketPath(t)
+			first := listenUnixTest(t, network, path)
+			second := listenUnixTest(t, network, path)
+			third := listenUnixTest(t, network, path)
+
+			for _, ln := range []io.Closer{first, second} {
+				if err := ln.Close(); err != nil {
+					t.Fatalf("first close: %v", err)
+				}
+				if err := ln.Close(); !errors.Is(err, net.ErrClosed) {
+					t.Fatalf("second close: expected net.ErrClosed, got: %v", err)
+				}
+			}
+
+			// third still holds a reference
+			assertFile(t, path)
+			if network == "unix" {
+				assertAccepts(t, third, path)
+			}
+
+			if err := third.Close(); err != nil {
+				t.Fatalf("closing last holder: %v", err)
+			}
+			assertNoFile(t, path)
+		})
+	}
+}
+
+func TestUnixConnCloseRemovesFile(t *testing.T) {
+	path := unixSocketPath(t)
+	first := listenUnixTest(t, "unixgram", path)
+	second := listenUnixTest(t, "unixgram", path)
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("closing first conn: %v", err)
+	}
+	assertFile(t, path)
+
+	client, err := net.Dial("unixgram", path)
+	if err != nil {
+		t.Fatalf("dialing: %v", err)
+	}
+	defer client.Close()
+	if _, err := client.Write([]byte("hi")); err != nil {
+		t.Fatalf("writing: %v", err)
+	}
+	pc := second.(net.PacketConn)
+	_ = pc.SetReadDeadline(time.Now().Add(2 * time.Second))
+	buf := make([]byte, 8)
+	if n, _, err := pc.ReadFrom(buf); err != nil || string(buf[:n]) != "hi" {
+		t.Fatalf("reading from shared conn: n=%d err=%v", n, err)
+	}
+
+	if err := second.Close(); err != nil {
+		t.Fatalf("closing second conn: %v", err)
+	}
+	assertNoFile(t, path)
+	if _, err := client.Write([]byte("hi")); err == nil {
+		t.Fatal("expected write to closed datagram socket to fail")
+	}
+}
+
+func TestUnixListenerCloseRacingListen(t *testing.T) {
+	path := unixSocketPath(t)
+	old := listenUnixTest(t, "unix", path)
+	for i := 0; i < 200; i++ {
+		var (
+			wg     sync.WaitGroup
+			newLn  any
+			lnErr  error
+			closer = old
+		)
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			_ = closer.Close()
+		}()
+		go func() {
+			defer wg.Done()
+			newLn, lnErr = NetworkAddress{Network: "unix", Host: path}.Listen(context.Background(), 0, net.ListenConfig{})
+		}()
+		wg.Wait()
+		if lnErr != nil {
+			t.Fatalf("iteration %d: listening: %v", i, lnErr)
+		}
+		old = newLn.(io.Closer)
+		assertFile(t, path)
+		assertAccepts(t, old, path)
+	}
+	if err := old.Close(); err != nil {
+		t.Fatalf("closing last listener: %v", err)
+	}
+	assertNoFile(t, path)
+}
+
+func TestAbstractUnixSocketCloseKeepsSameNamedFile(t *testing.T) {
+	if runtime.GOOS != "linux" && runtime.GOOS != "android" {
+		t.Skip("abstract unix sockets are Linux-only")
+	}
+	t.Chdir(t.TempDir())
+
+	name := "@caddy-abstract-test"
+	if err := os.WriteFile(name, []byte("keep me"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	first := listenUnixTest(t, "unix", name)
+	second := listenUnixTest(t, "unix", name)
+	for _, ln := range []io.Closer{first, second} {
+		if err := ln.Close(); err != nil {
+			t.Fatalf("closing listener: %v", err)
+		}
+	}
+
+	if _, err := os.Stat(name); err != nil {
+		t.Fatalf("file with the abstract socket's name was removed: %v", err)
+	}
+}
