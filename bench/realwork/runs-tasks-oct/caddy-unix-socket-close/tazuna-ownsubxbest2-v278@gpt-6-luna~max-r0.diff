+
+func TestUnixSocketReferenceCounting(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			path := shortUnixSocketPath(t)
+			first := listenUnixTest(t, network, path)
+			second := listenUnixTest(t, network, path)
+
+			if err := first.(io.Closer).Close(); err != nil {
+				t.Fatalf("closing first %s socket: %v", network, err)
+			}
+			if err := first.(io.Closer).Close(); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("closing first %s socket twice: got %v, want %v", network, err, net.ErrClosed)
+			}
+			assertUnixSocketFile(t, path, true)
+
+			switch second := second.(type) {
+			case net.Listener:
+				testUnixListenerWorks(t, second, path)
+			case net.PacketConn:
+				testUnixPacketConnWorks(t, second, path)
+			default:
+				t.Fatalf("unexpected %s socket type %T", network, second)
+			}
+
+			if err := second.(io.Closer).Close(); err != nil {
+				t.Fatalf("closing last %s socket: %v", network, err)
+			}
+			if err := second.(io.Closer).Close(); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("closing last %s socket twice: got %v, want %v", network, err, net.ErrClosed)
+			}
+			assertUnixSocketFile(t, path, false)
+		})
+	}
+}
+
+func TestUnixSocketReuseAfterCurrentHolderCloses(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			path := shortUnixSocketPath(t)
+			first := listenUnixTest(t, network, path)
+			second := listenUnixTest(t, network, path)
+
+			if err := second.(io.Closer).Close(); err != nil {
+				t.Fatalf("closing current %s socket: %v", network, err)
+			}
+			assertUnixSocketFile(t, path, true)
+
+			third := listenUnixTest(t, network, path)
+			switch third := third.(type) {
+			case net.Listener:
+				testUnixListenerWorks(t, third, path)
+			case net.PacketConn:
+				testUnixPacketConnWorks(t, third, path)
+			default:
+				t.Fatalf("unexpected %s socket type %T", network, third)
+			}
+
+			if err := first.(io.Closer).Close(); err != nil {
+				t.Fatalf("closing remaining old %s socket: %v", network, err)
+			}
+			if err := third.(io.Closer).Close(); err != nil {
+				t.Fatalf("closing last %s socket: %v", network, err)
+			}
+			assertUnixSocketFile(t, path, false)
+		})
+	}
+}
+
+func TestUnixSocketCloseRacingListen(t *testing.T) {
+	for i := 0; i < 20; i++ {
+		t.Run(fmt.Sprintf("iteration-%d", i), func(t *testing.T) {
+			path := shortUnixSocketPath(t)
+			first := listenUnixTest(t, "unix", path)
+
+			closed := make(chan error, 1)
+			go func() {
+				closed <- first.(io.Closer).Close()
+			}()
+
+			second := listenUnixTest(t, "unix", path)
+			if err := <-closed; err != nil {
+				t.Fatalf("closing old listener: %v", err)
+			}
+			defer second.(io.Closer).Close()
+
+			assertUnixSocketFile(t, path, true)
+			testUnixListenerWorks(t, second.(net.Listener), path)
+		})
+	}
+}
+
+func shortUnixSocketPath(t *testing.T) string {
+	t.Helper()
+	dir, err := os.MkdirTemp("", "caddy-uds-")
+	if err != nil {
+		t.Fatalf("creating socket directory: %v", err)
+	}
+	path := filepath.Join(dir, "socket")
+	t.Cleanup(func() {
+		_ = os.Remove(path)
+		_ = os.Remove(dir)
+	})
+	return path
+}
+
+func listenUnixTest(t *testing.T, network, path string) any {
+	t.Helper()
+	ln, err := (NetworkAddress{Network: network, Host: path}).Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listening on %s socket: %v", network, err)
+	}
+	t.Cleanup(func() {
+		_ = ln.(io.Closer).Close()
+	})
+	return ln
+}
+
+func assertUnixSocketFile(t *testing.T, path string, wantExists bool) {
+	t.Helper()
+	_, err := os.Stat(path)
+	if wantExists && err != nil {
+		t.Fatalf("stat socket file: %v", err)
+	}
+	if !wantExists && !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("socket file still exists or could not be checked: %v", err)
+	}
+}
+
+func testUnixListenerWorks(t *testing.T, ln net.Listener, path string) {
+	t.Helper()
+	accepted := make(chan error, 1)
+	go func() {
+		conn, err := ln.Accept()
+		if err == nil {
+			err = conn.Close()
+		}
+		accepted <- err
+	}()
+
+	conn, err := net.DialTimeout("unix", path, time.Second)
+	if err != nil {
+		t.Fatalf("dialing surviving listener: %v", err)
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatalf("closing client connection: %v", err)
+	}
+	if err := <-accepted; err != nil {
+		t.Fatalf("accepting on surviving listener: %v", err)
+	}
+}
+
+func testUnixPacketConnWorks(t *testing.T, pc net.PacketConn, path string) {
+	t.Helper()
+	read := make(chan error, 1)
+	go func() {
+		buffer := make([]byte, 1)
+		_, _, err := pc.ReadFrom(buffer)
+		read <- err
+	}()
+
+	conn, err := net.DialTimeout("unixgram", path, time.Second)
+	if err != nil {
+		t.Fatalf("dialing surviving packet connection: %v", err)
+	}
+	if _, err := conn.Write([]byte{1}); err != nil {
+		t.Fatalf("writing to surviving packet connection: %v", err)
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatalf("closing packet client connection: %v", err)
+	}
+	if err := <-read; err != nil {
+		t.Fatalf("reading from surviving packet connection: %v", err)
+	}
+}
+
+// TestUnixAbstractSocketDoesNotUnlinkPath verifies that the cleanup for an
+// abstract socket does not remove a filesystem entry with the same name.
+func TestUnixAbstractSocketDoesNotUnlinkPath(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract Unix sockets are Linux-specific")
+	}
+
+	file, err := os.CreateTemp(".", "@caddy-unix-socket-")
+	if err != nil {
+		t.Fatalf("creating sentinel file: %v", err)
+	}
+	path := filepath.Base(file.Name())
+	if err := file.Close(); err != nil {
+		t.Fatalf("closing sentinel file: %v", err)
+	}
+	defer os.Remove(path)
+
+	ln := listenUnixTest(t, "unix", path)
+	if err := ln.(net.Listener).Close(); err != nil {
+		t.Fatalf("closing abstract listener: %v", err)
+	}
+	assertUnixSocketFile(t, path, true)
+}
