+
+// release removes a holder and updates the reusable socket map. The caller
+// must hold unixSocketsMu.
+func (s *unixSocketState) release(holder unixSocket, mapKey string) int32 {
+	delete(s.holders, holder)
+	newCount := s.count.Add(-1)
+	if newCount == 0 {
+		delete(unixSockets, mapKey)
+		return newCount
+	}
+
+	// The map normally points to the most recently created holder. If that
+	// holder is the one being closed, keep a still-open holder available for
+	// the next reuse.
+	if current, ok := unixSockets[mapKey]; ok && current == holder {
+		for remaining := range s.holders {
+			unixSockets[mapKey] = remaining
+			break
+		}
+	}
+	return newCount
+}
