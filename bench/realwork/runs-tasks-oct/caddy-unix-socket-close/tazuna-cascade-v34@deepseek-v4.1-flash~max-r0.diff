+// TestAbstractUnixSocketCloseDoesNotUnlinkPath verifies that closing an
+// abstract Linux socket (names starting with "@") never unlinks a filesystem
+// path of the same name.
+func TestAbstractUnixSocketCloseDoesNotUnlinkPath(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract Unix sockets are Linux-specific")
+	}
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			sentinel, err := os.CreateTemp(".", "@caddy-abstract-*")
+			if err != nil {
+				t.Fatal(err)
+			}
+			name := filepath.Base(sentinel.Name())
+			if err := sentinel.Close(); err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { _ = os.Remove(name) })
+
+			lnAny, err := (NetworkAddress{Network: network, Host: name}).Listen(
+				context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("listening on abstract socket %q: %v", name, err)
+			}
+			closed := false
+			t.Cleanup(func() {
+				if !closed {
+					_ = lnAny.(io.Closer).Close()
+				}
+			})
+
+			if _, err := os.Stat(name); err != nil {
+				t.Fatalf("listening on abstract socket removed sentinel file: %v", err)
+			}
+			if err := lnAny.(io.Closer).Close(); err != nil {
+				t.Fatalf("closing abstract socket: %v", err)
+			}
+			closed = true
+			if _, err := os.Stat(name); err != nil {
+				t.Fatalf("closing abstract socket removed sentinel file: %v", err)
+			}
+		})
+	}
+}
