+// TestUnixSocketConcurrentCloseAndRelisten verifies that a close racing with a
+// new listen on the same path (as happens during a reload) leaves a working
+// socket and its file in place for the new listener.
+func TestUnixSocketConcurrentCloseAndRelisten(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			socketPath := unixTestSocketPath(t)
+			na := NetworkAddress{Network: network, Host: socketPath}
+
+			for i := 0; i < 20; i++ {
+				lnAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+				if err != nil {
+					t.Fatalf("iteration %d: initial listen: %v", i, err)
+				}
+				oldLn := lnAny.(io.Closer)
+
+				var (
+					wg        sync.WaitGroup
+					newLnAny  any
+					listenErr error
+				)
+				wg.Add(2)
+				go func() {
+					defer wg.Done()
+					_ = oldLn.Close()
+				}()
+				go func() {
+					defer wg.Done()
+					newLnAny, listenErr = na.Listen(context.Background(), 0, net.ListenConfig{})
+				}()
+				wg.Wait()
+
+				if listenErr != nil {
+					t.Fatalf("iteration %d: concurrent listen: %v", i, listenErr)
+				}
+				if _, err := os.Stat(socketPath); err != nil {
+					t.Fatalf("iteration %d: socket file missing after concurrent relisten: %v", i, err)
+				}
+				if network == "unix" {
+					conn, err := net.DialTimeout(network, socketPath, 2*time.Second)
+					if err != nil {
+						t.Fatalf("iteration %d: dialing relistened socket: %v", i, err)
+					}
+					_ = conn.Close()
+				}
+				if err := newLnAny.(io.Closer).Close(); err != nil {
+					t.Fatalf("iteration %d: closing relistened socket: %v", i, err)
+				}
+			}
+		})
+	}
+}
