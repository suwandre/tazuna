+// TestUnixSocketReuseKeepsFileUntilLastClose verifies that a socket shared by
+// several holders keeps working, and its file remains, until the last holder
+// closes it; only then is the file removed.
+func TestUnixSocketReuseKeepsFileUntilLastClose(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			socketPath := unixTestSocketPath(t)
+			na := NetworkAddress{Network: network, Host: socketPath}
+
+			firstAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("first listen: %v", err)
+			}
+			first := firstAny.(io.Closer)
+			t.Cleanup(func() { _ = first.Close() })
+
+			// A second holder reuses the same underlying socket.
+			secondAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("second listen (reuse): %v", err)
+			}
+			second := secondAny.(io.Closer)
+			t.Cleanup(func() { _ = second.Close() })
+
+			// Closing one of two holders must neither remove the file nor
+			// stop the survivor from accepting connections.
+			if err := first.Close(); err != nil {
+				t.Fatalf("closing first holder: %v", err)
+			}
+			if _, err := os.Stat(socketPath); err != nil {
+				t.Fatalf("socket file removed while another holder is active: %v", err)
+			}
+
+			if network == "unix" {
+				ln, ok := secondAny.(net.Listener)
+				if !ok {
+					t.Fatalf("expected net.Listener, got %T", secondAny)
+				}
+				accepted := make(chan struct{})
+				go func() {
+					conn, err := ln.Accept()
+					if err == nil {
+						_ = conn.Close()
+					}
+					close(accepted)
+				}()
+				conn, err := net.DialTimeout(network, socketPath, 2*time.Second)
+				if err != nil {
+					t.Fatalf("dialing surviving holder: %v", err)
+				}
+				_ = conn.Close()
+				select {
+				case <-accepted:
+				case <-time.After(2 * time.Second):
+					t.Fatal("surviving holder did not accept a connection")
+				}
+			}
+
+			// The last holder's close must remove the file.
+			if err := second.Close(); err != nil {
+				t.Fatalf("closing last holder: %v", err)
+			}
+			if _, err := os.Stat(socketPath); !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("socket file still exists after last holder closed: %v", err)
+			}
+		})
+	}
+}
