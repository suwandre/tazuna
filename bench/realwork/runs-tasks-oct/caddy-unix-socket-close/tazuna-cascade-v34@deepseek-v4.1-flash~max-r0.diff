+// unixTestSocketPath returns a short unix socket path to avoid sockaddr_un
+// path length limits (104 bytes on Darwin/BSD, 108 bytes on Linux), which
+// t.TempDir() can exceed in deeply nested temp directories.
+func unixTestSocketPath(t *testing.T) string {
+	t.Helper()
+	f, err := os.CreateTemp("", "caddy-test-*.sock")
+	if err != nil {
+		t.Fatalf("creating temp socket path: %v", err)
+	}
+	path := f.Name()
+	_ = f.Close()
+	_ = os.Remove(path)
+	t.Cleanup(func() {
+		_ = os.Remove(path)
+	})
+	return path
+}
+
+// TestUnixSocketCloseUnlinksAndStopsListening verifies that closing the last
+// reference to a unix socket removes its file immediately and that the socket
+// stops listening, rather than lingering until the next garbage collection.
+func TestUnixSocketCloseUnlinksAndStopsListening(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			socketPath := unixTestSocketPath(t)
+			na := NetworkAddress{Network: network, Host: socketPath}
+
+			lnAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("listen: %v", err)
+			}
+			closer, ok := lnAny.(io.Closer)
+			if !ok {
+				t.Fatalf("listener type %T is not an io.Closer", lnAny)
+			}
+
+			if _, err := os.Stat(socketPath); err != nil {
+				t.Fatalf("socket file was not created: %v", err)
+			}
+
+			if err := closer.Close(); err != nil {
+				t.Fatalf("close: %v", err)
+			}
+
+			if _, err := os.Stat(socketPath); !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("socket file still exists after close (stat err: %v)", err)
+			}
+
+			// A client must fail fast instead of hanging on a leaked fd.
+			conn, err := net.DialTimeout(network, socketPath, time.Second)
+			if err == nil {
+				_ = conn.Close()
+				t.Fatal("dialing the closed socket succeeded; socket is still listening")
+			}
+		})
+	}
+}
