+// TestUnixSocketDoubleCloseDoesNotReleaseAnotherReference verifies that a
+// second Close on the same wrapper reports net.ErrClosed and does not release
+// the reference held by another wrapper.
+func TestUnixSocketDoubleCloseDoesNotReleaseAnotherReference(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			socketPath := unixTestSocketPath(t)
+			na := NetworkAddress{Network: network, Host: socketPath}
+
+			firstAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("first listen: %v", err)
+			}
+			secondAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("second listen (reuse): %v", err)
+			}
+
+			var (
+				first, second io.Closer
+				count         *atomic.Int32
+			)
+			switch network {
+			case "unix":
+				first = firstAny.(deleteListener).Listener.(*unixListener)
+				second = secondAny.(*unixListener)
+				count = first.(*unixListener).count
+			case "unixgram":
+				first = firstAny.(deletePacketConn).PacketConn.(*unixConn)
+				second = secondAny.(*unixConn)
+				count = first.(*unixConn).count
+			}
+			t.Cleanup(func() { _ = second.Close() })
+
+			if err := first.Close(); err != nil {
+				t.Fatalf("first Close(): %v", err)
+			}
+			if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("second Close() error = %v; want net.ErrClosed", err)
+			}
+			if got := count.Load(); got != 1 {
+				t.Fatalf("reference count = %d after double close; want 1", got)
+			}
+			if _, err := os.Stat(socketPath); err != nil {
+				t.Fatalf("socket used by surviving reference was removed: %v", err)
+			}
+
+			if err := second.Close(); err != nil {
+				t.Fatalf("closing surviving holder: %v", err)
+			}
+			if _, err := os.Stat(socketPath); !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("socket file still exists after last holder closed: %v", err)
+			}
+		})
+	}
+}
