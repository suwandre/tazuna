+// TestUnixListenerReuseAndUnlinkOnlyWhenZeroCount ensures the socket file is
+// only removed once the last holder is closed, and that the socket keeps
+// working for the remaining holder.
+func TestUnixListenerReuseAndUnlinkOnlyWhenZeroCount(t *testing.T) {
+	socketPath := shortTempSocket(t)
+	na := NetworkAddress{Network: "unix", Host: socketPath}
+
+	firstAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("first listen: %v", err)
+	}
+	first := firstAny.(net.Listener)
+	t.Cleanup(func() { _ = first.Close() })
+
+	secondAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("second listen: %v", err)
+	}
+	second := secondAny.(net.Listener)
+	t.Cleanup(func() { _ = second.Close() })
+
+	// Close the first holder: the socket must remain usable by the second.
+	if err := first.Close(); err != nil {
+		t.Fatalf("first.Close() failed: %v", err)
+	}
+	if _, err := os.Stat(socketPath); err != nil {
+		t.Fatalf("socket file was removed while still in use: %v", err)
+	}
+
+	accepted := make(chan struct{})
+	go func() {
+		defer close(accepted)
+		conn, err := second.Accept()
+		if err == nil {
+			_ = conn.Close()
+		}
+	}()
+	clientConn, err := net.DialTimeout("unix", socketPath, 2*time.Second)
+	if err != nil {
+		t.Fatalf("dialing surviving listener: %v", err)
+	}
+	_ = clientConn.Close()
+	select {
+	case <-accepted:
+	case <-time.After(2 * time.Second):
+		t.Fatal("surviving listener did not accept a connection")
+	}
+
+	// Close the last holder: the file must go away.
+	if err := second.Close(); err != nil {
+		t.Fatalf("second.Close() failed: %v", err)
+	}
+	if _, err := os.Stat(socketPath); !os.IsNotExist(err) {
+		t.Fatalf("expected socket file to be unlinked after closing all references, got: %v", err)
+	}
+}
