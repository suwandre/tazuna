+// isAbstractUnixSocket reports whether name is a Linux abstract socket
+// name, which lives in the kernel's namespace and has no file on disk.
+func isAbstractUnixSocket(name string) bool {
+	return (runtime.GOOS == "linux" || runtime.GOOS == "android") && strings.HasPrefix(name, "@")
 }
 
