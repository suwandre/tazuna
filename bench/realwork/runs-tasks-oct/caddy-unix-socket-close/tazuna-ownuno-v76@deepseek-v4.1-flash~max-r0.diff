+//go:build unix && !solaris
+
+package caddy
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"runtime"
+	"testing"
+	"time"
+)
+
+// tempSocketPath returns a path short enough to bind a Unix socket to on
+// platforms with a small sun_path limit (e.g. macOS).
+func tempSocketPath(t *testing.T) string {
+	t.Helper()
+	f, err := os.CreateTemp("", "caddy-unix-*.sock")
+	if err != nil {
+		t.Fatalf("creating temp socket path: %v", err)
+	}
+	name := f.Name()
+	if err := f.Close(); err != nil {
+		t.Fatalf("closing temp file: %v", err)
+	}
+	if err := os.Remove(name); err != nil {
+		t.Fatalf("removing temp file: %v", err)
+	}
+	t.Cleanup(func() { _ = os.Remove(name) })
+	return name
+}
+
+func listenUnix(t *testing.T, network, addr string) net.Listener {
+	t.Helper()
+	na, err := ParseNetworkAddress(network + "/" + addr)
+	if err != nil {
+		t.Fatalf("parsing address %s/%s: %v", network, addr, err)
+	}
+	ln, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listening on %s/%s: %v", network, addr, err)
+	}
+	t.Cleanup(func() { _ = ln.(net.Listener).Close() })
+	return ln.(net.Listener)
+}
+
+func listenUnixgram(t *testing.T, addr string) net.PacketConn {
+	t.Helper()
+	na, err := ParseNetworkAddress("unixgram/" + addr)
+	if err != nil {
+		t.Fatalf("parsing address unixgram/%s: %v", addr, err)
+	}
+	pc, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listening on unixgram/%s: %v", addr, err)
+	}
+	t.Cleanup(func() { _ = pc.(net.PacketConn).Close() })
+	return pc.(net.PacketConn)
+}
+
+func assertSocketFileExists(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("socket file %s should exist: %v", path, err)
+	}
+}
+
+func assertSocketFileRemoved(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Stat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("socket file %s should have been removed, got: %v", path, err)
+	}
+}
+
+func assertDialRefused(t *testing.T, path string) {
+	t.Helper()
+	conn, err := net.DialTimeout("unix", path, time.Second)
+	if err == nil {
+		_ = conn.Close()
+		t.Fatalf("dialing %s should have failed, but it succeeded", path)
+	}
+}
+
+func assertAccepts(t *testing.T, ln net.Listener, path string) {
+	t.Helper()
+	accepted := make(chan error, 1)
+	go func() {
+		conn, err := ln.Accept()
+		if err == nil {
+			_ = conn.Close()
+		}
+		accepted <- err
+	}()
+
+	conn, err := net.DialTimeout("unix", path, time.Second)
+	if err != nil {
+		t.Fatalf("dialing %s: %v", path, err)
+	}
+	_ = conn.Close()
+
+	select {
+	case err := <-accepted:
+		if err != nil {
+			t.Fatalf("accepting connection on %s: %v", path, err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatalf("timed out waiting for a connection on %s", path)
+	}
+}
+
+// TestUnixSocketCloseRemovesFile pins that closing the last holder of a Unix
+// socket closes the socket and removes its file immediately, without waiting
+// for a garbage collection to finalize a leaked descriptor.
+func TestUnixSocketCloseRemovesFile(t *testing.T) {
+	path := tempSocketPath(t)
+
+	ln := listenUnix(t, "unix", path)
+	assertSocketFileExists(t, path)
+
+	if err := ln.Close(); err != nil {
+		t.Fatalf("closing listener: %v", err)
+	}
+
+	assertDialRefused(t, path)
+	assertSocketFileRemoved(t, path)
+}
+
+// TestUnixgramSocketCloseRemovesFile is the datagram equivalent of
+// TestUnixSocketCloseRemovesFile.
+func TestUnixgramSocketCloseRemovesFile(t *testing.T) {
+	path := tempSocketPath(t)
+
+	pc := listenUnixgram(t, path)
+	assertSocketFileExists(t, path)
+
+	if err := pc.Close(); err != nil {
+		t.Fatalf("closing packet conn: %v", err)
+	}
+
+	assertSocketFileRemoved(t, path)
+}
+
+// TestUnixSocketSharedByHolders pins that a shared socket keeps working and
+// keeps its file while another holder is using it, and that the file is
+// removed only when the last holder closes it.
+func TestUnixSocketSharedByHolders(t *testing.T) {
+	path := tempSocketPath(t)
+
+	first := listenUnix(t, "unix", path)
+	second := listenUnix(t, "unix", path)
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("closing first listener: %v", err)
+	}
+
+	// the other holder must still be usable, and the file must stay
+	assertSocketFileExists(t, path)
+	assertAccepts(t, second, path)
+
+	if err := second.Close(); err != nil {
+		t.Fatalf("closing second listener: %v", err)
+	}
+
+	assertDialRefused(t, path)
+	assertSocketFileRemoved(t, path)
+}
+
+// TestUnixSocketDoubleClose pins that closing the same listener twice does
+// not release a second reference and reports net.ErrClosed.
+func TestUnixSocketDoubleClose(t *testing.T) {
+	path := tempSocketPath(t)
+
+	first := listenUnix(t, "unix", path)
+	second := listenUnix(t, "unix", path)
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("first close: %v", err)
+	}
+	if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close: expected %v, got %v", net.ErrClosed, err)
+	}
+
+	// the second reference must not have been released by the double close
+	assertSocketFileExists(t, path)
+	assertAccepts(t, second, path)
+
+	if err := second.Close(); err != nil {
+		t.Fatalf("closing second listener: %v", err)
+	}
+	if err := second.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close of reused listener: expected %v, got %v", net.ErrClosed, err)
+	}
+	assertSocketFileRemoved(t, path)
+}
+
+// TestUnixgramSocketDoubleClose is the datagram equivalent of
+// TestUnixSocketDoubleClose.
+func TestUnixgramSocketDoubleClose(t *testing.T) {
+	path := tempSocketPath(t)
+
+	first := listenUnixgram(t, path)
+	second := listenUnixgram(t, path)
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("first close: %v", err)
+	}
+	if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close: expected %v, got %v", net.ErrClosed, err)
+	}
+
+	// the double close must not have released the other reference
+	assertSocketFileExists(t, path)
+
+	if err := second.Close(); err != nil {
+		t.Fatalf("closing second packet conn: %v", err)
+	}
+	if err := second.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close of reused packet conn: expected %v, got %v", net.ErrClosed, err)
+	}
+
+	assertSocketFileRemoved(t, path)
+}
+
+// TestUnixSocketCloseRacesWithListen pins that a close racing with a new
+// listen on the same path (as happens during a reload) leaves a working
+// socket and its file in place for the new listener.
+func TestUnixSocketCloseRacesWithListen(t *testing.T) {
+	for i := 0; i < 25; i++ {
+		t.Run(fmt.Sprintf("iteration_%d", i), func(t *testing.T) {
+			path := tempSocketPath(t)
+
+			oldLn := listenUnix(t, "unix", path)
+
+			closed := make(chan struct{})
+			go func() {
+				defer close(closed)
+				_ = oldLn.Close()
+			}()
+
+			newLn := listenUnix(t, "unix", path)
+			<-closed
+
+			assertSocketFileExists(t, path)
+			assertAccepts(t, newLn, path)
+
+			if err := newLn.Close(); err != nil {
+				t.Fatalf("closing new listener: %v", err)
+			}
+			assertDialRefused(t, path)
+			assertSocketFileRemoved(t, path)
+		})
+	}
+}
+
+// TestAbstractUnixSocketDoesNotUnlinkFile pins that closing an abstract Unix
+// socket never unlinks a filesystem path that happens to share its name.
+// Abstract sockets only exist on Linux.
+func TestAbstractUnixSocketDoesNotUnlinkFile(t *testing.T) {
+	if runtime.GOOS != "linux" && runtime.GOOS != "android" {
+		t.Skip("abstract Unix sockets are Linux-specific")
+	}
+
+	dir := t.TempDir()
+	t.Chdir(dir)
+
+	name := fmt.Sprintf("@caddy-abstract-%d", os.Getpid())
+	if err := os.WriteFile(name, []byte("keep me"), 0o600); err != nil {
+		t.Fatalf("creating colliding file: %v", err)
+	}
+
+	ln := listenUnix(t, "unix", name)
+	if err := ln.Close(); err != nil {
+		t.Fatalf("closing abstract listener: %v", err)
+	}
+
+	// the unrelated filesystem file must remain untouched
+	contents, err := os.ReadFile(name)
+	if err != nil {
+		t.Fatalf("abstract socket close removed a filesystem file: %v", err)
+	}
+	if string(contents) != "keep me" {
+		t.Fatalf("unexpected file contents: %q", contents)
+	}
+}
