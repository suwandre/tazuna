+// unixSocket is a Unix domain socket that is shared by reference-counted
+// holders. The underlying socket stays open (and its file stays on disk)
+// until the last holder closes it, so a reload can hand the socket off to
+// the new config without clients seeing connection refused.
+type unixSocket struct {
+	ln    *net.UnixListener // stream sockets (unix, unixpacket)
+	pc    *net.UnixConn     // datagram sockets (unixgram)
+	addr  string
+	count atomic.Int32
+}
+
+func (us *unixSocket) File() (*os.File, error) {
+	if us.ln != nil {
+		return us.ln.File()
+	}
+	return us.pc.File()
+}
+
+func (us *unixSocket) close() error {
+	var err error
+	switch {
+	case us.ln != nil:
+		err = us.ln.Close()
+	case us.pc != nil:
+		err = us.pc.Close()
+	}
+	// abstract sockets have no filesystem entry; make sure we never unlink
+	// a path that merely happens to have the same name
+	if !isAbstractUnixSocket(us.addr) {
+		_ = syscall.Unlink(us.addr)
+	}
+	return err
+}
+
+// release drops one reference to the shared socket and tears it down once
+// the last holder is gone. Holders must close their own duplicated file
+// descriptor before calling this.
+func (us *unixSocket) release(mapKey string) {
+	unixSocketsMu.Lock()
+	defer unixSocketsMu.Unlock()
+
+	if us.count.Add(-1) != 0 {
+		return
+	}
+	if unixSockets[mapKey] == us {
+		delete(unixSockets, mapKey)
+	}
+	_ = us.close()
+}
+
+// isAbstractUnixSocket reports whether addr names an abstract Unix socket,
+// which has no filesystem entry. Only Linux (and Android) supports abstract
+// Unix sockets, where a leading '@' denotes one; elsewhere '@' is just a
+// regular character in a filesystem path.
+func isAbstractUnixSocket(addr string) bool {
+	return (runtime.GOOS == "linux" || runtime.GOOS == "android") &&
+		strings.HasPrefix(addr, "@")
+}
+
+// newUnixListener creates the shared state for a newly bound Unix stream
+// socket and returns a holder for it. The caller must hold unixSocketsMu
+// and is responsible for closing ln if an error is returned.
+func newUnixListener(addr, mapKey string, ln *net.UnixListener) (*unixListener, error) {
+	socket := &unixSocket{ln: ln, addr: addr}
+	socket.count.Store(1)
+
+	holder, err := duplicateUnixListener(socket, mapKey)
+	if err != nil {
+		return nil, err
+	}
+	ln.SetUnlinkOnClose(false)
+	unixSockets[mapKey] = socket
+	return holder, nil
+}
+
+// newUnixConn is like newUnixListener, but for Unix datagram sockets.
+func newUnixConn(addr, mapKey string, pc *net.UnixConn) (*unixConn, error) {
+	socket := &unixSocket{pc: pc, addr: addr}
+	socket.count.Store(1)
+
+	holder, err := duplicateUnixConn(socket, mapKey)
+	if err != nil {
+		return nil, err
+	}
+	unixSockets[mapKey] = socket
+	return holder, nil
+}
+
+func duplicateUnixListener(socket *unixSocket, mapKey string) (*unixListener, error) {
+	file, err := socket.File()
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+
+	ln, err := net.FileListener(file)
+	if err != nil {
+		return nil, err
+	}
+	unixLn, ok := ln.(*net.UnixListener)
+	if !ok {
+		_ = ln.Close()
+		return nil, fmt.Errorf("expected *net.UnixListener, got %T", ln)
+	}
+	unixLn.SetUnlinkOnClose(false)
+	return &unixListener{UnixListener: unixLn, mapKey: mapKey, socket: socket}, nil
+}
+
+func duplicateUnixConn(socket *unixSocket, mapKey string) (*unixConn, error) {
+	file, err := socket.File()
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+
+	pc, err := net.FilePacketConn(file)
+	if err != nil {
+		return nil, err
+	}
+	unixPC, ok := pc.(*net.UnixConn)
+	if !ok {
+		_ = pc.Close()
+		return nil, fmt.Errorf("expected *net.UnixConn, got %T", pc)
+	}
+	return &unixConn{UnixConn: unixPC, mapKey: mapKey, socket: socket}, nil
+}
