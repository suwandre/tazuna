+// TestUnixListenerCloseRaceWithListen pins that a close racing with a new
+// listen on the same path leaves a working listener and its file in place.
+func TestUnixListenerCloseRaceWithListen(t *testing.T) {
+	dir := unixTempDir(t)
+	for i := 0; i < 50; i++ {
+		path := filepath.Join(dir, "race.sock")
+
+		first := listenUnix(t, "unix", path).(net.Listener)
+
+		var (
+			second    net.Listener
+			listenErr error
+			closeErr  error
+			wg        sync.WaitGroup
+		)
+		start := make(chan struct{})
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			<-start
+			closeErr = first.Close()
+		}()
+		go func() {
+			defer wg.Done()
+			<-start
+			ln, err := (NetworkAddress{Network: "unix", Host: path}).Listen(context.Background(), 0, net.ListenConfig{})
+			listenErr = err
+			if err == nil {
+				second = ln.(net.Listener)
+			}
+		}()
+		close(start)
+		wg.Wait()
+
+		if closeErr != nil {
+			t.Fatalf("iteration %d: close: %v", i, closeErr)
+		}
+		if listenErr != nil {
+			t.Fatalf("iteration %d: listen: %v", i, listenErr)
+		}
+		if _, err := os.Stat(path); err != nil {
+			t.Fatalf("iteration %d: socket file missing after race: %v", i, err)
+		}
+		conn, err := net.DialTimeout("unix", path, 2*time.Second)
+		if err != nil {
+			t.Fatalf("iteration %d: dial after race: %v", i, err)
+		}
+		conn.Close()
+
+		if err := second.Close(); err != nil {
+			t.Fatalf("iteration %d: close second: %v", i, err)
+		}
+		assertNoFile(t, path)
+	}
+}
+
+// TestUnixAbstractSocketNoUnlink pins that closing an abstract socket does not
+// remove a filesystem path with the same name.
+func TestUnixAbstractSocketNoUnlink(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract Unix sockets are Linux-specific")
+	}
+
+	path := filepath.Join(unixTempDir(t), "abstract.sock")
+	if err := os.WriteFile(path, []byte("keep"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	ln := listenUnix(t, "unix", "@"+path).(net.Listener)
+	if err := ln.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("closing abstract socket removed filesystem file: %v", err)
+	}
+}
+
+// TestUnixPacketConnClose pins the same close behavior for datagram sockets.
+func TestUnixPacketConnClose(t *testing.T) {
+	path := filepath.Join(unixTempDir(t), "test.sock")
+	pc := listenUnix(t, "unixgram", path).(net.PacketConn)
+
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("socket file should exist after listen: %v", err)
+	}
+	if err := pc.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	assertNoFile(t, path)
+	if err := pc.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close: expected net.ErrClosed, got %v", err)
+	}
+}
