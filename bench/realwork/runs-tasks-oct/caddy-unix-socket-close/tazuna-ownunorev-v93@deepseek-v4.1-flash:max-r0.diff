+// newUnixSocketHolder creates the shared, reusable socket for key from master
+// and returns a holder with its own duplicate of the descriptor. Holders can
+// be closed independently; the shared master is closed only when the last
+// holder is closed.
+func newUnixSocketHolder(master interface{ File() (*os.File, error) }, key, address string) (*unixSocket, io.Closer, error) {
+	socketFile, err := master.File()
+	if err != nil {
+		return nil, nil, err
+	}
+	defer socketFile.Close()
+
+	path := address
+	if isAbstractUnixSocket(address) {
+		path = ""
+	}
+	socket := &unixSocket{
+		key:    key,
+		path:   path,
+		count:  1,
+		master: master,
+	}
+
+	switch master.(type) {
+	case *net.UnixListener:
+		ln, err := net.FileListener(socketFile)
+		if err != nil {
+			return nil, nil, err
+		}
+		unixLn, ok := ln.(*net.UnixListener)
+		if !ok {
+			_ = ln.Close()
+			return nil, nil, fmt.Errorf("unexpected listener type %T for unix socket", ln)
+		}
+		return socket, &unixListener{unixLn, socket, atomic.Bool{}}, nil
+
+	case *net.UnixConn:
+		pc, err := net.FilePacketConn(socketFile)
+		if err != nil {
+			return nil, nil, err
+		}
+		unixPc, ok := pc.(*net.UnixConn)
+		if !ok {
+			_ = pc.Close()
+			return nil, nil, fmt.Errorf("unexpected packet conn type %T for unix socket", pc)
+		}
+		return socket, &unixConn{unixPc, socket, atomic.Bool{}}, nil
+	}
+
+	return nil, nil, fmt.Errorf("unexpected unix socket type %T", master)
+}
