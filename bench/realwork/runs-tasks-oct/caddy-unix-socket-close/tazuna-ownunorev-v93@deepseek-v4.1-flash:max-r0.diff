+// unixSocket is a Unix domain socket that can be shared by multiple
+// listeners or packet conns (holders). The master descriptor is kept
+// open so new holders can always duplicate a live descriptor. All fields
+// are guarded by unixSocketsMu.
+type unixSocket struct {
+	key    string
+	path   string // filesystem path to unlink on last close; empty for abstract sockets
+	count  int    // number of holders currently using this socket
+	master interface {
+		File() (*os.File, error)
+	}
+}
+
+// release drops one holder reference. When the last holder is released,
+// the socket is removed from the reusable map, its file is unlinked, and
+// the master descriptor is closed.
+func (us *unixSocket) release() {
+	unixSocketsMu.Lock()
+	defer unixSocketsMu.Unlock()
+
+	us.count--
+	if us.count > 0 {
+		return
+	}
+
+	// Only remove the mapping if it still refers to this socket; a newer
+	// listener may have replaced it, in which case its file must stay.
+	if unixSockets[us.key] == us {
+		delete(unixSockets, us.key)
+	}
+	if us.path != "" {
+		_ = syscall.Unlink(us.path)
+	}
+	if closer, ok := us.master.(io.Closer); ok {
+		_ = closer.Close()
+	}
+}
