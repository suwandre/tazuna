+// unixTempDir returns a short temporary directory, since Unix socket paths are
+// limited to around 100 bytes on some platforms (notably macOS).
+func unixTempDir(t *testing.T) string {
+	t.Helper()
+	dir, err := os.MkdirTemp("/tmp", "caddy")
+	if err != nil {
+		t.Fatalf("make temp dir: %v", err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(dir) })
+	return dir
+}
+
+func listenUnix(t *testing.T, network, address string) any {
+	t.Helper()
+	ln, err := (NetworkAddress{Network: network, Host: address}).Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listen %s %s: %v", network, address, err)
+	}
+	return ln
+}
+
+func assertNoFile(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Stat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("socket file %s should have been removed, stat error: %v", path, err)
+	}
+}
+
+// TestUnixListenerClose pins that closing the last holder stops listening and
+// removes the socket file, without waiting for a garbage collection.
+func TestUnixListenerClose(t *testing.T) {
+	path := filepath.Join(unixTempDir(t), "test.sock")
+	ln := listenUnix(t, "unix", path).(net.Listener)
+
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("socket file should exist after listen: %v", err)
+	}
+	if err := ln.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	assertNoFile(t, path)
+
+	if conn, err := net.DialTimeout("unix", path, time.Second); err == nil {
+		conn.Close()
+		t.Fatal("dial succeeded after listener was closed")
+	}
+}
+
+// TestUnixListenerReuse pins that a socket shared by multiple holders stays
+// open and keeps its file until the last holder is closed.
+func TestUnixListenerReuse(t *testing.T) {
+	path := filepath.Join(unixTempDir(t), "test.sock")
+	first := listenUnix(t, "unix", path).(net.Listener)
+	second := listenUnix(t, "unix", path).(net.Listener)
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("close first: %v", err)
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("socket file removed while still in use: %v", err)
+	}
+
+	accepted := make(chan net.Conn, 1)
+	go func() {
+		conn, err := second.Accept()
+		if err == nil {
+			accepted <- conn
+		}
+	}()
+
+	conn, err := net.DialTimeout("unix", path, 2*time.Second)
+	if err != nil {
+		t.Fatalf("dial surviving listener: %v", err)
+	}
+	defer conn.Close()
+
+	select {
+	case acceptedConn := <-accepted:
+		acceptedConn.Close()
+	case <-time.After(5 * time.Second):
+		t.Fatal("surviving listener did not accept a connection")
+	}
+
+	if err := second.Close(); err != nil {
+		t.Fatalf("close second: %v", err)
+	}
+	assertNoFile(t, path)
+}
+
+// TestUnixListenerReuseReverseClose pins that the holder created by reuse can
+// be closed before the original holder without affecting it.
+func TestUnixListenerReuseReverseClose(t *testing.T) {
+	path := filepath.Join(unixTempDir(t), "test.sock")
+	first := listenUnix(t, "unix", path).(net.Listener)
