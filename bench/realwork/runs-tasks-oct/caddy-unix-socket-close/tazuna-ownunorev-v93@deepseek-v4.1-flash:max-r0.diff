+// TestUnixListenerCloseTwice pins that a second Close does not release another
+// reference and reports net.ErrClosed.
+func TestUnixListenerCloseTwice(t *testing.T) {
+	path := filepath.Join(unixTempDir(t), "test.sock")
+	first := listenUnix(t, "unix", path).(net.Listener)
+	second := listenUnix(t, "unix", path).(net.Listener)
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("first close: %v", err)
+	}
+	if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close: expected net.ErrClosed, got %v", err)
+	}
+
+	// the second Close must not have released the other holder's reference
+	unixSocketsMu.Lock()
+	socket := unixSockets[listenerKey("unix", path)]
+	unixSocketsMu.Unlock()
+	if socket == nil {
+		t.Fatal("socket was removed from the reusable map by the second Close")
+	}
+	if socket.count != 1 {
+		t.Fatalf("reference count after second Close: got %d, want 1", socket.count)
+	}
+
+	accepted := make(chan net.Conn, 1)
+	go func() {
+		conn, err := second.Accept()
+		if err == nil {
+			accepted <- conn
+		}
+	}()
+
+	conn, err := net.DialTimeout("unix", path, 2*time.Second)
+	if err != nil {
+		t.Fatalf("dial surviving listener: %v", err)
+	}
+	defer conn.Close()
+
+	select {
+	case acceptedConn := <-accepted:
+		acceptedConn.Close()
+	case <-time.After(5 * time.Second):
+		t.Fatal("surviving listener did not accept a connection")
+	}
+
+	if err := second.Close(); err != nil {
+		t.Fatalf("close second: %v", err)
+	}
+	assertNoFile(t, path)
+}
