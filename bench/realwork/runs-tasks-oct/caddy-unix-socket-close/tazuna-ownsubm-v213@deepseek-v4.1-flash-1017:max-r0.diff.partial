-		return nil, err
+	// Abstract sockets (names beginning with '@' on Linux) have no file, so we must
+	// never unlink a filesystem path that happens to share their name.
+	if !isAbstractUnixSocket(addr) {
+		if err := syscall.Unlink(addr); err != nil && !errors.Is(err, fs.ErrNotExist) {
+			return nil, err
+		}
 	}
 
 	return nil, nil
 }
 
+// isAbstractUnixSocket returns true if addr names an abstract Unix
+// domain socket, which lives in the kernel's namespace and has no
+// corresponding file on disk.
+func isAbstractUnixSocket(addr string) bool {
+	return strings.HasPrefix(addr, "@")
+}
+
+// unixSocket is a unix domain socket that can be shared by multiple
+// listeners or packet conns during graceful config reloads. Each
+// holder gets its own duplicated file descriptor; the socket file is
+// only removed from disk when the last holder closes it.
+type unixSocket struct {
+	key   string   // key in unixSockets
+	addr  string   // address as configured (may be abstract)
+	file  *os.File // duplicate of the socket's file descriptor, for reuse
+	count atomic.Int32
+}
+
+// release drops one reference to the socket. When the last reference
+// is dropped, the socket file is unlinked and the shared file
+// descriptor is closed.
+func (us *unixSocket) release() {
+	unixSocketsMu.Lock()
+	defer unixSocketsMu.Unlock()
+
+	if us.count.Add(-1) > 0 {
+		return
+	}
+
+	delete(unixSockets, us.key)
+	_ = us.file.Close()
+	if !isAbstractUnixSocket(us.addr) {
+		_ = syscall.Unlink(us.addr)
+	}
+}
