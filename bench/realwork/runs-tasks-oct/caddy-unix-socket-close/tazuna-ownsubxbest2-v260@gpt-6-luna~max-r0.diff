+func TestUnixSocketCloseReferenceCount(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			address := unixSocketTestPath(t)
+			first := listenUnixSocketForTest(t, network, address)
+			second := listenUnixSocketForTest(t, network, address)
+			third := listenUnixSocketForTest(t, network, address)
+			defer first.(interface{ Close() error }).Close()
+			defer second.(interface{ Close() error }).Close()
+			defer third.(interface{ Close() error }).Close()
+
+			if err := first.(interface{ Close() error }).Close(); err != nil {
+				t.Fatalf("close first holder: %v", err)
+			}
+			if err := first.(interface{ Close() error }).Close(); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("second close error = %v, want %v", err, net.ErrClosed)
+			}
+
+			if _, err := os.Stat(address); err != nil {
+				t.Fatalf("socket file removed while second holder is active: %v", err)
+			}
+			assertUnixSocketWorks(t, network, address, second)
+
+			if err := third.(interface{ Close() error }).Close(); err != nil {
+				t.Fatalf("close newest holder: %v", err)
+			}
+			fourth := listenUnixSocketForTest(t, network, address)
+			defer fourth.(interface{ Close() error }).Close()
+
+			if err := second.(interface{ Close() error }).Close(); err != nil {
+				t.Fatalf("close second holder: %v", err)
+			}
+			if err := second.(interface{ Close() error }).Close(); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("second holder close error = %v, want %v", err, net.ErrClosed)
+			}
+			if _, err := os.Stat(address); err != nil {
+				t.Fatalf("socket file removed while fourth holder is active: %v", err)
+			}
+			assertUnixSocketWorks(t, network, address, fourth)
+
+			if err := fourth.(interface{ Close() error }).Close(); err != nil {
+				t.Fatalf("close final holder: %v", err)
+			}
+			if _, err := os.Stat(address); !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("socket file still exists after final close: %v", err)
+			}
+		})
+	}
+}
+
+func TestUnixSocketCloseRacesWithListen(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			address := unixSocketTestPath(t)
+			old := listenUnixSocketForTest(t, network, address)
+
+			start := make(chan struct{})
+			closed := make(chan error, 1)
+			listened := make(chan struct {
+				listener any
+				err      error
+			}, 1)
+			go func() {
+				<-start
+				closed <- old.(interface{ Close() error }).Close()
+			}()
+			go func() {
+				<-start
+				listener, err := NetworkAddress{Network: network, Host: address}.Listen(context.Background(), 0, net.ListenConfig{})
+				listened <- struct {
+					listener any
+					err      error
+				}{listener, err}
+			}()
+			close(start)
+
+			if err := <-closed; err != nil {
+				t.Fatalf("close old holder: %v", err)
+			}
+			result := <-listened
+			if result.err != nil {
+				t.Fatalf("listen during close: %v", result.err)
+			}
+			defer result.listener.(interface{ Close() error }).Close()
+
+			if _, err := os.Stat(address); err != nil {
+				t.Fatalf("socket file missing after concurrent listen: %v", err)
+			}
+			assertUnixSocketWorks(t, network, address, result.listener)
+		})
+	}
+}
+
+func TestUnixAbstractSocketDoesNotUnlinkFilesystemPath(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("Linux abstract Unix sockets")
+	}
+	name := "@" + filepath.Base(filepath.Dir(unixSocketTestPath(t)))
+	if err := os.WriteFile(name, []byte("keep me"), 0o600); err != nil {
+		t.Fatalf("create same-name filesystem path: %v", err)
+	}
+	defer os.Remove(name)
+
+	listener := listenUnixSocketForTest(t, "unix", name)
+	defer listener.(interface{ Close() error }).Close()
+	if contents, err := os.ReadFile(name); err != nil || string(contents) != "keep me" {
+		t.Fatalf("filesystem path changed during listen: contents %q, error %v", contents, err)
+	}
+	if err := listener.(interface{ Close() error }).Close(); err != nil {
+		t.Fatalf("close abstract socket: %v", err)
+	}
+	if contents, err := os.ReadFile(name); err != nil || string(contents) != "keep me" {
+		t.Fatalf("filesystem path changed during close: contents %q, error %v", contents, err)
+	}
+}
+
+func unixSocketTestPath(t *testing.T) string {
+	t.Helper()
+	dir, err := os.MkdirTemp("/tmp", "caddy-")
+	if err != nil {
+		t.Fatalf("create temporary socket directory: %v", err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(dir) })
+	return filepath.Join(dir, "s")
+}
+
+func listenUnixSocketForTest(t *testing.T, network, address string) any {
+	t.Helper()
+	listener, err := (NetworkAddress{Network: network, Host: address}).Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listen on %s socket %q: %v", network, address, err)
+	}
+	return listener
+}
+
+func assertUnixSocketWorks(t *testing.T, network, address string, listener any) {
+	t.Helper()
+
+	switch network {
+	case "unix":
+		ln := listener.(net.Listener)
+		accepted := make(chan error, 1)
+		go func() {
+			conn, err := ln.Accept()
+			if err == nil {
+				_ = conn.Close()
+			}
+			accepted <- err
+		}()
+
+		conn, err := net.DialTimeout(network, address, 2*time.Second)
+		if err != nil {
+			t.Fatalf("dial surviving Unix listener: %v", err)
+		}
+		_ = conn.Close()
+		select {
+		case err := <-accepted:
+			if err != nil {
+				t.Fatalf("accept surviving Unix listener: %v", err)
+			}
+		case <-time.After(2 * time.Second):
+			t.Fatal("surviving Unix listener did not accept a connection")
+		}
+
+	case "unixgram":
+		pc := listener.(net.PacketConn)
+		if err := pc.SetReadDeadline(time.Now().Add(2 * time.Second)); err != nil {
+			t.Fatalf("set Unixgram read deadline: %v", err)
+		}
+		defer pc.SetReadDeadline(time.Time{})
+
+		conn, err := net.Dial(network, address)
+		if err != nil {
+			t.Fatalf("dial surviving Unixgram socket: %v", err)
+		}
+		defer conn.Close()
+		if _, err := conn.Write([]byte("test")); err != nil {
+			t.Fatalf("write to surviving Unixgram socket: %v", err)
+		}
+		if _, _, err := pc.ReadFrom(make([]byte, 4)); err != nil {
+			t.Fatalf("read from surviving Unixgram socket: %v", err)
+		}
+	}
+}
