+func TestUnixListenerClose(t *testing.T) {
+	path := newUnixSocketPath(t)
+	na := NetworkAddress{Network: "unix", Host: path}
+
+	firstAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("first listen: %v", err)
+	}
+	first := firstAny.(net.Listener)
+
+	secondAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		first.Close()
+		t.Fatalf("second listen: %v", err)
+	}
+	second := secondAny.(net.Listener)
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("close first listener: %v", err)
+	}
+	if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close of first listener: got %v, want %v", err, net.ErrClosed)
+	}
+	assertUnixSocketFile(t, path, true)
+
+	accepted := make(chan error, 1)
+	go func() {
+		conn, err := second.Accept()
+		if err == nil {
+			err = conn.Close()
+		}
+		accepted <- err
+	}()
+
+	conn, err := net.DialTimeout("unix", path, time.Second)
+	if err != nil {
+		t.Fatalf("dial surviving listener: %v", err)
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatalf("close client connection: %v", err)
+	}
+	if err := <-accepted; err != nil {
+		t.Fatalf("accept on surviving listener: %v", err)
+	}
+
+	if err := second.Close(); err != nil {
+		t.Fatalf("close last listener: %v", err)
+	}
+	if err := second.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close of last listener: got %v, want %v", err, net.ErrClosed)
+	}
+	assertUnixSocketFile(t, path, false)
+}
+
+func TestUnixPacketConnClose(t *testing.T) {
+	path := newUnixSocketPath(t)
+	na := NetworkAddress{Network: "unixgram", Host: path}
+
+	firstAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("first listen: %v", err)
+	}
+	first := firstAny.(net.PacketConn)
+
+	secondAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		first.Close()
+		t.Fatalf("second listen: %v", err)
+	}
+	second := secondAny.(net.PacketConn)
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("close first packet conn: %v", err)
+	}
+	if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close of first packet conn: got %v, want %v", err, net.ErrClosed)
+	}
+	assertUnixSocketFile(t, path, true)
+
+	received := make(chan error, 1)
+	go func() {
+		buf := make([]byte, 1)
+		_, _, err := second.ReadFrom(buf)
+		received <- err
+	}()
+
+	conn, err := net.DialTimeout("unixgram", path, time.Second)
+	if err != nil {
+		t.Fatalf("dial surviving packet conn: %v", err)
+	}
+	if _, err := conn.Write([]byte("x")); err != nil {
+		conn.Close()
+		t.Fatalf("write to surviving packet conn: %v", err)
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatalf("close packet client: %v", err)
+	}
+	if err := <-received; err != nil {
+		t.Fatalf("read from surviving packet conn: %v", err)
+	}
+
+	if err := second.Close(); err != nil {
+		t.Fatalf("close last packet conn: %v", err)
+	}
+	if err := second.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close of last packet conn: got %v, want %v", err, net.ErrClosed)
+	}
+	assertUnixSocketFile(t, path, false)
+}
+
+func TestUnixSocketCloseListenRace(t *testing.T) {
+	for i := range 20 {
+		t.Run(fmt.Sprintf("%d", i), func(t *testing.T) {
+			path := newUnixSocketPath(t)
+			na := NetworkAddress{Network: "unix", Host: path}
+
+			oldAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("old listen: %v", err)
+			}
+			old := oldAny.(net.Listener)
+
+			start := make(chan struct{})
+			closeErr := make(chan error, 1)
+			newResult := make(chan struct {
+				listener net.Listener
+				err      error
+			}, 1)
+			go func() {
+				<-start
+				closeErr <- old.Close()
+			}()
+			go func() {
+				<-start
+				newAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+				if err != nil {
+					newResult <- struct {
+						listener net.Listener
+						err      error
+					}{err: err}
+					return
+				}
+				newResult <- struct {
+					listener net.Listener
+					err      error
+				}{listener: newAny.(net.Listener)}
+			}()
+			close(start)
+
+			if err := <-closeErr; err != nil {
+				t.Fatalf("close old listener: %v", err)
+			}
+			result := <-newResult
+			if result.err != nil {
+				t.Fatalf("new listen: %v", result.err)
+			}
+
+			accepted := make(chan error, 1)
+			go func() {
+				conn, err := result.listener.Accept()
+				if err == nil {
+					err = conn.Close()
+				}
+				accepted <- err
+			}()
+			conn, err := net.DialTimeout("unix", path, time.Second)
+			if err != nil {
+				t.Fatalf("dial new listener: %v", err)
+			}
+			if err := conn.Close(); err != nil {
+				t.Fatalf("close client connection: %v", err)
+			}
+			if err := <-accepted; err != nil {
+				t.Fatalf("accept on new listener: %v", err)
+			}
+
+			if err := result.listener.Close(); err != nil {
+				t.Fatalf("close new listener: %v", err)
+			}
+			assertUnixSocketFile(t, path, false)
+		})
+	}
+}
+
+func TestUnixAbstractSocketCloseDoesNotUnlinkPath(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract Unix sockets are Linux-specific")
+	}
+
+	file, err := os.CreateTemp(".", "@caddy-unix-abstract-*")
+	if err != nil {
+		t.Fatalf("create sentinel file: %v", err)
+	}
+	path := filepath.Base(file.Name())
+	if err := file.Close(); err != nil {
+		t.Fatalf("close sentinel file: %v", err)
+	}
+	t.Cleanup(func() { _ = os.Remove(path) })
+
+	na := NetworkAddress{Network: "unix", Host: path}
+	listenerAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listen on abstract socket: %v", err)
+	}
+	listener := listenerAny.(net.Listener)
+
+	if err := listener.Close(); err != nil {
+		t.Fatalf("close abstract listener: %v", err)
+	}
+	assertUnixSocketFile(t, path, true)
+}
+
+func newUnixSocketPath(t *testing.T) string {
+	t.Helper()
+	file, err := os.CreateTemp("", "caddy-unix-socket-*")
+	if err != nil {
+		t.Fatalf("create temporary socket path: %v", err)
+	}
+	path := file.Name()
+	if err := file.Close(); err != nil {
+		t.Fatalf("close temporary socket path: %v", err)
+	}
+	if err := os.Remove(path); err != nil {
+		t.Fatalf("remove temporary socket path: %v", err)
+	}
+	t.Cleanup(func() { _ = os.Remove(path) })
+	return path
+}
+
+func assertUnixSocketFile(t *testing.T, path string, wantPresent bool) {
+	t.Helper()
+	_, err := os.Stat(path)
+	if wantPresent && err != nil {
+		t.Fatalf("stat socket: %v", err)
+	}
+	if !wantPresent && !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("stat removed socket: got %v", err)
+	}
+}
