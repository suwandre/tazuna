+// the holder's reference; the socket itself is closed (and its file
+// unlinked) only once the last holder is gone.
 type unixListener struct {
 	*net.UnixListener
 	mapKey string
+	path   string
 	count  *atomic.Int32
+	closed atomic.Bool
 }
 
 func (uln *unixListener) Close() error {
-	newCount := uln.count.Add(-1)
-	if newCount == 0 {
-		file, err := uln.File()
