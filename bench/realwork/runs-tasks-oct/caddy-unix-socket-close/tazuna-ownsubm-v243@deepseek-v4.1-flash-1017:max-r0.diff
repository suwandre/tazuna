-		if err == nil {
-			name = file.Name()
-		}
-		defer func() {
-			unixSocketsMu.Lock()
-			delete(unixSockets, uln.mapKey)
-			unixSocketsMu.Unlock()
-			if err == nil {
-				_ = syscall.Unlink(name)
-			}
-		}()
+	// closing twice must not release a reference twice
