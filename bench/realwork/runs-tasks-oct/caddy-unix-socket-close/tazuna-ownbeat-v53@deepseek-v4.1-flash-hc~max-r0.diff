+//go:build unix && !solaris
+
+package caddy
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+)
+
+// shortTempDir returns a temporary directory short enough for unix socket
+// paths, which are limited (about 104 bytes on macOS) and would otherwise
+// overflow with t.TempDir(), whose path includes the test name.
+func shortTempDir(t *testing.T) string {
+	t.Helper()
+	dir, err := os.MkdirTemp("", "caddy")
+	if err != nil {
+		t.Fatalf("creating temp dir: %v", err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	return dir
+}
+
+// mustListenUnix opens a reusable unix socket listener for the given path.
+func mustListenUnix(t *testing.T, sock string) io.Closer {
+	t.Helper()
+	na, err := ParseNetworkAddress("unix/" + sock)
+	if err != nil {
+		t.Fatalf("parse address: %v", err)
+	}
+	ln, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listen %s: %v", sock, err)
+	}
+	return ln.(io.Closer)
+}
+
+// assertUnixDial checks whether a connection to a unix socket can be made.
+func assertUnixDial(t *testing.T, sock string, wantReachable bool) {
+	t.Helper()
+	conn, err := net.DialTimeout("unix", sock, 2*time.Second)
+	if wantReachable {
+		if err != nil {
+			t.Fatalf("expected %s to be reachable, got dial error: %v", sock, err)
+		}
+		conn.Close()
+		return
+	}
+	if err == nil {
+		conn.Close()
+		t.Fatalf("expected %s to refuse connections, but dial succeeded", sock)
+	}
+}
+
+func assertFileExists(t *testing.T, path string, want bool) {
+	t.Helper()
+	_, err := os.Stat(path)
+	if want && err != nil {
+		t.Fatalf("expected %s to exist: %v", path, err)
+	}
+	if !want && !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("expected %s to not exist, got: %v", path, err)
+	}
+}
+
+// TestUnixSocketFileRemovedAfterLastClose pins that a unix socket is actually
+// closed (connections refused) and its file removed once the last holder
+// closes it. Previously the dup'd file descriptor was leaked, so the kernel
+// socket stayed alive (clients hung) until GC, and the socket file was never
+// unlinked because the file name wasn't a path.
+func TestUnixSocketFileRemovedAfterLastClose(t *testing.T) {
+	sock := filepath.Join(shortTempDir(t), "single.sock")
+
+	ln := mustListenUnix(t, sock)
+	assertFileExists(t, sock, true)
+	assertUnixDial(t, sock, true)
+
+	if err := ln.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+
+	assertUnixDial(t, sock, false)
+	assertFileExists(t, sock, false)
+}
+
+// TestUnixSocketReuseKeepsFileUntilLastClose pins that a reused socket is
+// reference counted: closing one holder keeps the socket working and its file
+// in place while another holder remains, and only the last close removes it.
+func TestUnixSocketReuseKeepsFileUntilLastClose(t *testing.T) {
+	sock := filepath.Join(shortTempDir(t), "shared.sock")
+
+	ln1 := mustListenUnix(t, sock)
+	ln2 := mustListenUnix(t, sock)
+	assertFileExists(t, sock, true)
+
+	// closing the first holder must not tear down the shared socket
+	if err := ln1.Close(); err != nil {
+		t.Fatalf("close first: %v", err)
+	}
+	assertFileExists(t, sock, true)
+	assertUnixDial(t, sock, true)
+
+	// the last holder tears it down
+	if err := ln2.Close(); err != nil {
+		t.Fatalf("close second: %v", err)
+	}
+	assertUnixDial(t, sock, false)
+	assertFileExists(t, sock, false)
+}
+
+// TestUnixSocketDoubleClose pins that a second Close does not release another
+// reference and reports net.ErrClosed.
+func TestUnixSocketDoubleClose(t *testing.T) {
+	sock := filepath.Join(shortTempDir(t), "double.sock")
+
+	ln1 := mustListenUnix(t, sock)
+	ln2 := mustListenUnix(t, sock)
+
+	if err := ln1.Close(); err != nil {
+		t.Fatalf("first close: %v", err)
+	}
+	err := ln1.Close()
+	if !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close: expected net.ErrClosed, got %v", err)
+	}
+
+	// ln1's double close must not have stolen ln2's reference
+	assertUnixDial(t, sock, true)
+	assertFileExists(t, sock, true)
+
+	if err := ln2.Close(); err != nil {
+		t.Fatalf("close second holder: %v", err)
+	}
+	assertUnixDial(t, sock, false)
+	assertFileExists(t, sock, false)
+}
+
+// TestUnixSocketCloseInterleavedWithListen pins the reload sequence: a close
+// and a new listen on the same path must leave a working socket and its file
+// in place for the new listener.
+func TestUnixSocketCloseInterleavedWithListen(t *testing.T) {
+	sock := filepath.Join(shortTempDir(t), "reload.sock")
+
+	ln1 := mustListenUnix(t, sock)
+	ln2 := mustListenUnix(t, sock)
+
+	// old config goes away, new config starts sharing the same socket
+	if err := ln1.Close(); err != nil {
+		t.Fatalf("close old: %v", err)
+	}
+	ln3 := mustListenUnix(t, sock)
+
+	assertFileExists(t, sock, true)
+	assertUnixDial(t, sock, true)
+
+	// the remaining old holder leaves; ln3 must keep the socket alive
+	if err := ln2.Close(); err != nil {
+		t.Fatalf("close remaining old: %v", err)
+	}
+	assertFileExists(t, sock, true)
+	assertUnixDial(t, sock, true)
+
+	if err := ln3.Close(); err != nil {
+		t.Fatalf("close new: %v", err)
+	}
+	assertUnixDial(t, sock, false)
+	assertFileExists(t, sock, false)
+}
+
+// TestUnixSocketConcurrentListenClose exercises concurrent binds and closes on
+// the same path; it mainly guards against data races and deadlocks (run with
+// -race) and asserts the socket is cleaned up at the end.
+func TestUnixSocketConcurrentListenClose(t *testing.T) {
+	sock := filepath.Join(shortTempDir(t), "concurrent.sock")
+
+	var wg sync.WaitGroup
+	for range 8 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for range 20 {
+				na, err := ParseNetworkAddress("unix/" + sock)
+				if err != nil {
+					t.Errorf("parse address: %v", err)
+					return
+				}
+				ln, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+				if err != nil {
+					t.Errorf("listen: %v", err)
+					return
+				}
+				if err := ln.(io.Closer).Close(); err != nil {
+					t.Errorf("close: %v", err)
+					return
+				}
+			}
+		}()
+	}
+	wg.Wait()
+
+	assertUnixDial(t, sock, false)
+	assertFileExists(t, sock, false)
+}
+
+// TestUnixSocketAbstractSkipsUnlink pins that closing a Linux abstract socket
+// (name starting with '@') never removes a filesystem entry of the same name.
+func TestUnixSocketAbstractSkipsUnlink(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract unix sockets are Linux-only")
+	}
+
+	tmp := shortTempDir(t)
+	// the abstract socket name is not a path, but a file of the same name
+	// in the working directory is a convenient decoy: if close ever unlinked
+	// the name, it would delete this file
+	t.Chdir(tmp)
+	name := "@caddy-abstract-test"
+	regularFile := filepath.Join(tmp, name)
+	if err := os.WriteFile(regularFile, []byte("do not delete"), 0o600); err != nil {
+		t.Fatalf("creating decoy file: %v", err)
+	}
+
+	na := NetworkAddress{Network: "unix", Host: name}
+	ln, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listen abstract: %v", err)
+	}
+	if err := ln.(io.Closer).Close(); err != nil {
+		t.Fatalf("close abstract: %v", err)
+	}
+
+	if _, err := os.Stat(regularFile); err != nil {
+		t.Fatalf("abstract socket close removed unrelated file: %v", err)
+	}
+}
