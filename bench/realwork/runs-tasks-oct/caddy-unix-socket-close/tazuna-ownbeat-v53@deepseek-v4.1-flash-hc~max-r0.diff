+// unixSocketMaster is a duplicated unix domain socket that outlives any single
+// holder. It is only closed once the last holder has closed, and is used to
+// duplicate the socket for each new holder.
+type unixSocketMaster interface {
+	io.Closer
+	File() (*os.File, error)
+}
+
+// unixSocket is the shared state for one unix domain socket address. It keeps
+// a private master copy of the socket so that a holder closing cannot break
+// reuse by others, and so a close racing with a new listen on the same path
+// always leaves the new listener a working socket and file.
+type unixSocket struct {
+	master   unixSocketMaster
+	mapKey   string
+	addr     string
+	count    int // number of holders; guarded by unixSocketsMu
+	datagram bool
+}
+
+// newUnixListenerHolder creates the shared state for a freshly-bound listener
+// and returns the first holder of it. The original listener is used for the
+// first holder; a separate master copy is retained for future holders.
+// unixSocketsMu must be held.
+func newUnixListenerHolder(ln *net.UnixListener, mapKey, addr string) (*unixListener, error) {
+	master, err := dupUnixListener(ln)
+	if err != nil {
+		return nil, err
+	}
+	s := &unixSocket{master: master, mapKey: mapKey, addr: addr, count: 1}
+	unixSockets[mapKey] = s
+	return &unixListener{UnixListener: ln, shared: s}, nil
+}
+
+// newUnixConnHolder is like newUnixListenerHolder, but for datagram sockets.
+// unixSocketsMu must be held.
+func newUnixConnHolder(uc *net.UnixConn, mapKey, addr string) (*unixConn, error) {
+	master, err := dupUnixConn(uc)
+	if err != nil {
+		return nil, err
+	}
+	s := &unixSocket{master: master, mapKey: mapKey, addr: addr, count: 1, datagram: true}
+	unixSockets[mapKey] = s
+	return &unixConn{UnixConn: uc, shared: s}, nil
+}
+
+// newHolder returns another holder of the shared socket by duplicating its
+// master. unixSocketsMu must be held.
+func (s *unixSocket) newHolder() (any, error) {
+	f, err := s.master.File() // does dup() deep down
+	if err != nil {
+		return nil, err
+	}
+	// net.FileListener/FilePacketConn duplicate the fd again, so the copy
+	// returned by File must be closed by us.
+	defer f.Close()
+
+	if s.datagram {
+		pc, err := net.FilePacketConn(f)
+		if err != nil {
+			return nil, err
+		}
+		s.count++
+		return &unixConn{UnixConn: pc.(*net.UnixConn), shared: s}, nil
+	}
+
+	ln, err := net.FileListener(f)
+	if err != nil {
+		return nil, err
+	}
+	uln := ln.(*net.UnixListener)
+	uln.SetUnlinkOnClose(false)
+	s.count++
+	return &unixListener{UnixListener: uln, shared: s}, nil
+}
+
+// release drops one holder's reference. The socket is closed and its file
+// unlinked only when the last holder has released it. unixSocketsMu must be
+// held by the caller for the map and count to be consistent with listens.
+func (s *unixSocket) release() error {
+	if s.count > 0 {
+		s.count--
+	}
+	if s.count > 0 {
+		return nil
+	}
+	delete(unixSockets, s.mapKey)
+	err := s.master.Close()
+	if unlinkErr := unlinkUnixSocket(s.addr); err == nil {
+		err = unlinkErr
+	}
+	return err
+}
+
+func dupUnixListener(ln *net.UnixListener) (*net.UnixListener, error) {
+	f, err := ln.File()
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	dl, err := net.FileListener(f)
+	if err != nil {
+		return nil, err
+	}
+	uln := dl.(*net.UnixListener)
+	uln.SetUnlinkOnClose(false)
+	return uln, nil
+}
+
+func dupUnixConn(uc *net.UnixConn) (*net.UnixConn, error) {
+	f, err := uc.File()
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	pc, err := net.FilePacketConn(f)
+	if err != nil {
+		return nil, err
+	}
+	return pc.(*net.UnixConn), nil
+}
