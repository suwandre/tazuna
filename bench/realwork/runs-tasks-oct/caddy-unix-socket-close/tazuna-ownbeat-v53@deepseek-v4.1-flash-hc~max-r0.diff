+// unlinkUnixSocket removes the socket file at addr. Abstract sockets (Linux;
+// names starting with '@') have no filesystem entry and are left untouched, so
+// that a regular file that happens to share the name is never deleted. An error
+// is returned unless the file is already gone, in which case there is nothing
+// to remove.
+func unlinkUnixSocket(addr string) error {
+	if addr == "" || strings.HasPrefix(addr, "@") {
+		return nil
+	}
+	if err := syscall.Unlink(addr); err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return err
+	}
+	return nil
+}
