+func isAbstractUnixSocket(addr string) bool {
+	return runtime.GOOS == "linux" && strings.HasPrefix(addr, "@")
+}
+
+// closeUnixSocket serializes the reference count update and final cleanup with new listens.
+func closeUnixSocket(mapKey string, count *atomic.Int32, addr net.Addr, close func() error) error {
+	unixSocketsMu.Lock()
+	defer unixSocketsMu.Unlock()
+
+	newCount := count.Add(-1)
+	err := close()
+	if newCount != 0 {
+		return err
+	}
+
+	if !removeUnixSocket(mapKey, count) {
+		return err
+	}
+	unixAddr, ok := addr.(*net.UnixAddr)
+	if !ok || isAbstractUnixSocket(unixAddr.Name) {
+		return err
 	}
-	return uc.UnixConn.Close()
+	_ = syscall.Unlink(unixAddr.Name)
+	return err
+}
+
+func removeUnixSocket(mapKey string, count *atomic.Int32) bool {
+	var currentCount *atomic.Int32
+	switch socket := unixSockets[mapKey].(type) {
+	case *unixListener:
+		currentCount = socket.count
+	case *unixConn:
+		currentCount = socket.count
+	}
+	if currentCount != count {
+		return false
+	}
+	delete(unixSockets, mapKey)
+	return true
 }
 
