+func unixTestSocketPath(t *testing.T, name string) string {
+	t.Helper()
+	dir, err := os.MkdirTemp("/tmp", "caddy-test-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(dir) })
+	return filepath.Join(dir, name)
+}
+
+func TestUnixListenerCloseAndReuse(t *testing.T) {
+	address := unixTestSocketPath(t, "listener.sock")
+	na := NetworkAddress{Network: "unix", Host: address}
+
+	first, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = first.(net.Listener).Close() })
+	second, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		first.(net.Listener).Close()
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = second.(net.Listener).Close() })
+
+	ln1 := first.(net.Listener)
+	ln2 := second.(net.Listener)
+	if got := ListenerUsage("unix", address); got != 2 {
+		t.Fatalf("listener usage = %d, want 2", got)
+	}
+
+	if err := ln1.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := ln1.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second Close() error = %v, want %v", err, net.ErrClosed)
+	}
+	if got := ListenerUsage("unix", address); got != 1 {
+		t.Fatalf("listener usage after first close = %d, want 1", got)
+	}
+	if _, err := os.Stat(address); err != nil {
+		t.Fatalf("socket file removed while another listener uses it: %v", err)
+	}
+
+	accepted := make(chan error, 1)
+	go func() {
+		conn, err := ln2.Accept()
+		if conn != nil {
+			_ = conn.Close()
+		}
+		accepted <- err
+	}()
+	client, err := net.DialTimeout("unix", address, time.Second)
+	if err != nil {
+		ln2.Close()
+		t.Fatalf("dialing shared listener after closing first holder: %v", err)
+	}
+	_ = client.Close()
+	select {
+	case err := <-accepted:
+		if err != nil {
+			t.Fatalf("accepting on remaining listener: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("remaining listener did not accept a connection")
+	}
+
+	if err := ln2.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(address); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("socket file still exists after final close: %v", err)
+	}
+	if got := ListenerUsage("unix", address); got != 0 {
+		t.Fatalf("listener usage after final close = %d, want 0", got)
+	}
+	if _, err := net.DialTimeout("unix", address, time.Second); err == nil {
+		t.Fatal("dial unexpectedly succeeded after final close")
+	}
+}
+
+func TestUnixListenerCloseRacingWithReuse(t *testing.T) {
+	address := unixTestSocketPath(t, "listener.sock")
+	na := NetworkAddress{Network: "unix", Host: address}
+
+	for i := range 20 {
+		oldAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+		if err != nil {
+			t.Fatalf("iteration %d: listening: %v", i, err)
+		}
+		old := oldAny.(net.Listener)
+		t.Cleanup(func() { _ = old.Close() })
+
+		start := make(chan struct{})
+		closeErr := make(chan error, 1)
+		newListener := make(chan net.Listener, 1)
+		listenErr := make(chan error, 1)
+		go func() {
+			<-start
+			closeErr <- old.Close()
+		}()
+		go func() {
+			<-start
+			ln, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				listenErr <- err
+				return
+			}
+			newListener <- ln.(net.Listener)
+		}()
+		close(start)
+
+		if err := <-closeErr; err != nil {
+			t.Fatalf("iteration %d: closing old listener: %v", i, err)
+		}
+		var ln net.Listener
+		select {
+		case err := <-listenErr:
+			t.Fatalf("iteration %d: listening again: %v", i, err)
+		case ln = <-newListener:
+		}
+		t.Cleanup(func() { _ = ln.Close() })
+
+		if _, err := os.Stat(address); err != nil {
+			ln.Close()
+			t.Fatalf("iteration %d: socket file missing after concurrent reuse: %v", i, err)
+		}
+		accepted := make(chan error, 1)
+		go func() {
+			conn, err := ln.Accept()
+			if conn != nil {
+				_ = conn.Close()
+			}
+			accepted <- err
+		}()
+		client, err := net.DialTimeout("unix", address, time.Second)
+		if err != nil {
+			ln.Close()
+			t.Fatalf("iteration %d: dialing reused listener: %v", i, err)
+		}
+		_ = client.Close()
+		select {
+		case err := <-accepted:
+			if err != nil {
+				ln.Close()
+				t.Fatalf("iteration %d: accepting on reused listener: %v", i, err)
+			}
+		case <-time.After(time.Second):
+			ln.Close()
+			t.Fatalf("iteration %d: reused listener did not accept", i)
+		}
+		if err := ln.Close(); err != nil {
+			t.Fatalf("iteration %d: closing reused listener: %v", i, err)
+		}
+		if _, err := os.Stat(address); !errors.Is(err, os.ErrNotExist) {
+			t.Fatalf("iteration %d: socket file still exists after close: %v", i, err)
+		}
+	}
+}
