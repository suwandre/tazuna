+func TestUnixgramCloseAndReuse(t *testing.T) {
+	address := unixTestSocketPath(t, "packet.sock")
+	na := NetworkAddress{Network: "unixgram", Host: address}
+
+	firstAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = firstAny.(net.PacketConn).Close() })
+	secondAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		firstAny.(net.PacketConn).Close()
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = secondAny.(net.PacketConn).Close() })
+	first := firstAny.(net.PacketConn)
+	second := secondAny.(net.PacketConn)
+	if got := ListenerUsage("unixgram", address); got != 2 {
+		t.Fatalf("packet connection usage = %d, want 2", got)
+	}
+	if err := first.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second Close() error = %v, want %v", err, net.ErrClosed)
+	}
+	if _, err := os.Stat(address); err != nil {
+		t.Fatalf("socket file removed while another packet conn uses it: %v", err)
+	}
+	if got := ListenerUsage("unixgram", address); got != 1 {
+		t.Fatalf("packet connection usage after first close = %d, want 1", got)
+	}
+
+	if err := second.SetReadDeadline(time.Now().Add(time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	client, err := net.Dial("unixgram", address)
+	if err != nil {
+		second.Close()
+		t.Fatal(err)
+	}
+	defer client.Close()
+	if _, err := client.Write([]byte("hello")); err != nil {
+		second.Close()
+		t.Fatal(err)
+	}
+	buf := make([]byte, 5)
+	if _, _, err := second.ReadFrom(buf); err != nil {
+		second.Close()
+		t.Fatalf("reading from remaining packet conn: %v", err)
+	}
+	if string(buf) != "hello" {
+		t.Fatalf("packet payload = %q, want %q", buf, "hello")
+	}
+
+	if err := second.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(address); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("socket file still exists after final close: %v", err)
+	}
+	if got := ListenerUsage("unixgram", address); got != 0 {
+		t.Fatalf("packet connection usage after final close = %d, want 0", got)
+	}
+}
+
+func TestLinuxAbstractUnixSocketCloseDoesNotUnlink(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract Unix sockets are Linux-specific")
+	}
+
+	file, err := os.CreateTemp(".", "@caddy-abstract-*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	fileName := file.Name()
+	if err := file.Close(); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(fileName)
+
+	address := "@" + filepath.Base(fileName)
+	na := NetworkAddress{Network: "unix", Host: address}
+	lnAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ln := lnAny.(net.Listener)
+	t.Cleanup(func() { _ = ln.Close() })
+	if _, err := os.Stat(fileName); err != nil {
+		t.Fatalf("abstract socket bind removed same-named filesystem file: %v", err)
+	}
+	if err := ln.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(fileName); err != nil {
+		t.Fatalf("abstract socket close removed same-named filesystem file: %v", err)
+	}
+}
