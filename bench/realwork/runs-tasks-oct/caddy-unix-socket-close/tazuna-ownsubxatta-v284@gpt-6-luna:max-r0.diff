+
+func TestUnixSocketReferenceClose(t *testing.T) {
+	for _, network := range []string{"unix", "unixpacket", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			address := unixSocketTestPath(t)
+			first := listenUnixSocketForTest(t, network, address)
+			second := listenUnixSocketForTest(t, network, address)
+
+			firstCloser := first.(io.Closer)
+			if err := firstCloser.Close(); err != nil {
+				t.Fatalf("close first listener: %v", err)
+			}
+			if err := firstCloser.Close(); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("second close error = %v; want net.ErrClosed", err)
+			}
+
+			if _, err := os.Stat(address); err != nil {
+				t.Fatalf("socket file missing while another holder is open: %v", err)
+			}
+			if refs, ok := listenerPool.References(listenerKey(network, address)); !ok || refs != 1 {
+				t.Fatalf("listener pool references = %d, %v; want 1, true", refs, ok)
+			}
+
+			assertUnixSocketAccepts(t, network, address, second)
+
+			secondCloser := second.(io.Closer)
+			if err := secondCloser.Close(); err != nil {
+				t.Fatalf("close second listener: %v", err)
+			}
+			if err := secondCloser.Close(); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("second close error = %v; want net.ErrClosed", err)
+			}
+			if _, err := os.Stat(address); !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("socket file stat error after last close = %v; want not-exist", err)
+			}
+			conn, err := net.DialTimeout(network, address, time.Second)
+			if err == nil {
+				_ = conn.Close()
+				t.Fatal("dial succeeded after the last listener closed")
+			}
+		})
+	}
+}
+
+func TestUnixSocketCloseListenRace(t *testing.T) {
+	for i := range 20 {
+		address := unixSocketTestPath(t)
+		old := listenUnixSocketForTest(t, "unix", address)
+
+		start := make(chan struct{})
+		closeResult := make(chan error, 1)
+		listenResult := make(chan struct {
+			listener any
+			err      error
+		}, 1)
+		go func() {
+			<-start
+			closeResult <- old.(io.Closer).Close()
+		}()
+		go func() {
+			<-start
+			listener, err := (NetworkAddress{Network: "unix", Host: address}).Listen(context.Background(), 0, net.ListenConfig{})
+			listenResult <- struct {
+				listener any
+				err      error
+			}{listener, err}
+		}()
+		close(start)
+
+		if err := <-closeResult; err != nil {
+			t.Fatalf("iteration %d: close old listener: %v", i, err)
+		}
+		result := <-listenResult
+		if result.err != nil {
+			t.Fatalf("iteration %d: listen on reused path: %v", i, result.err)
+		}
+		t.Cleanup(func() { _ = result.listener.(io.Closer).Close() })
+		if _, err := os.Stat(address); err != nil {
+			t.Fatalf("iteration %d: new socket file missing: %v", i, err)
+		}
+
+		assertUnixSocketAccepts(t, "unix", address, result.listener)
+		if err := result.listener.(io.Closer).Close(); err != nil {
+			t.Fatalf("iteration %d: close new listener: %v", i, err)
+		}
+		if _, err := os.Stat(address); !errors.Is(err, os.ErrNotExist) {
+			t.Fatalf("iteration %d: socket file stat error after final close = %v; want not-exist", i, err)
+		}
+	}
+}
+
+func TestUnixAbstractSocketDoesNotUnlinkFile(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract Unix sockets are Linux-specific")
+	}
+
+	address := "@caddy-" + filepath.Base(t.TempDir()) + ".sock"
+	if err := os.WriteFile(address, []byte("not a socket"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Remove(address) })
+
+	listener := listenUnixSocketForTest(t, "unix", address)
+	if err := listener.(io.Closer).Close(); err != nil {
+		t.Fatalf("close abstract listener: %v", err)
+	}
+	content, err := os.ReadFile(address)
+	if err != nil {
+		t.Fatalf("abstract socket close removed filesystem file: %v", err)
+	}
+	if string(content) != "not a socket" {
+		t.Fatalf("filesystem file contents changed to %q", content)
+	}
+}
+
+func listenUnixSocketForTest(t *testing.T, network, address string) any {
+	t.Helper()
+	listener, err := (NetworkAddress{Network: network, Host: address}).Listen(context.Background(), 0, net.ListenConfig{})
+	if errors.Is(err, syscall.EPROTONOSUPPORT) {
+		t.Skipf("%s sockets are not supported on %s", network, runtime.GOOS)
+	}
+	if err != nil {
+		t.Fatalf("listen %s %q: %v", network, address, err)
+	}
+	t.Cleanup(func() { _ = listener.(io.Closer).Close() })
+	return listener
+}
+
+func unixSocketTestPath(t *testing.T) string {
+	t.Helper()
+	dir, err := os.MkdirTemp("/tmp", "caddy-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	address := filepath.Join(dir, "listener.sock")
+	t.Cleanup(func() {
+		_ = os.Remove(address)
+		_ = os.Remove(dir)
+	})
+	return address
+}
+
+func assertUnixSocketAccepts(t *testing.T, network, address string, listener any) {
+	t.Helper()
+
+	if network == "unixgram" {
+		server := listener.(net.PacketConn)
+		if err := server.SetReadDeadline(time.Now().Add(2 * time.Second)); err != nil {
+			t.Fatalf("set packet read deadline: %v", err)
+		}
+		client, err := net.DialTimeout(network, address, time.Second)
+		if err != nil {
+			t.Fatalf("dial surviving packet socket: %v", err)
+		}
+		defer client.Close()
+		if _, err := client.Write([]byte("hello")); err != nil {
+			t.Fatalf("write to surviving packet socket: %v", err)
+		}
+		buf := make([]byte, 5)
+		if _, _, err := server.ReadFrom(buf); err != nil {
+			t.Fatalf("read from surviving packet socket: %v", err)
+		}
+		return
+	}
+
+	server := listener.(net.Listener)
+	accepted := make(chan error, 1)
+	go func() {
+		conn, err := server.Accept()
+		if err == nil {
+			err = conn.Close()
+		}
+		accepted <- err
+	}()
+	client, err := net.DialTimeout(network, address, time.Second)
+	if err != nil {
+		t.Fatalf("dial surviving listener: %v", err)
+	}
+	_ = client.Close()
+	select {
+	case err := <-accepted:
+		if err != nil {
+			t.Fatalf("accept from surviving listener: %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("surviving listener did not accept a connection")
+	}
+}
