+// unixSocket owns a file descriptor that remains open while one or more
+// listener or packet connection holders use the socket.
+type unixSocket struct {
+	file    *os.File
+	mapKey  string
+	address string
+	count   atomic.Int32
+}
+
+func newUnixSocket(socket interface{ File() (*os.File, error) }, mapKey, address string) (*unixSocket, error) {
+	file, err := socket.File()
+	if err != nil {
+		return nil, err
+	}
+	socketState := &unixSocket{file: file, mapKey: mapKey, address: address}
+	socketState.count.Store(1)
+	return socketState, nil
+}
+
+func unlinkUnixSocket(address string) error {
+	if runtime.GOOS == "linux" && strings.HasPrefix(address, "@") {
+		return nil
+	}
+	return syscall.Unlink(address)
+}
