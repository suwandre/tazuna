+func TestUnixSocketClose(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			path := t.TempDir() + "/socket"
+			first := listenUnixSocketTest(t, network, path)
+			second := listenUnixSocketTest(t, network, path)
+			t.Cleanup(func() {
+				_ = first.Close()
+				_ = second.Close()
+			})
+
+			if err := second.Close(); err != nil {
+				t.Fatalf("close current socket holder: %v", err)
+			}
+			if _, err := os.Stat(path); err != nil {
+				t.Fatalf("socket file should remain while a holder is open: %v", err)
+			}
+
+			third := listenUnixSocketTest(t, network, path)
+			t.Cleanup(func() { _ = third.Close() })
+			if err := first.Close(); err != nil {
+				t.Fatalf("close first socket: %v", err)
+			}
+			if _, err := os.Stat(path); err != nil {
+				t.Fatalf("socket file should remain while a holder is open: %v", err)
+			}
+
+			switch network {
+			case "unix":
+				listener := third.(net.Listener)
+				accepted := make(chan error, 1)
+				go func() {
+					conn, err := listener.Accept()
+					if err == nil {
+						err = conn.Close()
+					}
+					accepted <- err
+				}()
+
+				conn, err := net.DialTimeout(network, path, time.Second)
+				if err != nil {
+					t.Fatalf("dial surviving listener: %v", err)
+				}
+				if err := conn.Close(); err != nil {
+					t.Fatalf("close client connection: %v", err)
+				}
+				select {
+				case err := <-accepted:
+					if err != nil {
+						t.Fatalf("accept on surviving listener: %v", err)
+					}
+				case <-time.After(time.Second):
+					t.Fatal("surviving listener did not accept a connection")
+				}
+			case "unixgram":
+				packetConn := third.(net.PacketConn)
+				client, err := net.DialTimeout(network, path, time.Second)
+				if err != nil {
+					t.Fatalf("dial surviving packet conn: %v", err)
+				}
+				if _, err := client.Write([]byte("test")); err != nil {
+					_ = client.Close()
+					t.Fatalf("write to surviving packet conn: %v", err)
+				}
+				_ = client.Close()
+				_ = packetConn.SetReadDeadline(time.Now().Add(time.Second))
+				buf := make([]byte, 4)
+				if n, _, err := packetConn.ReadFrom(buf); err != nil {
+					t.Fatalf("read from surviving packet conn: %v", err)
+				} else if string(buf[:n]) != "test" {
+					t.Fatalf("unexpected packet: %q", buf[:n])
+				}
+			}
+
+			if err := third.Close(); err != nil {
+				t.Fatalf("close last socket holder: %v", err)
+			}
+			if !errors.Is(first.Close(), net.ErrClosed) {
+				t.Fatal("first close did not return net.ErrClosed on repeat")
+			}
+			if !errors.Is(second.Close(), net.ErrClosed) {
+				t.Fatal("second close did not return net.ErrClosed")
+			}
+			if _, err := os.Stat(path); !errors.Is(err, fs.ErrNotExist) {
+				t.Fatalf("socket file still exists after last holder closed: %v", err)
+			}
+		})
+	}
+}
+
+func TestUnixSocketCloseListenRace(t *testing.T) {
+	for i := 0; i < 25; i++ {
+		t.Run(string(rune('a'+i)), func(t *testing.T) {
+			path := t.TempDir() + "/socket"
+			old := listenUnixSocketTest(t, "unix", path)
+			start := make(chan struct{})
+			var wg sync.WaitGroup
+			var newListener any
+			var listenErr error
+
+			wg.Add(2)
+			go func() {
+				defer wg.Done()
+				<-start
+				_ = old.Close()
+			}()
+			go func() {
+				defer wg.Done()
+				<-start
+				newListener, listenErr = listenUnixSocketTestResult("unix", path)
+			}()
+			close(start)
+			wg.Wait()
+			if listenErr != nil {
+				t.Fatalf("listen during close: %v", listenErr)
+			}
+			if newListener == nil {
+				t.Fatal("listen during close returned no listener")
+			}
+			defer newListener.(io.Closer).Close()
+
+			if _, err := os.Stat(path); err != nil {
+				t.Fatalf("socket file missing after close/listen race: %v", err)
+			}
+			listener := newListener.(net.Listener)
+			accepted := make(chan error, 1)
+			go func() {
+				conn, err := listener.Accept()
+				if err == nil {
+					err = conn.Close()
+				}
+				accepted <- err
+			}()
+			conn, err := net.DialTimeout("unix", path, time.Second)
+			if err != nil {
+				t.Fatalf("dial listener after close/listen race: %v", err)
+			}
+			_ = conn.Close()
+			select {
+			case err := <-accepted:
+				if err != nil {
+					t.Fatalf("accept after close/listen race: %v", err)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("listener did not accept after close/listen race")
+			}
+		})
+	}
+}
+
+func TestUnixAbstractSocketDoesNotUnlinkPath(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract Unix sockets are Linux-specific")
+	}
+
+	t.Chdir(t.TempDir())
+	const name = "@caddy-test-abstract-socket"
+	if err := os.WriteFile(name, []byte("keep"), 0o600); err != nil {
+		t.Fatalf("create sentinel file: %v", err)
+	}
+
+	listener := listenUnixSocketTest(t, "unix", name)
+	if err := listener.Close(); err != nil {
+		t.Fatalf("close abstract socket: %v", err)
+	}
+	if _, err := os.Stat(name); err != nil {
+		t.Fatalf("abstract socket close removed a filesystem path: %v", err)
+	}
+}
+
+func listenUnixSocketTest(t *testing.T, network, path string) io.Closer {
+	t.Helper()
+	listener, err := listenUnixSocketTestResult(network, path)
+	if err != nil {
+		t.Fatalf("listen on %s socket: %v", network, err)
+	}
+	return listener.(io.Closer)
+}
+
+func listenUnixSocketTestResult(network, path string) (any, error) {
+	return (NetworkAddress{Network: network, Host: path}).Listen(context.Background(), 0, net.ListenConfig{})
+}
