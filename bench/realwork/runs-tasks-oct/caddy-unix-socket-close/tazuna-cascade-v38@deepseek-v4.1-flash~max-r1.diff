+// TestUnixSocketCloseRaceWithRelisten mimics a config reload: a new listener is
+// created on the same path while the old one is closing. The socket must be
+// left working with its file in place for the new listener.
+func TestUnixSocketCloseRaceWithRelisten(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			socketPath := newTempUnixSocketPath(t)
+			na := NetworkAddress{Network: network, Host: socketPath}
+
+			for i := 0; i < 20; i++ {
+				oldLn, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+				if err != nil {
+					t.Fatalf("iteration %d: initial listen: %v", i, err)
+				}
+
+				var (
+					wg        sync.WaitGroup
+					newLn     any
+					listenErr error
+				)
+				wg.Add(2)
+				go func() {
+					defer wg.Done()
+					_ = oldLn.(io.Closer).Close()
+				}()
+				go func() {
+					defer wg.Done()
+					newLn, listenErr = na.Listen(context.Background(), 0, net.ListenConfig{})
+				}()
+				wg.Wait()
+
+				if listenErr != nil {
+					t.Fatalf("iteration %d: relisten: %v", i, listenErr)
+				}
+				if _, err := os.Stat(socketPath); err != nil {
+					t.Fatalf("iteration %d: socket file missing after relisten: %v", i, err)
+				}
+				if network == "unix" {
+					client, err := net.DialTimeout("unix", socketPath, time.Second)
+					if err != nil {
+						t.Fatalf("iteration %d: dialing relistened socket: %v", i, err)
+					}
+					_ = client.Close()
+				}
+				if err := newLn.(io.Closer).Close(); err != nil {
+					t.Fatalf("iteration %d: closing new listener: %v", i, err)
+				}
+			}
+		})
+	}
+}
