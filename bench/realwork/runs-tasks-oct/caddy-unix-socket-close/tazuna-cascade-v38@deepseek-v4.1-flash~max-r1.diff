+// newTempUnixSocketPath returns a short path suitable for a unix socket.
+// The path of t.TempDir() can exceed the sun_path size limit on some systems.
+func newTempUnixSocketPath(t *testing.T) string {
+	t.Helper()
+	f, err := os.CreateTemp("", "caddy-sock-*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := f.Name()
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(path); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Remove(path) })
+	return path
+}
+
+// TestUnixSocketUnlinksOnlyAfterLastHolderCloses verifies that closing one of
+// several holders of a reusable unix socket keeps the socket and its file
+// alive, and that the file is only unlinked when the last holder closes.
+func TestUnixSocketUnlinksOnlyAfterLastHolderCloses(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			socketPath := newTempUnixSocketPath(t)
+			na := NetworkAddress{Network: network, Host: socketPath}
+
+			first, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("first listen: %v", err)
+			}
+			second, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				_ = first.(io.Closer).Close()
+				t.Fatalf("second listen: %v", err)
+			}
+
+			// Closing the first holder must not remove the file while the
+			// second holder is still using the socket.
+			if err := first.(io.Closer).Close(); err != nil {
+				t.Fatalf("closing first holder: %v", err)
+			}
+			if _, err := os.Stat(socketPath); err != nil {
+				t.Fatalf("socket file removed while second holder was open: %v", err)
+			}
+
+			// Closing the last holder must unlink the file immediately.
+			if err := second.(io.Closer).Close(); err != nil {
+				t.Fatalf("closing second holder: %v", err)
+			}
+			if _, err := os.Stat(socketPath); !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("socket file not unlinked after last holder closed: %v", err)
+			}
+
+			// Dialing the path must now fail instead of hanging.
+			client, err := net.DialTimeout(network, socketPath, 500*time.Millisecond)
+			if err == nil {
+				_ = client.Close()
+				t.Fatal("dialing a closed socket succeeded")
+			}
+		})
+	}
+}
