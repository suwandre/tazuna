+// TestUnixSocketDoubleCloseDoesNotReleaseSibling verifies that a second Close
+// of the same listener or conn reports net.ErrClosed and does not decrement
+// the reference count again, which would strand the sibling's reference.
+func TestUnixSocketDoubleCloseDoesNotReleaseSibling(t *testing.T) {
+	t.Run("unix", func(t *testing.T) {
+		socketPath := newTempUnixSocketPath(t)
+		na := NetworkAddress{Network: "unix", Host: socketPath}
+
+		firstAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		first := firstAny.(deleteListener).Listener.(*unixListener)
+		secondAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		second := secondAny.(*unixListener)
+		t.Cleanup(func() {
+			_ = first.Close()
+			_ = second.Close()
+		})
+
+		if err := first.Close(); err != nil {
+			t.Fatalf("first Close: %v", err)
+		}
+		if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+			t.Fatalf("second Close error = %v; want net.ErrClosed", err)
+		}
+		if got := first.count.Load(); got != 1 {
+			t.Fatalf("reference count = %d; want 1", got)
+		}
+		if _, err := os.Stat(socketPath); err != nil {
+			t.Fatalf("socket file removed while second reference was open: %v", err)
+		}
+		if err := second.Close(); err != nil {
+			t.Fatalf("closing second reference: %v", err)
+		}
+	})
+
+	t.Run("unixgram", func(t *testing.T) {
+		socketPath := newTempUnixSocketPath(t)
+		na := NetworkAddress{Network: "unixgram", Host: socketPath}
+
+		firstAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		first := firstAny.(deletePacketConn).PacketConn.(*unixConn)
+		secondAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		second := secondAny.(*unixConn)
+		t.Cleanup(func() {
+			_ = first.Close()
+			_ = second.Close()
+		})
+
+		if err := first.Close(); err != nil {
+			t.Fatalf("first Close: %v", err)
+		}
+		if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+			t.Fatalf("second Close error = %v; want net.ErrClosed", err)
+		}
+		if got := first.count.Load(); got != 1 {
+			t.Fatalf("reference count = %d; want 1", got)
+		}
+		if _, err := os.Stat(socketPath); err != nil {
+			t.Fatalf("socket file removed while second reference was open: %v", err)
+		}
+		if err := second.Close(); err != nil {
+			t.Fatalf("closing second reference: %v", err)
+		}
+	})
+}
