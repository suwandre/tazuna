+// TestUnixSocketAbstractDoesNotUnlinkPath verifies that closing an abstract
+// socket (Linux only) never unlinks a filesystem path of the same name.
+func TestUnixSocketAbstractDoesNotUnlinkPath(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract unix sockets are Linux-specific")
+	}
+
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			f, err := os.CreateTemp(".", "@caddy-abstract-*")
+			if err != nil {
+				t.Fatal(err)
+			}
+			name := filepath.Base(f.Name())
+			if err := f.Close(); err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { _ = os.Remove(name) })
+
+			ln, err := (NetworkAddress{Network: network, Host: name}).Listen(
+				context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := os.Stat(name); err != nil {
+				t.Fatalf("abstract listen removed filesystem path: %v", err)
+			}
+			if err := ln.(io.Closer).Close(); err != nil {
+				t.Fatalf("closing abstract socket: %v", err)
+			}
+			if _, err := os.Stat(name); err != nil {
+				t.Fatalf("abstract close removed filesystem path: %v", err)
+			}
+		})
+	}
+}
