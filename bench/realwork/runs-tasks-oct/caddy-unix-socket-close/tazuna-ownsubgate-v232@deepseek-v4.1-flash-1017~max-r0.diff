+// TestUnixListenerNewestHolderClosesFirst pins that closing the newest
+// holder of a shared socket does not break the socket for older holders
+// or for a subsequent Listen. This is the reload-failure sequence where
+// a new config reuses the socket and is then torn down because a later
+// app failed to start.
+func TestUnixListenerNewestHolderClosesFirst(t *testing.T) {
+	socketPath := shortTempSocket(t)
+	na := NetworkAddress{Network: "unix", Host: socketPath}
+
+	first, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("first listen: %v", err)
+	}
+	defer first.(io.Closer).Close()
+
+	// A second holder is stored as the newest entry in unixSockets.
+	second, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("second listen: %v", err)
+	}
+	if err := second.(io.Closer).Close(); err != nil {
+		t.Fatalf("close second: %v", err)
+	}
+
+	// The first holder must still work and the file must remain.
+	if _, err := os.Stat(socketPath); err != nil {
+		t.Fatalf("socket file was removed while first holder was still open: %v", err)
+	}
+	conn, err := net.DialTimeout("unix", socketPath, time.Second)
+	if err != nil {
+		t.Fatalf("dial after newest holder closed: %v", err)
+	}
+	_ = conn.Close()
+
+	// A later listen must reuse the still-open socket, not fail on a
+	// closed wrapper left in the registry.
+	third, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listen after newest holder closed: %v", err)
+	}
+	conn, err = net.DialTimeout("unix", socketPath, time.Second)
+	if err != nil {
+		t.Fatalf("dial after relisten: %v", err)
+	}
+	_ = conn.Close()
+	if err := third.(io.Closer).Close(); err != nil {
+		t.Fatalf("close third: %v", err)
+	}
+
+	// The file is only removed once the last holder closes.
+	if _, err := os.Stat(socketPath); err != nil {
+		t.Fatalf("socket file was removed while first holder was still open: %v", err)
+	}
+	if err := first.(io.Closer).Close(); err != nil {
+		t.Fatalf("close first: %v", err)
+	}
+	if _, err := os.Stat(socketPath); !os.IsNotExist(err) {
+		t.Fatalf("expected socket file to be unlinked after last close, got: %v", err)
+	}
+}
