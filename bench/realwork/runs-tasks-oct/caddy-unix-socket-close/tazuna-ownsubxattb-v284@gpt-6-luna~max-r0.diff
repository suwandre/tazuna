+// unixSocketTestPath returns a short unix socket path to avoid sockaddr_un
+// path length limits (104 bytes on Darwin/BSD, 108 bytes on Linux),
+// which can be exceeded by t.TempDir() in deeply nested temp directories.
+func unixSocketTestPath(t *testing.T) string {
+	t.Helper()
+	f, err := os.CreateTemp("", "c-*.sock")
+	if err != nil {
+		t.Fatalf("failed to create temp socket path: %v", err)
+	}
+	path := f.Name()
+	_ = f.Close()
+	_ = os.Remove(path)
+	t.Cleanup(func() {
+		_ = os.Remove(path)
+	})
+	return path
+}
