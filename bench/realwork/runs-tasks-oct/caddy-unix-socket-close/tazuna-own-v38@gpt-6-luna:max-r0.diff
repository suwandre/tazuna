+//go:build linux
+
+package caddy
+
+import (
+	"context"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestUnixAbstractSocketCloseDoesNotRemoveFilesystemPath(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			file, err := os.CreateTemp(".", "@caddy-abstract-*")
+			if err != nil {
+				t.Fatal(err)
+			}
+			path := filepath.Base(file.Name())
+			if err := file.Close(); err != nil {
+				t.Fatal(err)
+			}
+			defer os.Remove(path)
+
+			listener, err := (NetworkAddress{Network: network, Host: path}).Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("listen on abstract socket: %v", err)
+			}
+			closer := listener.(interface{ Close() error })
+			t.Cleanup(func() { _ = closer.Close() })
+			if _, err := os.Stat(path); err != nil {
+				t.Fatalf("filesystem entry removed while listening on abstract socket: %v", err)
+			}
+
+			if err := closer.Close(); err != nil {
+				t.Fatalf("close abstract socket: %v", err)
+			}
+			if _, err := os.Stat(path); err != nil {
+				t.Fatalf("filesystem entry removed when closing abstract socket: %v", err)
+			}
+		})
+	}
+}
