+// limitations under the License.
+
+//go:build unix && !solaris
+
+package caddy
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestUnixSocketReferenceCounting(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			path := filepath.Join(unixSocketTestDir(t), "s")
+			address := NetworkAddress{Network: network, Host: path}
+
+			first, err := address.Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("first listen: %v", err)
+			}
+			firstCloser := first.(interface{ Close() error })
+			t.Cleanup(func() { _ = firstCloser.Close() })
+
+			second, err := address.Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("second listen: %v", err)
+			}
+			secondCloser := second.(interface{ Close() error })
+			t.Cleanup(func() { _ = secondCloser.Close() })
+			if got := ListenerUsage(network, path); got != 2 {
+				t.Fatalf("listener usage after two listens: got %d, want 2", got)
+			}
+
+			if err := secondCloser.Close(); err != nil {
+				t.Fatalf("close newest holder: %v", err)
+			}
+			if err := secondCloser.Close(); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("second close of newest holder: got %v, want %v", err, net.ErrClosed)
+			}
+			if got := ListenerUsage(network, path); got != 1 {
+				t.Fatalf("listener usage after closing newest holder: got %d, want 1", got)
+			}
+			if _, err := os.Stat(path); err != nil {
+				t.Fatalf("socket file should remain while first holder is open: %v", err)
+			}
+			assertUnixSocketWorks(t, network, path, first)
+
+			third, err := address.Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("listen again while first holder is open: %v", err)
+			}
+			thirdCloser := third.(interface{ Close() error })
+			t.Cleanup(func() { _ = thirdCloser.Close() })
+			if got := ListenerUsage(network, path); got != 2 {
+				t.Fatalf("listener usage after third listen: got %d, want 2", got)
+			}
+
+			if err := firstCloser.Close(); err != nil {
+				t.Fatalf("close first holder: %v", err)
+			}
+			if err := firstCloser.Close(); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("second close of first holder: got %v, want %v", err, net.ErrClosed)
+			}
+			if got := ListenerUsage(network, path); got != 1 {
+				t.Fatalf("listener usage after closing first holder: got %d, want 1", got)
+			}
+			if _, err := os.Stat(path); err != nil {
+				t.Fatalf("socket file should remain while third holder is open: %v", err)
+			}
+			assertUnixSocketWorks(t, network, path, third)
+
+			if err := thirdCloser.Close(); err != nil {
+				t.Fatalf("close last holder: %v", err)
+			}
+			if err := thirdCloser.Close(); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("second close of last holder: got %v, want %v", err, net.ErrClosed)
+			}
+			if got := ListenerUsage(network, path); got != 0 {
+				t.Fatalf("listener usage after closing last holder: got %d, want 0", got)
+			}
+			if _, err := os.Stat(path); !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("socket file should be removed after last close; stat error: %v", err)
+			}
+		})
+	}
+}
+
+func TestUnixSocketCloseRacingListen(t *testing.T) {
+	root := unixSocketTestDir(t)
+	for i := range 20 {
+		t.Run(fmt.Sprintf("iteration_%d", i), func(t *testing.T) {
+			path := filepath.Join(root, fmt.Sprintf("socket-%d", i))
+			address := NetworkAddress{Network: "unix", Host: path}
+
+			old, err := address.Listen(context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("initial listen: %v", err)
+			}
+			oldCloser := old.(interface{ Close() error })
+			t.Cleanup(func() { _ = oldCloser.Close() })
+
+			start := make(chan struct{})
+			closeResult := make(chan error, 1)
+			listenResult := make(chan struct {
+				listener any
+				err      error
+			}, 1)
+			go func() {
+				<-start
+				closeResult <- oldCloser.Close()
+			}()
+			go func() {
+				<-start
+				listener, err := address.Listen(context.Background(), 0, net.ListenConfig{})
+				listenResult <- struct {
+					listener any
+					err      error
+				}{listener, err}
+			}()
+			close(start)
+
+			if err := <-closeResult; err != nil {
+				t.Fatalf("close old listener: %v", err)
+			}
+			result := <-listenResult
+			if result.err != nil {
+				t.Fatalf("listen during close: %v", result.err)
+			}
+			newListener, ok := result.listener.(net.Listener)
+			if !ok {
+				t.Fatalf("new listener has unexpected type %T", result.listener)
+			}
+			t.Cleanup(func() { _ = newListener.Close() })
+			if got := ListenerUsage("unix", path); got != 1 {
+				t.Fatalf("listener usage after close/listen race: got %d, want 1", got)
+			}
+
+			if _, err := os.Stat(path); err != nil {
+				t.Fatalf("socket file should remain for new listener: %v", err)
+			}
+			assertUnixSocketWorks(t, "unix", path, newListener)
+
+			if err := newListener.Close(); err != nil {
+				t.Fatalf("close new listener: %v", err)
+			}
+			if got := ListenerUsage("unix", path); got != 0 {
+				t.Fatalf("listener usage after closing new listener: got %d, want 0", got)
+			}
+			if _, err := os.Stat(path); !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("socket file should be removed after new listener closes; stat error: %v", err)
+			}
+		})
+	}
+}
+
+func assertUnixSocketWorks(t *testing.T, network, path string, holder any) {
+	t.Helper()
+
+	switch network {
+	case "unix":
+		client, err := net.DialTimeout(network, path, time.Second)
+		if err != nil {
+			t.Fatalf("dial surviving listener: %v", err)
+		}
+		defer client.Close()
+
+		conn, err := holder.(net.Listener).Accept()
+		if err != nil {
+			t.Fatalf("accept on surviving listener: %v", err)
+		}
+		conn.Close()
+
+	case "unixgram":
+		server := holder.(net.PacketConn)
+		if err := server.SetReadDeadline(time.Now().Add(time.Second)); err != nil {
+			t.Fatalf("set read deadline: %v", err)
+		}
+		client, err := net.Dial(network, path)
+		if err != nil {
+			t.Fatalf("dial surviving packet connection: %v", err)
+		}
+		defer client.Close()
+		if _, err := client.Write([]byte("hello")); err != nil {
+			t.Fatalf("write to surviving packet connection: %v", err)
+		}
+
+		buf := make([]byte, 5)
+		n, _, err := server.ReadFrom(buf)
+		if err != nil {
+			t.Fatalf("read from surviving packet connection: %v", err)
+		}
+		if got := string(buf[:n]); got != "hello" {
+			t.Fatalf("read %q, want %q", got, "hello")
+		}
+	}
+}
+
+func unixSocketTestDir(t *testing.T) string {
+	t.Helper()
+
+	dir, err := os.MkdirTemp("", "caddy-uds-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(dir) })
+	return dir
+}
