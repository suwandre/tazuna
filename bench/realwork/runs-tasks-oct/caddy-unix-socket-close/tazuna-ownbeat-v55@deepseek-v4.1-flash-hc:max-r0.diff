+// unixSocketPath returns a path for a unix socket inside a short-lived temp
+// dir, so tests don't collide with each other and stay under the platform's
+// unix socket path length limit (about 104 bytes on macOS).
+func unixSocketPath(t *testing.T, name string) string {
+	t.Helper()
+	dir, err := os.MkdirTemp("", "caddytest")
+	if err != nil {
+		t.Fatalf("creating temp dir: %v", err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	return filepath.Join(dir, name)
+}
+
+func mustListenUnix(t *testing.T, network, path string) any {
+	t.Helper()
+	na, err := ParseNetworkAddress(network + "/" + path)
+	if err != nil {
+		t.Fatalf("parsing address: %v", err)
+	}
+	ln, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listening: %v", err)
+	}
+	return ln
+}
+
+func assertFileExists(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("expected socket file %q to exist: %v", path, err)
+	}
+}
+
+func assertFileRemoved(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Stat(path); !errors.Is(err, fs.ErrNotExist) {
+		t.Fatalf("expected socket file %q to be removed, got err: %v", path, err)
+	}
+}
+
+// TestUnixSocketCloseRemovesFileAndStopsListening is the regression test for
+// the reported bug: closing the last holder of a unix socket must close the
+// underlying socket (so connects are refused) and remove its file, rather than
+// leaving the socket listening until a garbage collection finalizer runs.
+func TestUnixSocketCloseRemovesFileAndStopsListening(t *testing.T) {
+	path := unixSocketPath(t, "admin.sock")
+	ln := mustListenUnix(t, "unix", path)
+
+	assertFileExists(t, path)
+
+	if err := ln.(io.Closer).Close(); err != nil {
+		t.Fatalf("closing listener: %v", err)
+	}
+
+	// The socket must refuse connections immediately, not hang until GC.
+	conn, err := net.DialTimeout("unix", path, time.Second)
+	if err == nil {
+		conn.Close()
+		t.Fatal("expected connection to be refused after socket closed, but it succeeded")
+	}
+
+	assertFileRemoved(t, path)
+}
+
+// TestUnixSocketSharedReferenceCounting checks that a socket shared by several
+// holders is only torn down and unlinked when the last holder closes it.
+func TestUnixSocketSharedReferenceCounting(t *testing.T) {
+	path := unixSocketPath(t, "shared.sock")
+
+	first := mustListenUnix(t, "unix", path).(io.Closer)
+	second := mustListenUnix(t, "unix", path).(net.Listener)
+	defer second.Close()
+
+	// Closing one holder must leave the socket working for the other.
+	if err := first.Close(); err != nil {
+		t.Fatalf("closing first listener: %v", err)
+	}
+	assertFileExists(t, path)
+
+	accepted := make(chan net.Conn, 1)
+	fatal := make(chan error, 1)
+	go func() {
+		conn, err := second.Accept()
+		if err != nil {
+			fatal <- err
+			return
+		}
+		accepted <- conn
+	}()
+
+	dialed, err := net.DialTimeout("unix", path, 2*time.Second)
+	if err != nil {
+		t.Fatalf("dialing socket still in use: %v", err)
+	}
+	defer dialed.Close()
+
+	select {
+	case conn := <-accepted:
+		conn.Close()
+	case err := <-fatal:
+		t.Fatalf("surviving listener returned an error: %v", err)
+	case <-time.After(5 * time.Second):
+		t.Fatal("surviving listener never accepted a connection")
+	}
+
+	// Closing the last holder must remove the file.
+	if err := second.Close(); err != nil {
+		t.Fatalf("closing second listener: %v", err)
+	}
+	assertFileRemoved(t, path)
+}
+
+// TestUnixSocketDoubleClose checks that a second Close on the same listener or
+// packet conn reports net.ErrClosed and does not release an extra reference.
+func TestUnixSocketDoubleClose(t *testing.T) {
+	t.Run("listener", func(t *testing.T) {
+		path := unixSocketPath(t, "double.sock")
+		first := mustListenUnix(t, "unix", path).(io.Closer)
+		second := mustListenUnix(t, "unix", path).(io.Closer)
+		defer second.Close()
+
+		if err := first.Close(); err != nil {
+			t.Fatalf("first close: %v", err)
+		}
+		if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+			t.Fatalf("second close should report net.ErrClosed, got: %v", err)
+		}
+
+		// The extra Close must not have released the sibling's reference.
+		assertFileExists(t, path)
+		conn, err := net.DialTimeout("unix", path, 2*time.Second)
+		if err != nil {
+			t.Fatalf("sibling listener stopped working: %v", err)
+		}
+		conn.Close()
+	})
+
+	t.Run("packet conn", func(t *testing.T) {
+		path := unixSocketPath(t, "double.gram")
+		first := mustListenUnix(t, "unixgram", path).(io.Closer)
+		second := mustListenUnix(t, "unixgram", path).(io.Closer)
+		defer second.Close()
+
+		if err := first.Close(); err != nil {
+			t.Fatalf("first close: %v", err)
+		}
+		if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+			t.Fatalf("second close should report net.ErrClosed, got: %v", err)
+		}
+
+		assertFileExists(t, path)
+	})
+}
+
+// TestUnixSocketCloseRacesListen mimics a config reload: a new listener is
+// opened on the same path while the old one is being closed. Whatever the
+// interleaving, the end state must be a working socket whose file still exists.
+func TestUnixSocketCloseRacesListen(t *testing.T) {
+	for i := 0; i < 50; i++ {
+		path := unixSocketPath(t, "race.sock")
+
+		old := mustListenUnix(t, "unix", path).(io.Closer)
+
+		var wg sync.WaitGroup
+		wg.Add(2)
+
+		var newLn any
+		var listenErr error
+		go func() {
+			defer wg.Done()
+			newLn = mustListenUnixNoFatal(&listenErr, "unix", path)
+		}()
+
+		var closeErr error
+		go func() {
+			defer wg.Done()
+			closeErr = old.Close()
+		}()
+
+		wg.Wait()
+
+		if listenErr != nil {
+			t.Fatalf("iteration %d: new listen failed: %v", i, listenErr)
+		}
+		if closeErr != nil {
+			t.Fatalf("iteration %d: close failed: %v", i, closeErr)
+		}
+
+		ln := newLn.(net.Listener)
+		accepted := make(chan net.Conn, 1)
+		fatal := make(chan error, 1)
+		go func() {
+			conn, err := ln.Accept()
+			if err != nil {
+				fatal <- err
+				return
+			}
+			accepted <- conn
+		}()
+
+		dialed, err := net.DialTimeout("unix", path, 2*time.Second)
+		if err != nil {
+			ln.Close()
+			t.Fatalf("iteration %d: new socket not usable after racing close: %v", i, err)
+		}
+		dialed.Close()
+
+		select {
+		case conn := <-accepted:
+			conn.Close()
+		case err := <-fatal:
+			ln.Close()
+			t.Fatalf("iteration %d: new listener returned an error: %v", i, err)
+		case <-time.After(2 * time.Second):
+			ln.Close()
+			t.Fatalf("iteration %d: new listener never accepted a connection", i)
+		}
+
+		assertFileExists(t, path)
+		ln.Close()
+		assertFileRemoved(t, path)
+	}
+}
+
+// mustListenUnixNoFatal is like mustListenUnix but reports errors instead of
+// failing, so it can be called from a goroutine.
+func mustListenUnixNoFatal(errPtr *error, network, path string) any {
+	na, err := ParseNetworkAddress(network + "/" + path)
+	if err != nil {
+		*errPtr = err
+		return nil
+	}
+	ln, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		*errPtr = err
+		return nil
+	}
+	return ln
+}
+
+// TestAbstractUnixSocketCloseDoesNotUnlinkFile checks that closing a unix
+// socket whose advertised name is abstract (starts with "@", Linux semantics)
+// never unlinks a filesystem path that merely happens to share that name.
+func TestAbstractUnixSocketCloseDoesNotUnlinkFile(t *testing.T) {
+	dir, err := os.MkdirTemp("", "caddytest")
+	if err != nil {
+		t.Fatalf("creating temp dir: %v", err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	t.Chdir(dir)
+
+	// A regular file named exactly like the abstract socket.
+	const abstractName = "@caddy-abstract"
+	if err := os.WriteFile(abstractName, []byte("do not delete me"), 0o600); err != nil {
+		t.Fatalf("creating file: %v", err)
+	}
+
+	// Build a real unix listener but give the wrapper an abstract addr, which
+	// is what a `unix/@name` config would look like after parsing.
+	raw, err := net.Listen("unix", filepath.Join(dir, "real.sock"))
+	if err != nil {
+		t.Fatalf("creating raw listener: %v", err)
+	}
+	cnt := new(atomic.Int32)
+	cnt.Store(1)
+	key := listenerKey("unix", abstractName)
+	uln := &unixListener{
+		UnixListener: raw.(*net.UnixListener),
+		mapKey:       key,
+		addr:         abstractName,
+		count:        cnt,
+	}
+	unixSocketsMu.Lock()
+	unixSockets[key] = uln
+	unixSocketsMu.Unlock()
+
+	if err := uln.Close(); err != nil {
+		t.Fatalf("closing listener: %v", err)
+	}
+
+	if _, err := os.Stat(abstractName); err != nil {
+		t.Fatalf("abstract socket close must not unlink %q: %v", abstractName, err)
+	}
+}
