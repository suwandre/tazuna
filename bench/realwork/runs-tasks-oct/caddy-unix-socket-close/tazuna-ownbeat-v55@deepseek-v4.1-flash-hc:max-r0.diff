+// releaseUnixSocket drops one reference to the shared unix socket identified
+// by key. When the caller held the last reference, the socket is removed from
+// unixSockets and its filesystem path is unlinked. Taking unixSocketsMu around
+// the whole operation keeps it atomic with respect to a concurrent Listen on the
+// same path (which holds the same lock while reusing or binding a socket): a
+// listener that has already taken over the socket keeps the count positive, so
+// both the socket and its file are left alone.
+func releaseUnixSocket(key string, count *atomic.Int32, addr string) {
+	unixSocketsMu.Lock()
+	defer unixSocketsMu.Unlock()
+
+	// A positive remaining count means at least one other holder is still
+	// using the socket, so it must keep listening and its file must remain.
+	if count.Add(-1) > 0 {
+		return
+	}
+	delete(unixSockets, key)
+
+	// Abstract unix sockets (Linux only) have no filesystem entry, so never
+	// unlink a path that merely happens to share their name.
+	if isAbstractUnixSocket(addr) {
+		return
+	}
+	_ = syscall.Unlink(addr)
+}
