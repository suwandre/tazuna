+// newShortSocketPath returns a socket path short enough for sockaddr_un on
+// every supported Unix platform.
+func newShortSocketPath(t *testing.T) string {
+	t.Helper()
+	f, err := os.CreateTemp("", "caddy-close-*.sock")
+	if err != nil {
+		t.Fatal(err)
+	}
+	name := f.Name()
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(name); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Remove(name) })
+	return name
+}
+
+func TestUnixSocketCloseImmediatelyUnlinks(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			socketPath := newShortSocketPath(t)
+			ln, err := (NetworkAddress{Network: network, Host: socketPath}).Listen(
+				context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := os.Stat(socketPath); err != nil {
+				t.Fatalf("socket file missing after listen: %v", err)
+			}
+			defer ln.(io.Closer).Close() //nolint:errcheck
+
+			if err := ln.(io.Closer).Close(); err != nil {
+				t.Fatalf("closing listener: %v", err)
+			}
+			if _, err := os.Stat(socketPath); !os.IsNotExist(err) {
+				t.Fatalf("socket file still exists after close: %v", err)
+			}
+		})
+	}
+}
+
+func TestUnixSocketSharedReferenceClose(t *testing.T) {
+	t.Run("unix", func(t *testing.T) {
+		socketPath := newShortSocketPath(t)
+		na := NetworkAddress{Network: "unix", Host: socketPath}
+
+		firstAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		first := firstAny.(deleteListener)
+		firstInner := first.Listener.(*unixListener)
+
+		secondAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		second := secondAny.(*unixListener)
+		t.Cleanup(func() {
+			_ = first.Close()
+			_ = second.Close()
+		})
+
+		if err := firstInner.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if err := firstInner.Close(); !errors.Is(err, net.ErrClosed) {
+			t.Fatalf("second close error = %v; want net.ErrClosed", err)
+		}
+		if got := firstInner.count.Load(); got != 1 {
+			t.Fatalf("reference count = %d; want 1", got)
+		}
+		if _, err := os.Stat(socketPath); err != nil {
+			t.Fatalf("socket removed while still referenced: %v", err)
+		}
+
+		// The remaining reference must still accept connections.
+		accepted := make(chan struct{})
+		go func() {
+			defer close(accepted)
+			conn, err := second.Accept()
+			if err == nil {
+				_ = conn.Close()
+			}
+		}()
+		conn, err := net.DialTimeout("unix", socketPath, 2*time.Second)
+		if err != nil {
+			t.Fatalf("dialing remaining listener: %v", err)
+		}
+		_ = conn.Close()
+		select {
+		case <-accepted:
+		case <-time.After(2 * time.Second):
+			t.Fatal("remaining listener did not accept")
+		}
+
+		if err := second.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := os.Stat(socketPath); !os.IsNotExist(err) {
+			t.Fatalf("socket file still exists after last close: %v", err)
+		}
+	})
+
+	t.Run("unixgram", func(t *testing.T) {
+		socketPath := newShortSocketPath(t)
+		na := NetworkAddress{Network: "unixgram", Host: socketPath}
+
+		firstAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		first := firstAny.(deletePacketConn)
+		firstInner := first.PacketConn.(*unixConn)
+
+		secondAny, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		second := secondAny.(*unixConn)
+		t.Cleanup(func() {
+			_ = first.Close()
+			_ = second.Close()
+		})
+
+		if err := firstInner.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if err := firstInner.Close(); !errors.Is(err, net.ErrClosed) {
+			t.Fatalf("second close error = %v; want net.ErrClosed", err)
+		}
+		if got := firstInner.count.Load(); got != 1 {
+			t.Fatalf("reference count = %d; want 1", got)
+		}
+		if _, err := os.Stat(socketPath); err != nil {
+			t.Fatalf("socket removed while still referenced: %v", err)
+		}
+
+		if err := second.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := os.Stat(socketPath); !os.IsNotExist(err) {
+			t.Fatalf("socket file still exists after last close: %v", err)
+		}
+	})
+}
