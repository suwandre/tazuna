+func TestUnixSocketConcurrentCloseAndRelisten(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			socketPath := newShortSocketPath(t)
+			na := NetworkAddress{Network: network, Host: socketPath}
+
+			for i := 0; i < 10; i++ {
+				initial, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+				if err != nil {
+					t.Fatalf("iteration %d: initial listen: %v", i, err)
+				}
+
+				var wg sync.WaitGroup
+				wg.Add(2)
+				var relistened any
+				var relistenErr error
+				go func() {
+					defer wg.Done()
+					_ = initial.(io.Closer).Close()
+				}()
+				go func() {
+					defer wg.Done()
+					relistened, relistenErr = na.Listen(context.Background(), 0, net.ListenConfig{})
+				}()
+				wg.Wait()
+
+				if relistenErr != nil {
+					t.Fatalf("iteration %d: relisten: %v", i, relistenErr)
+				}
+				if _, err := os.Stat(socketPath); err != nil {
+					t.Fatalf("iteration %d: socket missing after relisten: %v", i, err)
+				}
+				if network == "unix" {
+					conn, err := net.DialTimeout("unix", socketPath, time.Second)
+					if err != nil {
+						t.Fatalf("iteration %d: dialing relistened socket: %v", i, err)
+					}
+					_ = conn.Close()
+				}
+				if err := relistened.(io.Closer).Close(); err != nil {
+					t.Fatalf("iteration %d: closing relistened socket: %v", i, err)
+				}
+				if _, err := os.Stat(socketPath); !os.IsNotExist(err) {
+					t.Fatalf("iteration %d: socket file still exists after final close: %v", i, err)
+				}
+			}
+		})
+	}
+}
+
+func TestUnixAbstractSocketCloseDoesNotUnlinkFile(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract Unix sockets are Linux-specific")
+	}
+
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			sentinel, err := os.CreateTemp(".", "@caddy-abstract-*")
+			if err != nil {
+				t.Fatal(err)
+			}
+			name := filepath.Base(sentinel.Name())
+			if err := sentinel.Close(); err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { _ = os.Remove(name) })
+
+			ln, err := (NetworkAddress{Network: network, Host: name}).Listen(
+				context.Background(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := os.Stat(name); err != nil {
+				t.Fatalf("abstract listen removed sentinel: %v", err)
+			}
+			if err := ln.(io.Closer).Close(); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := os.Stat(name); err != nil {
+				t.Fatalf("abstract close removed sentinel: %v", err)
+			}
+		})
+	}
+}
