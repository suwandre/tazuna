+// closeUnixSocket closes one holder and cleans up the shared socket when it is
+// the last holder.
+func closeUnixSocket(state *unixSocketState, holder unixSocketHolder, closeFunc func() error) error {
+	unixSocketsMu.Lock()
+	defer unixSocketsMu.Unlock()
