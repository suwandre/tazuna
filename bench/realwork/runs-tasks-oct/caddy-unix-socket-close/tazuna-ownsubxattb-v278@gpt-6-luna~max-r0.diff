+func TestUnixAbstractSocketCloseDoesNotUnlink(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract Unix sockets are Linux-specific")
+	}
+
+	t.Chdir(t.TempDir())
+	address := "@caddy-test-" + strings.ReplaceAll(t.Name(), "/", "-")
+	if err := os.WriteFile(address, []byte("keep"), 0o600); err != nil {
+		t.Fatalf("create file named like abstract socket: %v", err)
+	}
+
+	na := NetworkAddress{Network: "unix", Host: address}
+	lnAny, err := na.Listen(t.Context(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listen on abstract socket: %v", err)
+	}
+	ln := lnAny.(net.Listener)
+	if err := ln.Close(); err != nil {
+		t.Fatalf("close abstract listener: %v", err)
+	}
+
+	if got, err := os.ReadFile(address); err != nil {
+		t.Fatalf("read file named like abstract socket: %v", err)
+	} else if string(got) != "keep" {
+		t.Fatalf("file named like abstract socket changed: got %q", got)
+	}
+}
+
+func assertUnixSocketExists(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("stat Unix socket: %v", err)
+	}
+}
+
+func assertUnixSocketRemoved(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Stat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("stat removed Unix socket: got %v", err)
+	}
+}
+
+func assertUnixListenerAccepts(t *testing.T, ln net.Listener) {
+	t.Helper()
+	accepted := make(chan error, 1)
+	go func() {
+		conn, err := ln.Accept()
+		if err == nil {
+			err = conn.Close()
+		}
+		accepted <- err
+	}()
+
+	conn, err := net.DialTimeout("unix", ln.Addr().String(), 2*time.Second)
+	if err != nil {
+		t.Fatalf("dial Unix listener: %v", err)
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatalf("close Unix client: %v", err)
+	}
+	select {
+	case err := <-accepted:
+		if err != nil {
+			t.Fatalf("accept Unix connection: %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out waiting for Unix listener to accept connection")
+	}
+}
