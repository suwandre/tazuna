+func TestUnixListenerClose(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "listener.sock")
+	address := NetworkAddress{Network: "unix", Host: path}
+
+	firstAny, err := address.Listen(t.Context(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("first listen: %v", err)
+	}
+	first := firstAny.(net.Listener)
+
+	secondAny, err := address.Listen(t.Context(), 0, net.ListenConfig{})
+	if err != nil {
+		first.Close()
+		t.Fatalf("second listen: %v", err)
+	}
+	second := secondAny.(net.Listener)
+
+	if err := second.Close(); err != nil {
+		t.Fatalf("close second listener: %v", err)
+	}
+	if err := second.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close of second listener: got %v, want %v", err, net.ErrClosed)
+	}
+	assertUnixSocketExists(t, path)
+	assertUnixListenerAccepts(t, first)
+
+	thirdAny, err := address.Listen(t.Context(), 0, net.ListenConfig{})
+	if err != nil {
+		first.Close()
+		t.Fatalf("third listen: %v", err)
+	}
+	third := thirdAny.(net.Listener)
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("close first listener: %v", err)
+	}
+	if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close of first listener: got %v, want %v", err, net.ErrClosed)
+	}
+	assertUnixSocketExists(t, path)
+	assertUnixListenerAccepts(t, third)
+
+	if err := third.Close(); err != nil {
+		t.Fatalf("close third listener: %v", err)
+	}
+	if err := third.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close of third listener: got %v, want %v", err, net.ErrClosed)
+	}
+	assertUnixSocketRemoved(t, path)
+}
+
+func TestUnixPacketConnClose(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "packet.sock")
+	address := NetworkAddress{Network: "unixgram", Host: path}
+
+	firstAny, err := address.Listen(t.Context(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("first listen: %v", err)
+	}
+	first := firstAny.(net.PacketConn)
+
+	secondAny, err := address.Listen(t.Context(), 0, net.ListenConfig{})
+	if err != nil {
+		first.Close()
+		t.Fatalf("second listen: %v", err)
+	}
+	second := secondAny.(net.PacketConn)
+
+	if err := first.Close(); err != nil {
+		t.Fatalf("close first packet conn: %v", err)
+	}
+	if err := first.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close of first packet conn: got %v, want %v", err, net.ErrClosed)
+	}
+	assertUnixSocketExists(t, path)
+
+	sender, err := net.Dial("unixgram", path)
+	if err != nil {
+		t.Fatalf("dial surviving packet conn: %v", err)
+	}
+	if _, err := sender.Write([]byte("hello")); err != nil {
+		sender.Close()
+		t.Fatalf("send packet: %v", err)
+	}
+	sender.Close()
+	_ = second.SetReadDeadline(time.Now().Add(2 * time.Second))
+	buf := make([]byte, 5)
+	if _, _, err := second.ReadFrom(buf); err != nil {
+		t.Fatalf("read packet from surviving conn: %v", err)
+	}
+
+	if err := second.Close(); err != nil {
+		t.Fatalf("close second packet conn: %v", err)
+	}
+	if err := second.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("second close of second packet conn: got %v, want %v", err, net.ErrClosed)
+	}
+	assertUnixSocketRemoved(t, path)
+}
+
+func TestUnixSocketCloseRaceWithListen(t *testing.T) {
+	dir, err := os.MkdirTemp("", "caddy-u")
+	if err != nil {
+		t.Fatalf("create temporary directory: %v", err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(dir) })
+	for i := 0; i < 20; i++ {
+		t.Run(string(rune('a'+i)), func(t *testing.T) {
+			path := filepath.Join(dir, "listener-"+string(rune('a'+i))+".sock")
+			address := NetworkAddress{Network: "unix", Host: path}
+
+			baseAny, err := address.Listen(t.Context(), 0, net.ListenConfig{})
+			if err != nil {
+				t.Fatalf("base listen: %v", err)
+			}
+			base := baseAny.(net.Listener)
+
+			oldAny, err := address.Listen(t.Context(), 0, net.ListenConfig{})
+			if err != nil {
+				base.Close()
+				t.Fatalf("old listen: %v", err)
+			}
+			old := oldAny.(net.Listener)
+
+			start := make(chan struct{})
+			var (
+				newAny any
+				newErr error
+				oldErr error
+			)
+			var wg sync.WaitGroup
+			wg.Add(2)
+			go func() {
+				defer wg.Done()
+				<-start
+				oldErr = old.Close()
+			}()
+			go func() {
+				defer wg.Done()
+				<-start
+				newAny, newErr = address.Listen(t.Context(), 0, net.ListenConfig{})
+			}()
+			close(start)
+			wg.Wait()
+
+			if oldErr != nil {
+				t.Fatalf("close old listener: %v", oldErr)
+			}
+			if newErr != nil {
+				t.Fatalf("new listen: %v", newErr)
+			}
+			newListener := newAny.(net.Listener)
+			assertUnixSocketExists(t, path)
+			assertUnixListenerAccepts(t, newListener)
+			if err := newListener.Close(); err != nil {
+				t.Fatalf("close new listener: %v", err)
+			}
+			assertUnixSocketExists(t, path)
+			assertUnixListenerAccepts(t, base)
+			if err := base.Close(); err != nil {
+				t.Fatalf("close base listener: %v", err)
+			}
+			assertUnixSocketRemoved(t, path)
+		})
+	}
+}
