+// isAbstractUnixSocket reports whether addr names a Linux abstract unix
+// socket, which does not have a corresponding file in the filesystem.
+func isAbstractUnixSocket(addr string) bool {
+	return strings.HasPrefix(addr, "@")
+}
+
+// newUnixSocket creates the shared, reference-counted state for a unix socket
+// and registers it so that it can be reused by a future config. The caller must
+// hold unixSocketsMu.
+func newUnixSocket(key, addr string, socket interface{ File() (*os.File, error) }) (*unixSocket, error) {
+	file, err := socket.File()
+	if err != nil {
+		return nil, err
+	}
+
+	us := &unixSocket{key: key, file: file}
+	if !isAbstractUnixSocket(addr) {
+		us.path = addr
+	}
+	us.refs.Store(1)
+	unixSockets[key] = us
+	return us, nil
+}
