+// unixSocket is the shared state of a unix domain socket that may be reused
+// by multiple listeners or packet conns (e.g. across config reloads). The
+// file descriptor is kept open for as long as any holder needs it, and the
+// socket file (if any) is removed when the last holder releases it.
+type unixSocket struct {
+	key  string // key in unixSockets
+	path string // filesystem path to unlink on last release; empty for abstract sockets
+	file *os.File
+
+	refs atomic.Int32
+}
+
+// release drops one reference to the socket. When the last reference is
+// dropped, the socket is removed from the reuse map and its file is unlinked
+// and closed. unixSocketsMu is held throughout, including the decrement, so
+// that a concurrent listen on the same path either reuses this socket or binds
+// a fresh one after it is gone, but never races with the unlink or with the
+// last reference going away.
+func (us *unixSocket) release() {
+	unixSocketsMu.Lock()
+	defer unixSocketsMu.Unlock()
+
+	if us.refs.Add(-1) > 0 {
+		return
+	}
+
+	if unixSockets[us.key] == us {
+		delete(unixSockets, us.key)
+	}
+
+	// Remove the file before closing the last descriptor so that a new
+	// listen on the same path can bind right away. Abstract sockets have
+	// no file; unlinking a filesystem path of the same name would be wrong.
+	if us.path != "" {
+		if err := syscall.Unlink(us.path); err != nil && !errors.Is(err, fs.ErrNotExist) {
+			Log().Warn("unlinking unix socket", zap.String("path", us.path), zap.Error(err))
+		}
+	}
+	_ = us.file.Close()
+}
+
 // unixSockets keeps track of the currently-active unix sockets
 // so we can transfer their FDs gracefully during reloads.
-var unixSockets = make(map[string]interface {
-	File() (*os.File, error)
