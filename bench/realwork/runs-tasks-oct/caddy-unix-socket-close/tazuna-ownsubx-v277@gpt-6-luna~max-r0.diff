+//go:build unix && !solaris
+
+package caddy
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+	"time"
+)
+
+func TestUnixSocketSharedClose(t *testing.T) {
+	networks := []string{"unix", "unixgram"}
+	if runtime.GOOS == "linux" {
+		networks = append(networks, "unixpacket")
+	}
+	for _, network := range networks {
+		t.Run(network, func(t *testing.T) {
+			address := filepath.Join(t.TempDir(), "socket")
+			first := listenTestUnixSocket(t, network, address)
+			second := listenTestUnixSocket(t, network, address)
+
+			if err := second.Close(); err != nil {
+				t.Fatalf("close second holder: %v", err)
+			}
+			if err := second.Close(); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("second close error = %v, want net.ErrClosed", err)
+			}
+			assertUnixSocketExists(t, address)
+
+			third := listenTestUnixSocket(t, network, address)
+			if got := ListenerUsage(network, address); got != 2 {
+				t.Fatalf("listener usage = %d, want 2", got)
+			}
+
+			if err := first.Close(); err != nil {
+				t.Fatalf("close first holder: %v", err)
+			}
+			assertUnixSocketExists(t, address)
+			assertUnixSocketWorks(t, network, address, third)
+
+			if err := third.Close(); err != nil {
+				t.Fatalf("close last holder: %v", err)
+			}
+			if err := third.Close(); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("second close error = %v, want net.ErrClosed", err)
+			}
+			assertUnixSocketRemoved(t, address)
+		})
+	}
+}
+
+func TestUnixSocketCloseRacingListen(t *testing.T) {
+	for i := range 20 {
+		t.Run(fmt.Sprint(i), func(t *testing.T) {
+			address := filepath.Join(t.TempDir(), "socket")
+			old := listenTestUnixSocket(t, "unix", address)
+			start := make(chan struct{})
+			closeDone := make(chan error, 1)
+			type listenResult struct {
+				listener net.Listener
+				err      error
+			}
+			listenDone := make(chan listenResult, 1)
+
+			go func() {
+				<-start
+				closeDone <- old.Close()
+			}()
+			go func() {
+				<-start
+				ln, err := (NetworkAddress{Network: "unix", Host: address}).Listen(context.Background(), 0, net.ListenConfig{})
+				if err != nil {
+					listenDone <- listenResult{err: err}
+					return
+				}
+				listenDone <- listenResult{listener: ln.(net.Listener)}
+			}()
+
+			close(start)
+			if err := <-closeDone; err != nil {
+				t.Fatalf("close old listener: %v", err)
+			}
+			result := <-listenDone
+			if result.err != nil {
+				t.Fatalf("listen during close: %v", result.err)
+			}
+			assertUnixSocketExists(t, address)
+			t.Cleanup(func() { _ = result.listener.Close() })
+			assertUnixSocketWorks(t, "unix", address, result.listener)
+			if err := result.listener.Close(); err != nil {
+				t.Fatalf("close new listener: %v", err)
+			}
+			assertUnixSocketRemoved(t, address)
+		})
+	}
+}
+
+func TestUnixAbstractSocketDoesNotUnlinkFilesystemPath(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract Unix sockets are specific to Linux")
+	}
+
+	marker, err := os.CreateTemp(".", "@caddy-abstract-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	address := "@" + filepath.Base(marker.Name())
+	if err := marker.Close(); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(address)
+
+	listener := listenTestUnixSocket(t, "unix", address)
+	if err := listener.Close(); err != nil {
+		t.Fatalf("close abstract socket: %v", err)
+	}
+	assertUnixSocketExists(t, address)
+}
+
+func listenTestUnixSocket(t *testing.T, network, address string) interface{ Close() error } {
+	t.Helper()
+	ln, err := (NetworkAddress{Network: network, Host: address}).Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listen on %s socket: %v", network, err)
+	}
+	closer := ln.(interface{ Close() error })
+	t.Cleanup(func() { _ = closer.Close() })
+	return closer
+}
+
+func assertUnixSocketWorks(t *testing.T, network, address string, socket any) {
+	t.Helper()
+	if network == "unixgram" {
+		pc := socket.(net.PacketConn)
+		readDone := make(chan error, 1)
+		go func() {
+			buf := make([]byte, 1)
+			_, _, err := pc.ReadFrom(buf)
+			readDone <- err
+		}()
+		client, err := net.DialTimeout(network, address, time.Second)
+		if err != nil {
+			t.Fatalf("dial socket: %v", err)
+		}
+		if _, err := client.Write([]byte("x")); err != nil {
+			t.Fatalf("write to socket: %v", err)
+		}
+		_ = client.Close()
+		select {
+		case err := <-readDone:
+			if err != nil {
+				t.Fatalf("read from socket: %v", err)
+			}
+		case <-time.After(2 * time.Second):
+			t.Fatal("packet connection did not receive a packet")
+		}
+		return
+	}
+
+	ln := socket.(net.Listener)
+	acceptDone := make(chan error, 1)
+	go func() {
+		conn, err := ln.Accept()
+		if err == nil {
+			_ = conn.Close()
+		}
+		acceptDone <- err
+	}()
+	client, err := net.DialTimeout(network, address, time.Second)
+	if err != nil {
+		t.Fatalf("dial socket: %v", err)
+	}
+	_ = client.Close()
+	select {
+	case err := <-acceptDone:
+		if err != nil {
+			t.Fatalf("accept connection: %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("listener did not accept a connection")
+	}
+}
+
+func assertUnixSocketExists(t *testing.T, address string) {
+	t.Helper()
+	if _, err := os.Stat(address); err != nil {
+		t.Fatalf("stat socket %q: %v", address, err)
+	}
+}
+
+func assertUnixSocketRemoved(t *testing.T, address string) {
+	t.Helper()
+	if _, err := os.Stat(address); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("stat socket %q error = %v, want not exist", address, err)
+	}
+}
