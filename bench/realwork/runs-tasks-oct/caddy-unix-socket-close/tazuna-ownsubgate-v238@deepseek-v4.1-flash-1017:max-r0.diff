+// unixSocketState is the state shared by all the holders of a reusable unix
+// socket. The master file is an independent duplicate of the listening socket
+// used only to make new listeners or packet conns for future holders, so that
+// closing any one holder does not affect the others. The socket file is only
+// removed once the last holder has released it.
+//
+// All fields are guarded by unixSocketsMu.
+type unixSocketState struct {
+	file     *os.File
+	key      string
+	path     string
+	datagram bool
+	refs     int
+}
+
+func newUnixSocketState(file *os.File, key, path string, datagram bool) *unixSocketState {
+	return &unixSocketState{file: file, key: key, path: path, datagram: datagram, refs: 1}
+}
+
+// release drops one reference to the socket. When the last reference is
+// dropped, the master file is closed and the socket file is removed. The
+// caller must not hold unixSocketsMu.
+func (s *unixSocketState) release() {
+	unixSocketsMu.Lock()
+	defer unixSocketsMu.Unlock()
+
+	s.refs--
+	if s.refs > 0 {
+		return
+	}
+
+	// Binds are serialized by unixSocketsMu, so no newer state can have taken
+	// this one's place in the map; still, only remove and unlink what is ours,
+	// so a newer socket's file can never be removed by a stale close.
+	if unixSockets[s.key] != s {
+		return
+	}
+	delete(unixSockets, s.key)
+
+	_ = s.file.Close()
+
+	// Abstract sockets (names starting with "@") have no file in the
+	// filesystem, so unlinking would remove an unrelated file of that name.
+	// Unlinking while holding the lock prevents a concurrent listen from
+	// binding the path between our close and our unlink.
+	if !isAbstractUnixSocket(s.path) {
+		_ = syscall.Unlink(s.path)
+	}
+}
+
+// dupSocketFile returns an independent duplicate of the socket file descriptor
+// as an *os.File that is safe to hand to net.FileListener or net.FilePacketConn.
+//
+// We deliberately do not use the File method of net.UnixListener or net.UnixConn
+// here: the *os.File it returns is marked as blocking, and calling its Fd method
+// (which net.FileListener does) clears O_NONBLOCK on the shared file description.
+// That would make a concurrent Accept on an already-serving listener block in the
+// kernel, so closing that listener would then hang. Duping the raw descriptor and
+// wrapping it with os.NewFile leaves the blocking mode of the shared file
+// description untouched.
+func dupSocketFile(conn syscall.Conn, name string) (*os.File, error) {
+	rawConn, err := conn.SyscallConn()
+	if err != nil {
+		return nil, err
+	}
+
+	var (
+		dupFd  int
+		dupErr error
+	)
+	if err := rawConn.Control(func(fd uintptr) {
+		dupFd, dupErr = unix.Dup(int(fd))
+	}); err != nil {
+		return nil, err
+	}
+	if dupErr != nil {
+		return nil, dupErr
+	}
+	unix.CloseOnExec(dupFd)
+
+	// The duplicate shares the file description with the listening socket,
+	// which is already non-blocking, so this is a no-op in practice; but make
+	// sure of it before wrapping the descriptor in a file.
+	if err := unix.SetNonblock(dupFd, true); err != nil {
+		_ = unix.Close(dupFd)
+		return nil, err
+	}
+
+	file := os.NewFile(uintptr(dupFd), name)
+	if file == nil {
+		_ = unix.Close(dupFd)
+		return nil, fmt.Errorf("making file for socket descriptor %d", dupFd)
+	}
+	return file, nil
+}
+
 // unixSockets keeps track of the currently-active unix sockets
 // so we can transfer their FDs gracefully during reloads.
-var unixSockets = make(map[string]interface {
