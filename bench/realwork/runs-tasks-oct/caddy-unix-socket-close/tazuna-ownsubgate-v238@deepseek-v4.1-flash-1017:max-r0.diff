+)
+
+// tempSocketPath returns a path to a socket file in a short temporary
+// directory, since unix socket paths are limited to ~100 bytes on some
+// platforms (e.g. macOS).
+func tempSocketPath(t *testing.T) string {
+	t.Helper()
+	dir, err := os.MkdirTemp("", "caddysock")
+	if err != nil {
+		t.Fatalf("creating temp dir: %v", err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(dir) })
+	return filepath.Join(dir, "s")
+}
+
+// listenUnixSocket listens on the given unix network and path and returns
+// the resulting listener or packet conn.
+func listenUnixSocket(t *testing.T, network, path string) any {
+	t.Helper()
+	na, err := ParseNetworkAddress(network + "/" + path)
+	if err != nil {
+		t.Fatalf("parsing address: %v", err)
+	}
+	ln, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listening on %s: %v", path, err)
+	}
+	return ln
+}
+
+// acceptOne accepts a single connection and closes it.
+func acceptOne(ln net.Listener) <-chan error {
+	done := make(chan error, 1)
+	go func() {
+		conn, err := ln.Accept()
+		if err != nil {
+			done <- err
+			return
+		}
+		_ = conn.Close()
+		done <- nil
+	}()
+	return done
+}
+
+func assertSocketFileGone(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Stat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("expected socket file %s to be removed, got: %v", path, err)
+	}
+}
+
+func assertConnectRefused(t *testing.T, network, path string) {
+	t.Helper()
+	conn, err := net.DialTimeout(network, path, time.Second)
+	if err == nil {
+		_ = conn.Close()
+		t.Fatalf("expected dialing %s to fail after close, but it succeeded", path)
+	}
+}
+
+func TestUnixSocketCloseRemovesFile(t *testing.T) {
+	for _, network := range []string{"unix", "unixpacket"} {
+		t.Run(network, func(t *testing.T) {
+			if network == "unixpacket" && runtime.GOOS == "darwin" {
+				t.Skip("unixpacket sockets are not supported on macOS")
+			}
+			path := tempSocketPath(t)
+			ln := listenUnixSocket(t, network, path)
+			accepted := acceptOne(ln.(net.Listener))
+
+			conn, err := net.DialTimeout(network, path, time.Second)
+			if err != nil {
+				t.Fatalf("dialing new socket: %v", err)
+			}
+			_ = conn.Close()
+			if err := <-accepted; err != nil {
+				t.Fatalf("accepting on new socket: %v", err)
+			}
+
+			if err := ln.(io.Closer).Close(); err != nil {
+				t.Fatalf("closing listener: %v", err)
+			}
+
+			assertConnectRefused(t, network, path)
+			assertSocketFileGone(t, path)
+		})
+	}
+}
+
+func TestUnixgramCloseRemovesFile(t *testing.T) {
+	path := tempSocketPath(t)
+	pc := listenUnixSocket(t, "unixgram", path)
+
+	if err := pc.(io.Closer).Close(); err != nil {
+		t.Fatalf("closing packet conn: %v", err)
+	}
+
+	assertSocketFileGone(t, path)
+}
+
+// TestUnixSocketSharedRefCount ensures a reused socket keeps working, and its
+// file stays on disk, until the last holder closes it.
+func TestUnixSocketSharedRefCount(t *testing.T) {
+	path := tempSocketPath(t)
+
+	first := listenUnixSocket(t, "unix", path)
+	second := listenUnixSocket(t, "unix", path)
+
+	if err := first.(io.Closer).Close(); err != nil {
+		t.Fatalf("closing first listener: %v", err)
+	}
+
+	// the socket file must still exist while another holder is using it
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("socket file removed while still in use: %v", err)
+	}
+
+	// the second holder must still accept connections
+	accepted := acceptOne(second.(net.Listener))
+	conn, err := net.DialTimeout("unix", path, time.Second)
+	if err != nil {
+		t.Fatalf("dialing shared socket: %v", err)
+	}
+	_ = conn.Close()
+	select {
+	case err := <-accepted:
+		if err != nil {
+			t.Fatalf("accepting on surviving listener: %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed out accepting on surviving listener")
+	}
+
+	if err := second.(io.Closer).Close(); err != nil {
+		t.Fatalf("closing second listener: %v", err)
+	}
+
+	assertConnectRefused(t, "unix", path)
+	assertSocketFileGone(t, path)
+}
+
+// TestUnixSocketDoubleClose ensures a second Close reports net.ErrClosed and
+// does not release another holder's reference.
+func TestUnixSocketDoubleClose(t *testing.T) {
+	path := tempSocketPath(t)
+
+	first := listenUnixSocket(t, "unix", path)
+	second := listenUnixSocket(t, "unix", path)
+
+	closer := first.(io.Closer)
+	if err := closer.Close(); err != nil {
+		t.Fatalf("first close: %v", err)
+	}
+	if err := closer.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("expected net.ErrClosed on second close, got: %v", err)
+	}
+
+	// the second holder must be unaffected by the extra close
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("socket file removed by double close: %v", err)
+	}
+	accepted := acceptOne(second.(net.Listener))
+	conn, err := net.DialTimeout("unix", path, time.Second)
+	if err != nil {
+		t.Fatalf("dialing shared socket: %v", err)
+	}
+	_ = conn.Close()
+	if err := <-accepted; err != nil {
+		t.Fatalf("accepting on surviving listener: %v", err)
+	}
+
+	if err := second.(io.Closer).Close(); err != nil {
+		t.Fatalf("closing second listener: %v", err)
+	}
+	assertSocketFileGone(t, path)
+}
+
+// TestUnixgramDoubleClose ensures the same for datagram sockets.
+func TestUnixgramDoubleClose(t *testing.T) {
+	path := tempSocketPath(t)
+
+	first := listenUnixSocket(t, "unixgram", path)
+	second := listenUnixSocket(t, "unixgram", path)
+
+	closer := first.(io.Closer)
+	if err := closer.Close(); err != nil {
+		t.Fatalf("first close: %v", err)
+	}
+	if err := closer.Close(); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("expected net.ErrClosed on second close, got: %v", err)
+	}
+
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("socket file removed by double close: %v", err)
+	}
+
+	if err := second.(io.Closer).Close(); err != nil {
+		t.Fatalf("closing second packet conn: %v", err)
+	}
+	assertSocketFileGone(t, path)
+}
+
+// TestUnixSocketCloseRacesWithListen ensures that closing a listener while a
+// new one is being created on the same path leaves a working socket and file.
+func TestUnixSocketCloseRacesWithListen(t *testing.T) {
+	for i := range 50 {
+		path := tempSocketPath(t)
+
+		oldLn := listenUnixSocket(t, "unix", path)
+		oldAccepts := acceptOne(oldLn.(net.Listener))
+
+		var wg sync.WaitGroup
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_ = oldLn.(io.Closer).Close()
+		}()
+
+		newLn := listenUnixSocket(t, "unix", path)
+		wg.Wait()
+
+		// drain the accept that the old listener may or may not have seen
+		select {
+		case <-oldAccepts:
+		case <-time.After(2 * time.Second):
+			t.Fatalf("iteration %d: old listener accept did not return", i)
+		}
+
+		accepted := acceptOne(newLn.(net.Listener))
+		conn, err := net.DialTimeout("unix", path, time.Second)
+		if err != nil {
+			t.Fatalf("iteration %d: dialing new socket: %v", i, err)
+		}
+		_ = conn.Close()
+		select {
+		case err := <-accepted:
+			if err != nil {
+				t.Fatalf("iteration %d: accepting on new listener: %v", i, err)
+			}
+		case <-time.After(2 * time.Second):
+			t.Fatalf("iteration %d: timed out accepting on new listener", i)
+		}
+
+		if _, err := os.Stat(path); err != nil {
+			t.Fatalf("iteration %d: socket file missing while new listener is active: %v", i, err)
+		}
+
+		if err := newLn.(io.Closer).Close(); err != nil {
+			t.Fatalf("iteration %d: closing new listener: %v", i, err)
+		}
+		assertSocketFileGone(t, path)
+	}
+}
+
+// TestUnixAbstractSocketDoesNotUnlinkFile ensures closing an abstract socket
+// never removes a filesystem entry of the same name.
+func TestUnixAbstractSocketDoesNotUnlinkFile(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("abstract unix sockets are only supported on Linux")
+	}
+
+	// abstract socket names have no filesystem entry; create a regular file
+	// with the same name to make sure it is not removed on close
+	t.Chdir(t.TempDir())
+	name := fmt.Sprintf("@caddytest-abstract-%d", os.Getpid())
+	if err := os.WriteFile(name, []byte("keep me"), 0o600); err != nil {
+		t.Fatalf("creating decoy file: %v", err)
+	}
+
+	ln := listenUnixSocket(t, "unix", name)
+	if err := ln.(io.Closer).Close(); err != nil {
+		t.Fatalf("closing abstract listener: %v", err)
+	}
+
+	content, err := os.ReadFile(name)
+	if err != nil {
+		t.Fatalf("abstract socket close removed filesystem entry: %v", err)
+	}
+	if string(content) != "keep me" {
+		t.Fatalf("decoy file content changed: %q", content)
+	}
+}
