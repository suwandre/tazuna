+// unixSocket is the state shared by all listeners and packet conns that
+// refer to the same unix socket path (for example, across a config reload
+// that keeps the same socket). It owns a duplicate of the socket's file
+// descriptor, which is kept open so that new holders can be created from it
+// while any holder remains. The file is only unlinked once the last holder
+// releases it.
+type unixSocket struct {
+	mapKey   string
+	path     string // filesystem path; empty for abstract sockets
+	file     *os.File
+	datagram bool
+	count    int // number of holders; guarded by unixSocketsMu
+}
+
+// newUnixSocket creates the shared state for a newly bound unix socket.
+// unixSocketsMu must be held.
+func newUnixSocket(mapKey, address string, datagram bool, file *os.File) *unixSocket {
+	path := address
+	if isAbstractUnixSocket(address) {
+		path = ""
+	}
+
+	return &unixSocket{
+		mapKey:   mapKey,
+		path:     path,
+		file:     file,
+		datagram: datagram,
+		count:    1,
+	}
+}
+
+// newHolder creates a new listener or packet conn from the shared socket file.
+// unixSocketsMu must be held.
+func (us *unixSocket) newHolder() (any, error) {
+	if us.datagram {
+		pc, err := net.FilePacketConn(us.file)
+		if err != nil {
+			return nil, err
+		}
+		return &unixConn{UnixConn: pc.(*net.UnixConn), socket: us}, nil
+	}
+
+	ln, err := net.FileListener(us.file)
+	if err != nil {
+		return nil, err
+	}
+	return &unixListener{UnixListener: ln.(*net.UnixListener), socket: us}, nil
+}
+
+// release drops one reference to the socket. When the last reference is
+// dropped, the socket is forgotten and its file (if any) is unlinked.
+//
+// The caller must hold unixSocketsMu, and must keep holding it until after
+// the underlying socket has been closed. Both the close and the reference
+// drop have to be atomic with respect to reuseUnixSocket, which duplicates
+// the socket's file descriptor: otherwise a new listener could copy the
+// descriptor just as the old one closes it, or could have the file unlinked
+// underneath it.
+func (us *unixSocket) release() {
+	us.count--
+	if us.count > 0 {
+		return
+	}
+
+	// Only clean up if the map still refers to this shared state. If a new
+	// socket has taken over the path in the meantime, it owns the file now.
+	if current, ok := unixSockets[us.mapKey]; ok {
+		if current != us {
+			_ = us.file.Close()
+			return
+		}
+		delete(unixSockets, us.mapKey)
+	}
+
+	_ = us.file.Close()
+
+	// Abstract sockets live in the kernel's namespace, not on the filesystem,
+	// so unlinking would target an unrelated file of the same name.
+	if us.path == "" {
+		return
+	}
+	_ = syscall.Unlink(us.path)
+}
+
+// isAbstractUnixSocket reports whether addr names an abstract socket, which
+// lives in the kernel's namespace rather than on the filesystem.
+func isAbstractUnixSocket(addr string) bool {
+	switch runtime.GOOS {
+	case "linux", "android":
+		return strings.HasPrefix(addr, "@")
+	}
+	return false
+}
