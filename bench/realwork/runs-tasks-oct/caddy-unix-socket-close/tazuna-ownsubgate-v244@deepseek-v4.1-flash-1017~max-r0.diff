+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+//go:build unix && !solaris
+
+package caddy
+
+import (
+	"context"
+	"errors"
+	"io/fs"
+	"net"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+)
+
+// unixTestDir returns a short temporary directory, since unix socket paths
+// are limited to roughly 100 characters on many platforms.
+func unixTestDir(t *testing.T) string {
+	t.Helper()
+	dir, err := os.MkdirTemp("", "caddy-unix")
+	if err != nil {
+		t.Fatalf("creating temp dir: %v", err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(dir) })
+	return dir
+}
+
+func listenUnixTestSocket(t *testing.T, network, path string) any {
+	t.Helper()
+	na := NetworkAddress{Network: network, Host: path}
+	ln, err := na.Listen(context.Background(), 0, net.ListenConfig{})
+	if err != nil {
+		t.Fatalf("listening on %s %s: %v", network, path, err)
+	}
+	return ln
+}
+
+func closeUnixTestSocket(ln any) error {
+	return ln.(interface{ Close() error }).Close()
+}
+
+func assertUnixSocketFileExists(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Stat(path); err != nil {
+		t.Fatalf("socket file %s should exist: %v", path, err)
+	}
+}
+
+func assertUnixSocketFileRemoved(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Stat(path); !errors.Is(err, fs.ErrNotExist) {
+		t.Fatalf("socket file %s should have been removed: %v", path, err)
+	}
+}
+
+func assertUnixSocketRefuses(t *testing.T, network, path string) {
+	t.Helper()
+	conn, err := net.DialTimeout(network, path, time.Second)
+	if err == nil {
+		conn.Close()
+		t.Fatalf("dialing %s %s should have failed", network, path)
+	}
+}
+
+// assertUnixSocketAccepts makes sure the listener is still accepting
+// connections and closes the accepted connection.
+func assertUnixSocketAccepts(t *testing.T, ln any) {
+	t.Helper()
+	listener, ok := ln.(net.Listener)
+	if !ok {
+		t.Fatalf("listener %T is not a net.Listener", ln)
+	}
+
+	accepted := make(chan net.Conn, 1)
+	fatal := make(chan error, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			fatal <- err
+			return
+		}
+		accepted <- conn
+	}()
+
+	conn, err := net.DialTimeout("unix", listener.Addr().String(), 2*time.Second)
+	if err != nil {
+		t.Fatalf("dialing listener: %v", err)
+	}
+	defer conn.Close()
+
+	select {
+	case conn := <-accepted:
+		conn.Close()
+	case err := <-fatal:
+		t.Fatalf("accepting connection: %v", err)
+	case <-time.After(5 * time.Second):
+		t.Fatal("listener never accepted a connection")
+	}
+}
+
+// TestUnixSocketFileRemovedOnClose ensures closing the last holder of a unix
+// socket closes the socket and removes its file instead of leaving a
+// listening socket behind for the garbage collector to clean up.
+func TestUnixSocketFileRemovedOnClose(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			path := filepath.Join(unixTestDir(t), "test.sock")
+
+			ln := listenUnixTestSocket(t, network, path)
+			assertUnixSocketFileExists(t, path)
+
+			if err := closeUnixTestSocket(ln); err != nil {
+				t.Fatalf("closing socket: %v", err)
+			}
+
+			assertUnixSocketFileRemoved(t, path)
+			assertUnixSocketRefuses(t, network, path)
+		})
+	}
+}
+
+// TestUnixSocketSharedByHolders ensures a shared socket keeps working and
+// keeps its file until the last holder closes it.
+func TestUnixSocketSharedByHolders(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			path := filepath.Join(unixTestDir(t), "test.sock")
+
+			first := listenUnixTestSocket(t, network, path)
+			second := listenUnixTestSocket(t, network, path)
+
+			// Closing one holder must not close the shared socket or remove
+			// its file while another holder is still using it.
+			if err := closeUnixTestSocket(first); err != nil {
+				t.Fatalf("closing first holder: %v", err)
+			}
+			assertUnixSocketFileExists(t, path)
+			if network == "unix" {
+				assertUnixSocketAccepts(t, second)
+			}
+
+			// The last holder cleans up after itself.
+			if err := closeUnixTestSocket(second); err != nil {
+				t.Fatalf("closing second holder: %v", err)
+			}
+			assertUnixSocketFileRemoved(t, path)
+			assertUnixSocketRefuses(t, network, path)
+		})
+	}
+}
+
+// TestUnixSocketCloseOldHolderOnReload mimics a config reload: the new holder
+// takes over the socket, then the old holder closes. The socket and its file
+// must remain usable by the new holder.
+func TestUnixSocketCloseOldHolderOnReload(t *testing.T) {
+	path := filepath.Join(unixTestDir(t), "test.sock")
+
+	oldHolder := listenUnixTestSocket(t, "unix", path)
+	newHolder := listenUnixTestSocket(t, "unix", path)
+
+	if err := closeUnixTestSocket(oldHolder); err != nil {
+		t.Fatalf("closing old holder: %v", err)
+	}
+
+	assertUnixSocketFileExists(t, path)
+	assertUnixSocketAccepts(t, newHolder)
+
+	if err := closeUnixTestSocket(newHolder); err != nil {
+		t.Fatalf("closing new holder: %v", err)
+	}
+	assertUnixSocketFileRemoved(t, path)
+	assertUnixSocketRefuses(t, "unix", path)
+}
+
+// TestUnixSocketNewestHolderClosesFirst ensures closing the most recently
+// created holder first does not prevent another holder from reusing the
+// socket later.
+func TestUnixSocketNewestHolderClosesFirst(t *testing.T) {
+	path := filepath.Join(unixTestDir(t), "test.sock")
+
+	first := listenUnixTestSocket(t, "unix", path)
+	second := listenUnixTestSocket(t, "unix", path)
+
+	if err := closeUnixTestSocket(second); err != nil {
+		t.Fatalf("closing newest holder: %v", err)
+	}
+	assertUnixSocketFileExists(t, path)
+
+	// The old holder is still listening, and a new config must be able to
+	// reuse the same socket even though the newest holder has closed.
+	third := listenUnixTestSocket(t, "unix", path)
+	assertUnixSocketAccepts(t, first)
+	assertUnixSocketAccepts(t, third)
+
+	if err := closeUnixTestSocket(first); err != nil {
+		t.Fatalf("closing first holder: %v", err)
+	}
+	assertUnixSocketAccepts(t, third)
+
+	if err := closeUnixTestSocket(third); err != nil {
+		t.Fatalf("closing third holder: %v", err)
+	}
+	assertUnixSocketFileRemoved(t, path)
+}
+
+// TestUnixSocketPermissionsSuffix ensures a permissions suffix on the address
+// sets the file mode and does not interfere with sharing or cleanup.
+func TestUnixSocketPermissionsSuffix(t *testing.T) {
+	path := filepath.Join(unixTestDir(t), "test.sock")
+
+	first := listenUnixTestSocket(t, "unix", path+"|0600")
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatalf("socket file should exist: %v", err)
+	}
+	if mode := info.Mode().Perm(); mode != 0o600 {
+		t.Fatalf("expected socket file mode 0600, got %04o", mode)
+	}
+
+	// The same socket addressed with the same permissions suffix must be reused.
+	second := listenUnixTestSocket(t, "unix", path+"|0600")
+	if err := closeUnixTestSocket(first); err != nil {
+		t.Fatalf("closing first holder: %v", err)
+	}
+	assertUnixSocketFileExists(t, path)
+	assertUnixSocketAccepts(t, second)
+
+	if err := closeUnixTestSocket(second); err != nil {
+		t.Fatalf("closing second holder: %v", err)
+	}
+	assertUnixSocketFileRemoved(t, path)
+}
+
+// TestUnixSocketDoubleClose ensures a second Close does not release another
+// reference (which would close a socket still in use) and reports net.ErrClosed.
+func TestUnixSocketDoubleClose(t *testing.T) {
+	for _, network := range []string{"unix", "unixgram"} {
+		t.Run(network, func(t *testing.T) {
+			path := filepath.Join(unixTestDir(t), "test.sock")
+
+			first := listenUnixTestSocket(t, network, path)
+			second := listenUnixTestSocket(t, network, path)
+
+			if err := closeUnixTestSocket(first); err != nil {
+				t.Fatalf("closing first holder: %v", err)
+			}
+			if err := closeUnixTestSocket(first); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("second close of first holder: expected net.ErrClosed, got %v", err)
+			}
+
+			// The duplicate Close must not have released the second holder's reference.
+			assertUnixSocketFileExists(t, path)
+			if network == "unix" {
+				assertUnixSocketAccepts(t, second)
+			}
+
+			if err := closeUnixTestSocket(second); err != nil {
+				t.Fatalf("closing second holder: %v", err)
+			}
+			if err := closeUnixTestSocket(second); !errors.Is(err, net.ErrClosed) {
+				t.Fatalf("second close of second holder: expected net.ErrClosed, got %v", err)
+			}
+
+			assertUnixSocketFileRemoved(t, path)
+			assertUnixSocketRefuses(t, network, path)
+		})
+	}
+}
+
+// TestUnixSocketCloseRacesWithListen ensures that closing a socket while a
+// new listener is binding the same path (as happens during a reload) leaves
+// a working socket and its file in place for the new listener.
+func TestUnixSocketCloseRacesWithListen(t *testing.T) {
+	for i := 0; i < 50; i++ {
+		path := filepath.Join(unixTestDir(t), "test.sock")
+
+		oldHolder := listenUnixTestSocket(t, "unix", path)
+
+		var (
+			wg        sync.WaitGroup
+			newHolder any
+			listenErr error
+		)
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			na := NetworkAddress{Network: "unix", Host: path}
+			newHolder, listenErr = na.Listen(context.Background(), 0, net.ListenConfig{})
+		}()
+		go func() {
+			defer wg.Done()
+			_ = closeUnixTestSocket(oldHolder)
+		}()
+		wg.Wait()
+
+		if listenErr != nil {
+			t.Fatalf("iteration %d: listening on the same path: %v", i, listenErr)
+		}
+
+		assertUnixSocketFileExists(t, path)
+		assertUnixSocketAccepts(t, newHolder)
+
+		if err := closeUnixTestSocket(newHolder); err != nil {
+			t.Fatalf("iteration %d: closing new listener: %v", i, err)
+		}
+		assertUnixSocketFileRemoved(t, path)
+	}
+}
