+// limitations under the License.
+
+//go:build linux
+
+package caddy
+
+import (
+	"os"
+	"testing"
+)
+
+// TestUnixSocketAbstractDoesNotUnlinkFile ensures abstract sockets, which
+// have no filesystem entry, never unlink an unrelated file of the same name.
+func TestUnixSocketAbstractDoesNotUnlinkFile(t *testing.T) {
+	dir := unixTestDir(t)
+	t.Chdir(dir)
+
+	const name = "@caddy-abstract-test"
+	if err := os.WriteFile(name, []byte("not a socket"), 0o600); err != nil {
+		t.Fatalf("creating file: %v", err)
+	}
+
+	ln := listenUnixTestSocket(t, "unix", name)
+	if _, err := os.Stat(name); err != nil {
+		t.Fatalf("file must not be removed when binding an abstract socket: %v", err)
+	}
+
+	if err := closeUnixTestSocket(ln); err != nil {
+		t.Fatalf("closing abstract socket: %v", err)
+	}
+	if _, err := os.Stat(name); err != nil {
+		t.Fatalf("file must not be removed when closing an abstract socket: %v", err)
+	}
+}
