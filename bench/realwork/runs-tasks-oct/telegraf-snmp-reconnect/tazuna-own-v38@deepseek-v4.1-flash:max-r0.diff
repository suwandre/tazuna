+func TestMibDirFS(t *testing.T) {
+	// Directory names containing the OS path-list separator (e.g. ":" on
+	// Linux and macOS) must be usable for loading MIBs. gosmi's AppendPath()
+	// cannot handle them as it splits paths on that separator.
+	dir := filepath.Join(t.TempDir(), "mi:bs")
+	require.NoError(t, os.Mkdir(dir, 0o750))
+
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "testmib"), []byte("test"), 0o600))
+
+	var fsys fs.ReadDirFS = mibDirFS(dir)
+
+	file, err := fsys.Open("testmib")
+	require.NoError(t, err)
+	require.NoError(t, file.Close())
+
+	entries, err := fsys.ReadDir(".")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	require.Equal(t, "testmib", entries[0].Name())
+
+	_, err = fsys.ReadDir("missing")
+	require.Error(t, err)
+}
