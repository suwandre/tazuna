+// mibDirFS exposes a directory to gosmi without going through its
+// path-list parsing. gosmi's AppendPath() splits paths on the OS path-list
+// separator, which breaks directories containing that separator (e.g. ":"
+// on Linux and macOS).
+type mibDirFS string
+
+func (d mibDirFS) Open(name string) (fs.File, error) {
+	return os.Open(filepath.Join(string(d), name))
+}
+
+func (d mibDirFS) ReadDir(name string) ([]fs.DirEntry, error) {
+	path := string(d)
+	if name != "." {
+		path = filepath.Join(path, name)
+	}
+	return os.ReadDir(path)
+}
+
 func (*GosmiMibLoader) appendPath(path string) {
