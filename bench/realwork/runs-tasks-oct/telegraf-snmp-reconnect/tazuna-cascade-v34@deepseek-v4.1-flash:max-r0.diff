+// Reconnect re-establishes the connection to the agent if it was closed.
+// For SNMPv3 this also forces a new engine discovery, as the engine ID of
+// the agent might have changed while the connection was closed. Established
+// connections are left untouched, keeping the already discovered engine
+// parameters.
 func (gs GosnmpWrapper) Reconnect() error {
 	if gs.Conn == nil {
+		// Discard the discovered engine state of the closed connection so
+		// the agent is queried for its current engine parameters.
+		gs.resetEngine()
+
 		return gs.Connect()
 	}
 
 	return nil
 }
+
+// Close closes the connection to the agent and resets the discovered SNMPv3
+// engine state. The reset is required for the subsequent Reconnect to perform
+// a fresh engine discovery, as gosnmp keeps the previously discovered
+// authoritative engine ID, boots and time otherwise.
+func (gs GosnmpWrapper) Close() error {
+	gs.resetEngine()
+
+	return gs.GoSNMP.Close()
+}
+
+// resetEngine resets the discovered SNMPv3 engine state so the next request
+// triggers a new engine discovery.
+func (gs *GosnmpWrapper) resetEngine() {
+	if sp, ok := gs.SecurityParameters.(*gosnmp.UsmSecurityParameters); ok {
+		sp.AuthoritativeEngineID = ""
+		sp.AuthoritativeEngineBoots = 0
+		sp.AuthoritativeEngineTime = 0
+		sp.SecretKey = nil
+		sp.PrivacyKey = nil
+	}
+	// The context engine ID is derived from the authoritative engine ID
+	// during discovery, so reset it as well.
+	gs.ContextEngineID = ""
+}
