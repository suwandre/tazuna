+func newV3Wrapper(t *testing.T) GosnmpWrapper {
+	t.Helper()
+
+	wrapper, err := NewWrapper(ClientConfig{
+		Version:      3,
+		SecLevel:     "authPriv",
+		SecName:      "myuser",
+		AuthProtocol: "SHA",
+		AuthPassword: config.NewSecret([]byte("authpassword")),
+		PrivProtocol: "AES",
+		PrivPassword: config.NewSecret([]byte("privpassword")),
+		EngineID:     "oldengineid",
+		EngineBoots:  3,
+		EngineTime:   42,
+		Timeout:      config.Duration(time.Second),
+	})
+	require.NoError(t, err)
+	require.NoError(t, wrapper.SetAgent("udp://127.0.0.1:161"))
+
+	return wrapper
+}
+
+func TestGosnmpWrapperCloseResetsEngine(t *testing.T) {
+	wrapper := newV3Wrapper(t)
+	require.NoError(t, wrapper.Connect())
+
+	securityParams := wrapper.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+	securityParams.SecretKey = []byte("secret")
+	securityParams.PrivacyKey = []byte("privacy")
+	wrapper.ContextEngineID = "oldcontext"
+
+	require.NoError(t, wrapper.Close())
+
+	require.Nil(t, wrapper.Conn)
+	require.Empty(t, securityParams.AuthoritativeEngineID)
+	require.Zero(t, securityParams.AuthoritativeEngineBoots)
+	require.Zero(t, securityParams.AuthoritativeEngineTime)
+	require.Nil(t, securityParams.SecretKey)
+	require.Nil(t, securityParams.PrivacyKey)
+	require.Empty(t, wrapper.ContextEngineID)
+}
+
+func TestGosnmpWrapperReconnectKeepsEngineOfOpenConnection(t *testing.T) {
+	wrapper := newV3Wrapper(t)
+	require.NoError(t, wrapper.Connect())
+	conn := wrapper.Conn
+	securityParams := wrapper.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+
+	require.NoError(t, wrapper.Reconnect())
+
+	require.Equal(t, conn, wrapper.Conn)
+	require.Equal(t, "oldengineid", securityParams.AuthoritativeEngineID)
+	require.EqualValues(t, 3, securityParams.AuthoritativeEngineBoots)
+	require.EqualValues(t, 42, securityParams.AuthoritativeEngineTime)
+}
+
+func TestGosnmpWrapperReconnectClosedForcesDiscovery(t *testing.T) {
+	wrapper := newV3Wrapper(t)
+	require.NoError(t, wrapper.Connect())
+	require.NoError(t, wrapper.Close())
+	require.Nil(t, wrapper.Conn)
+
+	require.NoError(t, wrapper.Reconnect())
+
+	require.NotNil(t, wrapper.Conn)
+	securityParams := wrapper.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+	require.Empty(t, securityParams.AuthoritativeEngineID, "engine discovery should be required after reconnect")
+	require.Zero(t, securityParams.AuthoritativeEngineBoots)
+	require.Zero(t, securityParams.AuthoritativeEngineTime)
+}
+
+func TestGosnmpWrapperReconnectAfterRawCloseForcesDiscovery(t *testing.T) {
+	wrapper := newV3Wrapper(t)
+	require.NoError(t, wrapper.Connect())
+	require.NoError(t, wrapper.GoSNMP.Close())
+
+	require.NoError(t, wrapper.Reconnect())
+
+	require.NotNil(t, wrapper.Conn)
+	securityParams := wrapper.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+	require.Empty(t, securityParams.AuthoritativeEngineID, "engine discovery should be required after reconnect")
+}
+
+func TestGosnmpWrapperGetReconnectsClosedConnection(t *testing.T) {
+	srv, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = srv.Close() })
+
+	wrapper, err := NewWrapper(ClientConfig{
+		Version: 2,
+		Timeout: config.Duration(10 * time.Millisecond),
+	})
+	require.NoError(t, err)
+	require.NoError(t, wrapper.SetAgent("udp://"+srv.LocalAddr().String()))
+	require.NoError(t, wrapper.Connect())
+	require.NoError(t, wrapper.Close())
+	require.Nil(t, wrapper.Conn)
+
+	_, err = wrapper.Get([]string{".1.3.6.1.2.1.1.5.0"})
+	require.Error(t, err)
+	require.NotContains(t, err.Error(), "Conn is missing")
+	require.NotNil(t, wrapper.Conn)
+}
+
+func TestGosnmpWrapperWalkReconnectsClosedConnection(t *testing.T) {
+	srv, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = srv.Close() })
+
+	wrapper, err := NewWrapper(ClientConfig{
+		Version: 2,
+		Timeout: config.Duration(10 * time.Millisecond),
+	})
+	require.NoError(t, err)
+	require.NoError(t, wrapper.SetAgent("udp://"+srv.LocalAddr().String()))
+	require.NoError(t, wrapper.Connect())
+	require.NoError(t, wrapper.Close())
+	require.Nil(t, wrapper.Conn)
+
+	require.Error(t, wrapper.Walk(".1.3.6.1.2.1.1", func(gosnmp.SnmpPDU) error { return nil }))
+	require.NotNil(t, wrapper.Conn)
+}
