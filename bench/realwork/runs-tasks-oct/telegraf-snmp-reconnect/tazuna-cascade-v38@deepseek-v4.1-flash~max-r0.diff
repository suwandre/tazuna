+// failingSNMPConnection can be used to simulate failures on a per-request
+// basis. Closing it marks it as disconnected and the next reconnect resets
+// the failures.
+type failingSNMPConnection struct {
+	host string
+
+	failGet    bool
+	failWalk   bool
+	closed     bool
+	closeCalls int
+}
+
+func (c *failingSNMPConnection) Host() string {
+	return c.host
+}
+
+func (c *failingSNMPConnection) Get(oids []string) (*gosnmp.SnmpPacket, error) {
+	if c.failGet {
+		return nil, errors.New("incoming packet is not authentic, discarding")
+	}
+	return tsc.Get(oids)
+}
+
+func (c *failingSNMPConnection) Walk(oid string, wf gosnmp.WalkFunc) error {
+	if c.failWalk {
+		return errors.New("incoming packet is not authentic, discarding")
+	}
+	return tsc.Walk(oid, wf)
+}
+
+func (c *failingSNMPConnection) Reconnect() error {
+	if c.closed {
+		c.closed = false
+		c.failGet = false
+		c.failWalk = false
+	}
+	return nil
+}
+
+func (c *failingSNMPConnection) Close() error {
+	c.closed = true
+	c.closeCalls++
+	return nil
+}
