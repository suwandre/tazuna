+func TestGatherClosesConnectionOnFieldFailure(t *testing.T) {
+	conn := &failingSNMPConnection{host: "failing", failGet: true}
+	s := &Snmp{
+		Agents: []string{"TestGather"},
+		Name:   "mytable",
+		Fields: []snmp.Field{
+			{Name: "myfield", Oid: ".1.0.0.1.2"},
+		},
+		connectionCache: []snmp.Connection{conn},
+	}
+
+	// The failing gather must close the connection...
+	acc := &testutil.Accumulator{}
+	require.NoError(t, s.Gather(acc))
+	require.Len(t, acc.Errors, 1)
+	require.True(t, conn.closed)
+	require.Equal(t, 1, conn.closeCalls)
+
+	// ...so the next gather reconnects and recovers.
+	acc = &testutil.Accumulator{}
+	require.NoError(t, s.Gather(acc))
+	require.Empty(t, acc.Errors)
+	require.Len(t, acc.Metrics, 1)
+	require.Equal(t, "failing", acc.Metrics[0].Tags[s.AgentHostTag])
+}
+
