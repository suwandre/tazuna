+func TestGosnmpWrapperReconnectEngineDiscovery(t *testing.T) {
+	srvr, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.ParseIP("127.0.0.1")})
+	require.NoError(t, err)
+	defer srvr.Close()
+
+	baseCfg := ClientConfig{
+		Timeout:      config.Duration(100 * time.Millisecond),
+		Retries:      0,
+		Version:      3,
+		SecLevel:     "authPriv",
+		SecName:      "user",
+		AuthProtocol: "sha",
+		AuthPassword: config.NewSecret([]byte("authpass")),
+		PrivProtocol: "aes",
+		PrivPassword: config.NewSecret([]byte("privpass")),
+	}
+	agents := []string{fmt.Sprintf("udp://%s", srvr.LocalAddr())}
+
+	t.Run("discovered parameters", func(t *testing.T) {
+		gs, err := NewWrapper(baseCfg)
+		require.NoError(t, err)
+		require.NoError(t, gs.SetAgent(agents[0]))
+		require.NoError(t, gs.Connect())
+
+		sp := gs.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+
+		// Pretend the agent's engine parameters were discovered on connect.
+		sp.AuthoritativeEngineID = "old-engine-id"
+		sp.AuthoritativeEngineBoots = 3
+		sp.AuthoritativeEngineTime = 42
+		gs.ContextEngineID = "old-engine-id"
+
+		// An open connection must keep the discovered parameters...
+		require.NoError(t, gs.Reconnect())
+		require.NotNil(t, gs.Conn)
+		require.Equal(t, "old-engine-id", sp.AuthoritativeEngineID)
+		require.EqualValues(t, 3, sp.AuthoritativeEngineBoots)
+		require.EqualValues(t, 42, sp.AuthoritativeEngineTime)
+		require.Equal(t, "old-engine-id", gs.ContextEngineID)
+
+		// ...while reconnecting a closed connection must force a new engine
+		// discovery, e.g. after the agent restarted with a new engine ID.
+		require.NoError(t, gs.Close())
+		require.Nil(t, gs.Conn)
+		require.NoError(t, gs.Reconnect())
+		require.NotNil(t, gs.Conn)
+		require.Empty(t, sp.AuthoritativeEngineID)
+		require.Zero(t, sp.AuthoritativeEngineBoots)
+		require.Zero(t, sp.AuthoritativeEngineTime)
+		require.Empty(t, gs.ContextEngineID)
+	})
+
+	t.Run("configured parameters", func(t *testing.T) {
+		cfg := baseCfg
+		cfg.EngineID = "configured-engine-id"
+		cfg.EngineBoots = 1
+		cfg.EngineTime = 2
+
+		gs, err := NewWrapper(cfg)
+		require.NoError(t, err)
+		require.NoError(t, gs.SetAgent(agents[0]))
+		require.NoError(t, gs.Connect())
+
+		sp := gs.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+		sp.AuthoritativeEngineID = "discovered-engine-id"
+		sp.AuthoritativeEngineBoots = 7
+		sp.AuthoritativeEngineTime = 8
+
+		require.NoError(t, gs.Close())
+		require.NoError(t, gs.Reconnect())
+		require.Equal(t, "configured-engine-id", sp.AuthoritativeEngineID)
+		require.EqualValues(t, 1, sp.AuthoritativeEngineBoots)
+		require.EqualValues(t, 2, sp.AuthoritativeEngineTime)
+	})
+}
+
+func TestGosnmpWrapperRequestsReconnectClosedConnection(t *testing.T) {
+	srvr, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.ParseIP("127.0.0.1")})
+	require.NoError(t, err)
+	defer srvr.Close()
+	agent := fmt.Sprintf("udp://%s", srvr.LocalAddr())
+
+	testCases := []struct {
+		name   string
+		config ClientConfig
+	}{
+		{
+			name:   "v1",
+			config: ClientConfig{Timeout: config.Duration(100 * time.Millisecond), Retries: 0, Version: 1, Community: "public"},
+		},
+		{
+			name:   "v2c",
+			config: ClientConfig{Timeout: config.Duration(100 * time.Millisecond), Retries: 0, Version: 2, Community: "public"},
+		},
+		{
+			name: "v3",
+			config: ClientConfig{
+				Timeout:      config.Duration(100 * time.Millisecond),
+				Retries:      0,
+				Version:      3,
+				SecLevel:     "authPriv",
+				SecName:      "user",
+				AuthProtocol: "sha",
+				AuthPassword: config.NewSecret([]byte("authpass")),
+				PrivProtocol: "aes",
+				PrivPassword: config.NewSecret([]byte("privpass")),
+			},
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			gs, err := NewWrapper(tc.config)
+			require.NoError(t, err)
+			require.NoError(t, gs.SetAgent(agent))
+			require.NoError(t, gs.Connect())
+			require.NoError(t, gs.Close())
+			require.Nil(t, gs.Conn)
+
+			// Requests on a closed connection must reconnect before sending.
+			_, err = gs.Get([]string{".1.3.6.1.2.1.1.5.0"})
+			require.Error(t, err)
+			require.NotContains(t, err.Error(), "Conn is missing")
+			require.NotNil(t, gs.Conn)
+
+			require.NoError(t, gs.Close())
+			require.Nil(t, gs.Conn)
+
+			err = gs.Walk(".1.3.6.1.2.1.1", func(gosnmp.SnmpPDU) error { return nil })
+			require.Error(t, err)
+			require.NotContains(t, err.Error(), "Conn is missing")
+			require.NotNil(t, gs.Conn)
+		})
+	}
+}
+
+func TestGosnmpWrapperCloseWithoutConnection(t *testing.T) {
+	gs, err := NewWrapper(ClientConfig{Version: 2})
+	require.NoError(t, err)
+	require.NoError(t, gs.Close())
+}
