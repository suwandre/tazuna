+// closeConnection closes the connection to an agent after a failed request so
+// the next request connects again. This e.g. triggers a new SNMPv3 engine
+// discovery required to recover from an agent restarting with a new engine ID.
+func (*Snmp) closeConnection(acc telegraf.Accumulator, agent string, gs snmp.Connection) {
+	if err := gs.Close(); err != nil {
+		acc.AddError(fmt.Errorf("agent %s: closing connection: %w", agent, err))
+	}
+}
