-	return nil
+	if sp, ok := gs.SecurityParameters.(*gosnmp.UsmSecurityParameters); ok && gs.Version == gosnmp.Version3 {
+		sp.AuthoritativeEngineID = ""
+		sp.AuthoritativeEngineBoots = 0
+		sp.AuthoritativeEngineTime = 0
