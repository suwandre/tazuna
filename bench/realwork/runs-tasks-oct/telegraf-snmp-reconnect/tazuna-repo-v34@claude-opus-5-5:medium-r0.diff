@@ -0,0 +1,116 @@
+package snmp
+
+import (
+	"net"
+	"testing"
+	"time"
+
+	"github.com/gosnmp/gosnmp"
+	"github.com/stretchr/testify/require"
+
+	"github.com/influxdata/telegraf/config"
+)
+
+// newSilentAgent returns the address of a local UDP socket never answering
+func newSilentAgent(t *testing.T) string {
+	t.Helper()
+	srv, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	require.NoError(t, err)
+	t.Cleanup(func() { srv.Close() })
+	return "udp://" + srv.LocalAddr().String()
+}
+
+func newV3TestWrapper(t *testing.T) GosnmpWrapper {
+	t.Helper()
+	cfg := ClientConfig{
+		Version:      3,
+		Timeout:      config.Duration(50 * time.Millisecond),
+		SecLevel:     "authPriv",
+		SecName:      "user",
+		AuthProtocol: "SHA",
+		AuthPassword: config.NewSecret([]byte("password")),
+		PrivProtocol: "AES",
+		PrivPassword: config.NewSecret([]byte("password")),
+	}
+	gs, err := NewWrapper(cfg)
+	require.NoError(t, err)
+	require.NoError(t, gs.SetAgent(newSilentAgent(t)))
+	return gs
+}
+
+// simulateDiscovery fills in engine parameters as gosnmp does after a
+// successful engine discovery
+func simulateDiscovery(t *testing.T, gs GosnmpWrapper) *gosnmp.UsmSecurityParameters {
+	t.Helper()
+	sp, ok := gs.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+	require.True(t, ok)
+	sp.AuthoritativeEngineID = "\x80\x00\x1f\x88\x80\xbe\x21\x4d\x13"
+	sp.AuthoritativeEngineBoots = 1
+	sp.AuthoritativeEngineTime = 98072
+	require.NoError(t, sp.InitSecurityKeys())
+	require.NotEmpty(t, sp.SecretKey)
+	require.NotEmpty(t, sp.PrivacyKey)
+	return sp
+}
+
+func TestReconnectOpenConnectionKeepsEngine(t *testing.T) {
+	gs := newV3TestWrapper(t)
+	require.NoError(t, gs.Connect())
+	defer gs.Close()
+	conn := gs.Conn
+	sp := simulateDiscovery(t, gs)
+
+	require.NoError(t, gs.Reconnect())
+	require.Same(t, conn, gs.Conn)
+	require.Equal(t, "\x80\x00\x1f\x88\x80\xbe\x21\x4d\x13", sp.AuthoritativeEngineID)
+	require.Equal(t, uint32(1), sp.AuthoritativeEngineBoots)
+	require.Equal(t, uint32(98072), sp.AuthoritativeEngineTime)
+	require.NotEmpty(t, sp.SecretKey)
+	require.NotEmpty(t, sp.PrivacyKey)
+}
+
+func TestReconnectClosedConnectionResetsEngine(t *testing.T) {
+	gs := newV3TestWrapper(t)
+	require.NoError(t, gs.Connect())
+	sp := simulateDiscovery(t, gs)
+
+	require.NoError(t, gs.Close())
+	require.Nil(t, gs.Conn)
+
+	require.NoError(t, gs.Reconnect())
+	defer gs.Close()
+	require.NotNil(t, gs.Conn)
+	require.Empty(t, sp.AuthoritativeEngineID)
+	require.Zero(t, sp.AuthoritativeEngineBoots)
+	require.Zero(t, sp.AuthoritativeEngineTime)
+	require.Empty(t, sp.SecretKey)
+	require.Empty(t, sp.PrivacyKey)
+}
+
+func TestRequestsOnClosedConnectionReconnect(t *testing.T) {
+	for _, version := range []uint8{1, 2, 3} {
+		cfg := ClientConfig{
+			Version:  version,
+			Timeout:  config.Duration(20 * time.Millisecond),
+			SecLevel: "noAuthNoPriv",
+			SecName:  "user",
+		}
+		gs, err := NewWrapper(cfg)
+		require.NoError(t, err)
+		require.NoError(t, gs.SetAgent(newSilentAgent(t)))
+		require.NoError(t, gs.Connect())
+		require.NoError(t, gs.Close())
+
+		// The agent never answers, so the request times out, but only after
+		// the connection was established again.
+		_, err = gs.Get([]string{".1.3.6.1.2.1.1.3.0"})
+		require.ErrorContains(t, err, "timeout")
+		require.NotNil(t, gs.Conn)
+		require.NoError(t, gs.Close())
+
+		err = gs.Walk(".1.3.6.1.2.1.1", func(gosnmp.SnmpPDU) error { return nil })
+		require.ErrorContains(t, err, "timeout")
+		require.NotNil(t, gs.Conn)
+		require.NoError(t, gs.Close())
+	}
+}
