+func TestGatherClosesConnectionOnError(t *testing.T) {
+	tests := []struct {
+		name   string
+		fields []snmp.Field
+		tables []snmp.Table
+	}{
+		{
+			name:   "field",
+			fields: []snmp.Field{{Name: "uptime", Oid: ".1.3.6.1.2.1.1.3.0"}},
+		},
+		{
+			name: "table",
+			tables: []snmp.Table{{
+				Name:   "mytable",
+				Fields: []snmp.Field{{Name: "myfield", Oid: ".1.0.0.0.1.1"}},
+			}},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			failing := &failingSNMPConnection{testSNMPConnection: testSNMPConnection{host: "failing"}}
+			healthy := &countingSNMPConnection{testSNMPConnection: *tsc}
+			s := &Snmp{
+				Agents:          []string{"failing", "healthy"},
+				Name:            "snmp",
+				Fields:          tt.fields,
+				Tables:          tt.tables,
+				connectionCache: []snmp.Connection{failing, healthy},
+			}
+
+			var acc testutil.Accumulator
+			require.NoError(t, s.Gather(&acc))
+			require.NotEmpty(t, acc.Errors)
+			require.Equal(t, 1, failing.closed)
+			require.Zero(t, healthy.closed)
+
+			// The connection object stays cached
+			require.Same(t, failing, s.connectionCache[0])
+		})
+	}
+}
