+func TestGosnmpWrapperReconnect(t *testing.T) {
+	wrapper, err := NewWrapper(ClientConfig{
+		Timeout:      config.Duration(time.Second),
+		Version:      3,
+		SecLevel:     "authPriv",
+		SecName:      "user",
+		AuthProtocol: "sha",
+		AuthPassword: config.NewSecret([]byte("authpass")),
+		PrivProtocol: "aes",
+		PrivPassword: config.NewSecret([]byte("privpass")),
+	})
+	require.NoError(t, err)
+	require.NoError(t, wrapper.SetAgent("udp://127.0.0.1:161"))
+	require.NoError(t, wrapper.Connect())
+
+	sp, ok := wrapper.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+	require.True(t, ok)
+	sp.AuthoritativeEngineID = "old-engine-id"
+	sp.AuthoritativeEngineBoots = 1
+	sp.AuthoritativeEngineTime = 2
+	wrapper.ContextEngineID = "old-engine-id"
+	oldConn := wrapper.Conn
+
+	// Reconnecting an open connection must keep the discovered parameters.
+	require.NoError(t, wrapper.Reconnect())
+	require.Equal(t, oldConn, wrapper.Conn)
+	require.Equal(t, "old-engine-id", sp.AuthoritativeEngineID)
+	require.EqualValues(t, 1, sp.AuthoritativeEngineBoots)
+	require.EqualValues(t, 2, sp.AuthoritativeEngineTime)
+
+	// Reconnecting a closed connection must re-establish the connection and
+	// reset the previously discovered engine parameters to trigger a fresh
+	// discovery.
+	require.NoError(t, wrapper.Close())
+	require.Nil(t, wrapper.Conn)
+	require.NoError(t, wrapper.Reconnect())
+	require.NotNil(t, wrapper.Conn)
+	require.Empty(t, sp.AuthoritativeEngineID)
+	require.Zero(t, sp.AuthoritativeEngineBoots)
+	require.Zero(t, sp.AuthoritativeEngineTime)
+	require.Empty(t, wrapper.ContextEngineID)
+
+	require.NoError(t, wrapper.Close())
+}
+
+func TestGosnmpWrapperRequestsReconnect(t *testing.T) {
+	srv, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	require.NoError(t, err)
+	defer srv.Close()
+
+	tests := []struct {
+		name    string
+		request func(*GosnmpWrapper) error
+	}{
+		{
+			name: "get",
+			request: func(gs *GosnmpWrapper) error {
+				_, err := gs.Get([]string{".1.3.6.1.2.1.1.5.0"})
+				return err
+			},
+		},
+		{
+			name: "walk",
+			request: func(gs *GosnmpWrapper) error {
+				return gs.Walk(".1.3.6.1.2.1.1", func(gosnmp.SnmpPDU) error { return nil })
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			wrapper, err := NewWrapper(ClientConfig{
+				Timeout:  config.Duration(10 * time.Millisecond),
+				Retries:  0,
+				Version:  3,
+				SecLevel: "noauthnopriv",
+				SecName:  "user",
+			})
+			require.NoError(t, err)
+			require.NoError(t, wrapper.SetAgent(fmt.Sprintf("udp://%s", srv.LocalAddr())))
+			require.NoError(t, wrapper.Connect())
+			require.NoError(t, wrapper.Close())
+			require.Nil(t, wrapper.Conn)
+
+			// The request must re-establish the connection before sending.
+			require.Error(t, tt.request(&wrapper))
+			require.NotNil(t, wrapper.Conn)
+
+			require.NoError(t, wrapper.Close())
+		})
+	}
+}
