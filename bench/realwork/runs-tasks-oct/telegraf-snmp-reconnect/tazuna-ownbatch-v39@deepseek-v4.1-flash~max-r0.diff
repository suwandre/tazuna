+type mockSNMPConnection struct {
+	*testSNMPConnection
+
+	getErrs        []error
+	walkErrs       []error
+	reconnectCount int
+	closeCount     int
+}
+
+func (c *mockSNMPConnection) Get(oids []string) (*gosnmp.SnmpPacket, error) {
+	if len(c.getErrs) > 0 {
+		err := c.getErrs[0]
+		c.getErrs = c.getErrs[1:]
+		return nil, err
+	}
+	return c.testSNMPConnection.Get(oids)
+}
+
+func (c *mockSNMPConnection) Walk(oid string, fn gosnmp.WalkFunc) error {
+	if len(c.walkErrs) > 0 {
+		err := c.walkErrs[0]
+		c.walkErrs = c.walkErrs[1:]
+		return err
+	}
+	return c.testSNMPConnection.Walk(oid, fn)
+}
+
+func (c *mockSNMPConnection) Reconnect() error {
+	c.reconnectCount++
+	return nil
+}
+
+func (c *mockSNMPConnection) Close() error {
+	c.closeCount++
+	return nil
+}
+
+func TestGatherClosesConnectionOnError(t *testing.T) {
+	tests := []struct {
+		name     string
+		conn     *mockSNMPConnection
+		fields   []snmp.Field
+		tables   []snmp.Table
+		expected int
+	}{
+		{
+			name: "top-level field",
+			conn: &mockSNMPConnection{testSNMPConnection: tsc, getErrs: []error{errors.New("get failed")}},
+			fields: []snmp.Field{
+				{Name: "myfield", Oid: ".1.0.0.1.1"},
+			},
+			expected: 1,
+		},
+		{
+			name: "table",
+			conn: &mockSNMPConnection{testSNMPConnection: tsc, walkErrs: []error{errors.New("walk failed")}},
+			fields: []snmp.Field{
+				{Name: "myfield", Oid: ".1.0.0.1.1"},
+			},
+			tables: []snmp.Table{
+				{
+					Name: "myTable",
+					Fields: []snmp.Field{
+						{Name: "myfield", Oid: ".1.0.0.1.1"},
+					},
+				},
+			},
+			expected: 1,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			s := &Snmp{
+				Agents:          []string{"TestGather"},
+				Name:            "mytable",
+				Fields:          tt.fields,
+				Tables:          tt.tables,
+				connectionCache: []snmp.Connection{tt.conn},
+			}
+
+			acc := &testutil.Accumulator{}
+			require.NoError(t, s.Gather(acc))
+			require.Error(t, acc.FirstError())
+			require.Equal(t, tt.expected, tt.conn.closeCount)
+			require.Equal(t, 1, tt.conn.reconnectCount)
+		})
+	}
+}
+
+func TestGatherKeepsConnectionOnSuccess(t *testing.T) {
+	conn := &mockSNMPConnection{testSNMPConnection: tsc}
+	s := &Snmp{
+		Agents: []string{"TestGather"},
+		Name:   "mytable",
+		Fields: []snmp.Field{
+			{Name: "myfield", Oid: ".1.0.0.1.1"},
+		},
+		connectionCache: []snmp.Connection{conn},
+	}
+
+	acc := &testutil.Accumulator{}
+	require.NoError(t, s.Gather(acc))
+	require.NoError(t, acc.FirstError())
+	require.Equal(t, 1, conn.reconnectCount)
+	require.Zero(t, conn.closeCount)
+}
+
+func TestGatherRecoversFromFailedConnection(t *testing.T) {
+	conn := &mockSNMPConnection{
+		testSNMPConnection: tsc,
+		getErrs:            []error{errors.New("incoming packet is not authentic, discarding")},
+	}
+	s := &Snmp{
+		Agents: []string{"TestGather"},
+		Name:   "mytable",
+		Fields: []snmp.Field{
+			{Name: "myfield", Oid: ".1.0.0.1.1"},
+		},
+		connectionCache: []snmp.Connection{conn},
+	}
+
+	// The first gather fails and closes the connection.
+	acc := &testutil.Accumulator{}
+	require.NoError(t, s.Gather(acc))
+	require.ErrorContains(t, acc.FirstError(), "not authentic")
+	require.Equal(t, 1, conn.closeCount)
+
+	// The next gather reconnects and works again.
+	acc = &testutil.Accumulator{}
+	require.NoError(t, s.Gather(acc))
+	require.NoError(t, acc.FirstError())
+	require.Len(t, acc.Metrics, 1)
+	require.Equal(t, 2, conn.reconnectCount)
+	require.Equal(t, 1, conn.closeCount)
+}
