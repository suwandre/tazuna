+func TestGosnmpWrapperReconnect(t *testing.T) {
+	agent, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	require.NoError(t, err)
+	defer agent.Close()
+
+	params := &gosnmp.UsmSecurityParameters{
+		UserName:                 "user",
+		AuthoritativeEngineID:    "old-engine",
+		AuthoritativeEngineBoots: 1,
+		AuthoritativeEngineTime:  42,
+	}
+	gs := &gosnmp.GoSNMP{
+		Target:             "127.0.0.1",
+		Port:               uint16(agent.LocalAddr().(*net.UDPAddr).Port),
+		Version:            gosnmp.Version3,
+		MsgFlags:           gosnmp.NoAuthNoPriv,
+		SecurityModel:      gosnmp.UserSecurityModel,
+		SecurityParameters: params,
+		ContextEngineID:    "old-engine",
+	}
+	wrapper := GosnmpWrapper{GoSNMP: gs}
+	t.Cleanup(func() { require.NoError(t, wrapper.Close()) })
+
+	require.NoError(t, wrapper.Connect())
+	conn := gs.Conn
+	require.NoError(t, wrapper.Reconnect())
+	require.Same(t, conn, gs.Conn)
+	require.Equal(t, "old-engine", params.AuthoritativeEngineID)
+	require.Equal(t, "old-engine", gs.ContextEngineID)
+
+	require.NoError(t, wrapper.Close())
+	require.Nil(t, gs.Conn)
+	require.NoError(t, wrapper.Reconnect())
+	require.NotNil(t, gs.Conn)
+	require.Empty(t, params.AuthoritativeEngineID)
+	require.Zero(t, params.AuthoritativeEngineBoots)
+	require.Zero(t, params.AuthoritativeEngineTime)
+	require.Empty(t, gs.ContextEngineID)
+}
+
+func TestGosnmpWrapperRequestsReconnect(t *testing.T) {
+	for _, method := range []string{"Get", "Walk"} {
+		t.Run(method, func(t *testing.T) {
+			agent, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+			require.NoError(t, err)
+			defer agent.Close()
+
+			received := make(chan struct{}, 1)
+			go func() {
+				buf := make([]byte, 2048)
+				if _, _, err := agent.ReadFromUDP(buf); err == nil {
+					received <- struct{}{}
+				}
+			}()
+
+			gs := &gosnmp.GoSNMP{
+				Target:    "127.0.0.1",
+				Port:      uint16(agent.LocalAddr().(*net.UDPAddr).Port),
+				Version:   gosnmp.Version2c,
+				Community: "public",
+				Timeout:   100 * time.Millisecond,
+				Retries:   0,
+			}
+			wrapper := GosnmpWrapper{GoSNMP: gs}
+			t.Cleanup(func() { require.NoError(t, wrapper.Close()) })
+
+			require.NoError(t, wrapper.Connect())
+			require.NoError(t, wrapper.Close())
+
+			if method == "Get" {
+				_, err = wrapper.Get([]string{".1.3.6.1.2.1.1.1.0"})
+			} else {
+				err = wrapper.Walk(".1.3.6.1.2.1.1", func(gosnmp.SnmpPDU) error { return nil })
+			}
+			require.Error(t, err)
+			require.NotNil(t, gs.Conn)
+
+			select {
+			case <-received:
+			case <-time.After(time.Second):
+				t.Fatal("request was not sent after reconnecting")
+			}
+		})
+	}
+}
