+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			conn := &failingSNMPConnection{
+				testSNMPConnection: &testSNMPConnection{host: "agent"},
+				getErr:             tt.getErr,
+				walkErr:            tt.walkErr,
+			}
+			s := &Snmp{
