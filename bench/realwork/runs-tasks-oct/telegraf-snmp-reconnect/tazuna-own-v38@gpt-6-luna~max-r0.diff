+			getErr: fmt.Errorf("get failed"),
+		},
+		{
+			name: "table",
+			tables: []snmp.Table{
+				{
+					Name: "table",
+					Fields: []snmp.Field{
+						{Name: "value", Oid: ".1.0.0.1.1"},
+					},
+				},
+			},
+			walkErr: fmt.Errorf("walk failed"),
+		},
+	}
