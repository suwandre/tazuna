 }
 
+// Get reconnects a closed connection before querying the agent.
+func (gs GosnmpWrapper) Get(oids []string) (*gosnmp.SnmpPacket, error) {
+	if err := gs.Reconnect(); err != nil {
+		return nil, err
+	}
+
+	return gs.GoSNMP.Get(oids)
+}
