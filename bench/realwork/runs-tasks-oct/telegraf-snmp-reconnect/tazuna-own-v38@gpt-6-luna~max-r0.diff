 func (gs GosnmpWrapper) Walk(oid string, fn gosnmp.WalkFunc) error {
+	if err := gs.Reconnect(); err != nil {
+		return err
+	}
+
 	if gs.Version == gosnmp.Version1 {
 		return gs.GoSNMP.Walk(oid, fn)
 	}
