+// Reconnect re-establishes a closed connection. An already open connection
+// is kept as-is. When reconnecting, any SNMPv3 engine parameters discovered
+// during a previous session are reset to the configured values to force a
+// fresh engine discovery, e.g. after the agent restarted with a new engine
+// ID.
 func (gs GosnmpWrapper) Reconnect() error {
-	if gs.Conn == nil {
-		return gs.Connect()
+	if gs.Conn != nil {
+		return nil
 	}
 
-	return nil
+	if gs.Version == gosnmp.Version3 {
+		if sp, ok := gs.SecurityParameters.(*gosnmp.UsmSecurityParameters); ok && sp != nil {
+			// The context engine ID is derived from the authoritative engine
+			// ID during discovery and must be reset as well to be refreshed.
+			if gs.ContextEngineID == sp.AuthoritativeEngineID {
+				gs.GoSNMP.ContextEngineID = ""
