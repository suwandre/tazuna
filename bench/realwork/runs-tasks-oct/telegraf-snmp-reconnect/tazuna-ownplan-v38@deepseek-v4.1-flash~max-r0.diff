+type failingSNMPConnection struct {
+	*testSNMPConnection
+
+	failures     int
+	walkFailures int
+	reconnects   int
+	closes       int
+}
+
+func (c *failingSNMPConnection) Get(oids []string) (*gosnmp.SnmpPacket, error) {
+	if c.failures > 0 {
+		c.failures--
+		return nil, errors.New("incoming packet is not authentic, discarding")
+	}
+	return c.testSNMPConnection.Get(oids)
+}
+
+func (c *failingSNMPConnection) Walk(oid string, fn gosnmp.WalkFunc) error {
+	if c.walkFailures > 0 {
+		c.walkFailures--
+		return errors.New("performing bulk walk: request timeout (after 1 retries)")
+	}
+	return c.testSNMPConnection.Walk(oid, fn)
+}
+
+func (c *failingSNMPConnection) Reconnect() error {
+	c.reconnects++
+	return nil
+}
+
+func (c *failingSNMPConnection) Close() error {
+	c.closes++
+	return nil
+}
