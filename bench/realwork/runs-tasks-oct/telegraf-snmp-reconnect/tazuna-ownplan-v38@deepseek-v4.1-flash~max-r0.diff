+func TestGosnmpWrapperReconnect(t *testing.T) {
+	tests := []struct {
+		name        string
+		engineID    string
+		engineBoots uint32
+		engineTime  uint32
+	}{
+		{name: "discovered-engine", engineID: "", engineBoots: 0, engineTime: 0},
+		{name: "configured-engine", engineID: "configured-engine", engineBoots: 7, engineTime: 42},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cfg := ClientConfig{
+				Timeout:      config.Duration(time.Second),
+				Retries:      0,
+				Version:      3,
+				SecLevel:     "authPriv",
+				SecName:      "user",
+				AuthProtocol: "sha",
+				AuthPassword: config.NewSecret([]byte("auth-secret")),
+				PrivProtocol: "aes",
+				PrivPassword: config.NewSecret([]byte("priv-secret")),
+				EngineID:     tt.engineID,
+				EngineBoots:  tt.engineBoots,
+				EngineTime:   tt.engineTime,
+			}
+			gs, err := NewWrapper(cfg)
+			require.NoError(t, err)
+			require.NoError(t, gs.SetAgent("udp://127.0.0.1:161"))
+			require.NoError(t, gs.Connect())
+			require.NotNil(t, gs.Conn)
+
+			// Simulate the engine parameters discovered from an agent.
+			sp := gs.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+			sp.AuthoritativeEngineID = "discovered-engine"
+			sp.AuthoritativeEngineBoots = 11
+			sp.AuthoritativeEngineTime = 22
+			gs.ContextEngineID = "discovered-engine"
+
+			require.NoError(t, gs.Close())
+			require.Nil(t, gs.Conn)
+
+			require.NoError(t, gs.Reconnect())
+			require.NotNil(t, gs.Conn)
+
+			// Reconnecting a closed connection must reset the discovery state
+			// to the configured values to allow re-discovering the engine.
+			require.Equal(t, tt.engineID, sp.AuthoritativeEngineID)
+			require.Equal(t, tt.engineBoots, sp.AuthoritativeEngineBoots)
+			require.Equal(t, tt.engineTime, sp.AuthoritativeEngineTime)
+			require.Empty(t, gs.ContextEngineID)
+
+			require.NoError(t, gs.Close())
+		})
+	}
+}
