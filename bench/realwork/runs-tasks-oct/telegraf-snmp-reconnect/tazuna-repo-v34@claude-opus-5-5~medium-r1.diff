+// Reconnect connects a closed connection again, resolving the agent address
+// anew. For SNMPv3 the previously discovered engine ID, boots and time are
+// discarded so that a fresh engine discovery is performed, e.g. to recover
+// from an agent restarting with a new engine ID. An open connection is kept
+// as-is including its discovered engine parameters.
 func (gs GosnmpWrapper) Reconnect() error {
-	if gs.Conn == nil {
-		return gs.Connect()
+	if gs.Conn != nil {
+		return nil
 	}
 
-	return nil
+	if gs.Version == gosnmp.Version3 {
+		if sp, ok := gs.SecurityParameters.(*gosnmp.UsmSecurityParameters); ok && sp != nil {
+			sp.AuthoritativeEngineID = ""
+			sp.AuthoritativeEngineBoots = 0
+			sp.AuthoritativeEngineTime = 0
+			// Localized keys are derived from the engine ID
+			sp.SecretKey = nil
+			sp.PrivacyKey = nil
+		}
+		// Discovered from the engine ID during discovery
+		gs.ContextEngineID = ""
+	}
+
+	return gs.Connect()
 }
