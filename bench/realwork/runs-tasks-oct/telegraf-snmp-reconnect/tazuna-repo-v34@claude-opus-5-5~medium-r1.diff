+++ b/plugins/common/snmp/wrapper_reconnect_test.go
@@ -0,0 +1,187 @@
+package snmp
+
+import (
+	"net"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/gosnmp/gosnmp"
+	"github.com/stretchr/testify/require"
+
+	"github.com/influxdata/telegraf/config"
+)
+
+func newV3TestWrapper(t *testing.T, agent string) GosnmpWrapper {
+	t.Helper()
+
+	gs, err := NewWrapper(ClientConfig{
+		Version:      3,
+		Timeout:      config.Duration(50 * time.Millisecond),
+		Retries:      0,
+		SecLevel:     "authPriv",
+		SecName:      "user",
+		AuthProtocol: "SHA",
+		AuthPassword: config.NewSecret([]byte("password123")),
+		PrivProtocol: "AES",
+		PrivPassword: config.NewSecret([]byte("321drowssap")),
+	})
+	require.NoError(t, err)
+	require.NoError(t, gs.SetAgent(agent))
+	return gs
+}
+
+// simulateDiscovery sets the engine parameters as if a discovery was done
+func simulateDiscovery(gs GosnmpWrapper) {
+	sp := gs.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+	sp.AuthoritativeEngineID = "old-engine-id"
+	sp.AuthoritativeEngineBoots = 1
+	sp.AuthoritativeEngineTime = 98072
+	sp.SecretKey = []byte("old-secret-key")
+	sp.PrivacyKey = []byte("old-privacy-key")
+	gs.ContextEngineID = "old-engine-id"
+}
+
+func TestReconnectOpenConnectionKeepsEngineParameters(t *testing.T) {
+	gs := newV3TestWrapper(t, "udp://127.0.0.1:161")
+	require.NoError(t, gs.Connect())
+	defer gs.Close()
+
+	simulateDiscovery(gs)
+	conn := gs.Conn
+
+	require.NoError(t, gs.Reconnect())
+	require.Same(t, conn, gs.Conn)
+
+	sp := gs.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+	require.Equal(t, "old-engine-id", sp.AuthoritativeEngineID)
+	require.Equal(t, uint32(1), sp.AuthoritativeEngineBoots)
+	require.Equal(t, uint32(98072), sp.AuthoritativeEngineTime)
+	require.Equal(t, "old-engine-id", gs.ContextEngineID)
+}
+
+func TestReconnectClosedConnectionResetsEngineParameters(t *testing.T) {
+	gs := newV3TestWrapper(t, "udp://127.0.0.1:161")
+	require.NoError(t, gs.Connect())
+	defer gs.Close()
+
+	simulateDiscovery(gs)
+
+	require.NoError(t, gs.Close())
+	require.Nil(t, gs.Conn)
+
+	require.NoError(t, gs.Reconnect())
+	require.NotNil(t, gs.Conn)
+
+	sp := gs.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+	require.Empty(t, sp.AuthoritativeEngineID)
+	require.Zero(t, sp.AuthoritativeEngineBoots)
+	require.Zero(t, sp.AuthoritativeEngineTime)
+	require.Empty(t, sp.SecretKey)
+	require.Empty(t, sp.PrivacyKey)
+	require.Empty(t, gs.ContextEngineID)
+}
+
+// startRecordingAgent starts a UDP server that decodes and records incoming
+// unencrypted packets without ever answering.
+func startRecordingAgent(t *testing.T) (string, <-chan *gosnmp.SnmpPacket) {
+	t.Helper()
+
+	srv, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	require.NoError(t, err)
+	t.Cleanup(func() { srv.Close() })
+
+	packets := make(chan *gosnmp.SnmpPacket, 100)
+	go func() {
+		buf := make([]byte, 65535)
+		for {
+			n, _, err := srv.ReadFrom(buf)
+			if err != nil {
+				return
+			}
+			decoder := &gosnmp.GoSNMP{
+				Version:            gosnmp.Version3,
+				SecurityModel:      gosnmp.UserSecurityModel,
+				SecurityParameters: &gosnmp.UsmSecurityParameters{UserName: "user"},
+			}
+			pkt, err := decoder.SnmpDecodePacket(buf[:n])
+			if err != nil {
+				// Encrypted or otherwise undecodable packet
+				pkt = nil
+			}
+			select {
+			case packets <- pkt:
+			default:
+			}
+		}
+	}()
+
+	addr := srv.LocalAddr().(*net.UDPAddr)
+	return "udp://127.0.0.1:" + strconv.Itoa(addr.Port), packets
+}
+
+func TestRequestsOnClosedConnectionRediscoverEngine(t *testing.T) {
+	tests := []struct {
+		name    string
+		request func(GosnmpWrapper) error
+	}{
+		{
+			name: "get",
+			request: func(gs GosnmpWrapper) error {
+				_, err := gs.Get([]string{".1.3.6.1.2.1.1.5.0"})
+				return err
+			},
+		},
+		{
+			name: "walk",
+			request: func(gs GosnmpWrapper) error {
+				return gs.Walk(".1.3.6.1.2.1.1", func(gosnmp.SnmpPDU) error { return nil })
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			agent, packets := startRecordingAgent(t)
+
+			gs := newV3TestWrapper(t, agent)
+			require.NoError(t, gs.Connect())
+			defer gs.Close()
+			simulateDiscovery(gs)
+			require.NoError(t, gs.Close())
+
+			// The request must reconnect and start with a fresh discovery
+			require.Error(t, tt.request(gs))
+			require.NotNil(t, gs.Conn)
+
+			select {
+			case pkt := <-packets:
+				require.NotNil(t, pkt, "expected an unencrypted discovery packet")
+				sp, ok := pkt.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+				require.True(t, ok)
+				require.Empty(t, sp.AuthoritativeEngineID)
+				require.Equal(t, gosnmp.NoAuthNoPriv, pkt.MsgFlags&gosnmp.AuthPriv)
+			case <-time.After(5 * time.Second):
+				require.FailNow(t, "no request received")
+			}
+		})
+	}
+}
+
+func TestRequestsOnClosedConnectionReconnectV2(t *testing.T) {
+	gs, err := NewWrapper(ClientConfig{
+		Version: 2,
+		Timeout: config.Duration(50 * time.Millisecond),
+	})
+	require.NoError(t, err)
+	require.NoError(t, gs.SetAgent("udp://127.0.0.1:161"))
+	require.NoError(t, gs.Connect())
+	require.NoError(t, gs.Close())
+	require.Nil(t, gs.Conn)
+
+	// The request itself fails as there is no agent, but it must reconnect
+	_, err = gs.Get([]string{".1.3.6.1.2.1.1.5.0"})
+	require.Error(t, err)
+	require.NotNil(t, gs.Conn)
+	require.NoError(t, gs.Close())
+}
