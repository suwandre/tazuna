+// failingSNMPConnection wraps the test connection, failing requests for the
+// configured OIDs and recording calls to Close().
+type failingSNMPConnection struct {
+	*testSNMPConnection
+	failOid string
+	closed  int
+}
+
+func (fsc *failingSNMPConnection) Get(oids []string) (*gosnmp.SnmpPacket, error) {
+	for _, oid := range oids {
+		if oid == fsc.failOid {
+			return nil, errors.New("incoming packet is not authentic, discarding")
+		}
+	}
+	return fsc.testSNMPConnection.Get(oids)
+}
+
+func (fsc *failingSNMPConnection) Walk(oid string, wf gosnmp.WalkFunc) error {
+	if oid == fsc.failOid {
+		return errors.New("incoming packet is not authentic, discarding")
+	}
+	return fsc.testSNMPConnection.Walk(oid, wf)
+}
+
+func (fsc *failingSNMPConnection) Close() error {
+	fsc.closed++
+	return nil
+}
+
+func TestGatherClosesConnectionOnError(t *testing.T) {
+	tests := []struct {
+		name     string
+		failOid  string
+		expected int
+	}{
+		{name: "success"},
+		{name: "field failure", failOid: ".1.0.0.1.1", expected: 1},
+		{name: "table failure", failOid: ".1.0.0.0.1.5", expected: 1},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			conn := &failingSNMPConnection{testSNMPConnection: tsc, failOid: tt.failOid}
+			s := &Snmp{
+				Agents: []string{"TestGather"},
+				Name:   "mytable",
+				Fields: []snmp.Field{
+					{Name: "myfield1", Oid: ".1.0.0.1.1", IsTag: true},
+				},
+				Tables: []snmp.Table{
+					{
+						Name:   "myOtherTable",
+						Fields: []snmp.Field{{Name: "myOtherField", Oid: ".1.0.0.0.1.5"}},
+					},
+				},
+				connectionCache: []snmp.Connection{conn},
+				Log:             testutil.Logger{},
+			}
+
+			acc := &testutil.Accumulator{}
+			require.NoError(t, s.Gather(acc))
+			require.Equal(t, tt.expected, conn.closed)
+			if tt.expected > 0 {
+				require.NotEmpty(t, acc.Errors)
+			} else {
+				require.Empty(t, acc.Errors)
+			}
+
+			// The connection object stays cached for the next gather
+			require.Same(t, conn, s.connectionCache[0])
+		})
+	}
+}
