+// controllableTestSNMPConnection allows to simulate failures of single
+// requests and records whether the connection was closed. A reconnect after a
+// close resets the simulated failure, mimicking the engine rediscovery of a
+// real connection.
+type controllableTestSNMPConnection struct {
+	testSNMPConnection
+	failGet  bool
+	failWalk bool
+	closed   bool
+}
+
+func (c *controllableTestSNMPConnection) Get(oids []string) (*gosnmp.SnmpPacket, error) {
+	if c.failGet {
+		return nil, errors.New("incoming packet is not authentic, discarding")
+	}
+	return c.testSNMPConnection.Get(oids)
+}
+
+func (c *controllableTestSNMPConnection) Walk(oid string, fn gosnmp.WalkFunc) error {
+	if c.failWalk {
+		return errors.New("incoming packet is not authentic, discarding")
+	}
+	return c.testSNMPConnection.Walk(oid, fn)
+}
+
+func (c *controllableTestSNMPConnection) Reconnect() error {
+	if c.closed {
+		c.closed = false
+		c.failGet = false
+		c.failWalk = false
+	}
+	return nil
+}
+
+func (c *controllableTestSNMPConnection) Close() error {
+	c.closed = true
+	return nil
+}
+
