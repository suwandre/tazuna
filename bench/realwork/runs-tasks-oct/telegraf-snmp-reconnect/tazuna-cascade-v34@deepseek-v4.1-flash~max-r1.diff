+func TestGather_closeOnError(t *testing.T) {
+	conn := &controllableTestSNMPConnection{
+		testSNMPConnection: testSNMPConnection{
+			host:   "tsc",
+			values: map[string]any{".1.0.0.1.1": "foo"},
+		},
+		failGet: true,
+	}
+	s := &Snmp{
+		Agents:          []string{"TestGather"},
+		Name:            "mytable",
+		Fields:          []snmp.Field{{Name: "myfield1", Oid: ".1.0.0.1.1"}},
+		connectionCache: []snmp.Connection{conn},
+		Log:             testutil.Logger{Name: "inputs.snmp"},
+	}
+
+	// The first gather fails and must close the connection so the next gather
+	// reconnects and re-discovers the agent's engine.
+	acc := &testutil.Accumulator{}
+	require.NoError(t, s.Gather(acc))
+	require.NotEmpty(t, acc.Errors)
+	require.Empty(t, acc.Metrics)
+	require.True(t, conn.closed)
+
+	// The reconnect resets the simulated engine change and gathering recovers.
+	acc = &testutil.Accumulator{}
+	require.NoError(t, s.Gather(acc))
+	require.Empty(t, acc.Errors)
+	require.Len(t, acc.Metrics, 1)
+	require.Equal(t, "foo", acc.Metrics[0].Fields["myfield1"])
+	require.False(t, conn.closed)
+}
