+func TestGosnmpWrapper_reconnectResetsEngineState(t *testing.T) {
+	gs, err := NewWrapper(ClientConfig{
+		Version:      3,
+		SecLevel:     "authPriv",
+		SecName:      "myuser",
+		AuthProtocol: "SHA",
+		AuthPassword: config.NewSecret([]byte("password123")),
+		PrivProtocol: "AES",
+		PrivPassword: config.NewSecret([]byte("321drowssap")),
+		Timeout:      config.Duration(time.Second),
+	})
+	require.NoError(t, err)
+	require.NoError(t, gs.SetAgent("udp://127.0.0.1:161"))
+	require.NoError(t, gs.Connect())
+	t.Cleanup(func() { require.NoError(t, gs.Close()) })
+
+	// Simulate an engine discovery performed on the open connection.
+	sp := gs.SecurityParameters.(*gosnmp.UsmSecurityParameters)
+	gs.ContextEngineID = "old-engine-id"
+	sp.AuthoritativeEngineID = "old-engine-id"
+	sp.AuthoritativeEngineBoots = 42
+	sp.AuthoritativeEngineTime = 4711
+
+	// Reconnecting an open connection keeps the discovered engine state.
+	require.NoError(t, gs.Reconnect())
+	require.NotNil(t, gs.Conn)
+	require.Equal(t, "old-engine-id", sp.AuthoritativeEngineID)
+	require.EqualValues(t, 42, sp.AuthoritativeEngineBoots)
+	require.EqualValues(t, 4711, sp.AuthoritativeEngineTime)
+	require.Equal(t, "old-engine-id", gs.ContextEngineID)
+
+	// Reconnecting a closed connection resets the engine state to force a
+	// fresh engine discovery.
+	require.NoError(t, gs.Close())
+	require.Nil(t, gs.Conn)
+	require.NoError(t, gs.Reconnect())
+	require.NotNil(t, gs.Conn)
+	require.Empty(t, sp.AuthoritativeEngineID)
+	require.Zero(t, sp.AuthoritativeEngineBoots)
+	require.Zero(t, sp.AuthoritativeEngineTime)
+	require.Empty(t, gs.ContextEngineID)
+}
+
+func TestGosnmpWrapper_getReconnectsClosedConnection(t *testing.T) {
+	testGosnmpWrapperRequestReconnects(t, func(gs GosnmpWrapper) error {
+		_, err := gs.Get([]string{".1.3.6.1.2.1.1.5.0"})
+		return err
+	})
+}
+
+func TestGosnmpWrapper_walkReconnectsClosedConnection(t *testing.T) {
+	testGosnmpWrapperRequestReconnects(t, func(gs GosnmpWrapper) error {
+		return gs.Walk(".1.3.6.1.2.1.1", func(gosnmp.SnmpPDU) error { return nil })
+	})
+}
+
+func testGosnmpWrapperRequestReconnects(t *testing.T, request func(GosnmpWrapper) error) {
+	t.Helper()
+
+	// Serve requests with a black hole to avoid ICMP errors and just let the
+	// request time out.
+	srvr, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.ParseIP("127.0.0.1")})
+	require.NoError(t, err)
+	defer srvr.Close()
+
+	gs, err := NewWrapper(ClientConfig{
+		Version:   2,
+		Community: "public",
+		Timeout:   config.Duration(50 * time.Millisecond),
+		Retries:   0,
+	})
+	require.NoError(t, err)
+	require.NoError(t, gs.SetAgent(fmt.Sprintf("udp://%s", srvr.LocalAddr())))
+	require.NoError(t, gs.Connect())
+	oldConn := gs.Conn
+
+	require.NoError(t, gs.Close())
+	require.Nil(t, gs.Conn)
+
+	// The request must re-establish the closed connection before sending.
+	require.Error(t, request(gs))
+	require.NotNil(t, gs.Conn)
+	require.NotEqual(t, oldConn, gs.Conn)
+}
