+// A run left cancelling although all its jobs are cancelled must release its concurrency group when force-cancelled.
+func TestForceCancelStuckRunWakesConcurrencyWaiter(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	var emittedRunIDs []int64
+	defer test.MockVariableValue(&EmitJobsIfReadyByRun, func(runID int64) error {
+		emittedRunIDs = append(emittedRunIDs, runID)
+		return nil
+	})()
+
+	const concurrencyGroup = "test-force-cancel-stuck-run"
+	run, attempt := createRunAttempt(t, 9911, concurrencyGroup, actions_model.StatusCancelling)
+	run.LatestAttemptID = attempt.ID
+	require.NoError(t, actions_model.UpdateRun(t.Context(), run, "latest_attempt_id"))
+	waiter, _ := createRunAttempt(t, 9912, concurrencyGroup, actions_model.StatusBlocked)
+
+	caller := &actions_model.ActionRunJob{
+		RunID: run.ID, RunAttemptID: attempt.ID, RepoID: run.RepoID, OwnerID: run.OwnerID, Name: "caller", JobID: "caller",
+		Status: actions_model.StatusCancelled, IsReusableCaller: true, IsExpanded: true,
+	}
+	require.NoError(t, db.Insert(t.Context(), caller))
+	child := &actions_model.ActionRunJob{
+		RunID: run.ID, RunAttemptID: attempt.ID, RepoID: run.RepoID, OwnerID: run.OwnerID, Name: "child", JobID: "child",
+		Status: actions_model.StatusCancelled, ParentJobID: caller.ID,
+	}
+	require.NoError(t, db.Insert(t.Context(), child))
+
+	cancelled, err := ForceCancelRun(t.Context(), run, []*actions_model.ActionRunJob{caller, child})
+	require.NoError(t, err)
+	assert.Equal(t, actions_model.StatusCancelled, cancelled.Status)
+	assert.Equal(t, []int64{run.ID}, emittedRunIDs)
+
+	result, err := checkRunConcurrency(t.Context(), cancelled)
+	require.NoError(t, err)
+	assert.Equal(t, []int64{waiter.ID}, result.RunIDsToReEmit)
+}
