+// Callers have no task of their own, so they must stay cancelling until the runner acknowledges their nested child.
+func TestCancellingReusableCallerFinalizesOnAck(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+	task, child := newRunningTaskForCancelling(t, "cancelling-nested-child", true)
+
+	newCaller := func(name string, parentID int64) *ActionRunJob {
+		caller := &ActionRunJob{
+			RunID:            child.RunID,
+			RepoID:           child.RepoID,
+			OwnerID:          child.OwnerID,
+			CommitSHA:        child.CommitSHA,
+			Name:             name,
+			JobID:            name,
+			Attempt:          1,
+			Status:           StatusRunning,
+			IsReusableCaller: true,
+			IsExpanded:       true,
+			ParentJobID:      parentID,
+		}
+		require.NoError(t, db.Insert(ctx, caller))
+		return caller
+	}
+	outer := newCaller("cancelling-outer", 0)
+	inner := newCaller("cancelling-inner", outer.ID)
+	child.ParentJobID = inner.ID
+	_, err := UpdateRunJob(ctx, child, nil, "parent_job_id")
+	require.NoError(t, err)
+
+	assertStatus := func(want Status) {
+		t.Helper()
+		for _, j := range []*ActionRunJob{outer, inner, child} {
+			assert.Equal(t, want, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: j.ID}).Status, "job %q", j.JobID)
+		}
+		assert.Equal(t, want, unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: child.RunID}).Status)
+	}
+
+	_, err = CancelJobs(ctx, []*ActionRunJob{outer}, false)
+	require.NoError(t, err)
+	assertStatus(StatusCancelling)
+
+	_, err = UpdateTaskByState(ctx, task.RunnerID, &runnerv1.TaskState{
+		Id:        task.ID,
+		Result:    runnerv1.Result_RESULT_CANCELLED,
+		StoppedAt: timestamppb.Now(),
+	})
+	require.NoError(t, err)
+	assertStatus(StatusCancelled)
+}
