+	// the runner acknowledges the cancel: the leaf settles and the cancellation cascades up to the run
+	updated, err := UpdateTaskByState(ctx, runner.ID, &runnerv1.TaskState{
+		Id:        task.ID,
+		Result:    runnerv1.Result_RESULT_SUCCESS,
+		StoppedAt: timestamppb.Now(),
+	})
+	require.NoError(t, err)
+	assert.Equal(t, StatusCancelled, updated.Status)
+
+	for _, job := range []*ActionRunJob{leaf, inner, outer} {
+		got := unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: job.ID})
+		assert.Equal(t, StatusCancelled, got.Status, "job %q", job.JobID)
+		assert.NotZero(t, got.Stopped, "job %q", job.JobID)
+	}
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRunAttempt{ID: attempt.ID}).Status)
+	gotRun := unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: run.ID})
+	assert.Equal(t, StatusCancelled, gotRun.Status)
+	assert.NotZero(t, gotRun.Stopped)
+}
