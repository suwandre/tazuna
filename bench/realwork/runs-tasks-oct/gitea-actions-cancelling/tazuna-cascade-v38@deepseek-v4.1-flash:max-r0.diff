+// reusableCallerStatusAfterCancel returns the status a reusable caller takes when its subtree is
+// cancelled: Cancelling while any direct child is still running its cancelling handshake, and
+// Cancelled once they all settled. Marking the caller Cancelled too early would leave the child's
+// acknowledgement nothing to cascade to, so the run status would never be refreshed from it.
+// Direct children keep the same invariant for their own subtrees, so one level is enough.
+func reusableCallerStatusAfterCancel(ctx context.Context, caller *ActionRunJob) (Status, error) {
+	children, err := GetDirectChildJobsByParent(ctx, caller)
+	if err != nil {
+		return StatusUnknown, err
+	}
+	for _, child := range children {
+		if !child.Status.IsDone() {
+			return StatusCancelling, nil
+		}
+	}
+	return StatusCancelled, nil
+}
