+// TestCancelRun_SettledRunWakesConcurrencyWaiters covers a run stuck in Cancelling whose jobs all
+// finished already: cancelling it settles the run itself, and the settled run must then be
+// re-checked for its concurrency groups or the runs blocked behind it never start.
+func TestCancelRun_SettledRunWakesConcurrencyWaiters(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+
+	const group = "cancel-settled-wakes-waiters"
+
+	// the stuck run holds the group at run level; its attempt is still Cancelling
+	stuckRun, stuckAttempt := createRunAttempt(t, 99720, group, actions_model.StatusCancelling)
+	_, err := db.Exec(ctx, "UPDATE `action_run` SET latest_attempt_id = ? WHERE id = ?", stuckAttempt.ID, stuckRun.ID)
+	require.NoError(t, err)
+	stuckRun.LatestAttemptID = stuckAttempt.ID
+
+	// a run blocked behind it on the same group
+	waiterRun, waiterAttempt := createRunAttempt(t, 99721, group, actions_model.StatusBlocked)
+	_, err = db.Exec(ctx, "UPDATE `action_run` SET latest_attempt_id = ? WHERE id = ?", waiterAttempt.ID, waiterRun.ID)
+	require.NoError(t, err)
+
+	// the stuck run's jobs are all done, so cancelling has nothing left to update
+	caller := &actions_model.ActionRunJob{
+		RunID: stuckRun.ID, RunAttemptID: stuckAttempt.ID, AttemptJobID: 1,
+		RepoID: stuckRun.RepoID, OwnerID: stuckRun.OwnerID, JobID: "caller", Name: "caller",
+		Status: actions_model.StatusCancelled, IsReusableCaller: true, IsExpanded: true,
+	}
+	child := &actions_model.ActionRunJob{
+		RunID: stuckRun.ID, RunAttemptID: stuckAttempt.ID, AttemptJobID: 2, ParentJobID: caller.ID,
+		RepoID: stuckRun.RepoID, OwnerID: stuckRun.OwnerID, JobID: "work", Name: "work",
+		Status: actions_model.StatusCancelled,
+	}
+	require.NoError(t, db.Insert(ctx, caller))
+	require.NoError(t, db.Insert(ctx, child))
+
+	var emitted []int64
+	defer test.MockVariableValue(&EmitJobsIfReadyByRun, func(runID int64) error {
+		emitted = append(emitted, runID)
+		return nil
+	})()
+
+	cancelled, err := ForceCancelRun(ctx, stuckRun, []*actions_model.ActionRunJob{caller, child})
+	require.NoError(t, err)
+	assert.Equal(t, actions_model.StatusCancelled, cancelled.Status)
+
+	// settling the run must queue its concurrency groups for a re-check
+	assert.Equal(t, []int64{stuckRun.ID}, emitted)
+	attemptAfter := unittest.AssertExistsAndLoadBean(t, &actions_model.ActionRunAttempt{ID: stuckAttempt.ID})
+	assert.Equal(t, actions_model.StatusCancelled, attemptAfter.Status)
+	waiter, err := findConcurrencyWaiterToWake(ctx, stuckRun.RepoID, stuckRun.ID, group)
+	require.NoError(t, err)
+	assert.Equal(t, waiterRun.ID, waiter, "the settled run no longer holds the group, so its waiter is startable")
+}
