@@ -0,0 +1,46 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package actions
+
+import (
+	"testing"
+
+	actions_model "gitea.dev/models/actions"
+	"gitea.dev/models/db"
+	"gitea.dev/models/unittest"
+	"gitea.dev/modules/test"
+	"gitea.dev/modules/timeutil"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// Cancelling a run whose jobs all reached a final status already updates no job, so only settling
+// the run releases the concurrency group it held. The run must still be emitted for a concurrency
+// check, or the runs blocked behind it stay blocked.
+func TestCancelRun_SettledRunIsEmitted(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+
+	var emittedRunIDs []int64
+	defer test.MockVariableValue(&EmitJobsIfReadyByRun, func(runID int64) error {
+		emittedRunIDs = append(emittedRunIDs, runID)
+		return nil
+	})()
+
+	run, attempt := createRunAttempt(t, 9921, "settled-cancelling-run-cg", actions_model.StatusCancelling)
+	run.LatestAttemptID = attempt.ID
+	require.NoError(t, actions_model.UpdateRun(t.Context(), run, "latest_attempt_id"))
+
+	job := &actions_model.ActionRunJob{
+		RunID: run.ID, RunAttemptID: attempt.ID, RepoID: run.RepoID, OwnerID: run.OwnerID,
+		CommitSHA: "c2d72f548424103f01ee1dc02889c1e2bff816b0", Name: "done", JobID: "done", Attempt: 1,
+		Status: actions_model.StatusCancelled, Stopped: timeutil.TimeStampNow(),
+	}
+	require.NoError(t, db.Insert(t.Context(), job))
+
+	settled, err := CancelRun(t.Context(), run, []*actions_model.ActionRunJob{job})
+	require.NoError(t, err)
+	assert.Equal(t, actions_model.StatusCancelled, settled.Status)
+	assert.Equal(t, []int64{run.ID}, emittedRunIDs)
+}
