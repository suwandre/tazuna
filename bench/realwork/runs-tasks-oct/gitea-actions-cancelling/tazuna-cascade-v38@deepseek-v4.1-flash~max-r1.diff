+// Cancelling a reusable caller must not outrun its descendants: the caller has to stay cancelling
+// while a child waits for its runner, otherwise the runner's final acknowledgement has no status
+// change left to cascade into the run, which stays cancelling forever.
+func TestCancelJobs_ReusableCallerWaitsForDescendants(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+
+	task, leaf := newRunningTaskForCancelling(t, "nested-caller-leaf", true)
+
+	newCaller := func(name string, parentID int64) *ActionRunJob {
+		caller := &ActionRunJob{
+			RunID:            leaf.RunID,
+			RepoID:           leaf.RepoID,
+			OwnerID:          leaf.OwnerID,
+			CommitSHA:        leaf.CommitSHA,
+			Name:             name,
+			JobID:            name,
+			Attempt:          1,
+			Status:           StatusRunning,
+			IsReusableCaller: true,
+			IsExpanded:       true,
+			ParentJobID:      parentID,
+		}
+		require.NoError(t, db.Insert(ctx, caller))
+		return caller
+	}
+	// Insertion order gives ascending IDs, which cancelReusableCaller relies on to cancel deepest-first.
+	outer := newCaller("outer", 0)
+	inner := newCaller("inner", outer.ID)
+	leaf.ParentJobID = inner.ID
+	_, err := UpdateRunJob(ctx, leaf, nil, "parent_job_id")
+	require.NoError(t, err)
+
+	_, err = CancelJobs(ctx, []*ActionRunJob{outer}, false)
+	require.NoError(t, err)
+
+	// The leaf is waiting for its runner, so both callers have to keep it company.
+	assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: leaf.ID}).Status)
+	assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: inner.ID}).Status)
+	assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: outer.ID}).Status)
+	assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: leaf.RunID}).Status)
+
+	// The runner acknowledges the cancellation; the last child finishing must settle both callers and the run.
+	_, err = UpdateTaskByState(ctx, task.RunnerID, &runnerv1.TaskState{
+		Id:        task.ID,
+		Result:    runnerv1.Result_RESULT_CANCELLED,
+		StoppedAt: timestamppb.Now(),
+	})
+	require.NoError(t, err)
+
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: inner.ID}).Status)
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: outer.ID}).Status)
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: leaf.RunID}).Status)
+}
+
+// A child finishing has to recompute its run even when the caller's aggregate does not change:
+// a caller cancelled ahead of its child (as older versions did) would otherwise mask that child
+// and leave the run stuck in cancelling after the runner acknowledged.
+func TestUpdateRunJob_ChildFinishRecomputesRunWithUnchangedCaller(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+
+	run := &ActionRun{
+		Title:         "stuck-cancelling-run",
+		RepoID:        4,
+		Index:         9951,
+		OwnerID:       1,
+		WorkflowID:    "caller.yaml",
+		TriggerUserID: 1,
+		Ref:           "refs/heads/master",
+		CommitSHA:     "c2d72f548424103f01ee1dc02889c1e2bff816b0",
+		Event:         "push",
+		TriggerEvent:  "push",
+		EventPayload:  "{}",
+		Status:        StatusCancelling,
+	}
+	require.NoError(t, db.Insert(ctx, run))
+
+	attempt := &ActionRunAttempt{RepoID: run.RepoID, RunID: run.ID, Attempt: 1, TriggerUserID: 1, Status: StatusCancelling}
+	require.NoError(t, db.Insert(ctx, attempt))
+	run.LatestAttemptID = attempt.ID
+	require.NoError(t, UpdateRun(ctx, run, "latest_attempt_id"))
+
+	caller := &ActionRunJob{
+		RunID: run.ID, RunAttemptID: attempt.ID, RepoID: run.RepoID, OwnerID: run.OwnerID,
+		CommitSHA: run.CommitSHA, Name: "caller", JobID: "caller", Attempt: 1,
+		Status: StatusCancelled, Stopped: timeutil.TimeStampNow(),
+		IsReusableCaller: true, IsExpanded: true,
+	}
+	require.NoError(t, db.Insert(ctx, caller))
+
+	child := &ActionRunJob{
+		RunID: run.ID, RunAttemptID: attempt.ID, RepoID: run.RepoID, OwnerID: run.OwnerID,
+		CommitSHA: run.CommitSHA, Name: "child", JobID: "child", Attempt: 1,
+		ParentJobID: caller.ID, Status: StatusCancelling,
+	}
+	require.NoError(t, db.Insert(ctx, child))
+
+	_, err := UpdateRunJob(ctx, &ActionRunJob{
+		ID: child.ID, RepoID: run.RepoID, Status: StatusCancelled, Stopped: timeutil.TimeStampNow(),
+	}, nil, "status", "stopped")
+	require.NoError(t, err)
+
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: child.ID}).Status)
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRunAttempt{ID: attempt.ID}).Status)
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: run.ID}).Status)
+}
