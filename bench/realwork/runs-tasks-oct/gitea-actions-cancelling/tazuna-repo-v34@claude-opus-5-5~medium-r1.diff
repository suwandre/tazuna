+}
 
-	if c, err := cancelOneJob(ctx, caller, force); err != nil {
-		return cancelledJobs, err
-	} else if c != nil {
-		cancelledJobs = append(cancelledJobs, c)
+// cancelExpandedCaller settles a caller whose children are already cancelled. Its status follows them,
+// so it stays cancelling until the runner of a cancelling child acknowledges.
+func cancelExpandedCaller(ctx context.Context, caller *ActionRunJob, force bool) (*ActionRunJob, error) {
+	current, err := GetRunJobByRunAndID(ctx, caller.RunID, caller.ID)
+	if err != nil {
+		return nil, fmt.Errorf("get caller: %w", err)
 	}
-	return cancelledJobs, nil
+	children, err := GetDirectChildJobsByParent(ctx, current)
+	if err != nil {
+		return nil, err
+	}
+	if len(children) == 0 {
+		return cancelOneJob(ctx, current, force) // not expanded yet
+	}
+	if !current.Status.IsDone() {
+		if err := RefreshReusableCallerStatus(ctx, current); err != nil {
+			return nil, err
+		}
+	}
+	// compared with the given row since cancelling a child may already have refreshed the caller
+	if current.Status == caller.Status {
+		return nil, nil //nolint:nilnil // signal "nothing to cancel; not an error"
+	}
+	return current, nil
 }
