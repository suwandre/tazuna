@@ -0,0 +1,47 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package actions
+
+import (
+	"testing"
+
+	actions_model "gitea.dev/models/actions"
+	"gitea.dev/models/db"
+	"gitea.dev/models/unittest"
+	"gitea.dev/modules/test"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestForceCancelRunWakesConcurrencyGroup(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+
+	// a run stuck in cancelling although all its jobs are cancelled already
+	run, attempt := createRunAttempt(t, 9901, "stuck-cancelling-group", actions_model.StatusCancelling)
+	run.LatestAttemptID = attempt.ID
+	require.NoError(t, actions_model.UpdateRun(t.Context(), run, "latest_attempt_id"))
+	job := &actions_model.ActionRunJob{
+		RunID:        run.ID,
+		RunAttemptID: attempt.ID,
+		AttemptJobID: 1,
+		RepoID:       run.RepoID,
+		OwnerID:      run.OwnerID,
+		Name:         "cancelled-job",
+		JobID:        "cancelled-job",
+		Status:       actions_model.StatusCancelled,
+	}
+	require.NoError(t, db.Insert(t.Context(), job))
+
+	var emitted []int64
+	defer test.MockVariableValue(&EmitJobsIfReadyByRun, func(runID int64) error {
+		emitted = append(emitted, runID)
+		return nil
+	})()
+
+	reloaded, err := ForceCancelRun(t.Context(), run, []*actions_model.ActionRunJob{job})
+	require.NoError(t, err)
+	assert.Equal(t, actions_model.StatusCancelled, reloaded.Status)
+	assert.Equal(t, []int64{run.ID}, emitted)
+}
