+		CommitSHA:     "c2d72f548424103f01ee1dc02889c1e2bff816b0",
+		Event:         "push",
+		TriggerEvent:  "push",
+		EventPayload:  "{}",
+		Status:        StatusRunning,
+		Started:       now,
+	}
+	require.NoError(t, db.Insert(ctx, run))
+
+	attempt := &ActionRunAttempt{
+		RepoID:        run.RepoID,
+		RunID:         run.ID,
+		Attempt:       1,
+		TriggerUserID: run.TriggerUserID,
+		Status:        StatusRunning,
+		Started:       now,
+	}
+	require.NoError(t, db.Insert(ctx, attempt))
+	run.LatestAttemptID = attempt.ID
+	require.NoError(t, UpdateRun(ctx, run, "latest_attempt_id"))
+
+	var nextAttemptJobID int64
+	newCaller := func(name string, parentID int64) *ActionRunJob {
+		t.Helper()
+		nextAttemptJobID++
+		caller := &ActionRunJob{
+			RunID:            run.ID,
+			RunAttemptID:     attempt.ID,
+			RepoID:           run.RepoID,
+			OwnerID:          run.OwnerID,
+			CommitSHA:        run.CommitSHA,
+			Name:             name,
+			JobID:            name,
+			Attempt:          1,
+			Status:           StatusRunning,
+			AttemptJobID:     nextAttemptJobID,
+			IsReusableCaller: true,
+			IsExpanded:       true,
+			ParentJobID:      parentID,
+			Started:          now,
+		}
+		require.NoError(t, db.Insert(ctx, caller))
+		return caller
+	}
+	outer := newCaller("outer", 0)
+	inner := newCaller("inner", outer.ID)
+	child := &ActionRunJob{
+		RunID:        run.ID,
+		RunAttemptID: attempt.ID,
+		RepoID:       run.RepoID,
+		OwnerID:      run.OwnerID,
+		CommitSHA:    run.CommitSHA,
+		Name:         "child",
+		JobID:        "child",
+		Attempt:      1,
+		Status:       StatusRunning,
+		AttemptJobID: nextAttemptJobID + 1,
+		ParentJobID:  inner.ID,
+		Started:      now,
+	}
+	require.NoError(t, db.Insert(ctx, child))
+
+	runner := &ActionRunner{UUID: "nested-cancel-runner", Name: "nested-cancel-runner", HasCancellingSupport: true}
+	require.NoError(t, db.Insert(ctx, runner))
+	task := &ActionTask{
+		JobID:     child.ID,
+		Attempt:   1,
+		RunnerID:  runner.ID,
+		Status:    StatusRunning,
+		Started:   now,
+		RepoID:    run.RepoID,
+		OwnerID:   run.OwnerID,
+		CommitSHA: run.CommitSHA,
+	}
+	require.NoError(t, db.Insert(ctx, task))
+	child.TaskID = task.ID
+	_, err := UpdateRunJob(ctx, child, nil, "task_id")
+	require.NoError(t, err)
+
+	_, err = CancelJobs(ctx, []*ActionRunJob{outer}, false)
+	require.NoError(t, err)
+	for _, job := range []*ActionRunJob{outer, inner, child} {
+		assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: job.ID}).Status)
+	}
+	assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionTask{ID: task.ID}).Status)
+	assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRunAttempt{ID: attempt.ID}).Status)
+	assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: run.ID}).Status)
+
+	_, err = UpdateTaskByState(ctx, runner.ID, &runnerv1.TaskState{
+		Id:        task.ID,
+		Result:    runnerv1.Result_RESULT_CANCELLED,
+		StoppedAt: timestamppb.Now(),
+	})
+	require.NoError(t, err)
+	for _, job := range []*ActionRunJob{outer, inner, child} {
+		assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: job.ID}).Status)
+	}
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionTask{ID: task.ID}).Status)
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRunAttempt{ID: attempt.ID}).Status)
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: run.ID}).Status)
+}
