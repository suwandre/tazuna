+func TestForceCancelRunWakesConcurrencyWaiter(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+	repo := unittest.AssertExistsAndLoadBean(t, &repo_model.Repository{ID: 1})
+	triggerUser := unittest.AssertExistsAndLoadBean(t, &user_model.User{ID: 2})
+	now := timeutil.TimeStampNow()
+
+	insertRun := func(index int64, status actions_model.Status, concurrencyGroup string) (*actions_model.ActionRun, *actions_model.ActionRunAttempt) {
+		t.Helper()
+		run := &actions_model.ActionRun{
+			Title:         "cancel-concurrency-run",
+			RepoID:        repo.ID,
+			Index:         index,
+			OwnerID:       repo.OwnerID,
+			WorkflowID:    "test.yaml",
+			TriggerUserID: triggerUser.ID,
+			Ref:           "refs/heads/main",
+			CommitSHA:     "c2d72f548424103f01ee1dc02889c1e2bff816b0",
+			Status:        status,
+			Started:       util.Iif(status == actions_model.StatusCancelling, now, 0),
+		}
+		require.NoError(t, db.Insert(ctx, run))
+		attempt := &actions_model.ActionRunAttempt{
+			RepoID:           repo.ID,
+			RunID:            run.ID,
+			Attempt:          1,
+			TriggerUserID:    triggerUser.ID,
+			ConcurrencyGroup: concurrencyGroup,
+			Status:           status,
+			Started:          util.Iif(status == actions_model.StatusCancelling, now, 0),
+		}
+		require.NoError(t, db.Insert(ctx, attempt))
+		run.LatestAttemptID = attempt.ID
+		require.NoError(t, actions_model.UpdateRun(ctx, run, "latest_attempt_id"))
+		return run, attempt
+	}
+
+	const concurrencyGroup = "force-cancel-wakes-waiter"
+	cancelledRun, cancelledAttempt := insertRun(9901, actions_model.StatusCancelling, concurrencyGroup)
+	caller := &actions_model.ActionRunJob{
+		RunID:            cancelledRun.ID,
+		RunAttemptID:     cancelledAttempt.ID,
+		RepoID:           repo.ID,
+		OwnerID:          repo.OwnerID,
+		CommitSHA:        cancelledRun.CommitSHA,
+		Name:             "caller",
+		JobID:            "caller",
+		Attempt:          1,
+		Status:           actions_model.StatusCancelled,
+		IsReusableCaller: true,
+		IsExpanded:       true,
+		Started:          now,
+		Stopped:          now,
+	}
+	require.NoError(t, db.Insert(ctx, caller))
+	child := &actions_model.ActionRunJob{
+		RunID:        cancelledRun.ID,
+		RunAttemptID: cancelledAttempt.ID,
+		RepoID:       repo.ID,
+		OwnerID:      repo.OwnerID,
+		CommitSHA:    cancelledRun.CommitSHA,
+		Name:         "child",
+		JobID:        "child",
+		Attempt:      1,
+		Status:       actions_model.StatusCancelled,
+		ParentJobID:  caller.ID,
+		Started:      now,
+		Stopped:      now,
+	}
+	require.NoError(t, db.Insert(ctx, child))
+
+	waiterRun, waiterAttempt := insertRun(9902, actions_model.StatusBlocked, concurrencyGroup)
+	waiterJob := &actions_model.ActionRunJob{
+		RunID:           waiterRun.ID,
+		RunAttemptID:    waiterAttempt.ID,
+		RepoID:          repo.ID,
+		OwnerID:         repo.OwnerID,
+		CommitSHA:       waiterRun.CommitSHA,
+		Name:            "waiter",
+		JobID:           "waiter",
+		Attempt:         1,
+		Status:          actions_model.StatusBlocked,
+		WorkflowPayload: minimalWorkflowPayload("waiter"),
+	}
+	require.NoError(t, db.Insert(ctx, waiterJob))
+
+	var emittedRunIDs []int64
+	defer test.MockVariableValue(&EmitJobsIfReadyByRun, func(runID int64) error {
+		emittedRunIDs = append(emittedRunIDs, runID)
+		return checkJobsByRunID(ctx, runID)
+	})()
+
+	updatedRun, err := ForceCancelRun(ctx, cancelledRun, []*actions_model.ActionRunJob{caller})
+	require.NoError(t, err)
+	assert.Equal(t, actions_model.StatusCancelled, updatedRun.Status)
+	assert.Contains(t, emittedRunIDs, cancelledRun.ID)
+	assert.Equal(t, actions_model.StatusCancelled, unittest.AssertExistsAndLoadBean(t, &actions_model.ActionRunAttempt{ID: cancelledAttempt.ID}).Status)
+	assert.Equal(t, actions_model.StatusWaiting, unittest.AssertExistsAndLoadBean(t, &actions_model.ActionRunAttempt{ID: waiterAttempt.ID}).Status)
+	assert.Equal(t, actions_model.StatusWaiting, unittest.AssertExistsAndLoadBean(t, &actions_model.ActionRun{ID: waiterRun.ID}).Status)
+	assert.Equal(t, actions_model.StatusWaiting, unittest.AssertExistsAndLoadBean(t, &actions_model.ActionRunJob{ID: waiterJob.ID}).Status)
