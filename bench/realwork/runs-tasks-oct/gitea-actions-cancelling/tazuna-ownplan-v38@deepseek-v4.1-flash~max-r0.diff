diff --git a/services/actions/cancel_test.go b/services/actions/cancel_test.go
new file mode 100644
index 0000000..41b2b57
--- /dev/null
+++ b/services/actions/cancel_test.go
@@ -0,0 +1,115 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package actions
+
+import (
+	"testing"
+
+	actions_model "gitea.dev/models/actions"
+	"gitea.dev/models/db"
+	"gitea.dev/models/unittest"
+	"gitea.dev/modules/test"
+	"gitea.dev/modules/timeutil"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestForceCancelRunSettlesAndEmits covers the two halves of cancelling a run whose jobs are already
+// finished: the run's own row has to be settled, and the settled run has to be emitted so the runs
+// waiting on its concurrency group are checked and can start.
+func TestForceCancelRunSettlesAndEmits(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+
+	var emittedRunIDs []int64
+	defer test.MockVariableValue(&EmitJobsIfReadyByRun, func(runID int64) error {
+		emittedRunIDs = append(emittedRunIDs, runID)
+		return nil
+	})()
+
+	newRun := func(t *testing.T, index int64, status actions_model.Status) (*actions_model.ActionRun, *actions_model.ActionRunAttempt) {
+		t.Helper()
+		run := &actions_model.ActionRun{
+			Title: "cancel-settle-test", RepoID: 1, OwnerID: 2, WorkflowID: "test.yml", Index: index,
+			TriggerUserID: 2, Ref: "refs/heads/main",
+			CommitSHA: "c2d72f548424103f01ee1dc02889c1e2bff816b0", Status: status,
+		}
+		require.NoError(t, db.Insert(ctx, run))
+		attempt := &actions_model.ActionRunAttempt{
+			RepoID: run.RepoID, RunID: run.ID, Attempt: 1, TriggerUserID: run.TriggerUserID, Status: status,
+		}
+		require.NoError(t, db.Insert(ctx, attempt))
+		run.LatestAttemptID = attempt.ID
+		require.NoError(t, actions_model.UpdateRun(ctx, run, "latest_attempt_id"))
+		return run, attempt
+	}
+
+	newJob := func(t *testing.T, run *actions_model.ActionRun, attempt *actions_model.ActionRunAttempt, name string, parentID int64, caller bool, status actions_model.Status) *actions_model.ActionRunJob {
+		t.Helper()
+		job := &actions_model.ActionRunJob{
+			RunID: run.ID, RunAttemptID: attempt.ID, RepoID: run.RepoID, OwnerID: run.OwnerID,
+			CommitSHA: run.CommitSHA, Name: name, JobID: name, Attempt: 1, Status: status,
+			ParentJobID: parentID, IsReusableCaller: caller, IsExpanded: caller,
+		}
+		require.NoError(t, db.Insert(ctx, job))
+		return job
+	}
+
+	assertCancelled := func(t *testing.T, run *actions_model.ActionRun, attempt *actions_model.ActionRunAttempt) {
+		t.Helper()
+		assert.Equal(t, actions_model.StatusCancelled, unittest.AssertExistsAndLoadBean(t, &actions_model.ActionRun{ID: run.ID}).Status)
+		assert.Equal(t, actions_model.StatusCancelled, unittest.AssertExistsAndLoadBean(t, &actions_model.ActionRunAttempt{ID: attempt.ID}).Status)
+	}
+
+	// The reported stuck shape: caller and child already cancelled, only the run row stayed cancelling.
+	t.Run("a run whose jobs are all cancelled", func(t *testing.T) {
+		run, attempt := newRun(t, 9801, actions_model.StatusCancelling)
+		attempt.ConcurrencyGroup = "settle-cg"
+		require.NoError(t, actions_model.UpdateRunAttempt(ctx, attempt, "concurrency_group"))
+		caller := newJob(t, run, attempt, "caller", 0, true, actions_model.StatusCancelled)
+		child := newJob(t, run, attempt, "child", caller.ID, false, actions_model.StatusCancelled)
+
+		// a second run waits behind it on the same concurrency group
+		blocked, blockedAttempt := newRun(t, 9803, actions_model.StatusBlocked)
+		blockedAttempt.ConcurrencyGroup = "settle-cg"
+		require.NoError(t, actions_model.UpdateRunAttempt(ctx, blockedAttempt, "concurrency_group"))
+
+		emittedRunIDs = nil
+		got, err := ForceCancelRun(ctx, run, []*actions_model.ActionRunJob{caller, child})
+		require.NoError(t, err)
+		assert.Equal(t, actions_model.StatusCancelled, got.Status)
+		assert.Equal(t, []int64{run.ID}, emittedRunIDs, "the settled run must be emitted to wake its concurrency waiters")
+		assertCancelled(t, run, attempt)
+
+		// the emitted run's concurrency check finds the blocked run runnable and re-emits it
+		result, err := checkRunConcurrency(ctx, got)
+		require.NoError(t, err)
+		assert.Equal(t, []int64{blocked.ID}, result.RunIDsToReEmit)
+	})
+
+	// A force-cancel can hit the child while it still waits for its runner's acknowledgement. The
+	// child's update does not change its already-cancelled caller's aggregate, so nothing else
+	// refreshes the run.
+	t.Run("a caller whose child was still cancelling", func(t *testing.T) {
+		run, attempt := newRun(t, 9802, actions_model.StatusCancelling)
+		caller := newJob(t, run, attempt, "caller", 0, true, actions_model.StatusCancelled)
+		child := newJob(t, run, attempt, "child", caller.ID, false, actions_model.StatusCancelling)
+		task := &actions_model.ActionTask{
+			JobID: child.ID, Attempt: 1, Status: actions_model.StatusCancelling, Started: timeutil.TimeStampNow(),
+			RepoID: run.RepoID, OwnerID: run.OwnerID, CommitSHA: run.CommitSHA,
+		}
+		require.NoError(t, db.Insert(ctx, task))
+		child.TaskID = task.ID
+		_, err := actions_model.UpdateRunJob(ctx, child, nil, "task_id")
+		require.NoError(t, err)
+
+		emittedRunIDs = nil
+		got, err := ForceCancelRun(ctx, run, []*actions_model.ActionRunJob{caller, child})
+		require.NoError(t, err)
+		assert.Equal(t, actions_model.StatusCancelled, got.Status)
+		assert.Equal(t, []int64{run.ID}, emittedRunIDs)
+		assertCancelled(t, run, attempt)
+	})
+}
