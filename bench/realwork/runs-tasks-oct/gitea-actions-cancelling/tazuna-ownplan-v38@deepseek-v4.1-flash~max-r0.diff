+// TestCancelJobs_ReusableCallerWaitsForDescendantAcks covers the reusable workflow cancellation handshake:
+// a caller has no task of its own, so it must stay cancelling while any descendant still waits for its
+// runner to acknowledge, instead of being marked cancelled right away. Marked cancelled too early, the
+// caller would never be refreshed by the descendant's late acknowledgement and the run would stay cancelling.
+func TestCancelJobs_ReusableCallerWaitsForDescendantAcks(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+
+	run := &ActionRun{
+		Title:         "caller-cancel-test",
+		RepoID:        4,
+		Index:         9711,
+		OwnerID:       1,
+		WorkflowID:    "caller.yaml",
+		TriggerUserID: 1,
+		Ref:           "refs/heads/master",
+		CommitSHA:     "c2d72f548424103f01ee1dc02889c1e2bff816b0",
+		Event:         "push",
+		TriggerEvent:  "push",
+		EventPayload:  "{}",
+		Status:        StatusRunning,
+		Started:       timeutil.TimeStampNow(),
+	}
+	require.NoError(t, db.Insert(ctx, run))
+
+	attempt := &ActionRunAttempt{
+		RepoID: run.RepoID, RunID: run.ID, Attempt: 1, TriggerUserID: 1,
+		Status: StatusRunning, Started: timeutil.TimeStampNow(),
+	}
+	require.NoError(t, db.Insert(ctx, attempt))
+	run.LatestAttemptID = attempt.ID
+	require.NoError(t, UpdateRun(ctx, run, "latest_attempt_id"))
+
+	newJob := func(name string, parentID, attemptJobID int64, caller bool) *ActionRunJob {
+		job := &ActionRunJob{
+			RunID: run.ID, RunAttemptID: attempt.ID, RepoID: run.RepoID, OwnerID: run.OwnerID,
+			CommitSHA: run.CommitSHA, Name: name, JobID: name, Attempt: 1, Status: StatusRunning,
+			AttemptJobID: attemptJobID, ParentJobID: parentID, IsReusableCaller: caller, IsExpanded: caller,
+		}
+		require.NoError(t, db.Insert(ctx, job))
+		return job
+	}
+	// outer and inner are callers, so the deepest cancellation acknowledgement has to bubble up twice.
+	outer := newJob("outer", 0, 1, true)
+	inner := newJob("inner", outer.ID, 2, true)
+	leaf := newJob("leaf", inner.ID, 3, false)
+
+	runner := &ActionRunner{UUID: "ack-cancel-runner", Name: "ack-cancel-runner", HasCancellingSupport: true}
+	require.NoError(t, db.Insert(ctx, runner))
+	task := &ActionTask{
+		JobID: leaf.ID, Attempt: 1, RunnerID: runner.ID, Status: StatusRunning,
+		Started: timeutil.TimeStampNow(), RepoID: run.RepoID, OwnerID: run.OwnerID, CommitSHA: run.CommitSHA,
+	}
+	require.NoError(t, db.Insert(ctx, task))
+	leaf.TaskID = task.ID
+	_, err := UpdateRunJob(ctx, leaf, nil, "task_id")
+	require.NoError(t, err)
+
+	// cancel just the caller, as the concurrency path can: cancelReusableCaller walks the whole subtree.
+	caller, err := GetRunJobByRunAndID(ctx, run.ID, outer.ID)
+	require.NoError(t, err)
+	_, err = CancelJobs(ctx, []*ActionRunJob{caller}, false)
+	require.NoError(t, err)
+
+	assertStatus := func(want Status) {
+		t.Helper()
+		for _, j := range []*ActionRunJob{outer, inner, leaf} {
+			assert.Equal(t, want, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: j.ID}).Status, "job %q", j.JobID)
+		}
+		assert.Equal(t, want, unittest.AssertExistsAndLoadBean(t, &ActionRunAttempt{ID: attempt.ID}).Status)
+		assert.Equal(t, want, unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: run.ID}).Status)
+	}
+
+	// the leaf waits for the runner, so its whole caller chain and the run have to wait too
+	assertStatus(StatusCancelling)
+
+	// the runner acknowledges: the leaf, its callers and the run all reach cancelled
+	_, err = UpdateTaskByState(ctx, runner.ID, &runnerv1.TaskState{
+		Id:        task.ID,
+		Result:    runnerv1.Result_RESULT_SUCCESS,
+		StoppedAt: timestamppb.Now(),
+	})
+	require.NoError(t, err)
+
+	assertStatus(StatusCancelled)
+}
