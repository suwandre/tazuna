+// Cancelling a reusable caller whose child has a task must leave the caller (at any nesting depth) and
+// the run cancelling until the runner acknowledges. Regression: the caller used to be written Cancelled
+// right away, so the acknowledgement no longer changed it and the run stayed Cancelling forever,
+// blocking the runs waiting behind it in the same concurrency group.
+func TestCancelJobs_ReusableCallerWaitsForDescendantAck(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+
+	task, child := newRunningTaskForCancelling(t, "wait-for-ack-child", true)
+
+	newCaller := func(name string, parentID int64) *ActionRunJob {
+		caller := &ActionRunJob{
+			RunID:            child.RunID,
+			RunAttemptID:     child.RunAttemptID,
+			RepoID:           child.RepoID,
+			OwnerID:          child.OwnerID,
+			CommitSHA:        child.CommitSHA,
+			Name:             name,
+			JobID:            name,
+			Attempt:          1,
+			Status:           StatusRunning,
+			IsReusableCaller: true,
+			IsExpanded:       true,
+			ParentJobID:      parentID,
+		}
+		require.NoError(t, db.Insert(ctx, caller))
+		return caller
+	}
+	outer := newCaller("wait-for-ack-outer", 0)
+	inner := newCaller("wait-for-ack-inner", outer.ID)
+	child.ParentJobID = inner.ID
+	_, err := UpdateRunJob(ctx, child, nil, "parent_job_id")
+	require.NoError(t, err)
+
+	cancelled, err := CancelJobs(ctx, []*ActionRunJob{outer}, false)
+	require.NoError(t, err)
+	assert.Len(t, cancelled, 3, "the child and both callers moved out of Running")
+
+	for _, caller := range []*ActionRunJob{outer, inner} {
+		assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: caller.ID}).Status, "caller %q must wait for its descendants", caller.JobID)
+	}
+	assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: child.ID}).Status)
+	assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: child.RunID}).Status)
+
+	// The runner acknowledges the cancellation, finishing its cleanup phase.
+	_, err = UpdateTaskByState(ctx, task.RunnerID, &runnerv1.TaskState{Id: task.ID, Result: runnerv1.Result_RESULT_CANCELLED})
+	require.NoError(t, err)
+
+	for _, caller := range []*ActionRunJob{outer, inner} {
+		assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: caller.ID}).Status, "caller %q follows its cancelled children", caller.JobID)
+	}
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: child.ID}).Status)
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: child.RunID}).Status)
+}
