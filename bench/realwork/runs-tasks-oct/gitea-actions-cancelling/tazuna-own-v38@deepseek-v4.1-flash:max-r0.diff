+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package actions
+
+import (
+	"testing"
+
+	actions_model "gitea.dev/models/actions"
+	"gitea.dev/models/db"
+	"gitea.dev/models/unittest"
+	"gitea.dev/modules/test"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// A run can be left non-final with all its jobs done (e.g. a reusable caller cancelled before its child
+// acknowledged, on an older version). Force-cancelling such a run must settle it and wake the runs
+// blocked on its concurrency group, which nothing else does because no job update is written.
+func TestForceCancelRun_SettledRunWakesConcurrencyWaiter(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+
+	var emittedRunIDs []int64
+	defer test.MockVariableValue(&EmitJobsIfReadyByRun, func(runID int64) error {
+		emittedRunIDs = append(emittedRunIDs, runID)
+		return nil
+	})()
+
+	const group = "force-cancel-settles-cg"
+	stuckRun, stuckAttempt := createRunAttempt(t, 99601, group, actions_model.StatusCancelling)
+	stuckRun.LatestAttemptID = stuckAttempt.ID
+	require.NoError(t, actions_model.UpdateRun(ctx, stuckRun, "latest_attempt_id"))
+
+	caller := &actions_model.ActionRunJob{
+		RunID: stuckRun.ID, RunAttemptID: stuckAttempt.ID, AttemptJobID: 1,
+		RepoID: stuckRun.RepoID, OwnerID: stuckRun.OwnerID,
+		Name: "caller", JobID: "caller", Status: actions_model.StatusCancelled,
+		IsReusableCaller: true, IsExpanded: true,
+	}
+	require.NoError(t, db.Insert(ctx, caller))
+	child := &actions_model.ActionRunJob{
+		RunID: stuckRun.ID, RunAttemptID: stuckAttempt.ID, AttemptJobID: 2,
+		RepoID: stuckRun.RepoID, OwnerID: stuckRun.OwnerID,
+		Name: "child", JobID: "child", Status: actions_model.StatusCancelled,
+		ParentJobID: caller.ID,
+	}
+	require.NoError(t, db.Insert(ctx, child))
+
+	// A run blocked behind the stuck one in the same group.
+	waiterRun, _ := createRunAttempt(t, 99602, group, actions_model.StatusBlocked)
+
+	jobs, err := actions_model.GetRunJobsByRunAndAttemptID(ctx, stuckRun.ID, stuckAttempt.ID)
+	require.NoError(t, err)
+	reloaded, err := ForceCancelRun(ctx, stuckRun, jobs)
+	require.NoError(t, err)
+	assert.Equal(t, actions_model.StatusCancelled, reloaded.Status)
+	assert.Equal(t, []int64{stuckRun.ID}, emittedRunIDs, "the settled run must be emitted so its concurrency group is re-checked")
+
+	result, err := checkRunConcurrency(ctx, reloaded)
+	require.NoError(t, err)
+	assert.Equal(t, []int64{waiterRun.ID}, result.RunIDsToReEmit, "the blocked run is woken once the group is free")
+}
