+// While a reusable caller's child is waiting for its runner to acknowledge the cancel, the caller,
+// its attempt and the run must stay cancelling; the acknowledgement then cascades cancelled up.
+func TestCancelJobs_ReusableCallerWaitsForChild(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+
+	run := &ActionRun{
+		Title:         "caller-waits-for-child",
+		RepoID:        4,
+		Index:         9751,
+		OwnerID:       1,
+		WorkflowID:    "caller.yaml",
+		TriggerUserID: 1,
+		Ref:           "refs/heads/master",
+		CommitSHA:     "c2d72f548424103f01ee1dc02889c1e2bff816b0",
+		Event:         "push",
+		TriggerEvent:  "push",
+		EventPayload:  "{}",
+		Status:        StatusRunning,
+		Started:       timeutil.TimeStampNow(),
+	}
+	require.NoError(t, db.Insert(ctx, run))
+
+	attempt := &ActionRunAttempt{
+		RepoID:        run.RepoID,
+		RunID:         run.ID,
+		Attempt:       1,
+		TriggerUserID: run.TriggerUserID,
+		Status:        StatusRunning,
+		Started:       run.Started,
+	}
+	require.NoError(t, db.Insert(ctx, attempt))
+	run.LatestAttemptID = attempt.ID
+	require.NoError(t, UpdateRun(ctx, run, "latest_attempt_id"))
+
+	caller := &ActionRunJob{
+		RunID: run.ID, RunAttemptID: attempt.ID, RepoID: run.RepoID, OwnerID: run.OwnerID,
+		CommitSHA: run.CommitSHA, Name: "caller", JobID: "caller", Attempt: 1, AttemptJobID: 1,
+		Status: StatusRunning, IsReusableCaller: true, IsExpanded: true,
+	}
+	require.NoError(t, db.Insert(ctx, caller))
+
+	runner := &ActionRunner{UUID: "caller-child-runner", Name: "caller-child-runner", HasCancellingSupport: true}
+	require.NoError(t, db.Insert(ctx, runner))
+
+	child := &ActionRunJob{
+		RunID: run.ID, RunAttemptID: attempt.ID, RepoID: run.RepoID, OwnerID: run.OwnerID,
+		CommitSHA: run.CommitSHA, Name: "child", JobID: "child", Attempt: 1, AttemptJobID: 2,
+		Status: StatusRunning, ParentJobID: caller.ID,
+	}
+	require.NoError(t, db.Insert(ctx, child))
+
+	task := &ActionTask{
+		JobID: child.ID, Attempt: 1, RunnerID: runner.ID, Status: StatusRunning,
+		Started: timeutil.TimeStampNow(), RepoID: run.RepoID, OwnerID: run.OwnerID, CommitSHA: run.CommitSHA,
+	}
+	require.NoError(t, db.Insert(ctx, task))
+	child.TaskID = task.ID
+	_, err := UpdateRunJob(ctx, child, nil, "task_id")
+	require.NoError(t, err)
+
+	_, err = CancelJobs(ctx, []*ActionRunJob{caller}, false)
+	require.NoError(t, err)
+
+	assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: caller.ID}).Status,
+		"the caller must wait for its cancelling child")
+	assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: child.ID}).Status)
+	assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRunAttempt{ID: attempt.ID}).Status)
+	assert.Equal(t, StatusCancelling, unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: run.ID}).Status)
+
+	// the runner acknowledges the cancellation
+	_, err = UpdateTaskByState(ctx, runner.ID, &runnerv1.TaskState{
+		Id:        task.ID,
+		Result:    runnerv1.Result_RESULT_CANCELLED,
+		StoppedAt: timestamppb.Now(),
+	})
+	require.NoError(t, err)
+
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: child.ID}).Status)
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: caller.ID}).Status,
+		"the acknowledged child must finish its caller")
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRunAttempt{ID: attempt.ID}).Status)
+	assert.Equal(t, StatusCancelled, unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: run.ID}).Status)
+}
