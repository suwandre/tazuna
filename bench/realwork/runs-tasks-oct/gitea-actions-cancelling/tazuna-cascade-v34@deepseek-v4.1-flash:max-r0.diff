+// cancelReusableCallerJob settles a cancelled reusable caller from its children.
+// A caller runs no task of its own, but its status aggregates its children's: while any child is still
+// cancelling, waiting for its runner to acknowledge, the caller has to stay cancelling too, so the
+// acknowledgement can later cascade cancelled through the callers up to the run.
+// A caller without children has nothing to wait for and is cancelled directly.
+func cancelReusableCallerJob(ctx context.Context, caller *ActionRunJob) (*ActionRunJob, error) {
+	children, err := GetDirectChildJobsByParent(ctx, caller)
+	if err != nil {
+		return nil, err
+	}
+	if len(children) > 0 {
+		if err := RefreshReusableCallerStatus(ctx, caller); err != nil {
+			return nil, err
+		}
+		return caller, nil
+	}
+
+	caller.Status = StatusCancelled
+	caller.Stopped = timeutil.TimeStampNow()
+	n, err := UpdateRunJob(ctx, caller, builder.Eq{"task_id": 0}, "status", "stopped")
+	if err != nil {
+		return nil, err
+	}
+	if n == 0 {
+		log.Error("Failed to cancel job %d because it has changed", caller.ID)
+		return nil, nil //nolint:nilnil // signal "nothing to cancel; not an error"
+	}
+	return caller, nil
+}
