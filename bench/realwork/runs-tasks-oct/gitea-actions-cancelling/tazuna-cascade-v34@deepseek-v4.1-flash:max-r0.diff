+	"github.com/stretchr/testify/require"
+)
+
+// A run settled by a cancel must be emitted even when no job changed status, so the job emitter
+// checks its concurrency group and wakes the runs blocked behind it.
+func TestForceCancelRun_WakesConcurrencyWaiter(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+
+	const group = "cancel-settles-and-wakes"
+	holder, holderAttempt := createRunAttempt(t, 99511, group, actions_model.StatusCancelling)
+	holder.LatestAttemptID = holderAttempt.ID
+	require.NoError(t, actions_model.UpdateRun(ctx, holder, "latest_attempt_id"))
+	require.NoError(t, db.Insert(ctx, &actions_model.ActionRunJob{
+		RunID: holder.ID, RunAttemptID: holderAttempt.ID, AttemptJobID: 1,
+		RepoID: holder.RepoID, OwnerID: holder.OwnerID,
+		JobID: "work", Name: "work", Status: actions_model.StatusCancelled,
+	}))
+
+	waiter, waiterAttempt := createRunAttempt(t, 99512, group, actions_model.StatusBlocked)
+	waiter.LatestAttemptID = waiterAttempt.ID
+	require.NoError(t, actions_model.UpdateRun(ctx, waiter, "latest_attempt_id"))
+	waiterJob := &actions_model.ActionRunJob{
+		RunID: waiter.ID, RunAttemptID: waiterAttempt.ID, AttemptJobID: 1,
+		RepoID: waiter.RepoID, OwnerID: waiter.OwnerID,
+		JobID: "work", Name: "work", Status: actions_model.StatusBlocked,
+		WorkflowPayload: minimalWorkflowPayload("work"),
+	}
+	require.NoError(t, db.Insert(ctx, waiterJob))
+
+	var emitted []int64
+	defer test.MockVariableValue(&EmitJobsIfReadyByRun, func(runID int64) error {
+		emitted = append(emitted, runID)
+		return nil
+	})()
+
+	holderJobs, err := actions_model.GetRunJobsByRunAndAttemptID(ctx, holder.ID, holderAttempt.ID)
+	require.NoError(t, err)
+	reloaded, err := ForceCancelRun(ctx, holder, holderJobs)
+	require.NoError(t, err)
+	assert.Equal(t, actions_model.StatusCancelled, reloaded.Status)
+	require.Contains(t, emitted, holder.ID, "the settled run must be emitted for its waiters")
+
+	// process the emitted runs like the job emitter queue does
+	require.NoError(t, checkJobsByRunID(ctx, holder.ID))
+	require.Contains(t, emitted, waiter.ID, "the waiter must be re-emitted")
+	require.NoError(t, checkJobsByRunID(ctx, waiter.ID))
+
+	assert.Equal(t, actions_model.StatusWaiting, unittest.AssertExistsAndLoadBean(t, &actions_model.ActionRunJob{ID: waiterJob.ID}).Status)
+	assert.Equal(t, actions_model.StatusWaiting, unittest.AssertExistsAndLoadBean(t, &actions_model.ActionRun{ID: waiter.ID}).Status)
+}
