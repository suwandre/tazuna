+// cancelReusableCallerWithoutTask derives the caller's status from its children, so it stays
+// cancelling until the runner acknowledges the last cancelling child, which then refreshes the run.
+func cancelReusableCallerWithoutTask(ctx context.Context, caller *ActionRunJob) (*ActionRunJob, error) {
+	children, err := GetDirectChildJobsByParent(ctx, caller)
+	if err != nil {
+		return nil, err
+	}
+	if len(children) == 0 {
+		caller.Status = StatusCancelled
+		caller.Stopped = timeutil.TimeStampNow()
+		n, err := UpdateRunJob(ctx, caller, builder.Eq{"task_id": 0}, "status", "stopped")
+		if err != nil {
+			return nil, err
+		}
+		if n == 0 {
+			log.Error("Failed to cancel job %d because it has changed", caller.ID)
+			return nil, nil //nolint:nilnil // signal "nothing to cancel; not an error"
+		}
+		return caller, nil
+	}
+
+	oldStatus := caller.Status
+	if err := RefreshReusableCallerStatus(ctx, caller); err != nil {
+		return nil, err
+	}
+	if caller.Status == oldStatus {
+		return nil, nil //nolint:nilnil // signal "nothing to cancel; not an error"
+	}
+	return caller, nil
+}
