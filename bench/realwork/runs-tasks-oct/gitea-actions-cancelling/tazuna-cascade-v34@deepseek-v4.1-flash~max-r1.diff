+// A caller has no task of its own, so its status must keep aggregating its children while they
+// are being cancelled: cancelling it directly would leave the run cancelling forever, because the
+// child's later acknowledgment finds the caller already final and never refreshes the run.
+func TestCancelJobs_ReusableCallerStaysCancellingUntilChildAcknowledged(t *testing.T) {
+	for _, depth := range []int{1, 2} {
+		t.Run(fmt.Sprintf("caller depth %d", depth), func(t *testing.T) {
+			require.NoError(t, unittest.PrepareTestDatabase())
+			ctx := t.Context()
+
+			run := &ActionRun{
+				Title: "caller-cancel-run", RepoID: 1, OwnerID: 2, WorkflowID: "test.yaml", Index: 9702,
+				TriggerUserID: 2, Ref: "refs/heads/master", CommitSHA: "c2d72f548424103f01ee1dc02889c1e2bff816b0",
+				Event: "push", TriggerEvent: "push", Status: StatusRunning, Started: timeutil.TimeStampNow(),
+			}
+			require.NoError(t, db.Insert(ctx, run))
+
+			// Chain the wanted number of reusable callers, then the child job: a child row is always
+			// inserted after its parent, which is what makes descending-ID cancellation deepest-first.
+			callers := make([]*ActionRunJob, 0, depth)
+			parentID := int64(0)
+			for i := range depth {
+				caller := &ActionRunJob{
+					RunID:            run.ID,
+					RepoID:           run.RepoID,
+					OwnerID:          run.OwnerID,
+					CommitSHA:        run.CommitSHA,
+					Name:             fmt.Sprintf("caller-%d", i),
+					JobID:            fmt.Sprintf("caller-%d", i),
+					Attempt:          1,
+					Status:           StatusRunning,
+					IsReusableCaller: true,
+					IsExpanded:       true,
+					ParentJobID:      parentID,
+				}
+				require.NoError(t, db.Insert(ctx, caller))
+				callers = append(callers, caller)
+				parentID = caller.ID
+			}
+			child := &ActionRunJob{
+				RunID: run.ID, RepoID: run.RepoID, OwnerID: run.OwnerID, CommitSHA: run.CommitSHA,
+				Name: "child", JobID: "child", Attempt: 1, Status: StatusRunning, ParentJobID: parentID,
+			}
+			require.NoError(t, db.Insert(ctx, child))
+
+			runner := &ActionRunner{UUID: "caller-child-runner", Name: "caller-child-runner", HasCancellingSupport: true}
+			require.NoError(t, db.Insert(ctx, runner))
+			task := &ActionTask{
+				JobID: child.ID, Attempt: 1, RunnerID: runner.ID, Status: StatusRunning, Started: timeutil.TimeStampNow(),
+				RepoID: run.RepoID, OwnerID: run.OwnerID, CommitSHA: run.CommitSHA,
+			}
+			require.NoError(t, db.Insert(ctx, task))
+			child.TaskID = task.ID
+			_, err := UpdateRunJob(ctx, child, nil, "task_id")
+			require.NoError(t, err)
+
+			cancelled, err := CancelJobs(ctx, []*ActionRunJob{callers[0]}, false)
+			require.NoError(t, err)
+			require.NotEmpty(t, cancelled)
+
+			// The child is in the cancelling handshake, so every caller above it and the run must be cancelling.
+			for _, caller := range callers {
+				callerAfter := unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: caller.ID})
+				assert.Equal(t, StatusCancelling, callerAfter.Status, "caller %q", caller.JobID)
+			}
+			childAfter := unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: child.ID})
+			assert.Equal(t, StatusCancelling, childAfter.Status)
+			runAfter := unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: run.ID})
+			assert.Equal(t, StatusCancelling, runAfter.Status)
+
+			// Once the runner acknowledges, the callers aggregate their now-final child and settle the run.
+			_, err = UpdateTaskByState(ctx, task.RunnerID, &runnerv1.TaskState{
+				Id:        task.ID,
+				Result:    runnerv1.Result_RESULT_CANCELLED,
+				StoppedAt: timestamppb.Now(),
+			})
+			require.NoError(t, err)
+
+			for _, caller := range callers {
+				callerAfter := unittest.AssertExistsAndLoadBean(t, &ActionRunJob{ID: caller.ID})
+				assert.Equal(t, StatusCancelled, callerAfter.Status, "caller %q", caller.JobID)
+				assert.NotZero(t, callerAfter.Stopped)
+			}
+			runAfter = unittest.AssertExistsAndLoadBean(t, &ActionRun{ID: run.ID})
+			assert.Equal(t, StatusCancelled, runAfter.Status)
+			assert.NotZero(t, runAfter.Stopped)
+		})
+	}
+}
