+// A run cancelled before its caller's status was derived from its children (existing stuck runs)
+// has a caller that is already final while a child still holds a task. The child's update then
+// cannot cascade through the caller, so a force-cancel has to settle the run itself.
+func TestForceCancelRun_SettlesRunWithFinalCaller(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+
+	run := &actions_model.ActionRun{
+		RepoID: 4, OwnerID: 1, TriggerUserID: 1, WorkflowID: "test.yml",
+		Index: 99702, Ref: "refs/heads/main", Status: actions_model.StatusCancelling,
+		Started: timeutil.TimeStampNow(),
+	}
+	require.NoError(t, db.Insert(ctx, run))
+	attempt := &actions_model.ActionRunAttempt{
+		RepoID: run.RepoID, RunID: run.ID, Attempt: 1, TriggerUserID: run.TriggerUserID,
+		Status: actions_model.StatusCancelling, ConcurrencyGroup: "settled-cancel-group",
+	}
+	require.NoError(t, db.Insert(ctx, attempt))
+	run.LatestAttemptID = attempt.ID
+	require.NoError(t, actions_model.UpdateRun(ctx, run, "latest_attempt_id"))
+
+	caller := &actions_model.ActionRunJob{
+		RunID: run.ID, RunAttemptID: attempt.ID, AttemptJobID: 1, RepoID: run.RepoID, OwnerID: run.OwnerID,
+		JobID: "caller", Name: "caller", Status: actions_model.StatusCancelled, Stopped: timeutil.TimeStampNow(),
+		IsReusableCaller: true, IsExpanded: true,
+	}
+	require.NoError(t, db.Insert(ctx, caller))
+	child := &actions_model.ActionRunJob{
+		RunID: run.ID, RunAttemptID: attempt.ID, AttemptJobID: 2, RepoID: run.RepoID, OwnerID: run.OwnerID,
+		JobID: "child", Name: "child", Status: actions_model.StatusCancelling, ParentJobID: caller.ID,
+	}
+	require.NoError(t, db.Insert(ctx, child))
+	task := &actions_model.ActionTask{
+		JobID: child.ID, Attempt: 1, Status: actions_model.StatusCancelling,
+		RepoID: run.RepoID, OwnerID: run.OwnerID,
+	}
+	require.NoError(t, db.Insert(ctx, task))
+	child.TaskID = task.ID
+	_, err := actions_model.UpdateRunJob(ctx, child, nil, "task_id")
+	require.NoError(t, err)
+
+	emitted := make([]int64, 0, 1)
+	defer test.MockVariableValue(&EmitJobsIfReadyByRun, func(runID int64) error {
+		emitted = append(emitted, runID)
+		return nil
+	})()
+
+	cancelledRun, err := ForceCancelRun(ctx, run, []*actions_model.ActionRunJob{caller, child})
+	require.NoError(t, err)
+	assert.Equal(t, actions_model.StatusCancelled, cancelledRun.Status)
+	assert.Equal(t, []int64{run.ID}, emitted)
+}
