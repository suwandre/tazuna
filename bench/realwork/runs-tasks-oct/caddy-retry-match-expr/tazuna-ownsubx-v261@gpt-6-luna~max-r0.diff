+// PlaceholderReferences returns the statically known placeholder names used by
+// m and whether it references any placeholder name that cannot be determined
+// until evaluation time.
+func (m MatchExpression) PlaceholderReferences() ([]string, bool) {
+	return append([]string(nil), m.placeholderRefs...), m.dynamicPlaceholderRef
+}
+
+// celStringLiteralValue returns the value of a string expression composed only
+// of string literals and concatenation, or false if it cannot be determined
+// without evaluating the expression.
+func celStringLiteralValue(e ast.Expr) (string, bool) {
+	if e.Kind() == ast.LiteralKind {
+		value, ok := e.AsLiteral().Value().(string)
+		return value, ok
+	}
+	if e.Kind() != ast.CallKind {
+		return "", false
+	}
+	call := e.AsCall()
+	if call.FunctionName() != operators.Add || call.IsMemberFunction() {
+		return "", false
+	}
+	var value strings.Builder
+	for _, arg := range call.Args() {
+		part, ok := celStringLiteralValue(arg)
+		if !ok {
+			return "", false
+		}
+		value.WriteString(part)
+	}
+	return value.String(), true
+}
