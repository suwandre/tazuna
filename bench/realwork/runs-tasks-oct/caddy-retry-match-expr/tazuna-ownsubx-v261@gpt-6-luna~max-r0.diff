+// TestRetryExpressionResponsePlaceholderDetection verifies that response
+// retries are enabled only when an expression reads a response placeholder.
+func TestRetryExpressionResponsePlaceholderDetection(t *testing.T) {
+	tests := []struct {
+		name       string
+		expression string
+		want       bool
+	}{
+		{
+			name:       "request method",
+			expression: `{http.request.method} == "POST"`,
+		},
+		{
+			name:       "request upstream placeholder",
+			expression: `{http.reverse_proxy.upstream.host} != ""`,
+		},
+		{
+			name:       "escaped response placeholder text",
+			expression: `"\{http.reverse_proxy.status_code}" == "\{http.reverse_proxy.status_code}"`,
+		},
+		{
+			name:       "similar but distinct placeholder",
+			expression: `ph(req, "http.reverse_proxy.status_codes") == null`,
+		},
+		{
+			name:       "transport error placeholder",
+			expression: `{http.reverse_proxy.is_transport_error} == true`,
+		},
+		{
+			name:       "status code shorthand",
+			expression: `{http.reverse_proxy.status_code} == 502`,
+			want:       true,
+		},
+		{
+			name:       "status text",
+			expression: `{http.reverse_proxy.status_text} != ""`,
+			want:       true,
+		},
+		{
+			name:       "response header",
+			expression: `{http.reverse_proxy.header.X-Retry} == "true"`,
+			want:       true,
+		},
+		{
+			name:       "upstream latency",
+			expression: `{http.reverse_proxy.upstream.latency} != null`,
+			want:       true,
+		},
+		{
+			name:       "upstream latency milliseconds",
+			expression: `{http.reverse_proxy.upstream.latency_ms} != null`,
+			want:       true,
+		},
+		{
+			name:       "direct placeholder function",
+			expression: `ph(req, "http.reverse_proxy.status_code") == 502`,
+			want:       true,
+		},
+		{
+			name:       "static concatenated request placeholder",
+			expression: `ph(req, "http.reverse_proxy.upstream." + "host") != ""`,
+		},
+		{
+			name:       "dynamic placeholder function",
+			expression: `ph(req, {http.request.method} == "POST" ? "http.reverse_proxy.status_code" : "http.request.method") == 502`,
+			want:       true,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			matcher := newExpressionMatcher(t, tc.expression)
+			got := matcherSetHasResponsePlaceholder(caddyhttp.MatcherSet{matcher})
+			if got != tc.want {
+				t.Errorf("matcherSetHasResponsePlaceholder() = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
