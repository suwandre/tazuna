+// TestRetryExpressionDirectPlaceholderCalls verifies that response placeholders
+// passed to ph(req, ...) directly trigger response retries, including a name
+// that is determined dynamically.
+func TestRetryExpressionDirectPlaceholderCalls(t *testing.T) {
+	tests := []struct {
+		name       string
+		expression string
+		dynamic    bool
+	}{
+		{
+			name:       "literal placeholder name",
+			expression: `ph(req, "http.reverse_proxy.status_code") == 502`,
+		},
+		{
+			name:       "dynamic placeholder name",
+			expression: `ph(req, ph(req, "test.retry.placeholder")) == 502`,
+			dynamic:    true,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			badServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusBadGateway)
+			}))
+			t.Cleanup(badServer.Close)
+			goodServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusOK)
+				_, _ = w.Write([]byte("good"))
+			}))
+			t.Cleanup(goodServer.Close)
+
+			retryMatch := caddyhttp.MatcherSets{
+				caddyhttp.MatcherSet{newExpressionMatcher(t, tc.expression)},
+			}
+			// RoundRobin selects the last upstream first.
+			upstreams := []*Upstream{
+				{Host: new(Host), Dial: goodServer.Listener.Addr().String()},
+				{Host: new(Host), Dial: badServer.Listener.Addr().String()},
+			}
+			h := minimalHandlerWithRetryMatch(1, retryMatch, upstreams...)
+
+			req := httptest.NewRequest(http.MethodGet, "http://example.com/", nil)
+			req = prepareTestRequest(req)
+			if tc.dynamic {
+				repl, _ := req.Context().Value(caddy.ReplacerCtxKey).(*caddy.Replacer)
+				repl.Set("test.retry.placeholder", "http.reverse_proxy.status_code")
+			}
+			rec := httptest.NewRecorder()
+			err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+				return nil
+			}))
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			if rec.Code != http.StatusOK {
+				t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+			}
+			if got := rec.Body.String(); got != "good" {
+				t.Errorf("response body: got %q, want %q", got, "good")
+			}
+		})
+	}
+}
