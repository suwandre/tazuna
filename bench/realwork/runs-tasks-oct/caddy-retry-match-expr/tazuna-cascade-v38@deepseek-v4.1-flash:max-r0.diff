+
+// TestMatcherSetReferencesResponse checks which CEL expressions are treated
+// as response conditions: only those that read placeholders populated by the
+// upstream round trip (status, headers, upstream latency) or whose placeholder
+// name is only known at evaluation time.
+func TestMatcherSetReferencesResponse(t *testing.T) {
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		// request-only expressions must not be evaluated against responses
+		{expr: `{http.request.method} == "POST"`, want: false},
+		{expr: `{http.reverse_proxy.upstream.host} == "127.0.0.1"`, want: false},
+		{expr: `{http.request.uri.path} != "\{http.reverse_proxy.status_code}"`, want: false},
+		{expr: `{http.reverse_proxy.status_codes} == null`, want: false},
+
+		// expressions reading response data must still be evaluated
+		{expr: `{http.reverse_proxy.status_code} in [502, 503]`, want: true},
+		{expr: `ph(req, "http.reverse_proxy.status_code") in [502, 503]`, want: true},
+		{expr: `{http.reverse_proxy.status_text} == "Bad Gateway"`, want: true},
+		{expr: `{http.reverse_proxy.header.X-Retry} == "true"`, want: true},
+		{expr: `{http.reverse_proxy.upstream.latency} == null`, want: true},
+		{expr: `{http.reverse_proxy.upstream.latency_ms} == null`, want: true},
+
+		// a placeholder name only known at evaluation time is conservatively
+		// treated as a possible response condition
+		{expr: `ph(req, {http.request.header.X-Placeholder}) == "x"`, want: true},
+	} {
+		t.Run(tc.expr, func(t *testing.T) {
+			m := newExpressionMatcher(t, tc.expr)
+			set := caddyhttp.MatcherSet{m}
+			if got := matcherSetReferencesResponse(set); got != tc.want {
+				t.Errorf("matcherSetReferencesResponse(%q) = %v, want %v", tc.expr, got, tc.want)
+			}
+		})
+	}
+}
+
+// TestRetryMatchRequestOnlyExpression verifies that a successful response is
+// not retried when the retry_match expression only tests the request or the
+// selected upstream, even though the expression matches every request.
+func TestRetryMatchRequestOnlyExpression(t *testing.T) {
+	for _, expr := range []string{
+		`{http.request.method} == "POST"`,
+		`{http.reverse_proxy.upstream.host} == "127.0.0.1"`,
+		`{http.request.uri.path} != "\{http.reverse_proxy.status_code}"`,
+		`{http.reverse_proxy.status_codes} == null`,
+	} {
+		t.Run(expr, func(t *testing.T) {
+			var hits atomic.Int32
+
+			// Both upstreams always answer 200, so a response-based retry
+			// would consume the retries and ultimately fail the request.
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				hits.Add(1)
+				w.WriteHeader(http.StatusOK)
+				_, _ = w.Write([]byte("ok"))
+			}))
+			t.Cleanup(server.Close)
+
+			retryMatch := caddyhttp.MatcherSets{
+				caddyhttp.MatcherSet{
+					newExpressionMatcher(t, expr),
+				},
+			}
+
+			upstreams := []*Upstream{
+				{Host: new(Host), Dial: server.Listener.Addr().String()},
+				{Host: new(Host), Dial: server.Listener.Addr().String()},
+			}
+
+			h := minimalHandlerWithRetryMatch(2, retryMatch, upstreams...)
+
+			req := httptest.NewRequest(http.MethodPost, "http://example.com/", strings.NewReader("order=1"))
+			req = prepareTestRequest(req)
+			rec := httptest.NewRecorder()
+
+			err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+				return nil
+			}))
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			if hits.Load() != 1 {
+				t.Errorf("upstream hits: got %d, want 1 (request-only expression must not retry successful responses)", hits.Load())
+			}
+			if rec.Code != http.StatusOK {
+				t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+			}
+			if rec.Body.String() != "ok" {
+				t.Errorf("body: got %q, want %q", rec.Body.String(), "ok")
+			}
+		})
+	}
+}
+
+// TestRetryMatchResponseExpression verifies that response-based expressions
+// still trigger retries, whether the placeholder is written with the
+// {placeholder} shorthand or with a direct ph() call.
+func TestRetryMatchResponseExpression(t *testing.T) {
+	for _, expr := range []string{
+		`{http.reverse_proxy.status_code} in [502, 503]`,
+		`ph(req, "http.reverse_proxy.status_code") in [502, 503]`,
+	} {
+		t.Run(expr, func(t *testing.T) {
+			badServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusBadGateway)
+			}))
+			t.Cleanup(badServer.Close)
+
+			goodServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusOK)
+				_, _ = w.Write([]byte("ok"))
+			}))
+			t.Cleanup(goodServer.Close)
+
+			retryMatch := caddyhttp.MatcherSets{
+				caddyhttp.MatcherSet{
+					newExpressionMatcher(t, expr),
+				},
+			}
+
+			// RoundRobin picks index 1 first, then 0
+			upstreams := []*Upstream{
+				{Host: new(Host), Dial: goodServer.Listener.Addr().String()},
+				{Host: new(Host), Dial: badServer.Listener.Addr().String()},
+			}
+
+			h := minimalHandlerWithRetryMatch(1, retryMatch, upstreams...)
+
+			req := httptest.NewRequest(http.MethodGet, "http://example.com/", nil)
+			req = prepareTestRequest(req)
+			rec := httptest.NewRecorder()
+
+			err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+				return nil
+			}))
+			gotStatus := rec.Code
+			if err != nil {
+				if herr, ok := err.(caddyhttp.HandlerError); ok {
+					gotStatus = herr.StatusCode
+				}
+			}
+			if gotStatus != http.StatusOK {
+				t.Errorf("status: got %d, want %d (response expression should have retried)", gotStatus, http.StatusOK)
+			}
+		})
+	}
+}
