+package caddyhttp
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	"github.com/caddyserver/caddy/v2"
+)
+
+// TestMatchExpressionPlaceholders verifies that the placeholder names read by
+// an expression are recorded from the checked CEL expression, covering both
+// the {placeholder} shorthand and direct ph() calls.
+func TestMatchExpressionPlaceholders(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		expr string
+		want []string
+	}{
+		{
+			name: "placeholder shorthand",
+			expr: `{http.request.method} == "POST"`,
+			want: []string{"http.request.method"},
+		},
+		{
+			name: "direct placeholder call",
+			expr: `ph(req, "http.reverse_proxy.status_code") in [502, 503]`,
+			want: []string{"http.reverse_proxy.status_code"},
+		},
+		{
+			name: "multiple placeholders",
+			expr: `{http.request.method} == "POST" || {http.reverse_proxy.header.X-Retry} == "true"`,
+			want: []string{"http.request.method", "http.reverse_proxy.header.X-Retry"},
+		},
+		{
+			name: "escaped placeholder remains literal text",
+			expr: `{http.request.uri.path} != "\{http.reverse_proxy.status_code}"`,
+			want: []string{"http.request.uri.path"},
+		},
+		{
+			name: "dynamic placeholder name",
+			expr: `ph(req, {http.request.header.X-Placeholder}) == "x"`,
+			want: []string{"", "http.request.header.X-Placeholder"},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+			defer cancel()
+
+			m := &MatchExpression{Expr: tc.expr}
+			if err := m.Provision(ctx); err != nil {
+				t.Fatalf("provisioning %q: %v", tc.expr, err)
+			}
+
+			got := m.Placeholders()
+			if !reflect.DeepEqual(got, tc.want) {
+				t.Errorf("Placeholders() = %v, want %v", got, tc.want)
+			}
+
+			// the returned slice must be a copy so callers cannot mutate
+			// the provisioned matcher
+			if len(got) > 0 {
+				got[0] = "mutated"
+				if reflect.DeepEqual(m.Placeholders(), got) {
+					t.Error("Placeholders() returned a slice aliasing the matcher's state")
+				}
+			}
+		})
+	}
+}
