+func TestMatchExpressionUsesResponsePlaceholders(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		expr string
+		want bool
+	}{
+		{
+			name: "request-only placeholder",
+			expr: `{http.request.method} == "POST"`,
+			want: false,
+		},
+		{
+			name: "request-only placeholder alongside literal text",
+			expr: `{http.request.uri.path} == "/foo"`,
+			want: false,
+		},
+		{
+			name: "status code",
+			expr: `{http.reverse_proxy.status_code} == 502`,
+			want: true,
+		},
+		{
+			name: "status text",
+			expr: `{http.reverse_proxy.status_text} == "Bad Gateway"`,
+			want: true,
+		},
+		{
+			name: "response header",
+			expr: `{http.reverse_proxy.header.X-Retry} == "true"`,
+			want: true,
+		},
+		{
+			name: "upstream latency",
+			expr: `{http.reverse_proxy.upstream.latency} > 0`,
+			want: true,
+		},
+		{
+			name: "upstream latency in milliseconds",
+			expr: `{http.reverse_proxy.upstream.latency_ms} > 0`,
+			want: true,
+		},
+		{
+			name: "direct placeholder call",
+			expr: `ph(req, "http.reverse_proxy.status_code") == 502`,
+			want: true,
+		},
+		{
+			name: "request-only placeholder call",
+			expr: `ph(req, "http.request.method") == "POST"`,
+			want: false,
+		},
+		{
+			name: "upstream host is known before the response",
+			expr: `{http.reverse_proxy.upstream.host} == "example.com"`,
+			want: false,
+		},
+		{
+			name: "placeholder name only starts like a response placeholder",
+			expr: `{http.reverse_proxy.status_codes} == "x"`,
+			want: false,
+		},
+		{
+			name: "escaped response placeholder is literal text",
+			expr: `header({'X-Test': '\{http.reverse_proxy.status_code}'})`,
+			want: false,
+		},
+		{
+			name: "placeholder name computed at evaluation time",
+			expr: `ph(req, "http.request.method" + "-suffix") == "POST-suffix"`,
+			want: true,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+			defer cancel()
+			m := &MatchExpression{Expr: tc.expr}
+			if err := m.Provision(ctx); err != nil {
+				t.Fatalf("failed to provision expression %q: %v", tc.expr, err)
+			}
+			if got := m.UsesResponsePlaceholders(); got != tc.want {
+				t.Errorf("UsesResponsePlaceholders() = %v, want %v for expression %q", got, tc.want, tc.expr)
+			}
+		})
+	}
+}
