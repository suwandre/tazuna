+// UsesResponsePlaceholders reports whether the expression references any
+// placeholder whose value is only known after an upstream response has been
+// received, such as {http.reverse_proxy.status_code}. Expressions that do not
+// reference response data are request-only conditions.
+//
+// Placeholder names that cannot be determined until evaluation time are
+// treated as possibly referencing response data.
+func (m MatchExpression) UsesResponsePlaceholders() bool {
+	return m.usesResponsePlaceholders
+}
+
+// responsePlaceholders is the set of placeholder names whose values are only
+// known after an upstream response has been received. Placeholders starting
+// with responseHeaderPlaceholderPrefix are handled separately because their
+// names are dynamic.
+var responsePlaceholders = map[string]struct{}{
+	"http.reverse_proxy.status_code":         {},
+	"http.reverse_proxy.status_text":         {},
+	"http.reverse_proxy.upstream.latency":    {},
+	"http.reverse_proxy.upstream.latency_ms": {},
+}
+
+// responseHeaderPlaceholderPrefix is the prefix of response header
+// placeholders, whose full names are only known at request time.
+const responseHeaderPlaceholderPrefix = "http.reverse_proxy.header."
+
+// expressionUsesResponsePlaceholders reports whether the compiled expression
+// contains a placeholder call that reads response data. Placeholder names that
+// are not string literals (i.e. computed at evaluation time) are treated as
+// possibly referencing response data, so they return true.
+func expressionUsesResponsePlaceholders(checked *cel.Ast) bool {
+	var usesResponse bool
+	ast.PostOrderVisit(checked.NativeRep().Expr(), ast.NewExprVisitor(func(e ast.Expr) {
+		if usesResponse || e.Kind() != ast.CallKind {
+			return
+		}
+		call := e.AsCall()
+		if call.FunctionName() != CELPlaceholderFuncName {
+			return
+		}
+		args := call.Args()
+		if len(args) != 2 {
+			return
+		}
+		nameExpr := args[1]
+		if nameExpr.Kind() != ast.LiteralKind {
+			// the placeholder name is only known at evaluation time
+			usesResponse = true
+			return
+		}
+		name, ok := nameExpr.AsLiteral().Value().(string)
+		if !ok {
+			usesResponse = true
+			return
+		}
+		if _, ok := responsePlaceholders[name]; ok {
+			usesResponse = true
+			return
+		}
+		if strings.HasPrefix(name, responseHeaderPlaceholderPrefix) {
+			usesResponse = true
+		}
+	}))
+	return usesResponse
+}
