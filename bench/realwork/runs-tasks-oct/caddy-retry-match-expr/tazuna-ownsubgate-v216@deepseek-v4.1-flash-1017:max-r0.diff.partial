--- a/caddytest/integration/reverseproxy_test.go
+++ b/caddytest/integration/reverseproxy_test.go
@@ -684,6 +684,70 @@ func TestReverseProxyRetryMatchHeader(t *testing.T) {
 	}
 }
 
+// TestReverseProxyRetryMatchRequestOnlyExpression verifies that a
+// lb_retry_match expression that only reads request data restricts which
+// requests may be retried on transport errors, but does not make successful
+// responses retryable (regression from v2.11.3)
+func TestReverseProxyRetryMatchRequestOnlyExpression(t *testing.T) {
+	var hits atomic.Int32
+
+	// Upstreams always answer 200 and echo the request body
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		w.Write(body)
+	})
+	firstSrv := &http.Server{Handler: handler}
+	firstLn, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("failed to listen: %v", err)
+	}
+	go firstSrv.Serve(firstLn)
+	t.Cleanup(func() { firstSrv.Close(); firstLn.Close() })
+
+	secondSrv := &http.Server{Handler: handler}
+	secondLn, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("failed to listen: %v", err)
+	}
+	go secondSrv.Serve(secondLn)
+	t.Cleanup(func() { secondSrv.Close(); secondLn.Close() })
+
+	tester := caddytest.NewTester(t)
+	tester.InitServer(fmt.Sprintf(`
+	{
+		skip_install_trust
+		admin localhost:2999
+		http_port 9080
+		https_port 9443
+		grace_period 1ns
+	}
+	http://localhost:9080 {
+		reverse_proxy %s %s {
+			lb_policy round_robin
+			lb_retries 2
+			lb_retry_match {
+				expression `+"`{http.request.method} == \"POST\"`"+`
+			}
+		}
+	}
+	`, firstLn.Addr().String(), secondLn.Addr().String()), "caddyfile")
+
+	req, err := http.NewRequest(http.MethodPost, "http://localhost:9080/order", strings.NewReader("order=1"))
+	if err != nil {
+		t.Fatalf("failed to create request: %v", err)
+	}
+	tester.AssertResponse(req, 200, "order=1")
+
+	if hits.Load() != 1 {
+		t.Errorf("upstream hits: got %d, want 1 (successful response should not be retried)", hits.Load())
+	}
+}
+
 // TestReverseProxyRetryMatchCombined verifies that a CEL expression combining
 // request path matching with response status code matching works correctly -
 // only retrying when both conditions are met
