+
+func TestMatchExpressionPlaceholders(t *testing.T) {
+	tests := []struct {
+		name string
+		expr string
+		want []string
+	}{
+		{
+			name: "no placeholders",
+			expr: `1 == 1`,
+			want: nil,
+		},
+		{
+			name: "placeholder shorthand",
+			expr: `{http.request.method} == "POST"`,
+			want: []string{"http.request.method"},
+		},
+		{
+			name: "multiple placeholder shorthands",
+			expr: `{http.request.method} == "POST" && {http.reverse_proxy.status_code} in [502, 503]`,
+			want: []string{"http.request.method", "http.reverse_proxy.status_code"},
+		},
+		{
+			name: "direct placeholder function call",
+			expr: `ph(req, "http.reverse_proxy.status_code") in [502, 503]`,
+			want: []string{"http.reverse_proxy.status_code"},
+		},
+		{
+			name: "escaped placeholder is a literal, not a placeholder",
+			expr: `header({'Field': '\{http.reverse_proxy.status_code}'})`,
+			want: nil,
+		},
+		{
+			name: "placeholder name is only known at evaluation time",
+			expr: `ph(req, "http.reverse_proxy." + "status_code") == "502"`,
+			want: []string{""},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+			defer cancel()
+			m := &MatchExpression{Expr: tt.expr}
+			if err := m.Provision(ctx); err != nil {
+				t.Fatalf("MatchExpression.Provision() error = %v", err)
+			}
+			got := m.Placeholders()
+			if !slices.Equal(got, tt.want) {
+				t.Errorf("MatchExpression.Placeholders() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
diff --git a/modules/caddyhttp/reverseproxy/retries_test.go b/modules/caddyhttp/reverseproxy/retries_test.go
index bfd7097..6420876 100644
--- a/modules/caddyhttp/reverseproxy/retries_test.go
+++ b/modules/caddyhttp/reverseproxy/retries_test.go
@@ -565,6 +565,156 @@ func TestRequestOnlyMatcherDoesNotRetryResponses(t *testing.T) {
 	}
 }
 
+// TestRequestOnlyExpressionDoesNotRetryResponses verifies that a lb_retry_match
+// expression which does not read response data only restricts which requests
+// may be retried on transport errors; it must not make successful responses
+// retryable. This regressed in v2.11.3, where any expression matcher was
+// evaluated against the response
+func TestRequestOnlyExpressionDoesNotRetryResponses(t *testing.T) {
+	tests := []struct {
+		name string
+		expr string
+	}{
+		{
+			name: "request placeholder",
+			expr: `{http.request.method} == "POST"`,
+		},
+		{
+			name: "placeholder known before the response",
+			expr: `{http.reverse_proxy.upstream.host} != ""`,
+		},
+		{
+			name: "escaped response placeholder inside a string literal",
+			expr: `header({'Field': '\{http.reverse_proxy.status_code}'})`,
+		},
+		{
+			name: "placeholder whose name only starts like a response placeholder",
+			expr: `{http.reverse_proxy.status_codes} == ""`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var hits atomic.Int32
+
+			// Server returns 200 OK and echoes the request body
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				hits.Add(1)
+				body, err := io.ReadAll(r.Body)
+				if err != nil {
+					http.Error(w, err.Error(), http.StatusInternalServerError)
+					return
+				}
+				w.WriteHeader(http.StatusOK)
+				_, _ = w.Write(body)
+			}))
+			t.Cleanup(server.Close)
+
+			retryMatch := caddyhttp.MatcherSets{
+				caddyhttp.MatcherSet{
+					newExpressionMatcher(t, tc.expr),
+				},
+			}
+
+			upstreams := []*Upstream{
+				{Host: new(Host), Dial: server.Listener.Addr().String()},
+				{Host: new(Host), Dial: server.Listener.Addr().String()},
+			}
+
+			h := minimalHandlerWithRetryMatch(2, retryMatch, upstreams...)
+
+			const requestBody = "order=1"
+			req := httptest.NewRequest(http.MethodPost, "http://example.com/order", strings.NewReader(requestBody))
+			req = prepareTestRequest(req)
+			rec := httptest.NewRecorder()
+
+			err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+				return nil
+			}))
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+
+			if hits.Load() != 1 {
+				t.Errorf("upstream hits: got %d, want 1 (should not retry successful responses)", hits.Load())
+			}
+			if rec.Code != http.StatusOK {
+				t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+			}
+			if rec.Body.String() != requestBody {
+				t.Errorf("body: got %q, want %q", rec.Body.String(), requestBody)
+			}
+		})
+	}
+}
+
+// TestResponseRetryExpressionForms verifies that response-based retry
+// detection works for expressions that call ph(req, "...") directly, and for
+// placeholder names that are only known at evaluation time (which must still
+// be treated as possible response conditions)
+func TestResponseRetryExpressionForms(t *testing.T) {
+	tests := []struct {
+		name string
+		expr string
+	}{
+		{
+			name: "direct placeholder call",
+			expr: `ph(req, "http.reverse_proxy.status_code") in [502, 503]`,
+		},
+		{
+			name: "placeholder name known at evaluation time",
+			expr: `ph(req, "http.reverse_proxy." + "status_code") in [502, 503]`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			badServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusBadGateway)
+			}))
+			t.Cleanup(badServer.Close)
+
+			goodServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusOK)
+				w.Write([]byte("ok"))
+			}))
+			t.Cleanup(goodServer.Close)
+
+			retryMatch := caddyhttp.MatcherSets{
+				caddyhttp.MatcherSet{
+					newExpressionMatcher(t, tc.expr),
+				},
+			}
+
+			// RoundRobin picks index 1 first, then 0
+			upstreams := []*Upstream{
+				{Host: new(Host), Dial: goodServer.Listener.Addr().String()},
+				{Host: new(Host), Dial: badServer.Listener.Addr().String()},
+			}
+
+			h := minimalHandlerWithRetryMatch(1, retryMatch, upstreams...)
+
+			req := httptest.NewRequest(http.MethodGet, "http://example.com/", nil)
+			req = prepareTestRequest(req)
+			rec := httptest.NewRecorder()
+
+			err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+				return nil
+			}))
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+
+			if rec.Code != http.StatusOK {
+				t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+			}
+			if rec.Body.String() != "ok" {
+				t.Errorf("body: got %q, want %q", rec.Body.String(), "ok")
+			}
+		})
+	}
+}
+
 // brokenUpstreamAddr returns the address of a TCP listener that accepts
 // connections but immediately closes them, causing a transport error (not
 // a dial error). This simulates an upstream that is reachable but broken
diff --git a/modules/caddyhttp/reverseproxy/reverseproxy.go b/modules/caddyhttp/reverseproxy/reverseproxy.go
