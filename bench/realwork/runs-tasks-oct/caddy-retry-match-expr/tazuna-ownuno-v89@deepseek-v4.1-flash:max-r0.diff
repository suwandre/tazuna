+func TestMatchExpressionPlaceholders(t *testing.T) {
+	for _, tc := range []struct {
+		name             string
+		expr             string
+		wantPlaceholders []string
+		wantComplete     bool
+	}{
+		{
+			name:             "shorthand placeholder",
+			expr:             `{http.request.method} == "POST"`,
+			wantPlaceholders: []string{"http.request.method"},
+			wantComplete:     true,
+		},
+		{
+			name:             "direct placeholder call",
+			expr:             `ph(req, "http.reverse_proxy.status_code") == 502`,
+			wantPlaceholders: []string{"http.reverse_proxy.status_code"},
+			wantComplete:     true,
+		},
+		{
+			name:             "multiple placeholders",
+			expr:             `{http.request.method} == "POST" && {http.reverse_proxy.status_code} == 502`,
+			wantPlaceholders: []string{"http.request.method", "http.reverse_proxy.status_code"},
+			wantComplete:     true,
+		},
+		{
+			name:             "escaped placeholder is a string literal",
+			expr:             `"\{http.reverse_proxy.status_code}" != ""`,
+			wantPlaceholders: nil,
+			wantComplete:     true,
+		},
+		{
+			name:             "similar placeholder name",
+			expr:             `{http.reverse_proxy.status_codes} == 502`,
+			wantPlaceholders: []string{"http.reverse_proxy.status_codes"},
+			wantComplete:     true,
+		},
+		{
+			name:             "dynamic placeholder name",
+			expr:             `ph(req, "http.reverse_proxy.header." + "X-Retry") == "true"`,
+			wantPlaceholders: nil,
+			wantComplete:     false,
+		},
+		{
+			name:             "no placeholders",
+			expr:             `"foo" == "foo"`,
+			wantPlaceholders: nil,
+			wantComplete:     true,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+			defer cancel()
+
+			m := &MatchExpression{Expr: tc.expr}
+			if err := m.Provision(ctx); err != nil {
+				t.Fatalf("provisioning expression: %v", err)
+			}
+
+			got, complete := m.Placeholders()
+			if complete != tc.wantComplete {
+				t.Errorf("complete: got %t, want %t", complete, tc.wantComplete)
+			}
+			if len(got) != len(tc.wantPlaceholders) {
+				t.Fatalf("placeholders: got %v, want %v", got, tc.wantPlaceholders)
+			}
+			for i := range got {
+				if got[i] != tc.wantPlaceholders[i] {
+					t.Errorf("placeholder %d: got %q, want %q", i, got[i], tc.wantPlaceholders[i])
+				}
+			}
+		})
+	}
+}
