+// TestMatcherSetUsesResponsePlaceholders verifies that only expressions which
+// reference response data are treated as response conditions
+func TestMatcherSetUsesResponsePlaceholders(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		matchers caddyhttp.MatcherSet
+		want     bool
+	}{
+		{
+			name:     "status code",
+			matchers: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.reverse_proxy.status_code} == 502`)},
+			want:     true,
+		},
+		{
+			name:     "status text",
+			matchers: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.reverse_proxy.status_text} == "Bad Gateway"`)},
+			want:     true,
+		},
+		{
+			name:     "response header",
+			matchers: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.reverse_proxy.header.X-Retry} == "true"`)},
+			want:     true,
+		},
+		{
+			name:     "upstream latency",
+			matchers: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.reverse_proxy.upstream.latency} > 0`)},
+			want:     true,
+		},
+		{
+			name:     "upstream latency milliseconds",
+			matchers: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.reverse_proxy.upstream.latency_ms} > 0`)},
+			want:     true,
+		},
+		{
+			name:     "direct placeholder call",
+			matchers: caddyhttp.MatcherSet{newExpressionMatcher(t, `ph(req, "http.reverse_proxy.status_code") == 502`)},
+			want:     true,
+		},
+		{
+			name:     "dynamic placeholder name",
+			matchers: caddyhttp.MatcherSet{newExpressionMatcher(t, `ph(req, "http.reverse_proxy.header." + "X-Retry") == "true"`)},
+			want:     true,
+		},
+		{
+			name:     "request placeholder",
+			matchers: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.request.method} == "POST"`)},
+			want:     false,
+		},
+		{
+			name:     "escaped placeholder",
+			matchers: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.request.method} == "POST" && "\{http.reverse_proxy.status_code}" != ""`)},
+			want:     false,
+		},
+		{
+			name:     "similar placeholder name",
+			matchers: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.reverse_proxy.status_codes} == 502`)},
+			want:     false,
+		},
+		{
+			name:     "non-expression matcher",
+			matchers: caddyhttp.MatcherSet{caddyhttp.MatchMethod{"POST"}},
+			want:     false,
+		},
+		{
+			name: "mixed request and response expressions",
+			matchers: caddyhttp.MatcherSet{
+				newExpressionMatcher(t, `{http.request.method} == "POST"`),
+				newExpressionMatcher(t, `{http.reverse_proxy.status_code} == 502`),
+			},
+			want: true,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := matcherSetUsesResponsePlaceholders(tc.matchers); got != tc.want {
+				t.Errorf("matcherSetUsesResponsePlaceholders() = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
