@@ -605,3 +605,77 @@ func TestMatchExpressionProvision(t *testing.T) {
 		})
 	}
 }
+
+func TestMatchExpressionUsesResponsePlaceholders(t *testing.T) {
+	tests := []struct {
+		name       string
+		expression string
+		want       bool
+	}{
+		{
+			name:       "status code shorthand",
+			expression: `{http.reverse_proxy.status_code} == 502`,
+			want:       true,
+		},
+		{
+			name:       "status code direct placeholder call",
+			expression: `ph(req, "http.reverse_proxy.status_code") == 502`,
+			want:       true,
+		},
+		{
+			name:       "status text",
+			expression: `{http.reverse_proxy.status_text} == "Bad Gateway"`,
+			want:       true,
+		},
+		{
+			name:       "response header",
+			expression: `{http.reverse_proxy.header.X-Retry} == "true"`,
+			want:       true,
+		},
+		{
+			name:       "upstream latency",
+			expression: `{http.reverse_proxy.upstream.latency_ms} > 10`,
+			want:       true,
+		},
+		{
+			name:       "request placeholder",
+			expression: `{http.request.method} == "POST"`,
+			want:       false,
+		},
+		{
+			name:       "upstream host",
+			expression: `{http.reverse_proxy.upstream.host} == "backend"`,
+			want:       false,
+		},
+		{
+			name:       "escaped response placeholder text",
+			expression: `"\{http.reverse_proxy.status_code}" == "\{http.reverse_proxy.status_code}"`,
+			want:       false,
+		},
+		{
+			name:       "similar placeholder name",
+			expression: `{http.reverse_proxy.status_codes} == 502`,
+			want:       false,
+		},
+		{
+			name:       "dynamic placeholder name",
+			expression: `ph(req, {http.request.uri.path}) == "/foo"`,
+			want:       true,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+			defer cancel()
+
+			m := &MatchExpression{Expr: tc.expression}
+			if err := m.Provision(ctx); err != nil {
+				t.Fatalf("failed to provision expression: %v", err)
+			}
+			if got := m.UsesResponsePlaceholders(); got != tc.want {
+				t.Errorf("UsesResponsePlaceholders() = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
