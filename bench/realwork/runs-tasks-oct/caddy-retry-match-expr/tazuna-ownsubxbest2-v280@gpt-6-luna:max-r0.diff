+func expressionUsesResponsePlaceholders(expr ast.Expr) bool {
+	usesResponsePlaceholder := false
+	ast.PreOrderVisit(expr, ast.NewExprVisitor(func(e ast.Expr) {
+		if usesResponsePlaceholder || e.Kind() != ast.CallKind {
+			return
+		}
+
+		call := e.AsCall()
+		if call.FunctionName() != CELPlaceholderFuncName {
+			return
+		}
+
+		args := call.Args()
+		if len(args) < 2 || args[1].Kind() != ast.LiteralKind {
+			// If the placeholder name is not a string literal, it cannot be
+			// determined until evaluation time, so conservatively assume it
+			// could refer to response data.
+			usesResponsePlaceholder = true
+			return
+		}
+
+		placeholder, ok := args[1].AsLiteral().Value().(string)
+		if !ok || isReverseProxyResponsePlaceholder(placeholder) {
+			usesResponsePlaceholder = true
+		}
+	}))
+	return usesResponsePlaceholder
+}
+
+func isReverseProxyResponsePlaceholder(placeholder string) bool {
+	const reverseProxyPrefix = "http.reverse_proxy."
+
+	switch placeholder {
+	case reverseProxyPrefix + "status_code",
+		reverseProxyPrefix + "status_text",
+		reverseProxyPrefix + "upstream.latency",
+		reverseProxyPrefix + "upstream.latency_ms":
+		return true
+	default:
+		return strings.HasPrefix(placeholder, reverseProxyPrefix+"header.")
+	}
+}
