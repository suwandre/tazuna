+func TestMatchExpressionPlaceholderNames(t *testing.T) {
+	tests := []struct {
+		name        string
+		expr        string
+		wantNames   []string
+		wantDynamic bool
+	}{
+		{
+			name:      "request-only placeholder",
+			expr:      `{http.request.method} == "POST"`,
+			wantNames: []string{"http.request.method"},
+		},
+		{
+			name:      "response status code shorthand",
+			expr:      `{http.reverse_proxy.status_code} in [502, 503]`,
+			wantNames: []string{"http.reverse_proxy.status_code"},
+		},
+		{
+			name:      "response header shorthand",
+			expr:      `{http.reverse_proxy.header.X-Upstream-Retry} == "true"`,
+			wantNames: []string{"http.reverse_proxy.header.X-Upstream-Retry"},
+		},
+		{
+			name:      "explicit placeholder function call",
+			expr:      `ph(req, "http.reverse_proxy.status_code") == 502`,
+			wantNames: []string{"http.reverse_proxy.status_code"},
+		},
+		{
+			name:      "mixed request and response placeholders",
+			expr:      `path('/retry*') && {http.reverse_proxy.status_code} in [502, 503]`,
+			wantNames: []string{"http.reverse_proxy.status_code"},
+		},
+		{
+			name:      "escaped placeholder is a string literal, not a placeholder",
+			expr:      `"\{http.reverse_proxy.status_code}" == "x"`,
+			wantNames: nil,
+		},
+		{
+			name:      "placeholder name with similar prefix is not a response placeholder",
+			expr:      `{http.reverse_proxy.status_codes} == "x"`,
+			wantNames: []string{"http.reverse_proxy.status_codes"},
+		},
+		{
+			name:        "dynamic placeholder name is reported as dynamic",
+			expr:        `ph(req, "http.reverse_proxy." + "status_code") == 502`,
+			wantNames:   nil,
+			wantDynamic: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+			defer cancel()
+			m := &MatchExpression{Expr: tt.expr}
+			if err := m.Provision(ctx); err != nil {
+				t.Fatalf("MatchExpression.Provision() error = %v", err)
+			}
+			names, dynamic := m.PlaceholderNames()
+			if dynamic != tt.wantDynamic {
+				t.Errorf("PlaceholderNames() dynamic = %v, want %v", dynamic, tt.wantDynamic)
+			}
+			if len(names) != len(tt.wantNames) {
+				t.Fatalf("PlaceholderNames() names = %v, want %v", names, tt.wantNames)
+			}
+			for i, name := range names {
+				if name != tt.wantNames[i] {
+					t.Errorf("PlaceholderNames() names[%d] = %q, want %q", i, name, tt.wantNames[i])
+				}
+			}
+		})
+	}
+}
