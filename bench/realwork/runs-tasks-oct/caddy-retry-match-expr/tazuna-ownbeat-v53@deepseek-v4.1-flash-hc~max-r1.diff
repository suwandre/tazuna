+// TestReverseProxyRetryMatchRequestOnlyExpression verifies that a
+// lb_retry_match expression that only tests request data does NOT cause
+// successful responses to be retried. Regression test for the bug where
+// request-only expressions were evaluated against responses, making every
+// successful response retryable and eventually surfacing as a 502
+func TestReverseProxyRetryMatchRequestOnlyExpression(t *testing.T) {
+	var hits atomic.Int32
+
+	// Upstream: always returns 200
+	srv := &http.Server{
+		Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			hits.Add(1)
+			io.Copy(io.Discard, r.Body)
+			w.Write([]byte("ok"))
+		}),
+	}
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("failed to listen: %v", err)
+	}
+	go srv.Serve(ln)
+	t.Cleanup(func() { srv.Close(); ln.Close() })
+
+	tester := caddytest.NewTester(t)
+	tester.InitServer(fmt.Sprintf(`
+	{
+		skip_install_trust
+		admin localhost:2999
+		http_port 9080
+		https_port 9443
+		grace_period 1ns
+	}
+	http://localhost:9080 {
+		reverse_proxy %s %s {
+			lb_policy round_robin
+			lb_retries 2
+			lb_retry_match {
+				expression `+"`{http.request.method} == \"POST\"`"+`
+			}
+		}
+	}
+	`, ln.Addr().String(), ln.Addr().String()), "caddyfile")
+
+	// A POST that matches the request-only expression must not be retried;
+	// the successful 200 response should be passed through to the client
+	req, _ := http.NewRequest(http.MethodPost, "http://localhost:9080/order", strings.NewReader("order=1"))
+	tester.AssertResponse(req, 200, "ok")
+
+	if hits.Load() != 1 {
+		t.Errorf("upstream hits: got %d, want 1 (request-only expression must not retry successful responses)", hits.Load())
+	}
+}
