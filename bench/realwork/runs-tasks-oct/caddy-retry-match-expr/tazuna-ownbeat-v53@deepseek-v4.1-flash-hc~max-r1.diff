+// PlaceholderNames returns the names of the Caddy placeholders referenced
+// by the expression via the {placeholder} shorthand or direct ph(req, "...")
+// calls. It also reports whether any placeholder reference could not be
+// resolved statically (for example ph(req, someVariable)); such references
+// cannot be known until evaluation time, so callers should treat them as
+// potentially referring to any placeholder.
+func (m MatchExpression) PlaceholderNames() ([]string, bool) {
+	return m.placeholderNames, m.dynamicPlaceholder
+}
+
+// placeholderNames walks the type-checked expression and collects the Caddy
+// placeholder names passed to ph() calls. A ph() argument that is not a
+// constant string is reported as dynamic.
+func placeholderNames(checked *cel.Ast) ([]string, bool) {
+	var names []string
+	var dynamic bool
+	nav := ast.NavigateAST(checked.NativeRep())
+	for _, call := range ast.MatchDescendants(nav, ast.FunctionMatcher(CELPlaceholderFuncName)) {
+		args := call.AsCall().Args()
+		if len(args) != 2 {
+			continue
+		}
+		nameExpr := args[1]
+		if nameExpr.Kind() != ast.LiteralKind {
+			dynamic = true
+			continue
+		}
+		name, ok := nameExpr.AsLiteral().(types.String)
+		if !ok {
+			dynamic = true
+			continue
+		}
+		names = append(names, string(name))
+	}
+	return names, dynamic
+}
