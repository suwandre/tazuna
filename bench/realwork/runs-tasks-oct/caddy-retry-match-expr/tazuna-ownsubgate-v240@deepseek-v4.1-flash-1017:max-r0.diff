+func TestMatchExpressionPlaceholders(t *testing.T) {
+	for i, tc := range []struct {
+		expr string
+		want []string
+	}{
+		{
+			expr: `{http.request.method} == "POST"`,
+			want: []string{"http.request.method"},
+		},
+		{
+			expr: `ph(req, "http.reverse_proxy.status_code") in [502, 503]`,
+			want: []string{"http.reverse_proxy.status_code"},
+		},
+		{
+			expr: `{http.reverse_proxy.status_code} in [502, 503] && {http.request.method} == "GET"`,
+			want: []string{"http.reverse_proxy.status_code", "http.request.method"},
+		},
+		{
+			// escaped placeholders are string literals, not placeholder reads
+			expr: `{http.request.uri.path} != "\{http.reverse_proxy.status_code}"`,
+			want: []string{"http.request.uri.path"},
+		},
+		{
+			// the name is only known at evaluation time
+			expr: `ph(req, "http.request." + "method") == "GET"`,
+			want: []string{""},
+		},
+	} {
+		m := &MatchExpression{Expr: tc.expr}
+		ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+		if err := m.Provision(ctx); err != nil {
+			cancel()
+			t.Fatalf("Test %d: unexpected provisioning error: %v", i, err)
+		}
+		cancel()
+
+		got := m.Placeholders()
+		if len(got) != len(tc.want) {
+			t.Errorf("Test %d: placeholders: got %v, want %v", i, got, tc.want)
+			continue
+		}
+		for j := range got {
+			if got[j] != tc.want[j] {
+				t.Errorf("Test %d: placeholders: got %v, want %v", i, got, tc.want)
+				break
+			}
+		}
+	}
+}
