+// TestMatcherSetReferencesResponse verifies that only expressions reading
+// response data (or using a placeholder name that is only known at evaluation
+// time) are treated as response conditions
+func TestMatcherSetReferencesResponse(t *testing.T) {
+	for i, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{expr: "{http.reverse_proxy.status_code} in [502, 503]", want: true},
+		{expr: `ph(req, "http.reverse_proxy.status_code") in [502, 503]`, want: true},
+		{expr: `{http.reverse_proxy.status_text} == "Bad Gateway"`, want: true},
+		{expr: `{http.reverse_proxy.header.X-Retry} == "true"`, want: true},
+		{expr: `{http.reverse_proxy.upstream.latency} > 1`, want: true},
+		{expr: `{http.reverse_proxy.upstream.latency_ms} > 1`, want: true},
+		{expr: `ph(req, "http.reverse_proxy." + "status_code") == 502`, want: true},
+		{expr: `{http.request.method} == "POST"`, want: false},
+		{expr: `{http.reverse_proxy.upstream.host} == "127.0.0.1"`, want: false},
+		{expr: `{http.reverse_proxy.is_transport_error} == true`, want: false},
+		{expr: `{http.request.uri.path} != "\{http.reverse_proxy.status_code}"`, want: false},
+		{expr: `{http.reverse_proxy.status_codes} == null`, want: false},
+	} {
+		matcherSet := caddyhttp.MatcherSet{newExpressionMatcher(t, tc.expr)}
+		if got := matcherSetReferencesResponse(matcherSet); got != tc.want {
+			t.Errorf("Test %d (%s): got %t, want %t", i, tc.expr, got, tc.want)
+		}
+	}
+
+	// non-expression matchers are never response conditions
+	matcherSet := caddyhttp.MatcherSet{caddyhttp.MatchMethod{"POST"}}
+	if matcherSetReferencesResponse(matcherSet) {
+		t.Error("method matcher should not reference the response")
+	}
+}
