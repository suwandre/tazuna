+// TestReverseProxyRetryMatchRequestExpression verifies that lb_retry_match
+// with an expression that only tests the request does not retry successful
+// upstream responses (see #8166)
+func TestReverseProxyRetryMatchRequestExpression(t *testing.T) {
+	var hits atomic.Int32
+
+	// Both upstreams return 200 and echo the request body
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		body, _ := io.ReadAll(r.Body)
+		w.WriteHeader(http.StatusOK)
+		w.Write(body)
+	})
+	firstSrv := &http.Server{Handler: handler}
+	firstLn, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("failed to listen: %v", err)
+	}
+	go firstSrv.Serve(firstLn)
+	t.Cleanup(func() { firstSrv.Close(); firstLn.Close() })
+
+	secondSrv := &http.Server{Handler: handler}
+	secondLn, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("failed to listen: %v", err)
+	}
+	go secondSrv.Serve(secondLn)
+	t.Cleanup(func() { secondSrv.Close(); secondLn.Close() })
+
+	tester := caddytest.NewTester(t)
+	tester.InitServer(fmt.Sprintf(`
+	{
+		skip_install_trust
+		admin localhost:2999
+		http_port 9080
+		https_port 9443
+		grace_period 1ns
+	}
+	http://localhost:9080 {
+		reverse_proxy %s %s {
+			lb_policy round_robin
+			lb_retries 2
+			lb_retry_match {
+				expression `+"`{method} == \"POST\"`"+`
+			}
+		}
+	}
+	`, firstLn.Addr().String(), secondLn.Addr().String()), "caddyfile")
+
+	body := bytes.NewBufferString("order=1")
+	tester.AssertPostResponseBody("http://localhost:9080/order", nil, body, 200, "order=1")
+	if hits.Load() != 1 {
+		t.Errorf("upstream hits: got %d, want 1 (request-only expression must not retry)", hits.Load())
+	}
+}
