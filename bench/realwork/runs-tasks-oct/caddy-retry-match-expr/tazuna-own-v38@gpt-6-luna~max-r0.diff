+// MayReferencePlaceholder reports whether m references a placeholder matching the
+// predicate. It also returns true if a placeholder name cannot be determined until
+// evaluation.
+func (m MatchExpression) MayReferencePlaceholder(predicate func(string) bool) bool {
+	if m.hasDynamicPlaceholderReference {
+		return true
+	}
+	if predicate == nil {
+		return false
+	}
+	return slices.ContainsFunc(m.placeholderReferences, predicate)
+}
