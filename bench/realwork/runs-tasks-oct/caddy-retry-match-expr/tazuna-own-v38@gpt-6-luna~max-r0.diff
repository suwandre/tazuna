+// TestRequestOnlyExpressionDoesNotRetrySuccessfulResponse verifies that a
+// request-only CEL expression does not retry a successful POST or consume its
+// body more than once.
+func TestRequestOnlyExpressionDoesNotRetrySuccessfulResponse(t *testing.T) {
+	const requestBody = "order=1"
+	var hits atomic.Int32
+	var bodiesMu sync.Mutex
+	var bodies []string
+
+	serverHandler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("reading request body: %v", err)
+			http.Error(w, "could not read request body", http.StatusInternalServerError)
+			return
+		}
+		bodiesMu.Lock()
+		bodies = append(bodies, string(body))
+		bodiesMu.Unlock()
+		_, _ = w.Write(body)
+	})
+	firstServer := httptest.NewServer(serverHandler)
+	t.Cleanup(firstServer.Close)
+	secondServer := httptest.NewServer(serverHandler)
+	t.Cleanup(secondServer.Close)
+
+	retryMatch := caddyhttp.MatcherSets{
+		caddyhttp.MatcherSet{
+			newExpressionMatcher(t, `{http.request.method} == "POST"`),
+		},
+	}
+	upstreams := []*Upstream{
+		{Host: new(Host), Dial: firstServer.Listener.Addr().String()},
+		{Host: new(Host), Dial: secondServer.Listener.Addr().String()},
+	}
+	h := minimalHandlerWithRetryMatch(2, retryMatch, upstreams...)
+
+	req := httptest.NewRequest(http.MethodPost, "http://example.com/order", strings.NewReader(requestBody))
+	req = prepareTestRequest(req)
+	rec := httptest.NewRecorder()
+
+	err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		return nil
+	}))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if rec.Code != http.StatusOK {
+		t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+	}
+	if got := rec.Body.String(); got != requestBody {
+		t.Errorf("response body: got %q, want %q", got, requestBody)
+	}
+	if got := hits.Load(); got != 1 {
+		t.Errorf("upstream hits: got %d, want 1", got)
+	}
+
+	bodiesMu.Lock()
+	defer bodiesMu.Unlock()
+	if len(bodies) != 1 || bodies[0] != requestBody {
+		t.Errorf("upstream request bodies: got %q, want [%q]", bodies, requestBody)
+	}
+}
