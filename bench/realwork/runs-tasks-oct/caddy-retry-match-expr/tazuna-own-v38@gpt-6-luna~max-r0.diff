+// TestResponseDataPlaceholderDetection distinguishes response placeholders
+// from request-only placeholders and placeholder-like string literals.
+func TestResponseDataPlaceholderDetection(t *testing.T) {
+	tests := []struct {
+		name string
+		expr string
+		want bool
+	}{
+		{name: "status code", expr: `{http.reverse_proxy.status_code} == 503`, want: true},
+		{name: "status text", expr: `{http.reverse_proxy.status_text} == "Service Unavailable"`, want: true},
+		{name: "response header", expr: `{http.reverse_proxy.header.X-Retry} == "true"`, want: true},
+		{name: "upstream latency", expr: `ph(req, "http.reverse_proxy.upstream.latency") != null`, want: true},
+		{name: "upstream latency milliseconds", expr: `ph(req, "http.reverse_proxy.upstream.latency_ms") != null`, want: true},
+		{name: "upstream duration", expr: `ph(req, "http.reverse_proxy.upstream.duration") != null`},
+		{name: "direct placeholder function", expr: `ph(req, "http.reverse_proxy.status_code") == 503`, want: true},
+		{name: "constant placeholder concatenation", expr: `ph(req, "http.reverse_proxy." + "status_code") == 503`, want: true},
+		{name: "request method", expr: `{http.request.method} == "POST"`},
+		{name: "upstream host", expr: `{http.reverse_proxy.upstream.host} != ""`},
+		{name: "transport error", expr: `{http.reverse_proxy.is_transport_error} == true`},
+		{name: "similar placeholder name", expr: `{http.reverse_proxy.status_codes} == 503`},
+		{name: "similar header prefix", expr: `{http.reverse_proxy.headerish.X-Retry} == "true"`},
+		{name: "escaped placeholder text", expr: `"\{http.reverse_proxy.status_code}" == "\{http.reverse_proxy.status_code}"`},
+		{name: "constant request placeholder concatenation", expr: `ph(req, "http.reverse_proxy." + "upstream.host") != ""`},
+		{name: "dynamic placeholder name", expr: `ph(req, method('POST') ? "http.reverse_proxy.status_code" : "http.request.method") == 503`, want: true},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			matcher := newExpressionMatcher(t, tc.expr)
+			got := matcherSetHasResponseDataExpression(caddyhttp.MatcherSet{matcher})
+			if got != tc.want {
+				t.Errorf("matcherSetHasResponseDataExpression() = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
