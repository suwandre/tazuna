-// isCELStringExpr indicates whether the expression is a supported string expression
+// collectCELPlaceholderReferences extracts the statically known placeholder references from an expression.
+func collectCELPlaceholderReferences(expression *ast.AST) ([]string, bool) {
+	var references []string
+	hasDynamicReference := false
+	for _, callExpr := range ast.MatchDescendants(ast.NavigateAST(expression), ast.FunctionMatcher(CELPlaceholderFuncName)) {
+		call := callExpr.AsCall()
+		args := call.Args()
+		if call.IsMemberFunction() {
+			args = append([]ast.Expr{call.Target()}, args...)
+		}
+		if len(args) < 2 {
+			hasDynamicReference = true
+			continue
+		}
+
+		placeholder, known := staticCELString(args[1])
+		if !known {
+			hasDynamicReference = true
+			continue
+		}
+		references = append(references, placeholder)
+	}
+	return references, hasDynamicReference
+}
+
+func staticCELString(expression ast.Expr) (string, bool) {
+	switch expression.Kind() {
+	case ast.LiteralKind:
+		if value, ok := expression.AsLiteral().(types.String); ok {
+			return string(value), true
+		}
+	case ast.CallKind:
+		call := expression.AsCall()
+		if call.Target().Kind() != ast.UnspecifiedExprKind {
+			return "", false
+		}
+
+		switch call.FunctionName() {
+		case operators.Add:
+			args := call.Args()
+			if len(args) != 2 {
+				return "", false
+			}
+			left, leftKnown := staticCELString(args[0])
+			right, rightKnown := staticCELString(args[1])
+			if leftKnown && rightKnown {
+				return left + right, true
+			}
+		case operators.Conditional:
+			args := call.Args()
+			if len(args) != 3 {
+				return "", false
+			}
+			condition, known := staticCELBool(args[0])
+			if known {
+				if condition {
+					return staticCELString(args[1])
+				}
+				return staticCELString(args[2])
+			}
+		}
+	case ast.UnspecifiedExprKind, ast.ComprehensionKind, ast.IdentKind, ast.ListKind, ast.MapKind, ast.SelectKind, ast.StructKind:
+		// appeasing the linter :)
+	}
+	return "", false
+}
+
+func staticCELBool(expression ast.Expr) (bool, bool) {
+	if expression.Kind() != ast.LiteralKind {
+		return false, false
+	}
+	value, ok := expression.AsLiteral().(types.Bool)
+	return bool(value), ok
+}
+
+// isCELStringExpr indicates whether the expression is a supported string expression.
 func isCELStringExpr(e ast.Expr) bool {
 	return isCELStringLiteral(e) || isCELCaddyPlaceholderCall(e) || isCELConcatCall(e)
 }
