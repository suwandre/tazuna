+func placeholdersInExpr(expression ast.Expr) (names []string, dynamic bool) {
+	seen := make(map[string]struct{})
+	ast.PostOrderVisit(expression, ast.NewExprVisitor(func(e ast.Expr) {
+		if e.Kind() != ast.CallKind {
+			return
+		}
+
+		call := e.AsCall()
+		if call.FunctionName() != CELPlaceholderFuncName {
+			return
+		}
+		args := call.Args()
+		if len(args) != 2 {
+			dynamic = true
+			return
+		}
+
+		nameString, ok := staticStringExpr(args[1])
+		if !ok {
+			dynamic = true
+			return
+		}
+
+		if _, ok := seen[nameString]; ok {
+			return
+		}
+		seen[nameString] = struct{}{}
+		names = append(names, nameString)
+	}))
+	return names, dynamic
+}
+
+func staticStringExpr(expression ast.Expr) (string, bool) {
+	if expression.Kind() == ast.LiteralKind {
+		name, ok := expression.AsLiteral().(types.String)
+		return string(name), ok
+	}
+	if expression.Kind() != ast.CallKind {
+		return "", false
+	}
+
+	call := expression.AsCall()
+	if call.IsMemberFunction() || call.FunctionName() != operators.Add || len(call.Args()) != 2 {
+		return "", false
+	}
+	left, leftOK := staticStringExpr(call.Args()[0])
+	right, rightOK := staticStringExpr(call.Args()[1])
+	return left + right, leftOK && rightOK
+}
