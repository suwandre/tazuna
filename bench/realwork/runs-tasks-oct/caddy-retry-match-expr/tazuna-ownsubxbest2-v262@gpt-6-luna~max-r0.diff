+// matcherSetHasResponseExpressionMatcher reports whether a matcher set contains
+// an expression matcher that can reference response data. Expressions that only
+// reference request data remain request conditions and are not evaluated after a
+// successful upstream response.
+func matcherSetHasResponseExpressionMatcher(matcherSet caddyhttp.MatcherSet) bool {
+	for _, matcher := range matcherSet {
+		var expression caddyhttp.MatchExpression
+		switch matcher := matcher.(type) {
+		case *caddyhttp.MatchExpression:
+			if matcher == nil {
+				continue
+			}
+			expression = *matcher
+		case caddyhttp.MatchExpression:
+			expression = matcher
+		default:
+			continue
+		}
+
+		names, dynamic := expression.PlaceholderNames()
+		if dynamic {
+			return true
+		}
+		if slices.ContainsFunc(names, isResponsePlaceholder) {
 			return true
 		}
 	}
 	return false
 }
 
+func isResponsePlaceholder(name string) bool {
+	// These are the placeholders populated from the upstream response before
+	// retry matching. Keep the names exact so similarly named request or
+	// otherwise unknown placeholders do not opt an expression into response
+	// matching.
+	switch name {
+	case "http.reverse_proxy.status_code",
+		"http.reverse_proxy.status_text",
+		"http.reverse_proxy.upstream.latency",
+		"http.reverse_proxy.upstream.latency_ms":
+		return true
+	default:
+		return strings.HasPrefix(name, "http.reverse_proxy.header.")
+	}
+}
