+// ReferencesPlaceholder reports whether the expression may read a
+// placeholder whose name satisfies match. An expression that computes
+// a placeholder name at evaluation time may read any placeholder, so
+// it is always reported as a possible reference. It must only be
+// called after m has been provisioned.
+func (m MatchExpression) ReferencesPlaceholder(match func(name string) bool) bool {
+	return m.dynamicPlaceholder || slices.ContainsFunc(m.placeholders, match)
+}
+
+// celPlaceholderReferences returns the placeholder names passed as
+// string literals to the placeholder function in the checked AST, and
+// whether the function is also called with a non-literal name.
+func celPlaceholderReferences(checked *cel.Ast) (names []string, dynamic bool) {
+	ast.PreOrderVisit(ast.NavigateAST(checked.NativeRep()), ast.NewExprVisitor(func(e ast.Expr) {
+		if e.Kind() != ast.CallKind {
+			return
+		}
+		call := e.AsCall()
+		if call.FunctionName() != CELPlaceholderFuncName {
+			return
+		}
+		args := call.Args()
+		if len(args) != 2 || args[1].Kind() != ast.LiteralKind {
+			dynamic = true
+			return
+		}
+		name, ok := args[1].AsLiteral().(types.String)
+		if !ok {
+			dynamic = true
+			return
+		}
+		names = append(names, string(name))
+	}))
+	return names, dynamic
+}
