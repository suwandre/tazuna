+// TestMatcherSetReadsResponse verifies which retry_match sets are treated
+// as response conditions: only expressions that read response placeholders,
+// or that compute a placeholder name at evaluation time
+func TestMatcherSetReadsResponse(t *testing.T) {
+	for i, tc := range []struct {
+		expr     string
+		expected bool
+	}{
+		{expr: `{http.reverse_proxy.status_code} in [502, 503]`, expected: true},
+		{expr: `{http.reverse_proxy.status_text}.startsWith("503")`, expected: true},
+		{expr: `{http.reverse_proxy.header.X-Retry} == "true"`, expected: true},
+		{expr: `{http.reverse_proxy.upstream.latency_ms} > 100.0`, expected: true},
+		{expr: `{http.reverse_proxy.upstream.latency} != null`, expected: true},
+		{expr: `ph(req, "http.reverse_proxy.status_code") == 503`, expected: true},
+		{expr: `method("POST") && {http.reverse_proxy.status_code} == 503`, expected: true},
+		{expr: `[1].exists(x, {http.reverse_proxy.status_code} == 503)`, expected: true},
+		{expr: `ph(req, "http.reverse_proxy." + "status_code") == 503`, expected: true},
+		{expr: `{http.request.method} == "POST"`, expected: false},
+		{expr: `method("POST")`, expected: false},
+		{expr: `{http.reverse_proxy.upstream.host} == "localhost"`, expected: false},
+		{expr: `{http.reverse_proxy.is_transport_error} == true`, expected: false},
+		{expr: `{http.request.uri} == '\{http.reverse_proxy.status_code}'`, expected: false},
+		{expr: `{http.request.uri} == "http.reverse_proxy.status_code"`, expected: false},
+		{expr: `{http.reverse_proxy.status_codes} == "503"`, expected: false},
+		{expr: `{http.reverse_proxy.headers} == "x"`, expected: false},
+	} {
+		set := caddyhttp.MatcherSet{newExpressionMatcher(t, tc.expr)}
+		if actual := matcherSetReadsResponse(set); actual != tc.expected {
+			t.Errorf("Test %d (%s): expected %v, got %v", i, tc.expr, tc.expected, actual)
+		}
+	}
+
+	if matcherSetReadsResponse(caddyhttp.MatcherSet{caddyhttp.MatchMethod{"POST"}}) {
+		t.Error("expected non-expression matcher set to not read the response")
+	}
+}
+
+// TestRequestOnlyExpressionDoesNotRetryResponses verifies that an expression
+// that only tests the request does not make successful responses retryable,
+// and that the response is passed through to the client
+func TestRequestOnlyExpressionDoesNotRetryResponses(t *testing.T) {
+	var hits atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		body, _ := io.ReadAll(r.Body)
+		w.WriteHeader(http.StatusOK)
+		w.Write(body)
+	}))
+	t.Cleanup(server.Close)
+
+	retryMatch := caddyhttp.MatcherSets{
+		caddyhttp.MatcherSet{
+			newExpressionMatcher(t, `{http.request.method} == "POST"`),
+		},
+	}
+	upstreams := []*Upstream{
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+	}
+	h := minimalHandlerWithRetryMatch(2, retryMatch, upstreams...)
+
+	req := httptest.NewRequest(http.MethodPost, "http://example.com/order", strings.NewReader("order=1"))
+	req = prepareTestRequest(req)
+	rec := httptest.NewRecorder()
+
+	err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		return nil
+	}))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if hits.Load() != 1 {
+		t.Errorf("upstream hits: got %d, want 1", hits.Load())
+	}
+	if rec.Code != http.StatusOK {
+		t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+	}
+	if rec.Body.String() != "order=1" {
+		t.Errorf("body: got %q, want %q", rec.Body.String(), "order=1")
+	}
+}
