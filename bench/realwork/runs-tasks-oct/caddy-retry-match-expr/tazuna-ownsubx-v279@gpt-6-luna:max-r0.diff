+// TestRequestOnlyExpressionDoesNotRetryResponses verifies that an expression
+// which only checks the request, like a method condition, does not cause a
+// successful upstream response to be retried.
+func TestRequestOnlyExpressionDoesNotRetryResponses(t *testing.T) {
+	var hits atomic.Int32
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("ok"))
+	}))
+	t.Cleanup(server.Close)
+
+	retryMatch := caddyhttp.MatcherSets{
+		caddyhttp.MatcherSet{
+			newExpressionMatcher(t, `{http.request.method} == "POST"`),
+		},
+	}
+
+	upstreams := []*Upstream{
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+	}
+
+	h := minimalHandlerWithRetryMatch(2, retryMatch, upstreams...)
+
+	req := httptest.NewRequest(http.MethodPost, "http://example.com/", strings.NewReader("order=1"))
+	req = prepareTestRequest(req)
+	rec := httptest.NewRecorder()
+
+	err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		return nil
+	}))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if hits.Load() != 1 {
+		t.Errorf("upstream hits: got %d, want 1 (request-only expression retried a successful response)", hits.Load())
+	}
+	if rec.Code != http.StatusOK {
+		t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+	}
+	if rec.Body.String() != "ok" {
+		t.Errorf("body: got %q, want %q", rec.Body.String(), "ok")
+	}
+}
+
+// TestRetryMatchExpressionResponsePlaceholderClassification verifies that
+// only expressions which can read response data are evaluated after a
+// successful upstream roundtrip.
+func TestRetryMatchExpressionResponsePlaceholderClassification(t *testing.T) {
+	tests := []struct {
+		name string
+		expr string
+		want bool
+	}{
+		{
+			name: "status code placeholder",
+			expr: `{http.reverse_proxy.status_code} == 502`,
+			want: true,
+		},
+		{
+			name: "status text placeholder",
+			expr: `{http.reverse_proxy.status_text} == "502 Bad Gateway"`,
+			want: true,
+		},
+		{
+			name: "response header placeholder",
+			expr: `{http.reverse_proxy.header.X-Retry} == "true"`,
+			want: true,
+		},
+		{
+			name: "upstream latency placeholder",
+			expr: `{http.reverse_proxy.upstream.latency_ms} > 0`,
+			want: true,
+		},
+		{
+			name: "upstream latency duration placeholder",
+			expr: `{http.reverse_proxy.upstream.latency} > 0`,
+			want: true,
+		},
+		{
+			name: "direct placeholder function",
+			expr: `ph(req, "http.reverse_proxy.status_code") == 502`,
+			want: true,
+		},
+		{
+			name: "request placeholder",
+			expr: `{http.request.method} == "POST"`,
+			want: false,
+		},
+		{
+			name: "direct request placeholder function",
+			expr: `ph(req, "http.request.method") == "POST"`,
+			want: false,
+		},
+		{
+			name: "known upstream placeholder",
+			expr: `{http.reverse_proxy.upstream.host} == "localhost"`,
+			want: false,
+		},
+		{
+			name: "status code prefix only",
+			expr: `{http.reverse_proxy.status_codes} == 502`,
+			want: false,
+		},
+		{
+			name: "escaped response placeholder text",
+			// The placeholders here are string contents, not calls to ph.
+			expr: `'\{http.reverse_proxy.status_code}' == '\{http.reverse_proxy.status_code}'`,
+			want: false,
+		},
+		{
+			name: "dynamic placeholder name",
+			expr: `ph(req, "http.reverse_proxy." + "status_code") == 502`,
+			want: true,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			matcher := newExpressionMatcher(t, tc.expr)
+			got := matcherSetHasResponseExpressionMatcher(caddyhttp.MatcherSet{matcher})
+			if got != tc.want {
+				t.Errorf("matcherSetHasResponseExpressionMatcher() = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
