+
+func expressionUsesResponsePlaceholder(expr ast.Expr) bool {
+	if expr == nil {
+		return false
+	}
+
+	usesResponsePlaceholder := false
+	ast.PreOrderVisit(expr, ast.NewExprVisitor(func(expr ast.Expr) {
+		if usesResponsePlaceholder || expr.Kind() != ast.CallKind {
+			return
+		}
+		call := expr.AsCall()
+		if call.FunctionName() != CELPlaceholderFuncName {
+			return
+		}
+		args := call.Args()
+		if len(args) < 2 || args[1].Kind() != ast.LiteralKind {
+			// A dynamically determined placeholder may refer to response
+			// data, so it must be treated as a possible response condition.
+			usesResponsePlaceholder = true
+			return
+		}
+		name, ok := args[1].AsLiteral().Value().(string)
+		if !ok {
+			usesResponsePlaceholder = true
+			return
+		}
+		usesResponsePlaceholder = isResponsePlaceholder(name)
+	}))
+	return usesResponsePlaceholder
+}
+
+func isResponsePlaceholder(name string) bool {
+	switch name {
+	case "http.reverse_proxy.status_code",
+		"http.reverse_proxy.status_text",
+		"http.reverse_proxy.upstream.latency",
+		"http.reverse_proxy.upstream.latency_ms":
+		return true
+	default:
+		return strings.HasPrefix(name, "http.reverse_proxy.header.")
+	}
+}
