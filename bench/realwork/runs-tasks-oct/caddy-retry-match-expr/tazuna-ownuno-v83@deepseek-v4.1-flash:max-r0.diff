+// PlaceholderNames returns the names of the Caddy placeholders referenced by
+// the expression, along with whether all of those names could be determined
+// statically. If the second return value is false, the expression references
+// at least one placeholder whose name is only known at evaluation time.
+func (m MatchExpression) PlaceholderNames() ([]string, bool) {
+	return append([]string(nil), m.placeholderNames...), m.placeholdersKnown
+}
+
+// placeholderNamesFromAST returns the names of all placeholders passed to the
+// ph() function in the expression's AST. The second return value is false if
+// any placeholder name cannot be determined statically.
+func placeholderNamesFromAST(root *ast.AST) ([]string, bool) {
+	if root == nil {
+		return nil, true
+	}
+	calls := ast.MatchDescendants(ast.NavigateAST(root), ast.FunctionMatcher(CELPlaceholderFuncName))
+	names := make([]string, 0, len(calls))
+	for _, call := range calls {
+		args := call.AsCall().Args()
+		if len(args) != 2 {
+			return names, false
+		}
+		if args[1].Kind() != ast.LiteralKind {
+			return names, false
+		}
+		name, ok := args[1].AsLiteral().Value().(string)
+		if !ok {
+			return names, false
+		}
+		names = append(names, name)
+	}
+	return names, true
+}
+
 // Match returns true if r matches m.
 func (m MatchExpression) Match(r *http.Request) bool {
 	match, err := m.MatchWithError(r)
