+func TestMatchExpressionPlaceholderNames(t *testing.T) {
+	tests := []struct {
+		name      string
+		expr      string
+		wantNames []string
+		wantKnown bool
+	}{
+		{
+			name:      "shorthand placeholder",
+			expr:      `{http.request.method} == "POST"`,
+			wantNames: []string{"http.request.method"},
+			wantKnown: true,
+		},
+		{
+			name:      "explicit ph call",
+			expr:      `ph(req, "http.reverse_proxy.status_code") == 502`,
+			wantNames: []string{"http.reverse_proxy.status_code"},
+			wantKnown: true,
+		},
+		{
+			name:      "multiple placeholders",
+			expr:      `{http.request.method} == "POST" && {http.reverse_proxy.status_code} == 502`,
+			wantNames: []string{"http.request.method", "http.reverse_proxy.status_code"},
+			wantKnown: true,
+		},
+		{
+			name:      "no placeholders",
+			expr:      `path("/foo")`,
+			wantNames: nil,
+			wantKnown: true,
+		},
+		{
+			name:      "escaped placeholder is a string literal",
+			expr:      `"\{http.reverse_proxy.status_code}" != ""`,
+			wantNames: nil,
+			wantKnown: true,
+		},
+		{
+			name:      "dynamic placeholder name",
+			expr:      `ph(req, "{http.reverse_proxy.status_" + "code}") == 502`,
+			wantNames: nil,
+			wantKnown: false,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+			defer cancel()
+			m := &MatchExpression{Expr: tc.expr}
+			if err := m.Provision(ctx); err != nil {
+				t.Fatalf("provisioning %q: %v", tc.expr, err)
+			}
+			names, known := m.PlaceholderNames()
+			if known != tc.wantKnown {
+				t.Errorf("known: got %t, want %t", known, tc.wantKnown)
+			}
+			if len(names) != len(tc.wantNames) {
+				t.Fatalf("names: got %v, want %v", names, tc.wantNames)
+			}
+			for i := range names {
+				if names[i] != tc.wantNames[i] {
+					t.Errorf("names[%d]: got %q, want %q", i, names[i], tc.wantNames[i])
+				}
+			}
+		})
+	}
+}
