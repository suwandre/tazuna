+func TestResponseWriterWrapperDetachAfterHijack(t *testing.T) {
+	// A plain wrapper holds no state, so it supports detachment even when
+	// the wrapped writer does not. This lets detached streams work without
+	// an access-log response recorder in the writer chain.
+	wrapped := &ResponseWriterWrapper{ResponseWriter: new(baseRespWriter)}
+	if !wrapped.DetachAfterHijack(true) {
+		t.Fatal("plain response writer wrapper should support detachment")
+	}
+	if !DetachResponseWriterAfterHijack(wrapped, true) {
+		t.Fatal("DetachResponseWriterAfterHijack() should succeed for a plain wrapper chain")
+	}
+
+	// A wrapper that refuses detachment must still make the whole chain
+	// report failure so callers can keep the stream attached.
+	rejecting := &ResponseWriterWrapper{ResponseWriter: new(baseRespWriter)}
+	if DetachResponseWriterAfterHijack(detachRejectingWriter{rejecting}, true) {
+		t.Fatal("rejecting writer should prevent detachment")
+	}
+}
+
+// detachRejectingWriter refuses to detach, like a writer that is already
+// hijacked or otherwise cannot safely outlive the handler.
+type detachRejectingWriter struct {
+	*ResponseWriterWrapper
+}
+
+func (detachRejectingWriter) DetachAfterHijack(bool) bool { return false }
