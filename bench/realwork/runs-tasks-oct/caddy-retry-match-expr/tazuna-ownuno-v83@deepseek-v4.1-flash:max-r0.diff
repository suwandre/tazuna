+// TestReverseProxyRetryMatchRequestOnlyExpression verifies that an
+// lb_retry_match expression that only inspects the request does not cause
+// successful responses to be retried, and that the request body is not
+// consumed by spurious retries
+func TestReverseProxyRetryMatchRequestOnlyExpression(t *testing.T) {
+	var hits atomic.Int32
+
+	srv := &http.Server{
+		Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			hits.Add(1)
+			body, _ := io.ReadAll(r.Body)
+			w.Write(body)
+		}),
+	}
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("failed to listen: %v", err)
+	}
+	go srv.Serve(ln)
+	t.Cleanup(func() { srv.Close(); ln.Close() })
+
+	tester := caddytest.NewTester(t)
+	tester.InitServer(fmt.Sprintf(`
+	{
+		skip_install_trust
+		admin localhost:2999
+		http_port 9080
+		https_port 9443
+		grace_period 1ns
+	}
+	http://localhost:9080 {
+		reverse_proxy %s %s {
+			lb_policy round_robin
+			lb_retries 2
+			lb_retry_match {
+				expression `+"`{http.request.method} == \"POST\"`"+`
+			}
+		}
+	}
+	`, ln.Addr().String(), ln.Addr().String()), "caddyfile")
+
+	// A successful POST must be returned as-is, not retried
+	req, err := http.NewRequest(http.MethodPost, "http://localhost:9080/order", strings.NewReader("order=1"))
+	if err != nil {
+		t.Fatalf("failed to create request: %v", err)
+	}
+	tester.AssertResponse(req, 200, "order=1")
+
+	if hits.Load() != 1 {
+		t.Errorf("upstream hits: got %d, want 1 (request-only expression must not retry responses)", hits.Load())
+	}
+}
