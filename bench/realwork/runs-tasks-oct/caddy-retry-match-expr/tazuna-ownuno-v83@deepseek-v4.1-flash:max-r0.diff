+// TestRequestOnlyExpressionDoesNotRetryResponses verifies that an
+// lb_retry_match expression which only inspects the request is treated as a
+// request condition (as before v2.11.3), not as a response condition. A
+// successful response must be passed through to the client without retrying
+func TestRequestOnlyExpressionDoesNotRetryResponses(t *testing.T) {
+	var hits atomic.Int32
+
+	// Both upstreams return 200 and echo the request body
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			http.Error(w, "read body: "+err.Error(), http.StatusInternalServerError)
+			return
+		}
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write(body)
+	}))
+	t.Cleanup(server.Close)
+
+	for _, tc := range []struct {
+		name string
+		expr string
+	}{
+		{
+			name: "shorthand placeholder",
+			expr: `{http.request.method} == "POST"`,
+		},
+		{
+			name: "explicit ph call",
+			expr: `ph(req, "http.request.method") == "POST"`,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			hits.Store(0)
+
+			retryMatch := caddyhttp.MatcherSets{
+				caddyhttp.MatcherSet{
+					newExpressionMatcher(t, tc.expr),
+				},
+			}
+
+			upstreams := []*Upstream{
+				{Host: new(Host), Dial: server.Listener.Addr().String()},
+				{Host: new(Host), Dial: server.Listener.Addr().String()},
+			}
+
+			h := minimalHandlerWithRetryMatch(2, retryMatch, upstreams...)
+
+			const requestBody = "order=1"
+			req := httptest.NewRequest(http.MethodPost, "http://example.com/order", strings.NewReader(requestBody))
+			req = prepareTestRequest(req)
+			rec := httptest.NewRecorder()
+
+			err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+				return nil
+			}))
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+
+			if hits.Load() != 1 {
+				t.Errorf("upstream hits: got %d, want 1 (request-only expression must not retry responses)", hits.Load())
+			}
+			if rec.Code != http.StatusOK {
+				t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+			}
+			if rec.Body.String() != requestBody {
+				t.Errorf("body: got %q, want %q", rec.Body.String(), requestBody)
+			}
+		})
+	}
+}
