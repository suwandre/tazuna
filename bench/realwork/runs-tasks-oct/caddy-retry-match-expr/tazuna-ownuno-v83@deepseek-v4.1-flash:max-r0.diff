@@ -197,9 +199,48 @@ func (m *MatchExpression) Provision(ctx caddy.Context) error {
 	if err != nil {
 		return fmt.Errorf("compiling CEL program: %s", err)
 	}
+
+	// record the placeholders referenced by the expression so callers can
