+			want: true,
+		},
+		{
+			name: "latency",
+			set:  caddyhttp.MatcherSet{newExpressionMatcher(t, "{http.reverse_proxy.upstream.latency} > 0")},
+			want: true,
+		},
+		{
+			name: "latency_ms",
+			set:  caddyhttp.MatcherSet{newExpressionMatcher(t, "{http.reverse_proxy.upstream.latency_ms} > 0")},
+			want: true,
+		},
+		{
+			name: "explicit ph call",
+			set:  caddyhttp.MatcherSet{newExpressionMatcher(t, `ph(req, "http.reverse_proxy.status_code") == 502`)},
+			want: true,
+		},
+		{
+			name: "request only",
+			set:  caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.request.method} == "POST"`)},
+			want: false,
+		},
+		{
+			name: "request only explicit ph call",
+			set:  caddyhttp.MatcherSet{newExpressionMatcher(t, `ph(req, "http.request.method") == "POST"`)},
+			want: false,
+		},
+		{
+			name: "upstream host is known before the response",
