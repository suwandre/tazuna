+func TestMatchExpressionPlaceholderNames(t *testing.T) {
+	for i, tc := range []struct {
+		expr        string
+		wantNames   []string
+		wantDynamic bool
+	}{
+		{
+			expr:      `{http.request.method} == "POST"`,
+			wantNames: []string{"http.request.method"},
+		},
+		{
+			expr:      `{rp.status_code} == 502`,
+			wantNames: []string{"rp.status_code"},
+		},
+		{
+			expr:      `ph(req, "http.reverse_proxy.status_code") == 502`,
+			wantNames: []string{"http.reverse_proxy.status_code"},
+		},
+		{
+			expr:      `{http.reverse_proxy.header.X-Foo} == "true"`,
+			wantNames: []string{"http.reverse_proxy.header.X-Foo"},
+		},
+		{
+			expr:      `{http.reverse_proxy.upstream.latency_ms} > 100`,
+			wantNames: []string{"http.reverse_proxy.upstream.latency_ms"},
+		},
+		{
+			// escaped placeholder inside a string literal is not a placeholder reference
+			expr:      `{http.request.method} == "\{http.reverse_proxy.status_code}"`,
+			wantNames: []string{"http.request.method"},
+		},
+		{
+			// placeholder name only starts like a response placeholder
+			expr:      `{http.reverse_proxy.status_codes} == 1`,
+			wantNames: []string{"http.reverse_proxy.status_codes"},
+		},
+		{
+			// placeholder name that cannot be known until evaluation time
+			expr:        `ph(req, "http.reverse_proxy.header." + "X-Foo") == "true"`,
+			wantNames:   nil,
+			wantDynamic: true,
+		},
+	} {
+		ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+		m := &MatchExpression{Expr: tc.expr}
+		err := m.Provision(ctx)
+		cancel()
+		if err != nil {
+			t.Errorf("Test %d: unexpected provision error for %q: %v", i, tc.expr, err)
+			continue
+		}
+		names, dynamic := m.PlaceholderNames()
+		if dynamic != tc.wantDynamic {
+			t.Errorf("Test %d (%q): dynamic = %v, want %v", i, tc.expr, dynamic, tc.wantDynamic)
+		}
+		if len(names) != len(tc.wantNames) {
+			t.Errorf("Test %d (%q): names = %v, want %v", i, tc.expr, names, tc.wantNames)
+			continue
+		}
+		for j := range names {
+			if names[j] != tc.wantNames[j] {
+				t.Errorf("Test %d (%q): names = %v, want %v", i, tc.expr, names, tc.wantNames)
+				break
+			}
+		}
+	}
+}
