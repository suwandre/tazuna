+// TestRequestOnlyExpressionDoesNotRetryResponses verifies that a
+// lb_retry_match expression that only tests the request (no response
+// placeholders) does NOT trigger response-based retries. This is the
+// regression from v2.11.3 where such an expression made every successful
+// response retryable
+func TestRequestOnlyExpressionDoesNotRetryResponses(t *testing.T) {
+	var hits atomic.Int32
+
+	// Server returns 200 OK for all requests
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		w.WriteHeader(http.StatusOK)
+		w.Write([]byte("ok"))
+	}))
+	t.Cleanup(server.Close)
+
+	// Request-only expression - should NOT trigger response retries
+	retryMatch := caddyhttp.MatcherSets{
+		caddyhttp.MatcherSet{
+			newExpressionMatcher(t, `{http.request.method} == "POST"`),
+		},
+	}
+
+	upstreams := []*Upstream{
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+	}
+
+	h := minimalHandlerWithRetryMatch(2, retryMatch, upstreams...)
+
+	req := httptest.NewRequest(http.MethodPost, "http://example.com/order", strings.NewReader("order=1"))
+	req = prepareTestRequest(req)
+	rec := httptest.NewRecorder()
+
+	err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		return nil
+	}))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	// Should hit only once - no retry for 200 OK even though the request matches
+	if hits.Load() != 1 {
+		t.Errorf("upstream hits: got %d, want 1 (should not retry successful responses)", hits.Load())
+	}
+	if rec.Code != http.StatusOK {
+		t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+	}
+}
+
+// TestRetryMatchExpressionClassification verifies that only expressions which
+// reference upstream response data are evaluated for response-based retries.
+// A response expression can retry a failing response, while a request-only
+// expression that evaluates true must not make every response retryable
+func TestRetryMatchExpressionClassification(t *testing.T) {
+	tests := []struct {
+		name       string
+		expr       string
+		wantHits   int32
+		wantStatus int
+	}{
+		{
+			name:       "shorthand status code retries",
+			expr:       `{http.reverse_proxy.status_code} == 502`,
+			wantHits:   2,
+			wantStatus: http.StatusOK,
+		},
+		{
+			name:       "direct ph call status code retries",
+			expr:       `ph(req, "http.reverse_proxy.status_code") == 502`,
+			wantHits:   2,
+			wantStatus: http.StatusOK,
+		},
+		{
+			name:       "shorthand response header retries",
+			expr:       `{http.reverse_proxy.header.X-Retry} == "true"`,
+			wantHits:   2,
+			wantStatus: http.StatusOK,
+		},
+		{
+			name:       "direct ph call response header retries",
+			expr:       `ph(req, "http.reverse_proxy.header.X-Retry") == "true"`,
+			wantHits:   2,
+			wantStatus: http.StatusOK,
+		},
+		{
+			name:       "request method expression does not retry",
+			expr:       `{http.request.method} == "GET"`,
+			wantHits:   1,
+			wantStatus: http.StatusBadGateway,
+		},
+		{
+			// name only starts like a response placeholder; request condition
+			name:       "status_codes is not a response placeholder",
+			expr:       `{http.reverse_proxy.status_codes} == ""`,
+			wantHits:   1,
+			wantStatus: http.StatusBadGateway,
+		},
+		{
+			// escaped placeholder in a string literal is not a response read
+			name:       "escaped placeholder is a request condition",
+			expr:       `{http.request.method} == "\{http.reverse_proxy.status_code}"`,
+			wantHits:   1,
+			wantStatus: http.StatusBadGateway,
+		},
+		{
+			// upstream host is known before the response arrives
+			name:       "upstream host is a request condition",
+			expr:       `{http.reverse_proxy.upstream.host} != ""`,
+			wantHits:   1,
+			wantStatus: http.StatusBadGateway,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var hits atomic.Int32
+
+			// First upstream answer is a 502 with X-Retry: true; subsequent
+			// answers are 200 without the header. Response-based expressions
+			// therefore retry the first answer and settle on the second,
+			// while request-only expressions pass the 502 through
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if hits.Add(1) == 1 {
+					w.Header().Set("X-Retry", "true")
+					w.WriteHeader(http.StatusBadGateway)
+					return
+				}
+				w.WriteHeader(http.StatusOK)
+				w.Write([]byte("ok"))
+			}))
+			t.Cleanup(server.Close)
+
+			retryMatch := caddyhttp.MatcherSets{
+				caddyhttp.MatcherSet{
+					newExpressionMatcher(t, tc.expr),
+				},
+			}
+
+			upstreams := []*Upstream{
+				{Host: new(Host), Dial: server.Listener.Addr().String()},
+				{Host: new(Host), Dial: server.Listener.Addr().String()},
+			}
+
+			h := minimalHandlerWithRetryMatch(1, retryMatch, upstreams...)
+
+			req := httptest.NewRequest(http.MethodGet, "http://example.com/", nil)
+			req = prepareTestRequest(req)
+			rec := httptest.NewRecorder()
+
+			err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+				return nil
+			}))
+
+			gotStatus := rec.Code
+			if err != nil {
+				if herr, ok := err.(caddyhttp.HandlerError); ok {
+					gotStatus = herr.StatusCode
+				} else {
+					t.Fatalf("unexpected error: %v", err)
+				}
+			}
+
+			if hits.Load() != tc.wantHits {
+				t.Errorf("upstream hits: got %d, want %d", hits.Load(), tc.wantHits)
+			}
+			if gotStatus != tc.wantStatus {
+				t.Errorf("status: got %d, want %d", gotStatus, tc.wantStatus)
+			}
+		})
+	}
+}
+
+// TestMatcherSetReadsResponse unit-tests the classification of retry_match
+// matcher sets as response-based or request-only
+func TestMatcherSetReadsResponse(t *testing.T) {
+	for i, tc := range []struct {
+		name string
+		expr string
+		want bool
+	}{
+		{name: "status code", expr: `{http.reverse_proxy.status_code} == 502`, want: true},
+		{name: "status text", expr: `{http.reverse_proxy.status_text} == "Bad Gateway"`, want: true},
+		{name: "response header", expr: `{http.reverse_proxy.header.X-Retry} == "true"`, want: true},
+		{name: "latency", expr: `{http.reverse_proxy.upstream.latency} > 1`, want: true},
+		{name: "latency ms", expr: `{http.reverse_proxy.upstream.latency_ms} > 1`, want: true},
+		{name: "direct ph call", expr: `ph(req, "http.reverse_proxy.status_code") == 502`, want: true},
+		{name: "dynamic placeholder", expr: `ph(req, "http.reverse_proxy.header." + "X-Retry") == "true"`, want: true},
+		{name: "request method", expr: `{http.request.method} == "POST"`, want: false},
+		{name: "upstream host", expr: `{http.reverse_proxy.upstream.host} != ""`, want: false},
+		{name: "similar placeholder name", expr: `{http.reverse_proxy.status_codes} == 1`, want: false},
+		{name: "escaped placeholder", expr: `{http.request.method} == "\{http.reverse_proxy.status_code}"`, want: false},
+	} {
+		retryMatch := caddyhttp.MatcherSet{newExpressionMatcher(t, tc.expr)}
+		if got := matcherSetReadsResponse(retryMatch); got != tc.want {
+			t.Errorf("Test %d (%q): matcherSetReadsResponse = %v, want %v", i, tc.expr, got, tc.want)
+		}
+	}
+
+	// non-expression matchers are never response-based
+	if matcherSetReadsResponse(caddyhttp.MatcherSet{caddyhttp.MatchMethod{"POST"}}) {
+		t.Error("method matcher should not be response-based")
+	}
+}
