+// collectPlaceholders records the names of the Caddy placeholders referenced
+// by the compiled expression. A placeholder whose name is not a constant is
+// marked as dynamic, meaning it can only be resolved at evaluation time.
+func (m *MatchExpression) collectPlaceholders(checked *cel.Ast) {
+	m.placeholderNames = nil
+	m.dynamicPlaceholder = false
+
+	ast.PostOrderVisit(checked.NativeRep().Expr(), ast.NewExprVisitor(func(e ast.Expr) {
+		if e.Kind() != ast.CallKind {
+			return
+		}
+		call := e.AsCall()
+		if call.FunctionName() != CELPlaceholderFuncName {
+			return
+		}
+		args := call.Args()
+		if len(args) != 2 {
+			m.dynamicPlaceholder = true
+			return
+		}
+		name, ok := args[1].AsLiteral().(types.String)
+		if !ok {
+			m.dynamicPlaceholder = true
+			return
+		}
+		m.placeholderNames = append(m.placeholderNames, string(name))
+	}))
+}
+
+// PlaceholderNames returns the names of the Caddy placeholders referenced by
+// the expression. If dynamic is true, at least one referenced placeholder has
+// a name that cannot be known until the expression is evaluated.
+func (m *MatchExpression) PlaceholderNames() (names []string, dynamic bool) {
+	return m.placeholderNames, m.dynamicPlaceholder
+}
+
 // Match returns true if r matches m.
 func (m MatchExpression) Match(r *http.Request) bool {
 	match, err := m.MatchWithError(r)
