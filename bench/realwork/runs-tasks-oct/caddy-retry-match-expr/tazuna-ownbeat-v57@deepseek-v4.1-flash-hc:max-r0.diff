index 3e44fbb..6520bbb 100644
--- a/modules/caddyhttp/celmatcher_test.go
+++ b/modules/caddyhttp/celmatcher_test.go
@@ -605,3 +605,84 @@ func TestMatchExpressionProvision(t *testing.T) {
 		})
 	}
 }
+
+func TestMatchExpressionUsesResponsePlaceholders(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		expr string
+		want bool
+	}{
+		{
+			name: "request method is not a response condition",
+			expr: `{http.request.method} == "POST"`,
+			want: false,
+		},
+		{
+			name: "upstream host is known before the response",
+			expr: `{http.reverse_proxy.upstream.host} == "example.com"`,
+			want: false,
+		},
+		{
+			name: "status_code is a response condition",
+			expr: `{http.reverse_proxy.status_code} in [502, 503]`,
+			want: true,
+		},
+		{
+			name: "status_text is a response condition",
+			expr: `{http.reverse_proxy.status_text} == "Bad Gateway"`,
+			want: true,
+		},
+		{
+			name: "response header is a response condition",
+			expr: `{http.reverse_proxy.header.X-Retry} == "true"`,
+			want: true,
+		},
+		{
+			name: "latency is a response condition",
+			expr: `{http.reverse_proxy.upstream.latency} > 1`,
+			want: true,
+		},
+		{
+			name: "latency_ms is a response condition",
+			expr: `{http.reverse_proxy.upstream.latency_ms} > 1000`,
+			want: true,
+		},
+		{
+			name: "similarly named placeholder is not a response condition",
+			expr: `{http.reverse_proxy.status_codes} == "1"`,
+			want: false,
+		},
+		{
+			name: "explicit ph() call with status_code is a response condition",
+			expr: `ph(req, "http.reverse_proxy.status_code") == 200`,
+			want: true,
+		},
+		{
+			name: "explicit ph() call with request placeholder is not a response condition",
+			expr: `ph(req, "http.request.method") == "POST"`,
+			want: false,
+		},
+		{
+			name: "escaped response placeholder inside string literal is not a response condition",
+			expr: `header({'Field': '\{http.reverse_proxy.status_code}'})`,
+			want: false,
+		},
+		{
+			name: "dynamic placeholder name is conservatively a response condition",
+			expr: `ph(req, "http.reverse_proxy.status_" + "code") == 1`,
+			want: true,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+			defer cancel()
+			m := &MatchExpression{Expr: tc.expr}
+			if err := m.Provision(ctx); err != nil {
+				t.Fatalf("provisioning %q: %v", tc.expr, err)
+			}
+			if got := m.UsesResponsePlaceholders(); got != tc.want {
+				t.Errorf("UsesResponsePlaceholders(%q) = %v, want %v", tc.expr, got, tc.want)
+			}
+		})
+	}
+}
diff --git a/modules/caddyhttp/reverseproxy/retries_test.go b/modules/caddyhttp/reverseproxy/retries_test.go
index bfd7097..b096bb1 100644
--- a/modules/caddyhttp/reverseproxy/retries_test.go
+++ b/modules/caddyhttp/reverseproxy/retries_test.go
@@ -565,6 +565,62 @@ func TestRequestOnlyMatcherDoesNotRetryResponses(t *testing.T) {
 	}
 }
 
+// TestRequestOnlyExpressionDoesNotRetryResponses verifies that an
+// lb_retry_match expression that only inspects the request (e.g. the HTTP
+// method) does NOT trigger response-based retries. Only expressions that
+// reference response placeholders ({rp.status_code}, {rp.header.*}, the
+// upstream latency placeholders) should do so. This is a regression test
+// for #7569: before the fix, any expression matcher was evaluated against
+// the response, so a successful response was retried and ultimately
+// reported as 502 (see issue with lb_retry_match + {http.request.method}).
+func TestRequestOnlyExpressionDoesNotRetryResponses(t *testing.T) {
+	var hits atomic.Int32
+
+	// Server returns 200 OK for all requests
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		w.WriteHeader(http.StatusOK)
+		w.Write([]byte("ok"))
+	}))
+	t.Cleanup(server.Close)
+
+	retryMatch := caddyhttp.MatcherSets{
+		caddyhttp.MatcherSet{
+			newExpressionMatcher(t, `{http.request.method} == "POST"`),
+		},
+	}
+
+	upstreams := []*Upstream{
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+	}
+
+	h := minimalHandlerWithRetryMatch(2, retryMatch, upstreams...)
+
+	req := httptest.NewRequest(http.MethodPost, "http://example.com/", strings.NewReader("order=1"))
+	req = prepareTestRequest(req)
+	rec := httptest.NewRecorder()
+
+	err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		return nil
+	}))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	// Should hit only once - a request-only expression must not retry a
+	// successful response
+	if hits.Load() != 1 {
+		t.Errorf("upstream hits: got %d, want 1 (should not retry successful responses)", hits.Load())
+	}
+	if rec.Code != http.StatusOK {
+		t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+	}
+	if rec.Body.String() != "ok" {
+		t.Errorf("body: got %q, want %q", rec.Body.String(), "ok")
+	}
+}
