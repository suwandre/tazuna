@@ -805,6 +829,72 @@ func isCELStringListLiteral(e ast.Expr) bool {
 	return false
 }
 
+// responsePlaceholderNames is the set of placeholders that are only
+// populated after an upstream response has been received. Expressions
+// referencing any of these are interpreted as response conditions by the
+// reverse proxy's retry logic.
+var responsePlaceholderNames = map[string]struct{}{
+	"http.reverse_proxy.status_code":         {},
+	"http.reverse_proxy.status_text":         {},
+	"http.reverse_proxy.upstream.latency":    {},
+	"http.reverse_proxy.upstream.latency_ms": {},
+}
+
+// responsePlaceholderHeaderPrefix is the prefix shared by all response
+// header placeholders (e.g. {http.reverse_proxy.header.Content-Type}).
+const responsePlaceholderHeaderPrefix = "http.reverse_proxy.header."
+
+// isResponsePlaceholder reports whether name refers to data that is only
+// available after an upstream response has been received.
+func isResponsePlaceholder(name string) bool {
+	if _, ok := responsePlaceholderNames[name]; ok {
+		return true
+	}
+	return strings.HasPrefix(name, responsePlaceholderHeaderPrefix)
+}
+
+// expressionUsesResponsePlaceholders reports whether the compiled expression
+// references any placeholder that is only populated after an upstream
+// response has been received. If a placeholder name cannot be determined at
+// plan time (i.e. the argument to ph() is not a string constant), the
+// expression is conservatively reported as a response condition.
+func expressionUsesResponsePlaceholders(checked *cel.Ast) bool {
+	if checked == nil {
+		return false
+	}
+	usesResponse := false
+	ast.PreOrderVisit(checked.NativeRep().Expr(), ast.NewExprVisitor(func(e ast.Expr) {
+		if usesResponse || e.Kind() != ast.CallKind {
+			return
+		}
+		call := e.AsCall()
+		if call.FunctionName() != CELPlaceholderFuncName {
+			return
+		}
+		args := call.Args()
+		if len(args) < 2 {
+			// unexpected signature; be conservative
+			usesResponse = true
+			return
+		}
+		phArg := args[1]
+		if phArg.Kind() != ast.LiteralKind {
+			// dynamic placeholder name; can't know until evaluation time
+			usesResponse = true
+			return
+		}
+		name, ok := phArg.AsLiteral().(types.String)
+		if !ok {
+			usesResponse = true
+			return
+		}
+		if isResponsePlaceholder(string(name)) {
+			usesResponse = true
+		}
+	}))
+	return usesResponse
+}
+
