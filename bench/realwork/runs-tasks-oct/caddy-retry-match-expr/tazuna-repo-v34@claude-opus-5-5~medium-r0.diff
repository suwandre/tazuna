+func TestMatchExpressionPlaceholders(t *testing.T) {
+	for i, tc := range []struct {
+		expr        string
+		wantNames   []string
+		wantDynamic bool
+	}{
+		{
+			expr:      `{http.request.method} == "POST"`,
+			wantNames: []string{"http.request.method"},
+		},
+		{
+			expr:      `ph(req, "http.reverse_proxy.status_code") == 502`,
+			wantNames: []string{"http.reverse_proxy.status_code"},
+		},
+		{
+			expr:      `{http.request.method} == "POST" && {http.reverse_proxy.header.X-Retry} == "1"`,
+			wantNames: []string{"http.request.method", "http.reverse_proxy.header.X-Retry"},
+		},
+		{
+			// escaped placeholders are plain string literals
+			expr: `"\{http.reverse_proxy.status_code}" != ""`,
+		},
+		{
+			expr:        `ph(req, "http.reverse_proxy." + "status_code") == 502`,
+			wantDynamic: true,
+		},
+		{
+			expr: `method("GET")`,
+		},
+	} {
+		ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+		m := &MatchExpression{Expr: tc.expr}
+		err := m.Provision(ctx)
+		cancel()
+		if err != nil {
+			t.Fatalf("Test %d: provisioning %q: %v", i, tc.expr, err)
+		}
+		names, dynamic := m.Placeholders()
+		if !slices.Equal(names, tc.wantNames) {
+			t.Errorf("Test %d: expected names %v, got %v", i, tc.wantNames, names)
+		}
+		if dynamic != tc.wantDynamic {
+			t.Errorf("Test %d: expected dynamic %v, got %v", i, tc.wantDynamic, dynamic)
+		}
+	}
+}
