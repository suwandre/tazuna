+// Placeholders returns the names of the placeholders read by the
+// expression, whether written as {placeholder} shorthand or as
+// direct ph() calls. If any placeholder name is computed at
+// evaluation time and cannot be known in advance, dynamic is true.
+// It must only be called after m is provisioned.
+func (m MatchExpression) Placeholders() (names []string, dynamic bool) {
+	return m.placeholders, m.dynamicPlaceholders
+}
+
+// celPlaceholderNames walks a checked CEL AST and returns the names of
+// all placeholders passed to the placeholder function as string literals.
+// If a placeholder name is not a string literal, dynamic is true.
+func celPlaceholderNames(a *ast.AST) (names []string, dynamic bool) {
+	calls := ast.MatchDescendants(ast.NavigateAST(a), ast.FunctionMatcher(CELPlaceholderFuncName))
+	for _, call := range calls {
+		args := call.AsCall().Args()
+		if len(args) != 2 || args[1].Kind() != ast.LiteralKind {
+			dynamic = true
+			continue
+		}
+		name, ok := args[1].AsLiteral().(types.String)
+		if !ok {
+			dynamic = true
+			continue
+		}
+		names = append(names, string(name))
+	}
+	return names, dynamic
+}
