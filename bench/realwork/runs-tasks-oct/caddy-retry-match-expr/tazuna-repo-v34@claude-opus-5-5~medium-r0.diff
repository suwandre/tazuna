+// TestMatcherSetReadsResponse verifies that only expressions which read
+// upstream response data are evaluated against responses.
+func TestMatcherSetReadsResponse(t *testing.T) {
+	for i, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{expr: `{http.request.method} == "POST"`, want: false},
+		{expr: `{http.reverse_proxy.upstream.host} == "localhost"`, want: false},
+		{expr: `"\{http.reverse_proxy.status_code}" != ""`, want: false},
+		{expr: `{http.reverse_proxy.status_codes} == 502`, want: false},
+		{expr: `{http.reverse_proxy.header} == ""`, want: false},
+		{expr: `{http.reverse_proxy.status_code} in [502, 503]`, want: true},
+		{expr: `ph(req, "http.reverse_proxy.status_code") == 502`, want: true},
+		{expr: `{http.reverse_proxy.status_text} == "502 Bad Gateway"`, want: true},
+		{expr: `{http.reverse_proxy.header.X-Retry} == "true"`, want: true},
+		{expr: `{http.reverse_proxy.upstream.latency_ms} > 100`, want: true},
+		{expr: `{http.reverse_proxy.upstream.latency} != ""`, want: true},
+		{expr: `{http.request.method} == "POST" && {http.reverse_proxy.status_code} == 503`, want: true},
+		{expr: `ph(req, "http.reverse_proxy." + "status_code") == 502`, want: true},
+	} {
+		set := caddyhttp.MatcherSet{newExpressionMatcher(t, tc.expr)}
+		if got := matcherSetReadsResponse(set); got != tc.want {
+			t.Errorf("Test %d: %s: expected %v, got %v", i, tc.expr, tc.want, got)
+		}
+	}
+
+	if matcherSetReadsResponse(caddyhttp.MatcherSet{caddyhttp.MatchMethod{"POST"}}) {
+		t.Error("method matcher should not be evaluated against responses")
+	}
+}
+
+// TestRequestOnlyExpressionDoesNotRetryResponses verifies that an
+// expression testing only the request does not make successful
+// responses retryable.
+func TestRequestOnlyExpressionDoesNotRetryResponses(t *testing.T) {
+	var hits atomic.Int32
+	var bodies sync.Map
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		n := hits.Add(1)
+		body, _ := io.ReadAll(r.Body)
+		bodies.Store(n, string(body))
+		w.WriteHeader(http.StatusOK)
+		w.Write([]byte("ok"))
+	}))
+	t.Cleanup(server.Close)
+
+	retryMatch := caddyhttp.MatcherSets{
+		caddyhttp.MatcherSet{
+			newExpressionMatcher(t, `{http.request.method} == "POST"`),
+		},
+	}
+
+	upstreams := []*Upstream{
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+	}
+
+	h := minimalHandlerWithRetryMatch(2, retryMatch, upstreams...)
+
+	req := httptest.NewRequest(http.MethodPost, "http://example.com/order", strings.NewReader("order=1"))
+	req = prepareTestRequest(req)
+	rec := httptest.NewRecorder()
+
+	err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		return nil
+	}))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if hits.Load() != 1 {
+		t.Errorf("upstream hits: got %d, want 1 (should not retry successful responses)", hits.Load())
+	}
+	if body, _ := bodies.Load(int32(1)); body != "order=1" {
+		t.Errorf("upstream body: got %q, want %q", body, "order=1")
+	}
+	if rec.Code != http.StatusOK {
+		t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+	}
+}
