+// expressionUsesResponsePlaceholders reports whether an expression can read a
+// placeholder whose value is only available after an upstream response is
+// received. Placeholder names which are not statically known are considered
+// response-dependent.
+func expressionUsesResponsePlaceholders(expr ast.Expr) bool {
+	responseDependent := false
+	ast.PostOrderVisit(expr, ast.NewExprVisitor(func(expr ast.Expr) {
+		if responseDependent || expr.Kind() != ast.CallKind {
+			return
+		}
+
+		call := expr.AsCall()
+		if call.FunctionName() != CELPlaceholderFuncName {
+			return
+		}
+
+		args := call.Args()
+		if len(args) != 2 {
+			responseDependent = true
+			return
+		}
+		placeholder, known := staticStringValue(args[1])
+		if !known || isResponsePlaceholder(placeholder) {
+			responseDependent = true
+		}
+	}))
+	return responseDependent
+}
+
+// staticStringValue returns the value of a statically known CEL string
+// expression. It handles string literals and concatenations of them.
+func staticStringValue(expr ast.Expr) (string, bool) {
+	if expr.Kind() == ast.LiteralKind {
+		value, ok := expr.AsLiteral().(types.String)
+		return string(value), ok
+	}
+	if expr.Kind() != ast.CallKind {
+		return "", false
+	}
+
+	call := expr.AsCall()
+	if call.IsMemberFunction() || call.FunctionName() != operators.Add {
+		return "", false
+	}
+
+	var value strings.Builder
+	for _, arg := range call.Args() {
+		part, ok := staticStringValue(arg)
+		if !ok {
+			return "", false
+		}
+		value.WriteString(part)
+	}
+	return value.String(), true
+}
+
+// isResponsePlaceholder reports whether name identifies a placeholder whose
+// value is populated from an upstream response before retry matching.
+func isResponsePlaceholder(name string) bool {
+	switch name {
+	case "http.reverse_proxy.status_code",
+		"http.reverse_proxy.status_text",
+		"http.reverse_proxy.upstream.latency",
+		"http.reverse_proxy.upstream.latency_ms":
+		return true
+	default:
+		return strings.HasPrefix(name, "http.reverse_proxy.header.") &&
+			len(name) > len("http.reverse_proxy.header.")
+	}
+}
