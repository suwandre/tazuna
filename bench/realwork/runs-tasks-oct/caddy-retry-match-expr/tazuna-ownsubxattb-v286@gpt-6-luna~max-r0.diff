+// TestMatchExpressionResponseDependency verifies that only expressions which
+// can read upstream response placeholders are evaluated as response matchers.
+func TestMatchExpressionResponseDependency(t *testing.T) {
+	tests := []struct {
+		name       string
+		expression string
+		want       bool
+	}{
+		{
+			name:       "status code placeholder",
+			expression: `{http.reverse_proxy.status_code} == 502`,
+			want:       true,
+		},
+		{
+			name:       "status text",
+			expression: `{http.reverse_proxy.status_text} == "Bad Gateway"`,
+			want:       true,
+		},
+		{
+			name:       "response header",
+			expression: `{http.reverse_proxy.header.X-Retry} == "true"`,
+			want:       true,
+		},
+		{
+			name:       "upstream latency",
+			expression: `{http.reverse_proxy.upstream.latency_ms} > 0`,
+			want:       true,
+		},
+		{
+			name:       "direct placeholder call",
+			expression: `ph(req, "http.reverse_proxy.status_code") == 502`,
+			want:       true,
+		},
+		{
+			name:       "dynamic placeholder call",
+			expression: `ph(req, {http.request.header.X-Placeholder}) == 502`,
+			want:       true,
+		},
+		{
+			name:       "request method",
+			expression: `{http.request.method} == "POST"`,
+			want:       false,
+		},
+		{
+			name:       "upstream host",
+			expression: `{http.reverse_proxy.upstream.host} != ""`,
+			want:       false,
+		},
+		{
+			name:       "escaped response placeholder text",
+			expression: `"\{http.reverse_proxy.status_code}" == "\{http.reverse_proxy.status_code}"`,
+			want:       false,
+		},
+		{
+			name:       "similar placeholder name",
+			expression: `{http.reverse_proxy.status_codes} == 502`,
+			want:       false,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			matcher := newExpressionMatcher(t, tc.expression)
+			if got := matcher.UsesResponsePlaceholders(); got != tc.want {
+				t.Errorf("UsesResponsePlaceholders() = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+// TestRequestOnlyExpressionDoesNotRetryResponses verifies that a request-only
+// expression in lb_retry_match does not make successful responses retryable.
+func TestRequestOnlyExpressionDoesNotRetryResponses(t *testing.T) {
+	var hits atomic.Int32
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("ok"))
+	}))
+	t.Cleanup(server.Close)
+
+	retryMatch := caddyhttp.MatcherSets{
+		caddyhttp.MatcherSet{
+			newExpressionMatcher(t, `{http.request.method} == "POST"`),
+		},
+	}
+	upstreams := []*Upstream{
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+	}
+
+	h := minimalHandlerWithRetryMatch(2, retryMatch, upstreams...)
+	req := httptest.NewRequest(http.MethodPost, "http://example.com/", nil)
+	req = prepareTestRequest(req)
+	rec := httptest.NewRecorder()
+
+	err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		return nil
+	}))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if hits.Load() != 1 {
+		t.Errorf("upstream hits: got %d, want 1", hits.Load())
+	}
+	if rec.Code != http.StatusOK {
+		t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+	}
+	if rec.Body.String() != "ok" {
+		t.Errorf("body: got %q, want %q", rec.Body.String(), "ok")
+	}
+}
