+// IsResponseMatcher reports whether m may depend on data from an upstream response.
+func (m MatchExpression) IsResponseMatcher() bool {
+	return m.responseMatch
+}
+
+// expressionUsesResponsePlaceholder reports whether expr contains a placeholder
+// which can only be populated after an upstream response is received. If the
+// placeholder name cannot be determined statically, it conservatively assumes
+// that it may refer to response data.
+func expressionUsesResponsePlaceholder(expr ast.Expr) bool {
+	responseMatch := false
+	ast.PreOrderVisit(expr, ast.NewExprVisitor(func(expr ast.Expr) {
+		if responseMatch || expr.Kind() != ast.CallKind {
+			return
+		}
+
+		call := expr.AsCall()
+		if call.FunctionName() != CELPlaceholderFuncName {
+			return
+		}
+
+		args := call.Args()
+		if len(args) != 2 {
+			responseMatch = true
+			return
+		}
+
+		placeholderName, known := staticStringValue(args[1])
+		if !known || isResponsePlaceholder(placeholderName) {
+			responseMatch = true
+		}
+	}))
+	return responseMatch
+}
+
+// staticStringValue returns the value of a CEL string expression when it can
+// be determined without evaluating a request. It handles string literals and
+// concatenations of other static string expressions.
+func staticStringValue(expr ast.Expr) (string, bool) {
+	if expr.Kind() == ast.LiteralKind {
+		value, ok := expr.AsLiteral().Value().(string)
+		return value, ok
+	}
+	if expr.Kind() != ast.CallKind {
+		return "", false
+	}
+
+	call := expr.AsCall()
+	if call.Target().Kind() != ast.UnspecifiedExprKind || call.FunctionName() != operators.Add {
+		return "", false
+	}
+
+	var value strings.Builder
+	for _, arg := range call.Args() {
+		part, ok := staticStringValue(arg)
+		if !ok {
+			return "", false
+		}
+		value.WriteString(part)
+	}
+	return value.String(), true
+}
+
+// isResponsePlaceholder reports whether name is populated from an upstream
+// response rather than from the request or the selected upstream.
+func isResponsePlaceholder(name string) bool {
+	switch name {
+	case "http.reverse_proxy.status_code",
+		"http.reverse_proxy.status_text",
+		"http.reverse_proxy.upstream.latency",
+		"http.reverse_proxy.upstream.latency_ms":
+		return true
+	}
+	return strings.HasPrefix(name, "http.reverse_proxy.header.")
+}
