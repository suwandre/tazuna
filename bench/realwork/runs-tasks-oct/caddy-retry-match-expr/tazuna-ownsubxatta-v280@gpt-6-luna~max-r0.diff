+func TestMatchExpressionIsResponseMatcher(t *testing.T) {
+	tests := []struct {
+		name       string
+		expression string
+		want       bool
+	}{
+		{
+			name:       "status code placeholder",
+			expression: `{http.reverse_proxy.status_code} == 502`,
+			want:       true,
+		},
+		{
+			name:       "status text through ph",
+			expression: `ph(req, "http.reverse_proxy.status_text") == "Bad Gateway"`,
+			want:       true,
+		},
+		{
+			name:       "response header placeholder",
+			expression: `{http.reverse_proxy.header.X-Retry} == "true"`,
+			want:       true,
+		},
+		{
+			name:       "upstream latency placeholder",
+			expression: `{http.reverse_proxy.upstream.latency} > 0`,
+			want:       true,
+		},
+		{
+			name:       "upstream latency milliseconds placeholder",
+			expression: `{http.reverse_proxy.upstream.latency_ms} > 0`,
+			want:       true,
+		},
+		{
+			name:       "request placeholder",
+			expression: `{http.request.method} == "POST"`,
+			want:       false,
+		},
+		{
+			name:       "upstream host placeholder",
+			expression: `{http.reverse_proxy.upstream.host} == "localhost"`,
+			want:       false,
+		},
+		{
+			name:       "status code prefix is not a response placeholder",
+			expression: `{http.reverse_proxy.status_codes} == 502`,
+			want:       false,
+		},
+		{
+			name:       "escaped response placeholder text",
+			expression: `'\{http.reverse_proxy.status_code}' == '\{http.reverse_proxy.status_code}'`,
+			want:       false,
+		},
+		{
+			name:       "static request placeholder name",
+			expression: `ph(req, "http.reverse_proxy.status_" + "codes") == 502`,
+			want:       false,
+		},
+		{
+			name:       "static response placeholder name",
+			expression: `ph(req, "http.reverse_proxy.status_" + "code") == 502`,
+			want:       true,
+		},
+		{
+			name:       "dynamic placeholder name",
+			expression: `ph(req, {http.request.method}) == "POST"`,
+			want:       true,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+			defer cancel()
+
+			matcher := &MatchExpression{Expr: tc.expression}
+			if err := matcher.Provision(ctx); err != nil {
+				t.Fatalf("failed to provision expression: %v", err)
+			}
+			if got := matcher.IsResponseMatcher(); got != tc.want {
+				t.Errorf("IsResponseMatcher() = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
