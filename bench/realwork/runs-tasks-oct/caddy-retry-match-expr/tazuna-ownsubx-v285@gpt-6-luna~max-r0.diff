+// expressionUsesResponseData reports whether an expression may read response
+// data through the ph function. A placeholder whose name is not a string
+// literal is considered response data because its value cannot be known until
+// the expression is evaluated.
+func expressionUsesResponseData(expr ast.Expr) bool {
+	usesResponseData := false
+	ast.PreOrderVisit(expr, ast.NewExprVisitor(func(expr ast.Expr) {
+		if usesResponseData || expr.Kind() != ast.CallKind {
+			return
+		}
+
+		call := expr.AsCall()
+		if call.FunctionName() != CELPlaceholderFuncName {
+			return
+		}
+
+		args := call.Args()
+		if len(args) < 2 || args[1].Kind() != ast.LiteralKind {
+			usesResponseData = true
+			return
+		}
+
+		placeholder, ok := args[1].AsLiteral().(types.String)
+		usesResponseData = !ok || isResponsePlaceholder(string(placeholder))
+	}))
+	return usesResponseData
+}
+
+// isResponsePlaceholder reports whether name identifies a reverse proxy
+// placeholder whose value depends on the upstream response.
+func isResponsePlaceholder(name string) bool {
+	switch name {
+	case "http.reverse_proxy.status_code",
+		"http.reverse_proxy.status_text",
+		"http.reverse_proxy.upstream.latency",
+		"http.reverse_proxy.upstream.latency_ms":
+		return true
+	}
+
+	const responseHeaderPrefix = "http.reverse_proxy.header."
+	return strings.HasPrefix(name, responseHeaderPrefix) && len(name) > len(responseHeaderPrefix)
+}
+
