+// TestRequestOnlyExpressionDoesNotRetryResponses verifies that an expression
+// which only tests request data does not turn every successful response into a
+// retryable response.
+func TestRequestOnlyExpressionDoesNotRetryResponses(t *testing.T) {
+	var hits atomic.Int32
+	var bodiesMu sync.Mutex
+	var bodies []string
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			http.Error(w, "read body: "+err.Error(), http.StatusInternalServerError)
+			return
+		}
+		bodiesMu.Lock()
+		bodies = append(bodies, string(body))
+		bodiesMu.Unlock()
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("ok"))
+	}))
+	t.Cleanup(server.Close)
+
+	retryMatch := caddyhttp.MatcherSets{
+		caddyhttp.MatcherSet{
+			newExpressionMatcher(t, `{http.request.method} == "POST"`),
+		},
+	}
+
+	upstreams := []*Upstream{
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+	}
+	h := minimalHandlerWithRetryMatch(2, retryMatch, upstreams...)
+
+	const requestBody = "order=1"
+	req := httptest.NewRequest(http.MethodPost, "http://example.com/order", strings.NewReader(requestBody))
+	req = prepareTestRequest(req)
+	rec := httptest.NewRecorder()
+
+	err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		return nil
+	}))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if hits.Load() != 1 {
+		t.Fatalf("upstream hits: got %d, want 1", hits.Load())
+	}
+	if rec.Code != http.StatusOK {
+		t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+	}
+	bodiesMu.Lock()
+	defer bodiesMu.Unlock()
+	if len(bodies) != 1 || bodies[0] != requestBody {
+		t.Errorf("upstream request bodies: got %q, want [%q]", bodies, requestBody)
+	}
+}
