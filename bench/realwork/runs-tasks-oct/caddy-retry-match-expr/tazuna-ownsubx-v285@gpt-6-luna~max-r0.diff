+
+func TestMatchExpressionUsesResponseData(t *testing.T) {
+	tests := []struct {
+		name string
+		expr string
+		want bool
+	}{
+		{
+			name: "status code placeholder",
+			expr: `{http.reverse_proxy.status_code} == 502`,
+			want: true,
+		},
+		{
+			name: "status text placeholder",
+			expr: `{http.reverse_proxy.status_text} == "Bad Gateway"`,
+			want: true,
+		},
+		{
+			name: "header placeholder",
+			expr: `{http.reverse_proxy.header.X-Retry} == "true"`,
+			want: true,
+		},
+		{
+			name: "upstream latency placeholder",
+			expr: `{http.reverse_proxy.upstream.latency} > 0`,
+			want: true,
+		},
+		{
+			name: "upstream latency milliseconds placeholder",
+			expr: `{http.reverse_proxy.upstream.latency_ms} > 0`,
+			want: true,
+		},
+		{
+			name: "direct response placeholder",
+			expr: `ph(req, "http.reverse_proxy.status_code") == 502`,
+			want: true,
+		},
+		{
+			name: "request placeholder",
+			expr: `{http.reverse_proxy.upstream.host} == "example.com"`,
+			want: false,
+		},
+		{
+			name: "escaped response placeholder text",
+			expr: `'\{http.reverse_proxy.status_code}' == '\{http.reverse_proxy.status_code}'`,
+			want: false,
+		},
+		{
+			name: "similar response placeholder",
+			expr: `{http.reverse_proxy.status_codes} == 502`,
+			want: false,
+		},
+		{
+			name: "direct request placeholder",
+			expr: `ph(req, "http.reverse_proxy.upstream.host") == "example.com"`,
+			want: false,
+		},
+		{
+			name: "dynamic placeholder name",
+			expr: `ph(req, "http.reverse_proxy." + "status_code") == 502`,
+			want: true,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+			defer cancel()
+
+			m := &MatchExpression{Expr: tc.expr}
+			if err := m.Provision(ctx); err != nil {
+				t.Fatalf("MatchExpression.Provision() error = %v", err)
+			}
+			if got := m.UsesResponseData(); got != tc.want {
+				t.Errorf("UsesResponseData() = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
