+// TestMatcherSetReferencesResponse verifies that only expressions reading
+// response data are classified as response conditions. Request-only
+// expressions (including escaped placeholders in string literals, similarly
+// named placeholders, and placeholders only known at evaluation time) must
+// not turn successful responses into retries
+func TestMatcherSetReferencesResponse(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		expr string
+		want bool
+	}{
+		{
+			name: "status code shorthand",
+			expr: `{http.reverse_proxy.status_code} == 200`,
+			want: true,
+		},
+		{
+			name: "status text shorthand",
+			expr: `{http.reverse_proxy.status_text} == "OK"`,
+			want: true,
+		},
+		{
+			name: "status code via ph call",
+			expr: `ph(req, "http.reverse_proxy.status_code") == 200`,
+			want: true,
+		},
+		{
+			name: "dynamic placeholder name",
+			expr: `ph(req, "http.reverse_proxy.status_" + "code") == 200`,
+			want: true,
+		},
+		{
+			name: "header",
+			expr: `{http.reverse_proxy.header.X-Retry} == "true"`,
+			want: true,
+		},
+		{
+			name: "latency",
+			expr: `{http.reverse_proxy.upstream.latency_ms} >= 0`,
+			want: true,
+		},
+		{
+			name: "request method",
+			expr: `{http.request.method} == "POST"`,
+			want: false,
+		},
+		{
+			name: "upstream host",
+			expr: `{http.reverse_proxy.upstream.host} == "127.0.0.1"`,
+			want: false,
+		},
+		{
+			name: "escaped response placeholder literal",
+			expr: `{http.request.uri.path} != "\{http.reverse_proxy.status_code}"`,
+			want: false,
+		},
+		{
+			name: "similarly named placeholder",
+			expr: `{http.reverse_proxy.status_codes} == null`,
+			want: false,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			matcherSet := caddyhttp.MatcherSet{newExpressionMatcher(t, tc.expr)}
+			if got := matcherSetReferencesResponse(matcherSet); got != tc.want {
+				t.Errorf("matcherSetReferencesResponse(%q) = %t, want %t", tc.expr, got, tc.want)
+			}
+		})
+	}
+}
+
+// TestRequestOnlyExpressionDoesNotRetryResponses verifies that an expression
+// matcher that only tests the request does not cause successful responses
+// to be retried (see the regression where every successful response was
+// retried for a matching request)
+func TestRequestOnlyExpressionDoesNotRetryResponses(t *testing.T) {
+	var hits atomic.Int32
+
+	// Server returns 200 OK and echoes the request body
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			http.Error(w, "read body: "+err.Error(), http.StatusInternalServerError)
+			return
+		}
+		w.WriteHeader(http.StatusOK)
+		w.Write(body)
+	}))
+	t.Cleanup(server.Close)
+
+	retryMatch := caddyhttp.MatcherSets{
+		caddyhttp.MatcherSet{
+			newExpressionMatcher(t, `{http.request.method} == "POST"`),
+		},
+	}
+
+	upstreams := []*Upstream{
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+		{Host: new(Host), Dial: server.Listener.Addr().String()},
+	}
+
+	h := minimalHandlerWithRetryMatch(2, retryMatch, upstreams...)
+
+	req := httptest.NewRequest(http.MethodPost, "http://example.com/order", strings.NewReader("order=1"))
+	req = prepareTestRequest(req)
+	rec := httptest.NewRecorder()
+
+	err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		return nil
+	}))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if hits.Load() != 1 {
+		t.Errorf("upstream hits: got %d, want 1 (should not retry successful responses)", hits.Load())
+	}
+	if rec.Code != http.StatusOK {
+		t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+	}
+	if rec.Body.String() != "order=1" {
+		t.Errorf("body: got %q, want %q", rec.Body.String(), "order=1")
+	}
+}
