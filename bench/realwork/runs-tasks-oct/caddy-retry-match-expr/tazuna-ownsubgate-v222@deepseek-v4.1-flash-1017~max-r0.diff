+func TestMatchExpressionPlaceholders(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		expr string
+		want []string
+	}{
+		{
+			name: "placeholder shorthand",
+			expr: `{http.reverse_proxy.status_code} == 200`,
+			want: []string{"http.reverse_proxy.status_code"},
+		},
+		{
+			name: "placeholder function call",
+			expr: `ph(req, "http.reverse_proxy.status_code") == 200`,
+			want: []string{"http.reverse_proxy.status_code"},
+		},
+		{
+			name: "multiple placeholders",
+			expr: `{http.request.method} == "POST" && {http.reverse_proxy.header.X-Retry} == "true"`,
+			want: []string{"http.request.method", "http.reverse_proxy.header.X-Retry"},
+		},
+		{
+			name: "escaped placeholder is a literal",
+			expr: `{http.request.uri.path} != "\{http.reverse_proxy.status_code}"`,
+			want: []string{"http.request.uri.path"},
+		},
+		{
+			name: "dynamic placeholder name",
+			expr: `ph(req, "http.reverse_proxy.status_" + "code") == 200`,
+			want: []string{""},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+			defer cancel()
+			m := &MatchExpression{Expr: tc.expr}
+			if err := m.Provision(ctx); err != nil {
+				t.Fatalf("provisioning %q: %v", tc.expr, err)
+			}
+			got := m.Placeholders()
+			if !slices.Equal(got, tc.want) {
+				t.Errorf("Placeholders() = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
