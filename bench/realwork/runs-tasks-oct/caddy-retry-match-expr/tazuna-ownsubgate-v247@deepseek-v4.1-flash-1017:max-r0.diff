+func TestMatchExpressionPlaceholders(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		expr     string
+		expected []string
+	}{
+		{
+			name:     "placeholder shorthand",
+			expr:     `{http.reverse_proxy.status_code} == 502`,
+			expected: []string{"http.reverse_proxy.status_code"},
+		},
+		{
+			name:     "direct placeholder call",
+			expr:     `ph(req, "http.reverse_proxy.status_code") == 502`,
+			expected: []string{"http.reverse_proxy.status_code"},
+		},
+		{
+			name:     "multiple placeholders",
+			expr:     `{http.request.method} == "POST" && {http.reverse_proxy.header.X-Retry} == "true"`,
+			expected: []string{"http.request.method", "http.reverse_proxy.header.X-Retry"},
+		},
+		{
+			name:     "escaped placeholder is a literal",
+			expr:     `{http.request.uri.path} != "\{http.reverse_proxy.status_code}"`,
+			expected: []string{"http.request.uri.path"},
+		},
+		{
+			name:     "placeholder name only known at evaluation time",
+			expr:     `ph(req, {http.request.header.X-Placeholder-Name}) == "true"`,
+			expected: []string{"", "http.request.header.X-Placeholder-Name"},
+		},
+		{
+			name:     "computed placeholder name",
+			expr:     `ph(req, "http.request." + "method") == "GET"`,
+			expected: []string{""},
+		},
+		{
+			name:     "no placeholders",
+			expr:     `1 == 1`,
+			expected: nil,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+			defer cancel()
+			m := &MatchExpression{Expr: tc.expr}
+			if err := m.Provision(ctx); err != nil {
+				t.Fatalf("Provision() error = %v", err)
+			}
+			actual := m.Placeholders()
+			if !slices.Equal(actual, tc.expected) {
+				t.Errorf("Placeholders() = %v, want %v", actual, tc.expected)
+			}
+		})
+	}
+}
