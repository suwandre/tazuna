+func TestMatchExpressionPlaceholders(t *testing.T) {
+	for i, tc := range []struct {
+		expr      string
+		wantNames []string
+	}{
+		{
+			expr:      `{http.request.method} == "POST"`,
+			wantNames: []string{"http.request.method"},
+		},
+		{
+			expr:      `{http.reverse_proxy.status_code} in [502, 503]`,
+			wantNames: []string{"http.reverse_proxy.status_code"},
+		},
+		{
+			expr:      `ph(req, "http.reverse_proxy.header.X-Retry") == "true"`,
+			wantNames: []string{"http.reverse_proxy.header.X-Retry"},
+		},
+		{
+			expr:      `ph(req, "http.request." + "method") == "POST"`,
+			wantNames: []string{""},
+		},
+		{
+			expr:      `path('/foo')`,
+			wantNames: nil,
+		},
+		{
+			expr:      `'\{http.reverse_proxy.status_code}' == ''`,
+			wantNames: nil,
+		},
+	} {
+		ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+		m := &MatchExpression{Expr: tc.expr}
+		err := m.Provision(ctx)
+		cancel()
+		if err != nil {
+			t.Errorf("Test %d: unexpected provisioning error for %q: %v", i, tc.expr, err)
+			continue
+		}
+		names := m.Placeholders()
+		if strings.Join(names, ",") != strings.Join(tc.wantNames, ",") {
+			t.Errorf("Test %d: names: got %v, want %v for %q", i, names, tc.wantNames, tc.expr)
+		}
+	}
+}
