+// TestMatcherSetReferencesResponse verifies that only expressions which
+// reference data that is populated after the upstream responds are treated as
+// response conditions. Everything else must remain a request condition.
+func TestMatcherSetReferencesResponse(t *testing.T) {
+	tests := []struct {
+		name    string
+		matcher caddyhttp.MatcherSet
+		want    bool
+	}{
+		{
+			name:    "status code",
+			matcher: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.reverse_proxy.status_code} == 502`)},
+			want:    true,
+		},
+		{
+			name:    "status text",
+			matcher: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.reverse_proxy.status_text} == "Bad Gateway"`)},
+			want:    true,
+		},
+		{
+			name:    "response header shorthand",
+			matcher: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.reverse_proxy.header.X-Retry} == "true"`)},
+			want:    true,
+		},
+		{
+			name:    "upstream latency",
+			matcher: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.reverse_proxy.upstream.latency} > 0`)},
+			want:    true,
+		},
+		{
+			name:    "upstream latency ms",
+			matcher: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.reverse_proxy.upstream.latency_ms} > 0`)},
+			want:    true,
+		},
+		{
+			name:    "direct ph response placeholder call",
+			matcher: caddyhttp.MatcherSet{newExpressionMatcher(t, `ph(req, "http.reverse_proxy.status_code") == 502`)},
+			want:    true,
+		},
+		{
+			name:    "dynamic placeholder name",
+			matcher: caddyhttp.MatcherSet{newExpressionMatcher(t, `ph(req, "http.reverse_proxy." + "status_code") == 502`)},
+			want:    true,
+		},
+		{
+			name:    "request method placeholder",
+			matcher: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.request.method} == "POST"`)},
+			want:    false,
+		},
+		{
+			name:    "request method matcher function",
+			matcher: caddyhttp.MatcherSet{newExpressionMatcher(t, `method("POST")`)},
+			want:    false,
+		},
+		{
+			name:    "pre-response upstream placeholder",
+			matcher: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.reverse_proxy.upstream.host} != ""`)},
+			want:    false,
+		},
+		{
+			name:    "response-like placeholder with different name",
+			matcher: caddyhttp.MatcherSet{newExpressionMatcher(t, `{http.reverse_proxy.status_codes} == ""`)},
+			want:    false,
+		},
+		{
+			name:    "escaped response placeholder in string literal",
+			matcher: caddyhttp.MatcherSet{newExpressionMatcher(t, `'\{http.reverse_proxy.status_code}' == '\{http.reverse_proxy.status_code}'`)},
+			want:    false,
+		},
+		{
+			name:    "non-expression matcher",
+			matcher: caddyhttp.MatcherSet{caddyhttp.MatchMethod{"POST"}},
+			want:    false,
+		},
+		{
+			name: "request expression mixed with method matcher",
+			matcher: caddyhttp.MatcherSet{
+				caddyhttp.MatchMethod{"POST"},
+				newExpressionMatcher(t, `{http.request.uri.path} == "/order"`),
+			},
+			want: false,
+		},
+		{
+			name: "response expression mixed with method matcher",
+			matcher: caddyhttp.MatcherSet{
+				caddyhttp.MatchMethod{"POST"},
+				newExpressionMatcher(t, `{http.reverse_proxy.status_code} == 502`),
+			},
+			want: true,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := matcherSetReferencesResponse(tc.matcher); got != tc.want {
+				t.Errorf("matcherSetReferencesResponse() = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
+
+// TestRequestOnlyExpressionDoesNotRetryResponses is a regression test for
+// lb_retry_match expressions that only test request data. They are request
+// conditions, so a successful upstream response must not be retried.
+func TestRequestOnlyExpressionDoesNotRetryResponses(t *testing.T) {
+	tests := []struct {
+		name string
+		expr string
+	}{
+		{
+			name: "request placeholder",
+			expr: `{http.request.method} == "POST"`,
+		},
+		{
+			name: "request matcher function",
+			expr: `method("POST")`,
+		},
+		{
+			name: "direct ph request placeholder call",
+			expr: `ph(req, "http.request.method") == "POST"`,
+		},
+		{
+			name: "pre-response upstream placeholder",
+			expr: `{http.reverse_proxy.upstream.host} != ""`,
+		},
+		{
+			name: "response-like placeholder with different name",
+			expr: `{http.reverse_proxy.status_codes} == ""`,
+		},
+		{
+			name: "escaped response placeholder in string literal",
+			expr: `'\{http.reverse_proxy.status_code}' == '\{http.reverse_proxy.status_code}'`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var hits atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				hits.Add(1)
+				body, err := io.ReadAll(r.Body)
+				if err != nil {
+					http.Error(w, err.Error(), http.StatusInternalServerError)
+					return
+				}
+				w.WriteHeader(http.StatusOK)
+				_, _ = w.Write(body)
+			}))
+			t.Cleanup(server.Close)
+
+			retryMatch := caddyhttp.MatcherSets{
+				caddyhttp.MatcherSet{
+					newExpressionMatcher(t, tc.expr),
+				},
+			}
+
+			upstreams := []*Upstream{
+				{Host: new(Host), Dial: server.Listener.Addr().String()},
+				{Host: new(Host), Dial: server.Listener.Addr().String()},
+			}
+
+			h := minimalHandlerWithRetryMatch(2, retryMatch, upstreams...)
+
+			req := httptest.NewRequest(http.MethodPost, "http://example.com/order", strings.NewReader("order=1"))
+			req = prepareTestRequest(req)
+			rec := httptest.NewRecorder()
+
+			err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+				return nil
+			}))
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+
+			if hits.Load() != 1 {
+				t.Errorf("upstream hits: got %d, want 1 (request-only expression must not retry a successful response)", hits.Load())
+			}
+			if rec.Code != http.StatusOK {
+				t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+			}
+			if rec.Body.String() != "order=1" {
+				t.Errorf("body: got %q, want %q", rec.Body.String(), "order=1")
+			}
+		})
+	}
+}
+
+// TestResponseRetryDirectPlaceholderCall verifies that a response condition
+// using ph(req, ...) directly (rather than the {placeholder} shorthand) still
+// triggers response-based retries.
+func TestResponseRetryDirectPlaceholderCall(t *testing.T) {
+	badServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusBadGateway)
+	}))
+	t.Cleanup(badServer.Close)
+
+	goodServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("ok"))
+	}))
+	t.Cleanup(goodServer.Close)
+
+	retryMatch := caddyhttp.MatcherSets{
+		caddyhttp.MatcherSet{
+			newExpressionMatcher(t, `ph(req, "http.reverse_proxy.status_code") in [502, 503]`),
+		},
+	}
+
+	// RoundRobin picks index 1 first, then 0
+	upstreams := []*Upstream{
+		{Host: new(Host), Dial: goodServer.Listener.Addr().String()},
+		{Host: new(Host), Dial: badServer.Listener.Addr().String()},
+	}
+
+	h := minimalHandlerWithRetryMatch(1, retryMatch, upstreams...)
+
+	req := httptest.NewRequest(http.MethodGet, "http://example.com/", nil)
+	req = prepareTestRequest(req)
+	rec := httptest.NewRecorder()
+
+	err := h.ServeHTTP(rec, req, caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		return nil
+	}))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if rec.Code != http.StatusOK {
+		t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+	}
+	if rec.Body.String() != "ok" {
+		t.Errorf("body: got %q, want %q", rec.Body.String(), "ok")
+	}
+}
