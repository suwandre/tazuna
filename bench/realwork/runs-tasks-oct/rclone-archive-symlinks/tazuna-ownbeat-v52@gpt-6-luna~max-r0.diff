@@ -2,14 +2,82 @@ package squashfs
 
 import (
 	"context"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
 	"testing"
 
 	_ "github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
 	fscache "github.com/rclone/rclone/fs/cache"
 	"github.com/stretchr/testify/assert"
 	"github.com/stretchr/testify/require"
 )
 
+// TestSquashfsSymlinks exposes image symlinks as translated link files when
+// --links is enabled and omits them otherwise.
+func TestSquashfsSymlinks(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+	ctx := context.Background()
+	dir := t.TempDir()
+	input := filepath.Join(dir, "input")
+	require.NoError(t, os.MkdirAll(input, 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "target.txt"), []byte("target"), 0600))
+	if err := os.Symlink("target.txt", filepath.Join(input, "link.txt")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	image := "links.sqfs"
+	output := filepath.Join(dir, image)
+	cmd := exec.Command(mksquashfs, input, output, "-noappend")
+	if got, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("mksquashfs failed: %v\n%s", err, got)
+	}
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, image, "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	assert.Len(t, entries, 1)
+	_, err = f.NewObject(ctx, "link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(linksCtx, localFs, image, "", "")
+	require.NoError(t, err)
+	entries, err = f.List(linksCtx, "")
+	require.NoError(t, err)
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.Equal(t, []string{"link.txt.rclonelink", "target.txt"}, names)
+
+	link, err := f.NewObject(linksCtx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("target.txt")), link.Size())
+	rc, err := link.Open(linksCtx, &fs.SeekOption{Offset: 3})
+	require.NoError(t, err)
+	got, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "get.txt", string(got))
+	rc, err = link.Open(linksCtx, &fs.RangeOption{Start: 3, End: 5})
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "get", string(got))
+	_, err = f.NewObject(linksCtx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+}
