+// TestZipSymlinkCopyDoesNotEscape verifies that archive entries nested below a
+// symlink cannot be copied through the link to a path outside the destination.
+func TestZipSymlinkCopyDoesNotEscape(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	probeLink := filepath.Join(dir, "symlink-probe")
+	if err := os.Symlink("target", probeLink); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	require.NoError(t, os.Remove(probeLink))
+	name := writeSymlinkZip(t, dir, "evil.zip", "src/link", "../../outside", "src/link/escaped.txt")
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	src, err := New(linksCtx, localFs, name, "", "")
+	require.NoError(t, err)
+	dstPath := filepath.Join(dir, "destination")
+	dst, err := localbackend.NewFs(linksCtx, "local", dstPath, configmap.Simple{})
+	require.NoError(t, err)
+	require.NoError(t, rclonesync.CopyDir(linksCtx, dst, src, false))
+
+	linkPath := filepath.Join(dstPath, "src", "link")
+	target, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, "../../outside", target)
+	_, err = os.Stat(filepath.Join(dir, "outside", "escaped.txt"))
+	assert.True(t, os.IsNotExist(err), "hostile archive wrote outside destination: %v", err)
+}
+
+// writeSymlinkZip builds a ZIP with one symbolic link and an optional member
+// beneath it.
+func writeSymlinkZip(t *testing.T, dir, name, link, target, child string) string {
+	t.Helper()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	header := &zip.FileHeader{Name: link}
+	header.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = io.WriteString(w, target)
+	require.NoError(t, err)
+	if child != "" {
+		w, err = zw.Create(child)
+		require.NoError(t, err)
+		_, err = io.WriteString(w, "malicious member")
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	archivePath := filepath.Join(dir, name)
+	require.NoError(t, os.WriteFile(archivePath, buf.Bytes(), 0600))
+	return name
+}
