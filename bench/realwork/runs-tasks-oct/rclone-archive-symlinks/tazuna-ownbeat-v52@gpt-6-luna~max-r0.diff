+	_, err = f.NewObject(linksCtx, "src/link.txt/escaped.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	link, err := f.NewObject(linksCtx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("../outside")), link.Size())
+	rc, err := link.Open(linksCtx, &fs.SeekOption{Offset: 3})
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "outside", string(got))
+	rc, err = link.Open(linksCtx, &fs.RangeOption{Start: 3, End: 5})
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "out", string(got))
+
+	regular, err := f.NewObject(linksCtx, "src/regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("regular contents")), regular.Size())
+	rc, err = regular.Open(linksCtx)
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "regular contents", string(got))
+}
+
+// mustOpen opens an object for a short assertion and registers its close.
+func mustOpen(t *testing.T, ctx context.Context, o fs.Object) io.ReadCloser {
+	t.Helper()
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	t.Cleanup(func() { assert.NoError(t, rc.Close()) })
+	return rc
+}
