+// isSymlink checks if the file header represents a symlink
+// Unix symlinks have the file type set to 0o120000 in ExternalAttrs
+// when the creator version is Unix (version >> 8 == 3)
+func isSymlink(fh *zip.FileHeader) bool {
+	if (fh.CreatorVersion >> 8) != 3 { // not Unix
+		return false
+	}
+	// Extract the file mode from the upper 16 bits of ExternalAttrs
+	mode := os.FileMode(fh.ExternalAttrs >> 16)
+	// Check if the file type is a symlink (0o120000)
+	return (mode & 0o170000) == 0o120000
+}
