 // NewObject finds the Object at remote.
 func (f *Fs) NewObject(ctx context.Context, remote string) (o fs.Object, err error) {
 	defer log.Trace(f, "remote=%q", remote)("obj=%v, err=%v", &o, &err)
+	defer recoverParsePanic(&err)
 
 	if f.file != "" && remote != f.file {
 		return nil, fs.ErrorObjectNotFound
 	}
+
+	// Check if this is a symlink reference (ends with .rclonelink)
+	isSymlinkRef := strings.HasSuffix(remote, fs.LinkSuffix)
+	if isSymlinkRef {
+		if !f.links {
+			return nil, fs.ErrorObjectNotFound
+		}
+		// Strip the suffix to get the actual symlink name
+		remote = strings.TrimSuffix(remote, fs.LinkSuffix)
+	}
+
 	nativePath, err := f.toNative(remote)
 	if err != nil {
 		return nil, err
 	}
+
+	// If this is a symlink reference, look it up as a symlink
+	if isSymlinkRef {
+		dir, leaf := path.Split(nativePath)
+		dir = strings.TrimRight(dir, "/")
+		leaf = strings.Trim(leaf, "/")
+
+		fis, err := f.sqfs.ReadDir(toIOFS(dir))
+		if err != nil {
+			return nil, fs.ErrorObjectNotFound
+		}
+
+		for _, fi := range fis {
+			if fi.Name() == leaf && fi.Type()&os.ModeSymlink != 0 {
+				// Read the symlink target
+				target, err := f.readSymlink(dir, fi.Name())
+				if err != nil {
+					return nil, err
+				}
+				info, err := fi.Info()
+				if err != nil {
+					return nil, fmt.Errorf("error reading item %q: %w", fi.Name(), err)
+				}
+				return &Object{
+					fs:      f,
+					remote:  remote + fs.LinkSuffix,
+					size:    int64(len(target)),
+					modTime: info.ModTime(),
+				}, nil
+			}
+		}
+		return nil, fs.ErrorObjectNotFound
+	}
+
 	return f.newObjectNative(nativePath)
 }
 
