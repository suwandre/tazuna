diff --git a/backend/archive/zip/zip_internal_test.go b/backend/archive/zip/zip_internal_test.go
index 6aff03c..810ffbe 100644
--- a/backend/archive/zip/zip_internal_test.go
+++ b/backend/archive/zip/zip_internal_test.go
@@ -170,3 +170,158 @@ func TestListCacheNotAliased(t *testing.T) {
 	}
 	assert.Equal(t, []string{"a.txt", "b.txt", "c.txt"}, remotes)
 }
+
+// writeZipWithSymlink builds a zip file with regular files and symlinks in dir and returns its leaf name.
+func writeZipWithSymlink(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+
+	// Add a regular file
+	w, err := zw.Create("file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("content of file"))
+	require.NoError(t, err)
+
+	// Add a symlink using Unix file mode
+	header := &zip.FileHeader{
+		Name:             "link.txt",
+		Method:           zip.Store,
+		ExternalAttrs:    (0o120777) << 16, // Unix symlink mode (0o120777) in upper 16 bits
+		CreatorVersion:   (3 << 8) | 20,   // Unix creator version
+	}
+	w, err = zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt")) // Target of the symlink
+	require.NoError(t, err)
+
+	// Add another regular file to distinguish from symlinks
+	w, err = zw.Create("another.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("content"))
+	require.NoError(t, err)
+
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// Symlinks should be skipped by default unless --links is enabled.
+func TestSymlinksSkippedByDefault(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipWithSymlink(t, dir, "test.zip")
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	// Without --links flag
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	remotes := allRemotes(t, f)
+	// Should have file.txt and another.txt, but not link.txt
+	assert.ElementsMatch(t, []string{"another.txt", "file.txt"}, remotes)
+	assert.NotContains(t, remotes, "link.txt")
+	assert.NotContains(t, remotes, "link.txt.rclonelink")
+}
+
+// Symlinks should be exposed with .rclonelink suffix when --links is enabled.
+func TestSymlinksExposedWithLinks(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	name := writeZipWithSymlink(t, dir, "test.zip")
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	// With --links flag
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	remotes := allRemotes(t, f)
+	// Should have file.txt, another.txt, and link.txt.rclonelink
+	assert.ElementsMatch(t, []string{"another.txt", "file.txt", "link.txt.rclonelink"}, remotes)
+}
+
+// When --links is enabled, symlink content should be readable as the target path.
+func TestSymlinkReadContent(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	name := writeZipWithSymlink(t, dir, "test.zip")
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	// Get the symlink object
+	linkObj, err := f.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+
+	// Size should be length of the target
+	expectedSize := int64(len("file.txt"))
+	assert.Equal(t, expectedSize, linkObj.Size())
+
+	// Read the content
+	rc, err := linkObj.Open(ctx)
+	require.NoError(t, err)
+	defer rc.Close()
+
+	buf := make([]byte, linkObj.Size())
+	n, err := rc.Read(buf)
+	require.NoError(t, err)
+	require.Equal(t, expectedSize, int64(n))
+	assert.Equal(t, "file.txt", string(buf))
+}
+
+// A hostile archive with a symlink pointing above the root should not
+// allow copying to write outside the destination.
+func TestSymlinkSlipProtection(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+
+	// Create a zip with a symlink pointing above the root
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+
+	// Normal file inside a directory
+	w, err := zw.Create("dir/file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("content"))
+	require.NoError(t, err)
+
+	// Symlink pointing above the root
+	header := &zip.FileHeader{
+		Name:             "dir/../../escape.txt",
+		Method:           zip.Store,
+		ExternalAttrs:    (0o120777) << 16,
+		CreatorVersion:   (3 << 8) | 20,
+	}
+	w, err = zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("/etc/passwd"))
+	require.NoError(t, err)
+
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(dir, "escape.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, "escape.zip", "", "")
+	require.NoError(t, err)
+
+	remotes := allRemotes(t, f)
+	// The escaping symlink should be filtered out by sanitize.Path
+	assert.Contains(t, remotes, "dir/file.txt")
+	// No escaping symlink should be exposed
+	for _, remote := range remotes {
+		assert.False(t, strings.Contains(remote, ".."),
+			"escaping remote exposed: %q", remote)
+	}
+}
