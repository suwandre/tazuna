+// readSymlink reads the target of a symlink in the squashfs image
+func (f *Fs) readSymlink(nativeDir string, name string) (string, error) {
+	defer func() {
+		if r := recover(); r != nil {
+			// fs.Errorf will be called by caller
+		}
+	}()
+
+	nativePath := path.Join(nativeDir, name)
+	rc, err := f.sqfs.Open(toIOFS(nativePath))
+	if err != nil {
+		return "", err
+	}
+	defer rc.Close()
+
+	// Read symlink target (usually small, so read up to 4KB)
+	buf := make([]byte, 4096)
+	n, err := rc.Read(buf)
+	if err != nil && err != io.EOF {
+		return "", err
+	}
+
+	return string(buf[:n]), nil
+}
