+func TestArchiveSymlinks(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks are not supported on Windows")
+	}
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+	ctxNoLinks, ciNoLinks := fs.AddConfig(context.Background())
+	ciNoLinks.Links = false
+	ctxLinks, ciLinks := fs.AddConfig(context.Background())
+	ciLinks.Links = true
+
+	base := t.TempDir()
+	input := filepath.Join(base, "input")
+	require.NoError(t, os.Mkdir(input, 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "regular.rclonelink"), []byte("regular data"), 0600))
+	linkTarget := "target.txt"
+	if err := os.Symlink(linkTarget, filepath.Join(input, "link")); err != nil {
+		t.Skipf("symlinks are not available: %v", err)
+	}
+	image := filepath.Join(base, "links.sqfs")
+	cmd := exec.Command(mksquashfs, input, image, "-noappend", "-processors", "1", "-quiet")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("mksquashfs failed: %v\n%s", err, output)
+	}
+
+	localFs, err := fscache.Get(ctxNoLinks, base)
+	require.NoError(t, err)
+	f, err := New(ctxNoLinks, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctxNoLinks, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "regular.rclonelink", entries[0].Remote())
+	_, err = f.NewObject(ctxNoLinks, "link.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	f, err = New(ctxLinks, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = f.List(ctxLinks, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 2)
+	remotes := []string{entries[0].Remote(), entries[1].Remote()}
+	sort.Strings(remotes)
+	assert.Equal(t, []string{"link.rclonelink", "regular.rclonelink"}, remotes)
+
+	link, err := f.NewObject(ctxLinks, "link.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len(linkTarget)), link.Size())
+	read := func(options ...fs.OpenOption) string {
+		rc, err := link.Open(ctxLinks, options...)
+		require.NoError(t, err)
+		defer func() { require.NoError(t, rc.Close()) }()
+		data, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		return string(data)
+	}
+	assert.Equal(t, linkTarget, read())
+	assert.Equal(t, "rget.txt", read(&fs.SeekOption{Offset: 2}))
+	assert.Equal(t, "arg", read(&fs.RangeOption{Start: 1, End: 3}))
+
+	regular, err := f.NewObject(ctxLinks, "regular.rclonelink")
+	require.NoError(t, err)
+	rc, err := regular.Open(ctxLinks)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "regular data", string(data))
+
+	single, err := New(ctxLinks, localFs, "links.sqfs", "", "link.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	singleEntries, err := single.List(ctxLinks, "")
+	require.NoError(t, err)
+	require.Len(t, singleEntries, 1)
+	assert.Equal(t, "link.rclonelink", singleEntries[0].Remote())
+	_, err = single.NewObject(ctxLinks, "link.rclonelink")
+	assert.NoError(t, err)
+}
