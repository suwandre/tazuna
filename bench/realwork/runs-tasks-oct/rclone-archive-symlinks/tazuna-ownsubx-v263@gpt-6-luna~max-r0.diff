+	if runtime.GOOS == "windows" {
+		t.Skip("symlink creation is not available on Windows")
+	}
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "hostile.zip",
+		// Put the child first to ensure filtering doesn't depend on ZIP order.
+		zipTestEntry{name: "link/attack.txt", data: "pwned", mode: 0644},
+		zipTestEntry{name: "link", data: "../outside", mode: os.ModeSymlink | 0777},
+	)
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.rclonelink", entries[0].Remote())
+	_, err = f.NewObject(ctx, "link/attack.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// A member beneath a symlink must not be able to redirect a copy
+	// outside the chosen destination root.
+	outside := filepath.Join(dir, "outside")
+	require.NoError(t, os.Mkdir(outside, 0700))
+	marker := filepath.Join(outside, "marker")
+	require.NoError(t, os.WriteFile(marker, []byte("safe"), 0600))
+	destination, err := cache.Get(ctx, filepath.Join(dir, "out"))
+	require.NoError(t, err)
+	require.NoError(t, fssync.CopyDir(ctx, destination, f, false))
+	got, err := os.ReadFile(marker)
+	require.NoError(t, err)
+	assert.Equal(t, "safe", string(got))
+	_, err = os.Stat(filepath.Join(outside, "attack.txt"))
+	assert.True(t, os.IsNotExist(err), "hostile archive wrote outside the destination")
+	linkTarget, err := os.Readlink(filepath.Join(dir, "out", "link"))
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", linkTarget)
+}
