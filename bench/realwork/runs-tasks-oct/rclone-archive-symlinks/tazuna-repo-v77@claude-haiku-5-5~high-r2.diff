+// writeZipWithLinks writes a zip in dir holding symlinks, including one
+// whose suffixed name is already taken by a regular file.
+func writeZipWithLinks(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	add := func(fh *zip.FileHeader, content string) {
+		w, err := zw.CreateHeader(fh)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	add(&zip.FileHeader{Name: "dir/file.txt"}, "hello world\n")
+	link := &zip.FileHeader{Name: "dir/link.txt"}
+	link.SetMode(os.ModeSymlink | 0777)
+	add(link, "file.txt")
+	collide := &zip.FileHeader{Name: "dir/collide"}
+	collide.SetMode(os.ModeSymlink | 0777)
+	add(collide, "file.txt")
+	add(&zip.FileHeader{Name: "dir/collide.rclonelink"}, "regular file\n")
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
