+
+// OpenLinkTarget returns the target path of a symlink in an archive as a
+// reader, honouring range and seek options as for a file of that size.
+//
+// The target is only ever read as text. It is never resolved against
+// the filesystem, so a link pointing outside the archive is harmless here.
+func OpenLinkTarget(target string, options ...fs.OpenOption) io.ReadCloser {
+	offset, limit := int64(0), int64(-1)
+	for _, option := range options {
+		switch x := option.(type) {
+		case *fs.SeekOption:
+			offset = x.Offset
+		case *fs.RangeOption:
+			offset, limit = x.Decode(int64(len(target)))
+		}
+	}
+	offset = min(max(offset, 0), int64(len(target)))
+	return readers.NewLimitedReadCloser(io.NopCloser(strings.NewReader(target[offset:])), limit)
+}
