+// A symlink pointing outside the destination, followed by a member
+// written "through" it, must not let a copy write outside the destination.
+func TestArchiveLinksCopyEscape(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	outside := t.TempDir()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	link := &zip.FileHeader{Name: "escape"}
+	link.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(link)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(outside))
+	require.NoError(t, err)
+	w, err = zw.Create("escape/pwned.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("pwned"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(t.TempDir(), "hostile.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dst, err := cache.Get(ctx, t.TempDir())
+	require.NoError(t, err)
+	// The copy may fail, but it must not write outside dst
+	_ = sync.CopyDir(ctx, dst, src, false)
+
+	_, err = os.Stat(filepath.Join(outside, "pwned.txt"))
+	assert.True(t, os.IsNotExist(err), "copy wrote outside the destination")
+}
