 )
 
+func TestSymlinks(t *testing.T) {
+	baseCtx := context.Background()
+	localFs, err := fscache.Get(baseCtx, "testdata")
+	require.NoError(t, err)
+
+	ctx, ci := fs.AddConfig(baseCtx)
+	ci.Links = false
+	withoutLinks, err := New(ctx, localFs, "symlinks.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := withoutLinks.List(ctx, "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "regular.rclonelink"}, remotes)
+	_, err = withoutLinks.NewObject(ctx, "link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, linksConfig := fs.AddConfig(baseCtx)
+	linksConfig.Links = true
+	withLinks, err := New(linksCtx, localFs, "symlinks.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 3)
+	link, err := withLinks.NewObject(linksCtx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "link.txt.rclonelink", link.Remote())
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+
+	for _, tc := range []struct {
+		options []fs.OpenOption
+		want    string
+	}{
+		{nil, "file.txt"},
+		{[]fs.OpenOption{&fs.SeekOption{Offset: 2}}, "le.txt"},
+		{[]fs.OpenOption{&fs.RangeOption{Start: 1, End: 4}}, "ile."},
+	} {
+		rc, err := link.Open(linksCtx, tc.options...)
+		require.NoError(t, err)
+		got, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, tc.want, string(got))
+	}
+
+	regular, err := withLinks.NewObject(linksCtx, "regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("ordinary rclonelink file\n")), regular.Size())
+}
