+func writeSymlinkZip(t *testing.T, dir, name string, entries map[string]struct {
+	mode os.FileMode
+	data string
+}) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for name, entry := range entries {
+		header := &zip.FileHeader{Name: name}
+		header.SetMode(entry.mode)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.data))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+func TestReadZipSymlinks(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	name := writeSymlinkZip(t, dir, "links.zip", map[string]struct {
+		mode os.FileMode
+		data string
+	}{
+		"src/file.txt":           {mode: 0644, data: "file contents"},
+		"src/link.txt":           {mode: os.ModeSymlink | 0777, data: "file.txt"},
+		"src/regular.rclonelink": {mode: 0644, data: "ordinary file"},
+		"bad/pwned.txt":          {mode: 0644, data: "must not be copied"},
+		"bad/":                   {mode: os.ModeDir | 0755},
+		"bad":                    {mode: os.ModeSymlink | 0777, data: "../outside"},
+	})
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	want := []string{"bad.rclonelink", "src/file.txt", "src/link.txt.rclonelink", "src/regular.rclonelink"}
+	assert.Equal(t, want, allRemotes(t, f))
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = f.NewObject(ctx, "bad/pwned.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	obj, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), obj.Size())
+	assert.Equal(t, "src/link.txt.rclonelink", obj.Remote())
+	for _, tc := range []struct {
+		options []fs.OpenOption
+		want    string
+	}{
+		{nil, "file.txt"},
+		{[]fs.OpenOption{&fs.SeekOption{Offset: 2}}, "le.txt"},
+		{[]fs.OpenOption{&fs.RangeOption{Start: 1, End: 4}}, "ile."},
+	} {
+		rc, err := obj.Open(ctx, tc.options...)
+		require.NoError(t, err)
+		got, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, tc.want, string(got))
+	}
+
+	regular, err := f.NewObject(ctx, "src/regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("ordinary file")), regular.Size())
+	rc, err := regular.Open(ctx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ordinary file", string(data))
+
+	// Copying the entries must create the translated symlink and must not
+	// follow the hostile symlink to write outside the destination.
+	copyRoot := t.TempDir()
+	dstPath := filepath.Join(copyRoot, "out")
+	outsidePath := filepath.Join(copyRoot, "outside")
+	require.NoError(t, os.Mkdir(dstPath, 0700))
+	require.NoError(t, os.Mkdir(outsidePath, 0700))
+	dst, err := cache.Get(ctx, dstPath)
+	require.NoError(t, err)
+	require.NoError(t, syncpkg.CopyDir(ctx, dst, f, false))
+	linkInfo, err := os.Lstat(filepath.Join(dstPath, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.True(t, linkInfo.Mode()&os.ModeSymlink != 0)
+	target, err := os.Readlink(filepath.Join(dstPath, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+	assert.NoFileExists(t, filepath.Join(dstPath, "bad", "pwned.txt"))
+	assert.NoFileExists(t, filepath.Join(outsidePath, "pwned.txt"))
+}
