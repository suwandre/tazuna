+func writeZipWithSymlinks(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for entryName, content := range map[string]string{
+		"src/file.txt":                "hello",
+		"src/link.txt":                "file.txt",
+		"src/regular" + fs.LinkSuffix: "ordinary file",
+	} {
+		header := &zip.FileHeader{Name: entryName, Method: zip.Deflate}
+		if strings.HasSuffix(entryName, "link.txt") {
+			header.SetMode(os.ModeSymlink | 0777)
+		}
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
