+func TestZipSymlinkEscapeBlocked(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks not applicable on Windows")
+	}
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	archiveDir := t.TempDir()
+	evilDir := t.TempDir()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	linkHeader := &zip.FileHeader{Name: "pwn", Method: zip.Deflate}
+	linkHeader.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(evilDir))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("pwned"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	archiveName := filepath.Join(archiveDir, "evil.zip")
+	require.NoError(t, os.WriteFile(archiveName, buf.Bytes(), 0600))
+
+	archiveFs, err := cache.Get(ctx, archiveDir)
+	require.NoError(t, err)
+	src, err := New(ctx, archiveFs, "evil.zip", "", "")
+	require.NoError(t, err)
+	destDir := t.TempDir()
+	dst, err := cache.Get(ctx, destDir)
+	require.NoError(t, err)
+
+	link, err := src.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, link.Remote(), link)
+	require.NoError(t, err)
+	linkTarget, err := os.Readlink(filepath.Join(destDir, "pwn"))
+	require.NoError(t, err)
+	assert.Equal(t, evilDir, linkTarget)
+
+	member, err := src.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, member.Remote(), member)
+	require.Error(t, err)
+	_, err = os.Stat(filepath.Join(evilDir, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "archive member escaped the destination")
+}
