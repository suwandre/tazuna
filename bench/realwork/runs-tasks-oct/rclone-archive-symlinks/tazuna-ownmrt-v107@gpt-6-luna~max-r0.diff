+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"README.md", "regular" + fs.LinkSuffix}, remotes)
+	_, err = f.NewObject(ctx, "goodlink"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	localFs, err = fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+	f, err = New(ctx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = f.List(ctx, "")
+	require.NoError(t, err)
+	remotes = remotes[:0]
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"README.md", "emptylink" + fs.LinkSuffix, "goodlink" + fs.LinkSuffix, "regular" + fs.LinkSuffix}, remotes)
+
+	linkName := "goodlink" + fs.LinkSuffix
+	o, err := f.NewObject(ctx, linkName)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("README.md")), o.Size())
+	assert.Equal(t, linkName, o.Remote())
+	rc, err := o.Open(ctx, &fs.RangeOption{Start: 1, End: 4})
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "EADM", string(data))
+
+	_, err = f.NewObject(ctx, "goodlink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	regular, err := f.NewObject(ctx, "regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	rc, err = regular.Open(ctx)
+	require.NoError(t, err)
+	data, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ordinary file\n", string(data))
+}
