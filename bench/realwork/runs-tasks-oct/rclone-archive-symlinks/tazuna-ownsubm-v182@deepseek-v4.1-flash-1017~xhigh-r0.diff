+
+// Copying a symlink with -l/--links to a destination which supports
+// symlinks recreates it.
+func TestSymlinkCopy(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	f := testdataFs(t, "symlinks.sqfs", "", true)
+	dst, err := fscache.Get(ctx, t.TempDir())
+	require.NoError(t, err)
+
+	o, err := f.NewObject(ctx, "sub/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, "link.txt"+fs.LinkSuffix, o)
+	require.NoError(t, err)
+
+	link := filepath.Join(dst.Root(), "link.txt")
