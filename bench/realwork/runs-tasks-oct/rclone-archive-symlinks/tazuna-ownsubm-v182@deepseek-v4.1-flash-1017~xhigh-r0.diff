+
+// zipEntry describes an entry to write into a test zip file. A symlink
+// entry's contents are its target.
+type zipEntry struct {
+	mode    os.FileMode
+	content string
+}
+
+// writeEntryZip builds a zip file in dir with the entries given and
+// returns its leaf name.
+func writeEntryZip(t *testing.T, dir, name string, entries map[string]zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for entryName, entry := range entries {
+		hdr := &zip.FileHeader{Name: entryName, Method: zip.Deflate}
+		hdr.SetMode(entry.mode)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// symlinkEntries is the archive used by the symlink tests: a regular
+// file, a symlink to it and a regular file whose name ends in the link
+// suffix.
+func symlinkEntries() map[string]zipEntry {
+	return map[string]zipEntry{
+		"src/file.txt":        {0644, "hello"},
+		"src/link.txt":        {os.ModeSymlink | 0777, "file.txt"},
+		"src/real.rclonelink": {0644, "not a link"},
+	}
+}
+
+// captureLog redirects rclone's log into a buffer for the test.
+func captureLog(t *testing.T) *bytes.Buffer {
+	var buf bytes.Buffer
+	fs.SetLogger(slog.NewTextHandler(&buf, &slog.HandlerOptions{Level: slog.LevelDebug}))
+	t.Cleanup(func() { fs.SetLogger(slog.NewTextHandler(io.Discard, nil)) })
+	return &buf
+}
+
+// listRemotes lists dir and returns the remotes and sizes of the objects.
+func listRemotes(t *testing.T, f fs.Fs, dir string) map[string]int64 {
+	entries, err := f.List(context.Background(), dir)
+	require.NoError(t, err)
+	remotes := make(map[string]int64, len(entries))
+	for _, entry := range entries {
+		if o, ok := entry.(fs.Object); ok {
+			remotes[o.Remote()] = o.Size()
+		} else {
+			remotes[entry.Remote()] = -1
+		}
+	}
+	return remotes
+}
+
+// withLinks returns a context with -l/--links set.
+func withLinks(t *testing.T) context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	return ctx
+}
+
+// Symlinks are only exposed with -l/--links, and then under their name
+// plus the link suffix with the size of their target.
+func TestSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	name := writeEntryZip(t, dir, "links.zip", symlinkEntries())
+	localFs, err := cache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	t.Run("WithoutLinks", func(t *testing.T) {
+		log := captureLog(t)
+		f, err := New(context.Background(), localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Contains(t, log.String(), "-l/--links")
+		assert.Equal(t, map[string]int64{
+			"src/file.txt":        5,
+			"src/real.rclonelink": 10,
+		}, listRemotes(t, f, "src"))
+		_, err = f.NewObject(context.Background(), "src/link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(context.Background(), "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("WithLinks", func(t *testing.T) {
+		ctx := withLinks(t)
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, map[string]int64{
+			"src/file.txt":                 5,
+			"src/link.txt" + fs.LinkSuffix: 8,
+			"src/real.rclonelink":          10,
+		}, listRemotes(t, f, "src"))
+
+		// Listing and NewObject must agree on the names which exist
+		for remote, size := range listRemotes(t, f, "src") {
+			o, err := f.NewObject(ctx, remote)
+			require.NoError(t, err, remote)
+			assert.Equal(t, remote, o.Remote())
+			assert.Equal(t, size, o.Size())
+		}
+
+		// Opening the link reads back its target, honouring ranges
+		o, err := f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", readAll(t, o))
+		assert.Equal(t, "le.txt", readAll(t, o, &fs.SeekOption{Offset: 2}))
+		assert.Equal(t, "le", readAll(t, o, &fs.RangeOption{Start: 2, End: 3}))
+		assert.Equal(t, "", readAll(t, o, &fs.RangeOption{Start: 100, End: -1}))
+	})
+
+	t.Run("RootIsLink", func(t *testing.T) {
+		ctx := withLinks(t)
+		f, err := New(ctx, localFs, name, "", "src/link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorIsFile)
+		assert.Equal(t, map[string]int64{
+			"link.txt" + fs.LinkSuffix: 8,
+		}, listRemotes(t, f, ""))
+		o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", readAll(t, o))
+	})
+}
+
+// A regular archive member whose name ends in the link suffix must stay
+// a regular file, even with -l/--links.
+func TestSymlinkSuffixRegularFile(t *testing.T) {
+	ctx := withLinks(t)
+	dir := t.TempDir()
+	name := writeEntryZip(t, dir, "links.zip", map[string]zipEntry{
+		"real.rclonelink": {0644, "not a link"},
+	})
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	o, err := f.NewObject(ctx, "real.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("not a link")), o.Size())
+	assert.Equal(t, "not a link", readAll(t, o))
+}
+
+// readAll reads the whole object applying the options passed.
+func readAll(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	defer func() { require.NoError(t, rc.Close()) }()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(data)
+}
+
+// A hostile archive must not be able to make a copy write outside the
+// destination: it contains a symlink pointing above the root plus a
+// member "inside" it.
+func TestSymlinkEscapeCopy(t *testing.T) {
+	ctx := withLinks(t)
+	dir := t.TempDir()
+	outside := t.TempDir()
+	name := writeEntryZip(t, dir, "hostile.zip", map[string]zipEntry{
+		"pwn":          {os.ModeSymlink | 0777, outside},
+		"pwn/authkeys": {0644, "PWNED"},
+	})
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	src, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	dst, err := cache.Get(ctx, t.TempDir())
+	require.NoError(t, err)
+
+	// Copy the symlink, then the member "inside" it
+	link, err := src.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, "pwn"+fs.LinkSuffix, link)
+	require.NoError(t, err)
+
+	// The symlink is recreated faithfully on a destination which
+	// supports them
+	dstPath := filepath.Join(dst.Root(), "pwn")
+	fi, err := os.Lstat(dstPath)
+	require.NoError(t, err)
+	require.NotZero(t, fi.Mode()&os.ModeSymlink, "symlink should be recreated")
+	target, err := os.Readlink(dstPath)
+	require.NoError(t, err)
+	assert.Equal(t, outside, target)
+	file, err := src.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, "pwn/authkeys", file)
+	require.Error(t, err, "writing through a planted symlink should be refused")
+
+	_, err = os.Stat(filepath.Join(outside, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination")
+}
