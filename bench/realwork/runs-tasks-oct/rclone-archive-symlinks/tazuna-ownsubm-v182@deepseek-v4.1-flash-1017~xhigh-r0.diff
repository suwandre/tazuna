+// symlinks.sqfs contains a regular file (real.rclonelink) whose name
+// ends in the link suffix, a symlink (toplink.txt) and a subdirectory
+// holding a regular file (file.txt) and a symlink (link.txt). It was
+// made with
+//
+//	mksquashfs src symlinks.sqfs -noappend -comp gzip -b 4096 \
+//	    -no-exports -no-xattrs -all-time 1600000000
+//
+// Symlinks are only exposed with -l/--links, and then under their name
+// plus the link suffix with the size of their target.
+func TestSymlinks(t *testing.T) {
+	t.Run("WithoutLinks", func(t *testing.T) {
+		log := captureLog(t)
+		f := testdataFs(t, "symlinks.sqfs", "", false)
+		assert.Equal(t, map[string]int64{
+			"real.rclonelink": 11,
+		}, listObjects(t, f, ""))
+		assert.Contains(t, log.String(), "-l/--links")
+		_, err := f.NewObject(context.Background(), "toplink.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(context.Background(), "sub/link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("WithLinks", func(t *testing.T) {
+		ctx := context.Background()
+		f := testdataFs(t, "symlinks.sqfs", "", true)
+		want := map[string]int64{
+			"real.rclonelink":             11,
+			"toplink.txt" + fs.LinkSuffix: 12,
+		}
+		assert.Equal(t, want, listObjects(t, f, ""))
+		assert.Equal(t, map[string]int64{
+			"sub/file.txt":                 6,
+			"sub/link.txt" + fs.LinkSuffix: 8,
+		}, listObjects(t, f, "sub"))
+
+		// Listing and NewObject must agree on the names which exist
+		for _, dir := range []string{"", "sub"} {
+			for remote, size := range listObjects(t, f, dir) {
+				o, err := f.NewObject(ctx, remote)
+				require.NoError(t, err, remote)
+				assert.Equal(t, remote, o.Remote())
+				assert.Equal(t, size, o.Size())
+			}
+		}
+
+		// A symlink isn't found under its name without the suffix
+		_, err := f.NewObject(ctx, "sub/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// Opening the link reads back its target, honouring ranges
+		o, err := f.NewObject(ctx, "sub/link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", readAll(t, o))
+		assert.Equal(t, "le.txt", readAll(t, o, &fs.SeekOption{Offset: 2}))
+		assert.Equal(t, "le", readAll(t, o, &fs.RangeOption{Start: 2, End: 3}))
+		assert.Equal(t, "", readAll(t, o, &fs.RangeOption{Start: 100, End: -1}))
+	})
+}
