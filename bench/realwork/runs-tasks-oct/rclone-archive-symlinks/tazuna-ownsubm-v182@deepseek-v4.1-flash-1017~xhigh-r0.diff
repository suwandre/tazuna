+
+// zipEntry describes an entry to write into a test zip file. A symlink
+// entry's body is its target.
+type zipEntry struct {
+	mode os.FileMode
+	body string
+}
+
+// writeZipEntries writes a zip file at path with the entries given.
+func writeZipEntries(t *testing.T, path string, entries map[string]zipEntry) {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for name, entry := range entries {
+		hdr := &zip.FileHeader{Name: name, Method: zip.Deflate}
+		hdr.SetMode(entry.mode)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(path, buf.Bytes(), 0600))
+}
+
+// TestArchiveSymlinkCopy checks that a symlink in a zip or squashfs
+// archive is exposed with -l/--links and recreated by a copy.
+func TestArchiveSymlinkCopy(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	zipPath := filepath.Join(t.TempDir(), "links.zip")
+	writeZipEntries(t, zipPath, map[string]zipEntry{
+		"src/file.txt": {0644, "hello"},
+		"src/link.txt": {os.ModeSymlink | 0777, "file.txt"},
+	})
+	sqfsPath, err := filepath.Abs(filepath.Join("squashfs", "testdata", "symlinks.sqfs"))
+	require.NoError(t, err)
+
+	for _, test := range []struct {
+		name      string
+		archive   string
+		link      string
+		linkDst   string
+		wantNames []string
+	}{
+		{"zip", zipPath, "src/link.txt", "file.txt", []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix}},
+		{"squashfs", sqfsPath, "sub/link.txt", "file.txt", []string{"real.rclonelink", "sub/file.txt", "sub/link.txt" + fs.LinkSuffix, "toplink.txt" + fs.LinkSuffix}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			src, err := cache.Get(ctx, ":archive:"+test.archive)
+			require.NoError(t, err)
+			dstDir := t.TempDir()
+			dst, err := cache.Get(ctx, dstDir)
+			require.NoError(t, err)
+
+			// Copy every object in the archive
+			var remotes []string
+			require.NoError(t, operations.ListFn(ctx, src, func(o fs.Object) {
+				remotes = append(remotes, o.Remote())
+				_, err := operations.Copy(ctx, dst, nil, o.Remote(), o)
+				require.NoError(t, err)
+			}))
+			assert.ElementsMatch(t, test.wantNames, remotes)
+
+			// The symlink is recreated rather than copied as a file
+			link := filepath.Join(dstDir, test.link)
+			fi, err := os.Lstat(link)
+			require.NoError(t, err)
+			require.NotZero(t, fi.Mode()&os.ModeSymlink, "symlink should be recreated")
+			target, err := os.Readlink(link)
+			require.NoError(t, err)
+			assert.Equal(t, test.linkDst, target)
+		})
+	}
+}
+
+// TestArchiveSymlinkEscape checks a hostile archive with a symlink
+// pointing above the root plus a member "inside" it can't make a copy
+// write outside the destination.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	outside := t.TempDir()
+	zipPath := filepath.Join(t.TempDir(), "hostile.zip")
+	writeZipEntries(t, zipPath, map[string]zipEntry{
+		"pwn":          {os.ModeSymlink | 0777, outside},
+		"pwn/authkeys": {0644, "PWNED"},
+	})
+
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dst, err := cache.Get(ctx, t.TempDir())
+	require.NoError(t, err)
+
+	// Copy the symlink, then the member "inside" it
+	link, err := src.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, "pwn"+fs.LinkSuffix, link)
+	require.NoError(t, err)
+	file, err := src.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, "pwn/authkeys", file)
+	require.Error(t, err, "writing through a planted symlink should be refused")
+
+	_, err = os.Stat(filepath.Join(outside, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", outside)
+}
