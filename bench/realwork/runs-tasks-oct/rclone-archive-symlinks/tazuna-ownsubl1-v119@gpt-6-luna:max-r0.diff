+	require.NoError(t, err)
+
+	child, err := source.NewObject(ctx, "pwn/owned")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, child.Remote(), child)
+	require.Error(t, err, "a child of a hostile symlink must not be written through it")
+	_, err = os.Stat(filepath.Join(evil, "owned"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination")
+}
