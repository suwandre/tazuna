+func TestSquashfsSymlinks(t *testing.T) {
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("symlinks are unavailable: %v", err)
+	}
+	ctx := context.Background()
+	dir := t.TempDir()
+	imagePath := filepath.Join(dir, "links.sqfs")
+	image, err := os.Create(imagePath)
+	require.NoError(t, err)
+	sqfs, err := diskfsq.Create(diskfile.New(image, false), 16*1024*1024, 0, 4096)
+	require.NoError(t, err)
+	workspace := sqfs.Workspace()
+	t.Cleanup(func() { _ = os.RemoveAll(workspace) })
+	require.NoError(t, os.Mkdir(filepath.Join(workspace, "src"), 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(workspace, "src", "file.txt"), []byte("hello"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(workspace, "src", "ordinary.rclonelink"), []byte("ordinary file"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(workspace, "src", "link.txt")))
+	oldwd, err := os.Getwd()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = os.Chdir(oldwd) })
+	require.NoError(t, os.Chdir(workspace))
+	err = sqfs.Finalize(diskfsq.FinalizeOptions{NoPad: true})
+	require.NoError(t, os.Chdir(oldwd))
+	require.NoError(t, err)
+	require.NoError(t, image.Close())
+
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+	withoutLinks, err := New(ctx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := withoutLinks.List(ctx, "src")
+	require.NoError(t, err)
+	require.Len(t, entries, 2)
+	assert.Equal(t, []string{"src/file.txt", "src/ordinary.rclonelink"}, []string{entries[0].Remote(), entries[1].Remote()})
+	_, err = withoutLinks.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	withLinks, err := New(linksCtx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(linksCtx, "src")
+	require.NoError(t, err)
+	require.Len(t, entries, 3)
+	assert.Equal(t, []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix, "src/ordinary.rclonelink"}, []string{entries[0].Remote(), entries[1].Remote(), entries[2].Remote()})
+	for _, entry := range entries {
+		_, err = withLinks.NewObject(linksCtx, entry.Remote())
+		require.NoError(t, err, entry.Remote())
+	}
+	single, err := New(linksCtx, localFs, "links.sqfs", "", "src/link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	singleEntries, err := single.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, singleEntries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, singleEntries[0].Remote())
+	_, err = single.NewObject(linksCtx, singleEntries[0].Remote())
+	require.NoError(t, err)
+
+	link, err := withLinks.NewObject(linksCtx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	ordinary, err := withLinks.NewObject(linksCtx, "src/ordinary"+fs.LinkSuffix)
+	require.NoError(t, err)
+	body, err := ordinary.Open(linksCtx)
+	require.NoError(t, err)
+	content, err := io.ReadAll(body)
+	require.NoError(t, err)
+	require.NoError(t, body.Close())
+	assert.Equal(t, "ordinary file", string(content))
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	body, err = link.Open(linksCtx)
+	require.NoError(t, err)
+	content, err = io.ReadAll(body)
+	require.NoError(t, err)
+	require.NoError(t, body.Close())
+	assert.Equal(t, "file.txt", string(content))
+	body, err = link.Open(linksCtx, &fs.RangeOption{Start: 1, End: 3})
+	require.NoError(t, err)
+	content, err = io.ReadAll(body)
+	require.NoError(t, err)
+	require.NoError(t, body.Close())
+	assert.Equal(t, "ile", string(content))
+}
