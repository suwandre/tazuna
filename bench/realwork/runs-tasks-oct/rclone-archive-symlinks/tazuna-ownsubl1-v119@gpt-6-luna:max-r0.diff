+func zipWithSymlink(t *testing.T, dir, name, linkName, target string, members map[string]string) string {
+	t.Helper()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	link := &zip.FileHeader{Name: linkName, Method: zip.Deflate}
+	link.SetMode(os.ModeSymlink | 0o777)
+	w, err := zw.CreateHeader(link)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(target))
+	require.NoError(t, err)
+	for member, content := range members {
+		w, err := zw.Create(member)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
