+func TestArchiveZipSymlinks(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	probe := filepath.Join(t.TempDir(), "symlink-probe")
+	if err := os.Symlink("target", probe); err != nil {
+		t.Skipf("can't create symlink: %v", err)
+	}
+	require.NoError(t, os.Remove(probe))
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	fh := &zip.FileHeader{Name: "link", Method: zip.Deflate}
+	fh.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(fh)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("target.txt"))
+	require.NoError(t, err)
+	w, err = zw.Create("target.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("target"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(t.TempDir(), "links.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	entries, err := src.List(ctx, "")
+	require.NoError(t, err)
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"link.rclonelink", "target.txt"}, names)
+	link, err := src.NewObject(ctx, "link.rclonelink")
+	require.NoError(t, err)
+
+	dstRoot := filepath.Join(t.TempDir(), "out")
+	dst, err := cache.Get(ctx, dstRoot)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, link.Remote(), link)
+	require.NoError(t, err)
+	info, err := os.Lstat(filepath.Join(dstRoot, "link"))
+	require.NoError(t, err)
+	assert.NotZero(t, info.Mode()&os.ModeSymlink)
+	target, err := os.Readlink(filepath.Join(dstRoot, "link"))
+	require.NoError(t, err)
+	assert.Equal(t, "target.txt", target)
+}
