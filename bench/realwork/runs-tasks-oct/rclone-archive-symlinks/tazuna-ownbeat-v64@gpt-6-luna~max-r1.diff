+	_, err = f.NewObject(ctx, "link")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	link, err := f.NewObject(ctx, "link.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	for _, test := range []struct {
+		options []fs.OpenOption
+		want    string
+	}{
+		{nil, "file.txt"},
+		{[]fs.OpenOption{&fs.SeekOption{Offset: 4}}, ".txt"},
+		{[]fs.OpenOption{&fs.RangeOption{Start: 2, End: 5}}, "le.t"},
+	} {
+		rc, err := link.Open(ctx, test.options...)
+		require.NoError(t, err)
+		got, err := io.ReadAll(rc)
