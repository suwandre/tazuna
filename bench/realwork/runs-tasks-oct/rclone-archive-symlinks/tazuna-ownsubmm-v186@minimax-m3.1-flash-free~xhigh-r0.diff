+// linkTarget returns the target of the symlink described by info.
+//
+// It returns an error if info doesn't describe a symlink or the target
+// can't be read.
+func linkTarget(info os.FileInfo) (string, error) {
+	stat, ok := info.Sys().(*squashfs.StatT)
+	if !ok {
+		return "", fmt.Errorf("can't read symlink target")
+	}
+	if stat.LinkTarget == "" {
+		return "", fmt.Errorf("symlink has no target")
+	}
+	if len(stat.LinkTarget) > links.MaxTargetSize {
+		return "", fmt.Errorf("symlink target is too long")
+	}
+	return stat.LinkTarget, nil
+}
+
+// objectFromEntry makes an Object from the directory entry item found in
+// nativeDir.
