+// its name whose contents are the target of the symlink. If symlinks
+// aren't being translated then it returns fs.ErrorObjectNotFound as
+// symlinks aren't exposed at all.
+func (f *Fs) objectFromEntry(nativeDir string, item iofs.DirEntry) (*Object, error) {
+	info, err := item.Info()
+	if err != nil {
+		return nil, fmt.Errorf("error reading item %q: %w", item.Name(), err)
+	}
+	o := f.objectFromFileInfo(nativeDir, info)
+	if !links.IsSymlink(info.Mode()) {
+		return o, nil
+	}
+	if !f.links {
+		return nil, fs.ErrorObjectNotFound
+	}
+	target, err := linkTarget(info)
+	if err != nil {
+		return nil, fmt.Errorf("error reading symlink %q: %w", item.Name(), err)
+	}
+	o.link = true
+	o.target = target
+	o.remote = links.Name(o.remote)
+	// The size of a symlink is the length of its target
+	o.size = int64(len(target))
+	return o, nil
+}
