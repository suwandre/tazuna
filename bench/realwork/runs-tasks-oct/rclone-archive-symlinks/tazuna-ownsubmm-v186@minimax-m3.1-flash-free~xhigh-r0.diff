new file mode 100644
index 0000000..e60691a
--- /dev/null
+++ b/backend/archive/links/links.go
@@ -0,0 +1,62 @@
+// Package links provides the handling of the symbolic links found in
+// archives for the archive backend.
+//
+// A symlink in an archive is skipped unless symlinks are being translated
+// (with the --links flag). When they are, the symlink is exposed as a
+// regular file whose name has the ".rclonelink" suffix and whose contents
+// are the target of the symlink. This is the same convention the local
+// backend uses, so copying such a file to a backend which supports
+// symlinks recreates the symlink.
+package links
+
+import (
+	"io"
+	"os"
+	"strings"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/lib/readers"
+)
+
+// MaxTargetSize is the largest symlink target which will be read from an
+// archive.
+const MaxTargetSize = 128 * 1024
+
+// Name returns the name a symlink is exposed under when symlinks are
+// being translated into regular files.
+func Name(name string) string {
+	return name + fs.LinkSuffix
+}
+
+// IsSymlink returns true if the mode indicates a symbolic link.
+func IsSymlink(mode os.FileMode) bool {
+	return mode&os.ModeSymlink != 0
+}
+
+// Open returns a ReadCloser which reads the target of a symlink as if it
+// were the contents of an object.
+//
+// The read starts at offset and is limited to limit bytes (limit < 0 means
+// no limit).
+func Open(target string, offset, limit int64) io.ReadCloser {
+	// Clamp the offset into range to avoid a panic
+	if offset < 0 {
+		offset = 0
+	}
+	if offset > int64(len(target)) {
+		offset = int64(len(target))
+	}
+	return readers.NewLimitedReadCloser(io.NopCloser(strings.NewReader(target[offset:])), limit)
+}
+
+// LogSkipped logs that n symlinks were skipped because symlinks aren't
+// being translated.
+//
+// The message names the flag which must be used to see them.
+func LogSkipped(f fs.Info, n int, dir string) {
+	if dir == "" {
+		fs.Logf(f, "Skipped %d symlinks - use --links to translate them", n)
+		return
+	}
+	fs.Logf(f, "Skipped %d symlinks in %q - use --links to translate them", n, dir)
+}
