+++ b/backend/archive/squashfs/squashfs_symlink_internal_test.go
@@ -0,0 +1,252 @@
+package squashfs
+
+import (
+	"context"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+
+	_ "github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
+	fscache "github.com/rclone/rclone/fs/cache"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// skipIfNoExe skips the test if the named executable isn't installed.
+func skipIfNoExe(t *testing.T, exeName string) {
+	_, err := exec.LookPath(exeName)
+	if err != nil {
+		t.Skipf("%s executable not installed", exeName)
+	}
+}
+
+// sqEntry describes an entry to put in a test squashfs image.
+type sqEntry struct {
+	name    string
+	body    string
+	symlink bool // make this entry a symlink pointing at body
+}
+
+// writeSqfs builds a squashfs image with the given entries in dir and
+// returns its leaf name.
+//
+// The image is made with mksquashfs as the go-diskfs library can't
+// create an image with a symlink whose target doesn't exist.
+func writeSqfs(t *testing.T, dir, name string, entries ...sqEntry) string {
+	// Make the tree to put in the image
+	src := filepath.Join(dir, "src")
+	require.NoError(t, os.MkdirAll(src, 0755))
+	for _, entry := range entries {
+		path := filepath.Join(src, entry.name)
+		require.NoError(t, os.MkdirAll(filepath.Dir(path), 0755))
+		if entry.symlink {
+			require.NoError(t, os.Symlink(entry.body, path))
+			continue
+		}
+		require.NoError(t, os.WriteFile(path, []byte(entry.body), 0644))
+	}
+
+	image := filepath.Join(dir, name)
+	cmd := exec.Command("mksquashfs", src, image, "-noappend", "-no-progress", "-all-root")
+	out, err := cmd.CombinedOutput()
+	require.NoError(t, err, string(out))
+
+	return name
+}
+
+// newSqfsFs makes an Fs from the squashfs image name in dir.
+//
+// If links is set then symlinks are translated as if --links was in use.
+func newSqfsFs(t *testing.T, dir, name string, links bool) *Fs {
+	ctx := context.Background()
+	if links {
+		var ci *fs.ConfigInfo
+		ctx, ci = fs.AddConfig(ctx)
+		ci.Links = true
+	}
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	sf, ok := f.(*Fs)
+	require.True(t, ok)
+	return sf
+}
+
+// listRemotes lists the remotes of the objects in dir.
+func listRemotes(t *testing.T, f *Fs, dir string) []string {
+	entries, err := f.List(context.Background(), dir)
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	return remotes
+}
+
+// readObject reads the contents of the object at remote.
+func readObject(t *testing.T, f *Fs, remote string, options ...fs.OpenOption) string {
+	o, err := f.NewObject(context.Background(), remote)
+	require.NoError(t, err, remote)
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err, remote)
+	buf, err := io.ReadAll(rc)
+	require.NoError(t, err, remote)
+	require.NoError(t, rc.Close())
+	return string(buf)
+}
+
+// A symlink in a squashfs image must not be exposed unless symlinks are
+// being translated, and then it must be exposed under its name plus the
+// link suffix with the target of the symlink as its contents.
+func TestSquashfsSymlink(t *testing.T) {
+	skipIfNoExe(t, "mksquashfs")
+	dir := t.TempDir()
+	name := writeSqfs(t, dir, "test.sqfs",
+		sqEntry{name: "file.txt", body: "data"},
+		sqEntry{name: "link.txt", body: "file.txt", symlink: true},
+	)
+
+	t.Run("WithoutLinks", func(t *testing.T) {
+		f := newSqfsFs(t, dir, name, false)
+		assert.Equal(t, []string{"file.txt"}, listRemotes(t, f, ""))
+		// The symlink isn't there under any name
+		_, err := f.NewObject(context.Background(), "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(context.Background(), "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("WithLinks", func(t *testing.T) {
+		f := newSqfsFs(t, dir, name, true)
+		assert.Equal(t, []string{"file.txt", "link.txt" + fs.LinkSuffix}, listRemotes(t, f, ""))
+
+		// The symlink is found by its name with the suffix and
+		// reads back the target of the symlink
+		assert.Equal(t, "file.txt", readObject(t, f, "link.txt"+fs.LinkSuffix))
+
+		// It isn't found by its own name
+		_, err := f.NewObject(context.Background(), "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// The size is the length of the target
+		o, err := f.NewObject(context.Background(), "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+	})
+}
+
+// Reading a symlink must honour the seek and range options.
+func TestSquashfsSymlinkOpenOptions(t *testing.T) {
+	skipIfNoExe(t, "mksquashfs")
+	dir := t.TempDir()
+	name := writeSqfs(t, dir, "test.sqfs",
+		sqEntry{name: "target", body: "data"},
+		sqEntry{name: "link.txt", body: "0123456789", symlink: true},
+	)
+	f := newSqfsFs(t, dir, name, true)
+
+	assert.Equal(t, "0123456789", readObject(t, f, "link.txt"+fs.LinkSuffix))
+	assert.Equal(t, "3456789", readObject(t, f, "link.txt"+fs.LinkSuffix, &fs.SeekOption{Offset: 3}))
+	assert.Equal(t, "012", readObject(t, f, "link.txt"+fs.LinkSuffix, &fs.RangeOption{Start: 0, End: 2}))
+	assert.Equal(t, "789", readObject(t, f, "link.txt"+fs.LinkSuffix, &fs.RangeOption{Start: 7, End: -1}))
+	assert.Equal(t, "789", readObject(t, f, "link.txt"+fs.LinkSuffix, &fs.RangeOption{Start: -1, End: 3}))
+	// An offset past the end of the target reads nothing
+	assert.Equal(t, "", readObject(t, f, "link.txt"+fs.LinkSuffix, &fs.SeekOption{Offset: 100}))
+}
+
+// A regular file in the image whose name happens to end with the link
+// suffix must stay a regular file.
+func TestSquashfsRegularFileWithLinkSuffix(t *testing.T) {
+	skipIfNoExe(t, "mksquashfs")
+	dir := t.TempDir()
+	name := writeSqfs(t, dir, "test.sqfs",
+		sqEntry{name: "regular" + fs.LinkSuffix, body: "regular data"},
+		sqEntry{name: "link.txt", body: "regular" + fs.LinkSuffix, symlink: true},
+	)
+	f := newSqfsFs(t, dir, name, true)
+
+	assert.Equal(t, []string{"link.txt" + fs.LinkSuffix, "regular" + fs.LinkSuffix}, listRemotes(t, f, ""))
+
+	// The regular file reads back its own contents
+	assert.Equal(t, "regular data", readObject(t, f, "regular"+fs.LinkSuffix))
+
+	// The symlink reads back its target
+	assert.Equal(t, "regular"+fs.LinkSuffix, readObject(t, f, "link.txt"+fs.LinkSuffix))
+}
+
+// A symlink in a subdirectory must be exposed in that directory.
+func TestSquashfsSymlinkInSubDir(t *testing.T) {
+	skipIfNoExe(t, "mksquashfs")
+	dir := t.TempDir()
+	name := writeSqfs(t, dir, "test.sqfs",
+		sqEntry{name: "sub/file.txt", body: "data"},
+		sqEntry{name: "sub/link.txt", body: "file.txt", symlink: true},
+	)
+	f := newSqfsFs(t, dir, name, true)
+
+	assert.Equal(t, []string{"sub"}, listRemotes(t, f, ""))
+	assert.Equal(t, []string{"sub/file.txt", "sub/link.txt" + fs.LinkSuffix}, listRemotes(t, f, "sub"))
+	assert.Equal(t, "file.txt", readObject(t, f, "sub/link.txt"+fs.LinkSuffix))
+}
+
+// A symlink which is the root of the Fs must be exposed with the link
+// suffix.
+func TestSquashfsSymlinkRoot(t *testing.T) {
+	skipIfNoExe(t, "mksquashfs")
+	dir := t.TempDir()
+	name := writeSqfs(t, dir, "test.sqfs",
+		sqEntry{name: "file.txt", body: "data"},
+		sqEntry{name: "link.txt", body: "file.txt", symlink: true},
+	)
+
+	ctx := context.Background()
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	// The root points at the symlink
+	f, err := New(ctx, localFs, name, "", "link.txt")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	sf, ok := f.(*Fs)
+	require.True(t, ok)
+
+	entries, err := sf.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+
+	// The root may also name the symlink with the link suffix
+	f, err = New(ctx, localFs, name, "", "link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	sf, ok = f.(*Fs)
+	require.True(t, ok)
+
+	entries, err = sf.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+}
+
+// The squashfs backend must expose the same names in a listing as it
+// does when looking up a single object.
+func TestSquashfsSymlinkListAndNewObjectAgree(t *testing.T) {
+	skipIfNoExe(t, "mksquashfs")
+	dir := t.TempDir()
+	name := writeSqfs(t, dir, "test.sqfs",
+		sqEntry{name: "file.txt", body: "data"},
+		sqEntry{name: "link.txt", body: "file.txt", symlink: true},
+		sqEntry{name: "regular" + fs.LinkSuffix, body: "regular data"},
+	)
+	f := newSqfsFs(t, dir, name, true)
+
+	for _, remote := range listRemotes(t, f, "") {
+		o, err := f.NewObject(context.Background(), remote)
+		require.NoError(t, err, remote)
+		assert.Equal(t, remote, o.Remote(), remote)
+	}
+}
