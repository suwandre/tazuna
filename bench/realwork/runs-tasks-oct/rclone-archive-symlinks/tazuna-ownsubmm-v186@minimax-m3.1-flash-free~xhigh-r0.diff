+package zip
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	_ "github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/cache"
+	"github.com/rclone/rclone/fs/hash"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// zipEntry describes an entry to put in a test zip file.
+type zipEntry struct {
+	name    string
+	body    string
+	symlink bool // make this entry a symlink pointing at body
+}
+
+// writeZipWith builds a zip file with the given entries in dir and
+// returns its leaf name.
+func writeZipWith(t *testing.T, dir, name string, entries ...zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		hdr := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+		if entry.symlink {
+			hdr.SetMode(os.ModeSymlink | 0777)
+		} else {
+			hdr.SetMode(0644)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// newZipFs makes an Fs from the zip file name in dir.
+//
+// If links is set then symlinks are translated as if --links was in use.
+func newZipFs(t *testing.T, dir, name string, links bool) *Fs {
+	ctx := context.Background()
+	if links {
+		var ci *fs.ConfigInfo
+		ctx, ci = fs.AddConfig(ctx)
+		ci.Links = true
+	}
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	zf, ok := f.(*Fs)
+	require.True(t, ok)
+	return zf
+}
+
+// listRemotes lists the remotes of the objects in dir.
+func listRemotes(t *testing.T, f *Fs, dir string) []string {
+	entries, err := f.List(context.Background(), dir)
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	return remotes
+}
+
+// readObject reads the contents of the object at remote.
+func readObject(t *testing.T, f *Fs, remote string, options ...fs.OpenOption) string {
+	o, err := f.NewObject(context.Background(), remote)
+	require.NoError(t, err, remote)
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err, remote)
+	buf, err := io.ReadAll(rc)
+	require.NoError(t, err, remote)
+	require.NoError(t, rc.Close())
+	return string(buf)
+}
+
+// A symlink in a zip file must not be exposed unless symlinks are being
+// translated, and then it must be exposed under its name plus the link
+// suffix with the target of the symlink as its contents.
+func TestZipSymlink(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipWith(t, dir, "test.zip",
+		zipEntry{name: "file.txt", body: "data"},
+		zipEntry{name: "link.txt", body: "file.txt", symlink: true},
+	)
+
+	t.Run("WithoutLinks", func(t *testing.T) {
+		f := newZipFs(t, dir, name, false)
+		assert.Equal(t, []string{"file.txt"}, listRemotes(t, f, ""))
+		// The symlink isn't there under any name
+		_, err := f.NewObject(context.Background(), "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(context.Background(), "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("WithLinks", func(t *testing.T) {
+		f := newZipFs(t, dir, name, true)
+		assert.Equal(t, []string{"file.txt", "link.txt" + fs.LinkSuffix}, listRemotes(t, f, ""))
+
+		// The symlink is found by its name with the suffix and
+		// reads back the target of the symlink
+		assert.Equal(t, "file.txt", readObject(t, f, "link.txt"+fs.LinkSuffix))
+
+		// It isn't found by its own name
+		_, err := f.NewObject(context.Background(), "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// The size is the length of the target
+		o, err := f.NewObject(context.Background(), "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+
+		// The modtime of the symlink is the modtime of the entry
+		assert.False(t, o.ModTime(context.Background()).IsZero())
+	})
+}
+
+// Reading a symlink must honour the seek and range options.
+func TestZipSymlinkOpenOptions(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipWith(t, dir, "test.zip",
+		zipEntry{name: "link.txt", body: "0123456789", symlink: true},
+	)
+	f := newZipFs(t, dir, name, true)
+	f.links = true
+
+	assert.Equal(t, "0123456789", readObject(t, f, "link.txt"+fs.LinkSuffix))
+	assert.Equal(t, "3456789", readObject(t, f, "link.txt"+fs.LinkSuffix, &fs.SeekOption{Offset: 3}))
+	assert.Equal(t, "012", readObject(t, f, "link.txt"+fs.LinkSuffix, &fs.RangeOption{Start: 0, End: 2}))
+	assert.Equal(t, "789", readObject(t, f, "link.txt"+fs.LinkSuffix, &fs.RangeOption{Start: 7, End: -1}))
+	assert.Equal(t, "789", readObject(t, f, "link.txt"+fs.LinkSuffix, &fs.RangeOption{Start: -1, End: 3}))
+	// An offset past the end of the target reads nothing
+	assert.Equal(t, "", readObject(t, f, "link.txt"+fs.LinkSuffix, &fs.SeekOption{Offset: 100}))
+}
+
+// A symlink which is the root of the Fs must be exposed with the link
+// suffix.
+func TestZipSymlinkRoot(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipWith(t, dir, "test.zip",
+		zipEntry{name: "file.txt", body: "data"},
+		zipEntry{name: "link.txt", body: "file.txt", symlink: true},
+	)
+
+	ctx := context.Background()
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	// The root points at the symlink
+	f, err := New(ctx, localFs, name, "", "link.txt")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	zf, ok := f.(*Fs)
+	require.True(t, ok)
+
+	entries, err := zf.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+
+	// The root may also name the symlink with the link suffix
+	f, err = New(ctx, localFs, name, "", "link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	zf, ok = f.(*Fs)
+	require.True(t, ok)
+
+	entries, err = zf.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+}
+
+// A regular file in the archive whose name happens to end with the link
+// suffix must stay a regular file.
+func TestZipRegularFileWithLinkSuffix(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipWith(t, dir, "test.zip",
+		zipEntry{name: "regular" + fs.LinkSuffix, body: "regular data"},
+		zipEntry{name: "link.txt", body: "regular" + fs.LinkSuffix, symlink: true},
+	)
+	f := newZipFs(t, dir, name, true)
+	f.links = true
+
+	assert.Equal(t, []string{"link.txt" + fs.LinkSuffix, "regular" + fs.LinkSuffix}, listRemotes(t, f, ""))
+
+	// The regular file reads back its own contents
+	assert.Equal(t, "regular data", readObject(t, f, "regular"+fs.LinkSuffix))
+
+	// The symlink reads back its target
+	assert.Equal(t, "regular"+fs.LinkSuffix, readObject(t, f, "link.txt"+fs.LinkSuffix))
+}
+
+// A symlink in a subdirectory must be exposed in that directory.
+func TestZipSymlinkInSubDir(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipWith(t, dir, "test.zip",
+		zipEntry{name: "sub/", body: ""},
+		zipEntry{name: "sub/file.txt", body: "data"},
+		zipEntry{name: "sub/link.txt", body: "file.txt", symlink: true},
+	)
+	f := newZipFs(t, dir, name, true)
+	f.links = true
+
+	assert.Equal(t, []string{"sub/file.txt", "sub/link.txt" + fs.LinkSuffix}, listRemotes(t, f, "sub"))
+	assert.Equal(t, "file.txt", readObject(t, f, "sub/link.txt"+fs.LinkSuffix))
+}
+
+// A symlink whose target is empty is still a symlink.
+func TestZipSymlinkEmptyTarget(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipWith(t, dir, "test.zip",
+		zipEntry{name: "link.txt", body: "", symlink: true},
+	)
+	f := newZipFs(t, dir, name, true)
+	f.links = true
+
+	assert.Equal(t, []string{"link.txt" + fs.LinkSuffix}, listRemotes(t, f, ""))
+	assert.Equal(t, "", readObject(t, f, "link.txt"+fs.LinkSuffix))
+	o, err := f.NewObject(context.Background(), "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(0), o.Size())
+}
+
+// The size of a symlink is the length of its target, not the length of
+// the entry in the archive.
+func TestZipSymlinkSize(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipWith(t, dir, "test.zip",
+		zipEntry{name: "link.txt", body: "a/very/long/target/path", symlink: true},
+	)
+	f := newZipFs(t, dir, name, true)
+	f.links = true
+
+	o, err := f.NewObject(context.Background(), "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("a/very/long/target/path")), o.Size())
+}
+
+// A symlink whose exposed name clashes with a regular file of that name
+// in the archive must not be exposed twice.
+func TestZipSymlinkNameClash(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipWith(t, dir, "test.zip",
+		zipEntry{name: "link.txt", body: "file.txt", symlink: true},
+		zipEntry{name: "link.txt" + fs.LinkSuffix, body: "regular data"},
+	)
+	f := newZipFs(t, dir, name, true)
+
+	// Only one entry with that name is exposed
+	remotes := listRemotes(t, f, "")
+	assert.Len(t, remotes, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, remotes[0])
+
+	// And it can be looked up
+	o, err := f.NewObject(context.Background(), "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, o.Remote())
+}
+
+// Check the CRC32 hash of a symlink is that of its target.
+func TestZipSymlinkHash(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipWith(t, dir, "test.zip",
+		zipEntry{name: "link.txt", body: "file.txt", symlink: true},
+	)
+	f := newZipFs(t, dir, name, true)
+	f.links = true
+
+	o, err := f.NewObject(context.Background(), "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	sum, err := o.Hash(context.Background(), hash.CRC32)
+	require.NoError(t, err)
+	assert.Equal(t, "e0f71625", sum)
+}
+
+// The zip backend must expose the same names in a listing as it does
+// when looking up a single object.
+func TestZipSymlinkListAndNewObjectAgree(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipWith(t, dir, "test.zip",
+		zipEntry{name: "file.txt", body: "data"},
+		zipEntry{name: "link.txt", body: "file.txt", symlink: true},
+		zipEntry{name: "regular" + fs.LinkSuffix, body: "regular data"},
+	)
+	f := newZipFs(t, dir, name, true)
+	f.links = true
+
+	for _, remote := range listRemotes(t, f, "") {
+		o, err := f.NewObject(context.Background(), remote)
+		require.NoError(t, err, remote)
+		assert.Equal(t, remote, o.Remote(), remote)
+	}
+}
+
+// Check that the symlink tests run against a zip file which really does
+// contain a symlink.
+func TestZipSymlinkIsDetected(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipWith(t, dir, "test.zip",
+		zipEntry{name: "link.txt", body: "file.txt", symlink: true},
+	)
+	r, err := os.Open(filepath.Join(dir, name))
+	require.NoError(t, err)
+	defer func() { require.NoError(t, r.Close()) }()
+	fi, err := r.Stat()
+	require.NoError(t, err)
+	zr, err := zip.NewReader(r, fi.Size())
+	require.NoError(t, err)
+	require.Len(t, zr.File, 1)
+	assert.NotZero(t, zr.File[0].Mode()&os.ModeSymlink, fmt.Sprintf("mode is %v", zr.File[0].Mode()))
+}
