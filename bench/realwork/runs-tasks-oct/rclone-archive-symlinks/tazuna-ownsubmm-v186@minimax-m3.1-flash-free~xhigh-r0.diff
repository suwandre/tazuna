+++ b/backend/archive/archive_symlink_internal_test.go
@@ -0,0 +1,257 @@
+//go:build !plan9
+
+package archive
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	_ "github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/cache"
+	"github.com/rclone/rclone/fs/sync"
+	"github.com/rclone/rclone/fstest"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// skipIfNoSymlinks skips the test if the platform doesn't support symlinks.
+func skipIfNoSymlinks(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks not supported on Windows")
+	}
+	dir := t.TempDir()
+	require.NoError(t, os.Symlink("target", filepath.Join(dir, "link")))
+}
+
+// writeSymlinkZip makes a zip file with a regular file and a symlink to
+// it in the given directory and returns its path.
+func writeSymlinkZip(t *testing.T, dir string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name    string
+		body    string
+		symlink bool
+	}{
+		{name: "src/", body: ""},
+		{name: "src/file.txt", body: "data"},
+		{name: "src/link.txt", body: "file.txt", symlink: true},
+	} {
+		hdr := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+		if entry.symlink {
+			hdr.SetMode(os.ModeSymlink | 0777)
+		} else {
+			hdr.SetMode(0644)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(dir, "test.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+	return zipPath
+}
+
+// linksConfig makes a context with the --links flag set.
+func linksConfig(ctx context.Context) (context.Context, *fs.ConfigInfo) {
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	return ctx, ci
+}
+
+// The archive backend must not expose the symlinks in an archive unless
+// --links is in use, and then it must expose them with the link suffix.
+func TestArchiveSymlinkNotExposed(t *testing.T) {
+	skipIfNoSymlinks(t)
+	fstest.Initialise()
+	ctx := context.Background()
+
+	zipPath := writeSymlinkZip(t, t.TempDir())
+
+	f, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.Equal(t, []string{"src/file.txt"}, remotes)
+}
+
+// With --links the symlink must be listed under its name plus the link
+// suffix and its size must be the length of the target.
+func TestArchiveSymlinkExposedWithLinks(t *testing.T) {
+	skipIfNoSymlinks(t)
+	fstest.Initialise()
+	ctx := context.Background()
+
+	zipPath := writeSymlinkZip(t, t.TempDir())
+
+	ctx, _ = linksConfig(ctx)
+
+	f, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.Equal(t, []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix}, remotes)
+
+	// The size is the length of the target of the symlink
+	o, err := f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+
+	// It isn't found by its own name
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+}
+
+// The names in a listing and the names found by looking up a single
+// object must agree.
+func TestArchiveSymlinkListAndNewObjectAgree(t *testing.T) {
+	skipIfNoSymlinks(t)
+	fstest.Initialise()
+	ctx := context.Background()
+
+	zipPath := writeSymlinkZip(t, t.TempDir())
+
+	ctx, _ = linksConfig(ctx)
+
+	f, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	require.NotEmpty(t, entries)
+	for _, entry := range entries {
+		remote := entry.Remote()
+		o, err := f.NewObject(ctx, remote)
+		require.NoError(t, err, remote)
+		assert.Equal(t, remote, o.Remote(), remote)
+	}
+}
+
+// A symlink which is the root of the Fs must be exposed with the link
+// suffix.
+func TestArchiveSymlinkRoot(t *testing.T) {
+	skipIfNoSymlinks(t)
+	fstest.Initialise()
+	ctx := context.Background()
+
+	zipPath := writeSymlinkZip(t, t.TempDir())
+
+	ctx, _ = linksConfig(ctx)
+
+	f, err := cache.Get(ctx, ":archive:"+zipPath+"/src/link.txt")
+	require.NoError(t, err)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+
+	// The symlink may also be named with the link suffix
+	f, err = cache.Get(ctx, ":archive:"+zipPath+"/src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+
+	entries, err = f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+}
+
+// Copying an archive with --links to a directory which supports symlinks
+// must recreate the symlinks.
+func TestArchiveSymlinkCopy(t *testing.T) {
+	skipIfNoSymlinks(t)
+	fstest.Initialise()
+	ctx := context.Background()
+
+	zipPath := writeSymlinkZip(t, t.TempDir())
+	dst := t.TempDir()
+
+	ctx, _ = linksConfig(ctx)
+
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dstFs, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+
+	require.NoError(t, sync.CopyDir(ctx, dstFs, src, false))
+
+	// The regular file was copied
+	got, err := os.ReadFile(filepath.Join(dst, "src", "file.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "data", string(got))
+
+	// The symlink was recreated as a symlink
+	link := filepath.Join(dst, "src", "link.txt")
+	fi, err := os.Lstat(link)
+	require.NoError(t, err)
+	require.NotZero(t, fi.Mode()&os.ModeSymlink, "link should be a symlink")
+	target, err := os.Readlink(link)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+// A hostile archive which has a symlink pointing above the destination
+// and a member "inside" it must not be able to write outside the
+// destination.
+func TestArchiveSymlinkHostile(t *testing.T) {
+	skipIfNoSymlinks(t)
+	fstest.Initialise()
+	ctx := context.Background()
+
+	// A directory outside the destination which the attack targets
+	outside := t.TempDir()
+	outsideFile := filepath.Join(outside, "authkeys")
+
+	// A zip with a symlink pointing at the outside directory and a
+	// member inside it
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	hdr := &zip.FileHeader{Name: "pwn", Method: zip.Deflate}
+	hdr.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(hdr)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(outside))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	zipPath := filepath.Join(t.TempDir(), "evil.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	dst := t.TempDir()
+
+	ctx, _ = linksConfig(ctx)
+
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dstFs, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+
+	// The copy may fail, but nothing may be written outside the
+	// destination
+	_ = sync.CopyDir(ctx, dstFs, src, false)
+
+	_, err = os.Stat(outsideFile)
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", outsideFile)
+}
