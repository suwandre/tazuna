+func writeSymlinkZip(t *testing.T, filename string) {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	write := func(name string, mode os.FileMode, content string) {
+		h := &zip.FileHeader{Name: name, Method: zip.Store}
+		h.SetMode(mode)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = io.WriteString(w, content)
+		require.NoError(t, err)
+	}
+	write("pwn", os.ModeSymlink|0777, "../outside")
+	write("pwn/authkeys", 0600, "PWNED")
+	write("safe", 0600, "safe")
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filename, buf.Bytes(), 0600))
+}
