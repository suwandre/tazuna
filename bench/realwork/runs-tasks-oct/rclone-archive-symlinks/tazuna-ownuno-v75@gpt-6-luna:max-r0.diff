+func TestArchiveSquashfsSymlinks(t *testing.T) {
+	fstest.Initialise()
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks are not available on Windows")
+	}
+	skipIfNoExe(t, "mksquashfs")
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("content"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "link.txt")))
+	archivePath := filepath.Join(t.TempDir(), "links.sqfs")
+	run(t, "mksquashfs", input, archivePath)
+
+	localFs, err := cache.Get(ctx, filepath.Dir(archivePath))
+	require.NoError(t, err)
+	noLinksCtx, noLinksCI := fs.AddConfig(context.Background())
+	noLinksCI.Links = false
+	var squashfsNew func(context.Context, fs.Fs, string, string, string) (fs.Fs, error)
+	for _, a := range archiver.Archivers {
+		if a.Extension == ".sqfs" {
+			squashfsNew = a.New
+			break
+		}
+	}
+	require.NotNil(t, squashfsNew)
+	withoutLinks, err := squashfsNew(noLinksCtx, localFs, filepath.Base(archivePath), "", "")
+	require.NoError(t, err)
+	entries, err := withoutLinks.List(noLinksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "file.txt", entries[0].Remote())
+	_, err = withoutLinks.NewObject(noLinksCtx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	f, err := squashfsNew(ctx, localFs, filepath.Base(archivePath), "", "")
+	require.NoError(t, err)
+	entries, err = f.List(ctx, "")
+	require.NoError(t, err)
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "link.txt" + fs.LinkSuffix}, names)
+
+	link, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	rc, err := link.Open(ctx, &fs.RangeOption{Start: 2, End: 5})
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "le.t", string(contents))
+}
