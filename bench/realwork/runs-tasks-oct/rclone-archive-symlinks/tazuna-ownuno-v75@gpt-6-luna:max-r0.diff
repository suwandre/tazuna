+func TestArchiveSymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks are not available on Windows")
+	}
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	root := t.TempDir()
+	archivePath := filepath.Join(root, "malicious.zip")
+	writeSymlinkZip(t, archivePath)
+	outside := filepath.Join(root, "outside")
+	require.NoError(t, os.Mkdir(outside, 0700))
+	outsideFile := filepath.Join(outside, "authkeys")
+	require.NoError(t, os.WriteFile(outsideFile, []byte("original"), 0600))
+
+	src, err := cache.Get(ctx, ":archive:"+archivePath)
+	require.NoError(t, err)
+	dst, err := fs.NewFs(ctx, filepath.Join(root, "destination"))
+	require.NoError(t, err)
+	assert.Error(t, syncpkg.CopyDir(ctx, dst, src, false))
+
+	contents, err := os.ReadFile(outsideFile)
+	require.NoError(t, err)
+	assert.Equal(t, "original", string(contents))
+}
