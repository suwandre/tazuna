+
+type archiveLinkEntry struct {
+	name, content string
+	mode          os.FileMode
+}
+
+func writeLinksZip(t *testing.T, name string, entries []archiveLinkEntry) {
+	out, err := os.Create(name)
+	require.NoError(t, err)
+	zw := zip.NewWriter(out)
+	for _, entry := range entries {
+		header := &zip.FileHeader{Name: entry.name, Modified: time.Date(2026, 9, 28, 14, 16, 59, 0, time.UTC)}
+		header.SetMode(entry.mode)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = io.WriteString(w, entry.content)
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, out.Close())
+}
+
+// symlinks.sqfs contains the same tree, packed with mksquashfs -noappend -no-xattrs.
+func linkArchives(t *testing.T) []string {
+	dir := t.TempDir()
+	zipPath := filepath.Join(dir, "links.zip")
+	writeLinksZip(t, zipPath, []archiveLinkEntry{
+		{"src/file.txt", "hello", 0644},
+		{"src/regular.rclonelink", "ordinary file", 0644},
+		{"src/link.txt", "file.txt", os.ModeSymlink | 0777},
+		{"src/dirlink", ".", os.ModeSymlink | 0777},
+		{"src/dangling", "missing", os.ModeSymlink | 0777},
+		{"src/suffixed.rclonelink", "file.txt", os.ModeSymlink | 0777},
+	})
+	image, err := os.ReadFile(filepath.Join("squashfs", "testdata", "symlinks.sqfs"))
+	require.NoError(t, err)
+	sqfsPath := filepath.Join(dir, "links.sqfs")
+	require.NoError(t, os.WriteFile(sqfsPath, image, 0600))
+	return []string{zipPath, sqfsPath}
+}
+
+func TestArchiveSymlinks(t *testing.T) {
+	fstest.Initialise()
+	for _, archivePath := range linkArchives(t) {
+		t.Run(filepath.Ext(archivePath), func(t *testing.T) {
+			for _, links := range []bool{false, true} {
+				ctx, ci := fs.AddConfig(context.Background())
+				ci.Links = links
+				for _, test := range []struct {
+					name, root, dir string
+				}{
+					{"Archive", archivePath, "src"},
+					{"Subdir", archivePath + "/src", ""},
+					{"Prefix", filepath.Dir(archivePath), path.Base(archivePath) + "/src"},
+				} {
+					t.Run(test.name+"/links="+strconv.FormatBool(links), func(t *testing.T) {
+						var notices strings.Builder
+						log.Handler.SetOutput(func(level slog.Level, text string) {
+							if level == fs.SlogLevelNotice {
+								notices.WriteString(text)
+							}
+						})
+						defer log.Handler.ResetOutput()
+
+						f, err := NewFs(ctx, "archive", test.root, configmap.Simple{})
+						require.NoError(t, err)
+						if test.name == "Prefix" {
+							_, err = f.List(ctx, "") // Discover the archives.
+							require.NoError(t, err)
+						}
+						entries, err := f.List(ctx, test.dir)
+						require.NoError(t, err)
+						want := map[string]string{"file.txt": "hello", "regular.rclonelink": "ordinary file"}
+						linkTargets := map[string]string{"link.txt": "file.txt", "dirlink": ".", "dangling": "missing", "suffixed.rclonelink": "file.txt"}
+						for name, target := range linkTargets {
+							_, err := f.NewObject(ctx, path.Join(test.dir, name))
+							assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+							if links {
+								want[name+fs.LinkSuffix] = target
+							} else {
+								_, err = f.NewObject(ctx, path.Join(test.dir, name+fs.LinkSuffix))
+								assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+							}
+						}
+						require.Len(t, entries, len(want))
+						for _, entry := range entries {
+							content, ok := want[path.Base(entry.Remote())]
+							require.True(t, ok, "unexpected entry %q", entry.Remote())
+							obj, ok := entry.(fs.Object)
+							require.True(t, ok)
+							lookup, err := f.NewObject(ctx, entry.Remote())
+							require.NoError(t, err)
+							for _, o := range []fs.Object{obj, lookup} {
+								assert.Equal(t, int64(len(content)), o.Size())
+								assert.Equal(t, content, fstests.ReadObject(ctx, t, o, -1))
+								assert.Equal(t, content[1:], fstests.ReadObject(ctx, t, o, -1, &fs.SeekOption{Offset: 1}))
+								assert.Equal(t, content[:1], fstests.ReadObject(ctx, t, o, -1, &fs.RangeOption{Start: 0, End: 0}))
+								assert.Equal(t, content, fstests.ReadObject(ctx, t, o, -1, &fs.RangeOption{Start: 0, End: 1000}))
+								assert.Equal(t, content[len(content)-1:], fstests.ReadObject(ctx, t, o, -1, &fs.RangeOption{Start: -1, End: 1}))
+							}
+						}
+						_, err = f.NewObject(ctx, path.Join(test.dir, "regular.rclonelink.rclonelink"))
+						assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+						if links {
+							assert.NotContains(t, notices.String(), "--links")
+						} else {
+							assert.Contains(t, notices.String(), "--links")
+						}
+					})
+				}
+			}
+		})
+	}
+}
+
+func TestArchiveSymlinkSingleFile(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	for _, archivePath := range linkArchives(t) {
+		for _, name := range []string{"link.txt.rclonelink", "suffixed.rclonelink.rclonelink", "regular.rclonelink"} {
+			t.Run(filepath.Ext(archivePath)+"/"+name, func(t *testing.T) {
+				f, err := NewFs(ctx, "archive", archivePath+"/src/"+name, configmap.Simple{})
+				require.NoError(t, err)
+				entries, err := f.List(ctx, "")
+				require.NoError(t, err)
+				require.Len(t, entries, 1)
+				assert.Equal(t, name, entries[0].Remote())
+				o, err := f.NewObject(ctx, name)
+				require.NoError(t, err)
+				want := "file.txt"
+				if name == "regular.rclonelink" {
+					want = "ordinary file"
+				}
+				assert.Equal(t, want, fstests.ReadObject(ctx, t, o, -1))
+			})
+		}
+	}
+}
+
+func skipIfNoSymlinks(t *testing.T) {
+	t.Helper()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("Symlinks are unavailable: %v", err)
+	}
+}
+
+func TestArchiveSymlinkCopy(t *testing.T) {
+	skipIfNoSymlinks(t)
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	for _, archivePath := range linkArchives(t) {
+		t.Run(filepath.Ext(archivePath), func(t *testing.T) {
+			src, err := NewFs(ctx, "archive", archivePath, configmap.Simple{})
+			require.NoError(t, err)
+			dir := t.TempDir()
+			dst, err := local.NewFs(ctx, "local", dir, configmap.Simple{})
+			require.NoError(t, err)
+			require.NoError(t, sync.CopyDir(ctx, dst, src, false))
+			target, err := os.Readlink(filepath.Join(dir, "src", "link.txt"))
+			require.NoError(t, err)
+			assert.Equal(t, "file.txt", target)
+			data, err := os.ReadFile(filepath.Join(dir, "src", "link.txt"))
+			require.NoError(t, err)
+			assert.Equal(t, "hello", string(data))
+		})
+	}
+}
+
+func TestArchiveSymlinkEscape(t *testing.T) {
+	skipIfNoSymlinks(t)
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	require.NoError(t, os.Mkdir(filepath.Join(dir, "outside"), 0700))
+	archivePath := filepath.Join(dir, "evil.zip")
+	writeLinksZip(t, archivePath, []archiveLinkEntry{
+		{"pwn", "../outside", os.ModeSymlink | 0777},
+		{"pwn/evil.txt", "must not escape", 0644},
+	})
+	src, err := NewFs(ctx, "archive", archivePath, configmap.Simple{})
+	require.NoError(t, err)
+	dst, err := local.NewFs(ctx, "local", filepath.Join(dir, "out"), configmap.Simple{})
+	require.NoError(t, err)
+	// Plant the link first to exercise the write-through regardless of transfer order.
+	require.NoError(t, operations.CopyFile(ctx, dst, src, "pwn.rclonelink", "pwn.rclonelink"))
+	target, err := os.Readlink(filepath.Join(dir, "out", "pwn"))
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", target)
+	require.Error(t, operations.CopyFile(ctx, dst, src, "pwn/evil.txt", "pwn/evil.txt"))
+	_, err = os.Stat(filepath.Join(dir, "outside", "evil.txt"))
+	assert.True(t, os.IsNotExist(err), "copy must not write through the symlink outside its root")
+}
