+func TestSquashfsSymlinks(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs not installed")
+	}
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = false
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "target.txt"), []byte("target data"), 0600))
+	if err := os.Symlink("target.txt", filepath.Join(input, "link.txt")); err != nil {
+		t.Skipf("can't create symlink: %v", err)
+	}
+	require.NoError(t, os.WriteFile(filepath.Join(input, "regular.rclonelink"), []byte("regular content"), 0600))
+	imageDir := t.TempDir()
+	cmd := exec.Command(mksquashfs, input, filepath.Join(imageDir, "links.sqfs"), "-noappend", "-processors", "1")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("mksquashfs failed: %v\n%s", err, output)
+	}
+
+	localFs, err := fscache.Get(ctx, imageDir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	assert.NotContains(t, entryRemotes(entries), "link.txt.rclonelink")
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctx, ci = fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(ctx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = f.List(ctx, "")
+	require.NoError(t, err)
+	assert.Contains(t, entryRemotes(entries), "link.txt.rclonelink")
+	assert.Contains(t, entryRemotes(entries), "regular.rclonelink")
+
+	link, err := f.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("target.txt")), link.Size())
+	assert.Equal(t, "target.txt", readSquashfsObject(ctx, t, link))
+	assert.Equal(t, "arget", readSquashfsObject(ctx, t, link, &fs.RangeOption{Start: 1, End: 5}))
+	assert.Equal(t, "rget.txt", readSquashfsObject(ctx, t, link, &fs.SeekOption{Offset: 2}))
+
+	dstRoot := t.TempDir()
+	dst, err := fscache.Get(ctx, dstRoot)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, "copied.rclonelink", link)
+	require.NoError(t, err)
+	target, err := os.Readlink(filepath.Join(dstRoot, "copied"))
+	require.NoError(t, err)
+	assert.Equal(t, "target.txt", target)
+
+	regular, err := f.NewObject(ctx, "regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "regular content", readSquashfsObject(ctx, t, regular))
+
+	single, err := New(ctx, localFs, "links.sqfs", "", "link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorIsFile)
+	require.NotNil(t, single)
+	entries, err = single.List(ctx, "")
+	require.NoError(t, err)
+	require.Equal(t, []string{"link.txt.rclonelink"}, entryRemotes(entries))
+	singleLink, err := single.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "target.txt", readSquashfsObject(ctx, t, singleLink))
+}
+
+func entryRemotes(entries fs.DirEntries) []string {
+	remotes := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	return remotes
+}
+
+func readSquashfsObject(ctx context.Context, t *testing.T, obj fs.Object, options ...fs.OpenOption) string {
+	rc, err := obj.Open(ctx, options...)
+	require.NoError(t, err)
+	defer func() { assert.NoError(t, rc.Close()) }()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(data)
+}
