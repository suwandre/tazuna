+// writeZipWithSymlinks creates a ZIP containing members with explicit modes.
+func writeZipWithSymlinks(t *testing.T, dir, name string, entries map[string]struct {
+	content string
+	mode    os.FileMode
+}) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for name, entry := range entries {
+		header := &zip.FileHeader{Name: name}
+		header.SetMode(entry.mode)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
