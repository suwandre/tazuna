+	f, err = New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	remotes := allRemotes(t, f)
+	assert.Contains(t, remotes, "src/link.txt.rclonelink")
+	assert.Contains(t, remotes, "src/regular.rclonelink")
+	assert.NotContains(t, remotes, "src/evil/escape.txt")
+
+	link, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	assert.Equal(t, "file.txt", readObject(ctx, t, link))
+	assert.Equal(t, "ile", readObject(ctx, t, link, &fs.RangeOption{Start: 1, End: 3}))
+	assert.Equal(t, "le.txt", readObject(ctx, t, link, &fs.SeekOption{Offset: 2}))
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	dstRoot := t.TempDir()
+	if err := os.Symlink("target", filepath.Join(dstRoot, "symlink-test")); err != nil {
+		t.Logf("skipping local symlink copy check: %v", err)
+	} else {
+		dst, err := cache.Get(ctx, dstRoot)
+		require.NoError(t, err)
+		_, err = operations.Copy(ctx, dst, nil, "copied.rclonelink", link)
+		require.NoError(t, err)
+		target, err := os.Readlink(filepath.Join(dstRoot, "copied"))
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", target)
+	}
+
+	regular, err := f.NewObject(ctx, "src/regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "regular content", readObject(ctx, t, regular))
+	_, err = f.NewObject(ctx, "src/evil/escape.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	single, err := New(ctx, localFs, name, "", "src/link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorIsFile)
+	require.NotNil(t, single)
+	entries, err := single.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt.rclonelink", entries[0].Remote())
+	singleLink, err := single.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", readObject(ctx, t, singleLink))
+}
+
+func readObject(ctx context.Context, t *testing.T, obj fs.Object, options ...fs.OpenOption) string {
+	rc, err := obj.Open(ctx, options...)
+	require.NoError(t, err)
+	defer func() { assert.NoError(t, rc.Close()) }()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(data)
+}
