+//go:build !plan9
+
+package archive
+
+import (
+	"archive/zip"
+	"context"
+	"fmt"
+	"io"
+	"log/slog"
+	"os"
+	"path"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/cache"
+	"github.com/rclone/rclone/fs/config/configmap"
+	"github.com/rclone/rclone/fs/log"
+	"github.com/rclone/rclone/fs/sync"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+var archiveLinkTargets = map[string]string{
+	"link.txt":        "file.txt",
+	"dirlink":         ".",
+	"dangling":        "missing",
+	"absolute":        "/absolute",
+	"link.rclonelink": "file.txt",
+}
+
+func writeSymlinkArchive(t *testing.T, extension string) string {
+	t.Helper()
+	name := filepath.Join(t.TempDir(), "links"+extension)
+	if extension == ".sqfs" {
+		data, err := os.ReadFile("squashfs/testdata/symlinks.sqfs")
+		require.NoError(t, err)
+		require.NoError(t, os.WriteFile(name, data, 0600))
+		return name
+	}
+	out, err := os.Create(name)
+	require.NoError(t, err)
+	zw := zip.NewWriter(out)
+	add := func(name, data string, mode os.FileMode) {
+		h := &zip.FileHeader{Name: "src/" + name, Method: zip.Deflate, Modified: time.Unix(1700000000, 0)}
+		h.SetMode(mode)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = io.WriteString(w, data)
+		require.NoError(t, err)
+	}
+	add("file.txt", "hello", 0644)
+	add("regular.rclonelink", "ordinary", 0644)
+	for name, target := range archiveLinkTargets {
+		add(name, target, os.ModeSymlink|0777)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, out.Close())
+	return name
+}
+
+func readArchiveObject(ctx context.Context, t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	t.Helper()
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
+
+func TestArchiveSymlinks(t *testing.T) {
+	for _, extension := range []string{".zip", ".sqfs"} {
+		a := findArchive("links" + extension).archiver
+		t.Run(a.Extension, func(t *testing.T) {
+			for _, links := range []bool{false, true} {
+				t.Run(map[bool]string{false: "Skip", true: "Links"}[links], func(t *testing.T) {
+					ctx, ci := fs.AddConfig(context.Background())
+					ci.Links = links
+					name := writeSymlinkArchive(t, a.Extension)
+					localFs, err := cache.Get(ctx, filepath.Dir(name))
+					require.NoError(t, err)
+					for _, mount := range []struct{ prefix, root string }{
+						{},
+						{prefix: "archive" + a.Extension},
+						{root: "src"},
+					} {
+						t.Run(mount.prefix+"/"+mount.root, func(t *testing.T) {
+							var notice atomic.Bool
+							log.Handler.SetOutput(func(level slog.Level, text string) {
+								if level == fs.SlogLevelNotice && strings.Contains(text, "--links") {
+									notice.Store(true)
+								}
+							})
+							t.Cleanup(log.Handler.ResetOutput)
+							f, err := a.New(ctx, localFs, filepath.Base(name), mount.prefix, mount.root)
+							require.NoError(t, err)
+							dir := path.Join(mount.prefix, "src")
+							if mount.root != "" {
+								dir = ""
+							}
+							entries, err := f.List(ctx, dir)
+							require.NoError(t, err)
+							assert.Equal(t, !links, notice.Load(), "skipped symlinks should produce a notice naming --links")
+							want := map[string]string{
+								path.Join(dir, "file.txt"):           "hello",
+								path.Join(dir, "regular.rclonelink"): "ordinary",
+							}
+							for name, target := range archiveLinkTargets {
+								_, err := f.NewObject(ctx, path.Join(dir, name))
+								assert.ErrorIs(t, err, fs.ErrorObjectNotFound, name)
+								remote := path.Join(dir, name+fs.LinkSuffix)
+								if links {
+									want[remote] = target
+								} else {
+									_, err := f.NewObject(ctx, remote)
+									assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+								}
+							}
+							require.Len(t, entries, len(want))
+							for _, entry := range entries {
+								listed, ok := entry.(fs.Object)
+								require.True(t, ok)
+								data, ok := want[entry.Remote()]
+								require.True(t, ok, entry.Remote())
+								o, err := f.NewObject(ctx, entry.Remote())
+								require.NoError(t, err)
+								for _, obj := range []fs.Object{listed, o} {
+									assert.Equal(t, entry.Remote(), obj.Remote())
+									assert.Equal(t, int64(len(data)), obj.Size())
+									assert.Equal(t, int64(1700000000), obj.ModTime(ctx).Unix())
+									assert.Equal(t, data, readArchiveObject(ctx, t, obj))
+									assert.Equal(t, data[1:], readArchiveObject(ctx, t, obj, &fs.SeekOption{Offset: 1}))
+									assert.Equal(t, data[:1], readArchiveObject(ctx, t, obj, &fs.RangeOption{Start: 0, End: 0}))
+									assert.Equal(t, data[len(data)-1:], readArchiveObject(ctx, t, obj, &fs.RangeOption{Start: -1, End: 1}))
+								}
+							}
+							_, err = f.NewObject(ctx, path.Join(dir, "file.txt"+fs.LinkSuffix))
+							assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+						})
+					}
+					if links {
+						f, err := a.New(ctx, localFs, filepath.Base(name), "", "src/link.txt"+fs.LinkSuffix)
+						require.ErrorIs(t, err, fs.ErrorIsFile)
+						entries, err := f.List(ctx, "")
+						require.NoError(t, err)
+						require.Len(t, entries, 1)
+						o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+						require.NoError(t, err)
+						assert.Equal(t, "file.txt", readArchiveObject(ctx, t, o))
+					}
+				})
+			}
+		})
+	}
+}
+
+func skipIfNoArchiveSymlinks(t *testing.T) {
+	t.Helper()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "probe")); err != nil {
+		t.Skipf("symlinks not supported: %v", err)
+	}
+}
+
+func TestArchiveCopySymlinks(t *testing.T) {
+	for _, extension := range []string{".zip", ".sqfs"} {
+		a := findArchive("links" + extension).archiver
+		t.Run(a.Extension, func(t *testing.T) {
+			ctx, ci := fs.AddConfig(context.Background())
+			ci.Links = true
+			out := t.TempDir()
+			skipIfNoArchiveSymlinks(t)
+			name := writeSymlinkArchive(t, a.Extension)
+			src, err := NewFs(ctx, "archive", name+"/src", configmap.Simple{})
+			require.NoError(t, err)
+			dst, err := cache.Get(ctx, out)
+			require.NoError(t, err)
+			require.NoError(t, sync.CopyDir(ctx, dst, src, false))
+			for name, target := range archiveLinkTargets {
+				got, err := os.Readlink(filepath.Join(out, name))
+				require.NoError(t, err)
+				assert.Equal(t, target, got)
+			}
+			data, err := os.ReadFile(filepath.Join(out, "file.txt"))
+			require.NoError(t, err)
+			assert.Equal(t, "hello", string(data))
+		})
+	}
+}
+
+func TestArchiveZipSymlinkTraversal(t *testing.T) {
+	for _, linkFirst := range []bool{false, true} {
+		for _, links := range []bool{false, true} {
+			t.Run(fmt.Sprintf("LinkFirst=%v/Links=%v", linkFirst, links), func(t *testing.T) {
+				ctx, ci := fs.AddConfig(context.Background())
+				ci.Links = links
+				name := filepath.Join(t.TempDir(), "evil.zip")
+				out, err := os.Create(name)
+				require.NoError(t, err)
+				zw := zip.NewWriter(out)
+				add := func(name, data string, mode os.FileMode) {
+					h := &zip.FileHeader{Name: name}
+					h.SetMode(mode)
+					w, err := zw.CreateHeader(h)
+					require.NoError(t, err)
+					_, err = io.WriteString(w, data)
+					require.NoError(t, err)
+				}
+				if linkFirst {
+					add("./escape", "../outside", os.ModeSymlink|0777)
+				}
+				add("escape/", "", os.ModeDir|0755)
+				add("escape/nested/pwn.txt", "overwritten", 0644)
+				if !linkFirst {
+					add("./escape", "../outside", os.ModeSymlink|0777)
+				}
+				add("escape-other/safe.txt", "safe", 0644)
+				require.NoError(t, zw.Close())
+				require.NoError(t, out.Close())
+
+				src, err := NewFs(ctx, "archive", name, configmap.Simple{})
+				require.NoError(t, err)
+				_, err = src.NewObject(ctx, "escape/nested/pwn.txt")
+				require.ErrorIs(t, err, fs.ErrorObjectNotFound)
+				entries, err := src.List(ctx, "")
+				require.NoError(t, err)
+				for _, entry := range entries {
+					assert.NotEqual(t, "escape", entry.Remote())
+				}
+				for _, root := range []string{"escape", "escape/nested", "escape/nested/pwn.txt"} {
+					rooted, err := NewFs(ctx, "archive", name+"/"+root, configmap.Simple{})
+					require.NoError(t, err)
+					entries, err := rooted.List(ctx, "")
+					if err != nil {
+						assert.ErrorIs(t, err, fs.ErrorDirNotFound)
+					}
+					assert.Empty(t, entries)
+				}
+
+				if links {
+					skipIfNoArchiveSymlinks(t)
+				}
+				dir := t.TempDir()
+				require.NoError(t, os.MkdirAll(filepath.Join(dir, "outside", "nested"), 0700))
+				victim := filepath.Join(dir, "outside", "nested", "pwn.txt")
+				require.NoError(t, os.WriteFile(victim, []byte("untouched"), 0600))
+				dst, err := cache.Get(ctx, filepath.Join(dir, "out"))
+				require.NoError(t, err)
+				require.NoError(t, sync.CopyDir(ctx, dst, src, false))
+				data, err := os.ReadFile(victim)
+				require.NoError(t, err)
+				assert.Equal(t, "untouched", string(data))
+				data, err = os.ReadFile(filepath.Join(dir, "out", "escape-other", "safe.txt"))
+				require.NoError(t, err)
+				assert.Equal(t, "safe", string(data))
+			})
+		}
+	}
+}
