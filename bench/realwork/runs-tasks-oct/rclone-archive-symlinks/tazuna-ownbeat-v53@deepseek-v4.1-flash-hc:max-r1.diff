+
+			// The archive exposes both the symlink and the member through it
+			assert.Equal(t, []string{"pwn" + fs.LinkSuffix, "pwn/authkeys"}, allRemotes(t, f))
+
+			// Copying into a local destination that supports symlinks must
+			// not write through the planted symlink. The local backend
+			// refuses, so the copy may report an error - what matters is
+			// nothing escaped.
+			dst := filepath.Join(parent, "dst")
+			require.NoError(t, os.Mkdir(dst, 0777))
+			dstFs, err := cache.Get(ctx, dst)
+			require.NoError(t, err)
+			_ = sync.CopyDir(ctx, dstFs, f, false)
+			_, err = os.Stat(evilFile)
+			assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evilFile)
+		})
+	}
+}
