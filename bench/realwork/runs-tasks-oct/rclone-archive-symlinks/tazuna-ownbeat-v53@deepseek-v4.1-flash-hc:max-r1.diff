+// writeZipSymlinks builds a zip file in dir with a regular file and
+// symlink entries. symlinks maps an entry name to its target.
+func writeZipSymlinks(t *testing.T, dir, name string, symlinks map[string]string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("hello"))
+	require.NoError(t, err)
+	for link, target := range symlinks {
+		hdr := &zip.FileHeader{Name: link, Method: zip.Store}
+		hdr.SetMode(os.ModeSymlink | 0o777)
+		lw, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = lw.Write([]byte(target))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
