+// readlinker is implemented by squashfs directory entries which can
+// return the target of a symbolic link.
+type readlinker interface {
+	Readlink() (string, error)
+}
+
+// objectFromEntry converts a directory entry into an Object from
+// native dir. A symlink becomes a translated link: its remote gains
+// the .rclonelink suffix and its size is the length of the target.
+func (f *Fs) objectFromEntry(nativeDir string, item iofs.DirEntry) (*Object, error) {
+	info, err := item.Info()
+	if err != nil {
+		return nil, err
+	}
+	o := f.objectFromFileInfo(nativeDir, info)
+	if item.Type()&os.ModeSymlink == 0 {
+		return o, nil
+	}
+	rl, ok := item.(readlinker)
+	if !ok {
+		return nil, fmt.Errorf("internal error: %T can't read a symlink target", item)
+	}
+	target, err := rl.Readlink()
+	if err != nil {
+		return nil, err
+	}
+	o.remote += fs.LinkSuffix
+	o.isLink = true
+	o.link = target
+	o.size = int64(len(target))
+	return o, nil
+}
