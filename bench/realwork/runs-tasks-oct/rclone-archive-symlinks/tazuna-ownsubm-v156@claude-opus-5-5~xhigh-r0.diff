+// openSymlink returns the symlink target as the file contents
+func (o *Object) openSymlink(ctx context.Context, offset, limit int64) (io.ReadCloser, error) {
+	// Strip the .rclonelink suffix to get the actual symlink path
+	remote := strings.TrimSuffix(o.remote, fs.LinkSuffix)
+	nativePath, err := o.fs.toNative(remote)
+	if err != nil {
+		return nil, err
+	}
+
+	// Read the symlink target from the squashfs
+	fh, err := o.fs.sqfs.OpenFile(toIOFS(nativePath), os.O_RDONLY)
+	if err != nil {
+		return nil, err
+	}
+	defer fh.Close()
+	
+	target, err := io.ReadAll(fh)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read symlink target: %w", err)
+	}
+	
+	// Validate that the target doesn't escape the archive root
+	targetStr := string(target)
+	if err := validateSymlinkTarget(targetStr); err != nil {
+		return nil, err
+	}
+	
+	// Clamp offset into range to avoid panic
+	if offset < 0 {
+		offset = 0
+	}
+	if offset > int64(len(target)) {
+		offset = int64(len(target))
+	}
+	
+	return readers.NewLimitedReadCloser(io.NopCloser(strings.NewReader(targetStr[offset:])), limit), nil
+}
+
+// validateSymlinkTarget checks that a symlink target doesn't escape the archive
+func validateSymlinkTarget(target string) error {
+	// Clean the target path
+	cleaned := path.Clean(target)
+	
+	// Check if it's an absolute path or tries to escape via ../
+	if path.IsAbs(cleaned) || strings.HasPrefix(cleaned, "../") {
+		return fmt.Errorf("symlink target %q escapes archive root", target)
+	}
+	
+	return nil
+}
+
 // Update in to the object with the modTime given of the given size
