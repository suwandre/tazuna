+		for _, entry := range entries {
+			subRemotes = append(subRemotes, entry.Remote())
+		}
+		assert.ElementsMatch(t, []string{"sub/a.txt", "sub/b.txt" + fs.LinkSuffix}, subRemotes)
+	})
