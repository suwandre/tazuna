+
+		// The symlink is exposed with the suffix and its target as contents
+		o, err = f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readAll(t, o))
+
+		// Open must honour seek and range options
+		rc, err := o.Open(ctx, &fs.SeekOption{Offset: 2})
+		require.NoError(t, err)
+		got, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "le.txt", string(got))
+
+		rc, err = o.Open(ctx, &fs.RangeOption{Start: 1, End: 3})
+		require.NoError(t, err)
+		got, err = io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "ile", string(got))
+	})
+
+	t.Run("SingleObject", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(context.Background())
+		ci.Links = true
+		f, err := New(ctx, localFs, name, "", "src/link.txt"+fs.LinkSuffix)
+		require.ErrorIs(t, err, fs.ErrorIsFile)
+		require.NotNil(t, f)
+
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		require.Len(t, entries, 1)
+		assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+
+		o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readAll(t, o))
+	})
+}
+
+// readAll reads and closes an object.
+func readAll(t *testing.T, o fs.Object) string {
+	rc, err := o.Open(context.Background())
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
