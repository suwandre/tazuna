+func (f *Fs) objectFromEntry(nativeDir string, item iofs.DirEntry) (*Object, error) {
+	if item.IsDir() {
+		return nil, fs.ErrorNotAFile
+	}
+	isLink := item.Type()&os.ModeSymlink != 0
+	if isLink && !f.links {
+		return nil, fs.ErrorObjectNotFound
+	}
+	info, err := item.Info()
+	if err != nil {
+		return nil, fmt.Errorf("error reading item %q: %w", item.Name(), err)
+	}
+	o := f.objectFromFileInfo(nativeDir, info)
+	if isLink {
+		target, err := readLink(item)
+		if err != nil {
+			return nil, fmt.Errorf("error reading link %q: %w", item.Name(), err)
+		}
+		o.remote += fs.LinkSuffix
+		o.size = int64(len(target))
+		o.linkTarget = target
+		o.isLink = true
+	}
+	return o, nil
