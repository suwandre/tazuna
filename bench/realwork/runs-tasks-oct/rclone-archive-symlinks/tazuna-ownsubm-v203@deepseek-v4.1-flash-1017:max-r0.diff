+// writeZipSymlinks builds a zip file in dir containing regular entries
+// (name -> contents) and symlink entries (name -> link target), and
+// returns its leaf name.
+func writeZipSymlinks(t *testing.T, dir, name string, files map[string]string, links map[string]string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for n, contents := range files {
+		w, err := zw.Create(n)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(contents))
+		require.NoError(t, err)
+	}
+	for n, target := range links {
+		h := &zip.FileHeader{Name: n, Method: zip.Store}
+		h.SetMode(os.ModeSymlink | 0777)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(target))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
