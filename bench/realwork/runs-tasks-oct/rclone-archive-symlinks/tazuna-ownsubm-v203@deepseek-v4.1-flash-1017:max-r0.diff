+// skipIfNoSymlinks skips the test if this process can't create symlinks.
+func skipIfNoSymlinks(t *testing.T) {
+	t.Helper()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("Skipping as symlinks are unavailable: %v", err)
+	}
+}
+
+// TestArchiveSymlinkEscape checks that a hostile archive can't make a
+// copy write outside the destination: it holds a symlink "pwn" pointing
+// above the root plus a member "pwn/authkeys" which would be written
+// through it.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	skipIfNoSymlinks(t)
+	fstest.Initialise()
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	outside := t.TempDir()
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	h := &zip.FileHeader{Name: "pwn", Method: zip.Store}
+	h.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(h)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(outside))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(t.TempDir(), "evil.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	fsrc, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	// The symlink must be listed under its translated name
+	entries, err := fsrc.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 2)
+
+	fdst, err := cache.Get(ctx, t.TempDir())
+	require.NoError(t, err)
+	// The copy may fail, but it must not write through the symlink
+	_ = sync.CopyDir(ctx, fdst, fsrc, false)
+
+	_, err = os.Stat(filepath.Join(outside, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", outside)
+}
