+		}
+		assert.ElementsMatch(t, []string{"file.txt", "regular.rclonelink", "sub"}, remotes)
+
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(context.Background())
+		ci.Links = true
+		f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+		require.NoError(t, err)
+
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.ElementsMatch(t, []string{
+			"file.txt",
+			"link.txt" + fs.LinkSuffix,
+			"escape.txt" + fs.LinkSuffix,
+			"regular.rclonelink",
+			"sub",
+		}, remotes)
+
+		// The symlink isn't visible under its plain name
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// A regular file ending in .rclonelink stays a regular file
