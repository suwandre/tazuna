+// TestSymlinks checks that symlinks in a squashfs image are skipped
+// unless -l/--links is in use, and then exposed as .rclonelink files
+// whose contents are the link target.
+//
+// symlink.sqfs holds:
+//
+//	file.txt             "hello world"
+//	link.txt      ->     file.txt
+//	escape.txt    ->     ../../outside
+//	regular.rclonelink   "data"
+//	sub/a.txt            "sub data"
+//	sub/b.txt     ->     a.txt
+func TestSymlinks(t *testing.T) {
+	localFs, err := fscache.Get(context.Background(), "testdata")
+	require.NoError(t, err)
+
+	t.Run("NoLinks", func(t *testing.T) {
