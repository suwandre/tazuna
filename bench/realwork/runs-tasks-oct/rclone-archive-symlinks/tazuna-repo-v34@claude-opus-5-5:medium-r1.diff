+// makeSquashfs creates a squashfs image called name in dir from the
+// files and symlinks given and returns its leaf name.
+func makeSquashfs(t *testing.T, dir, name string, files, links map[string]string) string {
+	const size = 1024 * 1024
+	b, err := file.CreateFromPath(filepath.Join(dir, name), size)
+	require.NoError(t, err)
+	defer func() { require.NoError(t, b.Close()) }()
+	sqfs, err := squashfs.Create(b, size, 0, 4096)
+	require.NoError(t, err)
+	ws := sqfs.Workspace()
+	for p, data := range files {
+		require.NoError(t, os.MkdirAll(filepath.Join(ws, filepath.Dir(p)), 0777))
+		require.NoError(t, os.WriteFile(filepath.Join(ws, p), []byte(data), 0666))
+	}
+	for p, target := range links {
+		require.NoError(t, os.MkdirAll(filepath.Join(ws, filepath.Dir(p)), 0777))
+		require.NoError(t, os.Symlink(target, filepath.Join(ws, p)))
+	}
+	// Finalize reads symlink targets relative to the current directory
+	// and needs them to exist
+	t.Chdir(ws)
+	require.NoError(t, sqfs.Finalize(squashfs.FinalizeOptions{}))
+	return name
+}
+
+// listRemotes returns the remotes of the entries in dir
+func listRemotes(ctx context.Context, t *testing.T, f fs.Fs, dir string) (remotes []string) {
+	entries, err := f.List(ctx, dir)
+	require.NoError(t, err)
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	sort.Strings(remotes)
+	return remotes
+}
+
+// readObject reads the contents of remote in f with the options given
+func readObject(ctx context.Context, t *testing.T, f fs.Fs, remote string, options ...fs.OpenOption) string {
+	o, err := f.NewObject(ctx, remote)
+	require.NoError(t, err)
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
+
+// Symlinks are skipped unless --links is in use, in which case they
+// are exposed as .rclonelink files containing the link target.
+func TestSymlinks(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("creating symlinks needs extra privileges on Windows")
+	}
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := makeSquashfs(t, dir, "test.sqfs", map[string]string{
+		"src/file.txt":         "hello",
+		"real.rclonelink":      "real",
+		"target":               "target",
+		"clash.rclonelink":     "clash",
+		"dir.rclonelink/a.txt": "a",
+		"plain/inner/file.txt": "inner",
+	}, map[string]string{
+		"src/link.txt": "file.txt",
+		"clash":        "target",
+		"dir":          "target",
+		"escape":       "../../../../../../../../../../tmp",
+	})
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	t.Run("NoLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"clash.rclonelink", "dir.rclonelink", "plain", "real.rclonelink", "src", "target"}, listRemotes(ctx, t, f, ""))
+		assert.Equal(t, []string{"src/file.txt"}, listRemotes(ctx, t, f, "src"))
+		for _, remote := range []string{"src/link.txt", "src/link.txt.rclonelink", "escape", "escape.rclonelink"} {
+			_, err = f.NewObject(ctx, remote)
+			assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+		}
+		assert.Equal(t, "real", readObject(ctx, t, f, "real.rclonelink"))
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(ctx)
+		ci.Links = true
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"clash.rclonelink", "dir.rclonelink", "escape.rclonelink", "plain", "real.rclonelink", "src", "target"}, listRemotes(ctx, t, f, ""))
+		assert.Equal(t, []string{"src/file.txt", "src/link.txt.rclonelink"}, listRemotes(ctx, t, f, "src"))
+
+		o, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(ctx, t, f, "src/link.txt.rclonelink"))
+		assert.Equal(t, "le.t", readObject(ctx, t, f, "src/link.txt.rclonelink", &fs.RangeOption{Start: 2, End: 5}))
+		assert.Equal(t, "xt", readObject(ctx, t, f, "src/link.txt.rclonelink", &fs.SeekOption{Offset: 6}))
+		assert.Equal(t, "../../../../../../../../../../tmp", readObject(ctx, t, f, "escape.rclonelink"))
+		assert.Equal(t, "clash", readObject(ctx, t, f, "clash.rclonelink"))
+		_, err = f.NewObject(ctx, "dir.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorNotAFile)
+		for _, remote := range []string{"src/link.txt", "escape", "src/file.txt.rclonelink"} {
+			_, err = f.NewObject(ctx, remote)
+			assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+		}
+
+		// Root pointing at a symlink
+		f, err = New(ctx, localFs, name, "", "src/link.txt.rclonelink")
+		require.ErrorIs(t, err, fs.ErrorIsFile)
+		assert.Equal(t, []string{"link.txt.rclonelink"}, listRemotes(ctx, t, f, ""))
+
+		// Copying the archive recreates the symlinks
+		f, err = New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		dst := filepath.Join(t.TempDir(), "out")
+		dstFs, err := fscache.Get(ctx, dst)
+		require.NoError(t, err)
+		require.NoError(t, sync.CopyDir(ctx, dstFs, f, false))
+		target, err := os.Readlink(filepath.Join(dst, "src", "link.txt"))
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", target)
+		data, err := os.ReadFile(filepath.Join(dst, "plain", "inner", "file.txt"))
+		require.NoError(t, err)
+		assert.Equal(t, "inner", string(data))
+	})
+}
