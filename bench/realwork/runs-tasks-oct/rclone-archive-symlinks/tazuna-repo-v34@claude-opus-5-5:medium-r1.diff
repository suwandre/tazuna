+// readLinkTarget reads the target of the symlink stored in file
+func readLinkTarget(file *zip.File) (linkTarget string, err error) {
+	const maxLinkTarget = 4096
+	rc, err := file.Open()
+	if err != nil {
+		return "", err
+	}
+	defer fs.CheckClose(rc, &err)
+	target, err := io.ReadAll(io.LimitReader(rc, maxLinkTarget+1))
+	if err != nil {
+		return "", err
+	}
+	if len(target) > maxLinkTarget {
+		return "", errors.New("symlink target too long")
+	}
+	return string(target), nil
+}
