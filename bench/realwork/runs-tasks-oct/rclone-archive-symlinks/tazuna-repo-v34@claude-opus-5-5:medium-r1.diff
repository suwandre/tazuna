+// readObject reads the contents of remote in f with the options given
+func readObject(ctx context.Context, t *testing.T, f fs.Fs, remote string, options ...fs.OpenOption) string {
+	o, err := f.NewObject(ctx, remote)
+	require.NoError(t, err)
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
+
+// Symlinks are skipped unless --links is in use, in which case they
+// are exposed as .rclonelink files containing the link target.
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "test.zip",
+		zipEntry{name: "src/file.txt"},
+		zipEntry{name: "src/link.txt", link: "file.txt"},
+		zipEntry{name: "real.rclonelink"},
+		zipEntry{name: "other/link", link: "../src"},
+	)
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	t.Run("NoLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"real.rclonelink", "src/file.txt"}, allRemotes(t, f))
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "src/link.txt.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		assert.Equal(t, "data for real.rclonelink", readObject(ctx, t, f, "real.rclonelink"))
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(ctx)
+		ci.Links = true
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"other/link.rclonelink", "real.rclonelink", "src/file.txt", "src/link.txt.rclonelink"}, allRemotes(t, f))
+
+		o, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(ctx, t, f, "src/link.txt.rclonelink"))
+		assert.Equal(t, "le.t", readObject(ctx, t, f, "src/link.txt.rclonelink", &fs.RangeOption{Start: 2, End: 5}))
+		assert.Equal(t, "xt", readObject(ctx, t, f, "src/link.txt.rclonelink", &fs.SeekOption{Offset: 6}))
+		assert.Equal(t, "../src", readObject(ctx, t, f, "other/link.rclonelink"))
+		assert.Equal(t, "data for real.rclonelink", readObject(ctx, t, f, "real.rclonelink"))
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// Root pointing at a symlink
+		f, err = New(ctx, localFs, name, "", "src/link.txt.rclonelink")
+		require.ErrorIs(t, err, fs.ErrorIsFile)
+		assert.Equal(t, []string{"link.txt.rclonelink"}, allRemotes(t, f))
+	})
+}
+
+// A symlink which clashes with another entry, or which has entries
+// inside it, must be dropped so a copy can't be made to write through
+// it.
+func TestSymlinkClashes(t *testing.T) {
+	ctx := context.Background()
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "test.zip",
+		zipEntry{name: "evil", link: "../../../../../../tmp"},
+		zipEntry{name: "evil/pwned.txt"},
+		zipEntry{name: "nested", link: ".."},
+		zipEntry{name: "nested/inner", link: "/etc"},
+		zipEntry{name: "clash", link: "target"},
+		zipEntry{name: "clash.rclonelink"},
+		zipEntry{name: "same", link: "target"},
+		zipEntry{name: "same"},
+		zipEntry{name: "twice", link: "one"},
+		zipEntry{name: "twice", link: "two"},
+	)
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"clash.rclonelink", "evil/pwned.txt", "nested/inner.rclonelink", "same", "twice.rclonelink"}, allRemotes(t, f))
+	assert.Equal(t, "data for clash.rclonelink", readObject(ctx, t, f, "clash.rclonelink"))
+	assert.Equal(t, "one", readObject(ctx, t, f, "twice.rclonelink"))
+	_, err = f.NewObject(ctx, "evil.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	if runtime.GOOS == "windows" {
+		t.Skip("creating symlinks needs extra privileges on Windows")
+	}
+	// Copying the archive must keep everything inside the destination
+	dst := filepath.Join(t.TempDir(), "out")
+	dstFs, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, dstFs, f, false))
+	fi, err := os.Lstat(filepath.Join(dst, "evil"))
+	require.NoError(t, err)
+	assert.True(t, fi.IsDir())
+	data, err := os.ReadFile(filepath.Join(dst, "evil", "pwned.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "data for evil/pwned.txt", string(data))
+	target, err := os.Readlink(filepath.Join(dst, "twice"))
+	require.NoError(t, err)
+	assert.Equal(t, "one", target)
+}
