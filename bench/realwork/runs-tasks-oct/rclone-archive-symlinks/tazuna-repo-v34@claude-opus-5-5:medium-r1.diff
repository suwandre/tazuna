+// addLinks adds the symlinks in links to dt
+//
+// A symlink is dropped if its name clashes with any other entry, or if
+// any other entry lives inside it, so a copy can never write through a
+// symlink and a regular file whose name ends in fs.LinkSuffix wins.
+//
+// Returns singleObject=true if f.root points to a symlink, in which
+// case dt is replaced by one containing just that symlink.
+func (f *Fs) addLinks(dt *dirtree.DirTree, links []*Object) (singleObject bool) {
+	for _, o := range links {
+		if o.remote == "" {
+			if len(*dt) > 0 {
+				fs.Logf(f, "Skipping symlink %q which clashes with a directory", f.root)
+				return false
+			}
+			o.remote = path.Base(f.root)
+			*dt = dirtree.New()
+			dt.Add(o)
+			return true
+		}
+	}
+	// Make sure the directories containing symlinks exist before
+	// looking for clashes with them
+	for _, o := range links {
+		if dir := path.Dir(o.remote); dir != "." {
+			if _, ok := (*dt)[dir]; !ok {
+				(*dt)[dir] = nil
+			}
+		}
+	}
+	dt.CheckParents("")
+	for _, o := range links {
+		name := strings.TrimSuffix(o.remote, fs.LinkSuffix)
+		_, isDir := (*dt)[name]
+		_, sameName := dt.Find(name)
+		_, sameLinkName := dt.Find(o.remote)
+		if isDir || sameName != nil || sameLinkName != nil {
+			fs.Logf(f, "Skipping symlink %q which clashes with another entry", name)
+			continue
+		}
+		dt.Add(o)
+	}
+	return false
+}
