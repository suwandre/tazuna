+func TestArchiveSymlinkEscapeBlocked(t *testing.T) {
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("Skipping as symlinks are unavailable: %v", err)
+	}
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	root := t.TempDir()
+	outside := filepath.Join(root, "outside")
+	require.NoError(t, os.Mkdir(outside, 0700))
+	zipPath := filepath.Join(root, "test.zip")
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	linkHeader := &zip.FileHeader{Name: "pwn"}
+	linkHeader.SetMode(os.ModeSymlink | 0o777)
+	linkWriter, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = linkWriter.Write([]byte("../outside"))
+	require.NoError(t, err)
+	fileWriter, err := zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = fileWriter.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dst, err := cache.Get(ctx, filepath.Join(root, "dst"))
+	require.NoError(t, err)
+
+	link, err := src.NewObject(ctx, "pwn.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, link.Remote(), link)
+	require.NoError(t, err)
+	linkPath := filepath.Join(root, "dst", "pwn")
+	fi, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	require.NotZero(t, fi.Mode()&os.ModeSymlink, "symlink should be reproduced")
+	target, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	require.Equal(t, "../outside", target)
+
+	child, err := src.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, child.Remote(), child)
+	require.Error(t, err, "writing through the archive symlink should be refused")
+	_, err = os.Stat(filepath.Join(outside, "authkeys"))
+	require.True(t, os.IsNotExist(err), "a file escaped the destination into %q", outside)
+}
