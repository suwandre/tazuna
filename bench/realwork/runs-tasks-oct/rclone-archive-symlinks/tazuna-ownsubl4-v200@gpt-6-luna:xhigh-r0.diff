+func TestReadZipSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipWithSymlink(t, dir, "symlinks.zip")
+	localFs, err := cache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	for _, test := range []struct {
+		name  string
+		links bool
+		want  []string
+	}{
+		{name: "without links", want: []string{"src/file.txt", "src/regular.rclonelink"}},
+		{name: "with links", links: true, want: []string{"src/file.txt", "src/link.txt.rclonelink", "src/regular.rclonelink"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			ctx, ci := fs.AddConfig(context.Background())
+			ci.Links = test.links
+			f, err := New(ctx, localFs, name, "", "")
+			require.NoError(t, err)
+			assert.Equal(t, test.want, allRemotes(t, f))
+
+			link, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+			if !test.links {
+				require.ErrorIs(t, err, fs.ErrorObjectNotFound)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, "src/link.txt.rclonelink", link.Remote())
+			assert.Equal(t, int64(len("file.txt")), link.Size())
+			for _, remote := range test.want {
+				if strings.HasPrefix(remote, "src/") {
+					obj, err := f.NewObject(ctx, remote)
+					require.NoError(t, err, remote)
+					assert.Equal(t, remote, obj.Remote())
+				}
+			}
+
+			read := func(options ...fs.OpenOption) string {
+				rc, err := link.Open(ctx, options...)
+				require.NoError(t, err)
+				defer rc.Close()
+				data, err := io.ReadAll(rc)
+				require.NoError(t, err)
+				return string(data)
+			}
+			assert.Equal(t, "file.txt", read())
+			assert.Equal(t, "ile", read(&fs.RangeOption{Start: 1, End: 3}))
+			assert.Equal(t, ".txt", read(&fs.SeekOption{Offset: 4}))
+
+			regular, err := f.NewObject(ctx, "src/regular.rclonelink")
+			require.NoError(t, err)
+			assert.Equal(t, int64(len("regular")), regular.Size())
+			regularReader, err := regular.Open(ctx)
+			require.NoError(t, err)
+			defer regularReader.Close()
+			data, err := io.ReadAll(regularReader)
+			require.NoError(t, err)
+			assert.Equal(t, "regular", string(data))
+
+			single, err := New(ctx, localFs, name, "", "src/link.txt.rclonelink")
+			require.ErrorIs(t, err, fs.ErrorIsFile)
+			link, err = single.NewObject(ctx, "link.txt.rclonelink")
+			require.NoError(t, err)
+			assert.Equal(t, "file.txt", readObject(t, ctx, link))
+		})
+	}
+}
