+func readObject(t *testing.T, ctx context.Context, obj fs.Object) string {
+	rc, err := obj.Open(ctx)
+	require.NoError(t, err)
+	defer rc.Close()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(data)
+}
