+func writeZipWithSymlink(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name, body string
+		mode       os.FileMode
+	}{
+		{name: "src/file.txt", body: "hello"},
+		{name: "src/link.txt", body: "file.txt", mode: os.ModeSymlink | 0o777},
+		{name: "src/regular.rclonelink", body: "regular"},
+	} {
+		header := &zip.FileHeader{Name: entry.name}
+		if entry.mode != 0 {
+			header.SetMode(entry.mode)
+		}
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
