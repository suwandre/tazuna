+			}{
+				{want: "file.txt"},
+				{option: &fs.SeekOption{Offset: 4}, want: ".txt"},
+				{option: &fs.RangeOption{Start: 1, End: 3}, want: "ile"},
+			} {
+				var options []fs.OpenOption
+				if rangeTest.option != nil {
