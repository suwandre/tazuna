@@ -3,8 +3,11 @@ package archiver
 
 import (
 	"context"
+	"io"
+	"strings"
 
 	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/lib/readers"
 )
 
 // Archiver describes an archive package
@@ -27,3 +30,60 @@ var Archivers []Archiver
 func Register(as ...Archiver) {
 	Archivers = append(Archivers, as...)
 }
+
+// MaxLinkTargetSize is the longest symbolic link target that is listed. It
+// is the longest path the Linux kernel accepts, and it limits the memory a
+// hostile archive can make rclone hold for each link.
+const MaxLinkTargetSize = 4096
+
+// SafeLinkTarget reports whether a symbolic link with this target may be
+// listed. A listed link is copied verbatim as a symbolic link, so its
+// target must be relative and must not contain a ".." element. Such an
+// element can climb out of the tree holding the link even when the path
+// looks contained, because it may be resolved after passing through
+// another link. Backslashes and colons are refused so that the target
+// means the same on every platform.
+func SafeLinkTarget(target string) bool {
+	if target == "" || len(target) > MaxLinkTargetSize || strings.HasPrefix(target, "/") || strings.ContainsAny(target, `\:`) {
+		return false
+	}
+	for _, part := range strings.Split(target, "/") {
+		if part == ".." {
+			return false
+		}
+	}
+	return true
+}
+
+// OpenLink returns the target of a symbolic link as the content of a
+// file, honouring any SeekOption or RangeOption in options.
+func OpenLink(target string, options ...fs.OpenOption) io.ReadCloser {
+	offset, limit := int64(0), int64(-1)
+	for _, option := range options {
+		switch x := option.(type) {
+		case *fs.SeekOption:
+			offset = x.Offset
+		case *fs.RangeOption:
+			offset, limit = x.Decode(int64(len(target)))
+		}
+	}
+	if offset < 0 {
+		offset = 0
+	}
+	if offset > int64(len(target)) {
+		offset = int64(len(target))
+	}
+	return readers.NewLimitedReadCloser(io.NopCloser(strings.NewReader(target[offset:])), limit)
+}
+
+// LogSkippedLinks logs a notice that an archive left links out of its
+// listing. Without links, symbolic links are skipped and the notice names
+// the flag which lists them. With links, the ones which cannot be listed
+// safely are skipped.
+func LogSkippedLinks(f fs.Fs, links bool) {
+	if links {
+		fs.Logf(f, "Skipped links with unsafe targets or conflicting names")
+		return
+	}
+	fs.Logf(f, "Skipped symbolic links, use -l/--links to list them")
+}
