+// zipEntry is a member of a zip file made by writeZipEntries. For a
+// symbolic link mode has os.ModeSymlink set and body is the target.
+type zipEntry struct {
+	name string
+	body string
+	mode os.FileMode
+}
+
+// writeZipEntries writes a zip file holding the given members in dir and
+// returns its leaf name.
+func writeZipEntries(t *testing.T, dir, name string, entries ...zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, e := range entries {
+		mode := e.mode
+		if mode == 0 {
+			mode = 0644
+		}
+		fh := zip.FileHeader{Name: e.name, Method: zip.Deflate}
+		fh.SetMode(mode)
+		w, err := zw.CreateHeader(&fh)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(e.body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
