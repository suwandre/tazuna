+
+// Symbolic links in an image are left out unless --links is set. With it a
+// link is listed under its name plus the .rclonelink suffix, provided its
+// target is relative and cannot climb out of the image. A regular member
+// keeps its name, and takes precedence over a link listed under the same
+// name. A regular member named like a link is left out under --links when
+// its content is not a safe target, since a local destination would turn it
+// into a link to that content. Special files such as FIFOs are never listed.
+// The image is made by mksquashfs from a tree holding the same members as the
+// linkEntries in the zip tests, except for the directory which cannot hold
+// both a link and the files under it.
+func TestReadSymlinks(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	t.Run("Off", func(t *testing.T) {
+		f, err := New(ctx, localFs, "symlinks.sqfs", "", "")
+		require.NoError(t, err)
+		assert.ElementsMatch(t, []string{"src"}, listRemotes(ctx, t, f, ""))
+		assert.ElementsMatch(t, []string{
+			"src/collide.rclonelink",
+			"src/evil.rclonelink",
+			"src/file.txt",
+			"src/regular.rclonelink",
+		}, listRemotes(ctx, t, f, "src"))
+		for _, remote := range []string{"dirlink.rclonelink", "src/link.txt.rclonelink", "src/pipe"} {
+			_, err := f.NewObject(ctx, remote)
+			assert.Equal(t, fs.ErrorObjectNotFound, err, remote)
+		}
+		o, err := f.NewObject(ctx, "src/evil.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "/etc/passwd", readObject(t, o))
+	})
+
+	t.Run("On", func(t *testing.T) {
+		f, err := New(linksCtx, localFs, "symlinks.sqfs", "", "")
+		require.NoError(t, err)
+		assert.ElementsMatch(t, []string{"dirlink.rclonelink", "src"}, listRemotes(linksCtx, t, f, ""))
+		assert.ElementsMatch(t, []string{
+			"src/collide.rclonelink",
+			"src/file.txt",
+			"src/link.txt.rclonelink",
+			"src/regular.rclonelink",
+		}, listRemotes(linksCtx, t, f, "src"))
+		for _, remote := range []string{
+			"dirlink",
+			"src/link.txt",
+			"src/collide",
+			"src/abs.rclonelink",
+			"src/up.rclonelink",
+			"src/evil.rclonelink",
+			"src/pipe",
+		} {
+			_, err := f.NewObject(linksCtx, remote)
+			assert.Equal(t, fs.ErrorObjectNotFound, err, remote)
+		}
+
+		o, err := f.NewObject(linksCtx, "src/link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(t, o))
+		assert.Equal(t, "le.", readObject(t, o, &fs.RangeOption{Start: 2, End: 4}))
+
+		o, err = f.NewObject(linksCtx, "dirlink.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "src", readObject(t, o))
+
+		o, err = f.NewObject(linksCtx, "src/regular.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "payload", readObject(t, o))
+
+		o, err = f.NewObject(linksCtx, "src/collide.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "plain", readObject(t, o))
+	})
+
+	// Opening the image at the name of a link gives the link, unless a regular
+	// member has that name, which then takes precedence
+	t.Run("Root", func(t *testing.T) {
+		for _, test := range []struct {
+			root, file, want string
+		}{
+			{"src/collide.rclonelink", "collide.rclonelink", "plain"},
+			{"src/link.txt.rclonelink", "link.txt.rclonelink", "file.txt"},
+		} {
+			f, err := New(linksCtx, localFs, "symlinks.sqfs", "", test.root)
+			require.Equal(t, fs.ErrorIsFile, err, test.root)
+			o, err := f.NewObject(linksCtx, test.file)
+			require.NoError(t, err)
+			assert.Equal(t, test.want, readObject(t, o), test.root)
+		}
+	})
+}
