+++ b/backend/archive/archiver/archiver_test.go
@@ -0,0 +1,57 @@
+package archiver
+
+import (
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSafeLinkTarget(t *testing.T) {
+	for _, test := range []struct {
+		target string
+		want   bool
+	}{
+		{"file.txt", true},
+		{"sub/file.txt", true},
+		{"./file.txt", true},
+		{"", false},
+		{"/etc/passwd", false},
+		{"../file.txt", false},
+		{"sub/../../file.txt", false},
+		{"link/../file.txt", false},
+		{`..\file.txt`, false},
+		{`sub\file.txt`, false},
+		{"C:file.txt", false},
+		{strings.Repeat("a", MaxLinkTargetSize), true},
+		{strings.Repeat("a", MaxLinkTargetSize+1), false},
+	} {
+		assert.Equal(t, test.want, SafeLinkTarget(test.target), "%q", test.target)
+	}
+}
+
+func TestOpenLink(t *testing.T) {
+	const target = "file.txt"
+	for _, test := range []struct {
+		name    string
+		options []fs.OpenOption
+		want    string
+	}{
+		{"None", nil, "file.txt"},
+		{"Range", []fs.OpenOption{&fs.RangeOption{Start: 2, End: 4}}, "le."},
+		{"RangeToEnd", []fs.OpenOption{&fs.RangeOption{Start: 5, End: -1}}, "txt"},
+		{"Seek", []fs.OpenOption{&fs.SeekOption{Offset: 5}}, "txt"},
+		{"SeekPastEnd", []fs.OpenOption{&fs.SeekOption{Offset: 100}}, ""},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			rc := OpenLink(target, test.options...)
+			data, err := io.ReadAll(rc)
+			require.NoError(t, err)
+			require.NoError(t, rc.Close())
+			assert.Equal(t, test.want, string(data))
+		})
+	}
+}
