+		assert.Equal(t, "file.txt", readObject(t, o))
+		assert.Equal(t, "le.", readObject(t, o, &fs.RangeOption{Start: 2, End: 4}))
+		assert.Equal(t, "txt", readObject(t, o, &fs.SeekOption{Offset: 5}))
+		assert.Equal(t, "", readObject(t, o, &fs.SeekOption{Offset: 100}))
+
+		o, err = f.NewObject(ctx, "dirlink.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "src", readObject(t, o))
