+		require.NoError(t, err)
+		assert.Equal(t, []string{
+			"dirlink.rclonelink",
+			"src/collide.rclonelink",
+			"src/file.txt",
+			"src/link.txt.rclonelink",
+			"src/regular.rclonelink",
+			"src/up/evil",
+		}, allRemotes(t, f))
+		for _, remote := range []string{
+			"dirlink",
+			"src/link.txt",
+			"src/collide",
+			"src/abs.rclonelink",
+			"src/up.rclonelink",
+			"src/chain.rclonelink",
+			"src/win.rclonelink",
+			"src/drive.rclonelink",
