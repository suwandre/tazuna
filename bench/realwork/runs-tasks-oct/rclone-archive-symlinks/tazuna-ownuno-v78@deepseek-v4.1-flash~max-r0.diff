+// TestSymlinks checks that symlinks are only exposed in --links mode,
+// under their .rclonelink name, and that regular files which happen to
+// end in .rclonelink are left alone.
+func TestSymlinks(t *testing.T) {
+	if _, err := exec.LookPath("mksquashfs"); err != nil {
+		t.Skip("mksquashfs not installed")
+	}
+	ctx := context.Background()
+	dir := t.TempDir()
+	input := filepath.Join(dir, "input")
+	require.NoError(t, os.Mkdir(input, 0777))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("hello"), 0666))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "link.txt")))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "regular.rclonelink"), []byte("not a link"), 0666))
+	sub := filepath.Join(input, "sub")
+	require.NoError(t, os.Mkdir(sub, 0777))
+	require.NoError(t, os.WriteFile(filepath.Join(sub, "file.txt"), []byte("hello"), 0666))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(sub, "link.txt")))
+	image := "test.sqfs"
+	out, err := exec.Command("mksquashfs", input, filepath.Join(dir, image), "-noappend").CombinedOutput()
+	require.NoError(t, err, "%s", out)
+
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	t.Run("without links", func(t *testing.T) {
+		f, err := New(ctx, localFs, image, "", "")
+		require.NoError(t, err)
+
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.ElementsMatch(t, []string{"file.txt", "regular.rclonelink", "sub"}, remotes)
+
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	t.Run("with links", func(t *testing.T) {
+		f, err := New(linksCtx, localFs, image, "", "")
+		require.NoError(t, err)
+
+		entries, err := f.List(linksCtx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.ElementsMatch(t, []string{"file.txt", "link.txt" + fs.LinkSuffix, "regular.rclonelink", "sub"}, remotes)
+
+		// The symlink is not available under its untranslated name
+		_, err = f.NewObject(linksCtx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		o, err := f.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(t, o))
+		assert.Equal(t, "txt", readObject(t, o, &fs.SeekOption{Offset: 5}))
+		assert.Equal(t, "file", readObject(t, o, &fs.RangeOption{Start: 0, End: 3}))
+
+		// A regular member ending in .rclonelink stays a regular file
+		ro, err := f.NewObject(linksCtx, "regular.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("not a link")), ro.Size())
+		assert.Equal(t, "not a link", readObject(t, ro))
+	})
+
+	t.Run("single symlink root", func(t *testing.T) {
+		for _, test := range []struct {
+			root string
+			want string
+		}{
+			{"link.txt", "link.txt"},
+			{"link.txt" + fs.LinkSuffix, "link.txt"},
+			{"sub/link.txt", "link.txt"},
+			{"sub/link.txt" + fs.LinkSuffix, "link.txt"},
+		} {
+			f, err := New(linksCtx, localFs, image, "", test.root)
+			require.ErrorIs(t, err, fs.ErrorIsFile)
+			entries, err := f.List(linksCtx, "")
+			require.NoError(t, err)
+			require.Len(t, entries, 1)
+			assert.Equal(t, test.want+fs.LinkSuffix, entries[0].Remote())
+			assert.Equal(t, "file.txt", readObject(t, entries[0].(fs.Object)))
+		}
+	})
+}
