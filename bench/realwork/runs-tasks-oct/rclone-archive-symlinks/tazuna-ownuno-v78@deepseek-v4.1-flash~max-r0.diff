+// TestArchiveZipSymlinks checks that zip symlinks are exposed by the
+// archive backend with --links and can be copied as symlinks.
+func TestArchiveZipSymlinks(t *testing.T) {
+	fstest.Initialise()
+	ctx := context.Background()
+	dir := t.TempDir()
+	zipPath := filepath.Join(dir, "links.zip")
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	writeFile := func(name, data string) {
+		w, err := zw.Create(name)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(data))
+		require.NoError(t, err)
+	}
+	writeLink := func(name, target string) {
+		h := &zip.FileHeader{Name: name, Method: zip.Deflate}
+		h.SetMode(os.ModeSymlink | 0777)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(target))
+		require.NoError(t, err)
+	}
+	writeFile("src/file.txt", "hello")
+	writeLink("src/link.txt", "file.txt")
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err := cache.Get(linksCtx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	entries, err := f.List(linksCtx, "src")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix}, remotes)
+
+	o, err := f.NewObject(linksCtx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	rc, err := o.Open(linksCtx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file.txt", string(data))
+
+	// Copying the link to a local destination recreates the symlink
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(linksCtx, dstDir)
+	require.NoError(t, err)
+	_, err = operations.Copy(linksCtx, dstFs, nil, "src/link.txt"+fs.LinkSuffix, o)
+	require.NoError(t, err)
+	target, err := os.Readlink(filepath.Join(dstDir, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
