+		}
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		if !strings.HasSuffix(entry.name, "/") {
+			_, err = w.Write([]byte(entry.data))
+			require.NoError(t, err)
+		}
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// readObject reads the whole object, applying any options.
+func readObject(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, rc.Close())
+	}()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(data)
+}
+
+// TestReadZipSymlinks checks that symlinks are only exposed in --links
+// mode, under their .rclonelink name, and that regular files which
+// happen to end in .rclonelink are left alone.
+func TestReadZipSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "links.zip",
+		zipEntry{name: "src/file.txt", data: "hello", mode: 0644},
+		zipEntry{name: "src/link.txt", data: "file.txt", mode: os.ModeSymlink | 0777},
+		zipEntry{name: "regular.rclonelink", data: "not a link", mode: 0644},
+	)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	t.Run("without links", func(t *testing.T) {
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		assert.Equal(t, []string{"regular.rclonelink", "src/file.txt"}, allRemotes(t, f))
+
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	t.Run("with links", func(t *testing.T) {
+		f, err := New(linksCtx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		assert.Equal(t, []string{"regular.rclonelink", "src/file.txt", "src/link.txt" + fs.LinkSuffix}, allRemotes(t, f))
+
+		// The symlink is not available under its untranslated name
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		o, err := f.NewObject(linksCtx, "src/link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(t, o))
+		assert.Equal(t, "txt", readObject(t, o, &fs.SeekOption{Offset: 5}))
+		assert.Equal(t, "file", readObject(t, o, &fs.RangeOption{Start: 0, End: 3}))
+
+		// A regular member ending in .rclonelink stays a regular file
+		ro, err := f.NewObject(linksCtx, "regular.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("not a link")), ro.Size())
+		assert.Equal(t, "not a link", readObject(t, ro))
+	})
+
+	t.Run("single symlink root", func(t *testing.T) {
+		for _, root := range []string{"src/link.txt", "src/link.txt" + fs.LinkSuffix} {
+			f, err := New(linksCtx, localFs, name, "", root)
+			require.ErrorIs(t, err, fs.ErrorIsFile)
+			entries, err := f.List(linksCtx, "")
+			require.NoError(t, err)
+			require.Len(t, entries, 1)
+			assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+			assert.Equal(t, "file.txt", readObject(t, entries[0].(fs.Object)))
+		}
+	})
+}
