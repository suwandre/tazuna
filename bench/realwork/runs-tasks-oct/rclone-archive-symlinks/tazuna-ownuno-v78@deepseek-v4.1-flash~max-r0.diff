+// withinRoot reports whether remote is within f.root and returns it
+// relative to the root. A symlink may also be named with the
+// .rclonelink suffix when links are enabled.
+func (f *Fs) withinRoot(remote string, isSymlink bool) (string, bool) {
+	if f.root == "" {
+		return remote, true
+	}
+	candidates := []string{remote}
+	if isSymlink && f.links {
+		candidates = append(candidates, remote+fs.LinkSuffix)
+	}
+	for _, candidate := range candidates {
+		if candidate == f.root {
+			return "", true
+		}
+		// Require a path boundary so that root "foo" does not also
+		// match a sibling entry such as "foobar"
+		if strings.HasPrefix(candidate, f.root+"/") {
+			return strings.TrimPrefix(candidate, f.root+"/"), true
+		}
+	}
+	return "", false
+}
