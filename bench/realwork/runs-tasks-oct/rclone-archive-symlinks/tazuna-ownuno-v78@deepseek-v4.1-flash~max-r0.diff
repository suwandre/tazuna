+// TestZipSymlinkEscape checks that copying a symlink and a member
+// "inside" it cannot write outside the destination.
+func TestZipSymlinkEscape(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	evil := t.TempDir()
+	evilFile := filepath.Join(evil, "authkeys")
+
+	name := writeZipEntries(t, dir, "evil.zip",
+		zipEntry{name: "pwn", data: evil, mode: os.ModeSymlink | 0777},
+		zipEntry{name: "pwn/authkeys", data: "PWNED", mode: 0644},
+	)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	srcFs, err := New(linksCtx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(linksCtx, dstDir)
+	require.NoError(t, err)
+
+	// Copy the symlink first, then try to write a file through it.
+	link, err := srcFs.NewObject(linksCtx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(linksCtx, dstFs, nil, "pwn"+fs.LinkSuffix, link)
+	require.NoError(t, err)
+
+	file, err := srcFs.NewObject(linksCtx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(linksCtx, dstFs, nil, "pwn/authkeys", file)
+	require.Error(t, err)
+
+	_, err = os.Stat(evilFile)
+	assert.True(t, os.IsNotExist(err), "file escaped the destination into %q", evilFile)
+}
