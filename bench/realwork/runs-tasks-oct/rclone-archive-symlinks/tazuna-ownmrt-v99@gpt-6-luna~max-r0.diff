+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	assert.Equal(t, "le.txt", string(contents))
+
+	in, err = link.Open(linksCtx, &fs.RangeOption{Start: 1, End: 3})
+	require.NoError(t, err)
+	contents, err = io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	assert.Equal(t, "ile", string(contents))
+
+	_, err = f.NewObject(linksCtx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	regular, err := f.NewObject(linksCtx, "src/regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.False(t, regular.(*Object).symlink)
+	assert.Equal(t, int64(len("regular")), regular.Size())
+	in, err = regular.Open(linksCtx)
+	require.NoError(t, err)
+	contents, err = io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	assert.Equal(t, "regular", string(contents))
+
+	f, err = New(linksCtx, localFs, name, "", "src/link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = f.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+	link, err = f.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.True(t, link.(*Object).symlink)
+}
