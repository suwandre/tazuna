+// writeZipWithSymlinks creates an archive containing both translated-link
+// candidates and a regular file whose name already has the link suffix.
+func writeZipWithSymlinks(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+
+	w, err := zw.Create("src/file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("content"))
+	require.NoError(t, err)
+
+	h := &zip.FileHeader{Name: "src/link.txt"}
+	h.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(h)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+
+	w, err = zw.Create("src/regular" + fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("regular"))
+	require.NoError(t, err)
+
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
