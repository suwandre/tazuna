+func TestSymlinkChildrenAreSkipped(t *testing.T) {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	h := &zip.FileHeader{Name: "link"}
+	h.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(h)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("../evil"))
+	require.NoError(t, err)
+	w, err = zw.Create("link/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("must not be copied through the link"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	dir := t.TempDir()
+	name := "hostile.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"link" + fs.LinkSuffix}, allRemotes(t, f))
+	_, err = f.NewObject(ctx, "link/authkeys")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	base := t.TempDir()
+	dstRoot := filepath.Join(base, "out")
+	evilFile := filepath.Join(base, "evil", "authkeys")
+	require.NoError(t, os.Mkdir(filepath.Dir(evilFile), 0700))
+	if err := os.Symlink("target", filepath.Join(base, "symlink-test")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	dstFs, err := cache.Get(ctx, dstRoot)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, dstFs, f, false))
+	_, err = os.Stat(evilFile)
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evilFile)
+	linkTarget, err := os.Readlink(filepath.Join(dstRoot, "link"))
+	require.NoError(t, err)
+	assert.Equal(t, "../evil", linkTarget)
+}
