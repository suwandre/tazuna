+func TestSymlinks(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skipf("mksquashfs executable not installed: %v", err)
+	}
+
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("content"), 0600))
+	if err := os.Symlink("file.txt", filepath.Join(input, "link.txt")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	require.NoError(t, os.WriteFile(filepath.Join(input, "regular"+fs.LinkSuffix), []byte("regular"), 0600))
+	archiveDir := t.TempDir()
+	archive := filepath.Join(archiveDir, "links.sqfs")
+	cmd := exec.Command(mksquashfs, input, archive, "-noappend", "-quiet")
+	output, err := cmd.CombinedOutput()
+	require.NoError(t, err, string(output))
+
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, archiveDir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, filepath.Base(archive), "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	assert.ElementsMatch(t, []string{"file.txt", "regular" + fs.LinkSuffix}, entryRemotes(entries))
+	_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(linksCtx, localFs, filepath.Base(archive), "", "")
+	require.NoError(t, err)
+	entries, err = f.List(linksCtx, "")
+	require.NoError(t, err)
+	assert.ElementsMatch(t, []string{"file.txt", "link.txt" + fs.LinkSuffix, "regular" + fs.LinkSuffix}, entryRemotes(entries))
+
+	link, err := f.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.True(t, link.(*Object).symlink)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	in, err := link.Open(linksCtx, &fs.SeekOption{Offset: 2})
+	require.NoError(t, err)
+	contents, err := io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	assert.Equal(t, "le.txt", string(contents))
+
+	in, err = link.Open(linksCtx, &fs.RangeOption{Start: 1, End: 3})
+	require.NoError(t, err)
+	contents, err = io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	assert.Equal(t, "ile", string(contents))
+
+	regular, err := f.NewObject(linksCtx, "regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.False(t, regular.(*Object).symlink)
+	in, err = regular.Open(linksCtx)
+	require.NoError(t, err)
+	contents, err = io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	assert.Equal(t, "regular", string(contents))
+
+	f, err = New(linksCtx, localFs, filepath.Base(archive), "", "link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = f.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+	link, err = f.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.True(t, link.(*Object).symlink)
+}
+
+func entryRemotes(entries fs.DirEntries) (remotes []string) {
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	return remotes
+}
