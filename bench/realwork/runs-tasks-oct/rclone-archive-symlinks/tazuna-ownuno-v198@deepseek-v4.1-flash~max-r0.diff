+// TestZipSymlinkEscape checks that a symlink pointing out of the
+// destination plus a member inside it can't write outside the
+// destination.
+func TestZipSymlinkEscape(t *testing.T) {
+	ctx := linksCtx()
+	outside := t.TempDir()
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "evil.zip",
+		zipEntry{name: "pwn", mode: os.ModeSymlink | 0777, data: outside},
+		zipEntry{name: "pwn/authkeys", mode: 0644, data: "PWNED"},
+	)
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	// The symlink is reproduced faithfully
+	link, err := f.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn"+fs.LinkSuffix, link)
+	require.NoError(t, err)
+	fi, err := os.Lstat(filepath.Join(dstDir, "pwn"))
+	require.NoError(t, err)
+	require.NotZero(t, fi.Mode()&os.ModeSymlink)
+
+	// But writing the member inside it must be refused
+	file, err := f.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn/authkeys", file)
+	require.Error(t, err, "writing through a planted symlink should be refused")
+
+	_, err = os.Stat(filepath.Join(outside, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination")
+}
