+// zipEntryFor returns the remote name for file, whether it is a
+// directory and whether it is within the root.
+//
+// It returns an error for entries whose names escape the archive's own
+// namespace.
+func (f *Fs) zipEntryFor(file *zip.File) (remote string, isDir, inRoot bool, err error) {
+	remote, err = sanitize.Path(file.Name)
+	if err != nil {
+		return "", false, false, err
+	}
+	isDir = strings.HasSuffix(file.Name, "/")
+	// A file entry whose last component is "", "." or ".." names a
+	// directory rather than a file, so skip
+	if !isDir && sanitize.Leaf(path.Base(file.Name)) != nil {
+		return "", false, false, errors.New("entry names a directory")
+	}
+	remote = path.Join(f.prefix, remote)
+	// A symlink is exposed under its name with the link suffix
+	if !isDir && file.Mode()&os.ModeSymlink != 0 {
+		remote += fs.LinkSuffix
+	}
+	if f.root != "" {
+		// Ignore all files outside the root, requiring a path
+		// boundary so that root "foo" does not also match a
+		// sibling entry such as "foobar"
+		if remote != f.root && !strings.HasPrefix(remote, f.root+"/") {
+			return remote, isDir, false, nil
+		}
+		if remote == f.root {
+			remote = ""
+		} else {
+			remote = strings.TrimPrefix(remote, f.root+"/")
+		}
+	}
+	return remote, isDir, true, nil
+}
+
+// removeLink removes the symlink object at remote from dt, if there is
+// one, so that a regular archive member can take its name.
+func removeLink(dt dirtree.DirTree, remote string) {
+	parent, entry := dt.Find(remote)
+	existing, ok := entry.(*Object)
+	if !ok || !existing.isLink {
+		return
+	}
+	entries := dt[parent]
+	for i, e := range entries {
+		if e == entry {
+			dt[parent] = append(entries[:i], entries[i+1:]...)
+			return
+		}
+	}
+}
+
+// addObject adds o to dt, letting a regular archive member keep a name
+// a symlink would also be exposed under.
+func addObject(dt dirtree.DirTree, o *Object) {
+	if _, entry := dt.Find(o.remote); entry != nil {
+		if o.isLink {
+			// A regular archive member keeps the name
+			return
+		}
+		removeLink(dt, o.remote)
+	}
+	dt.Add(o)
+}
