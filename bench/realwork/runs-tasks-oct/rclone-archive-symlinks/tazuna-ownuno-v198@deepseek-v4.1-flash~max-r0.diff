+// linkReader returns the target of a symlink, honouring the offset and
+// limit decoded from the open options.
+func linkReader(target string, offset, limit int64) io.ReadCloser {
+	if offset < 0 {
+		offset = 0
+	}
+	if offset > int64(len(target)) {
+		offset = int64(len(target))
+	}
+	return readers.NewLimitedReadCloser(io.NopCloser(strings.NewReader(target[offset:])), limit)
+}
