+// TestZipSymlinks checks that symlinks are skipped without --links
+// and exposed as .rclonelink objects with it.
+func TestZipSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "links.zip",
+		zipEntry{name: "src/file.txt", mode: 0644, data: "hello"},
+		zipEntry{name: "src/link.txt", mode: os.ModeSymlink | 0777, data: "file.txt"},
+		zipEntry{name: "real.rclonelink", mode: 0644, data: "not a link"},
+	)
+	localFs, err := cache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	t.Run("WithoutLinks", func(t *testing.T) {
+		ctx := context.Background()
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		assert.Equal(t, []string{"real.rclonelink", "src/file.txt"}, allRemotes(t, f))
+		entries, err := f.List(ctx, "src")
+		require.NoError(t, err)
+		require.Len(t, entries, 1)
+		assert.Equal(t, "src/file.txt", entries[0].Remote())
+
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("WithLinks", func(t *testing.T) {
+		ctx := linksCtx()
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		assert.Equal(t, []string{"real.rclonelink", "src/file.txt", "src/link.txt" + fs.LinkSuffix}, allRemotes(t, f))
+		entries, err := f.List(ctx, "src")
+		require.NoError(t, err)
+		require.Len(t, entries, 2)
+		assert.Equal(t, "src/file.txt", entries[0].Remote())
+		assert.Equal(t, "src/link.txt"+fs.LinkSuffix, entries[1].Remote())
+
+		o, err := f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "src/link.txt"+fs.LinkSuffix, o.Remote())
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(ctx, t, o))
+
+		// Seek and range options read from the target
+		assert.Equal(t, "txt", readObject(ctx, t, o, &fs.SeekOption{Offset: 5}))
+		assert.Equal(t, "le.t", readObject(ctx, t, o, &fs.RangeOption{Start: 2, End: 5}))
+
+		// Seeking past the end reads nothing
+		assert.Equal(t, "", readObject(ctx, t, o, &fs.SeekOption{Offset: o.Size() + 1}))
+		assert.Equal(t, "", readObject(ctx, t, o, &fs.RangeOption{Start: o.Size() + 1, End: -1}))
