+// linksCtx returns a context with -l/--links in use.
+func linksCtx() context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	return ctx
+}
+
+// makeSymlinkImage builds a squashfs image containing a regular file, a
+// symlink to it and a regular file whose name ends in .rclonelink.
+func makeSymlinkImage(t *testing.T) string {
+	dir := t.TempDir()
+	image := filepath.Join(dir, "test.sqfs")
+	f, err := os.Create(image)
+	require.NoError(t, err)
+	fsys, err := diskfsquashfs.Create(file.New(f, false), 0, 0, 4096)
+	require.NoError(t, err)
+	ws := fsys.Workspace()
+	require.NoError(t, os.WriteFile(filepath.Join(ws, "file.txt"), []byte("hello"), 0644))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(ws, "link.txt")))
+	require.NoError(t, os.WriteFile(filepath.Join(ws, "real.rclonelink"), []byte("not a link"), 0644))
+	// A symlink which would be exposed under the name of a regular file
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(ws, "real")))
+	// Finalize reads symlink targets relative to the working directory
+	t.Chdir(ws)
+	require.NoError(t, fsys.Finalize(diskfsquashfs.FinalizeOptions{}))
+	require.NoError(t, fsys.Close())
+	require.NoError(t, f.Close())
+	return image
+}
+
+// readObject reads the whole object using options.
+func readObject(ctx context.Context, t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	in, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	buf, err := io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	return string(buf)
+}
+
+// TestSymlinks checks that symlinks are skipped without --links and
+// exposed as .rclonelink objects with it.
+func TestSymlinks(t *testing.T) {
+	image := makeSymlinkImage(t)
+	localFs, err := fscache.Get(context.Background(), filepath.Dir(image))
+	require.NoError(t, err)
+	name := filepath.Base(image)
+
+	t.Run("WithoutLinks", func(t *testing.T) {
+		ctx := context.Background()
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		assert.ElementsMatch(t, []string{"file.txt", "real.rclonelink"}, listRemotes(ctx, t, f, ""))
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("WithLinks", func(t *testing.T) {
+		ctx := linksCtx()
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		assert.ElementsMatch(t, []string{"file.txt", "link.txt" + fs.LinkSuffix, "real.rclonelink"}, listRemotes(ctx, t, f, ""))
+
+		o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "link.txt"+fs.LinkSuffix, o.Remote())
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(ctx, t, o))
+
+		// Seek and range options read from the target
+		assert.Equal(t, "txt", readObject(ctx, t, o, &fs.SeekOption{Offset: 5}))
+		assert.Equal(t, "le.t", readObject(ctx, t, o, &fs.RangeOption{Start: 2, End: 5}))
+
+		// Seeking past the end reads nothing
+		assert.Equal(t, "", readObject(ctx, t, o, &fs.SeekOption{Offset: o.Size() + 1}))
+		assert.Equal(t, "", readObject(ctx, t, o, &fs.RangeOption{Start: o.Size() + 1, End: -1}))
+
+		// The name without the suffix isn't exposed
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// A regular member ending in .rclonelink stays a regular file,
+		// even though a symlink would also be exposed under that name
+		o, err = f.NewObject(ctx, "real.rclonelink")
+		require.NoError(t, err)
+		assert.False(t, o.(*Object).isLink)
+		assert.Equal(t, "not a link", readObject(ctx, t, o))
+	})
+}
+
+// listRemotes returns the remotes of the entries in dir.
+func listRemotes(ctx context.Context, t *testing.T, f fs.Fs, dir string) []string {
+	entries, err := f.List(ctx, dir)
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	return remotes
+}
+
+// TestSymlinkRoot checks that a root naming a symlink exposes just that
+// symlink.
+func TestSymlinkRoot(t *testing.T) {
+	image := makeSymlinkImage(t)
+	localFs, err := fscache.Get(context.Background(), filepath.Dir(image))
+	require.NoError(t, err)
+
+	ctx := linksCtx()
+	f, err := New(ctx, localFs, filepath.Base(image), "", "link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+	assert.Equal(t, "file.txt", readObject(ctx, t, entries[0].(fs.Object)))
+}
