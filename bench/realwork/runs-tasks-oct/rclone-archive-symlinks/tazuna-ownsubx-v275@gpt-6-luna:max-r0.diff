+// Symbolic links are skipped by default and exposed as translated link files
+// when --links is set. Regular members with the suffix remain regular files.
+func TestReadSquashfsSymlinks(t *testing.T) {
+	if _, err := exec.LookPath("mksquashfs"); err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+
+	ctx := context.Background()
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("data"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "regular"+fs.LinkSuffix), []byte("regular file"), 0600))
+	if err := os.Symlink("file.txt", filepath.Join(input, "link.txt")); err != nil {
+		t.Skipf("can't create symlink: %v", err)
+	}
+	archive := filepath.Join(t.TempDir(), "links.sqfs")
+	cmd := exec.Command("mksquashfs", input, archive, "-no-progress")
+	require.NoError(t, cmd.Run())
+
+	localFs, err := fscache.Get(ctx, filepath.Dir(archive))
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, filepath.Base(archive), "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		if _, ok := entry.(fs.Object); ok {
+			remotes = append(remotes, entry.Remote())
+		}
+	}
+	assert.NotContains(t, remotes, "link.txt"+fs.LinkSuffix)
+	assert.Contains(t, remotes, "regular"+fs.LinkSuffix)
+	_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(linksCtx, localFs, filepath.Base(archive), "", "")
+	require.NoError(t, err)
+	link, err := f.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	for _, test := range []struct {
+		options []fs.OpenOption
+		want    string
+	}{
+		{nil, "file.txt"},
+		{[]fs.OpenOption{&fs.SeekOption{Offset: 2}}, "le.txt"},
+		{[]fs.OpenOption{&fs.RangeOption{Start: 1, End: 3}}, "ile"},
+	} {
+		rc, err := link.Open(linksCtx, test.options...)
+		require.NoError(t, err)
+		data, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, test.want, string(data))
+	}
+
+	regular, err := f.NewObject(linksCtx, "regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, "regular file", fstests.ReadObject(linksCtx, t, regular, -1))
+	_, err = f.NewObject(linksCtx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+}
