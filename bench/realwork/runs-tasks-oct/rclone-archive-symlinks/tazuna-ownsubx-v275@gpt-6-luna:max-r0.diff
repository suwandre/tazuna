+// writeSymlinkZip builds a zip file containing a regular translated-link
+// suffix name and a symbolic link in dir and returns its leaf name.
+func writeSymlinkZip(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+
+	w, err := zw.Create("regular" + fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("regular file"))
+	require.NoError(t, err)
+
+	h := &zip.FileHeader{Name: "link.txt"}
+	h.SetMode(os.ModeSymlink | 0o777)
+	w, err = zw.CreateHeader(h)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
