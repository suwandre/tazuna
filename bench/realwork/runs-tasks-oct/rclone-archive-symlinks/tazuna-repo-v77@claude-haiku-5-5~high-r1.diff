+// With links set a symlink in an archive is copied to a destination as
+// a symlink.  A member reached through a symlink which points outside
+// the destination must not be written there.
+func TestArchiveSymlinkCopy(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	outside := t.TempDir()
+	dir := t.TempDir()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	addEntry := func(name, content string, mode os.FileMode) {
+		fh := &zip.FileHeader{Name: name, Method: zip.Store}
+		fh.SetMode(mode)
+		w, err := zw.CreateHeader(fh)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	addEntry("src/file.txt", "hello", 0644)
+	addEntry("src/link.txt", "file.txt", os.ModeSymlink|0777)
+	addEntry("escape", outside, os.ModeSymlink|0777)
+	addEntry("escape/evil.txt", "pwned", 0644)
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(dir, "test.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	srcFs, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	require.NoError(t, operations.CopyFile(ctx, dstFs, srcFs, "src/link.txt"+fs.LinkSuffix, "src/link.txt"+fs.LinkSuffix))
+	target, err := os.Readlink(filepath.Join(dstDir, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+
+	require.NoError(t, operations.CopyFile(ctx, dstFs, srcFs, "escape"+fs.LinkSuffix, "escape"+fs.LinkSuffix))
+	require.Error(t, operations.CopyFile(ctx, dstFs, srcFs, "escape/evil.txt", "escape/evil.txt"))
+
+	entries, err := os.ReadDir(outside)
+	require.NoError(t, err)
+	assert.Empty(t, entries)
+}
