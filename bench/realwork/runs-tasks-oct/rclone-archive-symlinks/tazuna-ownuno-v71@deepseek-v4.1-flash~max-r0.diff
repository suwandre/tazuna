 		assert.Equal(t, test.want, isDirectChild(test.dir, test.remote), "dir=%q remote=%q", test.dir, test.remote)
 	}
 }
+
+// archiveTestEntry is a member of a test zip: either a regular file
+// whose contents are body, or, when link is set, a symlink to body.
+type archiveTestEntry struct {
+	name string
+	body string
+	link bool
+}
+
+// writeArchiveZip builds a zip at path with the given members.
+func writeArchiveZip(t *testing.T, path string, entries ...archiveTestEntry) {
+	f, err := os.Create(path)
+	require.NoError(t, err)
+	zw := zip.NewWriter(f)
+	for _, entry := range entries {
+		var w io.Writer
+		if entry.link {
+			hdr := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+			hdr.SetMode(os.ModeSymlink | 0o777)
+			w, err = zw.CreateHeader(hdr)
+		} else {
+			w, err = zw.Create(entry.name)
+		}
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, f.Close())
+}
+
+// skipIfNoSymlinks skips the test if the OS won't make symlinks.
+func skipIfNoSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	target := filepath.Join(dir, "target")
+	require.NoError(t, os.WriteFile(target, []byte("x"), 0600))
+	if err := os.Symlink(target, filepath.Join(dir, "link")); err != nil {
+		t.Skipf("symlinks not supported: %v", err)
+	}
+}
+
+// Copying a zip symlink with -l/--links recreates it as a symlink at
+// the destination.
+func TestArchiveZipSymlinkCopy(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoSymlinks(t)
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	zipPath := filepath.Join(t.TempDir(), "test.zip")
+	writeArchiveZip(t, zipPath,
+		archiveTestEntry{name: "src/file.txt", body: "hello"},
+		archiveTestEntry{name: "src/link.txt", body: "file.txt", link: true},
+	)
+
+	dst := t.TempDir()
+	srcFs, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dstFs, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+
+	require.NoError(t, sync.CopyDir(ctx, dstFs, srcFs, false))
+
+	link := filepath.Join(dst, "src", "link.txt")
+	fi, err := os.Lstat(link)
+	require.NoError(t, err)
+	require.True(t, fi.Mode()&os.ModeSymlink != 0, "link.txt should be a symlink")
+	target, err := os.Readlink(link)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+// A hostile zip with a symlink pointing outside the destination plus a
+// member inside it must not let a copy write outside the destination.
+func TestArchiveZipSymlinkEscapeBlocked(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoSymlinks(t)
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	outside := t.TempDir()
+	zipPath := filepath.Join(t.TempDir(), "evil.zip")
+	writeArchiveZip(t, zipPath,
+		archiveTestEntry{name: "link", body: outside, link: true},
+		archiveTestEntry{name: "link/evil", body: "PWNED"},
+		archiveTestEntry{name: "safe.txt", body: "safe"},
+	)
+
+	dst := t.TempDir()
+	srcFs, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dstFs, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+
+	// The copy may fail because writing through the planted symlink is
+	// refused; what matters is that nothing escaped.
+	_ = sync.CopyDir(ctx, dstFs, srcFs, false)
+
+	_, err = os.Stat(filepath.Join(outside, "evil"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", outside)
+
+	_, err = os.Stat(filepath.Join(dst, "safe.txt"))
+	assert.NoError(t, err)
+}
