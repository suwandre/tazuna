--- a/backend/archive/archiver/archiver.go
+++ b/backend/archive/archiver/archiver.go
@@ -3,6 +3,7 @@ package archiver
 
 import (
 	"context"
+	"strings"
 
 	"github.com/rclone/rclone/fs"
 )
@@ -27,3 +28,29 @@ var Archivers []Archiver
 func Register(as ...Archiver) {
 	Archivers = append(Archivers, as...)
 }
+
+// LinksEnabled reports whether symlinks should be exposed as translated
+// .rclonelink objects, as requested by the global -l/--links flag.
+func LinksEnabled(ctx context.Context) bool {
+	return fs.GetConfig(ctx).Links
+}
+
+// LinkRemote returns the remote a symlink called remote is exposed under
+// when links are enabled.
+func LinkRemote(remote string) string {
+	return remote + fs.LinkSuffix
+}
+
+// UnlinkRemote returns the symlink name underlying a translated remote
+// and whether remote carried the link suffix.
+func UnlinkRemote(remote string) (name string, isLink bool) {
+	return strings.CutSuffix(remote, fs.LinkSuffix)
+}
+
+// LogSkippedLinks logs a single notice that n symlinks were skipped,
+// naming the flag which enables them.
+func LogSkippedLinks(f fs.Info, n int) {
+	if n > 0 {
+		fs.Logf(f, "Skipped %d symlinks - use -l/--links to translate them", n)
+	}
+}
