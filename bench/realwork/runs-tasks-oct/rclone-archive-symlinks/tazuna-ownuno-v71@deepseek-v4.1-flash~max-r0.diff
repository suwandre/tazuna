+// Symlinks in a zip are skipped unless -l/--links is set, in which
+// case they are exposed as .rclonelink objects whose contents are the
+// link target.
+func TestReadZipSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "test.zip",
+		zipEntry{name: "file.txt", target: "hello"},
+		zipEntry{name: "link.txt", target: "file.txt", link: true},
+		zipEntry{name: "regular.rclonelink", target: "not a link"},
+	)
+
+	localFs, err := cache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	t.Run("SkippedWithoutLinks", func(t *testing.T) {
+		f, err := New(context.Background(), localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"file.txt", "regular.rclonelink"}, allRemotes(t, f))
+
+		_, err = f.NewObject(context.Background(), "link.txt.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("TranslatedWithLinks", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(context.Background())
+		ci.Links = true
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"file.txt", "link.txt.rclonelink", "regular.rclonelink"}, allRemotes(t, f))
+
+		// The symlink is exposed under its name plus the suffix, with
+		// the target as its contents
+		o, err := f.NewObject(ctx, "link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(t, o))
+
+		// Open honours seek and range options
+		assert.Equal(t, "txt", readObject(t, o, &fs.SeekOption{Offset: 5}))
+		assert.Equal(t, "file", readObject(t, o, &fs.RangeOption{Start: 0, End: 3}))
+
+		// The unsuffixed name is not exposed
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// A regular member whose name ends in the suffix stays a
+		// regular file
+		o, err = f.NewObject(ctx, "regular.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("not a link")), o.Size())
+		assert.Equal(t, "not a link", readObject(t, o))
+	})
