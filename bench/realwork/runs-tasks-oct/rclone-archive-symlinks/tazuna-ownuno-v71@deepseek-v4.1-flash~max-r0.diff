+
+// remotes returns every remote in f, sorted, walking directories.
+func remotes(t *testing.T, f fs.Fs) []string {
+	var out []string
+	var walk func(dir string)
+	walk = func(dir string) {
+		entries, err := f.List(context.Background(), dir)
+		require.NoError(t, err)
+		for _, entry := range entries {
+			out = append(out, entry.Remote())
+			if _, ok := entry.(fs.Directory); ok {
+				walk(entry.Remote())
+			}
+		}
+	}
+	walk("")
+	sort.Strings(out)
+	return out
+}
+
+// readObject reads all of o, honouring the options passed in.
+func readObject(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, rc.Close())
+	}()
+	b, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(b)
+}
+
+// Symlinks in a squashfs image are skipped unless -l/--links is set, in
+// which case they are exposed as .rclonelink objects whose contents are
+// the link target.
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	t.Run("SkippedWithoutLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"file.txt", "regular.rclonelink", "sub", "sub/nested.txt"}, remotes(t, f))
+
+		_, err = f.NewObject(ctx, "link.txt.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("TranslatedWithLinks", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(ctx)
+		ci.Links = true
+		f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"abs.txt.rclonelink", "file.txt", "link.txt.rclonelink", "regular.rclonelink", "sub", "sub/nested.txt", "sub/sublink.txt.rclonelink"}, remotes(t, f))
+
+		// The symlink is exposed under its name plus the suffix, with
+		// the target as its contents
+		o, err := f.NewObject(ctx, "link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(t, o))
+
+		// Open honours seek and range options
+		assert.Equal(t, "txt", readObject(t, o, &fs.SeekOption{Offset: 5}))
+		assert.Equal(t, "file", readObject(t, o, &fs.RangeOption{Start: 0, End: 3}))
+
+		// The unsuffixed name is not exposed
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// A regular member whose name ends in the suffix stays a
+		// regular file
+		o, err = f.NewObject(ctx, "regular.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "not a link\n", readObject(t, o))
+
+		// A symlink in a subdirectory is exposed too
+		o, err = f.NewObject(ctx, "sub/sublink.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "nested.txt", readObject(t, o))
+	})
+
+	t.Run("SymlinkRoot", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(ctx)
+		ci.Links = true
+		for _, test := range []struct {
+			root   string
+			remote string
+			target string
+		}{
+			{"link.txt.rclonelink", "link.txt.rclonelink", "file.txt"},
+			{"sub/sublink.txt.rclonelink", "sublink.txt.rclonelink", "nested.txt"},
+		} {
+			f, err := New(ctx, localFs, "symlink.sqfs", "", test.root)
+			require.ErrorIs(t, err, fs.ErrorIsFile)
+			assert.Equal(t, []string{test.remote}, remotes(t, f))
+			o, err := f.NewObject(ctx, test.remote)
+			require.NoError(t, err)
+			assert.Equal(t, test.target, readObject(t, o))
+		}
+	})
+}
