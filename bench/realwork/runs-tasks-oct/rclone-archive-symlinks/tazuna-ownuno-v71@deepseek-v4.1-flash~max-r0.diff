+func zipHasRoot(zr *zip.Reader, prefix, remote string) bool {
+	for _, file := range zr.File {
+		name, err := sanitize.Path(file.Name)
+		if err != nil {
+			continue
+		}
+		name = path.Join(prefix, name)
+		if name == remote || strings.HasPrefix(name, remote+"/") {
+			return true
+		}
+	}
+	return false
+}
