+// zipEntry is a member of a test zip: either a regular file whose
+// contents are target, or, when link is set, a symlink to target.
+type zipEntry struct {
+	name   string
+	target string
+	link   bool
+}
+
+// writeZipEntries builds a zip with the given members in dir and
+// returns its leaf name.
+func writeZipEntries(t *testing.T, dir, name string, entries ...zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		var (
+			w   io.Writer
+			err error
+		)
+		if entry.link {
+			hdr := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+			hdr.SetMode(os.ModeSymlink | 0o777)
+			w, err = zw.CreateHeader(hdr)
+		} else {
+			w, err = zw.Create(entry.name)
+		}
+		require.NoError(t, err)
+		if !strings.HasSuffix(entry.name, "/") {
+			_, err = w.Write([]byte(entry.target))
+			require.NoError(t, err)
+		}
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// readObject reads all of o, honouring the options passed in.
+func readObject(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, rc.Close())
+	}()
+	b, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(b)
+}
