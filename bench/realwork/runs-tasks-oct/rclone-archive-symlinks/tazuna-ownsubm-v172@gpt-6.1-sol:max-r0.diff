+func TestSymlinks(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs not installed")
+	}
+	probe := filepath.Join(t.TempDir(), "symlink")
+	if err := os.Symlink("target", probe); err != nil {
+		t.Skipf("cannot create symlinks: %v", err)
+	}
+
+	ctx, ci := fs.AddConfig(context.Background())
+	root := t.TempDir()
+	input := filepath.Join(root, "input")
+	require.NoError(t, os.Mkdir(input, 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "target.txt"), []byte("target contents"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "regular.rclonelink"), []byte("ordinary file"), 0600))
+	require.NoError(t, os.Symlink("target.txt", filepath.Join(input, "link.txt")))
+	image := filepath.Join(root, "links.sqfs")
+	cmd := exec.Command(mksquashfs, input, image, "-noappend", "-quiet")
+	output, err := cmd.CombinedOutput()
+	require.NoError(t, err, string(output))
+
+	localFs, err := fscache.Get(ctx, root)
+	require.NoError(t, err)
+
+	ci.Links = false
+	withoutLinks, err := New(ctx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := withoutLinks.List(ctx, "")
+	require.NoError(t, err)
+	assert.Len(t, entries, 2)
+	_, err = withoutLinks.NewObject(ctx, "link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ci.Links = true
+	withLinks, err := New(ctx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 3)
+	for _, entry := range entries {
+		obj, err := withLinks.NewObject(ctx, entry.Remote())
+		require.NoError(t, err)
+		assert.Equal(t, entry.Remote(), obj.Remote())
+	}
+	link, err := withLinks.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	_, err = withLinks.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	assert.Equal(t, int64(len("target.txt")), link.Size())
+	for _, test := range []struct {
+		options []fs.OpenOption
+		want    string
+	}{
+		{nil, "target.txt"},
+		{[]fs.OpenOption{&fs.SeekOption{Offset: 2}}, "rget.txt"},
+		{[]fs.OpenOption{&fs.RangeOption{Start: 2, End: 5}}, "rget"},
