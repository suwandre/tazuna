+func TestArchiveCopySymlinks(t *testing.T) {
+	probe := filepath.Join(t.TempDir(), "symlink")
+	if err := os.Symlink("target", probe); err != nil {
+		t.Skipf("cannot create symlinks: %v", err)
+	}
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	base := t.TempDir()
+	zipPath := filepath.Join(base, "links.zip")
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for name, contents := range map[string]string{
+		"src/file.txt":     "file contents",
+		"evil/payload.txt": "must stay inside",
+	} {
+		w, err := zw.Create(name)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(contents))
+		require.NoError(t, err)
+	}
+	for name, target := range map[string]string{
+		"src/link.txt": "file.txt",
+		"evil":         "../pwned",
+	} {
+		header := &zip.FileHeader{Name: name}
+		header.SetMode(os.ModeSymlink | 0777)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(target))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	obj, err := src.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), obj.Size())
+	_, err = src.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	dstPath := filepath.Join(base, "destination")
+	dst, err := cache.Get(ctx, dstPath)
+	require.NoError(t, err)
+	// This crafted tree has both a symlink named "evil" and a member beneath
+	// it. The copy may report the conflicting paths, but must never follow the
+	// link outside the destination.
+	copyErr := sync.CopyDir(ctx, dst, src, false)
+	if copyErr != nil {
+		t.Logf("Copy reported the conflicting archive paths: %v", copyErr)
+	}
+
+	linkPath := filepath.Join(dstPath, "src", "link.txt")
+	linkTarget, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", linkTarget)
+	outside := filepath.Join(base, "pwned")
+	_, err = os.Lstat(outside)
+	assert.True(t, os.IsNotExist(err), "archive member escaped destination to %q", outside)
+}
