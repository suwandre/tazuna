+	linkPath := filepath.Join(destinationPath, "link.txt")
+	info, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	assert.NotZero(t, info.Mode()&os.ModeSymlink)
+	target, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+
+	copyRoot := t.TempDir()
+	copyDestination := filepath.Join(copyRoot, "out")
+	outside := filepath.Join(copyRoot, "outside")
+	require.NoError(t, os.Mkdir(copyDestination, 0700))
+	require.NoError(t, os.Mkdir(outside, 0700))
+	destination, err = local.NewFs(ctxLinks, "local", copyDestination, configmap.Simple{})
+	require.NoError(t, err)
+	require.NoError(t, syncop.CopyDir(ctxLinks, destination, withLinks, false))
+	_, err = os.Stat(filepath.Join(outside, "evil.txt"))
+	assert.ErrorIs(t, err, os.ErrNotExist)
+
+	_, err = withLinks.NewObject(ctxLinks, "escape/evil.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+}
