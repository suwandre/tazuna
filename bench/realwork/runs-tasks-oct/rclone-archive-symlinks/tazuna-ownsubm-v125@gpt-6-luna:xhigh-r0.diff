+// TestSymlinks exposes squashfs symbolic links as translated link files.
+func TestSymlinks(t *testing.T) {
+	if _, err := exec.LookPath("mksquashfs"); err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "target.txt"), []byte("target"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "ordinary"+fs.LinkSuffix), []byte("regular"), 0600))
+	if err := os.Symlink("target.txt", filepath.Join(input, "link.txt")); err != nil {
+		t.Skipf("can't create symbolic link: %v", err)
+	}
+	archivePath := filepath.Join(t.TempDir(), "links.sqfs")
+	cmd := exec.Command("mksquashfs", input, archivePath, "-noappend", "-quiet")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("mksquashfs failed: %v\n%s", err, output)
+	}
+
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, filepath.Dir(archivePath))
+	require.NoError(t, err)
+	ctxNoLinks, configNoLinks := fs.AddConfig(ctx)
+	configNoLinks.Links = false
+	withoutLinks, err := New(ctxNoLinks, localFs, filepath.Base(archivePath), "", "")
+	require.NoError(t, err)
+	entries, err := withoutLinks.List(ctxNoLinks, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 2)
+	assert.ElementsMatch(t, []string{"target.txt", "ordinary" + fs.LinkSuffix}, []string{entries[0].Remote(), entries[1].Remote()})
+	_, err = withoutLinks.NewObject(ctxNoLinks, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = withoutLinks.NewObject(ctxNoLinks, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	regular, err := withoutLinks.NewObject(ctxNoLinks, "ordinary"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("regular")), regular.Size())
+
+	ctxLinks, configLinks := fs.AddConfig(ctx)
+	configLinks.Links = true
+	withLinks, err := New(ctxLinks, localFs, filepath.Base(archivePath), "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(ctxLinks, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 3)
+	assert.ElementsMatch(t, []string{"link.txt" + fs.LinkSuffix, "ordinary" + fs.LinkSuffix, "target.txt"}, []string{entries[0].Remote(), entries[1].Remote(), entries[2].Remote()})
+
+	link, err := withLinks.NewObject(ctxLinks, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = withLinks.NewObject(ctxLinks, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	assert.Equal(t, int64(len("target.txt")), link.Size())
+	rc, err := link.Open(ctxLinks, &fs.RangeOption{Start: 2, End: 5})
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "rget", string(data))
+
+	regular, err = withLinks.NewObject(ctxLinks, "ordinary"+fs.LinkSuffix)
+	require.NoError(t, err)
+	rc, err = regular.Open(ctxLinks)
+	require.NoError(t, err)
+	data, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "regular", string(data))
+
+	_, err = withLinks.NewObject(ctxLinks, "link.txt/child")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = withLinks.List(ctxLinks, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorDirNotFound)
+}
