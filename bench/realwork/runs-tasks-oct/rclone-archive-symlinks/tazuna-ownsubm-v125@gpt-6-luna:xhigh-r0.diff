+// hasSymlinkAncestor reports whether a parent or, optionally, the last component is a symbolic link.
+func (f *Fs) hasSymlinkAncestor(nativePath string, includeLast bool) bool {
+	nativePath = strings.Trim(nativePath, "/")
+	if nativePath == "" {
+		return false
+	}
+	parts := strings.Split(nativePath, "/")
+	limit := len(parts)
+	if !includeLast {
+		limit--
+	}
+	parent := ""
+	for i := 0; i < limit; i++ {
+		entries, err := f.sqfs.ReadDir(toIOFS(parent))
+		if err != nil {
+			return false
+		}
+		for _, entry := range entries {
+			if entry.Name() == parts[i] {
+				info, err := entry.Info()
+				if err == nil && info.Mode()&os.ModeSymlink != 0 {
+					return true
+				}
+				break
+			}
+		}
+		parent = path.Join(parent, parts[i])
+	}
+	return false
+}
