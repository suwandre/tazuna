diff --git a/backend/archive/zip/zip.go b/backend/archive/zip/zip.go
index 129ce01..bfe5320 100644
--- a/backend/archive/zip/zip.go
+++ b/backend/archive/zip/zip.go
@@ -72,7 +72,7 @@ func New(ctx context.Context, wrappedFs fs.Fs, remote, prefix, root string) (fs.
 	}
 
 	// Read the contents of the zip file
-	singleObject, err := f.readZip()
+	singleObject, err := f.readZip(ctx)
 	if err != nil {
 		return nil, fmt.Errorf("failed to open zip file: %w", err)
 	}
@@ -120,7 +120,7 @@ func (f *Fs) String() string {
 // readZip the zip file into f
 //
 // Returns singleObject=true if f.root points to a file
-func (f *Fs) readZip() (singleObject bool, err error) {
+func (f *Fs) readZip(ctx context.Context) (singleObject bool, err error) {
 	if f.node == nil {
 		return singleObject, fs.ErrorDirNotFound
 	}
@@ -137,7 +137,9 @@ func (f *Fs) readZip() (singleObject bool, err error) {
 		return singleObject, fmt.Errorf("failed to read zip file: %w", err)
 	}
 	dt := dirtree.New()
+	links := fs.GetConfig(ctx).Links
 	skipped := 0
+	skippedLinks := 0
 	for _, file := range zr.File {
 		// Skip entries whose name escapes the archive's own namespace
 		remote, err := sanitize.Path(file.Name)
@@ -152,6 +154,16 @@ func (f *Fs) readZip() (singleObject bool, err error) {
 			skipped++
 			continue
 		}
+		isLink := !isDir && file.Mode()&os.ModeSymlink != 0
+		if isLink {
+			if !links {
+				skippedLinks++
+				continue
+			}
+			// A symlink is exposed as a regular file whose contents are
+			// the link target
+			remote += fs.LinkSuffix
+		}
 		remote = path.Join(f.prefix, remote)
 		if f.root != "" {
 			// Ignore all files outside the root, requiring a path
@@ -191,6 +203,9 @@ func (f *Fs) readZip() (singleObject bool, err error) {
 	if skipped > 0 {
 		fs.Logf(f, "Skipped %d zip entries which escape the archive", skipped)
 	}
+	if skippedLinks > 0 {
+		fs.Logf(f, "Skipped %d symlinks in the archive - use -l/--links to read them", skippedLinks)
+	}
 	dt.CheckParents("")
 	dt.Sort()
 	f.dt = dt
