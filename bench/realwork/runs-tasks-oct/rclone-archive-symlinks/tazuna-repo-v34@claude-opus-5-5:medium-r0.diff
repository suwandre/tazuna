+// readLink reads the target of the symlink stored in file
+func readLink(file *zip.File) (target string, err error) {
+	rc, err := file.Open()
+	if err != nil {
+		return "", err
+	}
+	defer fs.CheckClose(rc, &err)
+	buf, err := io.ReadAll(io.LimitReader(rc, archiver.MaxLinkTarget+1))
+	if err != nil {
+		return "", err
+	}
+	if len(buf) > archiver.MaxLinkTarget {
+		return "", errors.New("symlink target too long")
+	}
+	return string(buf), nil
+}
