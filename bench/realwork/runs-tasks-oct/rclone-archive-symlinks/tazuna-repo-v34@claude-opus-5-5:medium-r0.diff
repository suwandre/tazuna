 	assert.ErrorContains(t, err, "invalid or corrupt squashfs image")
 	assert.ErrorContains(t, err, "boom")
 }
+
+// writeSquashfs builds a squashfs image called name in dir from the
+// tree made by build in a workspace directory.
+//
+// go-diskfs reads symlinks relative to the current directory and
+// follows them, so this changes directory and symlinks must resolve.
+func writeSquashfs(t *testing.T, dir, name string, build func(ws string)) string {
+	out, err := os.Create(filepath.Join(dir, name))
+	require.NoError(t, err)
+	sq, err := dsquashfs.Create(file.New(out, false), 0, 0, 4096)
+	require.NoError(t, err)
+	ws := sq.Workspace()
+	defer func() { _ = os.RemoveAll(ws) }()
+	build(ws)
+	t.Chdir(ws)
+	require.NoError(t, sq.Finalize(dsquashfs.FinalizeOptions{}))
+	require.NoError(t, out.Close())
+	return name
+}
+
+// linksCtx returns a context with --links set to links
+func linksCtx(links bool) context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = links
+	return ctx
+}
+
+// listRemotes returns the remotes of all the objects in f
+func listRemotes(ctx context.Context, t *testing.T, f fs.Fs) (remotes []string) {
+	require.NoError(t, walk.ListR(ctx, f, "", true, -1, walk.ListObjects, func(entries fs.DirEntries) error {
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		return nil
+	}))
+	sort.Strings(remotes)
+	return remotes
+}
+
+// readObject reads the object at remote in f
+func readObject(t *testing.T, f fs.Fs, remote string, options ...fs.OpenOption) string {
+	ctx := context.Background()
+	o, err := f.NewObject(ctx, remote)
+	require.NoError(t, err)
+	in, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	return string(data)
+}
+
+func TestSquashfsSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	name := writeSquashfs(t, dir, "test.sqfs", func(ws string) {
+		require.NoError(t, os.MkdirAll(filepath.Join(ws, "src"), 0777))
+		require.NoError(t, os.WriteFile(filepath.Join(ws, "src", "file.txt"), []byte("hello"), 0666))
+		require.NoError(t, os.WriteFile(filepath.Join(ws, "src", "plain.rclonelink"), []byte("regular"), 0666))
+		require.NoError(t, os.Symlink("file.txt", filepath.Join(ws, "src", "link.txt")))
+	})
+	localFs, err := fscache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	t.Run("NoLinks", func(t *testing.T) {
+		ctx := linksCtx(false)
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"src/file.txt", "src/plain.rclonelink"}, listRemotes(ctx, t, f))
+		for _, remote := range []string{"src/link.txt", "src/link.txt.rclonelink"} {
+			_, err = f.NewObject(ctx, remote)
+			assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+		}
+		assert.Equal(t, "regular", readObject(t, f, "src/plain.rclonelink"))
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx := linksCtx(true)
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"src/file.txt", "src/link.txt.rclonelink", "src/plain.rclonelink"}, listRemotes(ctx, t, f))
+		o, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		assert.Equal(t, "file.txt", readObject(t, f, "src/link.txt.rclonelink"))
+		assert.Equal(t, "le.t", readObject(t, f, "src/link.txt.rclonelink", &fs.RangeOption{Start: 2, End: 5}))
+		assert.Equal(t, "txt", readObject(t, f, "src/link.txt.rclonelink", &fs.SeekOption{Offset: 5}))
+		assert.Equal(t, "regular", readObject(t, f, "src/plain.rclonelink"))
+	})
+
+	t.Run("Root", func(t *testing.T) {
+		ctx := linksCtx(true)
+		f, err := New(ctx, localFs, name, "", "src/link.txt.rclonelink")
+		require.ErrorIs(t, err, fs.ErrorIsFile)
+		assert.Equal(t, []string{"link.txt.rclonelink"}, listRemotes(ctx, t, f))
+		assert.Equal(t, "file.txt", readObject(t, f, "link.txt.rclonelink"))
+	})
+
+	t.Run("Copy", func(t *testing.T) {
+		ctx := linksCtx(true)
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		outDir := t.TempDir()
+		dstFs, err := fscache.Get(ctx, outDir)
+		require.NoError(t, err)
+		require.NoError(t, sync.CopyDir(ctx, dstFs, f, false))
+		target, err := os.Readlink(filepath.Join(outDir, "src", "link.txt"))
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", target)
+	})
+}
+
+// Entries which would become symlinks clashing with other entries
+// mustn't be listed as a copy could write through them.
+func TestSquashfsSymlinkClash(t *testing.T) {
+	dir := t.TempDir()
+	name := writeSquashfs(t, dir, "test.sqfs", func(ws string) {
+		require.NoError(t, os.MkdirAll(filepath.Join(ws, "fake"), 0777))
+		require.NoError(t, os.WriteFile(filepath.Join(ws, "fake", "passwd"), []byte("pwned"), 0666))
+		require.NoError(t, os.WriteFile(filepath.Join(ws, "fake.rclonelink"), []byte("../outside"), 0666))
+		require.NoError(t, os.Symlink("fake", filepath.Join(ws, "dup")))
+		require.NoError(t, os.WriteFile(filepath.Join(ws, "dup.rclonelink"), []byte("regular"), 0666))
+		require.NoError(t, os.Symlink("fake/passwd", filepath.Join(ws, "ok")))
+	})
+	ctx := linksCtx(true)
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	assert.Equal(t, []string{"dup.rclonelink", "fake/passwd", "ok.rclonelink"}, listRemotes(ctx, t, f))
+	assert.Equal(t, "regular", readObject(t, f, "dup.rclonelink"))
+	assert.Equal(t, "fake/passwd", readObject(t, f, "ok.rclonelink"))
+	_, err = f.NewObject(ctx, "fake.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+}
