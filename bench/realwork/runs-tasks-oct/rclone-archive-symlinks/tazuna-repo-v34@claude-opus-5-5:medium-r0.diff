+// A hostile zip containing a symlink pointing outside the archive and
+// entries "inside" it must not let a copy with --links write outside
+// the destination.
+func TestZipSymlinkEscape(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipLinks(t, dir, "evil.zip",
+		zipEntry{name: "evil", data: "../outside", isLink: true},
+		zipEntry{name: "evil/passwd", data: "pwned"},
+		zipEntry{name: "UPPER", data: "../outside", isLink: true},
+		zipEntry{name: "upper/passwd", data: "pwned"},
+		zipEntry{name: "nested", data: "../outside", isLink: true},
+		zipEntry{name: "nested/link", data: "../outside", isLink: true},
+		zipEntry{name: "file", data: "../outside/file", isLink: true},
+		zipEntry{name: "file", data: "pwned"},
+		zipEntry{name: "fake.rclonelink", data: "../outside"},
+		zipEntry{name: "fake/passwd", data: "pwned"},
+		zipEntry{name: "dup", data: "../outside", isLink: true},
+		zipEntry{name: "dup.rclonelink", data: "regular"},
+		zipEntry{name: "ok", data: "../outside", isLink: true},
+	)
+	ctx := linksCtx(true)
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	assert.Equal(t, []string{
+		"dup.rclonelink",
+		"evil/passwd",
+		"fake/passwd",
+		"file",
+		"nested/link.rclonelink",
+		"ok.rclonelink",
+		"upper/passwd",
+	}, allRemotes(t, f))
+	assert.Equal(t, "regular", readObject(t, f, "dup.rclonelink"))
+	for _, remote := range []string{"evil.rclonelink", "UPPER.rclonelink", "nested.rclonelink", "file.rclonelink", "fake.rclonelink"} {
+		_, err = f.NewObject(ctx, remote)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+	}
+
+	base := t.TempDir()
+	outDir := filepath.Join(base, "dst", "out")
+	outside := filepath.Join(base, "dst", "outside")
+	require.NoError(t, os.MkdirAll(outDir, 0777))
+	require.NoError(t, os.MkdirAll(outside, 0777))
+	dstFs, err := cache.Get(ctx, outDir)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, dstFs, f, false))
+	written, err := os.ReadDir(outside)
+	require.NoError(t, err)
+	assert.Empty(t, written, "copy wrote outside the destination")
+	data, err := os.ReadFile(filepath.Join(outDir, "evil", "passwd"))
+	require.NoError(t, err)
+	assert.Equal(t, "pwned", string(data))
+}
