+// zipEntry is an entry for writeZipLinks
+type zipEntry struct {
+	name   string
+	data   string
+	isLink bool // if set data is the symlink target
+}
+
+// writeZipLinks builds a zip file which may contain symlinks in dir
+// and returns its leaf name.
+func writeZipLinks(t *testing.T, dir, name string, entries ...zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, e := range entries {
+		fh := &zip.FileHeader{Name: e.name, Method: zip.Deflate}
+		if e.isLink {
+			fh.SetMode(os.ModeSymlink | 0777)
+		} else {
+			fh.SetMode(0644)
+		}
+		w, err := zw.CreateHeader(fh)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(e.data))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// linksCtx returns a context with --links set to links
+func linksCtx(links bool) context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = links
+	return ctx
+}
+
+// readObject reads the object at remote in f
+func readObject(t *testing.T, f fs.Fs, remote string, options ...fs.OpenOption) string {
+	ctx := context.Background()
+	o, err := f.NewObject(ctx, remote)
+	require.NoError(t, err)
+	in, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	return string(data)
+}
