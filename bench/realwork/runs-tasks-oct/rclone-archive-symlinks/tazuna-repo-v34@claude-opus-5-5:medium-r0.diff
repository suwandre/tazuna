+package archiver
+
+import (
+	"io"
+	"path"
+	"strings"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/lib/readers"
+)
+
+// MaxLinkTarget is the longest symlink target read from an archive
+const MaxLinkTarget = 4096
+
+// LinkFilter decides which entries ending in fs.LinkSuffix are safe
+// to list when symlinks are being translated with --links.
+//
+// When copied with --links each such entry becomes a symlink at its
+// name without the suffix. If another entry has that name, or lives
+// beneath it, the copy could write through the symlink to outside the
+// destination, so those entries are rejected. Names are compared case
+// insensitively as the destination may be case insensitive.
+type LinkFilter struct {
+	names   map[string]struct{} // entries which aren't translated to symlinks and their parents
+	regular map[string]struct{} // regular files whose names end in fs.LinkSuffix
+}
+
+// NewLinkFilter makes a new LinkFilter
+func NewLinkFilter() *LinkFilter {
+	return &LinkFilter{
+		names:   map[string]struct{}{},
+		regular: map[string]struct{}{},
+	}
+}
+
+// addParents records all the parent directories of remote
+func (lf *LinkFilter) addParents(remote string) {
+	for dir := path.Dir(remote); dir != "." && dir != "/" && dir != ""; dir = path.Dir(dir) {
+		lf.names[strings.ToLower(dir)] = struct{}{}
+	}
+}
+
+// AddName records remote as an entry which won't become a symlink
+func (lf *LinkFilter) AddName(remote string) {
+	lf.names[strings.ToLower(remote)] = struct{}{}
+	lf.addParents(remote)
+}
+
+// AddLink records remote, which ends in fs.LinkSuffix, as an entry
+// which will become a symlink. isLink should be false if it is a
+// regular file in the archive.
+//
+// All entries must be added before Allow is called.
+func (lf *LinkFilter) AddLink(remote string, isLink bool) {
+	lf.addParents(remote)
+	if !isLink {
+		lf.regular[strings.ToLower(remote)] = struct{}{}
+	}
+}
+
+// Allow reports whether the entry added with AddLink may be listed
+//
+// A symlink loses out to a regular file with the same name.
+func (lf *LinkFilter) Allow(remote string, isLink bool) bool {
+	lower := strings.ToLower(remote)
+	if _, found := lf.names[strings.TrimSuffix(lower, fs.LinkSuffix)]; found {
+		return false
+	}
+	if isLink {
+		if _, found := lf.regular[lower]; found {
+			return false
+		}
+	}
+	return true
+}
+
+// OpenLink returns a reader for the symlink target honouring the
+// fs.SeekOption and fs.RangeOption in options.
+func OpenLink(o fs.Object, target string, options ...fs.OpenOption) io.ReadCloser {
+	var offset, limit int64 = 0, -1
+	size := int64(len(target))
+	for _, option := range options {
+		switch x := option.(type) {
+		case *fs.SeekOption:
+			offset = x.Offset
+		case *fs.RangeOption:
+			offset, limit = x.Decode(size)
+		default:
+			if option.Mandatory() {
+				fs.Logf(o, "Unsupported mandatory option: %v", option)
+			}
+		}
+	}
+	offset = min(max(offset, 0), size)
+	rc := io.NopCloser(strings.NewReader(target[offset:]))
+	if limit >= 0 {
+		return readers.NewLimitedReadCloser(rc, limit)
+	}
+	return rc
+}
