+// A zip containing a symlink and a regular file whose name already ends
+// in the link suffix. Without -l/--links the symlink is absent; with it
+// the symlink is listed under the suffix and reads back its target,
+// while the regular member keeps its own name and content.
+func TestZipSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "links.zip",
+		zipEntry{name: "src/file.txt", content: "hello"},
+		zipEntry{name: "src/link.txt", content: "file.txt", mode: os.ModeSymlink | 0777},
+		zipEntry{name: "plain.rclonelink", content: "not a link"},
+		zipEntry{name: "src/"},
+	)
+
