+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	fdst, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+
+	// Copy every member, as rclone copy --links does. A symlink is
+	// copied under its suffixed name, which the local backend turns
+	// back into a symlink. The member stored under the escaping
+	// symlink is expected to be refused rather than written through it.
+	var copied []string
+	err = walk.ListR(ctx, f, "", true, -1, walk.ListObjects, func(entries fs.DirEntries) error {
+		for _, entry := range entries {
+			o, ok := entry.(fs.Object)
+			if !ok {
+				continue
+			}
+			err := operations.CopyFile(ctx, fdst, f, o.Remote(), o.Remote())
+			if err != nil {
+				assert.Equal(t, "escape/pwned.txt", o.Remote())
+				assert.ErrorContains(t, err, "path escapes from parent")
+				continue
+			}
+			copied = append(copied, o.Remote())
+		}
+		return nil
+	})
+	require.NoError(t, err)
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/link.txt.rclonelink", "escape.rclonelink"}, copied)
+
+	link := filepath.Join(dst, "src", "link.txt")
+	fi, err := os.Lstat(link)
+	require.NoError(t, err)
+	assert.NotEqual(t, 0, fi.Mode()&os.ModeSymlink)
+	target, err := os.Readlink(link)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+
+	// The member stored under the escaping symlink must not have been
+	// written through it.
+	_, err = os.Lstat(filepath.Join(outside, "pwned.txt"))
+	assert.True(t, os.IsNotExist(err), "copy wrote outside the destination")
+	_, err = os.Lstat(filepath.Join(dst, "pwned.txt"))
+	assert.True(t, os.IsNotExist(err))
+}
