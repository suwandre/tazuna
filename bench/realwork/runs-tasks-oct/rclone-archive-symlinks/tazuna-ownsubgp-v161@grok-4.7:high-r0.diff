+		zipEntry{name: "src/link.txt", content: "file.txt", mode: os.ModeSymlink | 0777},
+		zipEntry{name: "escape", content: "../../outside", mode: os.ModeSymlink | 0777},
+		zipEntry{name: "escape/pwned.txt", content: "pwned"},
+	)
+
+	dst := t.TempDir()
+	outside := filepath.Join(filepath.Dir(dst), "outside")
+	require.NoError(t, os.MkdirAll(outside, 0700))
+	t.Cleanup(func() {
