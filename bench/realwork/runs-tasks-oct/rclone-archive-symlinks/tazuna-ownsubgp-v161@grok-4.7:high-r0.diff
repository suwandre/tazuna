+
+// TranslateSymlinks reports whether symlinks should be exposed, following
+// the global -l/--links flag.
+func TranslateSymlinks(ctx context.Context) bool {
+	return fs.GetConfig(ctx).Links
+}
+
+// LinkRemote returns the name a symlink is listed under when translating
+// symlinks. A name which already ends in the link suffix is left as it is,
+// so a regular archive member with that suffix stays a regular file.
+func LinkRemote(remote string) string {
+	if strings.HasSuffix(remote, fs.LinkSuffix) {
+		return remote
+	}
+	return remote + fs.LinkSuffix
+}
+
+// NoteSkippedSymlinks logs that symlinks were not shown. It should be
+// called once per listing when some were skipped, so a crafted archive
+// can't flood the log.
+func NoteSkippedSymlinks(f fs.Fs, where string) {
+	if where == "" {
+		fs.Logf(f, "Skipped symbolic links in the archive without -l/--links")
+		return
+	}
+	fs.Logf(f, "Skipped symbolic links in %q without -l/--links", where)
+}
+
+// OpenLink opens the link target as the object's content, honouring
+// range and seek options the same way a regular file does.
+func OpenLink(o fs.Object, target string, options ...fs.OpenOption) (io.ReadCloser, error) {
+	var offset, limit int64 = 0, -1
+	for _, option := range options {
+		switch x := option.(type) {
+		case *fs.SeekOption:
+			offset = x.Offset
+		case *fs.RangeOption:
+			offset, limit = x.Decode(o.Size())
+		default:
+			if option.Mandatory() {
+				fs.Logf(o, "Unsupported mandatory option: %v", option)
+			}
+		}
+	}
+	data := []byte(target)
+	if offset > int64(len(data)) {
+		offset = int64(len(data))
+	}
+	r := io.NopCloser(bytes.NewReader(data[offset:]))
+	if limit >= 0 {
+		return readers.NewLimitedReadCloser(r, limit), nil
+	}
+	return r, nil
+}
