+// writeZipWithLinks builds a zip file in dir containing a regular file
+// "file.txt", a symlink "link.txt" pointing at "file.txt", and a regular
+// file "other.txt.rclonelink" whose name merely looks like a link.
+func writeZipWithLinks(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("data"))
+	require.NoError(t, err)
+	hdr := &zip.FileHeader{Name: "link.txt", Method: zip.Store}
+	hdr.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(hdr)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+	w, err = zw.Create("other.txt.rclonelink")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("regular"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// Symlinks in a zip are skipped unless --links is set, and then they are
+// listed and looked up under the fs.LinkSuffix name with the target as content.
+func TestReadZipSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipWithLinks(t, dir, "links.zip")
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	t.Run("NoLinks", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(ctx)
+		ci.Links = false
