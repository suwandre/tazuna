+// maxLinkTargetSize bounds the target of a symlink read from the archive
+const maxLinkTargetSize = 4096
+
+// readLinkTarget returns the target stored in the symlink entry file
+func readLinkTarget(file *zip.File) (target string, err error) {
+	rc, err := file.Open()
+	if err != nil {
+		return "", err
+	}
+	defer fs.CheckClose(rc, &err)
+	data, err := io.ReadAll(io.LimitReader(rc, maxLinkTargetSize+1))
+	if err != nil {
+		return "", err
+	}
+	if len(data) > maxLinkTargetSize {
+		return "", errors.New("symlink target too long")
+	}
+	return string(data), nil
+}
