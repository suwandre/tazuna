+		require.NoError(t, err)
+		assert.Equal(t, []string{"file.txt", "other.txt.rclonelink"}, allRemotes(t, f))
+		_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(ctx)
+		ci.Links = true
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"file.txt", "link.txt.rclonelink", "other.txt.rclonelink"}, allRemotes(t, f))
+
+		entries, err := f.List(ctx, "")
