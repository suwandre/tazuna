+// Symlinks in an image are hidden unless --links is set, and then they are
+// listed and looked up under the fs.LinkSuffix name, reading back the target.
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	t.Run("NoLinks", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(ctx)
+		ci.Links = false
+		f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+		require.NoError(t, err)
+
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		require.Len(t, entries, 1)
+		assert.Equal(t, "file.txt", entries[0].Remote())
+
+		_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(ctx)
+		ci.Links = true
+		f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+		require.NoError(t, err)
+
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, e := range entries {
+			remotes = append(remotes, e.Remote())
+		}
+		assert.ElementsMatch(t, []string{"file.txt", "link.txt" + fs.LinkSuffix}, remotes)
+
+		o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		rc, err := o.Open(ctx)
+		require.NoError(t, err)
+		got, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "file.txt", string(got))
+
+		rc, err = o.Open(ctx, &fs.RangeOption{Start: 5, End: -1})
+		require.NoError(t, err)
+		got, err = io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "txt", string(got))
+
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+}
