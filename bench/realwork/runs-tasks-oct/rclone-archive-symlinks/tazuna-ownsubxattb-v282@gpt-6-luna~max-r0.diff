+// writeSymlinkZip builds a ZIP with a symbolic link and a regular member
+// whose name ends in fs.LinkSuffix.
+func writeSymlinkZip(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+
+	for _, test := range []struct {
+		name, content string
+		mode          os.FileMode
+	}{
+		{"src/file.txt", "file contents", 0600},
+		{"src/link.txt", "file.txt", os.ModeSymlink | 0777},
+		{"src/regular" + fs.LinkSuffix, "regular contents", 0600},
+	} {
+		h := &zip.FileHeader{Name: test.name, Method: zip.Store}
+		h.SetMode(test.mode)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(test.content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
