+// Symbolic links are skipped by default, and with --links they are exposed
+// as translated link objects whose contents are the link targets.
+func TestSymlinks(t *testing.T) {
+	if _, err := exec.LookPath("mksquashfs"); err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("file contents"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "regular"+fs.LinkSuffix), []byte("regular contents"), 0600))
+	if err := os.Symlink("file.txt", filepath.Join(input, "link.txt")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	archive := filepath.Join(t.TempDir(), "links.sqfs")
+	cmd := exec.Command("mksquashfs", input, archive, "-noappend", "-quiet", "-no-xattrs")
+	require.NoError(t, cmd.Run())
+
+	baseCtx := context.Background()
+	localFs, err := fscache.Get(baseCtx, filepath.Dir(archive))
+	require.NoError(t, err)
+
+	ctx, ci := fs.AddConfig(baseCtx)
+	ci.Links = false
+	f, err := New(ctx, localFs, filepath.Base(archive), "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	assert.Len(t, entries, 2)
+	_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctx, ci = fs.AddConfig(baseCtx)
+	ci.Links = true
+	f, err = New(ctx, localFs, filepath.Base(archive), "", "")
+	require.NoError(t, err)
+	entries, err = f.List(ctx, "")
+	require.NoError(t, err)
+	assert.Len(t, entries, 3)
+
+	link, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	rc, err := link.Open(ctx, &fs.RangeOption{Start: 1, End: 4})
+	require.NoError(t, err)
+	got, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ile.", string(got))
+
+	rc, err = link.Open(ctx, &fs.SeekOption{Offset: 5})
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "txt", string(got))
+
+	regular, err := f.NewObject(ctx, "regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	rc, err = regular.Open(ctx)
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "regular contents", string(got))
+
+	single, err := New(ctx, localFs, filepath.Base(archive), "", "link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	singleLink, err := single.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), singleLink.Size())
+}
