+// A hostile archive whose symlinks point outside the destination must not
+// let a copy with --links write outside the destination.
+func TestReadZipSymlinkEscapeNotWritten(t *testing.T) {
+	base := t.TempDir()
+	archiveDir := filepath.Join(base, "archive")
+	dest := filepath.Join(base, "dest")
+	outside := filepath.Join(base, "outside")
+	for _, dir := range []string{archiveDir, dest, outside} {
+		require.NoError(t, os.Mkdir(dir, 0755))
+	}
+	name := writeZipMembers(t, archiveDir, "hostile.zip",
+		zipLink("rel", "../outside"),
+		zipFile("rel/evil.txt", "evil"),
+		zipLink("abs", outside),
+		zipFile("abs/evil2.txt", "evil"),
+	)
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	localFs, err := cache.Get(ctx, archiveDir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	destFs, err := cache.Get(ctx, dest)
+	require.NoError(t, err)
+	// Errors are expected for the entries which can't be written safely
+	_ = sync.CopyDir(ctx, destFs, f, false)
+
+	for _, leaf := range []string{"evil.txt", "evil2.txt"} {
+		_, err := os.Stat(filepath.Join(outside, leaf))
+		assert.ErrorIs(t, err, os.ErrNotExist, leaf)
