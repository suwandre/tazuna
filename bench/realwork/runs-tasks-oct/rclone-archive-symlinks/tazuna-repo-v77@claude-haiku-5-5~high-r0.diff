+	ctx, f := newSymlinkTestFs(t, false)
+
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/data.txt.rclonelink", "src/clash.rclonelink"}, entryRemotes(entries))
+
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = f.NewObject(ctx, "src/link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+}
+
+// With --links a symlink is listed with fs.LinkSuffix and reads as its target
+func TestSymlinksListedWithLinks(t *testing.T) {
+	ctx, f := newSymlinkTestFs(t, true)
+
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/link.txt.rclonelink", "src/data.txt.rclonelink", "src/clash.rclonelink"}, entryRemotes(entries))
+	for _, entry := range entries {
+		_, err := f.NewObject(ctx, entry.Remote())
+		assert.NoError(t, err, entry.Remote())
+	}
+
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	o, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	assert.Equal(t, "file.txt", readObjectWith(ctx, t, o))
+	assert.Equal(t, "le.t", readObjectWith(ctx, t, o, &fs.RangeOption{Start: 2, End: 5}))
+	assert.Equal(t, "txt", readObjectWith(ctx, t, o, &fs.SeekOption{Offset: 5}))
+}
+
+// A regular file keeps its name even when it ends in fs.LinkSuffix, and a
