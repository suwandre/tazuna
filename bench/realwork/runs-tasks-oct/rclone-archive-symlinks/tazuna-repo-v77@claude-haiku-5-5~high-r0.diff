+// newSymlinkTestFs returns symlink.sqfs, which holds src/file.txt ("hello"),
+// src/link.txt -> file.txt, src/data.txt.rclonelink (a regular file "x"),
+// src/clash -> file.txt and src/clash.rclonelink (a regular file "y").
+func newSymlinkTestFs(t *testing.T, links bool) (context.Context, fs.Fs) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = links
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+	return ctx, f
