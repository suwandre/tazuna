+// zipMember is an entry for writeZipMembers. A symlink has os.ModeSymlink
+// in mode and its body is the link target.
+type zipMember struct {
+	name string
+	mode os.FileMode
+	body string
+}
+
+func zipFile(name, body string) zipMember {
+	return zipMember{name: name, mode: 0644, body: body}
+}
+
+func zipLink(name, target string) zipMember {
+	return zipMember{name: name, mode: os.ModeSymlink | 0777, body: target}
+}
+
+// writeZipMembers builds a zip file from members in dir and returns its leaf name.
+func writeZipMembers(t *testing.T, dir, name string, members ...zipMember) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, m := range members {
+		hdr := &zip.FileHeader{Name: m.name, Method: zip.Deflate}
+		hdr.SetMode(m.mode)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(m.body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
