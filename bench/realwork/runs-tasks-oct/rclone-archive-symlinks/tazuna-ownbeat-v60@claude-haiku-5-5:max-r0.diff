+
+// writeZipWithSymlink builds a zip file in dir containing a regular file
+// "target.txt", a symlink "link.txt" pointing at it and a regular file
+// named like a translated link, and returns its leaf name.
+func writeZipWithSymlink(t *testing.T, dir string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	add := func(name string, mode os.FileMode, content string) {
+		fh := &zip.FileHeader{Name: name, Method: zip.Store}
+		fh.SetMode(mode)
+		w, err := zw.CreateHeader(fh)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	add("target.txt", 0644, "hello")
+	add("link.txt", os.ModeSymlink|0777, "target.txt")
+	add("regular.rclonelink", 0644, "not a link")
+	require.NoError(t, zw.Close())
+	name := "links.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// Symlinks in a zip archive are skipped without --links and listed
+// under the LinkSuffix name with --links, whose content is the target.
+func TestReadZipSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipWithSymlink(t, dir)
+
+	localFs, err := cache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	t.Run("NoLinks", func(t *testing.T) {
+		ctx := context.Background()
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"regular.rclonelink", "target.txt"}, allRemotes(t, f))
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(context.Background())
+		ci.Links = true
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"link.txt.rclonelink", "regular.rclonelink", "target.txt"}, allRemotes(t, f))
+
+		// NewObject must agree with the listing
+		o, err := f.NewObject(ctx, "link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("target.txt")), o.Size())
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// Opening reads the target, honouring range and seek options
+		readAll := func(options ...fs.OpenOption) string {
+			in, err := o.Open(ctx, options...)
+			require.NoError(t, err)
+			defer func() { require.NoError(t, in.Close()) }()
+			b, err := io.ReadAll(in)
+			require.NoError(t, err)
+			return string(b)
+		}
+		assert.Equal(t, "target.txt", readAll())
+		assert.Equal(t, "et.txt", readAll(&fs.SeekOption{Offset: 4}))
+		assert.Equal(t, "rge", readAll(&fs.RangeOption{Start: 2, End: 4}))
+
+		// A regular member named like a translated link stays a regular file
+		r, err := f.NewObject(ctx, "regular.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("not a link")), r.Size())
+	})
+}
