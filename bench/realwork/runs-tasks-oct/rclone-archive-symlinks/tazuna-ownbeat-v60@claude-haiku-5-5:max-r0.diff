@@ -2,9 +2,11 @@ package squashfs
 
 import (
 	"context"
+	"io"
 	"testing"
 
 	_ "github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
 	fscache "github.com/rclone/rclone/fs/cache"
 	"github.com/stretchr/testify/assert"
 	"github.com/stretchr/testify/require"
@@ -30,3 +32,60 @@ func TestBackslashInName(t *testing.T) {
 	require.NoError(t, err)
 	assert.Equal(t, int64(6), o.Size())
 }
+
+// Symlinks in a squashfs image are skipped without --links and listed
+// under the LinkSuffix name with --links, whose content is the target.
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	t.Run("NoLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, "links.sqfs", "", "")
+		require.NoError(t, err)
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, e := range entries {
+			remotes = append(remotes, e.Remote())
+		}
+		assert.Equal(t, []string{"regular.rclonelink", "target.txt"}, remotes)
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(ctx)
+		ci.Links = true
+		f, err := New(ctx, localFs, "links.sqfs", "", "")
+		require.NoError(t, err)
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, e := range entries {
+			remotes = append(remotes, e.Remote())
+		}
+		assert.Equal(t, []string{"link.txt.rclonelink", "regular.rclonelink", "target.txt"}, remotes)
+
+		// NewObject must agree with the listing
+		o, err := f.NewObject(ctx, "link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("target.txt")), o.Size())
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		readAll := func(options ...fs.OpenOption) string {
+			in, err := o.Open(ctx, options...)
+			require.NoError(t, err)
+			defer func() { require.NoError(t, in.Close()) }()
+			b, err := io.ReadAll(in)
+			require.NoError(t, err)
+			return string(b)
+		}
+		assert.Equal(t, "target.txt", readAll())
+		assert.Equal(t, "et.txt", readAll(&fs.SeekOption{Offset: 4}))
+		assert.Equal(t, "rge", readAll(&fs.RangeOption{Start: 2, End: 4}))
+
+		r, err := f.NewObject(ctx, "regular.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("not a link\n")), r.Size())
+	})
+}
