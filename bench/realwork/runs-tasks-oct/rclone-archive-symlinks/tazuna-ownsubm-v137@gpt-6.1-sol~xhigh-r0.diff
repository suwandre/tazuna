+	"github.com/rclone/rclone/fs/config/configmap"
+	"github.com/rclone/rclone/fs/log"
+	"github.com/rclone/rclone/fs/operations"
+	"github.com/rclone/rclone/fs/sync"
+	"github.com/rclone/rclone/fstest"
+	"github.com/rclone/rclone/fstest/fstests"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// squashfs/testdata/symlinks.sqfs contains the tree built by writeLinkZip,
+// packed with mksquashfs input symlinks.sqfs -noappend -no-xattrs -all-root
+// -all-time 0 -mkfs-time 0 -comp gzip.
+var archiveLinkTargets = map[string]string{
+	"link.txt":                 "file.txt",
+	"directory":                "../src",
+	"dangling":                 "missing",
+	"absolute":                 "/missing/target",
+	"chain":                    "link.txt",
+	"loop":                     "loop",
+	"unicode":                  "café.txt",
+	"suffixed" + fs.LinkSuffix: "file.txt",
+}
+
+// writeLinkZip writes the same tree as squashfs/testdata/symlinks.sqfs.
+func writeLinkZip(t *testing.T) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for name, contents := range map[string]string{
+		"file.txt":                "hello",
+		"literal" + fs.LinkSuffix: "regular file",
+	} {
+		w, err := zw.Create("src/" + name)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(contents))
+		require.NoError(t, err)
+	}
+	for name, target := range archiveLinkTargets {
+		h := &zip.FileHeader{Name: "src/" + name, Method: zip.Deflate}
+		h.SetMode(os.ModeSymlink | 0o777)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(target))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(t.TempDir(), "symlinks.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0o600))
+	return zipPath
+}
+
+func TestArchiveSymlinks(t *testing.T) {
+	fstest.Initialise()
+	for _, archivePath := range []string{writeLinkZip(t), "squashfs/testdata/symlinks.sqfs"} {
+		t.Run(filepath.Ext(archivePath), func(t *testing.T) {
+			for _, links := range []bool{false, true} {
+				t.Run(fmt.Sprintf("links=%v", links), func(t *testing.T) {
+					ctx, ci := fs.AddConfig(context.Background())
+					ci.Links = links
+					localFs, err := cache.Get(ctx, filepath.Dir(archivePath))
+					require.NoError(t, err)
+					name := filepath.Base(archivePath)
+					for _, test := range []struct{ prefix, root, dir string }{
+						{"", "", "src"},
+						{"nested/" + name, "", "nested/" + name + "/src"},
+						{"", "src", ""},
+					} {
+						t.Run(fmt.Sprintf("prefix=%q,root=%q", test.prefix, test.root), func(t *testing.T) {
+							var notices strings.Builder
+							log.Handler.SetOutput(func(level slog.Level, text string) {
+								if level == fs.SlogLevelNotice {
+									notices.WriteString(text)
+								}
+							})
+							defer log.Handler.ResetOutput()
+
+							f, err := findArchive(name).archiver.New(ctx, localFs, name, test.prefix, test.root)
+							require.NoError(t, err)
+							entries, err := f.List(ctx, test.dir)
+							require.NoError(t, err)
+							want := map[string]string{
+								"file.txt":                "hello",
+								"literal" + fs.LinkSuffix: "regular file",
+							}
+							for name, target := range archiveLinkTargets {
+								_, err := f.NewObject(ctx, path.Join(test.dir, name))
+								assert.ErrorIs(t, err, fs.ErrorObjectNotFound, name)
+								if links {
+									want[name+fs.LinkSuffix] = target
+								} else {
+									_, err = f.NewObject(ctx, path.Join(test.dir, name+fs.LinkSuffix))
+									assert.ErrorIs(t, err, fs.ErrorObjectNotFound, name)
+								}
+							}
+							_, err = f.NewObject(ctx, path.Join(test.dir, "directory/file.txt"))
+							assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+							assert.Len(t, entries, len(want))
+							for _, entry := range entries {
+								contents, ok := want[path.Base(entry.Remote())]
+								require.True(t, ok, "unexpected entry %q", entry.Remote())
+								o, ok := entry.(fs.Object)
+								require.True(t, ok, entry.Remote())
+								assert.Equal(t, int64(len(contents)), o.Size(), o.Remote())
+								assert.Equal(t, contents, fstests.ReadObject(ctx, t, o, -1))
+								found, err := f.NewObject(ctx, o.Remote())
+								require.NoError(t, err, o.Remote())
+								assert.Equal(t, o.Remote(), found.Remote())
+								assert.Equal(t, contents, fstests.ReadObject(ctx, t, found, -1))
+								for _, test := range []struct {
+									option fs.OpenOption
+									want   string
+								}{
+									{&fs.SeekOption{Offset: 2}, contents[2:]},
+									{&fs.RangeOption{Start: 1, End: 3}, contents[1:4]},
+									{&fs.RangeOption{Start: 2, End: -1}, contents[2:]},
+									{&fs.RangeOption{Start: -1, End: 2}, contents[len(contents)-2:]},
+								} {
+									assert.Equal(t, test.want, fstests.ReadObject(ctx, t, found, -1, test.option))
+								}
+							}
+							if links {
+								assert.NotContains(t, notices.String(), "--links")
+							} else {
+								assert.Contains(t, notices.String(), "--links")
+							}
+						})
+					}
+					if links {
+						f, err := findArchive(name).archiver.New(ctx, localFs, name, "", "src/link.txt"+fs.LinkSuffix)
+						require.ErrorIs(t, err, fs.ErrorIsFile)
+						entries, err := f.List(ctx, "")
+						require.NoError(t, err)
+						require.Len(t, entries, 1)
+						assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+						o, err := f.NewObject(ctx, entries[0].Remote())
+						require.NoError(t, err)
+						assert.Equal(t, "file.txt", fstests.ReadObject(ctx, t, o, -1))
+					}
+				})
+			}
+		})
+	}
+}
+
+func TestArchiveCopySymlink(t *testing.T) {
+	fstest.Initialise()
+	for _, archivePath := range []string{writeLinkZip(t), "squashfs/testdata/symlinks.sqfs"} {
+		t.Run(filepath.Ext(archivePath), func(t *testing.T) {
+			ctx, ci := fs.AddConfig(context.Background())
+			ci.Links = true
+			dir := t.TempDir()
+			if err := os.Symlink("file.txt", filepath.Join(dir, "probe")); err != nil {
+				t.Skipf("symlinks unavailable: %v", err)
+			}
+			f, err := NewFs(ctx, "archive", archivePath, configmap.Simple{})
+			require.NoError(t, err)
+			dst, err := cache.Get(ctx, dir)
+			require.NoError(t, err)
+			require.NoError(t, sync.CopyDir(ctx, dst, f, false))
+			target, err := os.Readlink(filepath.Join(dir, "src/link.txt"))
+			require.NoError(t, err)
+			assert.Equal(t, "file.txt", target)
+		})
+	}
+}
+
+// A ZIP can contain both a symlink and a member beneath its name.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	require.NoError(t, os.Mkdir(filepath.Join(dir, "outside"), 0o700))
+	if err := os.Symlink("../outside", filepath.Join(dir, "probe")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	h := &zip.FileHeader{Name: "escape"}
+	h.SetMode(os.ModeSymlink | 0o777)
+	w, err := zw.CreateHeader(h)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("../outside"))
+	require.NoError(t, err)
+	w, err = zw.Create("escape/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(t.TempDir(), "hostile.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0o600))
+
+	f, err := NewFs(ctx, "archive", zipPath, configmap.Simple{})
+	require.NoError(t, err)
+	dst, err := cache.Get(ctx, filepath.Join(dir, "out"))
+	require.NoError(t, err)
+	for _, remote := range []string{"escape" + fs.LinkSuffix, "escape/authkeys"} {
+		src, err := f.NewObject(ctx, remote)
+		require.NoError(t, err)
+		_, err = operations.Copy(ctx, dst, nil, remote, src)
+		if strings.HasSuffix(remote, fs.LinkSuffix) {
+			require.NoError(t, err)
+		} else {
+			require.Error(t, err, "copy must not write through a symlink outside the destination")
+		}
+	}
+	target, err := os.Readlink(filepath.Join(dir, "out/escape"))
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", target)
+	outside, err := os.ReadDir(filepath.Join(dir, "outside"))
+	require.NoError(t, err)
+	assert.Empty(t, outside)
+}
