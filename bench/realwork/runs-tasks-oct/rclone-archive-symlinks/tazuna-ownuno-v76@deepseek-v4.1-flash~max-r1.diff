+// A hostile archive must not make a copy write through a symlink out of
+// the destination: a symlink pointing above the root plus a member
+// "inside" it.
+func TestZipSymlinkEscape(t *testing.T) {
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("Skipping as symlinks are unavailable: %v", err)
+	}
+	evil := t.TempDir()
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "evil.zip", []zipTestEntry{
+		{name: "pwn", data: []byte(evil), mode: os.ModeSymlink | 0777},
+		{name: "pwn/authkeys", data: []byte("PWNED"), mode: 0644},
+	})
+	ctx := linksContext()
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	// The symlink is reproduced faithfully, pointing outside the destination.
+	src, err := f.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn"+fs.LinkSuffix, src)
+	require.NoError(t, err)
+	target, err := os.Readlink(filepath.Join(dstDir, "pwn"))
+	require.NoError(t, err)
+	assert.Equal(t, evil, target)
+
+	// But writing the member "inside" it must be refused.
+	src, err = f.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn/authkeys", src)
+	require.Error(t, err)
+
+	// Nothing escaped the destination.
+	_, err = os.Stat(filepath.Join(evil, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination")
+}
