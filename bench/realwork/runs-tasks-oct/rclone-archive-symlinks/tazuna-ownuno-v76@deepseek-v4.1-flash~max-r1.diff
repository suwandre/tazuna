+// zipTestEntry describes an entry for writeZipEntries.
+type zipTestEntry struct {
+	name string
+	data []byte
+	mode os.FileMode
+}
+
+// writeZipEntries builds a zip file with the given entries in dir and
+// returns its leaf name. A mode with os.ModeSymlink makes a symlink
+// entry whose data is the link target.
+func writeZipEntries(t *testing.T, dir, name string, entries []zipTestEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		hdr := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+		hdr.SetMode(entry.mode)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write(entry.data)
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
