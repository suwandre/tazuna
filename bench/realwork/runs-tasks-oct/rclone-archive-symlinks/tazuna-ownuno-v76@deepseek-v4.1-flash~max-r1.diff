+// writeSymlinkImage builds a squashfs image with a regular file, a
+// symlink to it and a regular file whose name ends in the link suffix,
+// returning the image path.
+func writeSymlinkImage(t *testing.T) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "links.sqfs")
+	f, err := os.Create(path)
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, f.Close())
+	}()
+	sqfs, err := diskfsquashfs.Create(file.New(f, false), 0, 0, 4096)
+	require.NoError(t, err)
+	workspace := sqfs.Workspace()
+	require.NoError(t, os.MkdirAll(filepath.Join(workspace, "src"), 0755))
+	require.NoError(t, os.WriteFile(filepath.Join(workspace, "src", "file.txt"), []byte("hello"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(workspace, "src", "plain.rclonelink"), []byte("regular"), 0644))
+	if err := os.Symlink("file.txt", filepath.Join(workspace, "src", "link.txt")); err != nil {
+		t.Skipf("Skipping as symlinks are unavailable: %v", err)
+	}
+	// A symlink whose translated name is taken by a regular file
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(workspace, "src", "plain")))
+	// go-diskfs reads symlink targets relative to the working directory
+	// rather than the workspace, so run Finalize from the workspace.
+	oldCwd, err := os.Getwd()
+	require.NoError(t, err)
+	require.NoError(t, os.Chdir(workspace))
+	defer func() {
+		require.NoError(t, os.Chdir(oldCwd))
+	}()
+	require.NoError(t, sqfs.Finalize(diskfsquashfs.FinalizeOptions{}))
+	return path
+}
+
+// linksContext returns a context with -l/--links enabled.
+func linksContext() context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	return ctx
+}
+
+// readObject reads the contents of an object with the options passed in.
+func readObject(ctx context.Context, t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	defer func() {
+		assert.NoError(t, rc.Close())
+	}()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(data)
+}
+
+// listRemotes returns the sorted remotes in dir.
+func listRemotes(ctx context.Context, t *testing.T, f fs.Fs, dir string) []string {
+	entries, err := f.List(ctx, dir)
+	require.NoError(t, err)
+	remotes := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	sort.Strings(remotes)
+	return remotes
+}
+
+// Symlinks are skipped without -l/--links and exposed under the link
+// suffix with it. A regular member whose name ends in the suffix stays
+// a regular file.
+func TestSymlinks(t *testing.T) {
+	imagePath := writeSymlinkImage(t)
+	dir := filepath.Dir(imagePath)
+	name := filepath.Base(imagePath)
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	t.Run("without links", func(t *testing.T) {
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"src/file.txt", "src/plain.rclonelink"}, listRemotes(ctx, t, f, "src"))
+
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		o, err := f.NewObject(ctx, "src/plain.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("regular")), o.Size())
+		assert.Equal(t, "regular", readObject(ctx, t, o))
+	})
+
+	t.Run("with links", func(t *testing.T) {
+		ctx := linksContext()
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix, "src/plain.rclonelink"}, listRemotes(ctx, t, f, "src"))
+
+		// The original symlink name doesn't exist...
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// ...but the translated name does, and reads back the target.
+		o, err := f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(ctx, t, o))
+		assert.Equal(t, "le.txt", readObject(ctx, t, o, &fs.SeekOption{Offset: 2}))
+		assert.Equal(t, "file", readObject(ctx, t, o, &fs.RangeOption{Start: 0, End: 3}))
+
+		// A regular file whose name ends in the suffix is unchanged.
+		o, err = f.NewObject(ctx, "src/plain.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("regular")), o.Size())
+		assert.Equal(t, "regular", readObject(ctx, t, o))
+	})
+
+	t.Run("root is a file", func(t *testing.T) {
+		f, err := New(ctx, localFs, name, "", "src/file.txt")
+		require.ErrorIs(t, err, fs.ErrorIsFile)
+		assert.Equal(t, []string{"file.txt"}, listRemotes(ctx, t, f, ""))
+		o, err := f.NewObject(ctx, "file.txt")
+		require.NoError(t, err)
+		assert.Equal(t, "hello", readObject(ctx, t, o))
+	})
+
+	t.Run("root is a symlink", func(t *testing.T) {
+		ctx := linksContext()
+		f, err := New(ctx, localFs, name, "", "src/link.txt")
+		require.ErrorIs(t, err, fs.ErrorIsFile)
+		assert.Equal(t, []string{"link.txt" + fs.LinkSuffix}, listRemotes(ctx, t, f, ""))
+		o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", readObject(ctx, t, o))
+	})
+}
