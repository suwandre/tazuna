+// TestZipSymlinkEscapeBlocked checks that an archive cannot write outside the
+// destination through a symlink and a member beneath it.
+func TestZipSymlinkEscapeBlocked(t *testing.T) {
+	skipIfNoSymlinks(t)
+	ctx := context.Background()
+	linksCtx, config := fs.AddConfig(ctx)
+	config.Links = true
+
+	base := t.TempDir()
+	archiveDir := filepath.Join(base, "archive")
+	require.NoError(t, os.Mkdir(archiveDir, 0700))
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	linkHeader := &zip.FileHeader{Name: "src/link"}
+	linkHeader.SetMode(os.ModeSymlink | 0777)
+	linkWriter, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = linkWriter.Write([]byte("../../outside"))
+	require.NoError(t, err)
+	fileWriter, err := zw.Create("src/link/pwn")
+	require.NoError(t, err)
+	_, err = fileWriter.Write([]byte("pwned"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	archiveName := "evil.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(archiveDir, archiveName), buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, archiveDir)
+	require.NoError(t, err)
+	source, err := New(linksCtx, localFs, archiveName, "", "")
+	require.NoError(t, err)
+	dstPath := filepath.Join(base, "destination")
+	destination, err := localbackend.NewFs(linksCtx, "local", dstPath, configmap.Simple{})
+	require.NoError(t, err)
+	err = sync.CopyDir(linksCtx, destination, source, true)
+	assert.Error(t, err, "copy should refuse to write through the archive symlink")
+
+	_, err = os.Stat(filepath.Join(base, "outside"))
+	assert.True(t, os.IsNotExist(err), "archive wrote outside the destination")
+}
+
+func skipIfNoSymlinks(t *testing.T) {
+	t.Helper()
+	name := filepath.Join(t.TempDir(), "link")
+	if err := os.Symlink("target", name); err != nil {
+		t.Skipf("symbolic links are unavailable: %v", err)
+	}
+}
