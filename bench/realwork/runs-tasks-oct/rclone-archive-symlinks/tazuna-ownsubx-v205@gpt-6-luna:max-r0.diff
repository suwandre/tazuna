+// TestReadZipSymlinks checks that symlinks are hidden by default and are
+// exposed as translated links when --links is enabled.
+func TestReadZipSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name, contents string
+		mode           os.FileMode
+	}{{"src/file.txt", "file contents", 0}, {"src/link.txt", "file.txt", os.ModeSymlink | 0777}, {"src/regular" + fs.LinkSuffix, "ordinary file", 0}} {
+		header := &zip.FileHeader{Name: entry.name}
+		if entry.mode != 0 {
+			header.SetMode(entry.mode)
+		}
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.contents))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	name := "links.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	withoutLinks, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err := withoutLinks.List(ctx, "src")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/regular" + fs.LinkSuffix}, remotes)
+	require.Len(t, entries, 2)
+	_, err = withoutLinks.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = withoutLinks.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, config := fs.AddConfig(ctx)
+	config.Links = true
+	withLinks, err := New(linksCtx, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(linksCtx, "src")
+	require.NoError(t, err)
+	remotes = remotes[:0]
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix, "src/regular" + fs.LinkSuffix}, remotes)
+	require.Len(t, entries, 3)
+	for _, remote := range remotes {
+		object, err := withLinks.NewObject(linksCtx, remote)
+		require.NoError(t, err, remote)
+		assert.Equal(t, remote, object.Remote())
+	}
+
+	link, err := withLinks.NewObject(linksCtx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	read := func(options ...fs.OpenOption) string {
+		rc, err := link.Open(linksCtx, options...)
+		require.NoError(t, err)
+		defer func() { assert.NoError(t, rc.Close()) }()
+		contents, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		return string(contents)
+	}
+	assert.Equal(t, "file.txt", read())
+	assert.Equal(t, "ile.", read(&fs.RangeOption{Start: 1, End: 4}))
+	assert.Equal(t, "le.txt", read(&fs.SeekOption{Offset: 2}))
+
+	// An archive member with the link suffix is still an ordinary file.
+	regular, err := withLinks.NewObject(linksCtx, "src/regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	rc, err := regular.Open(linksCtx)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ordinary file", string(contents))
+
+	// Looking up a translated link as the mounted root must expose the same
+	// suffixed name as a directory listing.
+	single, err := New(linksCtx, localFs, name, "", "src/link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = single.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+
+	// Copying the translated object to a links-enabled local filesystem
+	// recreates the symbolic link.
+	skipIfNoSymlinks(t)
+	dstPath := filepath.Join(dir, "out")
+	dst, err := localbackend.NewFs(linksCtx, "local", dstPath, configmap.Simple{})
+	require.NoError(t, err)
+	_, err = operations.Copy(linksCtx, dst, nil, "src/link.txt"+fs.LinkSuffix, link)
+	require.NoError(t, err)
+	target, err := os.Readlink(filepath.Join(dstPath, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
