+		}
+	}
+
+	// A regular file ending in the translated-link suffix remains regular.
+	o, err := f.NewObject(linksCtx, "src/ordinary"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, "ordinary file", fstestReadObject(t, o))
+}
+
+func fstestReadObject(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	t.Helper()
+	r, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	defer func() { _ = r.Close() }()
+	b, err := io.ReadAll(r)
+	require.NoError(t, err)
+	return string(b)
+}
