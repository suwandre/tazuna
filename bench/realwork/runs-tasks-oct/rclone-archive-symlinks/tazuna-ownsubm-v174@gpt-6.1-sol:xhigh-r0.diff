+func TestCopyZipSymlinksSafely(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	name := writeZipWithLinks(t, dir, "links.zip")
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	src, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	tmp := t.TempDir()
+	dstRoot := filepath.Join(tmp, "destination")
+	outside := filepath.Join(tmp, "outside")
+	require.NoError(t, os.WriteFile(outside, []byte("sentinel"), 0600))
+	dst, err := local.NewFs(ctx, "local", dstRoot, configmap.Simple{})
+	require.NoError(t, err)
+
+	for _, remote := range []string{
+		"src/escape" + fs.LinkSuffix,
+		"src/file.txt",
+		"src/link.txt" + fs.LinkSuffix,
+	} {
+		o, err := src.NewObject(ctx, remote)
+		require.NoError(t, err)
+		_, err = operations.Copy(ctx, dst, nil, remote, o)
+		require.NoError(t, err)
+	}
+	linkTarget, err := os.Readlink(filepath.Join(dstRoot, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", linkTarget)
+	assert.Equal(t, "sentinel", string(mustReadFile(t, outside)))
+	_, err = os.Lstat(filepath.Join(dstRoot, "src", "escape", "pwned"))
+	assert.Error(t, err, "archive member beneath symlink was copied")
+}
+
+func mustReadFile(t *testing.T, name string) []byte {
+	t.Helper()
+	b, err := os.ReadFile(name)
+	require.NoError(t, err)
+	return b
+}
