+func TestSquashfsSymlinks(t *testing.T) {
+	if _, err := exec.LookPath("mksquashfs"); err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+	ctx := context.Background()
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "target.txt"), []byte("target data"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "ordinary"+fs.LinkSuffix), []byte("ordinary data"), 0600))
+	if err := os.Symlink("target.txt", filepath.Join(input, "link.txt")); err != nil {
+		t.Skipf("symbolic links are not supported: %v", err)
+	}
+	output := filepath.Join(t.TempDir(), "links.sqfs")
+	cmd := exec.Command("mksquashfs", input, output, "-noappend")
+	if data, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("mksquashfs failed: %v\n%s", err, data)
+	}
+
+	localFs, err := fscache.Get(ctx, filepath.Dir(output))
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, filepath.Base(output), "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 2)
+	assert.ElementsMatch(t, []string{"target.txt", "ordinary" + fs.LinkSuffix}, []string{entries[0].Remote(), entries[1].Remote()})
+	_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.Equal(t, fs.ErrorObjectNotFound, err)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(linksCtx, localFs, filepath.Base(output), "", "")
+	require.NoError(t, err)
+	entries, err = f.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 3)
+	assert.ElementsMatch(t, []string{"target.txt", "ordinary" + fs.LinkSuffix, "link.txt" + fs.LinkSuffix}, []string{entries[0].Remote(), entries[1].Remote(), entries[2].Remote()})
+
+	o, err := f.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("target.txt")), o.Size())
+	read := func(options ...fs.OpenOption) string {
+		r, err := o.Open(linksCtx, options...)
+		require.NoError(t, err)
+		defer func() { _ = r.Close() }()
+		b, err := io.ReadAll(r)
+		require.NoError(t, err)
+		return string(b)
+	}
+	assert.Equal(t, "target.txt", read())
+	assert.Equal(t, "arget", read(&fs.RangeOption{Start: 1, End: 5}))
+	assert.Equal(t, "get.txt", read(&fs.SeekOption{Offset: 3}))
+
+	single, err := New(linksCtx, localFs, filepath.Base(output), "", "link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = single.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+
+	regular, err := f.NewObject(linksCtx, "ordinary"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("ordinary data")), regular.Size())
+	r, err := regular.Open(linksCtx)
+	require.NoError(t, err)
+	defer func() { _ = r.Close() }()
+	data, err := io.ReadAll(r)
+	require.NoError(t, err)
+	assert.Equal(t, "ordinary data", string(data))
+}
