+func writeZipWithLinks(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	addFile := func(name, content string, mode os.FileMode) {
+		h := &zip.FileHeader{Name: name}
+		h.SetMode(mode)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	addFile("src/file.txt", "contents", 0644)
+	addFile("src/link.txt", "file.txt", os.ModeSymlink|0777)
+	addFile("src/ordinary"+fs.LinkSuffix, "ordinary file", 0644)
+	addFile("src/escape", "../../outside", os.ModeSymlink|0777)
+	addFile("src/escape/pwned", "must not be copied", 0644)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
