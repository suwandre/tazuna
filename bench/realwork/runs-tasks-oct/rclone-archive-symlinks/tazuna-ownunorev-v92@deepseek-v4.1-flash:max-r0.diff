+// skipIfNoSymlinks skips the test if this process can't create symlinks.
+func skipIfNoSymlinks(t *testing.T) {
+	t.Helper()
+	dir := t.TempDir()
+	if err := os.Symlink("target", filepath.Join(dir, "link")); err != nil {
+		t.Skipf("can't create symlinks: %v", err)
+	}
+}
+
+// writeZipFile writes a zip containing a regular file and a symlink.
+func writeZipFile(t *testing.T, path, fileName, fileBody, linkName, linkTarget string) {
+	t.Helper()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	add := func(name, body string, mode os.FileMode) {
+		hdr := &zip.FileHeader{Name: name, Method: zip.Deflate}
+		hdr.SetMode(mode)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(body))
+		require.NoError(t, err)
+	}
+	add(fileName, fileBody, 0644)
+	add(linkName, linkTarget, os.ModeSymlink|0777)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(path, buf.Bytes(), 0600))
+}
+
+// TestArchiveCopySymlinks checks that --links exposes symlinks in a zip
+// archive and that copying one recreates it on the local backend.
+func TestArchiveCopySymlinks(t *testing.T) {
+	skipIfNoSymlinks(t)
+	ctx := context.Background()
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	zipPath := filepath.Join(t.TempDir(), "links.zip")
+	writeZipFile(t, zipPath, "src/file.txt", "hello", "src/link.txt", "file.txt")
+
+	a, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	entries, err := a.List(ctx, "src")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix}, remotes)
+
+	dstDir := t.TempDir()
+	dst, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	fileObj, err := a.NewObject(ctx, "src/file.txt")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, "src/file.txt", fileObj)
+	require.NoError(t, err)
+
+	linkObj, err := a.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, "src/link.txt"+fs.LinkSuffix, linkObj)
+	require.NoError(t, err)
+
+	// The destination is a real symlink pointing at the target.
+	target, err := os.Readlink(filepath.Join(dstDir, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+	body, err := os.ReadFile(filepath.Join(dstDir, "src", "file.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "hello", string(body))
+}
+
+// TestArchiveCopySymlinkEscape checks that a hostile archive containing
+// a symlink pointing outside the destination plus a member "inside" it
+// can't make a copy write outside the destination.
+func TestArchiveCopySymlinkEscape(t *testing.T) {
+	skipIfNoSymlinks(t)
+	ctx := context.Background()
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	evilDir := t.TempDir()
+	zipPath := filepath.Join(t.TempDir(), "evil.zip")
+	writeZipFile(t, zipPath, "pwn/authkeys", "PWNED", "pwn", evilDir)
+
+	a, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dst, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	// Reproduce the symlink faithfully...
+	linkObj, err := a.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, "pwn"+fs.LinkSuffix, linkObj)
+	require.NoError(t, err)
+	target, err := os.Readlink(filepath.Join(dstDir, "pwn"))
+	require.NoError(t, err)
+	assert.Equal(t, evilDir, target)
+
+	// ...but writing the member through it must be refused.
+	fileObj, err := a.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, "pwn/authkeys", fileObj)
+	require.Error(t, err, "writing through a symlink planted by the archive should be refused")
+
+	_, err = os.Stat(filepath.Join(evilDir, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evilDir)
+}
