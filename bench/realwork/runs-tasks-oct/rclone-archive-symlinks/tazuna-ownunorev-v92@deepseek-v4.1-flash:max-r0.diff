+// buildSquashfs makes a squashfs image from src using mksquashfs,
+// skipping the test if it isn't installed or symlinks aren't supported.
+func buildSquashfs(t *testing.T, src, dst string) {
+	t.Helper()
+	if _, err := exec.LookPath("mksquashfs"); err != nil {
+		t.Skip("mksquashfs not installed")
+	}
+	out, err := exec.Command("mksquashfs", src, dst, "-noappend").CombinedOutput()
+	require.NoError(t, err, "mksquashfs failed: %s", out)
+}
