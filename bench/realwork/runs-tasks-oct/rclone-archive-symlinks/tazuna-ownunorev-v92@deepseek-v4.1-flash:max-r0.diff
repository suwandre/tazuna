+// TestZipSymlinkAsRoot checks that a symlink can be mounted as the root
+// by its suffixed name.
+func TestZipSymlinkAsRoot(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "links.zip",
+		zipEntry{name: "sub/link.txt", body: "target", mode: os.ModeSymlink | 0777},
+	)
+
+	localFs, err := cache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	ctx := withLinks(context.Background())
+	f, err := New(ctx, localFs, name, "", "sub/link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+	o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("target")), o.Size())
+}
