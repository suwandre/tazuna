+// readLink returns the target of a symlink directory entry.
+func readLink(item os.DirEntry) (string, error) {
+	link, ok := item.(interface{ Readlink() (string, error) })
+	if !ok {
+		return "", fmt.Errorf("entry %q doesn't support reading symlink targets", item.Name())
+	}
+	return link.Readlink()
