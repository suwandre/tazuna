+// zipEntry describes a single entry for writeZipEntries.
+type zipEntry struct {
+	name string
+	body string
+	mode os.FileMode
+}
+
+// writeZipEntries builds a zip file with the given entries in dir and
+// returns its leaf name. An empty mode creates a regular file.
+func writeZipEntries(t *testing.T, dir, name string, entries ...zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, e := range entries {
+		hdr := &zip.FileHeader{Name: e.name, Method: zip.Deflate}
+		if e.mode != 0 {
+			hdr.SetMode(e.mode)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(e.body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// withLinks returns a context with -l/--links enabled.
+func withLinks(ctx context.Context) context.Context {
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	return ctx
+}
+
+// TestZipSymlinks checks that symlinks in a zip archive are skipped
+// without --links and exposed as .rclonelink files with it.
+func TestZipSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	const target = "file.txt"
+	name := writeZipEntries(t, dir, "links.zip",
+		zipEntry{name: "src/", mode: os.ModeDir | 0755},
+		zipEntry{name: "src/file.txt", body: "hello", mode: 0644},
+		zipEntry{name: "src/link.txt", body: target, mode: os.ModeSymlink | 0777},
+		zipEntry{name: "src/plain.rclonelink", body: "not a link", mode: 0644},
+	)
+
+	localFs, err := cache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	// Without --links the symlink is omitted and can't be looked up.
+	f, err := New(context.Background(), localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"src/file.txt", "src/plain.rclonelink"}, allRemotes(t, f))
+	_, err = f.NewObject(context.Background(), "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = f.NewObject(context.Background(), "src/link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// With --links it is listed and looked up under its suffixed name.
+	ctx := withLinks(context.Background())
+	f, err = New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix, "src/plain.rclonelink"}, allRemotes(t, f))
+
+	// The bare symlink name still doesn't exist.
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	o, err := f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len(target)), o.Size())
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	got, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, target, string(got))
+
+	// Seek and range options read from the target string.
+	rc, err = o.Open(ctx, &fs.SeekOption{Offset: 2})
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, target[2:], string(got))
+
+	rc, err = o.Open(ctx, &fs.RangeOption{Start: 1, End: 4})
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, target[1:5], string(got))
+
+	// A seek past the end reads nothing rather than failing.
+	rc, err = o.Open(ctx, &fs.SeekOption{Offset: 100})
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Empty(t, got)
+
+	// A regular member which happens to end in .rclonelink stays a
+	// regular file.
+	plain, err := f.NewObject(ctx, "src/plain.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("not a link")), plain.Size())
+	rc, err = plain.Open(ctx)
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "not a link", string(got))
+}
