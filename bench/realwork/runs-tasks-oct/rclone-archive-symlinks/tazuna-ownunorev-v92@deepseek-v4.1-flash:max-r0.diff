+// TestSymlinks checks that symlinks in a squashfs image are skipped
+// without --links and exposed as .rclonelink files with it.
+func TestSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	src := filepath.Join(dir, "src")
+	require.NoError(t, os.MkdirAll(src, 0755))
+	require.NoError(t, os.WriteFile(filepath.Join(src, "file.txt"), []byte("hello"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(src, "plain.rclonelink"), []byte("not a link"), 0644))
+	if err := os.Symlink("file.txt", filepath.Join(src, "link.txt")); err != nil {
+		t.Skipf("can't create symlink: %v", err)
+	}
+	buildSquashfs(t, src, filepath.Join(dir, "test.sqfs"))
+
+	localFs, err := fscache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	// A regular file still works as the root of a single-object Fs.
+	fileFs, err := New(context.Background(), localFs, "test.sqfs", "", "file.txt")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	fileEntries, err := fileFs.List(context.Background(), "")
+	require.NoError(t, err)
+	require.Len(t, fileEntries, 1)
+	assert.Equal(t, "file.txt", fileEntries[0].Remote())
+	_, err = fileFs.NewObject(context.Background(), "file.txt")
+	require.NoError(t, err)
+
+	// Without --links the symlink is omitted and can't be looked up.
+	f, err := New(context.Background(), localFs, "test.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := f.List(context.Background(), "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "plain.rclonelink"}, remotes)
+	_, err = f.NewObject(context.Background(), "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = f.NewObject(context.Background(), "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// With --links it is listed and looked up under its suffixed name.
+	ctx := withLinks(context.Background())
+	f, err = New(ctx, localFs, "test.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = f.List(ctx, "")
+	require.NoError(t, err)
+	remotes = nil
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "link.txt" + fs.LinkSuffix, "plain.rclonelink"}, remotes)
+
+	// The bare symlink name still doesn't exist.
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	const target = "file.txt"
+	o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len(target)), o.Size())
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	got, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, target, string(got))
+
+	// Seek and range options read from the target string.
+	rc, err = o.Open(ctx, &fs.SeekOption{Offset: 2})
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, target[2:], string(got))
+
+	rc, err = o.Open(ctx, &fs.RangeOption{Start: 1, End: 4})
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, target[1:5], string(got))
+
+	// A seek past the end reads nothing rather than failing.
+	rc, err = o.Open(ctx, &fs.SeekOption{Offset: 100})
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Empty(t, got)
+
+	// A regular member which happens to end in .rclonelink stays a
+	// regular file.
+	plain, err := f.NewObject(ctx, "plain.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("not a link")), plain.Size())
+	rc, err = plain.Open(ctx)
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "not a link", string(got))
+}
