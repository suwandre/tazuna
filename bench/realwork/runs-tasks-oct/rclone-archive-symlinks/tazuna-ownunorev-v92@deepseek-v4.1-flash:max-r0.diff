+// linkObjectFromDirEntry converts a symlink directory entry into an Object
+// exposed under its name plus fs.LinkSuffix.
+func (f *Fs) linkObjectFromDirEntry(nativeDir string, item os.DirEntry) (*Object, error) {
+	target, err := readLink(item)
+	if err != nil {
+		return nil, err
+	}
+	info, err := item.Info()
+	if err != nil {
+		return nil, fmt.Errorf("error reading item %q: %w", item.Name(), err)
+	}
+	o := f.objectFromFileInfo(nativeDir, info)
+	o.remote += fs.LinkSuffix
+	o.size = int64(len(target))
+	o.linkTarget = target
+	o.isLink = true
+	return o, nil
+}
