+			require.NoError(t, rc.Close())
+			return string(b)
+		}
+		assert.Equal(t, "file.txt", read())
+		assert.Equal(t, "txt", read(&fs.SeekOption{Offset: 5}))
+		assert.Equal(t, "ile", read(&fs.RangeOption{Start: 1, End: 3}))
+
+		// The bare symlink name isn't listed so must not be found.
+		_, err = f.NewObject(linksCtx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// A regular member which happens to end in .rclonelink stays a
+		// regular file.
+		o, err = f.NewObject(linksCtx, "regular.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("plain")), o.Size())
+		rc, err := o.Open(linksCtx)
+		require.NoError(t, err)
+		b, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "plain", string(b))
+	})
+}
+
+// A symlink in a zip must be recreated as a symlink when copied with
+// -l/--links.
+func TestZipSymlinkCopy(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "links.zip",
+		zipEntry{name: "src/file.txt", data: "hello"},
+		zipEntry{name: "src/link.txt", data: "file.txt", mode: os.ModeSymlink | 0777},
+	)
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	src, err := f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "src/link.txt"+fs.LinkSuffix, src)
+	require.NoError(t, err)
+
+	target, err := os.Readlink(filepath.Join(dstDir, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+// A hostile archive with a symlink pointing outside the destination plus
+// a member inside it must not be able to write outside the destination.
+func TestZipSymlinkEscapeWriteThroughBlocked(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	evil := t.TempDir()
+	evilFile := filepath.Join(evil, "authkeys")
+
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "evil.zip",
+		zipEntry{name: "pwn", data: evil, mode: os.ModeSymlink | 0777},
+		zipEntry{name: "pwn/authkeys", data: "PWNED"},
+	)
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	// The symlink is reproduced faithfully, pointing outside.
+	link, err := f.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn"+fs.LinkSuffix, link)
+	require.NoError(t, err)
+	target, err := os.Readlink(filepath.Join(dstDir, "pwn"))
+	require.NoError(t, err)
+	assert.Equal(t, evil, target)
+
+	// Writing the member through it must be refused.
+	file, err := f.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn/authkeys", file)
+	require.Error(t, err, "writing through a planted symlink should be refused")
+
+	_, err = os.Stat(evilFile)
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evilFile)
+}
