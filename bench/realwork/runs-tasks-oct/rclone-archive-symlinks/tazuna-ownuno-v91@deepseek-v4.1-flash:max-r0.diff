+// skipIfNoExe skips the test if the executable isn't installed.
+func skipIfNoExe(t *testing.T, name string) {
+	if _, err := exec.LookPath(name); err != nil {
+		t.Skipf("%s executable not installed", name)
+	}
+}
+
+// Symlinks in a squashfs are hidden unless -l/--links is in use. With it
+// they are exposed as name + .rclonelink, read back as the target and
+// their size is the length of the target.
+func TestSymlink(t *testing.T) {
+	skipIfNoExe(t, "mksquashfs")
+
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("hello"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "plain"+fs.LinkSuffix), []byte("plain"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "link.txt")))
+
+	imageDir := t.TempDir()
+	image := filepath.Join(imageDir, "test.sqfs")
+	out, err := exec.Command("mksquashfs", input, image, "-noappend", "-quiet").CombinedOutput()
+	require.NoError(t, err, string(out))
+
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, imageDir)
+	require.NoError(t, err)
+	name := filepath.Base(image)
+
+	t.Run("WithoutLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.ElementsMatch(t, []string{"file.txt", "plain" + fs.LinkSuffix}, remotes)
+
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	t.Run("WithLinks", func(t *testing.T) {
+		f, err := New(linksCtx, localFs, name, "", "")
+		require.NoError(t, err)
+		entries, err := f.List(linksCtx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.ElementsMatch(t, []string{"file.txt", "link.txt" + fs.LinkSuffix, "plain" + fs.LinkSuffix}, remotes)
+
+		// Every listed name must also be found by NewObject.
+		for _, remote := range remotes {
+			o, err := f.NewObject(linksCtx, remote)
+			require.NoError(t, err, remote)
+			assert.Equal(t, remote, o.Remote())
+		}
+
+		o, err := f.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+
+		read := func(options ...fs.OpenOption) string {
+			rc, err := o.Open(linksCtx, options...)
+			require.NoError(t, err)
+			b, err := io.ReadAll(rc)
+			require.NoError(t, err)
+			require.NoError(t, rc.Close())
+			return string(b)
+		}
+		assert.Equal(t, "file.txt", read())
+		assert.Equal(t, "txt", read(&fs.SeekOption{Offset: 5}))
+		assert.Equal(t, "ile", read(&fs.RangeOption{Start: 1, End: 3}))
+
+		// The bare symlink name isn't listed so must not be found.
+		_, err = f.NewObject(linksCtx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// A regular member which happens to end in .rclonelink stays a
+		// regular file.
+		o, err = f.NewObject(linksCtx, "plain"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("plain")), o.Size())
+		rc, err := o.Open(linksCtx)
+		require.NoError(t, err)
+		b, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "plain", string(b))
+	})
+}
