 // Listings are served from a cache which must survive callers
 // filtering the returned slice in place, as fs/list does.
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZip(t, dir, "links.zip", "src/file.txt", "symlink:src/link.txt=file.txt", "src/plain.rclonelink")
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	linksOpt := vfscommon.Opt
+	linksOpt.Links = false
+	ctxOff, _ := fs.AddConfig(ctx)
+	vfsObj := vfs.New(ctxOff, localFs, &linksOpt)
+	defer vfsObj.Shutdown()
+	f, err := New(ctxOff, localFs, name, "", "")
+	require.NoError(t, err)
+	_, err = f.NewObject(ctxOff, "src/link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksOpt.Links = true
+	vfsObj.Shutdown()
+	ctxOn, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	vfsObj = vfs.New(ctxOn, localFs, &linksOpt)
+	defer vfsObj.Shutdown()
+	f, err = New(ctxOn, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctxOn, "src")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.Equal(t, []string{"src/file.txt", "src/link.txt.rclonelink", "src/plain.rclonelink"}, remotes)
+
+	o, err := f.NewObject(ctxOn, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(8), o.Size())
+	for _, test := range []struct {
+		options []fs.OpenOption
+		want    string
+	}{
+		{nil, "file.txt"},
+		{[]fs.OpenOption{&fs.RangeOption{Start: 2, End: 4}}, "le."},
+		{[]fs.OpenOption{&fs.SeekOption{Offset: 3}}, "e.txt"},
+	} {
+		rc, err := o.Open(ctxOn, test.options...)
+		require.NoError(t, err)
+		data, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, test.want, string(data))
+	}
+}
