+// allRemotes returns every Object remote reachable by listing the whole
+// archive.
+func allRemotes(ctx context.Context, t *testing.T, f fs.Fs) []string {
+	sf, ok := f.(*Fs)
+	require.True(t, ok)
+	var remotes []string
+	var walk func(dir string)
+	walk = func(dir string) {
+		entries, err := sf.List(ctx, dir)
+		require.NoError(t, err)
+		for _, entry := range entries {
+			if o, ok := entry.(fs.Object); ok {
+				remotes = append(remotes, o.Remote())
+			}
+			if d, ok := entry.(fs.Directory); ok {
+				walk(d.Remote())
+			}
+		}
+	}
+	walk("")
+	return remotes
