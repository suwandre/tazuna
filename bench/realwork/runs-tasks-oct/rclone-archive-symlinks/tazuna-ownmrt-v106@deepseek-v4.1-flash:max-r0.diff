+// writeZipSymlink writes a zip file in dir containing the entries passed
+// in, where a name mapping to a non-empty target is a symlink, and
+// returns its leaf name.
+func writeZipSymlink(t *testing.T, dir, name string, entries map[string]string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for entryName, target := range entries {
+		h := &zip.FileHeader{Name: entryName}
+		if target != "" {
+			h.SetMode(os.ModeSymlink | 0777)
+		} else {
+			h.SetMode(0644)
+		}
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(target))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
