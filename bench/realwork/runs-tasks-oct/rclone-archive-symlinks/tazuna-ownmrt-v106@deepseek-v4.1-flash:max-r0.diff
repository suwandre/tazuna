+// Symlinks in a squashfs image are only exposed with -l/--links, under
+// their name plus the link suffix, and their contents are the link
+// target. symlink.sqfs holds:
+//
+//	src/file.txt        a regular file
+//	src/link.txt        a symlink to "file.txt"
+//	src/abs.txt         a symlink to "/etc/passwd"
+//	src/name.rclonelink a regular file whose name ends in the suffix
+//	sub/up.txt          a symlink to "../file.txt"
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	// Without --links the symlinks are skipped but the regular file
+	// whose name ends in the suffix stays
+	f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/name.rclonelink"}, allRemotes(ctx, t, f))
+
+	// With --links the symlinks are listed under their suffixed names
+	linksCtx := linkCtx(ctx, true)
+	f, err = New(linksCtx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+	assert.ElementsMatch(t, []string{
+		"src/file.txt",
+		"src/link.txt.rclonelink",
+		"src/abs.txt.rclonelink",
+		"src/name.rclonelink",
+		"sub/up.txt.rclonelink",
+	}, allRemotes(linksCtx, t, f))
+
+	// Listing and NewObject agree, and opening reads back the target
+	o, err := f.NewObject(linksCtx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	assert.Equal(t, "file.txt", readObject(linksCtx, t, o))
+	assert.Equal(t, ".txt", readObject(linksCtx, t, o, &fs.RangeOption{Start: 4, End: -1}))
+	assert.Equal(t, "ile", readObject(linksCtx, t, o, &fs.RangeOption{Start: 1, End: 3}))
+
+	// An absolute target is returned verbatim
+	o, err = f.NewObject(linksCtx, "src/abs.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "/etc/passwd", readObject(linksCtx, t, o))
+
+	// A regular file keeps its own name and is not the link
+	o, err = f.NewObject(linksCtx, "src/name.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "regular\n", readObject(linksCtx, t, o))
+
+	// A plain link name is not looked up when --links is in use
+	_, err = f.NewObject(linksCtx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// Without --links neither the link name nor the plain name is found
+	fNoLinks, err := New(ctx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+	_, err = fNoLinks.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = fNoLinks.NewObject(ctx, "src/link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+}
