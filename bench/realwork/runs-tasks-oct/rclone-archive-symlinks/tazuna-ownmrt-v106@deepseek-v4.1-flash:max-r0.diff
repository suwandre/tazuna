+	require.NoError(t, err)
+
+	// Without --links the symlink is skipped but the regular file
+	// whose name ends in the suffix stays
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"src/file.txt", "src/name.rclonelink"}, allRemotes(t, f))
+
+	// With --links the symlink is listed under its suffixed name
+	linkCtx := withLinks(ctx, true)
+	f, err = New(linkCtx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"src/file.txt", "src/link.txt.rclonelink", "src/name.rclonelink"}, allRemotes(t, f))
+
+	// Listing and NewObject agree, and opening reads back the target
+	o, err := f.NewObject(linkCtx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	assert.Equal(t, "file.txt", readObject(linkCtx, t, o))
+	assert.Equal(t, ".txt", readObject(linkCtx, t, o, &fs.RangeOption{Start: 4, End: -1}))
+	assert.Equal(t, "ile", readObject(linkCtx, t, o, &fs.RangeOption{Start: 1, End: 3}))
+	assert.Equal(t, "file.txt", readObject(linkCtx, t, o, &fs.SeekOption{Offset: 0}))
+
+	// A regular file keeps its own name and is not the link
+	_, err = f.NewObject(linkCtx, "src/name.rclonelink")
+	require.NoError(t, err)
+
+	// A plain link name is not looked up when --links is in use
+	_, err = f.NewObject(linkCtx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+}
+
+// readObject reads the whole object, or the part selected by the open
+// option, as a string.
+func readObject(ctx context.Context, t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	got, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(got)
+}
