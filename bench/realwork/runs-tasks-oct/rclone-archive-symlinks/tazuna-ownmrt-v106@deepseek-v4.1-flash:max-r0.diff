+// TestArchiveSymlinkEscape checks that a hostile zip archive with a
+// symlink escaping the destination plus a member "inside" it can't make
+// a copy write outside the destination. The symlink is reproduced
+// faithfully (it is a backup of untrusted data) but the write through it
+// must be refused (CWE-59).
+func TestArchiveSymlinkEscape(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks not supported on this OS")
+	}
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	// A directory outside the destination the archive wants to write into
+	outside := t.TempDir()
+	escaped := filepath.Join(outside, "pwn")
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	// "ebr" is a symlink pointing outside the destination
+	h := &zip.FileHeader{Name: "ebr"}
+	h.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(h)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(outside))
+	require.NoError(t, err)
+	// "ebr/pwn" is a regular member reached through the symlink
+	w, err = zw.Create("ebr/pwn")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(t.TempDir(), "hostile.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dst, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	// The symlink is reproduced faithfully, pointing outside the destination
+	require.NoError(t, operations.CopyFile(ctx, dst, src, "ebr.rclonelink", "ebr.rclonelink"))
+	link := filepath.Join(dstDir, "ebr")
+	fi, err := os.Lstat(link)
+	require.NoError(t, err)
+	require.True(t, fi.Mode()&os.ModeSymlink != 0, "symlink should be reproduced faithfully")
+	target, err := os.Readlink(link)
+	require.NoError(t, err)
+	require.Equal(t, outside, target)
+
+	// But writing the member through it must be refused
+	err = operations.CopyFile(ctx, dst, src, "ebr/pwn", "ebr/pwn")
+	require.Error(t, err, "writing through a planted symlink should be refused")
+
+	// Nothing escaped the destination
+	_, err = os.Stat(escaped)
+	require.True(t, os.IsNotExist(err), "a file escaped the destination into %q", escaped)
+}
