+// writeZipWithSymlinks builds a zip file at zipPath containing a
+// directory src with a regular file, a symbolic link to it, and a
+// regular file whose name ends in the link suffix.
+func writeZipWithSymlinks(t *testing.T, zipPath string) {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	write := func(name, content string, mode os.FileMode) {
+		hdr := &zip.FileHeader{Name: name, Method: zip.Deflate}
+		if mode != 0 {
+			hdr.SetMode(mode)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	write("src/file.txt", "hello", 0)
+	write("src/link.txt", "file.txt", os.ModeSymlink|0777)
+	write("src/real.txt"+fs.LinkSuffix, "not a link", 0)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+}
+
+// TestArchiveSymlinksCopy checks that -l/--links recreates the symbolic
+// links in an archive on a destination which supports them.
+func TestArchiveSymlinksCopy(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	zipPath := filepath.Join(t.TempDir(), "links.zip")
+	writeZipWithSymlinks(t, zipPath)
+
+	srcFs, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, dstFs, srcFs, false))
+
+	target, err := os.Readlink(filepath.Join(dstDir, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+
+	content, err := os.ReadFile(filepath.Join(dstDir, "src", "file.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "hello", string(content))
+
+	// The local destination interprets the suffixed member as a link
+	target, err = os.Readlink(filepath.Join(dstDir, "src", "real.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "not a link", target)
+}
+
+// TestArchiveSquashfsSymlinksCopy checks that -l/--links recreates the
+// symbolic links in a squashfs image on a destination which supports
+// them, and that a regular member ending in the link suffix stays a
+// regular file.
+func TestArchiveSquashfsSymlinksCopy(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	testdata, err := filepath.Abs(filepath.Join("squashfs", "testdata"))
+	require.NoError(t, err)
+	srcFs, err := cache.Get(ctx, ":archive:"+filepath.Join(testdata, "symlinks.sqfs"))
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, dstFs, srcFs, false))
+
+	for _, test := range []struct{ name, want string }{
+		{"link.txt", "file.txt"},
+		{"sub/rel.txt", "../file.txt"},
+	} {
+		target, err := os.Readlink(filepath.Join(dstDir, test.name))
+		require.NoError(t, err, test.name)
+		assert.Equal(t, test.want, target, test.name)
+	}
+
+	content, err := os.ReadFile(filepath.Join(dstDir, "file.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "hello", string(content))
+
+	// The local destination interprets the suffixed member as a link
+	target, err := os.Readlink(filepath.Join(dstDir, "name"))
+	require.NoError(t, err)
+	assert.Equal(t, "n", target)
+}
