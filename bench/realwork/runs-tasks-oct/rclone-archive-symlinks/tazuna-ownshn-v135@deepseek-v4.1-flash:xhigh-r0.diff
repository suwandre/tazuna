+// Without -l/--links symbolic links are skipped, and neither their own
+// name nor their suffixed name may be found.
+func TestSymlinksSkippedByDefault(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	name := symlinkZip(t, dir)
+
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	assert.Equal(t, []string{"src/file.txt", "src/real.txt.rclonelink"}, allRemotes(t, f))
+
+	for _, remote := range []string{"src/link.txt", "src/link.txt" + fs.LinkSuffix} {
+		_, err = f.NewObject(ctx, remote)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+	}
+
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.Equal(t, []string{"src/file.txt", "src/real.txt.rclonelink"}, remotes)
+}
+
+// With -l/--links a symbolic link is exposed as an object named after
+// the link plus the link suffix whose contents are the link target.
+func TestSymlinksWithLinks(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	name := symlinkZip(t, dir)
+
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	assert.Equal(t, []string{
+		"src/file.txt",
+		"src/link.txt" + fs.LinkSuffix,
+		"src/real.txt.rclonelink",
+	}, allRemotes(t, f))
+
+	// The symlink is found by its suffixed name only
+	o, err := f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	assert.Equal(t, "file.txt", readAll(ctx, t, o))
+	assert.Equal(t, "ile", readAll(ctx, t, o, &fs.RangeOption{Start: 1, End: 3}))
+	assert.Equal(t, "le.txt", readAll(ctx, t, o, &fs.SeekOption{Offset: 2}))
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// A regular member whose name ends in the link suffix stays regular
+	o, err = f.NewObject(ctx, "src/real.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("not a link")), o.Size())
+	assert.Equal(t, "not a link", readAll(ctx, t, o))
+}
+
+// A root which points at a symbolic link finds it under its suffixed
+// name, both when listing and when looking it up.
+func TestSymlinkRoot(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	name := symlinkZip(t, dir)
+
+	for _, root := range []string{"src/link.txt", "src/link.txt" + fs.LinkSuffix} {
+		t.Run(root, func(t *testing.T) {
+			f, err := New(ctx, localFs, name, "", root)
+			require.Equal(t, fs.ErrorIsFile, err)
+
+			entries, err := f.List(ctx, "")
+			require.NoError(t, err)
+			require.Len(t, entries, 1)
+			assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+
+			o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+			require.NoError(t, err)
+			assert.Equal(t, "file.txt", readAll(ctx, t, o))
+		})
+	}
+}
+
+// readAll reads the whole of o with the options passed in.
+func readAll(ctx context.Context, t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	buf, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(buf)
+}
