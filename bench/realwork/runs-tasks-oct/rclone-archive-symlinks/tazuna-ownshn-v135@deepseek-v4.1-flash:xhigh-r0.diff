+// zipEntry describes an entry to write into a test zip file.
+type zipEntry struct {
+	name    string
+	content string
+	mode    os.FileMode // zero means a regular file
+}
+
+// writeZipEntries builds a zip file with the given entries in dir and
+// returns its leaf name.
+func writeZipEntries(t *testing.T, dir, name string, entries ...zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		hdr := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+		switch {
+		case strings.HasSuffix(entry.name, "/"):
+			hdr.SetMode(os.ModeDir | 0755)
+		case entry.mode != 0:
+			hdr.SetMode(entry.mode)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		if !strings.HasSuffix(entry.name, "/") {
+			_, err = w.Write([]byte(entry.content))
+			require.NoError(t, err)
+		}
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// symlinkZip builds a zip file in dir with a regular file, a symbolic
+// link and a regular file whose name ends in the link suffix, returning
+// its leaf name.
+func symlinkZip(t *testing.T, dir string) string {
+	return writeZipEntries(t, dir, "links.zip",
+		zipEntry{name: "src/"},
+		zipEntry{name: "src/file.txt", content: "hello"},
+		zipEntry{name: "src/link.txt", content: "file.txt", mode: os.ModeSymlink | 0777},
+		zipEntry{name: "src/real.txt.rclonelink", content: "not a link"},
+	)
+}
