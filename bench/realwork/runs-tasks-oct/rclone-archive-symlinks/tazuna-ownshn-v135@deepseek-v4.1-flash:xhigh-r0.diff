+// linkReader is implemented by squashfs directory entries which are
+// symbolic links.
+type linkReader interface {
+	Readlink() (string, error)
+}
+
+// readLinkTarget returns the target of the symbolic link directory entry fi.
+//
+// It refuses a target longer than maxLinkTargetSize.
+func readLinkTarget(fi iofs.DirEntry) (string, error) {
+	lr, ok := fi.(linkReader)
+	if !ok {
+		return "", fmt.Errorf("%q is not a symbolic link", fi.Name())
+	}
+	target, err := lr.Readlink()
+	if err != nil {
+		return "", err
+	}
+	if len(target) > maxLinkTargetSize {
+		return "", fmt.Errorf("symbolic link %q target is too long", fi.Name())
+	}
+	return target, nil
+}
+
+// Convert the symbolic link directory entry fi in nativeDir into an
+// Object which reads back the link target.
+func (f *Fs) objectFromSymlink(nativeDir string, fi iofs.DirEntry) (*Object, error) {
+	target, err := readLinkTarget(fi)
+	if err != nil {
+		return nil, err
+	}
+	info, err := fi.Info()
+	if err != nil {
+		return nil, fmt.Errorf("error reading item %q: %w", fi.Name(), err)
+	}
+	return &Object{
+		fs:         f,
+		remote:     f.fromNative(nativeDir, fi.Name()) + fs.LinkSuffix,
+		size:       int64(len(target)),
+		modTime:    info.ModTime(),
+		link:       true,
+		linkTarget: target,
+	}, nil
+}
