+// TestArchiveSymlinkEscape checks that a hostile archive containing a
+// symbolic link pointing outside the destination, plus a member inside
+// it, can't make a copy write outside the destination.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	evil := t.TempDir()
+
+	zipPath := filepath.Join(t.TempDir(), "evil.zip")
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name, content string
+		mode          os.FileMode
+	}{
+		{"pwn", evil, os.ModeSymlink | 0777},
+		{"pwn/authkeys", "PWNED", 0},
+	} {
+		hdr := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+		if entry.mode != 0 {
+			hdr.SetMode(entry.mode)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	srcFs, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	// Copy the link first so it is in place before the member inside it
+	o, err := srcFs.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn"+fs.LinkSuffix, o)
+	require.NoError(t, err)
+
+	// The link itself is reproduced faithfully
+	target, err := os.Readlink(filepath.Join(dstDir, "pwn"))
+	require.NoError(t, err)
+	assert.Equal(t, evil, target)
+
+	// The member inside it must not be written through the link
+	o, err = srcFs.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn/authkeys", o)
+	assert.Error(t, err)
+
+	entries, err := os.ReadDir(evil)
+	require.NoError(t, err)
+	assert.Empty(t, entries, "files escaped the destination into %q", evil)
+}
