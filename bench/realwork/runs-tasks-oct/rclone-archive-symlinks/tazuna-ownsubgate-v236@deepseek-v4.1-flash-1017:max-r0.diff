+// writeZipSymlink builds a zip in dir holding the regular files in files
+// and the symlinks in links (name -> target), returning its path.
+func writeZipSymlink(t *testing.T, dir string, files map[string]string, links map[string]string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for name, content := range files {
+		w, err := zw.Create(name)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	for name, target := range links {
+		hdr := &zip.FileHeader{Name: name, Method: zip.Store}
+		hdr.SetMode(os.ModeSymlink | 0777)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(target))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(dir, "test.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+	return zipPath
+}
+
+// TestArchiveSymlinkCopy checks that a symlink in an archive is copied to
+// a destination as a symlink with -l/--links.
+func TestArchiveSymlinkCopy(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks not supported on Windows")
+	}
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	zipPath := writeZipSymlink(t, t.TempDir(),
+		map[string]string{"src/file.txt": "hello"},
+		map[string]string{"src/link.txt": "file.txt"},
+	)
+	fsrc, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	fdst, err := cache.Get(ctx, t.TempDir())
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, fdst, fsrc, true))
+
+	linkPath := filepath.Join(fdst.Root(), "src", "link.txt")
+	fi, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	require.NotZero(t, fi.Mode()&os.ModeSymlink, "expected a symlink at %q", linkPath)
+	target, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+
+	content, err := os.ReadFile(filepath.Join(fdst.Root(), "src", "file.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "hello", string(content))
+}
+
+// TestArchiveSymlinkEscape checks that a hostile archive with a symlink
+// pointing outside the destination plus a member "inside" it can't make
+// a copy write outside the destination.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks not supported on Windows")
+	}
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	evil := t.TempDir()
+	zipPath := writeZipSymlink(t, t.TempDir(),
+		map[string]string{"pwn/authkeys": "PWNED"},
+		map[string]string{"pwn": evil},
+	)
+	fsrc, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dst := t.TempDir()
+	fdst, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+
+	// The symlink is reproduced faithfully, pointing outside the destination.
+	require.NoError(t, operations.CopyFile(ctx, fdst, fsrc, "pwn.rclonelink", "pwn.rclonelink"))
+	linkPath := filepath.Join(dst, "pwn")
+	fi, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	require.NotZero(t, fi.Mode()&os.ModeSymlink, "expected a symlink at %q", linkPath)
+
+	// But writing the member through it must be refused.
+	err = operations.CopyFile(ctx, fdst, fsrc, "pwn/authkeys", "pwn/authkeys")
+	require.Error(t, err, "writing through a planted symlink should be refused")
+
+	// Nothing escaped the destination.
+	_, err = os.Stat(filepath.Join(evil, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "copy escaped the destination to %q", evil)
+}
