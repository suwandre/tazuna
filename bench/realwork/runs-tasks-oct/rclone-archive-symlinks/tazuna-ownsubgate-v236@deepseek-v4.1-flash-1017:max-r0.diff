+// newObjectNativeLink finds the object at the native path passed in.
+//
+// When translating links, a symlink is named by its own name plus the
+// link suffix, so a path with the suffix falls back to the symlink
+// without it. A regular file named with the suffix always wins over a
+// symlink of the same name.
+func (f *Fs) newObjectNativeLink(nativePath string) (*Object, error) {
+	o, err := f.newObjectNative(nativePath)
