+// testdata/symlink.sqfs holds file.txt ("hello") and the symlink
+// link.txt -> file.txt. It was built with:
+//
+//	mksquashfs src symlink.sqfs -noappend -comp gzip -no-xattrs -all-root
+//
+// A symlink in a squashfs image is skipped unless --links is in use, in
+// which case it is exposed as name.rclonelink with the target as its
+// content.
+func TestSymlink(t *testing.T) {
+	ctx := context.Background()
+
+	t.Run("WithoutLinks", func(t *testing.T) {
+		f := openSquashfs(t, ctx, "symlink.sqfs", "", "")
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.Equal(t, []string{"file.txt"}, remotes)
+		_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("WithLinks", func(t *testing.T) {
+		ctx := linksContext(ctx)
+		f := openSquashfs(t, ctx, "symlink.sqfs", "", "")
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.Equal(t, []string{"file.txt", "link.txt" + fs.LinkSuffix}, remotes)
+
+		o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// Opening it reads the target, honouring seek and range
+		checkOpen := func(want string, options ...fs.OpenOption) {
+			rc, err := o.Open(ctx, options...)
+			require.NoError(t, err)
+			got, err := io.ReadAll(rc)
+			require.NoError(t, err)
+			require.NoError(t, rc.Close())
+			assert.Equal(t, want, string(got))
+		}
+		checkOpen("file.txt")
+		checkOpen("file.txt"[2:], &fs.SeekOption{Offset: 2})
+		checkOpen("file.txt"[2:5], &fs.RangeOption{Start: 2, End: 4})
+		checkOpen("txt", &fs.RangeOption{Start: -1, End: 3})
+	})
+}
