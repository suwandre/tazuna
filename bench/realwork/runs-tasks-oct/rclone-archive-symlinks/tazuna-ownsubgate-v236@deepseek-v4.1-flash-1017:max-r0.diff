+// linkTarget returns the target of the symlink entry, if it is one.
+func linkTarget(item iofs.DirEntry) (target string, err error) {
+	linker, ok := item.(interface{ Readlink() (string, error) })
+	if !ok {
+		return "", fmt.Errorf("can't read symlink %q", item.Name())
+	}
+	return linker.Readlink()
