+	}
+	target, err := linkTarget(item)
+	if err != nil {
+		return nil, fmt.Errorf("error reading symlink %q: %w", item.Name(), err)
+	}
+	o.remote += fs.LinkSuffix
+	o.size = int64(len(target))
+	o.isLink = true
+	o.link = target
+	return o, nil
+}
