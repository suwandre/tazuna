+		linksCtx := linksContext(ctx)
+		f := openZip(t, linksCtx, dir, name, "", "")
+		assert.Equal(t, []string{"src/link.txt" + fs.LinkSuffix}, allRemotes(t, f))
+
+		o, err := f.NewObject(linksCtx, "src/link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+
+		// The plain name must not be found
+		_, err = f.NewObject(linksCtx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
