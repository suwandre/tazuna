+// content is the link target. Otherwise a symlink is reported as not
+// found, so listing and lookup agree on which names exist.
+func (f *Fs) objectFromEntry(nativeDir string, item iofs.DirEntry, link bool) (*Object, error) {
+	info, err := item.Info()
+	if err != nil {
+		return nil, fmt.Errorf("error reading item %q: %w", item.Name(), err)
+	}
+	o := f.objectFromFileInfo(nativeDir, info)
+	if item.Type()&os.ModeSymlink == 0 {
+		return o, nil
