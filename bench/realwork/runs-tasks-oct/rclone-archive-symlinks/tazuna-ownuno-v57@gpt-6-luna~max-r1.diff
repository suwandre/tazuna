+func TestSquashfsSymlinks(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("creating symlinks may require privileges on Windows")
+	}
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "target.txt"), []byte("contents"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "ordinary.rclonelink"), []byte("ordinary"), 0600))
+	require.NoError(t, os.Symlink("target.txt", filepath.Join(input, "link.txt")))
+
+	archivePath := filepath.Join(t.TempDir(), "links.sqfs")
+	cmd := exec.Command(mksquashfs, input, archivePath, "-noappend", "-all-root", "-no-xattrs", "-processors", "1")
+	output, err := cmd.CombinedOutput()
+	require.NoError(t, err, string(output))
+
+	baseCtx := context.Background()
+	localFs, err := fscache.Get(baseCtx, filepath.Dir(archivePath))
+	require.NoError(t, err)
+
+	noLinksCtx, noLinksConfig := fs.AddConfig(baseCtx)
+	noLinksConfig.Links = false
+	noLinksFs, err := New(noLinksCtx, localFs, filepath.Base(archivePath), "", "")
+	require.NoError(t, err)
+	entries, err := noLinksFs.List(noLinksCtx, "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"ordinary.rclonelink", "target.txt"}, entryRemotes(entries))
+	_, err = noLinksFs.NewObject(noLinksCtx, "link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = noLinksFs.NewObject(noLinksCtx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, linksConfig := fs.AddConfig(baseCtx)
+	linksConfig.Links = true
+	linksFs, err := New(linksCtx, localFs, filepath.Base(archivePath), "", "")
+	require.NoError(t, err)
+	entries, err = linksFs.List(linksCtx, "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"link.txt.rclonelink", "ordinary.rclonelink", "target.txt"}, entryRemotes(entries))
+	_, err = linksFs.NewObject(linksCtx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	link, err := linksFs.NewObject(linksCtx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("target.txt")), link.Size())
+	assert.Equal(t, "target.txt", readObject(t, linksCtx, link))
+	assert.Equal(t, "get.txt", readObject(t, linksCtx, link, &fs.SeekOption{Offset: 3}))
+	assert.Equal(t, "arg", readObject(t, linksCtx, link, &fs.RangeOption{Start: 1, End: 3}))
+
+	regular, err := linksFs.NewObject(linksCtx, "ordinary.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("ordinary")), regular.Size())
+	assert.Equal(t, "ordinary", readObject(t, linksCtx, regular))
+
+	singleFileFs, err := New(linksCtx, localFs, filepath.Base(archivePath), "", "link.txt.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = singleFileFs.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt.rclonelink", entries[0].Remote())
+	singleLink, err := singleFileFs.NewObject(linksCtx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "target.txt", readObject(t, linksCtx, singleLink))
+}
+
+func entryRemotes(entries fs.DirEntries) []string {
+	remotes := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	return remotes
+}
+
+func readObject(t *testing.T, ctx context.Context, obj fs.Object, options ...fs.OpenOption) string {
+	rc, err := obj.Open(ctx, options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
