+func TestZipSymlinkCopyCannotEscapeDestination(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("creating symlinks may require privileges on Windows")
+	}
+	ctx, config := fs.AddConfig(context.Background())
+	config.Links = true
+
+	archiveDir := t.TempDir()
+	name := writeTestZip(t, archiveDir, "evil.zip",
+		zipTestEntry{name: "escape", data: "../outside", mode: os.ModeSymlink | 0o777},
+		zipTestEntry{name: "escape/pwn.txt", data: "owned"},
+	)
+	localFs, err := cache.Get(ctx, archiveDir)
+	require.NoError(t, err)
+	srcFs, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	parent := t.TempDir()
+	dstRoot := filepath.Join(parent, "destination")
+	dstFs, err := cache.Get(ctx, dstRoot)
+	require.NoError(t, err)
+
+	link, err := srcFs.NewObject(ctx, "escape.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, link.Remote(), link)
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", func() string {
+		target, err := os.Readlink(filepath.Join(dstRoot, "escape"))
+		require.NoError(t, err)
+		return target
+	}())
+
+	child, err := srcFs.NewObject(ctx, "escape/pwn.txt")
+	require.NoError(t, err)
