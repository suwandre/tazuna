+// readObject reads the whole of o as a string.
+func readObject(t *testing.T, ctx context.Context, o fs.Object) string {
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
