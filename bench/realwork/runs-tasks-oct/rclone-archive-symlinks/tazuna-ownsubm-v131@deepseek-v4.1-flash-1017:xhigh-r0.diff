+// Symlinks in a squashfs image are only exposed with --links, under
+// their name plus the .rclonelink suffix, with the target as contents.
+func TestSymlinks(t *testing.T) {
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("hello"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "link.txt")))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "regular.rclonelink"), []byte("not a link"), 0600))
+
+	dir := t.TempDir()
+	name := "links.sqfs"
+	makeSquashfs(t, input, filepath.Join(dir, name))
+
+	localFs, err := fscache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	t.Run("WithoutLinks", func(t *testing.T) {
+		ctx := context.Background()
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		sort.Strings(remotes)
+		assert.Equal(t, []string{"file.txt", "regular.rclonelink"}, remotes)
+
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "link.txt.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("WithLinks", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(context.Background())
+		ci.Links = true
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		sort.Strings(remotes)
+		assert.Equal(t, []string{"file.txt", "link.txt.rclonelink", "regular.rclonelink"}, remotes)
+
+		// A regular member which happens to end in .rclonelink stays
+		// a regular file.
+		regular, err := f.NewObject(ctx, "regular.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "not a link", readObject(t, ctx, regular))
+
+		// The unsuffixed name of a symlink is not exposed.
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		link, err := f.NewObject(ctx, "link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), link.Size())
+		assert.Equal(t, "file.txt", readObject(t, ctx, link))
+
+		// Open must honour seek and range options on the target.
+		rc, err := link.Open(ctx, &fs.SeekOption{Offset: 5})
+		require.NoError(t, err)
+		data, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "txt", string(data))
+
+		rc, err = link.Open(ctx, &fs.RangeOption{Start: 0, End: 3})
+		require.NoError(t, err)
+		data, err = io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "file", string(data))
+	})
+
+	t.Run("RootAtSymlink", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(context.Background())
+		ci.Links = true
+		f, err := New(ctx, localFs, name, "", "link.txt.rclonelink")
+		require.ErrorIs(t, err, fs.ErrorIsFile)
+
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		require.Len(t, entries, 1)
+		assert.Equal(t, "link.txt.rclonelink", entries[0].Remote())
+
+		o, err := f.NewObject(ctx, "link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", readObject(t, ctx, o))
+	})
+}
