+		ctx, ci := fs.AddConfig(context.Background())
+		ci.Links = true
+		f, err := New(ctx, localFs, name, "", "src/link.txt.rclonelink")
+		require.ErrorIs(t, err, fs.ErrorIsFile)
+
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		require.Len(t, entries, 1)
+		assert.Equal(t, "link.txt.rclonelink", entries[0].Remote())
+
+		o, err := f.NewObject(ctx, "link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", readObject(t, ctx, o))
+	})
+}
+
+// readObject reads the whole of o as a string.
+func readObject(t *testing.T, ctx context.Context, o fs.Object) string {
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
+
+// Copying a symlink from a zip with --links recreates it as a symlink on
+// a destination which supports them.
+func TestCopyZipSymlink(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "links.zip", []zipEntry{
+		{"src/file.txt", 0644, "hello"},
+		{"src/link.txt", os.ModeSymlink | 0777, "file.txt"},
+	})
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	src, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "src/link.txt.rclonelink", src)
+	require.NoError(t, err)
+
+	target, err := os.Readlink(filepath.Join(dstDir, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+// A hostile zip with a symlink pointing outside the destination plus a
+// member inside it must not write outside the destination.
+func TestCopyZipSymlinkEscape(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	evil := t.TempDir()
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "evil.zip", []zipEntry{
+		{"pwn", os.ModeSymlink | 0777, evil},
+		{"pwn/authkeys", 0644, "PWNED"},
+	})
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	// Create the symlink first, as a sorted copy would.
+	srcLink, err := f.NewObject(ctx, "pwn.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn.rclonelink", srcLink)
+	require.NoError(t, err)
+
+	// Writing the sibling through the symlink must be refused.
+	srcFile, err := f.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn/authkeys", srcFile)
+	require.Error(t, err)
+
+	_, err = os.Stat(filepath.Join(evil, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evil)
+}
