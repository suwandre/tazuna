+// zipEntry describes a single entry written by writeZipEntries.
+type zipEntry struct {
+	name    string
+	mode    os.FileMode
+	content string
+}
+
+// writeZipEntries builds a zip file with entries which may be symlinks
+// (mode has os.ModeSymlink set, content is the link target).
+func writeZipEntries(t *testing.T, dir, name string, entries []zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, e := range entries {
+		fh := &zip.FileHeader{Name: e.name, Method: zip.Deflate}
+		fh.SetMode(e.mode)
+		w, err := zw.CreateHeader(fh)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(e.content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
