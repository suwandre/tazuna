+// Copying a symlink from a squashfs image with --links recreates it as a
+// symlink on a destination which supports them.
+func TestCopySymlink(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("hello"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "link.txt")))
+
+	dir := t.TempDir()
+	name := "links.sqfs"
+	makeSquashfs(t, input, filepath.Join(dir, name))
+
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	src, err := f.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dstFs, err := fscache.Get(ctx, dstDir)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "link.txt.rclonelink", src)
+	require.NoError(t, err)
+
+	target, err := os.Readlink(filepath.Join(dstDir, "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
