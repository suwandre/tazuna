+// makeSquashfs builds a squashfs image at output from the contents of
+// input using the mksquashfs binary, skipping the test if it isn't
+// installed.
+func makeSquashfs(t *testing.T, input, output string) {
+	exe, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+	cmd := exec.Command(exe, input, output, "-no-progress", "-noappend")
+	out, err := cmd.CombinedOutput()
+	require.NoError(t, err, "mksquashfs failed: %s", out)
+}
