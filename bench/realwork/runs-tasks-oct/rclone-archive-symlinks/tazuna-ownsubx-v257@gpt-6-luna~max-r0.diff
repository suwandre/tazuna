+func writeSquashfsWithSymlink(t *testing.T, dir string) string {
+	const imageSize = 4 << 20
+	imagePath := filepath.Join(dir, "links.sqfs")
+	image, err := os.Create(imagePath)
+	require.NoError(t, err)
+	require.NoError(t, image.Truncate(imageSize))
+
+	storage := diskfile.New(image, false)
+	builder, err := disksquashfs.Create(storage, imageSize, 0, 4096)
+	require.NoError(t, err)
+	root := filepath.Join(builder.Workspace(), "src")
+	require.NoError(t, os.MkdirAll(root, 0755))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "file.txt"), []byte("contents"), 0644))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(root, "link.txt")))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "ordinary"+fs.LinkSuffix), []byte("regular file"), 0644))
+	cwd, err := os.Getwd()
+	require.NoError(t, err)
+	require.NoError(t, os.Chdir(builder.Workspace()))
+	t.Cleanup(func() { _ = os.Chdir(cwd) })
+	err = builder.Finalize(disksquashfs.FinalizeOptions{})
+	require.NoError(t, os.Chdir(cwd))
+	require.NoError(t, err)
+	require.NoError(t, image.Close())
+	return "links.sqfs"
+}
+
+func TestSquashfsSymlinks(t *testing.T) {
+	probe := filepath.Join(t.TempDir(), "link")
+	if err := os.Symlink("target", probe); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	dir := t.TempDir()
+	name := writeSquashfsWithSymlink(t, dir)
+	localFs, err := fscache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	withLinks := func(enabled bool) context.Context {
+		ctx, config := fs.AddConfig(context.Background())
+		config.Links = enabled
+		return ctx
+	}
+
+	t.Run("without links", func(t *testing.T) {
+		ctx := withLinks(false)
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		entries, err := f.List(ctx, "src")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.ElementsMatch(t, []string{"src/file.txt", "src/ordinary" + fs.LinkSuffix}, remotes)
+		_, err = f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("with links", func(t *testing.T) {
+		ctx := withLinks(true)
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		entries, err := f.List(ctx, "src")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.ElementsMatch(t, []string{
+			"src/file.txt",
+			"src/link.txt" + fs.LinkSuffix,
+			"src/ordinary" + fs.LinkSuffix,
+		}, remotes)
+
+		o, err := f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		reader, err := o.Open(ctx)
+		require.NoError(t, err)
+		target, err := io.ReadAll(reader)
+		require.NoError(t, err)
+		require.NoError(t, reader.Close())
+		assert.Equal(t, "file.txt", string(target))
+
+		reader, err = o.Open(ctx, &fs.RangeOption{Start: 1, End: 3})
+		require.NoError(t, err)
+		part, err := io.ReadAll(reader)
+		require.NoError(t, err)
+		require.NoError(t, reader.Close())
+		assert.Equal(t, "ile", string(part))
+
+		o, err = f.NewObject(ctx, "src/ordinary"+fs.LinkSuffix)
+		require.NoError(t, err)
+		reader, err = o.Open(ctx)
+		require.NoError(t, err)
+		body, err := io.ReadAll(reader)
+		require.NoError(t, err)
+		require.NoError(t, reader.Close())
+		assert.Equal(t, "regular file", string(body))
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		rooted, err := New(ctx, localFs, name, "", "src/link.txt"+fs.LinkSuffix)
+		require.ErrorIs(t, err, fs.ErrorIsFile)
+		entries, err = rooted.List(ctx, "")
+		require.NoError(t, err)
+		require.Len(t, entries, 1)
+		assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+		_, err = rooted.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		assert.NoError(t, err)
+	})
+}
