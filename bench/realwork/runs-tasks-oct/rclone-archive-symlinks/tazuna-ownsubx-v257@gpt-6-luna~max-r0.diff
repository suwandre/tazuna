+// Copying a translated zip symlink to a local filesystem recreates the link.
+func TestZipSymlinkCopy(t *testing.T) {
+	probeDir := t.TempDir()
+	if err := os.Symlink("target", filepath.Join(probeDir, "link")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+
+	ctx := linksContext(true)
+	archiveDir := t.TempDir()
+	archiveFile := filepath.Join(archiveDir, "links.zip")
+	out, err := os.Create(archiveFile)
+	require.NoError(t, err)
+	zw := zip.NewWriter(out)
+	addZipSymlink(t, zw, "src/link.txt", "file.txt")
+	require.NoError(t, zw.Close())
+	require.NoError(t, out.Close())
+
+	upstream, err := cache.Get(ctx, archiveDir)
+	require.NoError(t, err)
+	source, err := New(ctx, upstream, "links.zip", "", "")
+	require.NoError(t, err)
+	destinationPath := t.TempDir()
+	destination, err := cache.Get(ctx, destinationPath)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, destination, source, false))
+
+	linkPath := filepath.Join(destinationPath, "src", "link.txt")
+	info, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	assert.True(t, info.Mode()&os.ModeSymlink != 0)
+	target, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
