+func (f *Fs) hasSymlinkPath(nativePath string, includeLeaf bool) bool {
+	components := strings.Split(strings.Trim(nativePath, "/"), "/")
+	if len(components) == 1 && components[0] == "" {
+		return false
+	}
+	limit := len(components)
+	if !includeLeaf {
