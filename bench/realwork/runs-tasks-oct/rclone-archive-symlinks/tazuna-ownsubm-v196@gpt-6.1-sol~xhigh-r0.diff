+func TestSymlinks(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = false
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "file.txt", entries[0].Remote())
+	_, err = f.NewObject(ctx, "link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctx, ci = fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(ctx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = f.List(ctx, "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "link.txt.rclonelink"}, remotes)
+
+	o, err := f.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file.txt", string(contents))
+
+	rc, err = o.Open(ctx, &fs.RangeOption{Start: 2, End: 5})
+	require.NoError(t, err)
+	contents, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "le.t", string(contents))
+
+	rc, err = o.Open(ctx, &fs.SeekOption{Offset: 2})
+	require.NoError(t, err)
+	contents, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "le.txt", string(contents))
+
+	rooted, err := New(ctx, localFs, "symlink.sqfs", "", "link.txt.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	rootedObject, err := rooted.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	rc, err = rootedObject.Open(ctx)
+	require.NoError(t, err)
+	contents, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file.txt", string(contents))
+}
