+		items, err := f.sqfs.ReadDir(toIOFS(dir))
+		if err != nil {
+			return false
+		}
+		for _, item := range items {
+			if item.Name() == component {
+				if item.Type()&os.ModeSymlink != 0 {
+					return true
+				}
+				break
+			}
+		}
+		dir = path.Join(dir, component)
+	}
