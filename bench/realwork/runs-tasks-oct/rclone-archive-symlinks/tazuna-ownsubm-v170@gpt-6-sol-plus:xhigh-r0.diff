+// TestArchiveSymlinkEscape checks that a symlink from an archive cannot
+// redirect a later copy outside the destination.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("symlinks are unavailable: %v", err)
+	}
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	sourceDir := t.TempDir()
+	archivePath := filepath.Join(sourceDir, "links.zip")
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	header := &zip.FileHeader{Name: "pwn", Modified: time.Now()}
+	header.SetMode(os.ModeSymlink | 0o777)
+	w, err := zw.CreateHeader(header)
+	require.NoError(t, err)
+	evil := t.TempDir()
+	_, err = w.Write([]byte(evil))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(archivePath, buf.Bytes(), 0600))
+
+	source, err := cache.Get(ctx, ":archive:"+archivePath)
+	require.NoError(t, err)
+	destinationPath := filepath.Join(t.TempDir(), "out")
+	destination, err := local.NewFs(ctx, "local", destinationPath, configmap.Simple{})
+	require.NoError(t, err)
+
+	link, err := source.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, destination, nil, link.Remote(), link)
+	require.NoError(t, err)
+	child, err := source.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, destination, nil, child.Remote(), child)
+	require.Error(t, err)
+
+	_, err = os.Stat(filepath.Join(evil, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "archive symlink redirected a write outside the destination")
+}
