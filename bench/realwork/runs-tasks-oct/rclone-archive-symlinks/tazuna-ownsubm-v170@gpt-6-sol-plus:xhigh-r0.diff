+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("content"), 0600))
+	symlink := filepath.Join(input, "link.txt")
+	if err := os.Symlink("file.txt", symlink); err != nil {
+		t.Skipf("symlinks are unavailable: %v", err)
+	}
+	sub := filepath.Join(input, "sub")
+	require.NoError(t, os.Mkdir(sub, 0700))
+	if err := os.Symlink("../file.txt", filepath.Join(sub, "link.txt")); err != nil {
+		t.Skipf("symlinks are unavailable: %v", err)
+	}
+	archive := filepath.Join(t.TempDir(), "links.sqfs")
+	cmd := exec.Command("mksquashfs", input, archive)
+	output, err := cmd.CombinedOutput()
+	require.NoError(t, err, string(output))
+
+	localFs, err := fscache.Get(ctx, filepath.Dir(archive))
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, filepath.Base(archive), "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 2)
+	assert.Equal(t, "file.txt", entries[0].Remote())
+	_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(linksCtx, localFs, filepath.Base(archive), "", "")
+	require.NoError(t, err)
+	entries, err = f.List(linksCtx, "")
+	require.NoError(t, err)
+	assert.Len(t, entries, 3)
+	link, err := f.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	r, err := link.Open(linksCtx)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(r)
+	require.NoError(t, err)
+	require.NoError(t, r.Close())
+	assert.Equal(t, "file.txt", string(contents))
+
+	single, err := New(linksCtx, localFs, filepath.Base(archive), "", "sub/link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorIsFile)
+	singleEntries, err := single.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, singleEntries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, singleEntries[0].Remote())
+
+	_, err = f.NewObject(linksCtx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
