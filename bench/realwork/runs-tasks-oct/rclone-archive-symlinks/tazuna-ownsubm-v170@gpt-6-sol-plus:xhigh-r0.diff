+// writeZipWithSymlinks builds a zip file containing a regular member whose
+// name has the link suffix and a real symbolic link.
+func writeZipWithSymlinks(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("regular" + fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("regular"))
+	require.NoError(t, err)
+
+	header := &zip.FileHeader{Name: "link", Modified: time.Now()}
+	header.SetMode(os.ModeSymlink | 0o777)
+	w, err = zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("target/file"))
+	require.NoError(t, err)
+
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// TestZipSymlinks checks translated link listings, lookups and reads.
+func TestZipSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipWithSymlinks(t, dir, "links.zip")
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"regular" + fs.LinkSuffix}, allRemotes(t, f))
+	_, err = f.NewObject(ctx, "link"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(linksCtx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"link" + fs.LinkSuffix, "regular" + fs.LinkSuffix}, allRemotes(t, f))
+
+	regular, err := f.NewObject(linksCtx, "regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.False(t, regular.(*Object).symlink)
+	link, err := f.NewObject(linksCtx, "link"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("target/file")), link.Size())
+	assert.Equal(t, "target/file", string(readObject(t, linksCtx, link)))
+	assert.Equal(t, "rget", string(readObject(t, linksCtx, link, &fs.RangeOption{Start: 2, End: 5})))
+	_, err = f.NewObject(linksCtx, "link")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	single, err := New(linksCtx, localFs, name, "", "link"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorIsFile)
+	singleEntries, err := single.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, singleEntries, 1)
+	assert.Equal(t, "link"+fs.LinkSuffix, singleEntries[0].Remote())
+}
