+func readObject(t *testing.T, ctx context.Context, o fs.Object, options ...fs.OpenOption) []byte {
+	t.Helper()
+	r, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(r)
+	require.NoError(t, err)
+	require.NoError(t, r.Close())
+	return data
+}
