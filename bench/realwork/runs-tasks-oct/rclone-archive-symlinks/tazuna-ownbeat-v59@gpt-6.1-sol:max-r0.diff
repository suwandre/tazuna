@@ -0,0 +1,280 @@
+//go:build !plan9
+
+package archive
+
+import (
+	"archive/zip"
+	"context"
+	"log/slog"
+	"os"
+	"path"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/accounting"
+	"github.com/rclone/rclone/fs/config/configmap"
+	"github.com/rclone/rclone/fs/log"
+	"github.com/rclone/rclone/fs/operations"
+	fssync "github.com/rclone/rclone/fs/sync"
+	"github.com/rclone/rclone/fstest"
+	"github.com/rclone/rclone/fstest/fstests"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type symlinkArchiveEntry struct {
+	name, content string
+	mode          os.FileMode
+}
+
+var symlinkArchiveEntries = []symlinkArchiveEntry{
+	{"src/file.txt", "hello", 0644},
+	{"src/regular.rclonelink", "ordinary data", 0644},
+	{"src/link.txt", "file.txt", os.ModeSymlink | 0777},
+	{"src/broken", "missing.txt", os.ModeSymlink | 0777},
+	{"src/dirlink", ".", os.ModeSymlink | 0777},
+	{"src/suffixed.rclonelink", "file.txt", os.ModeSymlink | 0777},
+}
+
+func writeSymlinkZip(t *testing.T, name string, entries []symlinkArchiveEntry) {
+	t.Helper()
+	out, err := os.Create(name)
+	require.NoError(t, err)
+	zw := zip.NewWriter(out)
+	for _, entry := range entries {
+		h := &zip.FileHeader{Name: entry.name, Modified: time.Unix(1234567890, 0).UTC()}
+		h.SetMode(entry.mode)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, out.Close())
+}
+
+func symlinkArchive(t *testing.T, extension string) string {
+	t.Helper()
+	if extension == ".sqfs" {
+		name, err := filepath.Abs(filepath.Join("squashfs", "testdata", "symlinks.sqfs"))
+		require.NoError(t, err)
+		return name
+	}
+	name := filepath.Join(t.TempDir(), "symlinks.zip")
+	writeSymlinkZip(t, name, symlinkArchiveEntries)
+	return name
+}
+
+func TestArchiveSymlinks(t *testing.T) {
+	fstest.Initialise()
+	for _, extension := range []string{".zip", ".sqfs"} {
+		t.Run(extension, func(t *testing.T) {
+			archivePath := symlinkArchive(t, extension)
+			for _, links := range []bool{false, true} {
+				name := "Skip"
+				if links {
+					name = "Links"
+				}
+				t.Run(name, func(t *testing.T) {
+					ctx, ci := fs.AddConfig(context.Background())
+					ci.Links = links
+					for _, scope := range []string{"Archive", "SubDir", "Prefix"} {
+						t.Run(scope, func(t *testing.T) {
+							root, dir := archivePath, "src"
+							switch scope {
+							case "SubDir":
+								root, dir = archivePath+"/src", ""
+							case "Prefix":
+								root, dir = filepath.Dir(archivePath), filepath.Base(archivePath)+"/src"
+							}
+
+							var mu sync.Mutex
+							var notices strings.Builder
+							log.Handler.SetOutput(func(level slog.Level, text string) {
+								if level == fs.SlogLevelNotice {
+									mu.Lock()
+									notices.WriteString(text)
+									mu.Unlock()
+								}
+							})
+							t.Cleanup(log.Handler.ResetOutput)
+
+							f, err := NewFs(ctx, "archive", root, configmap.Simple{})
+							require.NoError(t, err)
+							if scope == "Prefix" {
+								_, err = f.List(ctx, "")
+								require.NoError(t, err)
+							}
+							entries, err := f.List(ctx, dir)
+							require.NoError(t, err)
+							var want []string
+							wantSizes := make(map[string]int64)
+							for _, entry := range symlinkArchiveEntries {
+								remote := path.Join(dir, path.Base(entry.name))
+								if entry.mode&os.ModeSymlink != 0 {
+									_, err = f.NewObject(ctx, remote)
+									assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+									remote += fs.LinkSuffix
+									if !links {
+										_, err = f.NewObject(ctx, remote)
+										assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+										continue
+									}
+								}
+								want = append(want, remote)
+								wantSizes[remote] = int64(len(entry.content))
+								o, err := f.NewObject(ctx, remote)
+								require.NoError(t, err, remote)
+								assert.Equal(t, remote, o.Remote())
+								assert.Equal(t, int64(len(entry.content)), o.Size())
+								assert.Equal(t, int64(1234567890), o.ModTime(ctx).Unix())
+								assert.Equal(t, entry.content, fstests.ReadObject(ctx, t, o, -1))
+								assert.Equal(t, entry.content[1:], fstests.ReadObject(ctx, t, o, -1, &fs.SeekOption{Offset: 1}))
+								assert.Equal(t, entry.content[:1], fstests.ReadObject(ctx, t, o, -1, &fs.RangeOption{Start: 0, End: 0}))
+								assert.Equal(t, entry.content[1:min(4, len(entry.content))], fstests.ReadObject(ctx, t, o, -1, &fs.RangeOption{Start: 1, End: 3}))
+								assert.Equal(t, entry.content[len(entry.content)-1:], fstests.ReadObject(ctx, t, o, -1, &fs.RangeOption{Start: -1, End: 1}))
+								assert.Empty(t, fstests.ReadObject(ctx, t, o, -1, &fs.SeekOption{Offset: o.Size()}))
+							}
+							var got []string
+							for _, entry := range entries {
+								got = append(got, entry.Remote())
+								assert.Equal(t, wantSizes[entry.Remote()], entry.Size(), entry.Remote())
+							}
+							assert.ElementsMatch(t, want, got)
+							_, err = f.NewObject(ctx, path.Join(dir, "regular.rclonelink.rclonelink"))
+							assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+							mu.Lock()
+							noticeText := notices.String()
+							mu.Unlock()
+							if links {
+								assert.NotContains(t, noticeText, "--links")
+							} else {
+								assert.Contains(t, noticeText, "--links")
+							}
+						})
+					}
+				})
+			}
+		})
+	}
+}
+
+func TestArchiveSymlinkSingleFile(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	for _, extension := range []string{".zip", ".sqfs"} {
+		t.Run(extension, func(t *testing.T) {
+			root := symlinkArchive(t, extension) + "/src/link.txt" + fs.LinkSuffix
+			f, err := NewFs(ctx, "archive", root, configmap.Simple{})
+			require.NoError(t, err)
+			entries, err := f.List(ctx, "")
+			require.NoError(t, err)
+			require.Len(t, entries, 1)
+			assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+			o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+			require.NoError(t, err)
+			assert.Equal(t, "file.txt", fstests.ReadObject(ctx, t, o, -1))
+			_, err = f.NewObject(ctx, "file.txt")
+			assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		})
+	}
+}
+
+func TestArchiveSymlinkCopy(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	for _, extension := range []string{".zip", ".sqfs"} {
+		t.Run(extension, func(t *testing.T) {
+			src, err := NewFs(ctx, "archive", symlinkArchive(t, extension), configmap.Simple{})
+			require.NoError(t, err)
+			dir := t.TempDir()
+			if err := os.Symlink("probe", filepath.Join(dir, "probe")); err != nil {
+				t.Skipf("Symlinks unavailable: %v", err)
+			}
+			require.NoError(t, os.Remove(filepath.Join(dir, "probe")))
+			dst, err := local.NewFs(ctx, "local", dir, configmap.Simple{})
+			require.NoError(t, err)
+			defer accounting.Stats(ctx).ResetErrors()
+			require.NoError(t, fssync.CopyDir(ctx, dst, src, false))
+			target, err := os.Readlink(filepath.Join(dir, "src", "link.txt"))
+			require.NoError(t, err)
+			assert.Equal(t, "file.txt", target)
+			data, err := os.ReadFile(filepath.Join(dir, "src", "link.txt"))
+			require.NoError(t, err)
+			assert.Equal(t, "hello", string(data))
+		})
+	}
+}
+
+func TestArchiveSymlinkEscapeCopy(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	ci.LowLevelRetries = 1
+	work := t.TempDir()
+	outside := filepath.Join(work, "outside")
+	require.NoError(t, os.Mkdir(outside, 0700))
+	if err := os.Symlink("../outside", filepath.Join(work, "probe")); err != nil {
+		t.Skipf("Symlinks unavailable: %v", err)
+	}
+	archivePath := filepath.Join(work, "evil.zip")
+	writeSymlinkZip(t, archivePath, []symlinkArchiveEntry{
+		{"escape", "../outside", os.ModeSymlink | 0777},
+		{"escape/escaped.txt", "must stay inside", 0644},
+	})
+	src, err := NewFs(ctx, "archive", archivePath, configmap.Simple{})
+	require.NoError(t, err)
+	dst, err := local.NewFs(ctx, "local", filepath.Join(work, "out"), configmap.Simple{})
+	require.NoError(t, err)
+	defer accounting.Stats(ctx).ResetErrors()
+
+	// Copy the link first to exercise a write through it, independently of transfer order.
+	o, err := src.NewObject(ctx, "escape"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, o.Remote(), o)
+	require.NoError(t, err)
+	target, err := os.Readlink(filepath.Join(work, "out", "escape"))
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", target)
+	o, err = src.NewObject(ctx, "escape/escaped.txt")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, o.Remote(), o)
+	require.Error(t, err)
+	entries, err := os.ReadDir(outside)
+	require.NoError(t, err)
+	assert.Empty(t, entries, "copy must not write outside the destination")
+}
+
+func TestArchiveSymlinksOnly(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = false
+	for _, root := range []string{"", "src"} {
+		t.Run(root, func(t *testing.T) {
+			name := filepath.Join(t.TempDir(), "symlinks.zip")
+			writeSymlinkZip(t, name, []symlinkArchiveEntry{
+				{path.Join(root, "link.txt"), "file.txt", os.ModeSymlink | 0777},
+			})
+			f, err := NewFs(ctx, "archive", name+"/"+root, configmap.Simple{})
+			require.NoError(t, err)
+			entries, err := f.List(ctx, "")
+			require.NoError(t, err)
+			assert.Empty(t, entries)
+			if root != "" {
+				f, err = NewFs(ctx, "archive", name, configmap.Simple{})
+				require.NoError(t, err)
+				entries, err = f.List(ctx, root)
+				require.NoError(t, err)
+				assert.Empty(t, entries)
+			}
+		})
+	}
+}
