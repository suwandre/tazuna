+func TestArchiveZipSymlinks(t *testing.T) {
+	fstest.Initialise()
+	ctx := context.Background()
+
+	makeArchive := func(name string, hostile bool) string {
+		t.Helper()
+		var buf bytes.Buffer
+		zw := zip.NewWriter(&buf)
+		add := func(name, content string, mode os.FileMode) {
+			t.Helper()
+			fh := &zip.FileHeader{Name: name}
+			fh.SetMode(mode)
+			w, err := zw.CreateHeader(fh)
+			require.NoError(t, err)
+			_, err = io.WriteString(w, content)
+			require.NoError(t, err)
+		}
+		add("src/file.txt", "file", 0644)
+		add("src/ordinary"+fs.LinkSuffix, "ordinary file", 0644)
+		add("src/ordinary", "file.txt", os.ModeSymlink|0777)
+		add("src/link.txt", "file.txt", os.ModeSymlink|0777)
+		if hostile {
+			add("pwn", "../outside", os.ModeSymlink|0777)
+			add("pwn/authkeys", "PWNED", 0644)
+		}
+		require.NoError(t, zw.Close())
+		archivePath := filepath.Join(t.TempDir(), name)
+		require.NoError(t, os.WriteFile(archivePath, buf.Bytes(), 0600))
+		return archivePath
+	}
+
+	archivePath := makeArchive("links.zip", false)
+	normalFs, err := cache.Get(ctx, ":archive:"+archivePath)
+	require.NoError(t, err)
+	entries, err := normalFs.List(ctx, "src")
+	require.NoError(t, err)
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/ordinary" + fs.LinkSuffix}, names)
+	_, err = normalFs.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	linksFs, err := cache.Get(linksCtx, ":archive:"+makeArchive("links-enabled.zip", false))
+	require.NoError(t, err)
+	entries, err = linksFs.List(linksCtx, "src")
+	require.NoError(t, err)
+	names = names[:0]
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/ordinary" + fs.LinkSuffix, "src/link.txt" + fs.LinkSuffix}, names)
+
+	link, err := linksFs.NewObject(linksCtx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	assert.Equal(t, "file.txt", string(fstests.ReadObject(linksCtx, t, link, -1)))
+	assert.Equal(t, "ile.txt", string(fstests.ReadObject(linksCtx, t, link, -1, &fs.SeekOption{Offset: 1})))
+	assert.Equal(t, "ile", string(fstests.ReadObject(linksCtx, t, link, -1, &fs.RangeOption{Start: 1, End: 3})))
+
+	ordinary, err := linksFs.NewObject(linksCtx, "src/ordinary"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, "ordinary file", string(fstests.ReadObject(linksCtx, t, ordinary, -1)))
+
+	singleFs, err := cache.Get(linksCtx, ":archive:"+archivePath+"/src/link.txt")
+	require.NoError(t, err)
+	singleEntries, err := singleFs.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, singleEntries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, singleEntries[0].Remote())
+	_, err = singleFs.NewObject(linksCtx, singleEntries[0].Remote())
+	assert.NoError(t, err)
+
+	suffixedSingleFs, err := cache.Get(linksCtx, ":archive:"+archivePath+"/src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	suffixedEntries, err := suffixedSingleFs.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, suffixedEntries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, suffixedEntries[0].Remote())
+
+	if runtime.GOOS == "windows" {
+		t.Skip("symlink creation is not reliable on Windows")
+	}
+	// Copying the translated link must recreate a symlink, while an archive
+	// member below an escaping link must not write outside the destination.
+	copyCtx, copyConfig := fs.AddConfig(ctx)
+	copyConfig.Links = true
+	copyConfig.Transfers = 1
+	linkCopyRoot := t.TempDir()
+	linkCopyDst, err := cache.Get(copyCtx, linkCopyRoot)
+	require.NoError(t, err)
+	require.NoError(t, syncops.CopyDir(copyCtx, linkCopyDst, linksFs, false))
+	linkTarget, err := os.Readlink(filepath.Join(linkCopyRoot, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", linkTarget)
+
+	copyArchivePath := makeArchive("hostile.zip", true)
+	copySource, err := cache.Get(copyCtx, ":archive:"+copyArchivePath)
+	require.NoError(t, err)
+	copyRoot := t.TempDir()
+	dstRoot := filepath.Join(copyRoot, "dst")
+	outside := filepath.Join(copyRoot, "outside")
+	require.NoError(t, os.Mkdir(dstRoot, 0700))
+	require.NoError(t, os.Mkdir(outside, 0700))
+	copyDst, err := cache.Get(copyCtx, dstRoot)
+	require.NoError(t, err)
+	assert.Error(t, syncops.CopyDir(copyCtx, copyDst, copySource, false))
+	_, err = os.Stat(filepath.Join(outside, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a member escaped the destination into %q", outside)
+	hostileTarget, err := os.Readlink(filepath.Join(dstRoot, "pwn"))
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", hostileTarget)
+}
