+// TestArchiveSquashfsSymlinks checks translated squashfs symbolic links.
+func TestArchiveSquashfsSymlinks(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoExe(t, "mksquashfs")
+	if runtime.GOOS == "windows" {
+		t.Skip("symlink creation is not reliable on Windows")
+	}
+	ctx := context.Background()
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("file"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "ordinary"+fs.LinkSuffix), []byte("ordinary file"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "link.txt")))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "ordinary")))
+
+	makeArchive := func(name string) string {
+		t.Helper()
+		archivePath := filepath.Join(t.TempDir(), name)
+		run(t, "mksquashfs", input, archivePath)
+		return archivePath
+	}
+
+	normalFs, err := cache.Get(ctx, ":archive:"+makeArchive("normal.sqfs"))
+	require.NoError(t, err)
+	entries, err := normalFs.List(ctx, "")
+	require.NoError(t, err)
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "ordinary" + fs.LinkSuffix}, names)
+	_, err = normalFs.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	linksFs, err := cache.Get(linksCtx, ":archive:"+makeArchive("links.sqfs"))
+	require.NoError(t, err)
+	entries, err = linksFs.List(linksCtx, "")
+	require.NoError(t, err)
+	names = names[:0]
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "ordinary" + fs.LinkSuffix, "link.txt" + fs.LinkSuffix}, names)
+	link, err := linksFs.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	assert.Equal(t, "file.txt", string(fstests.ReadObject(linksCtx, t, link, -1)))
+	assert.Equal(t, "ile.txt", string(fstests.ReadObject(linksCtx, t, link, -1, &fs.SeekOption{Offset: 1})))
+	assert.Equal(t, "ile", string(fstests.ReadObject(linksCtx, t, link, -1, &fs.RangeOption{Start: 1, End: 3})))
+
+	singleFs, err := cache.Get(linksCtx, ":archive:"+makeArchive("single.sqfs")+"/link.txt")
+	require.NoError(t, err)
+	singleEntries, err := singleFs.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, singleEntries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, singleEntries[0].Remote())
+	_, err = singleFs.NewObject(linksCtx, singleEntries[0].Remote())
+	assert.NoError(t, err)
+
+	suffixedArchive := makeArchive("single-suffixed.sqfs")
+	suffixedSingleFs, err := cache.Get(linksCtx, ":archive:"+suffixedArchive+"/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	suffixedEntries, err := suffixedSingleFs.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, suffixedEntries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, suffixedEntries[0].Remote())
+}
