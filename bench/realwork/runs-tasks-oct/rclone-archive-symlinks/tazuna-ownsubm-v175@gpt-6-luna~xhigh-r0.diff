+// TestZipSymlinks translates symlink entries into .rclonelink objects when
+// links are enabled, and leaves regular files with that suffix untouched.
+func TestZipSymlinks(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name    string
+		content string
+		mode    os.FileMode
+	}{
+		{"src/file.txt", "contents", 0644},
+		{"src/link.txt", "file.txt", os.ModeSymlink | 0777},
+		{"src/regular.rclonelink", "ordinary file", 0644},
+		{"src/collision", "target", os.ModeSymlink | 0777},
+		{"src/collision.rclonelink", "ordinary collision", 0644},
+	} {
+		header := &zip.FileHeader{Name: entry.name}
+		header.SetMode(entry.mode)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = io.WriteString(w, entry.content)
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	name := filepath.Join(dir, "links.zip")
+	require.NoError(t, os.WriteFile(name, buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, "links.zip", "", "")
+	require.NoError(t, err)
+
+	assert.Equal(t, []string{"src/collision.rclonelink", "src/file.txt", "src/link.txt.rclonelink", "src/regular.rclonelink"}, allRemotes(t, f))
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	link, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	read := func(options ...fs.OpenOption) string {
+		rc, err := link.Open(ctx, options...)
+		require.NoError(t, err)
+		defer func() { require.NoError(t, rc.Close()) }()
+		data, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		return string(data)
+	}
+	assert.Equal(t, "file.txt", read())
+	assert.Equal(t, "le.txt", read(&fs.SeekOption{Offset: 2}))
+	assert.Empty(t, read(&fs.SeekOption{Offset: 20}))
+	assert.Equal(t, "ile.", read(&fs.RangeOption{Start: 1, End: 4}))
+
+	regular, err := f.NewObject(ctx, "src/regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("ordinary file")), regular.Size())
+	rc, err := regular.Open(ctx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ordinary file", string(data))
+
+	collision, err := f.NewObject(ctx, "src/collision.rclonelink")
+	require.NoError(t, err)
+	rc, err = collision.Open(ctx)
+	require.NoError(t, err)
+	data, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ordinary collision", string(data))
+
+	// The regular file should remain regular, while the translated link is
+	// recreated as a symlink by a destination using --links.
+	probe := filepath.Join(t.TempDir(), "symlink-probe")
+	if err := os.Symlink("target", probe); err != nil {
+		t.Skipf("Skipping symlink copy as symlinks are unavailable: %v", err)
+	}
+	dstRoot := filepath.Join(t.TempDir(), "out")
+	dst, err := local.NewFs(ctx, "local", dstRoot, configmap.Simple{})
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, link.Remote(), link)
+	require.NoError(t, err)
+	target, err := os.Readlink(filepath.Join(dstRoot, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+
+	rootFs, err := New(ctx, localFs, "links.zip", "", "src/link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorIsFile)
+	require.NotNil(t, rootFs)
+	rootEntries, err := rootFs.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, rootEntries, 1)
+	assert.Equal(t, "link.txt.rclonelink", rootEntries[0].Remote())
