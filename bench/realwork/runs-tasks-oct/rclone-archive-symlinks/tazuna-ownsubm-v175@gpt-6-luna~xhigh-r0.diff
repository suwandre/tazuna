+// enabled.
+func TestZipSymlinksSkipped(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = false
+	dir := t.TempDir()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	header := &zip.FileHeader{Name: "link"}
+	header.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = io.WriteString(w, "target")
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "links.zip"), buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, "links.zip", "", "")
+	require.NoError(t, err)
+	assert.Empty(t, allRemotes(t, f))
+	_, err = f.NewObject(ctx, "link")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+}
+
+// TestZipSymlinkPathEscape prevents a symlink and a member beneath it from
+// writing outside the destination when copied with --links.
+func TestZipSymlinkPathEscape(t *testing.T) {
+	probe := filepath.Join(t.TempDir(), "symlink-probe")
+	if err := os.Symlink("target", probe); err != nil {
+		t.Skipf("Skipping symlink path escape test as symlinks are unavailable: %v", err)
+	}
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name    string
+		content string
+		mode    os.FileMode
+	}{
+		{"escape", "../outside", os.ModeSymlink | 0777},
+		{"escape/pwned.txt", "hostile", 0644},
+	} {
+		header := &zip.FileHeader{Name: entry.name}
+		header.SetMode(entry.mode)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = io.WriteString(w, entry.content)
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "evil.zip"), buf.Bytes(), 0600))
+
+	wrappedFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	src, err := New(ctx, wrappedFs, "evil.zip", "", "")
+	require.NoError(t, err)
+	dstRoot := filepath.Join(t.TempDir(), "out")
+	outsideDir := filepath.Join(filepath.Dir(dstRoot), "outside")
+	require.NoError(t, os.Mkdir(outsideDir, 0700))
+	dst, err := local.NewFs(ctx, "local", dstRoot, configmap.Simple{})
+	require.NoError(t, err)
+	// Copy the malicious symlink before its child to exercise the destination's
+	// protection against traversing a symlink planted within the root.
+	link, err := src.NewObject(ctx, "escape.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, link.Remote(), link)
+	require.NoError(t, err)
+	child, err := src.NewObject(ctx, "escape/pwned.txt")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, child.Remote(), child)
+	assert.Error(t, err)
+	outside := filepath.Join(outsideDir, "pwned.txt")
+	_, err = os.Lstat(outside)
+	assert.ErrorIs(t, err, os.ErrNotExist)
+}
