+
+// makeSquashfs writes a squashfs image of src to dir using mksquashfs
+// and returns the image's leaf name.
+func makeSquashfs(t *testing.T, src, dir, name string) string {
+	if _, err := exec.LookPath("mksquashfs"); err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+	out, err := exec.Command("mksquashfs", src, filepath.Join(dir, name), "-no-progress", "-noappend").CombinedOutput()
