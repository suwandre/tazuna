+// TestSymlinks checks that symlinks in a squashfs image are skipped
+// without -l/--links and exposed as .rclonelink objects with it, and
+// that a regular file whose name ends in .rclonelink stays a regular
+// file.
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+
+	src := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(src, "file.txt"), []byte("hello world"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(src, "plain.rclonelink"), []byte("not a link"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(src, "link.txt")))
+
+	dir := t.TempDir()
+	name := makeSquashfs(t, src, dir, "links.sqfs")
+
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	t.Run("WithoutLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.ElementsMatch(t, []string{"file.txt", "plain.rclonelink"}, remotes)
+
+		_, err = f.NewObject(ctx, "link.txt.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("WithLinks", func(t *testing.T) {
+		linkCtx := withLinks(ctx)
+		f, err := New(linkCtx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		entries, err := f.List(linkCtx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.ElementsMatch(t, []string{"file.txt", "link.txt.rclonelink", "plain.rclonelink"}, remotes)
+
+		o, err := f.NewObject(linkCtx, "link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "link.txt.rclonelink", o.Remote())
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+
+		// Opening reads the target, honouring seek and range options
+		assert.Equal(t, "file.txt", fstests.ReadObject(linkCtx, t, o, -1))
+		assert.Equal(t, "le.txt", fstests.ReadObject(linkCtx, t, o, -1, &fs.SeekOption{Offset: 2}))
+		assert.Equal(t, "file", fstests.ReadObject(linkCtx, t, o, -1, &fs.RangeOption{Start: 0, End: 3}))
+
+		// The name without the suffix doesn't exist
+		_, err = f.NewObject(linkCtx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// A regular file ending in .rclonelink is still a regular file
+		o, err = f.NewObject(linkCtx, "plain.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("not a link")), o.Size())
+		assert.Equal(t, "not a link", fstests.ReadObject(linkCtx, t, o, -1))
+	})
+}
