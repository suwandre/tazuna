 	}
 }
+
+// zipTestEntry describes an entry for writeSymlinkZip.
+type zipTestEntry struct {
+	name string
+	mode os.FileMode
+	data string
+}
+
+// writeSymlinkZip writes a zip file called name in dir with the
+// entries given and returns its path.
+func writeSymlinkZip(t *testing.T, dir, name string, entries ...zipTestEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		hdr := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+		hdr.SetMode(entry.mode)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.data))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(dir, name)
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+	return zipPath
+}
+
+// TestArchiveZipSymlinkCopy checks that copying with -l/--links from a
+// zip recreates symlinks on a destination which supports them.
+func TestArchiveZipSymlinkCopy(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	zipPath := writeSymlinkZip(t, t.TempDir(), "links.zip",
+		zipTestEntry{"src/file.txt", 0644, "hello world"},
+		zipTestEntry{"src/link.txt", os.ModeSymlink | 0777, "file.txt"},
+	)
+
+	srcFs, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	dst := t.TempDir()
+	dstFs, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+
+	o, err := srcFs.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "src/link.txt.rclonelink", o)
+	require.NoError(t, err)
+
+	target, err := os.Readlink(filepath.Join(dst, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+// TestArchiveZipSymlinkEscape checks that a hostile zip which plants a
+// symlink pointing outside the destination and then a member inside it
+// can't make a copy write outside the destination.
+func TestArchiveZipSymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	evil := t.TempDir()
+	evilFile := filepath.Join(evil, "authkeys")
+
+	zipPath := writeSymlinkZip(t, t.TempDir(), "evil.zip",
+		zipTestEntry{"pwn", os.ModeSymlink | 0777, evil},
+		zipTestEntry{"pwn/authkeys", 0644, "PWNED"},
+	)
+
+	srcFs, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	dst := t.TempDir()
+	dstFs, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+
+	// The symlink is reproduced faithfully, pointing outside the destination.
+	link, err := srcFs.NewObject(ctx, "pwn.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn.rclonelink", link)
+	require.NoError(t, err)
+
+	// But the member "inside" it must not be written through.
+	member, err := srcFs.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn/authkeys", member)
+	require.Error(t, err, "writing through a planted symlink should be refused")
+
+	_, err = os.Stat(evilFile)
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evilFile)
+}
