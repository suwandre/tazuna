+
+// zipEntry describes an entry for writeZipEntries.
+type zipEntry struct {
+	name string
+	mode os.FileMode
+	data string
+}
+
+// writeZipEntries builds a zip file with the entries given in dir and
+// returns its leaf name. The mode of each entry is stored in the
+// external attributes, as zip does for symlinks.
+func writeZipEntries(t *testing.T, dir, name string, entries []zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		hdr := &zip.FileHeader{
+			Name:   entry.name,
+			Method: zip.Deflate,
+		}
+		hdr.SetMode(entry.mode)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.data))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// withLinks returns a context with -l/--links enabled.
+func withLinks(ctx context.Context) context.Context {
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	return ctx
+}
+
+// TestSymlinks checks that symlinks in a zip are skipped without
+// -l/--links and exposed as .rclonelink objects with it, and that a
+// regular member whose name ends in .rclonelink stays a regular file.
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "links.zip", []zipEntry{
+		{name: "src/file.txt", mode: 0644, data: "hello world"},
+		{name: "src/link.txt", mode: os.ModeSymlink | 0777, data: "file.txt"},
+		{name: "plain.rclonelink", mode: 0644, data: "not a link"},
+	})
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	t.Run("WithoutLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		assert.Equal(t, []string{"plain.rclonelink", "src/file.txt"}, allRemotes(t, f))
+
+		_, err = f.NewObject(ctx, "src/link.txt.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("WithLinks", func(t *testing.T) {
+		linkCtx := withLinks(ctx)
+		f, err := New(linkCtx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		assert.Equal(t, []string{"plain.rclonelink", "src/file.txt", "src/link.txt.rclonelink"}, allRemotes(t, f))
+
+		// Listing agrees with NewObject
+		entries, err := f.List(linkCtx, "src")
+		require.NoError(t, err)
+		var listed []string
+		for _, entry := range entries {
+			listed = append(listed, entry.Remote())
+		}
+		assert.Equal(t, []string{"src/file.txt", "src/link.txt.rclonelink"}, listed)
+
+		o, err := f.NewObject(linkCtx, "src/link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "src/link.txt.rclonelink", o.Remote())
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+
+		// Opening reads the target, honouring seek and range options
+		assert.Equal(t, "file.txt", fstests.ReadObject(linkCtx, t, o, -1))
+		assert.Equal(t, "le.txt", fstests.ReadObject(linkCtx, t, o, -1, &fs.SeekOption{Offset: 2}))
+		assert.Equal(t, "file", fstests.ReadObject(linkCtx, t, o, -1, &fs.RangeOption{Start: 0, End: 3}))
+
+		// The name without the suffix doesn't exist
+		_, err = f.NewObject(linkCtx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// A regular member ending in .rclonelink is still a regular file
+		o, err = f.NewObject(linkCtx, "plain.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("not a link")), o.Size())
+		assert.Equal(t, "not a link", fstests.ReadObject(linkCtx, t, o, -1))
+	})
+}
