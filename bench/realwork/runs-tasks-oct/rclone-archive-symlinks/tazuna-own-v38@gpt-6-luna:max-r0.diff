+func TestArchiveZipSymlinkEscape(t *testing.T) {
+	probe := filepath.Join(t.TempDir(), "link")
+	if err := os.Symlink("target", probe); err != nil {
+		t.Skipf("Skipping as symlinks are unavailable: %v", err)
+	}
+	fstest.Initialise()
+
+	base := t.TempDir()
+	destination := filepath.Join(base, "out")
+	outside := filepath.Join(base, "outside")
+	require.NoError(t, os.Mkdir(outside, 0700))
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	header := &zip.FileHeader{Name: "pwn"}
+	header.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("../outside"))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	zipPath := filepath.Join(base, "evil.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dst, err := cache.Get(ctx, destination)
+	require.NoError(t, err)
+	entries, err := src.List(ctx, "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.Contains(t, remotes, "pwn"+fs.LinkSuffix)
+	childEntries, err := src.List(ctx, "pwn")
+	require.NoError(t, err)
+	require.Len(t, childEntries, 1)
+	assert.Equal(t, "pwn/authkeys", childEntries[0].Remote())
+
+	// Recreate the symlink first, then copy the member nested under it.
+	link, err := src.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, link.Remote(), link)
+	require.NoError(t, err)
+	linkPath := filepath.Join(destination, "pwn")
+	linkInfo, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	assert.True(t, linkInfo.Mode()&os.ModeSymlink != 0)
+	target, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", target)
+
+	member, err := src.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, member.Remote(), member)
+	assert.Error(t, err, "a member nested under the symlink should not be copied")
+	_, err = os.Lstat(filepath.Join(outside, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", outside)
+}
