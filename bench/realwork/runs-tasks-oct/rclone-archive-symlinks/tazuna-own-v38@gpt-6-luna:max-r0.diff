+		{"Range", []fs.OpenOption{&fs.RangeOption{Start: 1, End: 3}}, "ile"},
+		{"SeekPastEnd", []fs.OpenOption{&fs.SeekOption{Offset: 100}}, ""},
+		{"RangePastEnd", []fs.OpenOption{&fs.RangeOption{Start: 100, End: -1}}, ""},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			rc, err := link.Open(linksCtx, test.options...)
+			require.NoError(t, err)
+			data, err := io.ReadAll(rc)
+			require.NoError(t, err)
+			require.NoError(t, rc.Close())
+			assert.Equal(t, test.want, string(data))
+		})
+	}
+
+	regular, err := f.NewObject(linksCtx, "regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("regular")), regular.Size())
+	rc, err := regular.Open(linksCtx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "regular", string(data))
