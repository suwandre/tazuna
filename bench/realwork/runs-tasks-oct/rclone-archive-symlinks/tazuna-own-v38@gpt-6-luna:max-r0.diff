+	writeSymlinkSquashfs(t, filename)
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = false
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, filepath.Base(filename), "", "")
+	require.NoError(t, err)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "regular.rclonelink"}, remotes)
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, linksConfig := fs.AddConfig(context.Background())
+	linksConfig.Links = true
+	f, err = New(linksCtx, localFs, filepath.Base(filename), "", "")
+	require.NoError(t, err)
+	entries, err = f.List(linksCtx, "")
+	require.NoError(t, err)
+	remotes = remotes[:0]
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "link.txt" + fs.LinkSuffix, "regular.rclonelink"}, remotes)
+
+	link, err := f.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
