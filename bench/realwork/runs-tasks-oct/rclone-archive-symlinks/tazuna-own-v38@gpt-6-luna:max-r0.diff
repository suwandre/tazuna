+func writeSymlinkSquashfs(t *testing.T, filename string) {
+	t.Helper()
+	out, err := os.Create(filename)
+	require.NoError(t, err)
+
+	image, err := diskfsquashfs.Create(diskfile.New(out, false), 0, 0, 4096)
+	require.NoError(t, err)
+	workspace := image.Workspace()
+	t.Cleanup(func() { _ = os.RemoveAll(workspace) })
+	require.NoError(t, os.WriteFile(filepath.Join(workspace, "file.txt"), []byte("file contents"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(workspace, "regular.rclonelink"), []byte("regular"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(workspace, "link.txt")))
+	oldwd, err := os.Getwd()
+	require.NoError(t, err)
+	// go-diskfs resolves symlink targets relative to the current directory during Finalize.
+	require.NoError(t, os.Chdir(workspace))
+	finalizeErr := image.Finalize(diskfsquashfs.FinalizeOptions{})
+	require.NoError(t, os.Chdir(oldwd))
+	require.NoError(t, finalizeErr)
+	require.NoError(t, out.Close())
+}
