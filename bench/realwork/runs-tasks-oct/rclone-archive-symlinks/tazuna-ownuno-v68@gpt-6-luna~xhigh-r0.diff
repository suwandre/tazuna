 	"os"
 	"path/filepath"
 	"sort"
@@ -146,6 +147,51 @@ func TestReadZipDirNamedFileEntry(t *testing.T) {
 
 // Listings are served from a cache which must survive callers
 // filtering the returned slice in place, as fs/list does.
+func TestZipSymlinkLinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	regular, err := zw.Create("link.rclonelink")
+	require.NoError(t, err)
+	_, err = regular.Write([]byte("ordinary"))
+	require.NoError(t, err)
+	linkHeader := &zip.FileHeader{Name: "src/link.txt", Method: zip.Deflate}
+	linkHeader.SetMode(os.ModeSymlink | 0777)
+	link, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = link.Write([]byte("../outside"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	name := "links.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	withoutLinks, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"link.rclonelink"}, allRemotes(t, withoutLinks))
+	_, err = withoutLinks.(*Fs).NewObject(ctx, "src/link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	withLinks, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"link.rclonelink", "src/link.txt.rclonelink"}, allRemotes(t, withLinks))
+	obj, err := withLinks.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("../outside")), obj.Size())
+	rc, err := obj.Open(ctx, &fs.RangeOption{Start: 3, End: 6})
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "outs", string(data))
+	_, err = withLinks.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+}
