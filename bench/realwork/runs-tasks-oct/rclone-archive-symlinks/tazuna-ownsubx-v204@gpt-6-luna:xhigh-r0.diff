+func TestZipSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := "links.zip"
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name, content string
+		mode          os.FileMode
+	}{
+		{"src/file.txt", "file contents", 0644},
+		{"src/link.txt", "file.txt", os.ModeSymlink | 0777},
+		{"src/regular.rclonelink", "ordinary file", 0644},
+	} {
+		header := &zip.FileHeader{Name: entry.name}
+		header.SetMode(entry.mode)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	obj, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	assert.Len(t, entries, 2)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(linksCtx, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err = f.List(linksCtx, "src")
+	require.NoError(t, err)
+	var got []string
+	for _, entry := range entries {
+		got = append(got, entry.Remote())
+	}
+	assert.Equal(t, []string{"src/file.txt", "src/link.txt.rclonelink", "src/regular.rclonelink"}, got)
+
+	obj, err = f.NewObject(linksCtx, "src/link.txt")
+	require.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	obj, err = f.NewObject(linksCtx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), obj.Size())
+	read := func(options ...fs.OpenOption) string {
+		rc, err := obj.Open(linksCtx, options...)
+		require.NoError(t, err)
+		defer rc.Close()
+		content, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		return string(content)
+	}
+	assert.Equal(t, "file.txt", read())
+	assert.Equal(t, "ile", read(&fs.RangeOption{Start: 1, End: 3}))
+	assert.Equal(t, "le.txt", read(&fs.SeekOption{Offset: 2}))
+
+	regular, err := f.NewObject(linksCtx, "src/regular.rclonelink")
+	require.NoError(t, err)
+	rc, err := regular.Open(linksCtx)
+	require.NoError(t, err)
+	content, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ordinary file", string(content))
+}
