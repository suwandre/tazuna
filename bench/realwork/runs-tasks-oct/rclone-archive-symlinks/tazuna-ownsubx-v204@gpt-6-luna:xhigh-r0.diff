+func TestZipSymlinkEscapeBlocked(t *testing.T) {
+	if runtime.GOOS == "windows" || runtime.GOOS == "plan9" {
+		t.Skip("symlink escape check requires Unix symlinks")
+	}
+	ctx := context.Background()
+	outside := t.TempDir()
+	archiveDir := t.TempDir()
+	archiveName := "hostile.zip"
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	header := &zip.FileHeader{Name: "pwn"}
+	header.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(outside))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("pwned"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(archiveDir, archiveName), buf.Bytes(), 0600))
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	sourceFs, err := cache.Get(ctx, archiveDir)
+	require.NoError(t, err)
+	sourceFs, err = New(linksCtx, sourceFs, archiveName, "", "")
+	require.NoError(t, err)
+	destination := t.TempDir()
+	destinationFs, err := cache.Get(linksCtx, destination)
+	require.NoError(t, err)
+
+	link, err := sourceFs.NewObject(linksCtx, "pwn.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(linksCtx, destinationFs, nil, link.Remote(), link)
+	require.NoError(t, err)
+	linkPath := filepath.Join(destination, "pwn")
+	fi, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	assert.NotZero(t, fi.Mode()&os.ModeSymlink)
+
+	member, err := sourceFs.NewObject(linksCtx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(linksCtx, destinationFs, nil, member.Remote(), member)
+	require.Error(t, err, "copying through the symlink must be refused")
+	_, err = os.Stat(filepath.Join(outside, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "hostile archive wrote outside the destination")
+}
