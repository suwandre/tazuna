+func TestSymlinks(t *testing.T) {
+	if runtime.GOOS == "windows" || runtime.GOOS == "plan9" {
+		t.Skip("creating symlinks requires privileges on Windows or is unsupported on Plan 9")
+	}
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs is not installed")
+	}
+	ctx := context.Background()
+	dir := t.TempDir()
+	input := filepath.Join(dir, "tree")
+	require.NoError(t, os.Mkdir(input, 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("file contents"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "regular.rclonelink"), []byte("ordinary file"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "link.txt")))
+	output := filepath.Join(dir, "links.sqfs")
+	cmd := exec.Command(mksquashfs, input, output, "-noappend")
+	if data, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("mksquashfs failed: %v\n%s", err, data)
+	}
+
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	obj, err := f.NewObject(ctx, "link.txt.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	assert.Len(t, entries, 2)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(linksCtx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = f.List(linksCtx, "")
+	require.NoError(t, err)
+	var foundLink bool
+	for _, entry := range entries {
+		if entry.Remote() == "link.txt.rclonelink" {
+			foundLink = true
+		}
+	}
+	assert.True(t, foundLink)
+
+	obj, err = f.NewObject(linksCtx, "link.txt")
+	require.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	obj, err = f.NewObject(linksCtx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), obj.Size())
+	for _, test := range []struct {
+		options []fs.OpenOption
+		want    string
+	}{
+		{nil, "file.txt"},
+		{[]fs.OpenOption{&fs.RangeOption{Start: 1, End: 3}}, "ile"},
+		{[]fs.OpenOption{&fs.SeekOption{Offset: 2}}, "le.txt"},
+	} {
+		rc, err := obj.Open(linksCtx, test.options...)
+		require.NoError(t, err)
+		content, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, test.want, string(content))
+	}
+
+	regular, err := f.NewObject(linksCtx, "regular.rclonelink")
+	require.NoError(t, err)
+	rc, err := regular.Open(linksCtx)
+	require.NoError(t, err)
+	content, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ordinary file", string(content))
+}
