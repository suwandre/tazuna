+// newObjectNativeRemote finds the object at nativePath whose remote is remote.
+func (f *Fs) newObjectNativeRemote(nativePath, remote string) (fs.Object, error) {
+	o, err := f.newObjectNative(nativePath)
+	if err == nil && o.Remote() == remote {
+		return o, nil
+	}
+	if err != nil && err != fs.ErrorObjectNotFound {
+		return nil, err
+	}
+	if f.links && strings.HasSuffix(remote, fs.LinkSuffix) {
+		linkPath := strings.TrimSuffix(nativePath, fs.LinkSuffix)
+		if linkPath != nativePath {
+			o, err = f.newObjectNative(linkPath)
+			if err == nil && o.Remote() == remote {
+				return o, nil
+			}
+		}
+	}
+	return nil, fs.ErrorObjectNotFound
+}
