+func skipIfNoArchiveSymlinks(t *testing.T) {
+	t.Helper()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("Skipping as symlinks are unavailable: %v", err)
+	}
+}
+
+// TestArchiveSymlinkCopy checks that --links recreates an archive symlink on a
+// local destination.
+func TestArchiveSymlinkCopy(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoArchiveSymlinks(t)
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("src/file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file contents"))
+	require.NoError(t, err)
+	linkHeader := &zip.FileHeader{Name: "src/link.txt"}
+	linkHeader.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	zipPath := filepath.Join(t.TempDir(), "test.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	destination := t.TempDir()
+	dst, err := cache.Get(ctx, destination)
+	require.NoError(t, err)
+	require.NoError(t, fsync.CopyDir(ctx, dst, src, true))
+
+	linkPath := filepath.Join(destination, "src", "link.txt")
+	fi, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	require.True(t, fi.Mode()&os.ModeSymlink != 0)
+	target, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+// TestArchiveSymlinkEscape checks that an archive symlink can't redirect a copy
+// of another member outside the destination.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoArchiveSymlinks(t)
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	destination := t.TempDir()
+	outside := t.TempDir()
+	target, err := filepath.Rel(destination, outside)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	linkHeader := &zip.FileHeader{Name: "pwn"}
+	linkHeader.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(target))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("outside write"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	zipPath := filepath.Join(t.TempDir(), "test.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	entries, err := src.List(ctx, "")
+	require.NoError(t, err)
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"pwn", "pwn" + fs.LinkSuffix}, names)
+	_, err = src.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	link, err := src.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	rc, err := link.Open(ctx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, target, string(data))
+
+	dst, err := cache.Get(ctx, destination)
+	require.NoError(t, err)
+
+	_ = fsync.CopyDir(ctx, dst, src, true)
+	_, err = os.Lstat(filepath.Join(outside, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "archive symlink wrote outside destination: %v", err)
+}
