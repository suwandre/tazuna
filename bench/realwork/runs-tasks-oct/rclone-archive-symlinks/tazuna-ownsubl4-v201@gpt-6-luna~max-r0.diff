+// symlinks.sqfs contains a regular file, a link to it, and a regular file
+// whose name ends in LinkSuffix.
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, "symlinks.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "regular.rclonelink"}, names)
+	_, err = f.NewObject(ctx, "link")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(linksCtx, localFs, "symlinks.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = f.List(linksCtx, "")
+	require.NoError(t, err)
+	names = names[:0]
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+		if _, ok := entry.(fs.Object); ok {
+			obj, err := f.NewObject(linksCtx, entry.Remote())
+			require.NoError(t, err, entry.Remote())
+			assert.Equal(t, entry.Remote(), obj.Remote())
+		}
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "link.rclonelink", "regular.rclonelink"}, names)
+
+	link, err := f.NewObject(linksCtx, "link.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	read := func(options ...fs.OpenOption) string {
+		rc, err := link.Open(linksCtx, options...)
+		require.NoError(t, err)
+		data, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		return string(data)
+	}
+	assert.Equal(t, "file.txt", read())
+	assert.Equal(t, "le.", read(&fs.RangeOption{Start: 2, End: 4}))
+	assert.Equal(t, ".txt", read(&fs.SeekOption{Offset: 4}))
+	assert.Empty(t, read(&fs.RangeOption{Start: 9, End: -1}))
+	_, err = f.NewObject(linksCtx, "link")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	regular, err := f.NewObject(linksCtx, "regular.rclonelink")
+	require.NoError(t, err)
+	assert.False(t, regular.(*Object).symlink)
+	rc, err := regular.Open(linksCtx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ordinary", string(data))
+
+	rootFs, err := New(linksCtx, localFs, "symlinks.sqfs", "", "link.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = rootFs.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.rclonelink", entries[0].Remote())
+}
