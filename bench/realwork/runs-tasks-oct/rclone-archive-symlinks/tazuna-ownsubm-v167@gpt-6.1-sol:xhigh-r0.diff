+++ b/backend/archive/symlink_test.go
@@ -0,0 +1,219 @@
+//go:build !plan9
+
+package archive
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"log/slog"
+	"os"
+	"path"
+	"path/filepath"
+	"testing"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/log"
+	"github.com/rclone/rclone/fs/operations"
+	"github.com/rclone/rclone/fs/sync"
+	"github.com/rclone/rclone/fstest"
+	"github.com/rclone/rclone/fstest/fstests"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+var archiveLinkTargets = map[string]string{
+	"link.txt":          "file.txt",
+	"dangling":          "missing",
+	"dirlink":           ".",
+	"loop":              "loop",
+	"suffix.rclonelink": "file.txt",
+	"absolute":          "/does/not/exist",
+}
+
+func symlinkArchive(t *testing.T, extension string) string {
+	t.Helper()
+	var data []byte
+	if extension == ".sqfs" {
+		var err error
+		data, err = os.ReadFile("squashfs/testdata/symlinks.sqfs")
+		require.NoError(t, err)
+	} else {
+		var buf bytes.Buffer
+		zw := zip.NewWriter(&buf)
+		add := func(name, content string, mode os.FileMode) {
+			header := &zip.FileHeader{Name: "src/" + name}
+			header.SetMode(mode)
+			w, err := zw.CreateHeader(header)
+			require.NoError(t, err)
+			_, err = io.WriteString(w, content)
+			require.NoError(t, err)
+		}
+		add("file.txt", "hello", 0644)
+		add("plain.rclonelink", "ordinary data", 0644)
+		for name, target := range archiveLinkTargets {
+			add(name, target, os.ModeSymlink|0777)
+		}
+		require.NoError(t, zw.Close())
+		data = buf.Bytes()
+	}
+	archivePath := filepath.Join(t.TempDir(), "test"+extension)
+	require.NoError(t, os.WriteFile(archivePath, data, 0600))
+	return archivePath
+}
+
+func TestArchiveSymlinks(t *testing.T) {
+	fstest.Initialise()
+	for _, extension := range []string{".zip", ".sqfs"} {
+		for _, links := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/links=%v", extension, links), func(t *testing.T) {
+				ctx, ci := fs.AddConfig(context.Background())
+				ci.Links = links
+				archivePath := symlinkArchive(t, extension)
+				var notices bytes.Buffer
+				log.Handler.SetOutput(func(level slog.Level, text string) {
+					if level == fs.SlogLevelNotice {
+						notices.WriteString(text)
+					}
+				})
+				defer log.Handler.ResetOutput()
+
+				for _, test := range []struct{ root, dir string }{
+					{archivePath, "src"},
+					{archivePath + "/src", ""},
+					{filepath.Dir(archivePath), filepath.Base(archivePath) + "/src"},
+				} {
+					f, err := fs.NewFs(ctx, ":archive:"+test.root)
+					require.NoError(t, err)
+					// Discover archives when listing their parent directory.
+					_, err = f.List(ctx, "")
+					require.NoError(t, err)
+					dir := test.dir
+					entries, err := f.List(ctx, dir)
+					require.NoError(t, err)
+					want := []string{path.Join(dir, "file.txt"), path.Join(dir, "plain.rclonelink")}
+					for name, target := range archiveLinkTargets {
+						remote := path.Join(dir, name)
+						_, err := f.NewObject(ctx, remote)
+						assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+						o, err := f.NewObject(ctx, remote+fs.LinkSuffix)
+						if !links {
+							assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+							continue
+						}
+						require.NoError(t, err)
+						want = append(want, remote+fs.LinkSuffix)
+						assert.Equal(t, remote+fs.LinkSuffix, o.Remote())
+						assert.Equal(t, int64(len(target)), o.Size())
+						assert.Equal(t, target, fstests.ReadObject(ctx, t, o, -1))
+						assert.Equal(t, target[1:], fstests.ReadObject(ctx, t, o, -1, &fs.SeekOption{Offset: 1}))
+						assert.Equal(t, target[:1], fstests.ReadObject(ctx, t, o, -1, &fs.RangeOption{Start: 0, End: 0}))
+						assert.Equal(t, target[len(target)-1:], fstests.ReadObject(ctx, t, o, -1, &fs.RangeOption{Start: -1, End: 1}))
+					}
+					var got []string
+					for _, entry := range entries {
+						got = append(got, entry.Remote())
+						o, err := f.NewObject(ctx, entry.Remote())
+						require.NoError(t, err)
+						assert.Equal(t, entry.Size(), o.Size())
+						assert.Equal(t, entry.ModTime(ctx), o.ModTime(ctx))
+					}
+					assert.ElementsMatch(t, want, got)
+					o, err := f.NewObject(ctx, path.Join(dir, "plain.rclonelink"))
+					require.NoError(t, err)
+					assert.Equal(t, int64(len("ordinary data")), o.Size())
+					assert.Equal(t, "ordinary data", fstests.ReadObject(ctx, t, o, -1))
+					_, err = f.NewObject(ctx, o.Remote()+fs.LinkSuffix)
+					assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+				}
+				if links {
+					assert.NotContains(t, notices.String(), "--links")
+				} else {
+					assert.Contains(t, notices.String(), "--links")
+				}
+				if !links {
+					return
+				}
+
+				f, err := fs.NewFs(ctx, ":archive:"+archivePath+"/src/link.txt"+fs.LinkSuffix)
+				require.NoError(t, err)
+				entries, err := f.List(ctx, "")
+				require.NoError(t, err)
+				require.Len(t, entries, 1)
+				assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+				o, err := f.NewObject(ctx, entries[0].Remote())
+				require.NoError(t, err)
+				assert.Equal(t, "file.txt", fstests.ReadObject(ctx, t, o, -1))
+			})
+		}
+	}
+}
+
+func TestArchiveCopySymlinks(t *testing.T) {
+	fstest.Initialise()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "probe")); err != nil {
+		t.Skipf("Symlinks not supported: %v", err)
+	}
+	for _, extension := range []string{".zip", ".sqfs"} {
+		t.Run(extension, func(t *testing.T) {
+			ctx, ci := fs.AddConfig(context.Background())
+			ci.Links = true
+			f, err := fs.NewFs(ctx, ":archive:"+symlinkArchive(t, extension))
+			require.NoError(t, err)
+			dstPath := t.TempDir()
+			dst, err := fs.NewFs(ctx, dstPath)
+			require.NoError(t, err)
+			require.NoError(t, sync.CopyDir(ctx, dst, f, false))
+			data, err := os.ReadFile(filepath.Join(dstPath, "src/file.txt"))
+			require.NoError(t, err)
+			assert.Equal(t, "hello", string(data))
+			for name, want := range archiveLinkTargets {
+				target, err := os.Readlink(filepath.Join(dstPath, "src", name))
+				require.NoError(t, err)
+				assert.Equal(t, want, target)
+			}
+		})
+	}
+}
+
+func TestArchiveSymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "probe")); err != nil {
+		t.Skipf("Symlinks not supported: %v", err)
+	}
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	ci.LowLevelRetries = 1
+	root := t.TempDir()
+	require.NoError(t, os.Mkdir(filepath.Join(root, "outside"), 0700))
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	header := &zip.FileHeader{Name: "pwn"}
+	header.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = io.WriteString(w, "../outside")
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = io.WriteString(w, "PWNED")
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	archivePath := filepath.Join(root, "evil.zip")
+	require.NoError(t, os.WriteFile(archivePath, buf.Bytes(), 0600))
+	f, err := fs.NewFs(ctx, ":archive:"+archivePath)
+	require.NoError(t, err)
+	dstPath := filepath.Join(root, "out")
+	dst, err := fs.NewFs(ctx, dstPath)
+	require.NoError(t, err)
+	// Copy the link first so the child write tests the planted-link guard.
+	require.NoError(t, operations.CopyFile(ctx, dst, f, "pwn"+fs.LinkSuffix, "pwn"+fs.LinkSuffix))
+	target, err := os.Readlink(filepath.Join(dstPath, "pwn"))
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", target)
+	require.Error(t, operations.CopyFile(ctx, dst, f, "pwn/authkeys", "pwn/authkeys"))
+	_, err = os.Stat(filepath.Join(root, "outside/authkeys"))
+	assert.True(t, os.IsNotExist(err), "copy must not write outside the destination")
+}
