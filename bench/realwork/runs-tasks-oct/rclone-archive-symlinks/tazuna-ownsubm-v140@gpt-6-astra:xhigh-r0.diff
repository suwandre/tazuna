+++ b/backend/archive/symlinks_test.go
@@ -0,0 +1,277 @@
+//go:build !plan9
+
+package archive
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"io"
+	"log/slog"
+	"os"
+	"path"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/accounting"
+	"github.com/rclone/rclone/fs/filter"
+	"github.com/rclone/rclone/fs/log"
+	"github.com/rclone/rclone/fs/operations"
+	"github.com/rclone/rclone/fs/sync"
+	"github.com/rclone/rclone/fstest"
+	"github.com/rclone/rclone/fstest/fstests"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type archiveMember struct {
+	name, contents string
+	mode           os.FileMode
+}
+
+var symlinkMembers = []archiveMember{
+	{"src/file.txt", "hello", 0644},
+	{"src/file.txt.rclonelink", "ordinary file", 0644},
+	{"src/link.txt", "file.txt", os.ModeSymlink | 0777},
+	{"src/dangling", "../missing", os.ModeSymlink | 0777},
+	{"src/dirlink", ".", os.ModeSymlink | 0777},
+	{"src/suffixed.rclonelink", "file.txt", os.ModeSymlink | 0777},
+	{"rootlink", "src/file.txt", os.ModeSymlink | 0777},
+}
+
+func writeArchiveZip(t *testing.T, members []archiveMember) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, member := range members {
+		h := &zip.FileHeader{Name: member.name, Method: zip.Deflate, Modified: time.Unix(1700000000, 0)}
+		h.SetMode(member.mode)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = io.WriteString(w, member.contents)
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	name := filepath.Join(t.TempDir(), "test.zip")
+	require.NoError(t, os.WriteFile(name, buf.Bytes(), 0600))
+	return name
+}
+
+func symlinkArchives(t *testing.T) map[string]string {
+	sqfs, err := filepath.Abs(filepath.Join("squashfs", "testdata", "symlinks.sqfs"))
+	require.NoError(t, err)
+	return map[string]string{
+		"zip":      writeArchiveZip(t, symlinkMembers),
+		"squashfs": sqfs,
+	}
+}
+
+func TestArchiveSymlinks(t *testing.T) {
+	fstest.Initialise()
+	for format, archivePath := range symlinkArchives(t) {
+		t.Run(format, func(t *testing.T) {
+			for _, links := range []bool{false, true} {
+				name := "Skip"
+				if links {
+					name = "Links"
+				}
+				t.Run(name, func(t *testing.T) {
+					ctx, ci := fs.AddConfig(context.Background())
+					ci.Links = links
+					for _, mount := range []struct {
+						name, root, dir string
+					}{
+						{"Archive", archivePath, "src"},
+						{"Subdir", archivePath + "/src", ""},
+						{"Parent", filepath.Dir(archivePath), filepath.Base(archivePath) + "/src"},
+					} {
+						t.Run(mount.name, func(t *testing.T) {
+							f, err := fs.NewFs(ctx, ":archive:"+mount.root)
+							require.NoError(t, err)
+							// Discover archives when mounted above the archive itself.
+							_, err = f.List(ctx, "")
+							require.NoError(t, err)
+							entries, err := f.List(ctx, mount.dir)
+							require.NoError(t, err)
+							var want, got []string
+							for _, entry := range entries {
+								got = append(got, entry.Remote())
+								listed, ok := entry.(fs.Object)
+								require.True(t, ok, "%s must be an object", entry.Remote())
+								lookedUp, err := f.NewObject(ctx, entry.Remote())
+								require.NoError(t, err)
+								assert.Equal(t, lookedUp.Size(), listed.Size())
+								assert.Equal(t, fstests.ReadObject(ctx, t, lookedUp, -1), fstests.ReadObject(ctx, t, listed, -1))
+							}
+							for _, member := range symlinkMembers {
+								if path.Dir(member.name) != "src" {
+									continue
+								}
+								remote := path.Join(mount.dir, path.Base(member.name))
+								if member.mode&os.ModeSymlink != 0 {
+									_, err = f.NewObject(ctx, remote)
+									assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+									remote += fs.LinkSuffix
+									if !links {
+										_, err = f.NewObject(ctx, remote)
+										assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+										continue
+									}
+								}
+								want = append(want, remote)
+								o, err := f.NewObject(ctx, remote)
+								require.NoError(t, err)
+								assert.Equal(t, int64(len(member.contents)), o.Size())
+								assert.Equal(t, member.contents, fstests.ReadObject(ctx, t, o, -1))
+								assert.WithinDuration(t, time.Unix(1700000000, 0), o.ModTime(ctx), time.Second)
+								if len(member.contents) > 3 {
+									assert.Equal(t, member.contents[2:], fstests.ReadObject(ctx, t, o, -1, &fs.SeekOption{Offset: 2}))
+									assert.Equal(t, member.contents[1:3], fstests.ReadObject(ctx, t, o, -1, &fs.RangeOption{Start: 1, End: 2}))
+									assert.Equal(t, member.contents[len(member.contents)-2:], fstests.ReadObject(ctx, t, o, -1, &fs.RangeOption{Start: -1, End: 2}))
+									assert.Equal(t, "", fstests.ReadObject(ctx, t, o, -1, &fs.SeekOption{Offset: o.Size()}))
+								}
+							}
+							assert.ElementsMatch(t, want, got)
+							_, err = f.NewObject(ctx, path.Join(mount.dir, "file.txt.rclonelink.rclonelink"))
+							assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+						})
+					}
+					if links {
+						for _, remote := range []string{"rootlink.rclonelink", "src/link.txt.rclonelink", "src/suffixed.rclonelink.rclonelink"} {
+							t.Run("Single/"+remote, func(t *testing.T) {
+								f, err := fs.NewFs(ctx, ":archive:"+archivePath+"/"+remote)
+								require.NoError(t, err)
+								entries, err := f.List(ctx, "")
+								require.NoError(t, err)
+								require.Len(t, entries, 1)
+								assert.Equal(t, path.Base(remote), entries[0].Remote())
+								o, err := f.NewObject(ctx, path.Base(remote))
+								require.NoError(t, err)
+								target := "file.txt"
+								if remote == "rootlink.rclonelink" {
+									target = "src/file.txt"
+								}
+								assert.Equal(t, target, fstests.ReadObject(ctx, t, o, -1))
+							})
+						}
+					}
+				})
+			}
+		})
+	}
+}
+
+func requireArchiveSymlinks(t *testing.T) {
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("Cannot create symlinks: %v", err)
+	}
+}
+
+func TestArchiveCopySymlinks(t *testing.T) {
+	fstest.Initialise()
+	requireArchiveSymlinks(t)
+	for format, archivePath := range symlinkArchives(t) {
+		t.Run(format, func(t *testing.T) {
+			ctx, ci := fs.AddConfig(context.Background())
+			ci.Links = true
+			accounting.Stats(ctx).ResetCounters()
+			t.Cleanup(func() { accounting.Stats(ctx).ResetCounters() })
+			src, err := fs.NewFs(ctx, ":archive:"+archivePath)
+			require.NoError(t, err)
+			dstPath := t.TempDir()
+			dst, err := fs.NewFs(ctx, dstPath)
+			require.NoError(t, err)
+			// The local destination interprets the suffix as a link, so omit
+			// the regular suffixed file whose name collides with file.txt.
+			ctx, fi := filter.AddConfig(ctx)
+			require.NoError(t, fi.AddRule("- /src/file.txt.rclonelink"))
+			require.NoError(t, sync.CopyDir(ctx, dst, src, false))
+			for _, member := range symlinkMembers {
+				if member.mode&os.ModeSymlink == 0 {
+					continue
+				}
+				target, err := os.Readlink(filepath.Join(dstPath, filepath.FromSlash(member.name)))
+				require.NoError(t, err)
+				assert.Equal(t, member.contents, target)
+			}
+			data, err := os.ReadFile(filepath.Join(dstPath, "src", "link.txt"))
+			require.NoError(t, err)
+			assert.Equal(t, "hello", string(data))
+		})
+	}
+}
+
+func TestArchiveCopySymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	requireArchiveSymlinks(t)
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	ci.LowLevelRetries = 1
+	accounting.Stats(ctx).ResetCounters()
+	t.Cleanup(func() { accounting.Stats(ctx).ResetCounters() })
+	archivePath := writeArchiveZip(t, []archiveMember{
+		{"escape", "../outside", os.ModeSymlink | 0777},
+		{"escape/pwned.txt", "must stay inside", 0644},
+	})
+	src, err := fs.NewFs(ctx, ":archive:"+archivePath)
+	require.NoError(t, err)
+	root := t.TempDir()
+	outside := filepath.Join(root, "outside")
+	require.NoError(t, os.Mkdir(outside, 0700))
+	dst, err := fs.NewFs(ctx, filepath.Join(root, "dst"))
+	require.NoError(t, err)
+	// Copy the link first to exercise traversal through it deterministically.
+	link, err := src.NewObject(ctx, "escape.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, link.Remote(), link)
+	require.NoError(t, err)
+	require.Error(t, sync.CopyDir(ctx, dst, src, false))
+	entries, err := os.ReadDir(outside)
+	require.NoError(t, err)
+	assert.Empty(t, entries)
+}
+
+func TestArchiveSkippedSymlinkNotice(t *testing.T) {
+	fstest.Initialise()
+	for format, archivePath := range symlinkArchives(t) {
+		t.Run(format, func(t *testing.T) {
+			out, err := os.CreateTemp(t.TempDir(), "log")
+			require.NoError(t, err)
+			defer func() { require.NoError(t, out.Close()) }()
+			fs.SetLogger(slog.NewTextHandler(out, nil))
+			defer fs.SetLogger(log.Handler)
+			ctx, ci := fs.AddConfig(context.Background())
+			ci.Links = false
+			f, err := fs.NewFs(ctx, ":archive:"+archivePath)
+			require.NoError(t, err)
+			_, err = f.List(ctx, "src")
+			require.NoError(t, err)
+			data, err := os.ReadFile(out.Name())
+			require.NoError(t, err)
+			assert.Contains(t, string(data), "symbolic links")
+			assert.Contains(t, string(data), "-l/--links")
+		})
+	}
+}
+
+func TestArchiveSkippedSymlinksOnly(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = false
+	archivePath := writeArchiveZip(t, []archiveMember{
+		{"link", "target", os.ModeSymlink | 0777},
+	})
+	for _, mount := range []struct{ root, dir string }{
+		{archivePath, ""},
+		{filepath.Dir(archivePath), filepath.Base(archivePath)},
+	} {
+		f, err := fs.NewFs(ctx, ":archive:"+mount.root)
+		require.NoError(t, err)
+		_, err = f.List(ctx, "")
+		require.NoError(t, err)
+		entries, err := f.List(ctx, mount.dir)
+		require.NoError(t, err)
+		assert.Empty(t, entries)
+	}
+}
