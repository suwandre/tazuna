+// linksContext returns a context with -l/--links enabled
+func linksContext() context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	return ctx
+}
+
+// readObject returns the contents of the object at remote.
+func readObject(ctx context.Context, t *testing.T, f fs.Fs, remote string, options ...fs.OpenOption) string {
+	o, err := f.NewObject(ctx, remote)
+	require.NoError(t, err)
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	body, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(body)
