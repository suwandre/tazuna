+// zipEntry describes an entry to write into a zip file
+type zipEntry struct {
+	name string      // name of the entry
+	body string      // contents of the entry
+	mode os.FileMode // mode of the entry, 0 for a regular file
+}
+
+// writeZipEntries builds a zip file at path with the given entries.
+func writeZipEntries(t *testing.T, path string, entries []zipEntry) {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		hdr := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+		if entry.mode != 0 {
+			hdr.SetMode(entry.mode | 0777)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(path, buf.Bytes(), 0600))
+}
