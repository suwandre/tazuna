+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	assert.Equal(t, []string{"src/file.txt", "src/plain.rclonelink"}, allRemotes(t, f))
+	_, err = f.NewObject(ctx, "src/link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+}
+
+// Skipping symlinks logs a notice naming the flag which enables them.
+func TestReadZipLinksSkippedNotice(t *testing.T) {
+	var buf bytes.Buffer
+	fs.SetLogger(slog.NewTextHandler(&buf, &slog.HandlerOptions{Level: slog.LevelDebug}))
+	defer fs.SetLogger(log.Handler)
+
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipLinks(t, dir, "links.zip")
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	_, err = New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	assert.Contains(t, buf.String(), "Skipped 1 zip symlinks")
+	assert.Contains(t, buf.String(), "-l/--links")
+}
+
+// A regular member named with the link suffix wins over a symlink
+// which maps onto the same name, whichever order they appear in.
+func TestReadZipLinkNameClash(t *testing.T) {
+	for _, linkFirst := range []bool{true, false} {
+		t.Run(fmt.Sprintf("linkFirst=%v", linkFirst), func(t *testing.T) {
+			ctx := linksContext()
+			dir := t.TempDir()
+			entries := []struct {
+				name string
+				body string
+				link bool
+			}{
+				{"clash", "target", true},
+				{"clash" + fs.LinkSuffix, "regular", false},
+			}
+			if !linkFirst {
+				entries[0], entries[1] = entries[1], entries[0]
+			}
+			var buf bytes.Buffer
+			zw := zip.NewWriter(&buf)
+			for _, entry := range entries {
+				hdr := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+				if entry.link {
+					hdr.SetMode(os.ModeSymlink | 0777)
+				}
+				w, err := zw.CreateHeader(hdr)
+				require.NoError(t, err)
+				_, err = w.Write([]byte(entry.body))
+				require.NoError(t, err)
+			}
+			require.NoError(t, zw.Close())
+			require.NoError(t, os.WriteFile(filepath.Join(dir, "clash.zip"), buf.Bytes(), 0600))
+
+			localFs, err := cache.Get(ctx, dir)
+			require.NoError(t, err)
+			f, err := New(ctx, localFs, "clash.zip", "", "")
+			require.NoError(t, err)
+
+			remotes := allRemotes(t, f)
+			require.Len(t, remotes, 1)
+			assert.Equal(t, "clash"+fs.LinkSuffix, remotes[0])
+			assert.Equal(t, "regular", readObject(ctx, t, f, "clash"+fs.LinkSuffix))
+		})
+	}
+}
+
+// A symlink whose target is too big to be a path is skipped.
+func TestReadZipLinkTargetTooLong(t *testing.T) {
+	ctx := linksContext()
+	dir := t.TempDir()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	hdr := &zip.FileHeader{Name: "big.txt", Method: zip.Deflate}
+	hdr.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(hdr)
+	require.NoError(t, err)
