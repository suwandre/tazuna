+// MaxLinkTargetSize is the largest symlink target an archiver exposes
+// when translating symlinks with -l/--links. It is comfortably above
+// any OS path limit.
+const MaxLinkTargetSize = 128 * 1024
+
+// OpenLink returns a reader for a symlink's contents, which are its
+// target path, trimmed according to offset and limit as if they were
+// the contents of an object. A negative limit means no limit.
+func OpenLink(target string, offset, limit int64) io.ReadCloser {
+	if offset < 0 {
+		offset = 0
+	}
+	if offset > int64(len(target)) {
+		offset = int64(len(target))
+	}
+	return readers.NewLimitedReadCloser(io.NopCloser(strings.NewReader(target[offset:])), limit)
+}
