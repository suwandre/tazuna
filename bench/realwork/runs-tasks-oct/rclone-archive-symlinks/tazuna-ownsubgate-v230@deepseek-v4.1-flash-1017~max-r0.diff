+// TestArchiveSquashfsLinks checks that with -l/--links the archive
+// backend exposes the symlinks in a squashfs image under their
+// suffixed name and copies them back as symlinks on a local
+// destination.
+func TestArchiveSquashfsLinks(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks not applicable on Windows")
+	}
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	sqfsPath, err := filepath.Abs(filepath.Join("squashfs", "testdata", "links.sqfs"))
+	require.NoError(t, err)
+
+	fsrc, err := cache.Get(ctx, ":archive:"+sqfsPath)
+	require.NoError(t, err)
+
+	entries, err := fsrc.List(ctx, "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.Equal(t, []string{"file.txt", "link.txt.rclonelink", "plain.rclonelink"}, remotes)
+
+	// The symlink reads back its target and the regular file ending in
+	// the link suffix keeps its own contents
+	link, err := fsrc.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", fstests.ReadObject(ctx, t, link, -1))
+	plain, err := fsrc.NewObject(ctx, "plain.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "not a link\n", fstests.ReadObject(ctx, t, plain, -1))
+
+	// Copy the tree to a local destination which supports symlinks
+	dstDir := t.TempDir()
+	fdst, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, fdst, fsrc, false))
+
+	dstLink := filepath.Join(dstDir, "link.txt")
+	fi, err := os.Lstat(dstLink)
+	require.NoError(t, err)
+	require.NotZero(t, fi.Mode()&os.ModeSymlink, "expected a symlink at %q", dstLink)
+	target, err := os.Readlink(dstLink)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+	body, err := os.ReadFile(dstLink)
+	require.NoError(t, err)
+	assert.Equal(t, "hello\n", string(body))
+}
