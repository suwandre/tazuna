+// TestArchiveZipHostileLink checks that a symlink in an archive
+// pointing outside the destination plus a member "inside" it can't
+// make a copy write outside the destination.
+func TestArchiveZipHostileLink(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks not applicable on Windows")
+	}
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	// The directory outside the destination the archive wants to write to
+	evil := t.TempDir()
+
+	dir := t.TempDir()
+	zipPath := filepath.Join(dir, "evil.zip")
+	writeZipEntries(t, zipPath, []zipEntry{
+		{"pwn", evil, os.ModeSymlink},
+		{"pwn/authkeys", "PWNED", 0},
+	})
+
+	fsrc, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	fdst, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	// Copy the symlink first, which is reproduced faithfully
+	srcLink, err := fsrc.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, fdst, nil, "pwn"+fs.LinkSuffix, srcLink)
+	require.NoError(t, err)
+	linkPath := filepath.Join(dstDir, "pwn")
+	fi, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	require.NotZero(t, fi.Mode()&os.ModeSymlink, "expected a symlink at %q", linkPath)
+	target, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, evil, target)
+
+	// ...but writing the member "inside" it must be refused
+	srcFile, err := fsrc.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, fdst, nil, "pwn/authkeys", srcFile)
+	require.Error(t, err, "writing through a planted symlink should be refused")
+
+	_, err = os.Stat(filepath.Join(evil, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evil)
+}
