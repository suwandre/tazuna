+// links.sqfs is a squashfs image of a tree containing file.txt
+// ("hello\n"), a symlink link.txt -> file.txt and a regular file
+// plain.rclonelink ("not a link\n").
+//
+// A symlink in a squashfs is only exposed with -l/--links, under its
+// name plus the link suffix, and reads back its target. A regular file
+// which happens to end in the link suffix is left alone.
+func TestSymlinks(t *testing.T) {
+	ctx := linksContext()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	remotes := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.Equal(t, []string{"file.txt", "link.txt.rclonelink", "plain.rclonelink"}, remotes)
+
+	assert.Equal(t, "file.txt", readObject(ctx, t, f, "link.txt.rclonelink"))
+	assert.Equal(t, "not a link\n", readObject(ctx, t, f, "plain.rclonelink"))
+	assert.Equal(t, "hello\n", readObject(ctx, t, f, "file.txt"))
+
+	// Range and seek options apply to the target
+	assert.Equal(t, "ile.", readObject(ctx, t, f, "link.txt.rclonelink", &fs.RangeOption{Start: 1, End: 4}))
+	assert.Equal(t, "le.txt", readObject(ctx, t, f, "link.txt.rclonelink", &fs.SeekOption{Offset: 2}))
+
+	// The name without the suffix must not exist
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+}
