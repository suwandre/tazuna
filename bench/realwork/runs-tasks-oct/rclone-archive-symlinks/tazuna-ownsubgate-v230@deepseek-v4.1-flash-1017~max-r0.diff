+// writeZipLinks builds a zip file containing a regular file, a symlink
+// and a regular file which happens to be named with the link suffix.
+func writeZipLinks(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name string
+		body string
+		mode os.FileMode
+	}{
+		{"src/file.txt", "hello", 0},
+		{"src/link.txt", "file.txt", os.ModeSymlink},
+		{"src/plain.rclonelink", "not a link", 0},
+	} {
+		hdr := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+		if entry.mode != 0 {
+			hdr.SetMode(entry.mode | 0777)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// readObject returns the contents of the object at remote.
+func readObject(ctx context.Context, t *testing.T, f fs.Fs, remote string, options ...fs.OpenOption) string {
+	o, err := f.NewObject(ctx, remote)
+	require.NoError(t, err)
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	body, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(body)
+}
+
+// linksContext returns a context with -l/--links enabled
+func linksContext() context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	return ctx
+}
+
+// A symlink in a zip is only exposed with -l/--links, under its name
+// plus the link suffix, and reads back its target.
+func TestReadZipLinks(t *testing.T) {
+	ctx := linksContext()
+	dir := t.TempDir()
+	name := writeZipLinks(t, dir, "links.zip")
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	// The symlink is listed under its suffixed name, and the regular
+	// file which happens to end in .rclonelink is left alone
+	assert.Equal(t, []string{"src/file.txt", "src/link.txt.rclonelink", "src/plain.rclonelink"}, allRemotes(t, f))
+
+	assert.Equal(t, "file.txt", readObject(ctx, t, f, "src/link.txt.rclonelink"))
+	assert.Equal(t, "not a link", readObject(ctx, t, f, "src/plain.rclonelink"))
+	assert.Equal(t, "hello", readObject(ctx, t, f, "src/file.txt"))
+
+	// Range and seek options apply to the target
+	assert.Equal(t, "ile.", readObject(ctx, t, f, "src/link.txt.rclonelink", &fs.RangeOption{Start: 1, End: 4}))
+	assert.Equal(t, "le.txt", readObject(ctx, t, f, "src/link.txt.rclonelink", &fs.SeekOption{Offset: 2}))
+
+	// The name without the suffix must not exist
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// A root naming the symlink with or without the suffix exposes
+	// the same single object
+	for _, root := range []string{"src/link.txt", "src/link.txt.rclonelink"} {
+		t.Run("root="+root, func(t *testing.T) {
+			f, err := New(ctx, localFs, name, "", root)
+			require.ErrorIs(t, err, fs.ErrorIsFile)
+			entries, err := f.List(ctx, "")
+			require.NoError(t, err)
+			require.Len(t, entries, 1)
+			assert.Equal(t, "link.txt.rclonelink", entries[0].Remote())
+			assert.Equal(t, "file.txt", readObject(ctx, t, f, "link.txt.rclonelink"))
+			_, err = f.NewObject(ctx, "file.txt")
+			assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		})
+	}
+}
