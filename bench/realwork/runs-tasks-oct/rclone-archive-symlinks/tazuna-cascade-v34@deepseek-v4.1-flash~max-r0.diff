+
+		_, err = f.NewObject(ctx, "sublink/file.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound, "links=%v", links)
+		_, err = f.List(ctx, "sublink")
+		assert.Error(t, err, "links=%v", links)
+	}
+}
