+// zipSymlinkEntry describes one entry to put in a test zip file.
+type zipSymlinkEntry struct {
+	name string
+	mode os.FileMode
+	data string
+}
+
+// writeTestZip builds a zip file from the entries in dir and returns
+// its leaf name. A zero mode means a regular file created with
+// zip.Writer.Create.
+func writeTestZip(t *testing.T, dir, name string, entries ...zipSymlinkEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		var w io.Writer
+		if entry.mode == 0 {
+			var err error
+			w, err = zw.Create(entry.name)
+			require.NoError(t, err)
+		} else {
+			header := &zip.FileHeader{Name: entry.name, Method: zip.Store}
+			header.SetMode(entry.mode)
+			var err error
+			w, err = zw.CreateHeader(header)
+			require.NoError(t, err)
+		}
+		_, err := w.Write([]byte(entry.data))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// zipLinksContext returns ctx with -l/--links enabled.
+func zipLinksContext(ctx context.Context) context.Context {
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	return ctx
+}
+
+// readTestObject reads the whole contents of o and returns it.
+func readTestObject(ctx context.Context, t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(contents)
+}
