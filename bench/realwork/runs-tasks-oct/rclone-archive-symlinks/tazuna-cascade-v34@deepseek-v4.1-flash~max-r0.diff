+// Convert a symbolic link entry into an Object from native dir
+func (f *Fs) objectFromSymlink(nativeDir string, item iofs.DirEntry) (*Object, error) {
+	target, err := readLink(item)
+	if err != nil {
+		return nil, err
+	}
+	info, err := item.Info()
+	if err != nil {
+		return nil, err
+	}
+	return &Object{
+		fs:             f,
+		remote:         f.fromNative(nativeDir, item.Name()) + fs.LinkSuffix,
+		size:           int64(len(target)),
+		modTime:        info.ModTime(),
+		translatedLink: true,
+		linkTarget:     target,
+	}, nil
+}
+
+// readLink returns the target of a symbolic link directory entry
+func readLink(item iofs.DirEntry) (string, error) {
+	linker, ok := item.(interface {
+		Readlink() (string, error)
+	})
+	if !ok {
+		return "", fmt.Errorf("symlink entry %q does not support Readlink", item.Name())
+	}
+	return linker.Readlink()
+}
+
+// findItem returns the directory entry called name, or nil if there
+// isn't one.
+func findItem(items []iofs.DirEntry, name string) iofs.DirEntry {
+	for _, item := range items {
+		if item.Name() == name {
+			return item
+		}
+	}
+	return nil
+}
