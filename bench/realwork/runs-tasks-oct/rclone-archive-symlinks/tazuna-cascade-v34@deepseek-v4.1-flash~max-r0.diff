+// archiveSymlinkEntry describes one entry to put in a test archive.
+//
+// A symlink has os.ModeSymlink in mode and its target in data.
+type archiveSymlinkEntry struct {
+	name string
+	data string
+	mode os.FileMode
+}
+
+// writeSymlinkZip writes a zip file at path holding the entries.
+func writeSymlinkZip(t *testing.T, path string, entries ...archiveSymlinkEntry) {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		header := &zip.FileHeader{Name: entry.name, Method: zip.Store}
+		header.SetMode(entry.mode)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.data))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(path, buf.Bytes(), 0600))
+}
+
+// writeSymlinkSquashfs writes a squashfs image at path holding the
+// entries.
+func writeSymlinkSquashfs(t *testing.T, path string, entries ...archiveSymlinkEntry) {
+	out, err := os.Create(path)
+	require.NoError(t, err)
+	sf, err := disksquashfs.Create(filedisk.New(out, false), 0, 0, 4096)
+	require.NoError(t, err)
+	for _, entry := range entries {
+		p := filepath.Join(sf.Workspace(), filepath.FromSlash(entry.name))
+		require.NoError(t, os.MkdirAll(filepath.Dir(p), 0777))
+		if entry.mode&os.ModeSymlink != 0 {
+			require.NoError(t, os.Symlink(entry.data, p))
+		} else {
+			require.NoError(t, os.WriteFile(p, []byte(entry.data), 0644))
+		}
+	}
+	// go-diskfs resolves symlink targets relative to the working
+	// directory when finalizing, so run from inside the workspace
+	t.Chdir(sf.Workspace())
+	require.NoError(t, sf.Finalize(disksquashfs.FinalizeOptions{}))
+	require.NoError(t, out.Close())
+}
+
+// TestArchiveSymlinksCopyWithLinks checks that -l/--links exposes
+// symlinks from the archivers and copying them recreates them on a
+// local destination.
+func TestArchiveSymlinksCopyWithLinks(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	for _, test := range []struct {
+		name  string
+		file  string
+		write func(t *testing.T, path string)
+	}{
+		{
+			name: "zip",
+			file: "test.zip",
+			write: func(t *testing.T, path string) {
+				writeSymlinkZip(t, path,
+					archiveSymlinkEntry{name: "file.txt", data: "hello"},
+					archiveSymlinkEntry{name: "link.txt", mode: os.ModeSymlink | 0777, data: "file.txt"},
+				)
+			},
+		},
+		{
+			name: "squashfs",
+			file: "test.sqfs",
+			write: func(t *testing.T, path string) {
+				writeSymlinkSquashfs(t, path,
+					archiveSymlinkEntry{name: "file.txt", data: "hello"},
+					archiveSymlinkEntry{name: "link.txt", mode: os.ModeSymlink | 0777, data: "file.txt"},
+				)
+			},
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			archivePath := filepath.Join(t.TempDir(), test.file)
+			test.write(t, archivePath)
+
+			fsrc, err := cache.Get(ctx, ":archive:"+archivePath)
+			require.NoError(t, err)
+
+			dstDir := t.TempDir()
+			fdst, err := cache.Get(ctx, dstDir)
+			require.NoError(t, err)
+
+			require.NoError(t, sync.CopyDir(ctx, fdst, fsrc, false))
+
+			contents, err := os.ReadFile(filepath.Join(dstDir, "file.txt"))
+			require.NoError(t, err)
+			assert.Equal(t, "hello", string(contents))
+			target, err := os.Readlink(filepath.Join(dstDir, "link.txt"))
+			require.NoError(t, err)
+			assert.Equal(t, "file.txt", target)
+		})
+	}
+}
+
+// TestArchiveSymlinksCopyEscapeBlocked checks that a hostile archive
+// cannot make a copy with -l/--links write outside the destination: a
+// symlink pointing at an outside directory plus a member "inside" it
+// must not be transferred.
+func TestArchiveSymlinksCopyEscapeBlocked(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	evil := t.TempDir()
+	archivePath := filepath.Join(t.TempDir(), "evil.zip")
+	writeSymlinkZip(t, archivePath,
+		archiveSymlinkEntry{name: "link", mode: os.ModeSymlink | 0777, data: evil},
+		archiveSymlinkEntry{name: "link/pwn.txt", data: "pwned"},
+	)
+
+	fsrc, err := cache.Get(ctx, ":archive:"+archivePath)
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	fdst, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	require.NoError(t, sync.CopyDir(ctx, fdst, fsrc, false))
+
+	// The symlink is recreated faithfully...
+	target, err := os.Readlink(filepath.Join(dstDir, "link"))
+	require.NoError(t, err)
+	assert.Equal(t, evil, target)
+
+	// ...but nothing is written through it.
+	_, err = os.Stat(filepath.Join(evil, "pwn.txt"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evil)
+}
