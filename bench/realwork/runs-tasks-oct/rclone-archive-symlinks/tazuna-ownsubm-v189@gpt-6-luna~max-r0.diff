+func TestArchiveSymlinkEscapeBlocked(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks are not applicable on Windows")
+	}
+	fstest.Initialise()
+	parent := t.TempDir()
+	destination := filepath.Join(parent, "destination")
+	outside := filepath.Join(parent, "outside")
+	require.NoError(t, os.Mkdir(outside, 0700))
+	outsideFile := filepath.Join(outside, "authkeys")
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	linkHeader := &zip.FileHeader{Name: "src/pwn"}
+	linkHeader.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = io.WriteString(w, "../../outside")
+	require.NoError(t, err)
+	w, err = zw.Create("src/pwn/authkeys")
+	require.NoError(t, err)
+	_, err = io.WriteString(w, "PWNED")
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(parent, "hostile.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	fsrc, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	fdst, err := cache.Get(ctx, destination)
+	require.NoError(t, err)
+	copyErr := rclonesync.CopyDir(ctx, fdst, fsrc, false)
+	require.Error(t, copyErr, "writing through a symlink that escapes the destination should fail")
+	link := filepath.Join(destination, "src", "pwn")
+	info, err := os.Lstat(link)
+	require.NoError(t, err)
+	require.True(t, info.Mode()&os.ModeSymlink != 0, "archive symlink should be copied faithfully")
+	target, err := os.Readlink(link)
+	require.NoError(t, err)
+	require.Equal(t, "../../outside", target)
+
+	_, err = os.Stat(outsideFile)
+	assert.True(t, os.IsNotExist(err), "copy escaped the destination into %q", outsideFile)
+}
