+func TestArchiveCopyLinks(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks are not applicable on Windows")
+	}
+	fstest.Initialise()
+	parent := t.TempDir()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("src/file.txt")
+	require.NoError(t, err)
+	_, err = io.WriteString(w, "file contents")
+	require.NoError(t, err)
+	linkHeader := &zip.FileHeader{Name: "src/link.txt"}
+	linkHeader.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = io.WriteString(w, "file.txt")
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(parent, "links.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	fsrc, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	destination := filepath.Join(parent, "destination")
+	fdst, err := cache.Get(ctx, destination)
+	require.NoError(t, err)
+	require.NoError(t, rclonesync.CopyDir(ctx, fdst, fsrc, false))
+
+	link := filepath.Join(destination, "src", "link.txt")
+	info, err := os.Lstat(link)
+	require.NoError(t, err)
+	assert.True(t, info.Mode()&os.ModeSymlink != 0)
+	target, err := os.Readlink(link)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+	contents, err := os.ReadFile(filepath.Join(destination, "src", "file.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file contents", string(contents))
+}
