+		require.NoError(t, err)
+		entries, err := f.List(linksCtx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.Contains(t, remotes, "link.txt.rclonelink")
+		assert.Contains(t, remotes, "ordinary.rclonelink")
+		assert.NotContains(t, remotes, "link.txt")
+
+		_, err = f.NewObject(linksCtx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		link, err := f.NewObject(linksCtx, "link.txt.rclonelink")
