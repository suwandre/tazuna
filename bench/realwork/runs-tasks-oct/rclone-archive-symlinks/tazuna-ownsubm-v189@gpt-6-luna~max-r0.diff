+		for _, test := range []struct {
+			options []fs.OpenOption
+			want    string
+		}{
+			{want: "file.txt"},
+			{options: []fs.OpenOption{&fs.SeekOption{Offset: 2}}, want: "le.txt"},
+			{options: []fs.OpenOption{&fs.RangeOption{Start: 1, End: 3}}, want: "ile"},
+		} {
+			rc, err := link.Open(linksCtx, test.options...)
