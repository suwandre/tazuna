+func TestArchiveSquashfsSymlinks(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoExe(t, "mksquashfs")
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("symlinks are unavailable: %v", err)
+	}
+	ctx := context.Background()
+	input := filepath.Join(t.TempDir(), "input")
+	require.NoError(t, os.Mkdir(input, 0700))
+	srcDir := filepath.Join(input, "src")
+	require.NoError(t, os.Mkdir(srcDir, 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(srcDir, "file.txt"), []byte("file contents"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(srcDir, "existing.rclonelink"), []byte("ordinary file"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(srcDir, "link.txt")))
+
+	archiveDir := t.TempDir()
+	archiveName := "links.sqfs"
+	archivePath := filepath.Join(archiveDir, archiveName)
+	run(t, "mksquashfs", input, archivePath)
+	localFs, err := cache.Get(ctx, archiveDir)
+	require.NoError(t, err)
+
+	t.Run("skipped_without_links", func(t *testing.T) {
+		f, err := archivesquashfs.New(ctx, localFs, archiveName, "", "")
+		require.NoError(t, err)
+		entries, err := f.List(ctx, "src")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.ElementsMatch(t, []string{"src/file.txt", "src/existing.rclonelink"}, remotes)
+		_, err = f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("translated_with_links", func(t *testing.T) {
+		linksCtx, ci := fs.AddConfig(ctx)
+		ci.Links = true
+		f, err := archivesquashfs.New(linksCtx, localFs, archiveName, "", "")
+		require.NoError(t, err)
+
+		entries, err := f.List(linksCtx, "src")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		assert.ElementsMatch(t, []string{
+			"src/file.txt",
+			"src/link.txt" + fs.LinkSuffix,
+			"src/existing.rclonelink",
+		}, remotes)
+
+		link, err := f.NewObject(linksCtx, "src/link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), link.Size())
+		assert.Equal(t, "file.txt", readArchiveObject(t, linksCtx, link))
+		assert.Equal(t, "le.txt", readArchiveObject(t, linksCtx, link, &fs.SeekOption{Offset: 2}))
+		assert.Equal(t, "ile", readArchiveObject(t, linksCtx, link, &fs.RangeOption{Start: 1, End: 3}))
+		_, err = f.NewObject(linksCtx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		regular, err := f.NewObject(linksCtx, "src/existing.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "ordinary file", readArchiveObject(t, linksCtx, regular))
+
+		single, err := archivesquashfs.New(linksCtx, localFs, archiveName, "", "src/link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorIsFile)
+		require.NotNil(t, single)
+		singleEntries, err := single.List(linksCtx, "")
+		require.NoError(t, err)
+		require.Len(t, singleEntries, 1)
+		assert.Equal(t, "link.txt"+fs.LinkSuffix, singleEntries[0].Remote())
+
+		destination := t.TempDir()
+		dst, err := cache.Get(linksCtx, destination)
+		require.NoError(t, err)
+		require.NoError(t, sync.CopyDir(linksCtx, dst, f, false))
+		linkPath := filepath.Join(destination, "src", "link.txt")
+		info, err := os.Lstat(linkPath)
+		require.NoError(t, err)
+		assert.NotZero(t, info.Mode()&os.ModeSymlink)
+		target, err := os.Readlink(linkPath)
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", target)
+	})
+}
+
+func readArchiveObject(t *testing.T, ctx context.Context, o fs.Object, options ...fs.OpenOption) string {
+	t.Helper()
+	r, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	defer func() { require.NoError(t, r.Close()) }()
+	contents, err := io.ReadAll(r)
+	require.NoError(t, err)
+	return string(contents)
+}
+
+func TestArchiveZipSymlinkCopy(t *testing.T) {
+	fstest.Initialise()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("symlinks are unavailable: %v", err)
+	}
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	archiveDir := t.TempDir()
+	archivePath := filepath.Join(archiveDir, "links.zip")
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("src/file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file contents"))
+	require.NoError(t, err)
+	header := &zip.FileHeader{Name: "src/link.txt"}
+	header.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(archivePath, buf.Bytes(), 0600))
+
+	destination := t.TempDir()
+	src, err := cache.Get(ctx, ":archive:"+archivePath)
+	require.NoError(t, err)
+	dst, err := cache.Get(ctx, destination)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, dst, src, false))
+
+	linkPath := filepath.Join(destination, "src", "link.txt")
+	info, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	assert.NotZero(t, info.Mode()&os.ModeSymlink)
+	target, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+func TestArchiveZipSymlinkEscapeBlocked(t *testing.T) {
+	fstest.Initialise()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("symlinks are unavailable: %v", err)
+	}
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	archiveDir := t.TempDir()
+	archivePath := filepath.Join(archiveDir, "hostile.zip")
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	header := &zip.FileHeader{Name: "src/escape"}
+	header.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("../../outside"))
+	require.NoError(t, err)
+	w, err = zw.Create("src/escape/pwn.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("attacker data"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(archivePath, buf.Bytes(), 0600))
+
+	destinationParent := t.TempDir()
+	destination := filepath.Join(destinationParent, "out")
+	require.NoError(t, os.Mkdir(destination, 0700))
+	outside := filepath.Join(destinationParent, "outside")
+	require.NoError(t, os.Mkdir(outside, 0700))
+	outsideFile := filepath.Join(outside, "pwn.txt")
+	require.NoError(t, os.WriteFile(outsideFile, []byte("sentinel"), 0600))
+
+	src, err := cache.Get(ctx, ":archive:"+archivePath)
+	require.NoError(t, err)
+	dst, err := cache.Get(ctx, destination)
+	require.NoError(t, err)
+	if err := sync.CopyDir(ctx, dst, src, false); err != nil {
+		t.Logf("copy reported an error: %v", err)
+	}
+	escapePath := filepath.Join(destination, "src", "escape")
+	escapeInfo, err := os.Lstat(escapePath)
+	require.NoError(t, err)
+	assert.True(t, escapeInfo.IsDir() || escapeInfo.Mode()&os.ModeSymlink != 0)
+
+	contents, err := os.ReadFile(outsideFile)
+	require.NoError(t, err)
+	assert.Equal(t, "sentinel", string(contents))
+}
