+	ci.Links = true
+
+	dir := t.TempDir()
+	name := writeZipSymlink(t, dir, "links.zip", "note"+fs.LinkSuffix, "sub/link", "../file.txt")
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	assert.Equal(t, []string{"note" + fs.LinkSuffix, "sub/link" + fs.LinkSuffix}, allRemotes(t, f))
+
+	o, err := f.NewObject(ctx, "note"+fs.LinkSuffix)
+	require.NoError(t, err)
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "data for note"+fs.LinkSuffix, string(contents))
+
+	o, err = f.NewObject(ctx, "sub/link"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("../file.txt")), o.Size())
+	rc, err = o.Open(ctx)
