+// makeLinksImage writes a squashfs image containing symlinks and returns
+// the directory it was written to
+func makeLinksImage(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	out, err := os.Create(filepath.Join(dir, "links.sqfs"))
+	require.NoError(t, err)
+	fsys, err := squashfs.Create(file.New(out, false), 0, 0, 0)
+	require.NoError(t, err)
+
+	// Symlinks are made directly in the workspace as go-diskfs has no
+	// way to create them through its API
+	ws := fsys.Workspace()
+	require.NoError(t, os.Mkdir(filepath.Join(ws, "src"), 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(ws, "src", "file.txt"), []byte("hello"), 0o644))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(ws, "src", "link.txt")))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(ws, "src", "dup")))
+	require.NoError(t, os.WriteFile(filepath.Join(ws, "src", "dup.rclonelink"), []byte("regular"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(ws, "a.rclonelink"), []byte("regular"), 0o644))
+	// evil points outside the image at a real directory so following it
+	// would succeed. Relative targets outside the workspace such as "../.."
+	// make the Finalize xattr walk fail on macOS, so use an absolute path.
+	outside := t.TempDir()
+	require.NoError(t, os.Mkdir(filepath.Join(outside, "src"), 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(outside, "src", "file.txt"), []byte("outside"), 0o644))
+	require.NoError(t, os.Symlink(filepath.Join(outside, "src"), filepath.Join(ws, "evil")))
+	require.NoError(t, os.Symlink("src", filepath.Join(ws, "sub")))
+
+	// Finalize reads symlink targets and xattrs relative to the current
+	// directory rather than the workspace, so it must run inside it
+	wd, err := os.Getwd()
+	require.NoError(t, err)
+	require.NoError(t, os.Chdir(ws))
+	err = fsys.Finalize(squashfs.FinalizeOptions{})
+	require.NoError(t, os.Chdir(wd))
+	require.NoError(t, err)
+	require.NoError(t, fsys.Close())
+	require.NoError(t, out.Close())
+	return dir
+}
+
+// newLinksFs returns an Fs over makeLinksImage with -l/--links set to links
+func newLinksFs(t *testing.T, links bool) (context.Context, fs.Fs) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = links
+	localFs, err := fscache.Get(ctx, makeLinksImage(t))
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	return ctx, f
+}
+
+// entryRemotes returns the remotes of entries
+func entryRemotes(entries fs.DirEntries) []string {
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	return remotes
+}
+
+func TestSymlinksOff(t *testing.T) {
+	ctx, f := newLinksFs(t, false)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	assert.ElementsMatch(t, []string{"a.rclonelink", "src"}, entryRemotes(entries))
+
+	entries, err = f.List(ctx, "src")
+	require.NoError(t, err)
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/dup.rclonelink"}, entryRemotes(entries))
+
+	for _, remote := range []string{"src/link.txt", "src/link.txt.rclonelink", "src/dup", "evil.rclonelink", "sub/file.txt", "evil/src/file.txt"} {
+		_, err := f.NewObject(ctx, remote)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+	}
+
+	o, err := f.NewObject(ctx, "a.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(7), o.Size())
+}
+
+func TestSymlinksOn(t *testing.T) {
+	ctx, f := newLinksFs(t, true)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	assert.ElementsMatch(t, []string{"a.rclonelink", "evil.rclonelink", "src", "sub.rclonelink"}, entryRemotes(entries))
+
+	entries, err = f.List(ctx, "src")
+	require.NoError(t, err)
+	// src/dup is hidden by the regular file src/dup.rclonelink
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/link.txt.rclonelink", "src/dup.rclonelink"}, entryRemotes(entries))
+
+	// NewObject must agree with List for every listed file
+	for _, dir := range []string{"", "src"} {
+		entries, err := f.List(ctx, dir)
+		require.NoError(t, err)
+		for _, entry := range entries {
+			if _, ok := entry.(fs.Directory); ok {
+				continue
+			}
+			o, err := f.NewObject(ctx, entry.Remote())
+			require.NoError(t, err, entry.Remote())
+			assert.Equal(t, entry.Size(), o.Size(), entry.Remote())
+		}
+	}
+
+	o, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "src/link.txt.rclonelink", o.Remote())
+	assert.Equal(t, int64(8), o.Size())
+
+	read := func(options ...fs.OpenOption) string {
+		rc, err := o.Open(ctx, options...)
+		require.NoError(t, err)
+		defer func() { require.NoError(t, rc.Close()) }()
+		buf, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		return string(buf)
+	}
+	assert.Equal(t, "file.txt", read())
+	assert.Equal(t, "ile", read(&fs.RangeOption{Start: 1, End: 3}))
+	assert.Equal(t, ".txt", read(&fs.SeekOption{Offset: 4}))
+
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = f.NewObject(ctx, "src/dup")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	o, err = f.NewObject(ctx, "src/dup.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(7), o.Size())
+
+	// Lookups must not follow symlinks into the archive
+	for _, remote := range []string{"evil/src/file.txt", "sub/file.txt", "sub/link.txt.rclonelink"} {
+		_, err := f.NewObject(ctx, remote)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+	}
+	_, err = f.List(ctx, "evil")
+	assert.Error(t, err)
+	_, err = f.List(ctx, "sub")
+	assert.Error(t, err)
+
+	// A regular file is found in both modes
+	o, err = f.NewObject(ctx, "a.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(7), o.Size())
+}
+
+func TestSymlinkRoot(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	localFs, err := fscache.Get(ctx, makeLinksImage(t))
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, "links.sqfs", "", "src/link.txt.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	// Remotes are relative to the directory the root file is in
+	assert.Equal(t, []string{"link.txt.rclonelink"}, entryRemotes(entries))
+}
