 		assert.Equal(t, test.want, isDirectChild(test.dir, test.remote), "dir=%q remote=%q", test.dir, test.remote)
 	}
 }
+
+// zipMember is an entry for writeZipMembers. The content of a symlink
+// is its target.
+type zipMember struct {
+	name    string
+	content string
+	symlink bool
+}
+
+// writeZipMembers builds a zip file at zipPath with the given members
+// and returns zipPath.
+func writeZipMembers(t *testing.T, zipPath string, members ...zipMember) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, m := range members {
+		hdr := &zip.FileHeader{Name: m.name, Method: zip.Deflate}
+		if m.symlink {
+			hdr.SetMode(os.ModeSymlink | 0777)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(m.content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+	return zipPath
+}
+
+// copyArchive copies the contents of the zip file zipPath into the
+// directory out with -l/--links set to links
+func copyArchive(t *testing.T, links bool, zipPath, out string) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = links
+	require.NoError(t, os.MkdirAll(out, 0777))
+	fsrc, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	fdst, err := cache.Get(ctx, out)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, fdst, fsrc, false))
+}
+
+// TestArchiveSymlinks checks that with -l/--links the symlinks in a zip
+// file are copied out as symlinks, and that nothing is written outside
+// the destination through a symlink in the archive.
+func TestArchiveSymlinks(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks not supported on windows")
+	}
+	fstest.Initialise()
+
+	t.Run("Links", func(t *testing.T) {
+		base := t.TempDir()
+		zipPath := writeZipMembers(t, filepath.Join(base, "links.zip"),
+			zipMember{name: "src/file.txt", content: "data"},
+			zipMember{name: "src/link.txt", content: "file.txt", symlink: true},
+		)
+		out := filepath.Join(base, "out")
+		copyArchive(t, true, zipPath, out)
+
+		target, err := os.Readlink(filepath.Join(out, "src", "link.txt"))
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", target)
+		data, err := os.ReadFile(filepath.Join(out, "src", "file.txt"))
+		require.NoError(t, err)
+		assert.Equal(t, "data", string(data))
+	})
+
+	t.Run("Escape", func(t *testing.T) {
+		for _, links := range []bool{false, true} {
+			t.Run(fmt.Sprintf("links=%v", links), func(t *testing.T) {
+				base := t.TempDir()
+				zipPath := writeZipMembers(t, filepath.Join(base, "evil.zip"),
+					zipMember{name: "good.txt", content: "good"},
+					zipMember{name: "evil", content: "../../..", symlink: true},
+					zipMember{name: "evil/"},
+					zipMember{name: "evil/x", content: "pwned"},
+				)
+				// "../../.." from out is base, so evil/x would land in base/x
+				out := filepath.Join(base, "a", "b", "out")
+				copyArchive(t, links, zipPath, out)
+
+				_, err := os.Lstat(filepath.Join(base, "x"))
+				assert.True(t, os.IsNotExist(err), "file written outside destination")
+				data, err := os.ReadFile(filepath.Join(out, "good.txt"))
+				require.NoError(t, err)
+				assert.Equal(t, "good", string(data))
+			})
+		}
+	})
+}
