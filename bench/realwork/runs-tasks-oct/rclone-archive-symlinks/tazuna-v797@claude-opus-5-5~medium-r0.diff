+// underLink reports whether remote is inside one of the symlinks in
+// linkPaths or, if isDir, is one of them
+func underLink(linkPaths map[string]bool, remote string, isDir bool) bool {
+	for p := path.Dir(remote); p != "."; p = path.Dir(p) {
+		if linkPaths[p] {
+			return true
+		}
+	}
+	return isDir && linkPaths[remote]
+}
