+// Symlink members are listed with fs.LinkSuffix only when links are
+// enabled, and nothing inside a symlink is ever exposed.
+func TestReadZipSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "links.zip",
+		zipEntry{name: "src/file.txt", content: "data"},
+		zipEntry{name: "src/link.txt", content: "file.txt", symlink: true},
+		// A regular file takes precedence over a symlink with the same suffixed name
+		zipEntry{name: "src/dup", content: "file.txt", symlink: true},
+		zipEntry{name: "src/dup.rclonelink", content: "regular"},
+		zipEntry{name: "a.rclonelink", content: "regular"},
+		zipEntry{name: "evil", content: "../..", symlink: true},
+		zipEntry{name: "evil/", content: ""},
+		zipEntry{name: "evil/x", content: "pwned"},
+	)
+
+	localFs, err := cache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	for _, test := range []struct {
+		links bool
+		want  []string
+	}{
+		{false, []string{"a.rclonelink", "src/dup.rclonelink", "src/file.txt"}},
+		{true, []string{"a.rclonelink", "evil.rclonelink", "src/dup.rclonelink", "src/file.txt", "src/link.txt.rclonelink"}},
+	} {
+		t.Run(fmt.Sprintf("links=%v", test.links), func(t *testing.T) {
+			ctx, ci := fs.AddConfig(context.Background())
+			ci.Links = test.links
+			f, err := New(ctx, localFs, name, "", "")
+			require.NoError(t, err)
+			assert.Equal(t, test.want, allRemotes(t, f))
+
+			// The symlink's name is only found with the suffix
+			_, err = f.NewObject(ctx, "src/link.txt")
