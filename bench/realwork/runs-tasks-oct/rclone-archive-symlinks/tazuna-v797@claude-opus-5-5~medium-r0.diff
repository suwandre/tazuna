+			// Nothing inside the symlink "evil" is exposed
+			_, err = f.List(ctx, "evil")
+			assert.Equal(t, fs.ErrorDirNotFound, err)
+			_, err = f.NewObject(ctx, "evil/x")
+			assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		})
+	}
