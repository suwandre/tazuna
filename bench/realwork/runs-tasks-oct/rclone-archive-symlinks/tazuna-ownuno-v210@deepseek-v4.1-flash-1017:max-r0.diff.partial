+// Convert a symlink FileInfo into a translated link Object from native dir
+func (f *Fs) linkObjectFromFileInfo(nativeDir string, item os.FileInfo) (*Object, error) {
+	linker, ok := item.(interface{ Readlink() (string, error) })
+	if !ok {
+		return nil, fmt.Errorf("symbolic link %q has no target", item.Name())
+	}
+	target, err := linker.Readlink()
+	if err != nil {
+		return nil, err
+	}
+	return &Object{
+		fs:         f,
+		remote:     f.fromNative(nativeDir, item.Name()) + fs.LinkSuffix,
+		size:       int64(len(target)),
+		modTime:    item.ModTime(),
+		link:       true,
+		linkTarget: target,
+	}, nil
+}
