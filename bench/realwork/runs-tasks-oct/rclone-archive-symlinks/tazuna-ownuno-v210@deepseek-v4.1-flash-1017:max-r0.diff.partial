diff --git a/backend/archive/squashfs/symlink_internal_test.go b/backend/archive/squashfs/symlink_internal_test.go
new file mode 100644
index 0000000..b6ab6c5
--- /dev/null
+++ b/backend/archive/squashfs/symlink_internal_test.go
@@ -0,0 +1,169 @@
+package squashfs
+
+import (
+	"context"
+	"io"
+	"log/slog"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+
+	_ "github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
+	fscache "github.com/rclone/rclone/fs/cache"
+	fslog "github.com/rclone/rclone/fs/log"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// objectRemotes lists the Object remotes in dir, sorted.
+func objectRemotes(t *testing.T, f fs.Fs, dir string) []string {
+	entries, err := f.List(context.Background(), dir)
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		if _, ok := entry.(fs.Object); ok {
+			remotes = append(remotes, entry.Remote())
+		}
+	}
+	sort.Strings(remotes)
+	return remotes
+}
+
+// readObject returns the contents of o.
+func readObject(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	defer func() { require.NoError(t, rc.Close()) }()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(data)
+}
+
+// newTestFs mounts the symlinks test image, using ctx as the mount context.
+func newTestFs(t *testing.T, ctx context.Context) fs.Fs {
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, "symlinks.sqfs", "", "")
+	require.NoError(t, err)
+	return f
+}
+
+// Symlinks are skipped unless -l/--links is in use, in which case they
+// are exposed under their name plus the link suffix and open to their
+// target.
+func TestSymlinks(t *testing.T) {
+	baseCtx := context.Background()
+
+	t.Run("NoLinks", func(t *testing.T) {
+		f := newTestFs(t, baseCtx)
+
+		assert.Equal(t, []string{"file.txt", "plain.rclonelink"}, objectRemotes(t, f, ""))
+		assert.Equal(t, []string{"sub/file.txt"}, objectRemotes(t, f, "sub"))
+
+		_, err := f.NewObject(baseCtx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(baseCtx, "link.txt.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(baseCtx, "sub/link2.txt.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// A regular member ending in the link suffix is still a regular file
+		o, err := f.NewObject(baseCtx, "plain.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("plain")), o.Size())
+		assert.Equal(t, "plain", readObject(t, o))
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(baseCtx)
+		ci.Links = true
+		f := newTestFs(t, ctx)
+
+		assert.Equal(t, []string{"file.txt", "link.txt.rclonelink", "plain.rclonelink"}, objectRemotes(t, f, ""))
+		assert.Equal(t, []string{"sub/file.txt", "sub/link2.txt.rclonelink"}, objectRemotes(t, f, "sub"))
+
+		// A symlink is only exposed with the suffix
+		_, err := f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		o, err := f.NewObject(ctx, "link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(t, o))
+
+		// Seek and range options apply to the target
+		assert.Equal(t, "txt", readObject(t, o, &fs.SeekOption{Offset: 5}))
+		assert.Equal(t, "ile", readObject(t, o, &fs.RangeOption{Start: 1, End: 3}))
+
+		o, err = f.NewObject(ctx, "sub/link2.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "../file.txt", readObject(t, o))
+
+		// A regular member ending in the link suffix is still a regular file
+		o, err = f.NewObject(ctx, "plain.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("plain")), o.Size())
+		assert.Equal(t, "plain", readObject(t, o))
+
+		// Listing and NewObject must agree on which names exist
+		for _, dir := range []string{"", "sub"} {
+			for _, remote := range objectRemotes(t, f, dir) {
+				_, err := f.NewObject(ctx, remote)
+				assert.NoError(t, err, remote)
+			}
+		}
+	})
+}
+
+// A root which points at a translated symlink exposes just that symlink.
+func TestSymlinkRoot(t *testing.T) {
+	baseCtx := context.Background()
+	ctx, ci := fs.AddConfig(baseCtx)
+	ci.Links = true
+
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, "symlinks.sqfs", "", "link.txt.rclonelink")
+	require.Equal(t, fs.ErrorIsFile, err)
+	require.NotNil(t, f)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt.rclonelink", entries[0].Remote())
+
+	o, err := f.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", readObject(t, o))
+}
+
+// captureLogs runs fn and returns the log output it produced.
+func captureLogs(fn func()) string {
+	var mu sync.Mutex
+	var sb strings.Builder
+	fslog.Handler.SetOutput(func(level slog.Level, text string) {
+		mu.Lock()
+		defer mu.Unlock()
+		sb.WriteString(text)
+		sb.WriteString("\n")
+	})
+	defer fslog.Handler.ResetOutput()
+	fn()
+	mu.Lock()
+	defer mu.Unlock()
+	return sb.String()
+}
+
+// Skipping symlinks must tell the user which flag exposes them.
+func TestSymlinkSkippedNotice(t *testing.T) {
+	ctx := context.Background()
+	logs := captureLogs(func() {
+		f := newTestFs(t, ctx)
+		_, err := f.List(ctx, "")
+		require.NoError(t, err)
+	})
+	assert.Contains(t, logs, "Skipped 1 symbolic links")
+	assert.Contains(t, logs, "--links")
+}
