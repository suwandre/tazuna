+
+// writeSymlink adds a symlink entry called name with the given target
+// to zw.
+func writeSymlink(t *testing.T, zw *zip.Writer, name, target string) {
+	h := &zip.FileHeader{Name: name, Method: zip.Store}
+	h.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(h)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(target))
+	require.NoError(t, err)
+}
+
+// writeZipWithSymlinks builds a zip file with the given entries in dir
+// and returns its leaf name.
+func writeZipWithSymlinks(t *testing.T, dir, name string, entries func(*zip.Writer)) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	entries(zw)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// objectRemotes lists the Object remotes in dir, sorted.
+func objectRemotes(t *testing.T, f fs.Fs, dir string) []string {
+	entries, err := f.List(context.Background(), dir)
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		if _, ok := entry.(fs.Object); ok {
+			remotes = append(remotes, entry.Remote())
+		}
+	}
+	sort.Strings(remotes)
+	return remotes
+}
+
+// readObject returns the contents of o.
+func readObject(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	defer func() { require.NoError(t, rc.Close()) }()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(data)
+}
+
+// Symlinks are skipped unless -l/--links is in use, in which case they
+// are exposed under their name plus the link suffix and open to their
+// target.
+func TestSymlinks(t *testing.T) {
+	baseCtx := context.Background()
+	dir := t.TempDir()
+	name := writeZipWithSymlinks(t, dir, "links.zip", func(zw *zip.Writer) {
+		w, err := zw.Create("src/file.txt")
+		require.NoError(t, err)
+		_, err = w.Write([]byte("hello"))
+		require.NoError(t, err)
+		writeSymlink(t, zw, "src/link.txt", "file.txt")
+		w, err = zw.Create("src/plain.rclonelink")
+		require.NoError(t, err)
+		_, err = w.Write([]byte("plain"))
+		require.NoError(t, err)
+	})
+
+	localFs, err := cache.Get(baseCtx, dir)
+	require.NoError(t, err)
+
+	t.Run("NoLinks", func(t *testing.T) {
+		f, err := New(baseCtx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		assert.Equal(t, []string{"src/file.txt", "src/plain.rclonelink"}, objectRemotes(t, f, "src"))
+
+		_, err = f.NewObject(baseCtx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(baseCtx, "src/link.txt.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// A regular member ending in the link suffix is still a regular file
+		o, err := f.NewObject(baseCtx, "src/plain.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("plain")), o.Size())
+		assert.Equal(t, "plain", readObject(t, o))
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(baseCtx)
+		ci.Links = true
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		assert.Equal(t, []string{"src/file.txt", "src/link.txt.rclonelink", "src/plain.rclonelink"}, objectRemotes(t, f, "src"))
+
+		// A symlink is only exposed with the suffix
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		o, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(t, o))
+
+		// Seek and range options apply to the target
+		assert.Equal(t, "txt", readObject(t, o, &fs.SeekOption{Offset: 5}))
+		assert.Equal(t, "ile", readObject(t, o, &fs.RangeOption{Start: 1, End: 3}))
+
+		// A regular member ending in the link suffix is still a regular file
+		o, err = f.NewObject(ctx, "src/plain.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("plain")), o.Size())
+		assert.Equal(t, "plain", readObject(t, o))
+	})
+}
+
+// captureLogs runs fn and returns the log output it produced.
