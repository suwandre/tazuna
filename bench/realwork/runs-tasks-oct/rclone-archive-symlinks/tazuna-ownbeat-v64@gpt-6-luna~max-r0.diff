+	link, err = single.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, target, readObject(t, link))
+}
+
+func skipIfNoSymlinkSupport(t *testing.T) {
+	t.Helper()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("symlinks are unavailable: %v", err)
+	}
+}
+
+func TestSymlinkCannotEscapeCopyRoot(t *testing.T) {
+	skipIfNoSymlinkSupport(t)
+	outside := t.TempDir()
+	outsideFile := filepath.Join(outside, "owned")
+	archiveDir := t.TempDir()
+	archivePath := filepath.Join(archiveDir, "hostile.zip")
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	header := &zip.FileHeader{Name: "src/link"}
+	header.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(outside))
+	require.NoError(t, err)
+	w, err = zw.Create("src/link/owned")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("outside write"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(archivePath, buf.Bytes(), 0600))
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	localFs, err := cache.Get(ctx, archiveDir)
+	require.NoError(t, err)
+	source, err := New(ctx, localFs, "hostile.zip", "", "")
+	require.NoError(t, err)
+	destinationDir := t.TempDir()
+	destination, err := cache.Get(ctx, destinationDir)
+	require.NoError(t, err)
+
+	_ = syncfs.CopyDir(ctx, destination, source, false)
+	linkPath := filepath.Join(destinationDir, "src", "link")
+	linkInfo, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	require.NotZero(t, linkInfo.Mode()&os.ModeSymlink, "archive link should be recreated as a symlink")
+	linkTarget, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, outside, linkTarget)
+	_, err = os.Stat(outsideFile)
+	assert.True(t, os.IsNotExist(err), "archive member escaped the destination into %q", outsideFile)
+}
+
+func entryRemotes(entries fs.DirEntries) []string {
+	remotes := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	sort.Strings(remotes)
+	return remotes
+}
