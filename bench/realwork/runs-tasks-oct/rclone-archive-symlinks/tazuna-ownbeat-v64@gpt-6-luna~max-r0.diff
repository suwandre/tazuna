+
+func TestSymlinks(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs is required to create a squashfs symlink test image")
+	}
+
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("file contents"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt.rclonelink"), []byte("ordinary file"), 0600))
+	if err := os.Symlink("file.txt", filepath.Join(input, "link.txt")); err != nil {
+		t.Skipf("symlinks are unavailable: %v", err)
+	}
+	image := filepath.Join(t.TempDir(), "symlinks.sqfs")
+	if output, err := exec.Command(mksquashfs, input, image).CombinedOutput(); err != nil {
+		t.Fatalf("mksquashfs failed: %v\n%s", err, output)
+	}
+
+	ctx, ci := fs.AddConfig(context.Background())
+	localFs, err := fscache.Get(ctx, filepath.Dir(image))
+	require.NoError(t, err)
+	withoutLinks, err := New(ctx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err := withoutLinks.List(ctx, "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"file.txt", "file.txt.rclonelink"}, squashfsEntryRemotes(entries))
+	_, err = withoutLinks.NewObject(ctx, "link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ci.Links = true
+	withLinks, err := New(ctx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(ctx, "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"file.txt", "file.txt.rclonelink", "link.txt.rclonelink"}, squashfsEntryRemotes(entries))
+
+	link, err := withLinks.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	assert.Equal(t, "file.txt", readSquashfsObject(t, link))
+	assert.Equal(t, "le.t", readSquashfsObject(t, link, &fs.RangeOption{Start: 2, End: 5}))
+	assert.Equal(t, "e.txt", readSquashfsObject(t, link, &fs.SeekOption{Offset: 3}))
+
+	regular, err := withLinks.NewObject(ctx, "file.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "ordinary file", readSquashfsObject(t, regular))
+	_, err = withLinks.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	single, err := New(ctx, localFs, filepath.Base(image), "", "link.txt.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = single.List(ctx, "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"link.txt.rclonelink"}, squashfsEntryRemotes(entries))
+	link, err = single.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", readSquashfsObject(t, link))
+}
+
+func squashfsEntryRemotes(entries fs.DirEntries) []string {
+	remotes := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	sort.Strings(remotes)
+	return remotes
+}
+
+func readSquashfsObject(t *testing.T, obj fs.Object, options ...fs.OpenOption) string {
+	t.Helper()
+	rc, err := obj.Open(context.Background(), options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
