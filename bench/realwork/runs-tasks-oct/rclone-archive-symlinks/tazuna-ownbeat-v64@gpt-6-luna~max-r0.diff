+func writeSymlinkZip(t *testing.T, dir, name, symlink, target string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for file, data := range map[string]string{
+		"src/file.txt":            "file contents",
+		"src/file.txt.rclonelink": "ordinary file",
+	} {
+		w, err := zw.Create(file)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(data))
+		require.NoError(t, err)
+	}
+	header := &zip.FileHeader{Name: symlink}
+	header.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(target))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+func linksContext(links bool) context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = links
+	return ctx
