--- /dev/null
+++ b/backend/archive/base/links_test.go
@@ -0,0 +1,21 @@
+package base
+
+import "testing"
+
+func TestIsSafeLinkTarget(t *testing.T) {
+	for _, test := range []struct {
+		remote, target string
+		want           bool
+	}{
+		{remote: "src/link", target: "file.txt", want: true},
+		{remote: "src/link", target: "../file.txt", want: true},
+		{remote: "src/link", target: "../../outside", want: false},
+		{remote: "src/link", target: "/outside", want: false},
+		{remote: "src/link", target: `..\..\outside`, want: false},
+		{remote: "src/link", target: "", want: false},
+	} {
+		if got := IsSafeLinkTarget(test.remote, test.target); got != test.want {
+			t.Errorf("IsSafeLinkTarget(%q, %q) = %v, want %v", test.remote, test.target, got, test.want)
+		}
+	}
+}
