new file mode 100644
index 0000000..a23503e
--- /dev/null
+++ b/backend/archive/base/links.go
@@ -0,0 +1,20 @@
+package base
+
+import (
+	"path"
+	"strings"
+)
+
+// IsSafeLinkTarget reports whether target resolves within the archive root.
+func IsSafeLinkTarget(remote, target string) bool {
+	if target == "" {
+		return false
+	}
+	// Treat both path separators as separators so an archive is safe on every OS.
+	target = strings.ReplaceAll(target, `\`, "/")
+	if strings.HasPrefix(target, "/") || (len(target) >= 2 && target[1] == ':') {
+		return false
+	}
+	resolved := path.Clean(path.Join(path.Dir(remote), target))
+	return resolved != ".." && !strings.HasPrefix(resolved, "../")
+}
diff --git a/backend/archive/base/links_test.go b/backend/archive/base/links_test.go
new file mode 100644
