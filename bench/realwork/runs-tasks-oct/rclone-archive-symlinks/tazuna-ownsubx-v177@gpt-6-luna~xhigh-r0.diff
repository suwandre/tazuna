+// writeZipWithLinks builds a ZIP with regular files, symlinks, and a member
+// below an unsafe symlink.
+func writeZipWithLinks(t *testing.T, dir string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	entries := []struct {
+		name, body string
+		mode       os.FileMode
+	}{
+		{name: "src/file.txt", body: "data"},
+		{name: "src/link.txt", body: "file.txt", mode: os.ModeSymlink | 0777},
+		{name: "src/keep", body: "file.txt", mode: os.ModeSymlink | 0777},
+		{name: "src/keep.rclonelink", body: "ordinary file"},
+		{name: "src/pivot", body: "../../outside", mode: os.ModeSymlink | 0777},
+		{name: "src/pivot/pwned.txt", body: "must stay in destination"},
+	}
+	for _, entry := range entries {
+		header := &zip.FileHeader{Name: entry.name}
+		if entry.mode != 0 {
+			header.SetMode(entry.mode)
+		}
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	const name = "links.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+func TestZipSymlinks(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = false
+	dir := t.TempDir()
+	name := writeZipWithLinks(t, dir)
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	defer f.(*Fs).vfs.Shutdown()
+	assert.Equal(t, []string{
+		"src/file.txt",
+		"src/keep.rclonelink",
+		"src/pivot/pwned.txt",
+	}, allRemotes(t, f))
+	_, err = f.NewObject(ctx, "src/link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	ordinary, err := f.NewObject(ctx, "src/keep.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("ordinary file")), ordinary.Size())
+	_, err = f.NewObject(ctx, "src/pivot.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctx, ci = fs.AddConfig(context.Background())
+	ci.Links = true
+	f, err = New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	defer f.(*Fs).vfs.Shutdown()
+	assert.Equal(t, []string{
+		"src/file.txt",
+		"src/keep.rclonelink",
+		"src/link.txt.rclonelink",
+		"src/pivot/pwned.txt",
+	}, allRemotes(t, f))
+
+	link, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	ordinary, err = f.NewObject(ctx, "src/keep.rclonelink")
+	require.NoError(t, err)
+	rc, err := ordinary.Open(ctx)
+	require.NoError(t, err)
+	body, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ordinary file", string(body))
+
+	rc, err = link.Open(ctx)
+	require.NoError(t, err)
+	body, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file.txt", string(body))
+
+	rc, err = link.Open(ctx, &fs.RangeOption{Start: 2, End: 4})
+	require.NoError(t, err)
+	body, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "le.", string(body))
+
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "symlink-test")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	dstRoot := t.TempDir()
+	dst, err := localbackend.NewFs(ctx, "local", dstRoot, configmap.Simple{})
+	require.NoError(t, err)
+	require.NoError(t, dst.Mkdir(ctx, "src"))
+	_, err = operations.Copy(ctx, dst, nil, "src/link.txt.rclonelink", link)
+	require.NoError(t, err)
+	target, err := os.Readlink(filepath.Join(dstRoot, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+
+	sandbox := t.TempDir()
+	copyRoot := filepath.Join(sandbox, "out")
+	require.NoError(t, os.Mkdir(copyRoot, 0700))
+	copyDst, err := localbackend.NewFs(ctx, "local", copyRoot, configmap.Simple{})
+	require.NoError(t, err)
+	require.NoError(t, copyDst.Mkdir(ctx, "src"))
+	require.NoError(t, copyDst.Mkdir(ctx, "src/pivot"))
+	for _, remote := range allRemotes(t, f) {
+		if remote == "src/keep.rclonelink" {
+			continue
+		}
+		src, err := f.NewObject(ctx, remote)
+		require.NoError(t, err)
+		_, err = operations.Copy(ctx, copyDst, nil, remote, src)
+		require.NoError(t, err)
+	}
+	pivotInfo, err := os.Lstat(filepath.Join(copyRoot, "src", "pivot"))
+	require.NoError(t, err)
+	assert.True(t, pivotInfo.IsDir(), "unsafe symlink should not be created in the destination")
+	_, err = os.Stat(filepath.Join(sandbox, "outside", "pwned.txt"))
+	assert.True(t, os.IsNotExist(err), "archive member escaped the destination")
+
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	for _, remote := range allRemotes(t, f) {
+		if strings.HasSuffix(remote, fs.LinkSuffix) {
+			_, err = f.NewObject(ctx, remote)
+			assert.NoError(t, err, "NewObject should find listed object %q", remote)
+		}
+	}
+
+	rooted, err := New(ctx, localFs, name, "", "src/link.txt")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	defer rooted.(*Fs).vfs.Shutdown()
+	assert.Equal(t, []string{"link.txt.rclonelink"}, allRemotes(t, rooted))
+
+	rooted, err = New(ctx, localFs, name, "", "src/link.txt.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	defer rooted.(*Fs).vfs.Shutdown()
+	assert.Equal(t, []string{"link.txt.rclonelink"}, allRemotes(t, rooted))
+}
