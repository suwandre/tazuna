+// Keep malformed archives from forcing a large allocation for a symlink target.
+const maxLinkTargetSize = 1 << 20
+
+// readLinkTarget reads a bounded ZIP symlink target.
+func readLinkTarget(file *zip.File) (string, error) {
+	if file.UncompressedSize64 > maxLinkTargetSize {
+		return "", errors.New("symlink target is too large")
+	}
+	r, err := file.Open()
+	if err != nil {
+		return "", err
+	}
+	target, readErr := io.ReadAll(io.LimitReader(r, maxLinkTargetSize+1))
+	closeErr := r.Close()
+	if readErr != nil {
+		return "", readErr
+	}
+	if closeErr != nil {
+		return "", closeErr
+	}
+	if len(target) > maxLinkTargetSize {
+		return "", errors.New("symlink target is too large")
+	}
+	return string(target), nil
 }
 
