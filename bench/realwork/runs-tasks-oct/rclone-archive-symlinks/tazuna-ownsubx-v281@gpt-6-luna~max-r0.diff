+func TestSymlinks(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("contents"), 0600))
+	if err := os.Symlink("file.txt", filepath.Join(input, "link.txt")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	require.NoError(t, os.WriteFile(filepath.Join(input, "ordinary"+fs.LinkSuffix), []byte("regular file"), 0600))
+	imageDir := t.TempDir()
+	image := filepath.Join(imageDir, "links.sqfs")
+	cmd := exec.Command(mksquashfs, input, image, "-noappend", "-processors", "1")
+	out, err := cmd.CombinedOutput()
+	require.NoError(t, err, string(out))
+
+	for _, links := range []bool{false, true} {
+		t.Run(fmt.Sprintf("links=%t", links), func(t *testing.T) {
+			ctx, ci := fs.AddConfig(context.Background())
+			ci.Links = links
+			localFs, err := fscache.Get(ctx, imageDir)
+			require.NoError(t, err)
+			f, err := New(ctx, localFs, "links.sqfs", "", "")
+			require.NoError(t, err)
+
+			entries, err := f.List(ctx, "")
+			require.NoError(t, err)
+			var remotes []string
+			for _, entry := range entries {
+				if _, ok := entry.(fs.Object); ok {
+					remotes = append(remotes, entry.Remote())
+				}
+			}
+			sort.Strings(remotes)
+			linkRemote := "link.txt"
+			want := []string{"file.txt", "ordinary" + fs.LinkSuffix}
+			if links {
+				linkRemote += fs.LinkSuffix
+				want = append(want, linkRemote)
+			}
+			sort.Strings(want)
+			assert.Equal(t, want, remotes)
+
+			regular, err := f.NewObject(ctx, "ordinary"+fs.LinkSuffix)
+			require.NoError(t, err)
+			assert.Equal(t, "regular file", string(readSquashfsObject(ctx, t, regular)))
+			link, err := f.NewObject(ctx, linkRemote)
+			if !links {
+				require.ErrorIs(t, err, fs.ErrorObjectNotFound)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, int64(len("file.txt")), link.Size())
+			assert.Equal(t, "file.txt", string(readSquashfsObject(ctx, t, link)))
+			assert.Equal(t, "le.txt", string(readSquashfsObject(ctx, t, link, &fs.SeekOption{Offset: 2})))
+			assert.Equal(t, "ile", string(readSquashfsObject(ctx, t, link, &fs.RangeOption{Start: 1, End: 3})))
+			_, err = f.NewObject(ctx, "link.txt")
+			require.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+			single, err := New(ctx, localFs, "links.sqfs", "", "link.txt"+fs.LinkSuffix)
+			require.ErrorIs(t, err, fs.ErrorIsFile)
+			obj, err := single.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+			require.NoError(t, err)
+			assert.Equal(t, "file.txt", string(readSquashfsObject(ctx, t, obj)))
+		})
+	}
+}
+
+func readSquashfsObject(ctx context.Context, t *testing.T, o fs.Object, options ...fs.OpenOption) []byte {
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	defer func() { assert.NoError(t, rc.Close()) }()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return data
+}
