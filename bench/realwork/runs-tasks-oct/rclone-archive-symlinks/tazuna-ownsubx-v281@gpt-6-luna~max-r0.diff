+func readZipObject(ctx context.Context, t *testing.T, o fs.Object, options ...fs.OpenOption) []byte {
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	defer func() { assert.NoError(t, rc.Close()) }()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return data
+}
