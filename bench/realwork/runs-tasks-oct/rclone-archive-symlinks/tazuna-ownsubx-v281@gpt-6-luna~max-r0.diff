+func skipIfNoSymlinks(t *testing.T) {
+	t.Helper()
+	if err := os.Symlink("missing", filepath.Join(t.TempDir(), "symlink-probe")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+}
+
+func TestArchiveSymlinkCopy(t *testing.T) {
+	skipIfNoSymlinks(t)
+	archivePath := filepath.Join(t.TempDir(), "links.zip")
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("src/file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("target contents"))
+	require.NoError(t, err)
+	header := &zip.FileHeader{Name: "src/link.txt"}
+	header.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(archivePath, buf.Bytes(), 0600))
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	src, err := cache.Get(ctx, ":archive:"+archivePath)
+	require.NoError(t, err)
+	dstRoot := t.TempDir()
+	dst, err := local.NewFs(ctx, "local", dstRoot, configmap.Simple{})
+	require.NoError(t, err)
+	require.NoError(t, syncfs.CopyDir(ctx, dst, src, false))
+
+	link := filepath.Join(dstRoot, "src", "link.txt")
+	info, err := os.Lstat(link)
+	require.NoError(t, err)
+	require.NotZero(t, info.Mode()&os.ModeSymlink)
+	target, err := os.Readlink(link)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+	content, err := os.ReadFile(filepath.Join(dstRoot, "src", "file.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "target contents", string(content))
+}
+
+func TestArchiveSymlinkEscapeWriteBlocked(t *testing.T) {
+	skipIfNoSymlinks(t)
+	base := t.TempDir()
+	dstRoot := filepath.Join(base, "destination")
+	outside := filepath.Join(base, "outside")
+	require.NoError(t, os.Mkdir(dstRoot, 0700))
+	require.NoError(t, os.Mkdir(outside, 0700))
+
+	archivePath := filepath.Join(base, "hostile.zip")
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	header := &zip.FileHeader{Name: "pwn"}
+	header.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(header)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("../outside"))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(archivePath, buf.Bytes(), 0600))
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	src, err := cache.Get(ctx, ":archive:"+archivePath)
+	require.NoError(t, err)
+	link, err := src.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	member, err := src.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	dst, err := local.NewFs(ctx, "local", dstRoot, configmap.Simple{})
+	require.NoError(t, err)
+
+	_, err = operations.Copy(ctx, dst, nil, link.Remote(), link)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, member.Remote(), member)
+	require.Error(t, err, "writing through the archive symlink should be refused")
+	linkInfo, err := os.Lstat(filepath.Join(dstRoot, "pwn"))
+	require.NoError(t, err)
+	require.NotZero(t, linkInfo.Mode()&os.ModeSymlink)
+	target, err := os.Readlink(filepath.Join(dstRoot, "pwn"))
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", target)
+	_, err = os.Lstat(filepath.Join(outside, "authkeys"))
+	require.True(t, os.IsNotExist(err), "archive wrote outside the destination: %v", err)
+}
