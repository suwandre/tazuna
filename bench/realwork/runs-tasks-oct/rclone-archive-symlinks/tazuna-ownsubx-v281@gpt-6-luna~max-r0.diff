+// Symlinks are omitted by default and exposed as translated files with --links.
+func TestZipSymlinks(t *testing.T) {
+	baseCtx := context.Background()
+	dir := t.TempDir()
+	name := writeZipWithSymlinks(t, dir, "links.zip")
+
+	for _, links := range []bool{false, true} {
+		t.Run(fmt.Sprintf("links=%t", links), func(t *testing.T) {
+			ctx, ci := fs.AddConfig(baseCtx)
+			ci.Links = links
+			localFs, err := cache.Get(ctx, dir)
+			require.NoError(t, err)
+			f, err := New(ctx, localFs, name, "", "")
+			require.NoError(t, err)
+
+			want := []string{"src/file.txt", "src/ordinary" + fs.LinkSuffix}
+			linkRemote := "src/link.txt"
+			if links {
+				linkRemote += fs.LinkSuffix
+				want = append(want, linkRemote)
+			}
+			sort.Strings(want)
+			assert.Equal(t, want, allRemotes(t, f))
+
+			regular, err := f.NewObject(ctx, "src/ordinary"+fs.LinkSuffix)
+			require.NoError(t, err)
+			assert.Equal(t, "regular file", string(readZipObject(ctx, t, regular)))
+
+			link, err := f.NewObject(ctx, linkRemote)
+			if !links {
+				require.ErrorIs(t, err, fs.ErrorObjectNotFound)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, int64(len("file.txt")), link.Size())
+			assert.Equal(t, "file.txt", string(readZipObject(ctx, t, link)))
+			assert.Equal(t, "le.txt", string(readZipObject(ctx, t, link, &fs.SeekOption{Offset: 2})))
+			assert.Equal(t, "ile", string(readZipObject(ctx, t, link, &fs.RangeOption{Start: 1, End: 3})))
+			_, err = f.NewObject(ctx, "src/link.txt")
+			require.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+			single, err := New(ctx, localFs, name, "", "src/link.txt"+fs.LinkSuffix)
+			require.ErrorIs(t, err, fs.ErrorIsFile)
+			obj, err := single.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+			require.NoError(t, err)
+			assert.Equal(t, "file.txt", string(readZipObject(ctx, t, obj)))
+
+		})
+	}
+}
