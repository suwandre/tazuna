@@ -36,6 +38,25 @@ func writeZip(t *testing.T, dir, name string, names ...string) string {
 	return name
 }
 
+func writeZipSymlinks(t *testing.T, dir, name string, members map[string]struct {
+	content string
+	mode    os.FileMode
+}) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for member, details := range members {
+		hdr := &zip.FileHeader{Name: member, Method: zip.Deflate}
+		hdr.SetMode(details.mode)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(details.content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
 // allRemotes returns every Object remote in the mounted archive's dirtree.
 func allRemotes(t *testing.T, f fs.Fs) []string {
 	zf, ok := f.(*Fs)
@@ -170,3 +191,96 @@ func TestListCacheNotAliased(t *testing.T) {
 	}
 	assert.Equal(t, []string{"a.txt", "b.txt", "c.txt"}, remotes)
 }
+
+func TestReadZipSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipSymlinks(t, dir, "links.zip", map[string]struct {
+		content string
+		mode    os.FileMode
+	}{
+		"link":               {content: "target.txt", mode: os.ModeSymlink | 0777},
+		"regular.rclonelink": {content: "ordinary file", mode: 0600},
+	})
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = false
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"regular.rclonelink"}, []string{entries[0].Remote()})
+	_, err = f.NewObject(ctx, "link")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = f.NewObject(ctx, "link"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctx, ci = fs.AddConfig(context.Background())
+	ci.Links = true
+	f, err = New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err = f.List(ctx, "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"link" + fs.LinkSuffix, "regular.rclonelink"}, []string{entries[0].Remote(), entries[1].Remote()})
+
+	_, err = f.NewObject(ctx, "link")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	link, err := f.NewObject(ctx, "link"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("target.txt")), link.Size())
+	assert.Equal(t, "target.txt", string(readZipObject(t, ctx, link)))
+	assert.Equal(t, "get.txt", string(readZipObject(t, ctx, link, &fs.SeekOption{Offset: 3})))
+	assert.Equal(t, "get.", string(readZipObject(t, ctx, link, &fs.RangeOption{Start: 3, End: 6})))
+
+	regular, err := f.NewObject(ctx, "regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "ordinary file", string(readZipObject(t, ctx, regular)))
+
+	dstPath := t.TempDir()
+	dst, err := cache.Get(ctx, dstPath)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, dst, f, false))
+	linkInfo, err := os.Lstat(filepath.Join(dstPath, "link"))
+	require.NoError(t, err)
+	assert.NotZero(t, linkInfo.Mode()&os.ModeSymlink)
+	linkTarget, err := os.Readlink(filepath.Join(dstPath, "link"))
+	require.NoError(t, err)
+	assert.Equal(t, "target.txt", linkTarget)
+}
+
+func readZipObject(t *testing.T, ctx context.Context, obj fs.Object, options ...fs.OpenOption) []byte {
+	rc, err := obj.Open(ctx, options...)
+	require.NoError(t, err)
+	defer func() { require.NoError(t, rc.Close()) }()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return data
+}
+
+func TestCopyHostileZipSymlink(t *testing.T) {
+	ctx := context.Background()
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	dir := t.TempDir()
+	name := writeZipSymlinks(t, dir, "hostile.zip", map[string]struct {
+		content string
+		mode    os.FileMode
+	}{
+		"src/link":       {content: "../../outside", mode: os.ModeSymlink | 0777},
+		"src/link/pwned": {content: "hostile", mode: 0600},
+	})
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	src, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	dstPath := t.TempDir()
+	dst, err := cache.Get(ctx, dstPath)
+	require.NoError(t, err)
+	err = sync.CopyDir(ctx, dst, src, false)
+	require.Error(t, err)
+	_, err = os.Stat(filepath.Join(filepath.Dir(dstPath), "outside", "pwned"))
+	assert.True(t, os.IsNotExist(err))
+}
