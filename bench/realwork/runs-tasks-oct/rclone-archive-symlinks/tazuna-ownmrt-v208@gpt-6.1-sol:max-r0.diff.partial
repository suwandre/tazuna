diff --git a/backend/archive/squashfs/squashfs_internal_test.go b/backend/archive/squashfs/squashfs_internal_test.go
index 9b071bf..478d026 100644
--- a/backend/archive/squashfs/squashfs_internal_test.go
+++ b/backend/archive/squashfs/squashfs_internal_test.go
@@ -2,9 +2,14 @@ package squashfs
 
 import (
 	"context"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
 	"testing"
 
 	_ "github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
 	fscache "github.com/rclone/rclone/fs/cache"
 	"github.com/stretchr/testify/assert"
 	"github.com/stretchr/testify/require"
@@ -30,3 +35,66 @@ func TestBackslashInName(t *testing.T) {
 	require.NoError(t, err)
 	assert.Equal(t, int64(6), o.Size())
 }
+
+func TestSquashfsSymlinks(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs not installed")
+	}
+
+	ctx := context.Background()
+	root := t.TempDir()
+	input := filepath.Join(root, "input")
+	require.NoError(t, os.Mkdir(input, 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "ordinary.rclonelink"), []byte("ordinary"), 0600))
+	require.NoError(t, os.Symlink("target.txt", filepath.Join(input, "link")))
+	image := filepath.Join(root, "links.sqfs")
+	cmd := exec.Command(mksquashfs, input, image, "-noappend", "-processors", "1")
+	out, err := cmd.CombinedOutput()
+	require.NoError(t, err, string(out))
+
+	localFs, err := fscache.Get(ctx, root)
+	require.NoError(t, err)
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = false
+	f, err := New(ctx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "ordinary.rclonelink", entries[0].Remote())
+	_, err = f.NewObject(ctx, "link")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = f.NewObject(ctx, "link"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctx, ci = fs.AddConfig(context.Background())
+	ci.Links = true
+	f, err = New(ctx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err = f.List(ctx, "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"link" + fs.LinkSuffix, "ordinary.rclonelink"}, []string{entries[0].Remote(), entries[1].Remote()})
+
+	_, err = f.NewObject(ctx, "link")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	link, err := f.NewObject(ctx, "link"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("target.txt")), link.Size())
+	assert.Equal(t, "target.txt", readSquashfsObject(t, ctx, link))
+	assert.Equal(t, "get.txt", readSquashfsObject(t, ctx, link, &fs.SeekOption{Offset: 3}))
+	assert.Equal(t, "get.", readSquashfsObject(t, ctx, link, &fs.RangeOption{Start: 3, End: 6}))
+
+	regular, err := f.NewObject(ctx, "ordinary.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "ordinary", readSquashfsObject(t, ctx, regular))
+}
+
+func readSquashfsObject(t *testing.T, ctx context.Context, obj fs.Object, options ...fs.OpenOption) string {
+	rc, err := obj.Open(ctx, options...)
+	require.NoError(t, err)
+	defer func() { require.NoError(t, rc.Close()) }()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(data)
+}
