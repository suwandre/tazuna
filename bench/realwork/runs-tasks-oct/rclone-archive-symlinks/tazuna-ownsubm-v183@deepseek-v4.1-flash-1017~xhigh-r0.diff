+		{"symlink first", []zipEntry{
+			{name: "link.txt", mode: os.ModeSymlink | 0777, content: "file.txt"},
+			{name: "link.txt.rclonelink", content: "regular"},
+		}},
+		{"regular first", []zipEntry{
+			{name: "link.txt.rclonelink", content: "regular"},
+			{name: "link.txt", mode: os.ModeSymlink | 0777, content: "file.txt"},
+		}},
+	} {
