+// TestSymlinksSkipped checks that symlinks are skipped without
+// -l/--links, and that a regular member ending in the link suffix is
+// still a regular file.
+func TestSymlinksSkipped(t *testing.T) {
+	ctx, f := newSymlinkFs(t, false)
+
+	assert.Equal(t, []string{"real.rclonelink", "src/file.txt"}, allRemotes(ctx, t, f))
+
+	for _, remote := range []string{"evil", "evil.rclonelink", "src/link.txt", "src/link.txt.rclonelink"} {
+		_, err := f.NewObject(ctx, remote)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+	}
+
+	o, err := f.NewObject(ctx, "real.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("data")), o.Size())
+	assert.Equal(t, "data", readObject(ctx, t, o))
+}
