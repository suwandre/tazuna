+// skipIfNoSymlinks skips the test if this process can't create symlinks.
+func skipIfNoSymlinks(t *testing.T) {
+	t.Helper()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("Skipping as symlinks are unavailable: %v", err)
+	}
+}
+
+// checkCopiedSymlink copies the archive at archivePath into a new directory
+// with the config in ctx, and checks the copy recreated src/link.txt as a
+// symlink to file.txt.
+func checkCopiedSymlink(ctx context.Context, t *testing.T, archivePath string) {
+	srcFs, err := cache.Get(ctx, ":archive:"+archivePath)
+	require.NoError(t, err)
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, dstFs, srcFs, false))
+
+	content, err := os.ReadFile(filepath.Join(dstDir, "src", "file.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "hello", string(content))
+
+	link := filepath.Join(dstDir, "src", "link.txt")
+	fi, err := os.Lstat(link)
+	require.NoError(t, err)
+	require.True(t, fi.Mode()&os.ModeSymlink != 0, "src/link.txt should be a symlink")
+	target, err := os.Readlink(link)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+// TestArchiveZipSymlinkCopy checks that a symlink in a zip is recreated by a
+// --links copy.
+func TestArchiveZipSymlinkCopy(t *testing.T) {
+	skipIfNoSymlinks(t)
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("src/file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("hello"))
+	require.NoError(t, err)
+	link := &zip.FileHeader{Name: "src/link.txt"}
+	link.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(link)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	zipPath := filepath.Join(t.TempDir(), "test.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+	checkCopiedSymlink(ctx, t, zipPath)
+}
+
+// TestArchiveSquashfsSymlinkCopy checks that a symlink in a squashfs image is
+// recreated by a --links copy.
+func TestArchiveSquashfsSymlinkCopy(t *testing.T) {
+	skipIfNoSymlinks(t)
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	image, err := filepath.Abs(filepath.Join("squashfs", "testdata", "symlink.sqfs"))
+	require.NoError(t, err)
+	checkCopiedSymlink(ctx, t, image)
+}
+
+// TestArchiveZipSymlinkEscapeBlocked checks that a hostile zip cannot make
+// a --links copy write outside the destination: a symlink pointing above the
+// destination plus a member "inside" it must not be followed (CWE-59).
+func TestArchiveZipSymlinkEscapeBlocked(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	// A directory outside the destination the archive wants to write into
+	evil := t.TempDir()
+	evilFile := filepath.Join(evil, "authkeys")
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	link := &zip.FileHeader{Name: "pwn"}
+	link.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(link)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(evil))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	zipPath := filepath.Join(t.TempDir(), "evil.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	srcFs, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	// The copy may fail, but it must never write through the symlink
+	_ = sync.CopyDir(ctx, dstFs, srcFs, false)
+
+	_, err = os.Stat(evilFile)
+	require.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evilFile)
+}
