+// symlink.sqfs contains
+//
+//	src/file.txt     regular file with contents "hello"
+//	src/link.txt     symlink to "file.txt"
+//	evil             symlink to "../../etc/passwd"
+//	real.rclonelink  regular file with contents "data"
+//
+// It was made with
+//
+//	mksquashfs tree symlink.sqfs -noappend -no-xattrs -comp gzip -b 4096
+
+// newSymlinkFs returns symlink.sqfs mounted, with -l/--links in force if
+// links is set.
+func newSymlinkFs(t *testing.T, links bool) (context.Context, fs.Fs) {
+	ctx := context.Background()
+	if links {
+		var ci *fs.ConfigInfo
+		ctx, ci = fs.AddConfig(ctx)
+		ci.Links = true
+	}
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+	return ctx, f
+}
+
+// allRemotes returns the sorted remotes of every object in the archive.
+func allRemotes(ctx context.Context, t *testing.T, f fs.Fs) (remotes []string) {
+	var walk func(dir string)
+	walk = func(dir string) {
+		entries, err := f.List(ctx, dir)
+		require.NoError(t, err)
+		for _, entry := range entries {
+			if o, ok := entry.(fs.Object); ok {
+				remotes = append(remotes, o.Remote())
+			} else {
+				walk(entry.Remote())
+			}
+		}
+	}
+	walk("")
+	sort.Strings(remotes)
+	return remotes
+}
+
+// readObject reads the whole of o, honouring any options.
+func readObject(ctx context.Context, t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
