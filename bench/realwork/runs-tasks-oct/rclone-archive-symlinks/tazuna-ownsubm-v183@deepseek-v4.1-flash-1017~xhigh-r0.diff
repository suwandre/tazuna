+
+// zipEntry describes an entry for writeZipEntries.
+type zipEntry struct {
+	name    string
+	mode    os.FileMode // defaults to a regular file
+	content string
+}
+
+// writeZipEntries builds a zip file from entries in dir and returns its
+// leaf name. An entry with a directory mode gets no content.
+func writeZipEntries(t *testing.T, dir, name string, entries ...zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, e := range entries {
+		hdr := &zip.FileHeader{Name: e.name}
+		if e.mode != 0 {
+			hdr.SetMode(e.mode)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		if !e.mode.IsDir() {
+			_, err = w.Write([]byte(e.content))
+			require.NoError(t, err)
+		}
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// linksCtx returns a context with -l/--links in force.
+func linksCtx(ctx context.Context) context.Context {
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	return ctx
+}
+
+// listRemotes returns the sorted remotes of every object returned by
+// listing every directory reachable from the root.
+func listRemotes(ctx context.Context, t *testing.T, f fs.Fs) (remotes []string) {
+	var walk func(dir string)
+	walk = func(dir string) {
+		entries, err := f.List(ctx, dir)
+		require.NoError(t, err)
+		for _, entry := range entries {
+			if _, ok := entry.(fs.Object); ok {
+				remotes = append(remotes, entry.Remote())
+				continue
+			}
+			walk(entry.Remote())
+		}
+	}
+	walk("")
+	sort.Strings(remotes)
+	return remotes
+}
+
+// readObject returns the contents of o.
+func readObject(ctx context.Context, t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
+
+// TestSymlinkSkipped checks that a symlink member is left out unless
+// -l/--links is in use, and that a regular member whose name ends in
+// the link suffix is unaffected.
+func TestSymlinkSkipped(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "test.zip",
+		zipEntry{name: "src/file.txt", content: "hello"},
+		zipEntry{name: "src/link.txt", mode: os.ModeSymlink | 0777, content: "file.txt"},
+		zipEntry{name: "real.rclonelink", content: "not a link"},
+	)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	assert.Equal(t, []string{"real.rclonelink", "src/file.txt"}, listRemotes(ctx, t, f))
+
+	for _, remote := range []string{"src/link.txt", "src/link.txt.rclonelink"} {
+		_, err := f.NewObject(ctx, remote)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+	}
+
+	o, err := f.NewObject(ctx, "real.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("not a link")), o.Size())
+	assert.Equal(t, "not a link", readObject(ctx, t, o))
+}
+
+// TestSymlink checks that with -l/--links a symlink member is exposed as
+// a .rclonelink object holding its target, and that listing and NewObject
+// agree on the names which exist.
+func TestSymlink(t *testing.T) {
+	ctx := linksCtx(context.Background())
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "test.zip",
+		zipEntry{name: "src/file.txt", content: "hello"},
+		zipEntry{name: "src/link.txt", mode: os.ModeSymlink | 0777, content: "file.txt"},
+		zipEntry{name: "real.rclonelink", content: "not a link"},
+	)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	want := []string{"real.rclonelink", "src/file.txt", "src/link.txt.rclonelink"}
+	remotes := listRemotes(ctx, t, f)
+	assert.Equal(t, want, remotes)
+
+	// Every listed name must be found by NewObject, and no other name may be
+	for _, remote := range remotes {
+		o, err := f.NewObject(ctx, remote)
+		require.NoError(t, err, remote)
+		assert.Equal(t, remote, o.Remote())
+	}
+	for _, remote := range []string{"src/link.txt", "src/missing"} {
+		_, err := f.NewObject(ctx, remote)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+	}
+
+	// The translated symlink holds its target and is sized accordingly
+	o, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	assert.Equal(t, "file.txt", readObject(ctx, t, o))
+
+	// Range and seek options are honoured when reading the target
+	assert.Equal(t, "file.txt"[2:], readObject(ctx, t, o, &fs.SeekOption{Offset: 2}))
+	assert.Equal(t, "le.t", readObject(ctx, t, o, &fs.RangeOption{Start: 2, End: 5}))
+	assert.Equal(t, "txt", readObject(ctx, t, o, &fs.RangeOption{Start: -1, End: 3}))
+
+	// A regular member ending in the link suffix is still a regular file
+	o, err = f.NewObject(ctx, "real.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("not a link")), o.Size())
+	assert.Equal(t, "not a link", readObject(ctx, t, o))
+}
+
+// TestSymlinkNameClash checks that a regular member ending in the link
+// suffix wins over a symlink translated to the same name, whichever order
+// the two appear in the archive.
+func TestSymlinkNameClash(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		entries []zipEntry
