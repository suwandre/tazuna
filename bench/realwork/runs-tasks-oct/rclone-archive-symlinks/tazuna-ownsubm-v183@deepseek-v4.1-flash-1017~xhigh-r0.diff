+			name := writeZipEntries(t, dir, "test.zip", test.entries...)
+
+			localFs, err := cache.Get(ctx, dir)
+			require.NoError(t, err)
+			f, err := New(ctx, localFs, name, "", "")
+			require.NoError(t, err)
+
+			assert.Equal(t, []string{"link.txt.rclonelink"}, listRemotes(ctx, t, f))
+			o, err := f.NewObject(ctx, "link.txt.rclonelink")
+			require.NoError(t, err)
+			assert.Equal(t, int64(len("regular")), o.Size())
+			assert.Equal(t, "regular", readObject(ctx, t, o))
+		})
+	}
+}
+
+// TestSymlinkRoot checks that a symlink can be mounted as a single object
