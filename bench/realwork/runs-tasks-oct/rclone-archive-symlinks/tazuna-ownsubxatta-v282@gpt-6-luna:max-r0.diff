+func TestZipSymlinkEscapeWriteBlocked(t *testing.T) {
+	linkTest := filepath.Join(t.TempDir(), "link")
+	if err := os.Symlink("target", linkTest); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	base := t.TempDir()
+	archiveDir := filepath.Join(base, "archives")
+	require.NoError(t, os.Mkdir(archiveDir, 0700))
+	require.NoError(t, os.Mkdir(filepath.Join(base, "outside"), 0700))
+	name := "evil.zip"
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name, content string
+		mode          os.FileMode
+	}{
+		{"src/pwn", "../../outside", os.ModeSymlink | 0777},
+		{"src/pwn/inside.txt", "evil data", 0644},
+	} {
+		header := &zip.FileHeader{Name: entry.name}
+		header.SetMode(entry.mode)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(archiveDir, name), buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, archiveDir)
+	require.NoError(t, err)
+	source, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	_, err = source.NewObject(ctx, "src/pwn/inside.txt")
+	require.NoError(t, err)
+
+	outputRoot := filepath.Join(base, "destination")
+	destination, err := cache.Get(ctx, outputRoot)
+	require.NoError(t, err)
+	err = operations.CopyFile(ctx, destination, source, "src/pwn"+fs.LinkSuffix, "src/pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	fi, err := os.Lstat(filepath.Join(outputRoot, "src", "pwn"))
+	require.NoError(t, err)
+	assert.NotZero(t, fi.Mode()&os.ModeSymlink)
+
+	// This member sits below the archive symlink, but must not be allowed to
+	// write through it into a sibling of the destination root.
+	err = operations.CopyFile(ctx, destination, source, "src/pwn/inside.txt", "src/pwn/inside.txt")
+	assert.Error(t, err)
+	_, err = os.Stat(filepath.Join(base, "outside", "inside.txt"))
+	assert.True(t, os.IsNotExist(err), "hostile archive wrote outside the destination")
+}
