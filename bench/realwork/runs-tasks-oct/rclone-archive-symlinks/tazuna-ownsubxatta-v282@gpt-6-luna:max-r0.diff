+func TestSquashfsSymlinks(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	const target = "file.txt"
+	const name = "links.sqfs"
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	require.Len(t, entries, 2)
+	_, err = f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ci.Links = true
+	f, err = New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err = f.List(ctx, "src")
+	require.NoError(t, err)
+	require.Len(t, entries, 3)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix, "src/ordinary" + fs.LinkSuffix}, remotes)
+
+	o, err := f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len(target)), o.Size())
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	rc, err := o.Open(ctx, &fs.SeekOption{Offset: 1})
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ile.txt", string(data))
+
+	ordinary, err := f.NewObject(ctx, "src/ordinary"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("ordinary file")), ordinary.Size())
+	rc, err = ordinary.Open(ctx)
+	require.NoError(t, err)
+	data, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ordinary file", string(data))
+
+	rooted, err := New(ctx, localFs, name, "", "src/link.txt")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = rooted.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+	_, err = rooted.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+}
