+func TestZipSymlinks(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	dir := t.TempDir()
+	const target = "file.txt"
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name, content string
+		mode          os.FileMode
+	}{
+		{"file.txt", "content", 0644},
+		{"link.txt", target, os.ModeSymlink | 0777},
+		{"ordinary" + fs.LinkSuffix, "ordinary file", 0644},
+	} {
+		header := &zip.FileHeader{Name: entry.name}
+		header.SetMode(entry.mode)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	const name = "links.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"file.txt", "ordinary" + fs.LinkSuffix}, allRemotes(t, f))
+	_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ci.Links = true
+	f, err = New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"file.txt", "link.txt" + fs.LinkSuffix, "ordinary" + fs.LinkSuffix}, allRemotes(t, f))
+
+	o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len(target)), o.Size())
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	rc, err := o.Open(ctx, &fs.RangeOption{Start: 1, End: 3})
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ile", string(data))
+
+	ordinary, err := f.NewObject(ctx, "ordinary"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("ordinary file")), ordinary.Size())
+	rc, err = ordinary.Open(ctx)
+	require.NoError(t, err)
+	data, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ordinary file", string(data))
+
+	rooted, err := New(ctx, localFs, name, "", "link.txt")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err := rooted.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+	_, err = rooted.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
