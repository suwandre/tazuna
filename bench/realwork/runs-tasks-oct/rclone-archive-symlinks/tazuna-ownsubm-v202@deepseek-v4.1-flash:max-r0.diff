+// Without -l/--links symlinks are skipped, and with it they are listed
+// as .rclonelink objects whose size is the length of the target and
+// whose contents are the target.
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeSquashfs(t, dir, "test.sqfs", map[string]string{
+		"src/file.txt": "hello",
+	}, map[string]string{
+		"src/link.txt":  "file.txt",
+		"src/link2.txt": "../src/file.txt",
+	})
+
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	// Without --links the symlinks are invisible
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "src/file.txt", entries[0].Remote())
+	_, err = f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// With --links they are listed under their name plus the suffix
+	linkCtx := linksCtx(ctx)
+	f, err = New(linkCtx, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err = f.List(linkCtx, "src")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	sort.Strings(remotes)
+	assert.Equal(t, []string{
+		"src/file.txt",
+		"src/link.txt" + fs.LinkSuffix,
+		"src/link2.txt" + fs.LinkSuffix,
+	}, remotes)
+
+	// Listing and NewObject must agree on which names exist
+	for _, remote := range remotes {
