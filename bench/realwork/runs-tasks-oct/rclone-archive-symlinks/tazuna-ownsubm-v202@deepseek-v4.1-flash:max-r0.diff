+// writeSquashfs builds a squashfs image in dir containing the files
+// (name -> contents) and symlinks (name -> target) given, returning
+// the image's leaf name.
+func writeSquashfs(t *testing.T, dir, image string, files, links map[string]string) string {
+	f, err := os.Create(filepath.Join(dir, image))
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, f.Close())
+	}()
+	b := file.New(f, false)
+	sqfs, err := squashfs.Create(b, 0, 0, 4096)
+	require.NoError(t, err)
+	workspace := sqfs.Workspace()
+	for name, contents := range files {
+		require.NoError(t, os.MkdirAll(filepath.Dir(filepath.Join(workspace, name)), 0777))
+		require.NoError(t, os.WriteFile(filepath.Join(workspace, name), []byte(contents), 0666))
+	}
+	for name, target := range links {
+		require.NoError(t, os.MkdirAll(filepath.Dir(filepath.Join(workspace, name)), 0777))
+		require.NoError(t, os.Symlink(target, filepath.Join(workspace, name)))
+	}
+	// Finalize reads symlink targets relative to the working directory,
+	// so run it in the workspace
+	oldCwd, err := os.Getwd()
+	require.NoError(t, err)
+	require.NoError(t, os.Chdir(workspace))
+	defer func() {
+		require.NoError(t, os.Chdir(oldCwd))
+	}()
+	require.NoError(t, sqfs.Finalize(squashfs.FinalizeOptions{}))
+	return image
+}
