+// writeSymlinkZip builds a zip file at zipPath with a regular file
+// "src/file.txt" and a symlink "src/link.txt" pointing at it.
+func writeSymlinkZip(t *testing.T, zipPath string) {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("src/file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("hello"))
+	require.NoError(t, err)
+	h := &zip.FileHeader{Name: "src/link.txt", Method: zip.Store}
+	h.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(h)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+}
+
+// linksCtx returns a context with -l/--links enabled.
+func linksCtx(ctx context.Context) context.Context {
+	newCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	return newCtx
+}
+
+// TestArchiveZipSymlink checks that a symlink in a zip is only exposed
+// with -l/--links, and that copying it with --links recreates the
+// symlink on a destination which supports them.
+func TestArchiveZipSymlink(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoSymlinks(t)
+
+	zipPath := filepath.Join(t.TempDir(), "test.zip")
+	writeSymlinkZip(t, zipPath)
+
+	// Without --links the symlink isn't listed
+	ctx := context.Background()
+	f, err := NewFs(ctx, "archive", zipPath, configmap.Simple{})
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.Equal(t, []string{"src/file.txt"}, remotes)
+	_, err = f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// With --links it is listed under its name plus the suffix and
+	// reads back the target
+	linkCtx := linksCtx(ctx)
+	f, err = NewFs(linkCtx, "archive", zipPath, configmap.Simple{})
+	require.NoError(t, err)
+	o, err := f.NewObject(linkCtx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	rc, err := o.Open(linkCtx)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file.txt", string(contents))
+
+	// Copying with --links recreates the symlink
+	dstDir := t.TempDir()
+	dst, err := cache.Get(linkCtx, dstDir)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(linkCtx, dst, f, false))
+	link := filepath.Join(dstDir, "src", "link.txt")
+	fi, err := os.Lstat(link)
+	require.NoError(t, err)
+	require.NotZero(t, fi.Mode()&os.ModeSymlink, "should have been copied as a symlink")
+	target, err := os.Readlink(link)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+// TestArchiveZipSymlinkEscape checks that a symlink pointing above the
+// destination plus a member "inside" it can't make a copy write outside
+// the destination.
+func TestArchiveZipSymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoSymlinks(t)
+	ctx := linksCtx(context.Background())
+
+	// The destination and the directory outside it the archive tries
+	// to write into are siblings, so the symlink can point at it with
+	// a relative target which escapes the destination
+	root := t.TempDir()
+	dstDir := filepath.Join(root, "dst")
+	outside := filepath.Join(root, "outside")
+	require.NoError(t, os.MkdirAll(dstDir, 0777))
+	require.NoError(t, os.MkdirAll(outside, 0777))
+
+	zipPath := filepath.Join(t.TempDir(), "evil.zip")
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	h := &zip.FileHeader{Name: "pwn", Method: zip.Store}
+	h.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(h)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("../outside"))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/evil.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	f, err := NewFs(ctx, "archive", zipPath, configmap.Simple{})
+	require.NoError(t, err)
+	dst, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+	// The copy is expected to fail as the destination refuses to write
+	// through the symlink, but nothing may escape the destination
+	_ = sync.CopyDir(ctx, dst, f, false)
+
+	_, err = os.Stat(filepath.Join(outside, "evil.txt"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", outside)
+}
+
+// skipIfNoSymlinks skips the test if the OS can't make symlinks.
+func skipIfNoSymlinks(t *testing.T) {
+	t.Helper()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("Skipping as symlinks are unavailable: %v", err)
+	}
+}
+
+// TestArchiveSquashfsSymlink checks that a symlink in a squashfs image
+// is only exposed with -l/--links, and that copying it with --links
+// recreates the symlink on a destination which supports them.
+func TestArchiveSquashfsSymlink(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoExe(t, "mksquashfs")
+	skipIfNoSymlinks(t)
+
+	input := t.TempDir()
+	require.NoError(t, os.MkdirAll(filepath.Join(input, "src"), 0777))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "src", "file.txt"), []byte("hello"), 0666))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "src", "link.txt")))
+	sqfsPath := filepath.Join(t.TempDir(), "test.sqfs")
+	run(t, "mksquashfs", input, sqfsPath, "-quiet", "-noappend")
+
+	// Without --links the symlink isn't listed
+	ctx := context.Background()
+	f, err := NewFs(ctx, "archive", sqfsPath, configmap.Simple{})
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.Equal(t, []string{"src/file.txt"}, remotes)
+	_, err = f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// With --links it is listed under its name plus the suffix and
+	// reads back the target
+	linkCtx := linksCtx(ctx)
+	f, err = NewFs(linkCtx, "archive", sqfsPath, configmap.Simple{})
+	require.NoError(t, err)
+	o, err := f.NewObject(linkCtx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	rc, err := o.Open(linkCtx)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file.txt", string(contents))
+
+	// Copying with --links recreates the symlink
+	dstDir := t.TempDir()
+	dst, err := cache.Get(linkCtx, dstDir)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(linkCtx, dst, f, false))
+	link := filepath.Join(dstDir, "src", "link.txt")
+	fi, err := os.Lstat(link)
+	require.NoError(t, err)
+	require.NotZero(t, fi.Mode()&os.ModeSymlink, "should have been copied as a symlink")
+	target, err := os.Readlink(link)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
