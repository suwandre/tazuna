+// writeZipLinks builds a zip file in dir containing a regular file
+// "file.txt" and symlinks to it, returning its leaf name.
+func writeZipLinks(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("src/file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("hello"))
+	require.NoError(t, err)
+	for link, target := range map[string]string{
+		"src/link.txt":  "file.txt",
+		"src/link2.txt": "../src/file.txt",
+	} {
+		h := &zip.FileHeader{Name: link, Method: zip.Store}
+		h.SetMode(os.ModeSymlink | 0777)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(target))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
