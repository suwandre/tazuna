+		regular, err := f.NewObject(ctx, "dir/regular"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("regular file")), regular.Size())
+		rc, err := regular.Open(ctx)
+		require.NoError(t, err)
+		contents, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "regular file", string(contents))
+
+		destination, err := cache.Get(linksCtx, t.TempDir())
+		require.NoError(t, err)
+		require.NoError(t, sync.CopyDir(linksCtx, destination, f, false))
+		linkPath := filepath.Join(destination.Root(), "dir", "link")
+		info, err := os.Lstat(linkPath)
+		require.NoError(t, err)
+		assert.NotZero(t, info.Mode()&os.ModeSymlink)
+		target, err := os.Readlink(linkPath)
+		require.NoError(t, err)
+		assert.Equal(t, "target.txt", target)
+	})
+
+	t.Run("CopyLinksSecurely", func(t *testing.T) {
+		if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+			t.Skipf("symlinks unavailable: %v", err)
+		}
+		dst := t.TempDir()
+		outside := t.TempDir()
+		zipPath := filepath.Join(t.TempDir(), "hostile.zip")
+		var buf bytes.Buffer
+		zw := zip.NewWriter(&buf)
+		for _, entry := range []struct {
+			name, body string
+			symlink    bool
+		}{
+			{"src/pwn", outside, true},
+			{"src/pwn/escape", "pwned", false},
+		} {
+			h := &zip.FileHeader{Name: entry.name}
+			if entry.symlink {
+				h.SetMode(os.ModeSymlink | 0777)
+			}
+			w, err := zw.CreateHeader(h)
+			require.NoError(t, err)
+			_, err = w.Write([]byte(entry.body))
+			require.NoError(t, err)
+		}
+		require.NoError(t, zw.Close())
+		require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+		archiveFs, err := cache.Get(linksCtx, filepath.Dir(zipPath))
+		require.NoError(t, err)
+		hostile, err := New(linksCtx, archiveFs, filepath.Base(zipPath), "", "")
+		require.NoError(t, err)
+		destination, err := cache.Get(linksCtx, dst)
+		require.NoError(t, err)
+		assert.Error(t, sync.CopyDir(linksCtx, destination, hostile, false))
+		_, err = os.Stat(filepath.Join(outside, "escape"))
+		assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", outside)
+	})
+}
