+
+func TestSymlinks(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+	ctx := context.Background()
+	source := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(source, "regular"+fs.LinkSuffix), []byte("file contents"), 0600))
+	require.NoError(t, os.Symlink("target.txt", filepath.Join(source, "link")))
+	image := filepath.Join(t.TempDir(), "links.sqfs")
+	cmd := exec.Command(mksquashfs, source, image, "-noappend")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("mksquashfs failed: %v\n%s", err, output)
+	}
+
+	localFs, err := fscache.Get(ctx, filepath.Dir(image))
+	require.NoError(t, err)
+
+	t.Run("SkippedWithoutLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, filepath.Base(image), "", "")
+		require.NoError(t, err)
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		require.Len(t, entries, 1)
+		assert.Equal(t, "regular"+fs.LinkSuffix, entries[0].Remote())
+		_, err = f.NewObject(ctx, "link"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	linksCtx, config := fs.AddConfig(ctx)
+	config.Links = true
+	f, err := New(linksCtx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 2)
+	assert.Equal(t, "link"+fs.LinkSuffix, entries[0].Remote())
+
+	_, err = f.NewObject(ctx, "link")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	o, err := f.NewObject(ctx, "link"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("target.txt")), o.Size())
+	for _, test := range []struct {
+		option fs.OpenOption
+		want   string
+	}{
+		{nil, "target.txt"},
+		{&fs.SeekOption{Offset: 2}, "rget.txt"},
+		{&fs.RangeOption{Start: 1, End: 4}, "arge"},
+	} {
+		var options []fs.OpenOption
+		if test.option != nil {
+			options = append(options, test.option)
+		}
+		rc, err := o.Open(ctx, options...)
+		require.NoError(t, err)
+		got, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, test.want, string(got))
+	}
+
+	regular, err := f.NewObject(ctx, "regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file contents")), regular.Size())
+}
