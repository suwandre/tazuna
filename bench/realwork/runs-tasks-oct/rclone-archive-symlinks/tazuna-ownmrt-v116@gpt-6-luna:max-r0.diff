+func writeZipWithSymlink(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+
+	link := &zip.FileHeader{Name: "dir/link", Method: zip.Deflate}
+	link.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(link)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("target.txt"))
+	require.NoError(t, err)
+
+	w, err = zw.Create("dir/regular" + fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("regular file"))
+	require.NoError(t, err)
+
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
