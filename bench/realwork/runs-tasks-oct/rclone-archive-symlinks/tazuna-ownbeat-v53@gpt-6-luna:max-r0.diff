+func TestSquashfsSymlinks(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlink creation requires additional privileges on Windows")
+	}
+	image, err := os.CreateTemp(t.TempDir(), "links-*.sqfs")
+	require.NoError(t, err)
+	defer image.Close()
+	imageFS, err := diskSquashfs.Create(file.New(image, false), 0, 0, 4096)
+	require.NoError(t, err)
+	workspace := imageFS.Workspace()
+	require.NoError(t, os.MkdirAll(filepath.Join(workspace, "src"), 0755))
+	require.NoError(t, os.WriteFile(filepath.Join(workspace, "src", "file.txt"), []byte("file data"), 0644))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(workspace, "src", "link.txt")))
+	t.Chdir(workspace)
+	require.NoError(t, imageFS.Finalize(diskSquashfs.FinalizeOptions{}))
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = false
+	localFs, err := fscache.Get(ctx, filepath.Dir(image.Name()))
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, filepath.Base(image.Name()), "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "src/file.txt", entries[0].Remote())
+	_, err = f.NewObject(ctx, "src/link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linkCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(linkCtx, localFs, filepath.Base(image.Name()), "", "")
+	require.NoError(t, err)
+	entries, err = f.List(linkCtx, "src")
+	require.NoError(t, err)
+	require.Len(t, entries, 2)
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/link.txt.rclonelink"}, []string{entries[0].Remote(), entries[1].Remote()})
+
+	link, err := f.NewObject(linkCtx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	assert.Equal(t, "file.txt", string(readSquashfsObject(t, linkCtx, link)))
+	assert.Equal(t, "e.txt", string(readSquashfsObject(t, linkCtx, link, &fs.SeekOption{Offset: 3})))
+	assert.Equal(t, "ile", string(readSquashfsObject(t, linkCtx, link, &fs.RangeOption{Start: 1, End: 3})))
+
+	dstRoot := t.TempDir()
+	dst, err := local.NewFs(linkCtx, "local", dstRoot, configmap.Simple{})
+	require.NoError(t, err)
+	_, err = operations.Copy(linkCtx, dst, nil, link.Remote(), link)
+	require.NoError(t, err)
+	linkPath := filepath.Join(dstRoot, "src", "link.txt")
+	info, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	assert.True(t, info.Mode()&os.ModeSymlink != 0)
+	target, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+func readSquashfsObject(t *testing.T, ctx context.Context, obj fs.Object, options ...fs.OpenOption) []byte {
+	rc, err := obj.Open(ctx, options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return data
+}
