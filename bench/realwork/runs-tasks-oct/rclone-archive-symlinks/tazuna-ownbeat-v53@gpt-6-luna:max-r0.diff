+func writeZipWithSymlink(t *testing.T, dir, name, symlink string, entries ...string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for i := 0; i < len(entries); i += 2 {
+		entryName, content := entries[i], entries[i+1]
+		var w io.Writer
+		if entryName == symlink {
+			header := &zip.FileHeader{Name: entryName, Method: zip.Store}
+			header.SetMode(os.ModeSymlink | 0o777)
+			var err error
+			w, err = zw.CreateHeader(header)
+			require.NoError(t, err)
+		} else {
+			var err error
+			w, err = zw.Create(entryName)
+			require.NoError(t, err)
+		}
+		_, err := io.WriteString(w, content)
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
