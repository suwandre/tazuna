+func TestZipSymlinkEscapeWriteBlocked(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlink creation requires additional privileges on Windows")
+	}
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	parent := t.TempDir()
+	dir := filepath.Join(parent, "archives")
+	require.NoError(t, os.Mkdir(dir, 0700))
+	evilDir := filepath.Join(parent, "evil")
+	require.NoError(t, os.Mkdir(evilDir, 0700))
+	name := writeZipWithSymlink(t, dir, "evil.zip", "src/link", "src/link", "../../evil", "src/link/evil.txt", "escaped")
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	src, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	dstRoot := filepath.Join(parent, "out")
+	dst, err := local.NewFs(ctx, "local", dstRoot, configmap.Simple{})
+	require.NoError(t, err)
+
+	link, err := src.NewObject(ctx, "src/link.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, link.Remote(), link)
+	require.NoError(t, err)
+	child, err := src.NewObject(ctx, "src/link/evil.txt")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, child.Remote(), child)
+	require.Error(t, err, "copy through an archive symlink must be refused")
+	_, err = os.Stat(filepath.Join(evilDir, "evil.txt"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination")
+}
