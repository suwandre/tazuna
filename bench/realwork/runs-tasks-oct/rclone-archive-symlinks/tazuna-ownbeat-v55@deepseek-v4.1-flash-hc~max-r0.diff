+// TestSymlinkRanges checks that reading a symlink target honours
+// seek and range options, like any other member.
+func TestSymlinkRanges(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	dir := t.TempDir()
+	name := writeSymlinkZip(t, dir, "test.zip")
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+
+	for _, test := range []struct {
+		name    string
+		options []fs.OpenOption
+		want    string
+	}{
+		{"All", nil, "file.txt"},
+		{"Seek", []fs.OpenOption{&fs.SeekOption{Offset: 5}}, "txt"},
+		{"Range", []fs.OpenOption{&fs.RangeOption{Start: 0, End: 3}}, "file"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			rc, err := o.Open(ctx, test.options...)
+			require.NoError(t, err)
