+	t.Run("NewObjectAgreesWithList", func(t *testing.T) {
+		f, err := New(ctxLinks, localFs, name, "", "")
+		require.NoError(t, err)
+
+		// The name without the suffix isn't exposed
+		_, err = f.NewObject(ctxLinks, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// The suffixed name is
+		o, err := f.NewObject(ctxLinks, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(8), o.Size())
+	})
