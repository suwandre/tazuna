+// TestSymlinkHostileRootTraversal checks that a symlink pointing above
+// the root cannot make a copy write outside the destination.
+func TestSymlinkHostileRootTraversal(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	dir := t.TempDir()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	add := func(entry, content string, mode os.FileMode) {
+		hdr := &zip.FileHeader{Name: entry}
+		hdr.SetMode(mode)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	// "evil" points above the archive root and "evil/pwned" would then
+	// be written through it by a naive extractor
+	add("evil", "../../outside", os.ModeSymlink|0777)
+	add("evil/pwned", "PWNED", 0644)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "evil.zip"), buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, "evil.zip", "", "")
+	require.NoError(t, err)
+
+	// The symlink is exposed under its name plus the suffix and read
+	// back verbatim, never resolved, so it cannot escape the archive
+	got := listRemotes(ctx, t, f, "")
+	assert.Equal(t, map[string]int64{
+		"evil" + fs.LinkSuffix: 13,
+		"evil":                 -1, // directory made for "evil/pwned"
+		"evil/pwned":           5,
+	}, got)
+
+	// The symlink target is returned verbatim, not resolved
+	assert.Equal(t, "../../outside", readObject(ctx, t, f, "evil"+fs.LinkSuffix))
+
+	// The object nested under the symlink is a regular, safe object
+	o, err := f.NewObject(ctx, "evil/pwned")
+	require.NoError(t, err)
+	assert.Equal(t, "evil/pwned", o.Remote())
+
+	// No object may escape the archive namespace
+	for remote := range got {
+		assert.NotContains(t, remote, "..")
+	}
+}
