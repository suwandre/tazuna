+
+// writeArchiveZip writes a zip at zipPath containing the given entries
+// (content is the file data, or the target for a symlink).
+func writeArchiveZip(t *testing.T, zipPath string, entries []archiveEntry) {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, e := range entries {
+		hdr := &zip.FileHeader{Name: e.name}
+		hdr.SetMode(e.mode)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(e.content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.MkdirAll(filepath.Dir(zipPath), 0777))
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+}
+
+type archiveEntry struct {
+	name    string
+	content string
+	mode    os.FileMode
+}
+
+// TestArchiveSymlinkCopy copies a zip containing a symlink to a local
+// destination with --links and checks the symlink is recreated.
+func TestArchiveSymlinkCopy(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	zipPath := filepath.Join(t.TempDir(), "test.zip")
+	writeArchiveZip(t, zipPath, []archiveEntry{
+		{"file.txt", "hello\n", 0644},
+		{"link.txt", "file.txt", os.ModeSymlink | 0777},
+	})
+
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	destDir := t.TempDir()
+	dst, err := cache.Get(ctx, destDir)
+	require.NoError(t, err)
+
+	require.NoError(t, sync.CopyDir(ctx, dst, src, false))
+
+	assertFileContent(t, filepath.Join(destDir, "file.txt"), "hello\n")
+	link := filepath.Join(destDir, "link.txt")
+	fi, err := os.Lstat(link)
+	require.NoError(t, err)
+	require.True(t, fi.Mode()&os.ModeSymlink != 0, "link.txt should be a symlink")
+	target, err := os.Readlink(link)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+// TestArchiveSymlinkEscape copies a hostile zip whose symlink points
+// above the archive root followed by a member "inside" it, and checks
+// nothing is written outside the destination.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	// A directory outside the destination the attacker wants to write into
+	evil := t.TempDir()
+	evilFile := filepath.Join(evil, "pwned")
+
+	zipPath := filepath.Join(t.TempDir(), "evil.zip")
+	writeArchiveZip(t, zipPath, []archiveEntry{
+		{"evil", evil, os.ModeSymlink | 0777},
+		{"evil/pwned", "PWNED", 0644},
+	})
+
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	destDir := t.TempDir()
+	dst, err := cache.Get(ctx, destDir)
+	require.NoError(t, err)
+
+	// The copy may fail on the member nested under the symlink, but
+	// whatever happens nothing may land outside the destination
+	_ = sync.CopyDir(ctx, dst, src, false)
+
+	_, err = os.Stat(evilFile)
+	require.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evilFile)
+}
+
+// TestArchiveSquashfsSymlinkCopy creates a squashfs image containing a
+// symlink with mksquashfs, copies it with --links and checks the symlink
+// is recreated, so squashfs and zip behave the same way.
+func TestArchiveSquashfsSymlinkCopy(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoExe(t, "mksquashfs")
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	// Build a source tree with a regular file and a symlink
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("hello\n"), 0644))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "link.txt")))
+
+	sqfsPath := filepath.Join(t.TempDir(), "test.sqfs")
+	run(t, "mksquashfs", input, sqfsPath, "-noappend", "-all-root")
+
+	src, err := cache.Get(ctx, ":archive:"+sqfsPath)
+	require.NoError(t, err)
+
+	destDir := t.TempDir()
+	dst, err := cache.Get(ctx, destDir)
+	require.NoError(t, err)
+
+	require.NoError(t, sync.CopyDir(ctx, dst, src, false))
+
+	assertFileContent(t, filepath.Join(destDir, "file.txt"), "hello\n")
+	link := filepath.Join(destDir, "link.txt")
+	fi, err := os.Lstat(link)
+	require.NoError(t, err)
+	require.True(t, fi.Mode()&os.ModeSymlink != 0, "link.txt should be a symlink")
+	target, err := os.Readlink(link)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+// assertFileContent checks the file at path has the wanted content.
+func assertFileContent(t *testing.T, path, want string) {
+	t.Helper()
+	got, err := os.ReadFile(path)
+	require.NoError(t, err)
+	assert.Equal(t, want, string(got))
+}
