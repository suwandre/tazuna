+
+		got := listRemotes(ctxNoLinks, t, f, "")
+		assert.Equal(t, map[string]int64{
+			"file.txt":        6,
+			"real.rclonelink": 11,
+		}, got)
+
+		_, err = f.NewObject(ctxNoLinks, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctxNoLinks, "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		f, err := New(ctxLinks, localFs, "symlink.sqfs", "", "")
+		require.NoError(t, err)
+
+		got := listRemotes(ctxLinks, t, f, "")
+		assert.Equal(t, map[string]int64{
+			"file.txt":                 6,
+			"link.txt" + fs.LinkSuffix: 8,
+			"real.rclonelink":          11,
+		}, got)
+
+		// The link is listed under its name plus the suffix, and its
+		// size is the length of the target
+		assert.Equal(t, "file.txt", readObject(ctxLinks, t, f, "link.txt"+fs.LinkSuffix))
+		// A regular member ending in .rclonelink is still a regular file
+		assert.Equal(t, "not a link\n", readObject(ctxLinks, t, f, "real.rclonelink"))
+	})
+
+	t.Run("NewObjectAgreesWithList", func(t *testing.T) {
