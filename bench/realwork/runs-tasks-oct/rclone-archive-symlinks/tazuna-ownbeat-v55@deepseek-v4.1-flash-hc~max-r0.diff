+func TestSymlinks(t *testing.T) {
+	ctxNoLinks := context.Background()
+	ctxLinks, ci := fs.AddConfig(ctxNoLinks)
+	ci.Links = true
+
+	localFs, err := fscache.Get(ctxNoLinks, "testdata")
