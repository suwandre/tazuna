+// writeSymlinkZip builds a zip file in dir containing a regular file
+// "file.txt", a symbolic link "link.txt" -> "file.txt" and a regular
+// file "real.rclonelink". It returns its leaf name.
+func writeSymlinkZip(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	add := func(entry, content string, mode os.FileMode) {
+		hdr := &zip.FileHeader{Name: entry}
+		hdr.SetMode(mode)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	add("file.txt", "hello\n", 0644)
+	add("link.txt", "file.txt", os.ModeSymlink|0777)
+	add("real.rclonelink", "not a link\n", 0644)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// listRemotes returns the remotes and sizes of every object in the
+// archive, recursing into directories. Directories map to -1.
+func listRemotes(ctx context.Context, t *testing.T, f fs.Fs, dir string) map[string]int64 {
+	entries, err := f.List(ctx, dir)
+	require.NoError(t, err)
+	got := make(map[string]int64, len(entries))
+	for _, entry := range entries {
+		if o, ok := entry.(fs.Object); ok {
+			got[o.Remote()] = o.Size()
+		} else {
+			got[entry.Remote()] = -1
+			for remote, size := range listRemotes(ctx, t, f, entry.Remote()) {
+				got[remote] = size
+			}
+		}
+	}
+	return got
+}
+
+// readObject reads back the whole content of the object at remote.
+func readObject(ctx context.Context, t *testing.T, f fs.Fs, remote string) string {
+	o, err := f.NewObject(ctx, remote)
+	require.NoError(t, err)
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	defer func() {
+		require.NoError(t, rc.Close())
+	}()
+	buf, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(buf)
+}
