+// A zip containing a symbolic link must hide it unless -l/--links is in
+// use, and then expose it as a .rclonelink object whose content is the
+// target. A regular file whose name ends in .rclonelink stays a regular
+// file.
+func TestSymlinks(t *testing.T) {
+	ctxNoLinks := context.Background()
+	ctxLinks, ci := fs.AddConfig(ctxNoLinks)
+	ci.Links = true
+
+	dir := t.TempDir()
+	name := writeSymlinkZip(t, dir, "test.zip")
+	localFs, err := cache.Get(ctxNoLinks, dir)
+	require.NoError(t, err)
+
+	t.Run("NoLinks", func(t *testing.T) {
+		f, err := New(ctxNoLinks, localFs, name, "", "")
+		require.NoError(t, err)
+
+		got := listRemotes(ctxNoLinks, t, f, "")
+		assert.Equal(t, map[string]int64{"file.txt": 6, "real.rclonelink": 11}, got)
+
+		_, err = f.NewObject(ctxNoLinks, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctxNoLinks, "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		f, err := New(ctxLinks, localFs, name, "", "")
+		require.NoError(t, err)
+
+		got := listRemotes(ctxLinks, t, f, "")
+		assert.Equal(t, map[string]int64{
+			"file.txt":                 6,
+			"link.txt" + fs.LinkSuffix: 8,
+			"real.rclonelink":          11,
+		}, got)
+
+		// The link is listed under its name plus the suffix, and its
+		// size is the length of the target
+		assert.Equal(t, "file.txt", readObject(ctxLinks, t, f, "link.txt"+fs.LinkSuffix))
+		// A regular member ending in .rclonelink is still a regular file
+		assert.Equal(t, "not a link\n", readObject(ctxLinks, t, f, "real.rclonelink"))
+	})
