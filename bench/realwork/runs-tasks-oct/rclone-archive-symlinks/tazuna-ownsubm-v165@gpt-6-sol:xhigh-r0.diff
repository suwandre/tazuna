+// TestReadZipSymlinks checks that ZIP symlinks use the same translated-link
+// representation as the local backend.
+func TestReadZipSymlinks(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	dir := t.TempDir()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+
+	w, err := zw.Create("src/file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file contents"))
+	require.NoError(t, err)
+
+	linkHeader := &zip.FileHeader{Name: "src/link.txt", Method: zip.Deflate}
+	linkHeader.SetMode(0777 | os.ModeSymlink)
+	w, err = zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+
+	linkHeader = &zip.FileHeader{Name: "src/regular", Method: zip.Deflate}
+	linkHeader.SetMode(0777 | os.ModeSymlink)
+	w, err = zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+
+	w, err = zw.Create("src/regular" + fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("regular file"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	zipPath := filepath.Join(dir, "links.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	noLinks, err := New(ctx, localFs, "links.zip", "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"src/file.txt", "src/regular" + fs.LinkSuffix}, allRemotes(t, noLinks))
+	_, err = noLinks.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ci.Links = true
+	withLinks, err := New(ctx, localFs, "links.zip", "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{
+		"src/file.txt",
+		"src/link.txt" + fs.LinkSuffix,
+		"src/regular" + fs.LinkSuffix,
+	}, allRemotes(t, withLinks))
+
+	link, err := withLinks.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	rc, err := link.Open(ctx, &fs.SeekOption{Offset: 2})
+	require.NoError(t, err)
+	got, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "le.txt", string(got))
+	rc, err = link.Open(ctx, &fs.RangeOption{Start: 1, End: 4})
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ile.", string(got))
+
+	regular, err := withLinks.NewObject(ctx, "src/regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	rc, err = regular.Open(ctx)
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "regular file", string(got))
+
+	single, err := New(ctx, localFs, "links.zip", "", "src/link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err := single.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+}
