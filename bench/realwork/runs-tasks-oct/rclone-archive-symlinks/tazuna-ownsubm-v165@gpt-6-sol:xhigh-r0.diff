+// TestSymlinks checks that squashfs symlinks use the translated-link
+// representation and are readable without following their targets.
+func TestSymlinks(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs is not installed")
+	}
+
+	ctx, ci := fs.AddConfig(context.Background())
+	source := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(source, "file.txt"), []byte("file contents"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(source, "regular"+fs.LinkSuffix), []byte("regular file"), 0600))
+	if err := os.Symlink("file.txt", filepath.Join(source, "link.txt")); err != nil {
+		t.Skipf("symbolic links are unavailable: %v", err)
+	}
+	if err := os.Symlink("file.txt", filepath.Join(source, "regular")); err != nil {
+		t.Skipf("symbolic links are unavailable: %v", err)
+	}
+	image := filepath.Join(t.TempDir(), "links.sqfs")
+	cmd := exec.Command(mksquashfs, source, image, "-no-progress")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("mksquashfs failed: %v\n%s", err, output)
+	}
+
+	localFs, err := fscache.Get(ctx, filepath.Dir(image))
+	require.NoError(t, err)
+	noLinks, err := New(ctx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err := noLinks.List(ctx, "")
+	require.NoError(t, err)
+	remotes := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "regular" + fs.LinkSuffix}, remotes)
+	_, err = noLinks.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ci.Links = true
+	withLinks, err := New(ctx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(ctx, "")
+	require.NoError(t, err)
+	remotes = make([]string, 0, len(entries))
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{
+		"file.txt",
+		"link.txt" + fs.LinkSuffix,
+		"regular" + fs.LinkSuffix,
+	}, remotes)
+
+	link, err := withLinks.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	rc, err := link.Open(ctx, &fs.RangeOption{Start: 1, End: 4})
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ile.", string(data))
+}
