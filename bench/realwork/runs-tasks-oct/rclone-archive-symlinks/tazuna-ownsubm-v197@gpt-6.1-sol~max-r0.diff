+// A symlink in an archive must not redirect writes from another archive
+// member outside the destination directory.
+func TestCopyZipSymlinkCannotEscapeDestination(t *testing.T) {
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("symlinks are unavailable: %v", err)
+	}
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	name := writeZipWithSymlink(t, dir, "evil.zip", "up", "../outside", map[string]string{
+		"up/inside.txt": "must stay inside",
+	})
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	src, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	destination := filepath.Join(t.TempDir(), "destination")
+	dst, err := localbackend.NewFs(ctx, "local", destination, configmap.Simple{})
+	require.NoError(t, err)
+
+	link, err := src.NewObject(ctx, "up.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, link.Remote(), link)
+	require.NoError(t, err)
+	linkTarget, err := os.Readlink(filepath.Join(destination, "up"))
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", linkTarget)
+	inside, err := src.NewObject(ctx, "up/inside.txt")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, inside.Remote(), inside)
+	assert.Error(t, err)
+
+	outsideFile := filepath.Join(filepath.Dir(destination), "outside", "inside.txt")
+	_, err = os.Stat(outsideFile)
+	assert.ErrorIs(t, err, os.ErrNotExist)
+}
