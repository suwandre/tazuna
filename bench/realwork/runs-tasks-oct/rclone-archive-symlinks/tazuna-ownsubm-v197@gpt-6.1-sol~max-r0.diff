+// Symlinks in squashfs images are exposed using rclone's translated-link names.
+func TestSquashfsSymlinks(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+	ctx := context.Background()
+	input := t.TempDir()
+	if err := os.Symlink("target.txt", filepath.Join(input, "link")); err != nil {
+		t.Skipf("symlinks are unavailable: %v", err)
+	}
+	require.NoError(t, os.WriteFile(filepath.Join(input, "target.txt"), []byte("target contents"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "ordinary.rclonelink"), []byte("ordinary file"), 0600))
+	image := filepath.Join(t.TempDir(), "links.sqfs")
+	cmd := exec.Command(mksquashfs, input, image, "-noappend", "-processors", "1", "-quiet")
+	output, err := cmd.CombinedOutput()
+	require.NoError(t, err, string(output))
+
+	localFs, err := fscache.Get(ctx, filepath.Dir(image))
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"target.txt", "ordinary.rclonelink"}, remotes)
+	_, err = f.NewObject(ctx, "link.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(ctx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err = f.List(ctx, "")
+	require.NoError(t, err)
+	remotes = remotes[:0]
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"target.txt", "ordinary.rclonelink", "link.rclonelink"}, remotes)
+
+	link, err := f.NewObject(ctx, "link.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("target.txt")), link.Size())
+	regular, err := f.NewObject(ctx, "ordinary.rclonelink")
+	require.NoError(t, err)
+	rc, err := regular.Open(ctx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "ordinary file", string(data))
+	for _, test := range []struct {
+		options []fs.OpenOption
+		want    string
+	}{
+		{want: "target.txt"},
+		{options: []fs.OpenOption{&fs.SeekOption{Offset: 7}}, want: "txt"},
+		{options: []fs.OpenOption{&fs.RangeOption{Start: 0, End: 5}}, want: "target"},
+	} {
+		rc, err := link.Open(ctx, test.options...)
+		require.NoError(t, err)
+		data, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, test.want, string(data))
+	}
+
+	rootFs, err := New(ctx, localFs, filepath.Base(image), "", "link.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = rootFs.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.rclonelink", entries[0].Remote())
+	_, err = rootFs.NewObject(ctx, "link.rclonelink")
+	require.NoError(t, err)
+}
