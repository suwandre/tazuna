+
+// linkEntry describes a zip entry for writeZipLinks.
+type linkEntry struct {
+	name, target string // target is the link target, or the contents if not a link
+	link         bool
+}
+
+// writeZipLinks builds a zip file in dir with the given entries, where
+// entries marked link are stored as symbolic links whose contents are
+// their target, and returns its leaf name.
+func writeZipLinks(t *testing.T, dir, name string, entries ...linkEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		hdr := &zip.FileHeader{
+			Name:     entry.name,
+			Method:   zip.Store,
+			Modified: time.Date(2026, 9, 28, 14, 16, 59, 0, time.UTC),
+		}
+		if entry.link {
+			hdr.SetMode(os.ModeSymlink | 0777)
+		} else {
+			hdr.SetMode(0666)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.target))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// linksContext returns a context with -l/--links set.
+func linksContext(ctx context.Context) context.Context {
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	return ctx
+}
+
+// newZipFs opens name in dir with -l/--links set if links is true.
+func newZipFs(ctx context.Context, t *testing.T, dir, name, root string, links bool) *Fs {
+	if links {
+		ctx = linksContext(ctx)
+	}
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", root)
+	if err != fs.ErrorIsFile {
+		require.NoError(t, err)
+	}
+	return f.(*Fs)
+}
+
+// listRemotes returns the sorted remotes of the objects in dir.
+func listRemotes(t *testing.T, f *Fs, dir string) []string {
+	entries, err := f.List(context.Background(), dir)
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		if _, ok := entry.(*Object); ok {
+			remotes = append(remotes, entry.Remote())
+		}
+	}
+	sort.Strings(remotes)
+	return remotes
+}
+
+// Symlinks in a zip are only exposed with -l/--links, under their name
+// plus .rclonelink, and their contents are the link target.
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipLinks(t, dir, "test.zip",
+		linkEntry{name: "src/file.txt", target: "hello"},
+		linkEntry{name: "src/link.txt", target: "file.txt", link: true},
+	)
+
+	t.Run("WithoutLinks", func(t *testing.T) {
+		f := newZipFs(ctx, t, dir, name, "", false)
+		assert.Equal(t, []string{"src/file.txt"}, listRemotes(t, f, "src"))
+		_, err := f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("WithLinks", func(t *testing.T) {
+		f := newZipFs(ctx, t, dir, name, "", true)
+		remote := "src/link.txt" + fs.LinkSuffix
+		assert.Equal(t, []string{"src/file.txt", remote}, listRemotes(t, f, "src"))
+
+		// The link is not exposed without the suffix
+		_, err := f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		o, err := f.NewObject(ctx, remote)
+		require.NoError(t, err)
+		assert.Equal(t, remote, o.Remote())
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(t, o))
+		assert.Equal(t, "2026-09-28 14:16:59 UTC", o.ModTime(ctx).UTC().Format("2006-01-02 15:04:05 MST"))
+
+		// Seek and range options are honoured
+		assert.Equal(t, "le.txt", readObject(t, o, &fs.SeekOption{Offset: 2}))
+		assert.Equal(t, "le", readObject(t, o, &fs.RangeOption{Start: 2, End: 3}))
+		// An offset past the end reads empty rather than panicking
+		assert.Equal(t, "", readObject(t, o, &fs.SeekOption{Offset: 100}))
+		assert.Equal(t, "xt", readObject(t, o, &fs.RangeOption{Start: -1, End: 2}))
+	})
+
+	t.Run("RootAtLink", func(t *testing.T) {
+		f := newZipFs(ctx, t, dir, name, "src/link.txt"+fs.LinkSuffix, true)
+		assert.Equal(t, []string{"link.txt" + fs.LinkSuffix}, listRemotes(t, f, ""))
+	})
+}
+
+// A regular member whose name ends in .rclonelink is still a regular
+// file and takes precedence over a symlink which would translate to
+// the same name.
+func TestSymlinkNameClash(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipLinks(t, dir, "test.zip",
+		linkEntry{name: "real.txt", target: "not a link"},
+		linkEntry{name: "real.txt" + fs.LinkSuffix, target: "also not a link"},
+		linkEntry{name: "other.txt", target: "target", link: true},
+		linkEntry{name: "other.txt" + fs.LinkSuffix, target: "clashing member"},
+	)
+
+	f := newZipFs(ctx, t, dir, name, "", true)
+	assert.Equal(t, []string{
+		"other.txt" + fs.LinkSuffix,
+		"real.txt",
+		"real.txt" + fs.LinkSuffix,
+	}, listRemotes(t, f, ""))
+
+	// The clashing member is the regular one, not the link
+	o, err := f.NewObject(ctx, "other.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, "clashing member", readObject(t, o))
+}
+
+// A symlink stored with an absurdly long target is skipped rather than
+// read into memory.
+func TestSymlinkTargetTooLong(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipLinks(t, dir, "test.zip",
+		linkEntry{name: "huge", target: strings.Repeat("x", maxLinkTargetSize+1), link: true},
+		linkEntry{name: "good.txt", target: "hello"},
+	)
+
+	f := newZipFs(ctx, t, dir, name, "", true)
+	assert.Equal(t, []string{"good.txt"}, listRemotes(t, f, ""))
+}
+
+// readObject reads the whole object, or the part of it the options
+// select.
+func readObject(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	in, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	buf, err := io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	return string(buf)
+}
