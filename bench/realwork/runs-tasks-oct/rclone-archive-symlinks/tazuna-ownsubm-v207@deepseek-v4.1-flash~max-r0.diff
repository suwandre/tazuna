 		assert.Equal(t, test.want, isDirectChild(test.dir, test.remote), "dir=%q remote=%q", test.dir, test.remote)
 	}
 }
+
+// zipEntry is an entry of a zip file built by writeZip.
+type zipEntry struct {
+	name     string
+	contents string
+	link     bool // store as a symbolic link with contents as the target
+}
+
+// writeZip builds a zip file called name in dir with the entries passed
+// in and returns its path.
+func writeZip(t *testing.T, dir, name string, entries ...zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		hdr := &zip.FileHeader{Name: entry.name, Method: zip.Store}
+		if entry.link {
+			hdr.SetMode(os.ModeSymlink | 0777)
+		} else {
+			hdr.SetMode(0666)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.contents))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(dir, name)
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+	return zipPath
+}
+
+// TestArchiveSymlinks checks that symlinks in an archive are exposed
+// with -l/--links and copied to a destination as symlinks.
+func TestArchiveSymlinks(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	dir := t.TempDir()
+	zipPath := writeZip(t, dir, "test.zip",
+		zipEntry{name: "src/file.txt", contents: "hello"},
+		zipEntry{name: "src/link.txt", contents: "file.txt", link: true},
+	)
+	// The images in each directory are separate so the fs cache doesn't
+	// hand one subtest the other's archive
+	sqfsDir := filepath.Join(dir, "sqfs")
+	require.NoError(t, os.Mkdir(sqfsDir, 0777))
+	sqfsPath := copySquashfsTestdata(t, sqfsDir, "symlink.sqfs")
+
+	for _, archive := range []struct {
+		name  string
+		path  string
+		dir   string // the directory in the archive holding the symlink
+		where string // where the symlink ends up on the destination
+	}{
+		{name: "Zip", path: zipPath, dir: "src", where: filepath.Join("src", "link.txt")},
+		{name: "Squashfs", path: sqfsPath, dir: "", where: "link.txt"},
+	} {
+		t.Run(archive.name, func(t *testing.T) {
+			f, err := cache.Get(ctx, ":archive:"+archive.path)
+			require.NoError(t, err)
+
+			// The symlink is listed under its name plus the suffix
+			entries, err := f.List(ctx, archive.dir)
+			require.NoError(t, err)
+			var remotes []string
+			for _, entry := range entries {
+				remotes = append(remotes, entry.Remote())
+			}
+			fileRemote := path.Join(archive.dir, "file.txt")
+			linkRemote := path.Join(archive.dir, "link.txt") + fs.LinkSuffix
+			assert.Contains(t, remotes, fileRemote)
+			assert.Contains(t, remotes, linkRemote)
+
+			// Copying recreates the symlink on the destination
+			dst := t.TempDir()
+			dstFs, err := cache.Get(ctx, dst)
+			require.NoError(t, err)
+			src, err := f.NewObject(ctx, linkRemote)
+			require.NoError(t, err)
+			_, err = operations.Copy(ctx, dstFs, nil, linkRemote, src)
+			require.NoError(t, err)
+			target, err := os.Readlink(filepath.Join(dst, archive.where))
+			require.NoError(t, err)
+			assert.Equal(t, "file.txt", target)
+		})
+	}
+}
+
+// copySquashfsTestdata copies the named image from the squashfs
+// package's testdata into dir, returning its path.
+func copySquashfsTestdata(t *testing.T, dir, name string) string {
+	data, err := os.ReadFile(filepath.Join("squashfs", "testdata", name))
+	require.NoError(t, err)
+	path := filepath.Join(dir, name)
+	require.NoError(t, os.WriteFile(path, data, 0600))
+	return path
+}
+
+// TestArchiveSymlinkEscape checks that a hostile archive can't make a
+// copy write outside the destination, by planting a symlink pointing
+// above the root and a member "inside" it.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	// The directory the attacker wants to write into
+	evil := t.TempDir()
+	evilFile := filepath.Join(evil, "authkeys")
+
+	zipPath := writeZip(t, t.TempDir(), "evil.zip",
+		zipEntry{name: "pwn", contents: evil, link: true},
+		zipEntry{name: "pwn/authkeys", contents: "PWNED"},
+	)
+
+	f, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	dst := t.TempDir()
+	dstFs, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+	_ = sync.CopyDir(ctx, dstFs, f, false)
+
+	// The symlink is reproduced faithfully, but nothing escaped the
+	// destination through it
+	target, err := os.Readlink(filepath.Join(dst, "pwn"))
+	require.NoError(t, err)
+	assert.Equal(t, evil, target)
+	_, err = os.Stat(evilFile)
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evilFile)
+}
