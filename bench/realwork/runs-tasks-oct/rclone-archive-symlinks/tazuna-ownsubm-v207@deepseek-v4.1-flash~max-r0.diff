+		require.ErrorIs(t, err, fs.ErrorIsFile)
+		assert.Equal(t, []string{"link.txt" + fs.LinkSuffix}, listNames(t, f.(*Fs), ""))
+		o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", readObject(t, o))
+	})
+
+	t.Run("NameClash", func(t *testing.T) {
+		// A regular member whose name ends in .rclonelink stays a
+		// regular file, and takes precedence over a symlink which
+		// would translate to the same name
+		f := openTestdata(t, "symlink.sqfs", true)
+		o, err := f.NewObject(context.Background(), "notalink"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "regular", readObject(t, o))
+		o, err = f.NewObject(context.Background(), "clash"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "clash member", readObject(t, o))
+	})
+}
