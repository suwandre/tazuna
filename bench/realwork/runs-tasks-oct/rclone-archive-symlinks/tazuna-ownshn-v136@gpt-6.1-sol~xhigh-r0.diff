new file mode 100644
index 0000000..1e772a3
--- /dev/null
+++ b/backend/archive/symlinks_test.go
@@ -0,0 +1,195 @@
+//go:build !plan9
+
+package archive
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/cache"
+	"github.com/rclone/rclone/fs/config/configmap"
+	"github.com/rclone/rclone/fs/operations"
+	"github.com/rclone/rclone/fs/sync"
+	"github.com/rclone/rclone/fstest"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type linkArchiveEntry struct {
+	name, content string
+	mode          os.FileMode
+}
+
+func writeLinkZip(t *testing.T, entries []linkArchiveEntry) string {
+	t.Helper()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		header := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+		header.SetMode(entry.mode)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = io.WriteString(w, entry.content)
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	name := filepath.Join(t.TempDir(), "links.zip")
+	require.NoError(t, os.WriteFile(name, buf.Bytes(), 0600))
+	return name
+}
+
+// The squashfs fixture contains the same tree as the ZIP below. It is built
+// with mksquashfs input symlinks.sqfs -noappend -no-xattrs -all-root
+// -mkfs-time 0 -all-time 0.
+func TestArchiveSymlinks(t *testing.T) {
+	fstest.Initialise()
+	zipPath := writeLinkZip(t, []linkArchiveEntry{
+		{"sub/file.txt", "hello", 0644},
+		{"sub/regular.rclonelink", "regular data", 0644},
+		{"sub/link.txt", "file.txt", os.ModeSymlink | 0777},
+		{"sub/dirlink", ".", os.ModeSymlink | 0777},
+		{"sub/dangling", "missing", os.ModeSymlink | 0777},
+		{"sub/loop", "loop", os.ModeSymlink | 0777},
+		{"sub/suffixed.rclonelink", "file.txt", os.ModeSymlink | 0777},
+	})
+	sqfsPath, err := filepath.Abs("squashfs/testdata/symlinks.sqfs")
+	require.NoError(t, err)
+	for _, archivePath := range []string{zipPath, sqfsPath} {
+		t.Run(filepath.Ext(archivePath), func(t *testing.T) {
+			for _, links := range []bool{false, true} {
+				t.Run(fmt.Sprint(links), func(t *testing.T) {
+					ctx, ci := fs.AddConfig(context.Background())
+					ci.Links = links
+					for _, mount := range []struct {
+						root, dir, prefix string
+					}{
+						{archivePath, "sub", "sub/"},
+						{archivePath + "/sub", "", ""},
+					} {
+						t.Run(mount.dir+"@"+mount.root, func(t *testing.T) {
+							f, err := NewFs(ctx, "archive", mount.root, configmap.Simple{})
+							require.NoError(t, err)
+							entries, err := f.List(ctx, mount.dir)
+							require.NoError(t, err)
+							want := map[string]string{
+								"file.txt":           "hello",
+								"regular.rclonelink": "regular data",
+							}
+							if links {
+								for name, target := range map[string]string{
+									"link.txt": "file.txt", "dirlink": ".", "dangling": "missing",
+									"loop": "loop", "suffixed.rclonelink": "file.txt",
+								} {
+									want[name+fs.LinkSuffix] = target
+								}
+							}
+							require.Len(t, entries, len(want))
+							for _, entry := range entries {
+								name := entry.Remote()[len(mount.prefix):]
+								content, ok := want[name]
+								require.True(t, ok, "unexpected entry %q", entry.Remote())
+								o, err := f.NewObject(ctx, entry.Remote())
+								require.NoError(t, err)
+								assert.Equal(t, entry.Remote(), o.Remote())
+								assert.Equal(t, int64(len(content)), entry.Size())
+								assert.Equal(t, entry.Size(), o.Size())
+								assert.Equal(t, content, readLinkObject(t, ctx, o))
+							}
+							for _, name := range []string{"link.txt", "dirlink", "dangling", "loop", "suffixed.rclonelink"} {
+								_, err := f.NewObject(ctx, mount.prefix+name)
+								assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+								if !links {
+									_, err = f.NewObject(ctx, mount.prefix+name+fs.LinkSuffix)
+									assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+								}
+							}
+							if links {
+								o, err := f.NewObject(ctx, mount.prefix+"link.txt"+fs.LinkSuffix)
+								require.NoError(t, err)
+								assert.Equal(t, "ile", readLinkObject(t, ctx, o, &fs.RangeOption{Start: 1, End: 3}))
+								assert.Equal(t, ".txt", readLinkObject(t, ctx, o, &fs.SeekOption{Offset: 4}))
+								assert.Equal(t, "txt", readLinkObject(t, ctx, o, &fs.RangeOption{Start: -1, End: 3}))
+							}
+						})
+					}
+				})
+			}
+		})
+	}
+}
+
+func readLinkObject(t *testing.T, ctx context.Context, o fs.Object, options ...fs.OpenOption) string {
+	t.Helper()
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
+
+func TestArchiveCopySymlink(t *testing.T) {
+	fstest.Initialise()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "probe")); err != nil {
+		t.Skipf("symlinks not supported: %v", err)
+	}
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	zipPath := writeLinkZip(t, []linkArchiveEntry{{"link.txt", "file.txt", os.ModeSymlink | 0777}})
+	sqfsPath, err := filepath.Abs("squashfs/testdata/symlinks.sqfs")
+	require.NoError(t, err)
+	for _, test := range []struct{ archive, remote string }{
+		{zipPath, "link.txt" + fs.LinkSuffix},
+		{sqfsPath, "sub/link.txt" + fs.LinkSuffix},
+	} {
+		t.Run(filepath.Ext(test.archive), func(t *testing.T) {
+			f, err := NewFs(ctx, "archive", test.archive, configmap.Simple{})
+			require.NoError(t, err)
+			o, err := f.NewObject(ctx, test.remote)
+			require.NoError(t, err)
+			dir := t.TempDir()
+			dst, err := cache.Get(ctx, dir)
+			require.NoError(t, err)
+			_, err = operations.Copy(ctx, dst, nil, test.remote, o)
+			require.NoError(t, err)
+			target, err := os.Readlink(filepath.Join(dir, filepath.FromSlash(test.remote[:len(test.remote)-len(fs.LinkSuffix)])))
+			require.NoError(t, err)
+			assert.Equal(t, "file.txt", target)
+		})
+	}
+}
+
+func TestArchiveCopySymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "probe")); err != nil {
+		t.Skipf("symlinks not supported: %v", err)
+	}
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	ci.LowLevelRetries = 1
+	dir := t.TempDir()
+	require.NoError(t, os.Mkdir(filepath.Join(dir, "outside"), 0700))
+	zipPath := writeLinkZip(t, []linkArchiveEntry{
+		{"escape", "../outside", os.ModeSymlink | 0777},
+		{"escape/pwned.txt", "must not escape", 0644},
+	})
+	f, err := NewFs(ctx, "archive", zipPath, configmap.Simple{})
+	require.NoError(t, err)
+	dst, err := cache.Get(ctx, filepath.Join(dir, "out"))
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, dst, f, false))
+	_, err = f.NewObject(ctx, "escape/pwned.txt")
+	require.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	target, err := os.Readlink(filepath.Join(dir, "out", "escape"))
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", target)
+	_, err = os.Stat(filepath.Join(dir, "outside", "pwned.txt"))
+	assert.True(t, os.IsNotExist(err), "file written outside destination: %v", err)
+}
