+// TestArchiveZipLinks checks that a symbolic link in a zip is exposed
+// with -l/--links and can be copied out to recreate it as a symlink.
+func TestArchiveZipLinks(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("src/file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("hello"))
+	require.NoError(t, err)
+	hdr := &zip.FileHeader{Name: "src/link.txt", Method: zip.Store}
+	hdr.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(hdr)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	dir := t.TempDir()
+	zipPath := filepath.Join(dir, "test.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	f, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/link.txt.rclonelink"}, remotes)
+
+	// Copy the archive out to a local destination, which should
+	// recreate the symlink rather than a file holding the target.
+	out := t.TempDir()
+	fdst, err := cache.Get(ctx, out)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, fdst, f, false))
+
+	target, err := os.Readlink(filepath.Join(out, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+// TestArchiveSquashfsLinks checks that a symbolic link in a squashfs
+// image is exposed with -l/--links and copied out as a symlink.
+func TestArchiveSquashfsLinks(t *testing.T) {
