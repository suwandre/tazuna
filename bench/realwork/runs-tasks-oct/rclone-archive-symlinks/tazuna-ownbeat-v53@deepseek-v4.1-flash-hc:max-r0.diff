+// TestArchiveHostileLinkBlocked checks that a hostile archive containing
+// a symlink pointing above the destination plus a member "inside" it
+// cannot make a copy write outside the destination (CWE-59).
+func TestArchiveHostileLinkBlocked(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	// The directory outside the destination the archive wants to write into
+	evil := t.TempDir()
+	evilFile := filepath.Join(evil, "authkeys")
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	// A symlink "pwn" pointing outside the destination
+	hdr := &zip.FileHeader{Name: "pwn", Method: zip.Store}
+	hdr.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(hdr)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(evil))
+	require.NoError(t, err)
+	// A member which would be written through the planted symlink
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	dir := t.TempDir()
+	zipPath := filepath.Join(dir, "evil.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	fsrc, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	out := t.TempDir()
+	fdst, err := cache.Get(ctx, out)
+	require.NoError(t, err)
+	// The symlink is reproduced faithfully but nothing may be written
+	// through it outside the destination.
+	_ = sync.CopyDir(ctx, fdst, fsrc, false)
+
+	_, err = os.Stat(evilFile)
+	require.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evilFile)
+}
