+// writeZipLink adds a symbolic link entry named name with the given
+// target to the zip writer.
+func writeZipLink(t *testing.T, zw *zip.Writer, name, target string) {
+	hdr := &zip.FileHeader{Name: name, Method: zip.Store}
+	// Mark the entry as a Unix symlink so the zip reader reports
+	// os.ModeSymlink from FileHeader.Mode()
+	hdr.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(hdr)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(target))
+	require.NoError(t, err)
+}
+
+// writeZipWithLinks builds a zip file containing a regular file, a
+// symbolic link and a link inside a subdirectory, and returns its leaf
+// name.
+func writeZipWithLinks(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("src/file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("hello"))
+	require.NoError(t, err)
+	writeZipLink(t, zw, "src/link.txt", "file.txt")
+	writeZipLink(t, zw, "src/evil", "../../outside")
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// linksCtx returns a context with -l/--links enabled.
+func linksCtx(ctx context.Context) context.Context {
+	newCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	return newCtx
+}
