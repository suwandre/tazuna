+// MaxLinkTargetSize is the largest symlink target accepted from an
+// archive, comfortably above any OS path limit (Windows allows 32767
+// UTF-16 units).
+const MaxLinkTargetSize = 128 * 1024
+
+// OpenLink returns a reader over the symlink target passed in,
+// honouring offset and limit as if the target were the contents of a
+// file.
+func OpenLink(target string, offset, limit int64) io.ReadCloser {
+	// Clamp offset into range to avoid panic
+	if offset < 0 {
+		offset = 0
+	}
+	if offset > int64(len(target)) {
+		offset = int64(len(target))
+	}
+	return readers.NewLimitedReadCloser(io.NopCloser(strings.NewReader(target[offset:])), limit)
+}
