+
+// With -l/--links a symbolic link is exposed under its name plus the
+// .rclonelink suffix, its size is the length of the target and opening
+// it reads the target back, honouring seek and range options.
+func TestReadZipLinksEnabled(t *testing.T) {
+	ctx := linksCtx(context.Background())
+	dir := t.TempDir()
+	name := writeZipWithLinks(t, dir, "links.zip")
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	want := []string{"src/evil.rclonelink", "src/file.txt", "src/link.txt.rclonelink"}
+	assert.Equal(t, want, allRemotes(t, f))
+
+	o, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file.txt", string(data))
+
+	// Seek and range options are honoured
+	rc, err = o.Open(ctx, &fs.SeekOption{Offset: 5})
+	require.NoError(t, err)
+	data, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "txt", string(data))
+
+	rc, err = o.Open(ctx, &fs.RangeOption{Start: 0, End: 3})
+	require.NoError(t, err)
+	data, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file", string(data))
+
+	// A hostile link target is exposed verbatim, not resolved
+	o, err = f.NewObject(ctx, "src/evil.rclonelink")
+	require.NoError(t, err)
+	rc, err = o.Open(ctx)
+	require.NoError(t, err)
+	data, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "../../outside", string(data))
+
+	// Listing and NewObject must agree
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	for _, entry := range entries {
+		_, err := f.NewObject(ctx, entry.Remote())
+		assert.NoError(t, err, entry.Remote())
+	}
+}
