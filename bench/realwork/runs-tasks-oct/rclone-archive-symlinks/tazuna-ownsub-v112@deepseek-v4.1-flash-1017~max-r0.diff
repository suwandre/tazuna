+package archiver
+
+import (
+	"io"
+	"strings"
+
+	"github.com/rclone/rclone/lib/readers"
+)
+
+// OpenLink returns the target of a symbolic link as an io.ReadCloser,
+// honouring the offset and limit passed in.
+//
+// The offset is clamped to the length of the target so seeking past the
+// end reads nothing rather than panicking.
+func OpenLink(target string, offset, limit int64) io.ReadCloser {
+	if offset < 0 {
+		offset = 0
+	}
+	if offset > int64(len(target)) {
+		offset = int64(len(target))
+	}
+	return readers.NewLimitedReadCloser(io.NopCloser(strings.NewReader(target[offset:])), limit)
+}
