+// readLinkTarget returns the target of the symbolic link stored in file.
+//
+// The target is read through a limit so a hostile archive can't make
+// the listing read an unbounded amount of data.
+func readLinkTarget(file *zip.File) (target string, err error) {
+	rc, err := file.Open()
+	if err != nil {
+		return "", err
+	}
+	defer fs.CheckClose(rc, &err)
+	buf, err := io.ReadAll(io.LimitReader(rc, maxLinkTargetSize+1))
+	if err != nil {
+		return "", err
+	}
+	if len(buf) > maxLinkTargetSize {
+		return "", errors.New("symlink target is too long")
+	}
+	return string(buf), nil
