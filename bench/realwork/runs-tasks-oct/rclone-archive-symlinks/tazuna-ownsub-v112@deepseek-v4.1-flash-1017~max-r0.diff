+// addZipFile writes a regular file entry to zw.
+func addZipFile(t *testing.T, zw *zip.Writer, name, contents string) {
+	w, err := zw.Create(name)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(contents))
+	require.NoError(t, err)
+}
+
+// addZipSymlink writes a symbolic link entry to zw whose data is target.
+func addZipSymlink(t *testing.T, zw *zip.Writer, name, target string) {
+	hdr := &zip.FileHeader{Name: name, Method: zip.Store}
+	hdr.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(hdr)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(target))
+	require.NoError(t, err)
+}
+
+// writeZipArchive writes a zip file in dir built by write and returns its path.
+func writeZipArchive(t *testing.T, dir string, write func(zw *zip.Writer)) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	write(zw)
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(dir, "test.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+	return zipPath
+}
+
+// TestArchiveCopyLinks checks that copying an archive with --links
+// recreates its symlinks at the destination.
+func TestArchiveCopyLinks(t *testing.T) {
+	skipIfNoSymlinks(t)
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	dir := t.TempDir()
+	zipPath := writeZipArchive(t, dir, func(zw *zip.Writer) {
+		addZipFile(t, zw, "src/file.txt", "hello")
+		addZipSymlink(t, zw, "src/link.txt", "file.txt")
+	})
+
+	fsrc, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dst := filepath.Join(t.TempDir(), "out")
+	fdst, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+
+	require.NoError(t, sync.CopyDir(ctx, fdst, fsrc, false))
+
+	linkPath := filepath.Join(dst, "src", "link.txt")
+	fi, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	require.True(t, fi.Mode()&os.ModeSymlink != 0, "destination should be a symlink")
+	target, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+
+	data, err := os.ReadFile(filepath.Join(dst, "src", "file.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "hello", string(data))
+}
+
+// TestArchiveCopyLinksEscape checks that a hostile archive containing a
+// symlink pointing above the destination plus a member "inside" it
+// can't make a copy write outside the destination.
+func TestArchiveCopyLinksEscape(t *testing.T) {
+	skipIfNoSymlinks(t)
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	evil := t.TempDir()
+	evilFile := filepath.Join(evil, "authkeys")
+
+	dir := t.TempDir()
+	zipPath := writeZipArchive(t, dir, func(zw *zip.Writer) {
+		addZipSymlink(t, zw, "pwn", evil)
+		addZipFile(t, zw, "pwn/authkeys", "PWNED")
+	})
+
+	fsrc, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dst := filepath.Join(t.TempDir(), "out")
+	fdst, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+
+	// The copy may fail - what matters is that nothing escapes
+	_ = sync.CopyDir(ctx, fdst, fsrc, false)
+
+	_, err = os.Stat(evilFile)
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evilFile)
+}
+
+// skipIfNoSymlinks skips the test if this process can't create symlinks.
+func skipIfNoSymlinks(t *testing.T) {
+	t.Helper()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("Skipping as symlinks are unavailable: %v", err)
+	}
+}
