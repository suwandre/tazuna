+// writeZipWithLinks is writeZip with symlink entries added, each given
+// as a {name, target} pair.
+func writeZipWithLinks(t *testing.T, dir, name string, regular []string, links ...[2]string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, n := range regular {
+		w, err := zw.Create(n)
+		require.NoError(t, err)
+		_, err = w.Write([]byte("data for " + n))
+		require.NoError(t, err)
+	}
+	for _, link := range links {
+		hdr := &zip.FileHeader{Name: link[0], Method: zip.Store}
+		hdr.SetMode(os.ModeSymlink | 0777)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(link[1]))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
