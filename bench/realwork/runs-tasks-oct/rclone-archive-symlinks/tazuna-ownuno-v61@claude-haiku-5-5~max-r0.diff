+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(t, linksCtx, o))
+		assert.Equal(t, "le.txt", readObject(t, linksCtx, o, &fs.SeekOption{Offset: 2}))
+		assert.Equal(t, "le.t", readObject(t, linksCtx, o, &fs.RangeOption{Start: 2, End: 5}))
+
+		o, err = f.NewObject(linksCtx, "data.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(4), o.Size())
+		assert.Equal(t, "data", readObject(t, linksCtx, o))
