+// writeSymlinkZip creates a ZIP archive containing a regular file, a symlink,
+// and a regular file whose name ends with the link suffix.
+func writeSymlinkZip(t *testing.T, dir, name, linkTarget string, hostile bool) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	entries := []struct {
+		name string
+		mode os.FileMode
+		data string
+	}{
+		{name: "src/file.txt", mode: 0644, data: "file contents"},
+		{name: "src/link.txt", mode: os.ModeSymlink | 0777, data: linkTarget},
+		{name: "src/regular" + fs.LinkSuffix, mode: 0644, data: "regular file"},
+	}
+	if hostile {
+		entries = append(entries, struct {
+			name string
+			mode os.FileMode
+			data string
+		}{name: "src/link.txt/escape.txt", mode: 0644, data: "hostile member"})
+	}
+	for _, entry := range entries {
+		header := &zip.FileHeader{Name: entry.name}
+		header.SetMode(entry.mode)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.data))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+func readObject(t *testing.T, obj fs.Object, options ...fs.OpenOption) []byte {
+	rc, err := obj.Open(context.Background(), options...)
+	require.NoError(t, err)
+	defer func() { require.NoError(t, rc.Close()) }()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return data
+}
+
+// ZIP symlinks are exposed as translated link files only when links are
+// enabled, while regular members ending in the suffix retain their names.
+func TestReadZipSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	name := writeSymlinkZip(t, dir, "links.zip", "file.txt", false)
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = false
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	withoutLinks, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err := withoutLinks.List(ctx, "src")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"src/file.txt", "src/regular" + fs.LinkSuffix}, []string{entries[0].Remote(), entries[1].Remote()})
+	_, err = withoutLinks.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctx, ci = fs.AddConfig(context.Background())
+	ci.Links = true
+	localFs, err = cache.Get(ctx, dir)
+	require.NoError(t, err)
+	withLinks, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(ctx, "src")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix, "src/regular" + fs.LinkSuffix}, []string{entries[0].Remote(), entries[1].Remote(), entries[2].Remote()})
+
+	link, err := withLinks.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	assert.Equal(t, []byte("file.txt"), readObject(t, link))
+	assert.Equal(t, []byte("le.txt"), readObject(t, link, &fs.SeekOption{Offset: 2}))
+	assert.Equal(t, []byte("ile"), readObject(t, link, &fs.RangeOption{Start: 1, End: 3}))
+
+	regular, err := withLinks.NewObject(ctx, "src/regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, []byte("regular file"), readObject(t, regular))
+
+	// Looking up a link as the archive root uses the same translated name.
+	rootFs, err := New(ctx, localFs, name, "", "src/link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorIsFile)
+	require.NotNil(t, rootFs)
+	entries, err = rootFs.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+	_, err = rootFs.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+}
