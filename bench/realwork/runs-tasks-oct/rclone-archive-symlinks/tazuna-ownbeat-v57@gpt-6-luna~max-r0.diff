+// Squashfs symlinks are exposed using the same translated-link convention as
+// the local backend.
+func TestSymlinkTranslation(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+	ctx := context.Background()
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "target.txt"), []byte("target data"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "regular"+fs.LinkSuffix), []byte("regular data"), 0600))
+	if err := os.Symlink("target.txt", filepath.Join(input, "link.txt")); err != nil {
+		t.Skipf("can't create symlink: %v", err)
+	}
+	if err := os.Symlink("target.txt", filepath.Join(input, "link2.txt")); err != nil {
+		t.Skipf("can't create symlink: %v", err)
+	}
+	image := filepath.Join(t.TempDir(), "links.sqfs")
+	cmd := exec.Command(mksquashfs, input, image, "-noappend", "-processors", "1", "-no-progress", "-quiet")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("mksquashfs failed: %v\n%s", err, output)
+	}
+
+	localFs, err := fscache.Get(ctx, filepath.Dir(image))
+	require.NoError(t, err)
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = false
+	withoutLinks, err := New(ctx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err := withoutLinks.List(ctx, "")
+	require.NoError(t, err)
+	assert.Len(t, entries, 2)
+	_, err = withoutLinks.NewObject(ctx, "link2.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctx, ci = fs.AddConfig(context.Background())
+	ci.Links = true
+	withLinks, err := New(ctx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(ctx, "")
+	require.NoError(t, err)
+	assert.Len(t, entries, 4)
+	link, err := withLinks.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("target.txt")), link.Size())
+	assert.Equal(t, "target.txt", readSquashfsObject(t, link))
+	assert.Equal(t, "rget.txt", readSquashfsObject(t, link, &fs.SeekOption{Offset: 2}))
+	assert.Equal(t, "arge", readSquashfsObject(t, link, &fs.RangeOption{Start: 1, End: 4}))
+
+	regular, err := withLinks.NewObject(ctx, "regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, "regular data", readSquashfsObject(t, regular))
+
+	rootFs, err := New(ctx, localFs, filepath.Base(image), "", "link2.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorIsFile)
+	require.NotNil(t, rootFs)
+	entries, err = rootFs.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link2.txt"+fs.LinkSuffix, entries[0].Remote())
+	_, err = rootFs.NewObject(ctx, "link2.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+}
+
+func readSquashfsObject(t *testing.T, obj fs.Object, options ...fs.OpenOption) string {
+	rc, err := obj.Open(context.Background(), options...)
+	require.NoError(t, err)
+	defer func() { require.NoError(t, rc.Close()) }()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(data)
+}
