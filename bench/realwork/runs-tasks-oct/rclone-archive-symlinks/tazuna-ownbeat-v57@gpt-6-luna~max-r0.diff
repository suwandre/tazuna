+// Copying a ZIP symlink with links enabled recreates it as a symlink. A
+// member below a hostile symlink cannot write outside the destination.
+func TestCopyZipSymlinkSafety(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	name := writeSymlinkZip(t, dir, "links.zip", "file.txt", false)
+	attackName := writeSymlinkZip(t, dir, "hostile.zip", "../../escape", true)
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	src, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	dest := filepath.Join(dir, "out")
+	dst, err := cache.Get(ctx, dest)
+	require.NoError(t, err)
+	require.NoError(t, syncer.CopyDir(ctx, dst, src, false))
+	linkPath := filepath.Join(dest, "src", "link.txt")
+	linkInfo, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	assert.NotEqual(t, 0, linkInfo.Mode()&os.ModeSymlink)
+	target, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+
+	// Simulate transfer of a member stored below a hostile symlink. local's
+	// rooted writes must refuse to follow the symlink outside the destination.
+	attackSrc, err := New(ctx, localFs, attackName, "", "")
+	require.NoError(t, err)
+	attackLink, err := attackSrc.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, attackLink.Remote(), attackLink)
+	require.NoError(t, err)
+	child, err := attackSrc.NewObject(ctx, "src/link.txt/escape.txt")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, child.Remote(), child)
+	assert.Error(t, err)
+	assert.NoFileExists(t, filepath.Join(dir, "escape", "escape.txt"))
+}
