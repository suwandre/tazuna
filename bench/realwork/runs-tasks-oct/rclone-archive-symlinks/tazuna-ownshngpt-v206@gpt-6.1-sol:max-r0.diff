+func TestSymlinks(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+
+	ctx := context.Background()
+	dir := t.TempDir()
+	input := filepath.Join(dir, "input")
+	require.NoError(t, os.Mkdir(input, 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("contents"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "regular"+fs.LinkSuffix), []byte("regular"), 0600))
+	if err := os.Symlink("file.txt", filepath.Join(input, "link.txt")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	image := filepath.Join(dir, "test.sqfs")
+	cmd := exec.Command(mksquashfs, input, image, "-noappend", "-no-progress", "-processors", "1")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("mksquashfs failed: %v\n%s", err, output)
+	}
+
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	ctxNoLinks, ci := fs.AddConfig(ctx)
+	ci.Links = false
+	withoutLinks, err := New(ctxNoLinks, localFs, "test.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := withoutLinks.List(ctxNoLinks, "")
+	require.NoError(t, err)
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "regular" + fs.LinkSuffix}, names)
+	_, err = withoutLinks.NewObject(ctxNoLinks, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = withoutLinks.NewObject(ctxNoLinks, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctxLinks, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	withLinks, err := New(ctxLinks, localFs, "test.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(ctxLinks, "")
+	require.NoError(t, err)
+	names = names[:0]
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "link.txt" + fs.LinkSuffix, "regular" + fs.LinkSuffix}, names)
+
+	link, err := withLinks.NewObject(ctxLinks, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	for _, test := range []struct {
+		option fs.OpenOption
+		want   string
+	}{
+		{nil, "file.txt"},
+		{&fs.SeekOption{Offset: 2}, "le.txt"},
+		{&fs.RangeOption{Start: 2, End: 4}, "le."},
+	} {
+		var options []fs.OpenOption
+		if test.option != nil {
+			options = append(options, test.option)
+		}
+		rc, err := link.Open(ctxLinks, options...)
+		require.NoError(t, err)
+		contents, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, test.want, string(contents))
+	}
+	_, err = withLinks.NewObject(ctxLinks, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	regular, err := withLinks.NewObject(ctxLinks, "regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	rc, err := regular.Open(ctxLinks)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "regular", string(contents))
+
+	singleLink, err := New(ctxLinks, localFs, "test.sqfs", "", "link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = singleLink.List(ctxLinks, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+	_, err = singleLink.NewObject(ctxLinks, entries[0].Remote())
+	require.NoError(t, err)
+
+	singleRegular, err := New(ctxLinks, localFs, "test.sqfs", "", "regular"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = singleRegular.List(ctxLinks, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "regular"+fs.LinkSuffix, entries[0].Remote())
+	_, err = singleRegular.NewObject(ctxLinks, entries[0].Remote())
+	require.NoError(t, err)
+}
