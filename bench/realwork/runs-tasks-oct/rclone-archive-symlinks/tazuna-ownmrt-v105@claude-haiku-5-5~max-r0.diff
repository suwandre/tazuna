+// writeZipSymlinks builds a zip file in dir with the regular files in
+// files (name -> content) and the symlinks in links (name -> target),
+// and returns its leaf name.
+func writeZipSymlinks(t *testing.T, dir, name string, files, links map[string]string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for n, content := range files {
+		w, err := zw.Create(n)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	for n, target := range links {
+		hdr := &zip.FileHeader{Name: n, Method: zip.Store}
+		hdr.SetMode(os.ModeSymlink | 0777)
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(target))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
