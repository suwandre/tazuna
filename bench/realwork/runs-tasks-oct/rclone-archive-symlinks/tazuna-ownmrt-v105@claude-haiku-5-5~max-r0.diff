+// Symlinks in an image are skipped unless -l/--links is set, in which
+// case they are listed with fs.LinkSuffix appended and read back as
+// their target. A regular file named with the suffix stays a regular file.
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	for _, test := range []struct {
+		links bool
+		want  []string
+	}{
+		{false, []string{"dir", "file.txt", "regular.rclonelink"}},
+		{true, []string{"dangling.rclonelink", "dir", "file.txt", "link.txt.rclonelink", "regular.rclonelink"}},
+	} {
+		t.Run(fmt.Sprintf("links=%v", test.links), func(t *testing.T) {
+			ctx, ci := fs.AddConfig(ctx)
+			ci.Links = test.links
+			f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+			require.NoError(t, err)
+
+			entries, err := f.List(ctx, "")
+			require.NoError(t, err)
+			var remotes []string
+			for _, entry := range entries {
+				remotes = append(remotes, entry.Remote())
+			}
+			sort.Strings(remotes)
+			assert.Equal(t, test.want, remotes)
+
+			// The link inside dir is listed the same way as at the root
+			entries, err = f.List(ctx, "dir")
+			require.NoError(t, err)
+			var wantDir []string
+			if test.links {
+				wantDir = []string{"dir/link.rclonelink"}
+			}
+			remotes = nil
+			for _, entry := range entries {
+				remotes = append(remotes, entry.Remote())
+			}
+			assert.Equal(t, wantDir, remotes)
+
+			// NewObject must agree with the listing
+			for _, remote := range []string{"file.txt", "regular.rclonelink", "link.txt", "link.txt.rclonelink", "dir/link", "dir/link.rclonelink"} {
+				o, err := f.NewObject(ctx, remote)
+				if !slices.Contains(test.want, remote) && !slices.Contains(wantDir, remote) {
+					assert.Equal(t, fs.ErrorObjectNotFound, err, remote)
+					continue
+				}
+				require.NoError(t, err, remote)
+				assert.Equal(t, remote, o.Remote())
+			}
+		})
+	}
+
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+
+	// A link reads back its target, honouring range and seek options
+	o, err := f.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	assert.Equal(t, "file.txt", fstests.ReadObject(ctx, t, o, -1))
+	assert.Equal(t, "txt", fstests.ReadObject(ctx, t, o, -1, &fs.SeekOption{Offset: 5}))
+	assert.Equal(t, "fi", fstests.ReadObject(ctx, t, o, -1, &fs.RangeOption{Start: 0, End: 1}))
+
+	o, err = f.NewObject(ctx, "dir/link.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "../file.txt", fstests.ReadObject(ctx, t, o, -1))
+
+	// A regular file named with the suffix is read as the file content
+	o, err = f.NewObject(ctx, "regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "data\n", fstests.ReadObject(ctx, t, o, -1))
+}
