+// A symlink in an archive must not let a copy with --links write outside
+// the destination, even when a later member is "inside" the link.
+func TestCopySymlinkEscape(t *testing.T) {
+	dir := t.TempDir()
+	// victim is where the escape would land, a sibling of the destination
+	parent := t.TempDir()
+	victim := filepath.Join(parent, "victim")
+	require.NoError(t, os.Mkdir(victim, 0777))
+	name := writeZipSymlinks(t, dir, "evil.zip",
+		map[string]string{
+			"evil/pwned.txt": "pwned",
+		},
+		map[string]string{
+			"evil": "../victim",
+		},
+	)
+	localSrc, err := cache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	f, err := New(ctx, localSrc, name, "", "")
+	require.NoError(t, err)
+
+	dst := filepath.Join(parent, "out")
+	require.NoError(t, os.Mkdir(dst, 0777))
+	dstFs, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+
+	// Check the link is exposed, so the copy below is really exercised
+	assert.Equal(t, []string{"evil.rclonelink", "evil/pwned.txt"}, allRemotes(t, f))
+
+	// The copy may fail, but it must not write through the link
+	_ = sync.CopyDir(ctx, dstFs, f, false)
+
+	_, err = os.Stat(filepath.Join(victim, "pwned.txt"))
+	assert.True(t, os.IsNotExist(err), "copy wrote outside the destination")
+}
