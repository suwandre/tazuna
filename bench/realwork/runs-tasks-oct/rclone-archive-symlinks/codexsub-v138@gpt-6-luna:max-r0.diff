+func TestArchiveZipSymlinkEscapeBlocked(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	outside := t.TempDir()
+	evilFile := filepath.Join(outside, "authkeys")
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	linkHeader := &zip.FileHeader{Name: "pwn"}
+	linkHeader.SetMode(os.ModeSymlink | 0o777)
+	w, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(outside))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	zipPath := filepath.Join(t.TempDir(), "evil.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dstPath := filepath.Join(t.TempDir(), "dst")
+	require.NoError(t, os.Mkdir(dstPath, 0700))
+	probe := filepath.Join(dstPath, "symlink-probe")
+	if err := os.Symlink("target", probe); err != nil {
+		t.Skipf("destination filesystem does not support symlinks: %v", err)
+	}
+	require.NoError(t, os.Remove(probe))
+	dst, err := cache.Get(ctx, dstPath)
+	require.NoError(t, err)
+
+	link, err := src.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, link.Remote(), link)
+	require.NoError(t, err)
+
+	linkPath := filepath.Join(dstPath, "pwn")
+	info, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	require.True(t, info.Mode()&os.ModeSymlink != 0, "archive link was not recreated as a symlink")
+
+	member, err := src.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, member.Remote(), member)
+	assert.Error(t, err, "copy through an archived symlink must be refused")
+	_, err = os.Stat(evilFile)
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evilFile)
+}
