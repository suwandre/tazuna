+func TestZipSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+
+	linkHeader := &zip.FileHeader{Name: "dir/link.txt"}
+	linkHeader.SetMode(os.ModeSymlink | 0o777)
+	w, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+
+	w, err = zw.Create("dir/ordinary.rclonelink")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("regular file"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "links.zip"), buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	withoutLinks, err := New(ctx, localFs, "links.zip", "", "")
+	require.NoError(t, err)
+	entries, err := withoutLinks.List(ctx, "dir")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "dir/ordinary.rclonelink", entries[0].Remote())
+	_, err = withoutLinks.NewObject(ctx, "dir/link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	withLinks, err := New(linksCtx, localFs, "links.zip", "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(linksCtx, "dir")
+	require.NoError(t, err)
+	require.Len(t, entries, 2)
+	assert.ElementsMatch(t, []string{"dir/link.txt.rclonelink", "dir/ordinary.rclonelink"}, []string{entries[0].Remote(), entries[1].Remote()})
+
+	_, err = withLinks.NewObject(linksCtx, "dir/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	link, err := withLinks.NewObject(linksCtx, "dir/link.txt.rclonelink")
