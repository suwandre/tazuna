+func (f *Fs) objectFromDirEntry(nativeDir string, item iofs.DirEntry) (*Object, error) {
+	info, err := item.Info()
+	if err != nil {
+		return nil, fmt.Errorf("error reading item %q: %w", item.Name(), err)
+	}
+	if info.Mode()&os.ModeSymlink != 0 {
+		if !f.links {
+			return nil, fs.ErrorObjectNotFound
+		}
+		link, ok := item.(interface{ Readlink() (string, error) })
+		if !ok {
+			return nil, fmt.Errorf("item %q does not expose its symlink target", item.Name())
+		}
+		target, err := link.Readlink()
+		if err != nil {
+			return nil, fmt.Errorf("error reading symlink target for %q: %w", item.Name(), err)
+		}
+		o := f.objectFromFileInfo(nativeDir, info)
+		o.remote += fs.LinkSuffix
+		o.size = int64(len(target))
+		o.linkTarget = target
+		o.symlink = true
+		return o, nil
+	}
+	if !info.Mode().IsRegular() {
+		return nil, fs.ErrorObjectNotFound
+	}
+	return f.objectFromFileInfo(nativeDir, info), nil
+}
