+func TestSquashfsSymlinks(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	withoutLinks, err := New(ctx, localFs, "symlinks.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := withoutLinks.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 2)
+	assert.ElementsMatch(t, []string{"file.txt", "ordinary.rclonelink"}, []string{entries[0].Remote(), entries[1].Remote()})
+	_, err = withoutLinks.NewObject(ctx, "link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	withLinks, err := New(linksCtx, localFs, "symlinks.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 3)
+	assert.ElementsMatch(t, []string{"file.txt", "link.txt.rclonelink", "ordinary.rclonelink"}, []string{entries[0].Remote(), entries[1].Remote(), entries[2].Remote()})
+
+	_, err = withLinks.NewObject(linksCtx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	link, err := withLinks.NewObject(linksCtx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+
+	rc, err := link.Open(linksCtx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file.txt", string(data))
+
+	rc, err = link.Open(linksCtx, &fs.RangeOption{Start: 2, End: 5})
+	require.NoError(t, err)
+	data, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "le.t", string(data))
+
+	rc, err = link.Open(linksCtx, &fs.SeekOption{Offset: 5})
+	require.NoError(t, err)
+	data, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "txt", string(data))
+
+	regular, err := withLinks.NewObject(linksCtx, "ordinary.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("regular file\n")), regular.Size())
+
+	single, err := New(linksCtx, localFs, "symlinks.sqfs", "", "link.txt.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = single.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt.rclonelink", entries[0].Remote())
+	_, err = single.NewObject(linksCtx, "link.txt.rclonelink")
+	assert.NoError(t, err)
