+// writeSymlinkZip writes regular and symbolic-link members to a zip file.
+func writeSymlinkZip(t *testing.T, dir string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+
+	linkHeader := &zip.FileHeader{Name: "link.txt"}
+	linkHeader.SetMode(os.ModeSymlink | 0o777)
+	w, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+
+	w, err = zw.Create("regular.rclonelink")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("regular file"))
+	require.NoError(t, err)
+
+	linkHeader = &zip.FileHeader{Name: "outside"}
+	linkHeader.SetMode(os.ModeSymlink | 0o777)
+	w, err = zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("../../outside"))
+	require.NoError(t, err)
+
+	w, err = zw.Create("outside/evil.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("evil"))
+	require.NoError(t, err)
+
+	require.NoError(t, zw.Close())
+	name := "links.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
