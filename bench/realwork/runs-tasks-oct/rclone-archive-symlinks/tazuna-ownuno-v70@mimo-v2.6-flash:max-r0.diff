+// writeSymlinkZip builds a zip file with the given regular files
+// (remote -> content) and symlinks (remote -> target) in dir and
+// returns its leaf name.
+func writeSymlinkZip(t *testing.T, dir, name string, files map[string]string, links map[string]string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, remote := range sortedKeys(files) {
+		w, err := zw.Create(remote)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(files[remote]))
+		require.NoError(t, err)
+	}
+	for _, remote := range sortedKeys(links) {
+		h := &zip.FileHeader{Name: remote}
+		h.SetMode(os.ModeSymlink | 0777)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(links[remote]))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// sortedKeys returns the keys of m in sorted order
+func sortedKeys[V any](m map[string]V) (keys []string) {
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// linksContext returns a context with -l/--links in effect
+func linksContext(t *testing.T) context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	return ctx
+}
