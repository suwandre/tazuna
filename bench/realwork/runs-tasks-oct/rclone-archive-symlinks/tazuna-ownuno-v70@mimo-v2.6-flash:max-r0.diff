+	assert.Equal(t, "fil", fstestsReadObject(ctx, t, o, -1, &fs.RangeOption{Start: 0, End: 2}))
+
+	// A symlink pointing above the archive is exposed under its
+	// .rclonelink name like any other, it doesn't escape
+	o, err = f.NewObject(ctx, "src/sub/above.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, "../../../etc/passwd", fstestsReadObject(ctx, t, o, -1))
+
+	// A regular file which happens to be named *.rclonelink stays a
+	// regular file...
+	o, err = f.NewObject(ctx, "src/plain.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "not a link", fstestsReadObject(ctx, t, o, -1))
+
+	// ...and so does one named like a translated symlink
+	o, err = f.NewObject(ctx, "src/target.rclonelink.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", fstestsReadObject(ctx, t, o, -1))
+
+	// NewObject and List agree: the bare names aren't there
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.Equal(t, fs.ErrorObjectNotFound, err)
+	_, err = f.NewObject(ctx, "src/target.rclonelink")
+	assert.Equal(t, fs.ErrorObjectNotFound, err)
+}
+
+// A symlink the archive's root points at is exposed under its suffixed
+// name so the single file archive can still be read.
+func TestReadZipSymlinkRoot(t *testing.T) {
+	ctx := linksContext(t)
+	dir := t.TempDir()
+	name := writeSymlinkZip(t, dir, "test.zip",
+		map[string]string{"src/file.txt": "hello"},
+		map[string]string{"src/link.txt": "file.txt"},
+	)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, name, "", "src/link.txt")
+	require.Equal(t, fs.ErrorIsFile, err)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+
+	o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", fstestsReadObject(ctx, t, o, -1))
+}
+
+// fstestsReadObject reads obj as a string with the options passed in
+func fstestsReadObject(ctx context.Context, t *testing.T, obj fs.Object, limit int64, options ...fs.OpenOption) string {
+	t.Helper()
+	in, err := obj.Open(ctx, options...)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	return string(contents)
+}
