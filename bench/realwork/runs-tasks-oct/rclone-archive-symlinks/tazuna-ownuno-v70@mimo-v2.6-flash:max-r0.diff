+// TestArchiveSymlinkZip checks that -l/--links makes a zip archive's
+// symlink visible under its .rclonelink name and that copying it to a
+// local destination recreates the symlink. Without -l/--links the
+// symlink is skipped and a notice naming the flag is logged.
+func TestArchiveSymlinkZip(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoExe(t, "zip")
+	ctx := context.Background()
+
+	// Source directory with a file and a symlink to it
+	srcRoot := t.TempDir()
+	srcDir := filepath.Join(srcRoot, "src")
+	require.NoError(t, os.Mkdir(srcDir, 0777))
+	require.NoError(t, os.WriteFile(filepath.Join(srcDir, "file.txt"), []byte("hello\n"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(srcDir, "link.txt")))
+
+	// Archive it
+	outDir := t.TempDir()
+	zipPath := path.Join(outDir, "test.zip")
+	oldcwd, err := os.Getwd()
+	require.NoError(t, err)
+	require.NoError(t, os.Chdir(srcRoot))
+	run(t, "zip", "-9ry", zipPath, ".")
+	require.NoError(t, os.Chdir(oldcwd))
+
+	// openArchive makes a fresh archive Fs - cache.Get isn't used as
+	// the -l/--links flag is read when the Fs is made
+	openArchive := func(t *testing.T, ctx context.Context) fs.Fs {
+		t.Helper()
+		f, err := NewFs(ctx, "archive", zipPath, configmap.Simple{})
+		require.True(t, err == nil || err == fs.ErrorIsFile, "unexpected err: %v", err)
+		return f
+	}
+
+	list := func(t *testing.T, ctx context.Context) string {
+		t.Helper()
+		f := openArchive(t, ctx)
+		var buf bytes.Buffer
+		require.NoError(t, operations.List(ctx, f, &buf))
+		return buf.String()
+	}
+
+	// Without -l/--links the symlink is skipped with a notice
+	assert.Equal(t, "        6 src/file.txt\n", list(t, ctx))
+
+	// With -l/--links the symlink is listed under its .rclonelink
+	// name, sized to its target
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	assert.Equal(t, "        6 src/file.txt\n        8 src/link.txt.rclonelink\n", list(t, linksCtx))
+
+	// Copying with -l/--links to a local destination recreates the
+	// symlink
+	dstRoot := t.TempDir()
+	srcFs := openArchive(t, linksCtx)
+	dstFs, err := cache.Get(linksCtx, dstRoot)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(linksCtx, dstFs, srcFs, false))
+
+	fi, err := os.Lstat(filepath.Join(dstRoot, "src", "link.txt"))
+	require.NoError(t, err)
+	require.NotZero(t, fi.Mode()&os.ModeSymlink, "link.txt should be a symlink")
+	target, err := os.Readlink(filepath.Join(dstRoot, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
