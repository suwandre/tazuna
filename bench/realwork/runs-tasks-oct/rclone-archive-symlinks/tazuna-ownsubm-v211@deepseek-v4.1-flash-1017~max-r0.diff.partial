diff --git a/backend/archive/zip/zip.go b/backend/archive/zip/zip.go
index 129ce01..3cfd34f 100644
--- a/backend/archive/zip/zip.go
+++ b/backend/archive/zip/zip.go
@@ -44,6 +44,7 @@ type Fs struct {
 	prefixSlash string          // position for objects with a slash on
 	root        string          // position to read from within the archive
 	dt          dirtree.DirTree // read from zipfile
+	links       bool            // translate symlinks to .rclonelink objects
 }
 
 // New constructs an Fs from the (wrappedFs, remote) with the objects
@@ -69,6 +70,7 @@ func New(ctx context.Context, wrappedFs fs.Fs, remote, prefix, root string) (fs.
 		root:        root,
 		prefix:      prefix,
 		prefixSlash: prefix + "/",
+		links:       fs.GetConfig(ctx).Links,
 	}
 
 	// Read the contents of the zip file
@@ -138,6 +140,7 @@ func (f *Fs) readZip() (singleObject bool, err error) {
 	}
 	dt := dirtree.New()
 	skipped := 0
+	skippedLinks := 0
 	for _, file := range zr.File {
 		// Skip entries whose name escapes the archive's own namespace
 		remote, err := sanitize.Path(file.Name)
@@ -152,7 +155,19 @@ func (f *Fs) readZip() (singleObject bool, err error) {
 			skipped++
 			continue
 		}
+		// A symlink is stored as an entry whose content is the link
+		// target. Expose it as a .rclonelink object when --links is
+		// in use so it can be recreated as a symlink, and skip it
+		// otherwise.
+		isLink := !isDir && file.Mode()&os.ModeSymlink != 0
+		if isLink && !f.links {
+			skippedLinks++
+			continue
+		}
 		remote = path.Join(f.prefix, remote)
+		if isLink {
+			remote += fs.LinkSuffix
+		}
 		if f.root != "" {
 			// Ignore all files outside the root, requiring a path
 			// boundary so that root "foo" does not also match a
@@ -191,6 +206,9 @@ func (f *Fs) readZip() (singleObject bool, err error) {
 	if skipped > 0 {
 		fs.Logf(f, "Skipped %d zip entries which escape the archive", skipped)
 	}
+	if skippedLinks > 0 {
+		fs.Logf(f, "Skipped %d symlinks in the archive - use -l/--links to include them", skippedLinks)
+	}
 	dt.CheckParents("")
 	dt.Sort()
 	f.dt = dt
