+// A root pointing at a symlink is found with the link suffix.
+func TestSymlinkRoot(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	for _, test := range []struct {
+		root   string
+		leaf   string
+		link   bool
+		target string
+	}{
+		{"link.txt" + fs.LinkSuffix, "link.txt" + fs.LinkSuffix, true, "file.txt"},
+		{"sub/link2.txt" + fs.LinkSuffix, "link2.txt" + fs.LinkSuffix, true, "../file.txt"},
+		{"file.txt", "file.txt", false, "hello\n"},
+		{"sub/data.txt", "data.txt", false, "sub data\n"},
+	} {
+		t.Run(test.root, func(t *testing.T) {
+			f, err := New(ctx, localFs, "symlink.sqfs", "", test.root)
+			require.Equal(t, fs.ErrorIsFile, err)
+			entries, err := f.List(ctx, "")
+			require.NoError(t, err)
+			require.Len(t, entries, 1)
+			assert.Equal(t, test.leaf, entries[0].Remote())
+			o, err := f.NewObject(ctx, test.leaf)
+			require.NoError(t, err)
+			assert.Equal(t, test.target, readObject(ctx, t, o))
+		})
+	}
+
+	// A root naming a symlink without the link suffix matches nothing
+	f, err := New(ctx, localFs, "symlink.sqfs", "", "link.txt")
+	require.NoError(t, err)
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+}
