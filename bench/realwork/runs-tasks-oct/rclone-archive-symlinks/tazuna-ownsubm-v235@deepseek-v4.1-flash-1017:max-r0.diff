+// symlink.sqfs is built from this tree with
+//
+//	mksquashfs src symlink.sqfs -noappend -comp gzip -b 4096 -no-xattrs -all-root
+//
+// where src contains
+//
+//	file.txt              "hello\n"
+//	link.txt         ->   file.txt
+//	escape.txt       ->   ../outside
+//	plain.rclonelink      "not a link\n"
+//	sub/data.txt          "sub data\n"
+//	sub/link2.txt    ->   ../file.txt
+//
+// A symlink is skipped unless --links is in use, in which case it is
+// listed under its name plus .rclonelink and reading it returns the
+// target. A regular entry whose name ends in .rclonelink stays a
+// regular file.
+func TestSymlinks(t *testing.T) {
+	localFs, err := fscache.Get(context.Background(), "testdata")
+	require.NoError(t, err)
+
+	t.Run("WithoutLinks", func(t *testing.T) {
+		ctx := context.Background()
+		f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"file.txt", "plain.rclonelink", "sub/data.txt"}, allRemotes(ctx, t, f))
+
+		// Neither the symlink nor its suffixed name exist
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("WithLinks", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(context.Background())
+		ci.Links = true
+		f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+		require.NoError(t, err)
+
+		want := []string{
+			"escape.txt" + fs.LinkSuffix,
+			"file.txt",
+			"link.txt" + fs.LinkSuffix,
+			"plain.rclonelink",
+			"sub/data.txt",
+			"sub/link2.txt" + fs.LinkSuffix,
+		}
+		assert.Equal(t, want, allRemotes(ctx, t, f))
+
+		// Listing and NewObject agree on the names which exist
+		o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "link.txt"+fs.LinkSuffix, o.Remote())
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// Opening reads back the target, honouring seek and range
+		assert.Equal(t, "file.txt", readObject(ctx, t, o))
+		assert.Equal(t, "file.txt"[2:], readObject(ctx, t, o, &fs.SeekOption{Offset: 2}))
+		assert.Equal(t, "file.txt"[2:5], readObject(ctx, t, o, &fs.RangeOption{Start: 2, End: 4}))
+
+		// A regular file with the link suffix stays a regular file
+		o, err = f.NewObject(ctx, "plain.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("not a link\n")), o.Size())
+		assert.Equal(t, "not a link\n", readObject(ctx, t, o))
+	})
+}
