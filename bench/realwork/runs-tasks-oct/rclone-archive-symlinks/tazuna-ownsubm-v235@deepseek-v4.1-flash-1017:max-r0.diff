+// skipIfNoSymlinks skips the test if this process can't create symlinks.
+func skipIfNoSymlinks(t *testing.T) {
+	t.Helper()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("Skipping as symlinks are unavailable: %v", err)
+	}
+}
+
+// writeSymlinkZip builds a zip at path whose entries are given as
+// (name, target) pairs. A non-empty target makes the entry a symlink.
+func writeSymlinkZip(t *testing.T, path string, entries map[string]string) {
+	t.Helper()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for name, target := range entries {
+		hdr := &zip.FileHeader{Name: name}
+		content := "contents of " + name
+		if target != "" {
+			hdr.SetMode(os.ModeSymlink | 0777)
+			content = target
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(path, buf.Bytes(), 0600))
+}
+
+// TestArchiveCopySymlink checks that copying an archive with --links
+// recreates symlinks at a destination which supports them.
+func TestArchiveCopySymlink(t *testing.T) {
+	skipIfNoSymlinks(t)
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	zipPath := filepath.Join(t.TempDir(), "test.zip")
+	writeSymlinkZip(t, zipPath, map[string]string{
+		"src/file.txt": "",
+		"src/link.txt": "file.txt",
+	})
+
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	// Listing shows the symlink with the link suffix
+	entries, err := src.List(ctx, "src")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix}, remotes)
+
+	dst := t.TempDir()
+	dstFs, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, dstFs, src, false))
+
+	// The symlink has been recreated pointing at the same target
+	linkPath := filepath.Join(dst, "src", "link.txt")
+	fi, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	assert.True(t, fi.Mode()&os.ModeSymlink != 0, "should be a symlink")
+	target, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
+
+// TestArchiveSymlinkEscape checks a hostile archive containing a symlink
+// pointing above the root plus a member inside it can't make a copy
+// write outside the destination.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	skipIfNoSymlinks(t)
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	// A directory outside the destination the archive wants to write into
+	outside := t.TempDir()
+	outsideFile := filepath.Join(outside, "authkeys")
+
+	zipPath := filepath.Join(t.TempDir(), "evil.zip")
+	writeSymlinkZip(t, zipPath, map[string]string{
+		"pwn":          outside,
+		"pwn/authkeys": "",
+		"good.txt":     "",
+	})
+
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	dst := t.TempDir()
+	dstFs, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+	// The copy is expected to report errors as the write through the
+	// planted symlink is refused, but nothing may escape.
+	_ = sync.CopyDir(ctx, dstFs, src, false)
+
+	_, err = os.Stat(outsideFile)
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", outsideFile)
+
+	// The benign file is still copied
+	_, err = os.Stat(filepath.Join(dst, "good.txt"))
+	assert.NoError(t, err)
+}
