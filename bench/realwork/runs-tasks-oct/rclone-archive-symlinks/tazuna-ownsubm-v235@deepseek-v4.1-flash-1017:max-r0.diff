+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "test.zip",
+		zipEntry{name: "file.txt", content: "hello"},
+		zipEntry{name: "link.txt", target: "file.txt"},
+		zipEntry{name: "plain.rclonelink", content: "not a link"},
+	)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	t.Run("WithoutLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"file.txt", "plain.rclonelink"}, allRemotes(t, f))
+
+		// Neither the symlink nor its suffixed name exist
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// The notice names the flag
+		var buf bytes.Buffer
+		fs.SetLogger(slog.NewTextHandler(&buf, nil))
+		defer fs.SetLogger(slog.NewTextHandler(io.Discard, nil))
+		_, err = New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Contains(t, buf.String(), "--links")
+	})
+
+	t.Run("WithLinks", func(t *testing.T) {
+		linksCtx := linksContext()
+		f, err := New(linksCtx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		want := []string{"file.txt", "link.txt" + fs.LinkSuffix, "plain.rclonelink"}
+		assert.Equal(t, want, allRemotes(t, f))
+
+		// Listing and NewObject agree on the names which exist
+		o, err := f.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "link.txt"+fs.LinkSuffix, o.Remote())
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		_, err = f.NewObject(linksCtx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// Opening reads back the target, honouring seek and range
+		assert.Equal(t, "file.txt", readObject(t, o))
+		assert.Equal(t, "file.txt"[2:], readObject(t, o, &fs.SeekOption{Offset: 2}))
+		assert.Equal(t, "file.txt"[2:5], readObject(t, o, &fs.RangeOption{Start: 2, End: 4}))
+
+		// A regular file with the link suffix stays a regular file
+		o, err = f.NewObject(linksCtx, "plain.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("not a link")), o.Size())
+		assert.Equal(t, "not a link", readObject(t, o))
+	})
+}
