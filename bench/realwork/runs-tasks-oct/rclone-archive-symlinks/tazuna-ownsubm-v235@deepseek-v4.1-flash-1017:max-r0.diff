+// allRemotes returns every object remote in the mounted archive's tree,
+// sorted for a stable comparison.
+func allRemotes(ctx context.Context, t *testing.T, f fs.Fs) []string {
+	t.Helper()
+	var remotes []string
+	var walk func(dir string)
+	walk = func(dir string) {
+		entries, err := f.List(ctx, dir)
+		require.NoError(t, err)
+		for _, entry := range entries {
+			if _, ok := entry.(fs.Object); ok {
+				remotes = append(remotes, entry.Remote())
+			} else {
+				walk(entry.Remote())
+			}
+		}
+	}
+	walk("")
+	sort.Strings(remotes)
+	return remotes
+}
+
+// readObject reads the whole of o.
+func readObject(ctx context.Context, t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	t.Helper()
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
