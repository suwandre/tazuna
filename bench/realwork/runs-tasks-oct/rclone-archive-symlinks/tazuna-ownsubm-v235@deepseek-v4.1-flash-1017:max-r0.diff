+// zipEntry describes an entry to write with writeZipEntries.
+type zipEntry struct {
+	name    string
+	target  string // if set the entry is a symlink to this
+	content string
+}
+
+// writeZipEntries builds a zip file from entries in dir and returns its
+// leaf name. An entry with target set is written as a symlink whose
+// contents are the target.
+func writeZipEntries(t *testing.T, dir, name string, entries ...zipEntry) string {
+	t.Helper()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		hdr := &zip.FileHeader{Name: entry.name}
+		if entry.target != "" {
+			hdr.SetMode(os.ModeSymlink | 0777)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		content := entry.content
+		if entry.target != "" {
+			content = entry.target
+		}
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// linksContext returns a context with -l/--links enabled.
+func linksContext() context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	return ctx
+}
+
+// readObject reads the whole of o.
+func readObject(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	t.Helper()
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
