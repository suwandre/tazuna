@@ -0,0 +1,45 @@
+package archiver
+
+import (
+	"errors"
+	"io"
+	"strings"
+
+	"github.com/rclone/rclone/lib/readers"
+)
+
+// MaxLinkTargetSize is the largest symlink target read from an archive.
+//
+// It is comfortably above any OS path limit (Windows allows 32767
+// UTF-16 units) while bounding the memory a hostile archive can make
+// an archiver use.
+const MaxLinkTargetSize = 128 * 1024
+
+// ErrLinkTargetTooLong is returned by ReadLinkTarget when a symlink
+// target is larger than MaxLinkTargetSize.
+var ErrLinkTargetTooLong = errors.New("symlink target is too long")
+
+// ReadLinkTarget reads a symlink target from r, refusing targets
+// larger than MaxLinkTargetSize.
+func ReadLinkTarget(r io.Reader) (string, error) {
+	target, err := io.ReadAll(io.LimitReader(r, MaxLinkTargetSize+1))
+	if err != nil {
+		return "", err
+	}
+	if len(target) > MaxLinkTargetSize {
+		return "", ErrLinkTargetTooLong
+	}
+	return string(target), nil
+}
+
+// OpenLink returns the contents of a symlink target from offset
+// onwards, limited to limit bytes if limit is non-negative.
+func OpenLink(target string, offset, limit int64) io.ReadCloser {
+	if offset < 0 {
+		offset = 0
+	}
+	if offset > int64(len(target)) {
+		offset = int64(len(target))
+	}
+	return readers.NewLimitedReadCloser(io.NopCloser(strings.NewReader(target[offset:])), limit)
+}
