+// readObject returns the contents of o with the options passed in.
+func readObject(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
+
+// linksContext returns a context with -l/--links enabled.
+func linksContext() context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	return ctx
