+		if !strings.HasSuffix(entry.name, "/") {
+			_, err = w.Write([]byte(entry.data))
+			require.NoError(t, err)
+		}
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// readObject returns the contents of o with the options passed in.
+func readObject(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
+
+// linksContext returns a context with -l/--links enabled.
+func linksContext() (context.Context, *fs.ConfigInfo) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	return ctx, ci
+}
+
+// A zip symlink is skipped unless -l/--links is in use, and a regular
+// entry whose name ends in .rclonelink stays a regular file.
+func TestSymlinkSkippedWithoutLinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "test.zip",
+		zipEntry{name: "file.txt", data: "hello world", mode: 0644},
+		zipEntry{name: "link.txt", data: "file.txt", mode: os.ModeSymlink | 0777},
+		zipEntry{name: "regular.rclonelink", data: "not a link", mode: 0644},
+	)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "regular.rclonelink"}, remotes)
+
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// A regular file with the link suffix is still a regular file.
+	o, err := f.NewObject(ctx, "regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("not a link")), o.Size())
+	assert.Equal(t, "not a link", readObject(t, o))
+}
+
+// An archive containing only skipped symlinks still has a root which
+// lists as empty.
+func TestSymlinkOnlyArchive(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "links.zip",
+		zipEntry{name: "link.txt", data: "file.txt", mode: os.ModeSymlink | 0777},
+	)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	assert.Empty(t, entries)
+}
+
+// With -l/--links a zip symlink is listed with the link suffix and
+// reads back its target.
+func TestSymlinkLinks(t *testing.T) {
+	ctx, _ := linksContext()
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "test.zip",
+		zipEntry{name: "file.txt", data: "hello world", mode: 0644},
+		zipEntry{name: "link.txt", data: "file.txt", mode: os.ModeSymlink | 0777},
+		zipEntry{name: "regular.rclonelink", data: "not a link", mode: 0644},
+		zipEntry{name: "sub/", mode: os.ModeDir | 0755},
+		zipEntry{name: "sub/deep.txt", data: "deep", mode: 0644},
+		zipEntry{name: "sub/deep-link.txt", data: "deep.txt", mode: os.ModeSymlink | 0777},
+	)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		if o, ok := entry.(fs.Object); ok {
+			// Listing and NewObject must agree on which names exist.
+			found, err := f.NewObject(ctx, o.Remote())
+			require.NoError(t, err, o.Remote())
+			assert.Equal(t, o.Remote(), found.Remote())
+		}
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "link.txt" + fs.LinkSuffix, "regular.rclonelink", "sub"}, remotes)
+
+	o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	assert.Equal(t, "file.txt", readObject(t, o))
+	assert.Equal(t, ".txt", readObject(t, o, &fs.SeekOption{Offset: 4}))
+	assert.Equal(t, "file", readObject(t, o, &fs.RangeOption{Start: 0, End: 3}))
+
+	// The unsuffixed name doesn't exist.
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// A regular file with the link suffix is still a regular file.
+	ro, err := f.NewObject(ctx, "regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("not a link")), ro.Size())
+	assert.Equal(t, "not a link", readObject(t, ro))
+
+	// Links in subdirectories get the suffix too.
+	deep, err := f.NewObject(ctx, "sub/deep-link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, "deep.txt", readObject(t, deep))
+}
+
+// The root may name a symlink either with or without the link suffix.
+func TestSymlinkRoot(t *testing.T) {
+	ctx, _ := linksContext()
+	dir := t.TempDir()
+	name := writeZipEntries(t, dir, "test.zip",
+		zipEntry{name: "file.txt", data: "hello world", mode: 0644},
+		zipEntry{name: "link.txt", data: "file.txt", mode: os.ModeSymlink | 0777},
+	)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	for _, root := range []string{"link.txt", "link.txt" + fs.LinkSuffix} {
+		t.Run(root, func(t *testing.T) {
+			f, err := New(ctx, localFs, name, "", root)
+			require.ErrorIs(t, err, fs.ErrorIsFile)
+			entries, err := f.List(ctx, "")
+			require.NoError(t, err)
+			require.Len(t, entries, 1)
+			assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+			o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+			require.NoError(t, err)
+			assert.Equal(t, "file.txt", readObject(t, o))
+		})
+	}
+}
+
+// A hostile zip with a symlink pointing outside the destination and a
+// member "inside" it must not write outside the destination.
+func TestSymlinkEscapeBlocked(t *testing.T) {
+	ctx, _ := linksContext()
+	dir := t.TempDir()
+	evil := t.TempDir()
+	name := writeZipEntries(t, dir, "evil.zip",
+		zipEntry{name: "pwn", data: evil, mode: os.ModeSymlink | 0777},
+		zipEntry{name: "pwn/authkeys", data: "PWNED", mode: 0644},
+	)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	dst := t.TempDir()
+	dstFs, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+
+	// Reproduce the symlink faithfully.
+	srcLink, err := f.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn"+fs.LinkSuffix, srcLink)
+	require.NoError(t, err)
+	fi, err := os.Lstat(filepath.Join(dst, "pwn"))
+	require.NoError(t, err)
+	require.NotZero(t, fi.Mode()&os.ModeSymlink)
+	target, err := os.Readlink(filepath.Join(dst, "pwn"))
+	require.NoError(t, err)
+	assert.Equal(t, evil, target)
+
+	// Writing through it must be refused, so nothing escapes.
+	srcFile, err := f.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn/authkeys", srcFile)
+	require.Error(t, err)
+	_, err = os.Stat(filepath.Join(evil, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evil)
+}
