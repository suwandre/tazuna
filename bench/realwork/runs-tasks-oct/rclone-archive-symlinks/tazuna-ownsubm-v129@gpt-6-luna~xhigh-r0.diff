+// A symlink in an archive must not let a later member write outside the
+// destination when links are translated on the local backend.
+func TestZipSymlinkEscapeCopy(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	if err := os.Symlink("target", filepath.Join(dir, "symlink-probe")); err != nil {
+		t.Skipf("can't create symlink: %v", err)
+	}
+	name := "evil.zip"
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	linkHeader := &zip.FileHeader{Name: "dir/link"}
+	linkHeader.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("../../outside"))
+	require.NoError(t, err)
+	w, err = zw.Create("dir/link/pwn")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("must stay inside"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+
+	upstream, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	source, err := New(ctx, upstream, name, "", "")
+	require.NoError(t, err)
+	destinationPath := filepath.Join(dir, "out")
+	destination, err := cache.Get(ctx, destinationPath)
+	require.NoError(t, err)
+
+	link, err := source.NewObject(ctx, "dir/link.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, destination, nil, link.Remote(), link)
+	require.NoError(t, err)
+	target, err := os.Readlink(filepath.Join(destinationPath, "dir", "link"))
+	require.NoError(t, err)
+	assert.Equal(t, "../../outside", target)
+
+	member, err := source.NewObject(ctx, "dir/link/pwn")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, destination, nil, member.Remote(), member)
+	assert.Error(t, err)
+	assert.NoFileExists(t, filepath.Join(dir, "outside", "pwn"))
+}
