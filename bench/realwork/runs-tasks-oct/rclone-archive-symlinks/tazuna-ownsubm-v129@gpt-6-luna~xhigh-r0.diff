+func TestSquashfsSymlinks(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+	ctx := context.Background()
+	dir := t.TempDir()
+	input := filepath.Join(dir, "input")
+	require.NoError(t, os.Mkdir(input, 0700))
+	if err := os.Symlink("target", filepath.Join(input, "link")); err != nil {
+		t.Skipf("can't create symlink: %v", err)
+	}
+	require.NoError(t, os.WriteFile(filepath.Join(input, "regular.rclonelink"), []byte("ordinary file"), 0600))
+	archive := filepath.Join(dir, "links.sqfs")
+	cmd := exec.Command(mksquashfs, input, archive, "-noappend", "-quiet")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("mksquashfs failed: %v\n%s", err, output)
+	}
+
+	localFs, err := fscache.Get(ctx, dir)
+	require.NoError(t, err)
+	t.Run("SkippedWithoutLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, "links.sqfs", "", "")
+		require.NoError(t, err)
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		require.Len(t, entries, 1)
+		assert.Equal(t, "regular.rclonelink", entries[0].Remote())
+		_, err = f.NewObject(ctx, "link.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("TranslatedWithLinks", func(t *testing.T) {
+		linksCtx, ci := fs.AddConfig(ctx)
+		ci.Links = true
+		f, err := New(linksCtx, localFs, "links.sqfs", "", "")
+		require.NoError(t, err)
+		entries, err := f.List(linksCtx, "")
+		require.NoError(t, err)
+		var names []string
+		for _, entry := range entries {
+			names = append(names, entry.Remote())
+		}
+		assert.ElementsMatch(t, []string{"link.rclonelink", "regular.rclonelink"}, names)
+
+		_, err = f.NewObject(linksCtx, "link")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		link, err := f.NewObject(linksCtx, "link.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("target")), link.Size())
+		rc, err := link.Open(linksCtx, &fs.RangeOption{Start: 1, End: 3})
+		require.NoError(t, err)
+		data, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		rc, err = link.Open(linksCtx, &fs.SeekOption{Offset: 2})
+		require.NoError(t, err)
+		data, err = io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "rget", string(data))
+
+		regular, err := f.NewObject(linksCtx, "regular.rclonelink")
+		require.NoError(t, err)
+		rc, err = regular.Open(linksCtx)
+		require.NoError(t, err)
+		data, err = io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "ordinary file", string(data))
+	})
+}
