+func TestZipSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := "links.zip"
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	linkHeader := &zip.FileHeader{Name: "link"}
+	linkHeader.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("target"))
+	require.NoError(t, err)
+	w, err = zw.Create("regular.rclonelink")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("ordinary file"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	t.Run("SkippedWithoutLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"regular.rclonelink"}, allRemotes(t, f))
+		_, err = f.NewObject(ctx, "link.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("TranslatedWithLinks", func(t *testing.T) {
+		linksCtx, ci := fs.AddConfig(ctx)
+		ci.Links = true
+		f, err := New(linksCtx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"link.rclonelink", "regular.rclonelink"}, allRemotes(t, f))
+
+		_, err = f.NewObject(linksCtx, "link")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		link, err := f.NewObject(linksCtx, "link.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("target")), link.Size())
+		for _, test := range []struct {
+			options []fs.OpenOption
+			want    string
+		}{
+			{nil, "target"},
+			{[]fs.OpenOption{&fs.SeekOption{Offset: 2}}, "rget"},
+			{[]fs.OpenOption{&fs.RangeOption{Start: 1, End: 3}}, "arg"},
+		} {
+			rc, err := link.Open(linksCtx, test.options...)
+			require.NoError(t, err)
+			got, err := io.ReadAll(rc)
+			require.NoError(t, err)
