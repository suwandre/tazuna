@@ -0,0 +1,255 @@
+//go:build !plan9
+
+package archive
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"log/slog"
+	"os"
+	"path"
+	"path/filepath"
+	"testing"
+	"time"
+
+	squashfsarchiver "github.com/rclone/rclone/backend/archive/squashfs"
+	ziparchiver "github.com/rclone/rclone/backend/archive/zip"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/cache"
+	"github.com/rclone/rclone/fs/config/configmap"
+	fslog "github.com/rclone/rclone/fs/log"
+	"github.com/rclone/rclone/fs/operations"
+	"github.com/rclone/rclone/fs/sync"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type symlinkTestEntry struct {
+	name, contents string
+	mode           os.FileMode
+}
+
+// These entries also describe the tree packed in squashfs/testdata/symlinks.sqfs
+// using mksquashfs with -noappend -comp gzip -no-xattrs -all-root
+// -all-time 1700000000 -mkfs-time 1700000000 -nopad.
+var symlinkTestEntries = []symlinkTestEntry{
+	{"src/file.txt", "hello", 0644},
+	{"src/link.txt", "file.txt", os.ModeSymlink | 0777},
+	{"dir/child.txt", "child", 0644},
+	{"dirlink", "dir", os.ModeSymlink | 0777},
+	{"dangling", "missing", os.ModeSymlink | 0777},
+	{"absolute", "/outside", os.ModeSymlink | 0777},
+	{"parent", "../outside", os.ModeSymlink | 0777},
+	{"suffixed.rclonelink", "src/file.txt", os.ModeSymlink | 0777},
+	{"literal.rclonelink", "not a link", 0644},
+}
+
+func writeSymlinkZip(t *testing.T, entries []symlinkTestEntry) string {
+	t.Helper()
+	name := filepath.Join(t.TempDir(), "symlinks.zip")
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		h := &zip.FileHeader{Name: entry.name, Method: zip.Deflate, Modified: time.Unix(1700000000, 0)}
+		h.SetMode(entry.mode)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = io.WriteString(w, entry.contents)
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(name, buf.Bytes(), 0600))
+	return name
+}
+
+func readSymlinkTestObject(t *testing.T, ctx context.Context, o fs.Object, want string, options ...fs.OpenOption) {
+	t.Helper()
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	got, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, want, string(got))
+}
+
+func TestArchiveSymlinks(t *testing.T) {
+	for _, test := range []struct {
+		name, filename string
+		new            func(context.Context, fs.Fs, string, string, string) (fs.Fs, error)
+	}{
+		{"Zip", writeSymlinkZip(t, symlinkTestEntries), ziparchiver.New},
+		{"Squashfs", filepath.Join("squashfs", "testdata", "symlinks.sqfs"), squashfsarchiver.New},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			for _, links := range []bool{false, true} {
+				t.Run(fmt.Sprintf("Links=%v", links), func(t *testing.T) {
+					ctx, ci := fs.AddConfig(context.Background())
+					ci.Links = links
+					localFs, err := cache.Get(ctx, filepath.Dir(test.filename))
+					require.NoError(t, err)
+
+					var logs bytes.Buffer
+					fs.SetLogger(slog.NewTextHandler(&logs, &slog.HandlerOptions{Level: fs.SlogLevelNotice}))
+					defer fs.SetLogger(fslog.Handler)
+
+					f, err := test.new(ctx, localFs, filepath.Base(test.filename), "", "")
+					require.NoError(t, err)
+					_, err = f.List(ctx, "")
+					require.NoError(t, err)
+					if links {
+						assert.NotContains(t, logs.String(), "--links")
+					} else {
+						assert.Contains(t, logs.String(), "--links")
+					}
+
+					for _, entry := range symlinkTestEntries {
+						remote := entry.name
+						if entry.mode&os.ModeSymlink != 0 {
+							_, err := f.NewObject(ctx, remote)
+							assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+							remote += fs.LinkSuffix
+						}
+						dir := path.Dir(remote)
+						if dir == "." {
+							dir = ""
+						}
+						entries, err := f.List(ctx, dir)
+						require.NoError(t, err)
+						var names []string
+						for _, e := range entries {
+							names = append(names, e.Remote())
+						}
+						if entry.mode&os.ModeSymlink != 0 {
+							assert.NotContains(t, names, entry.name)
+						}
+						o, err := f.NewObject(ctx, remote)
+						if entry.mode&os.ModeSymlink != 0 && !links {
+							assert.NotContains(t, names, remote)
+							assert.ErrorIs(t, err, fs.ErrorObjectNotFound, remote)
+							continue
+						}
+						require.NoError(t, err, remote)
+						assert.Contains(t, names, remote)
+						assert.Equal(t, remote, o.Remote())
+						assert.Equal(t, int64(len(entry.contents)), o.Size())
+						assert.True(t, time.Unix(1700000000, 0).Equal(o.ModTime(ctx)))
+						readSymlinkTestObject(t, ctx, o, entry.contents)
+						readSymlinkTestObject(t, ctx, o, entry.contents[1:3], &fs.RangeOption{Start: 1, End: 2})
+						readSymlinkTestObject(t, ctx, o, entry.contents[2:], &fs.SeekOption{Offset: 2})
+						readSymlinkTestObject(t, ctx, o, entry.contents[len(entry.contents)-2:], &fs.RangeOption{Start: -1, End: 2})
+						readSymlinkTestObject(t, ctx, o, "", &fs.RangeOption{Start: o.Size() + 1, End: -1})
+						readSymlinkTestObject(t, ctx, o, "", &fs.SeekOption{Offset: o.Size() + 1})
+					}
+					_, err = f.List(ctx, "dirlink")
+					assert.Error(t, err)
+					_, err = f.NewObject(ctx, "dirlink/child.txt")
+					assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+				})
+			}
+
+			t.Run("RootsAndPrefixes", func(t *testing.T) {
+				ctx, ci := fs.AddConfig(context.Background())
+				ci.Links = true
+				localFs, err := cache.Get(ctx, filepath.Dir(test.filename))
+				require.NoError(t, err)
+				for _, location := range []struct {
+					root, prefix, remote, want string
+					single                     bool
+				}{
+					{"", "", "src/link.txt.rclonelink", "file.txt", false},
+					{"", "prefix", "prefix/src/link.txt.rclonelink", "file.txt", false},
+					{"src", "", "link.txt.rclonelink", "file.txt", false},
+					{"src/link.txt.rclonelink", "", "link.txt.rclonelink", "file.txt", true},
+					{"literal.rclonelink", "", "literal.rclonelink", "not a link", true},
+				} {
+					t.Run(fmt.Sprintf("root=%q,prefix=%q", location.root, location.prefix), func(t *testing.T) {
+						f, err := test.new(ctx, localFs, filepath.Base(test.filename), location.prefix, location.root)
+						if location.single {
+							require.ErrorIs(t, err, fs.ErrorIsFile)
+						} else {
+							require.NoError(t, err)
+						}
+						o, err := f.NewObject(ctx, location.remote)
+						require.NoError(t, err)
+						readSymlinkTestObject(t, ctx, o, location.want)
+					})
+				}
+			})
+
+			t.Run("Copy", func(t *testing.T) {
+				requireArchiveSymlinks(t)
+				ctx, ci := fs.AddConfig(context.Background())
+				ci.Links = true
+				f, err := NewFs(ctx, "archive", test.filename+"/src", configmap.Simple{})
+				require.NoError(t, err)
+				out := t.TempDir()
+				dst, err := cache.Get(ctx, out)
+				require.NoError(t, err)
+				require.NoError(t, sync.CopyDir(ctx, dst, f, false))
+				target, err := os.Readlink(filepath.Join(out, "link.txt"))
+				require.NoError(t, err)
+				assert.Equal(t, "file.txt", target)
+				contents, err := os.ReadFile(filepath.Join(out, "link.txt"))
+				require.NoError(t, err)
+				assert.Equal(t, "hello", string(contents))
+			})
+		})
+	}
+}
+
+func TestArchiveZipSymlinksOnly(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = false
+	name := writeSymlinkZip(t, []symlinkTestEntry{{"link", "target", os.ModeSymlink | 0777}})
+	f, err := NewFs(ctx, "archive", name, configmap.Simple{})
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	assert.Empty(t, entries)
+}
+
+func requireArchiveSymlinks(t *testing.T) {
+	t.Helper()
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("Symlinks are unavailable: %v", err)
+	}
+}
+
+func TestArchiveZipSymlinkEscape(t *testing.T) {
+	requireArchiveSymlinks(t)
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	ci.LowLevelRetries = 1
+	name := writeSymlinkZip(t, []symlinkTestEntry{
+		{"escape", "../outside", os.ModeSymlink | 0777},
+		{"escape/pwned", "bad", 0644},
+		{"./", "", os.ModeSymlink | 0777},
+		{"../../outside", "../outside", os.ModeSymlink | 0777},
+	})
+	f, err := NewFs(ctx, "archive", name, configmap.Simple{})
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 2)
+	parent := t.TempDir()
+	outside := filepath.Join(parent, "outside")
+	require.NoError(t, os.Mkdir(outside, 0700))
+	dst, err := cache.Get(ctx, filepath.Join(parent, "out"))
+	require.NoError(t, err)
+
+	// Copy the link first to exercise writes through a planted parent.
+	link, err := f.NewObject(ctx, "escape.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, link.Remote(), link)
+	require.NoError(t, err)
+	child, err := f.NewObject(ctx, "escape/pwned")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dst, nil, child.Remote(), child)
+	assert.Error(t, err)
+	outsideEntries, err := os.ReadDir(outside)
+	require.NoError(t, err)
+	assert.Empty(t, outsideEntries)
+}
