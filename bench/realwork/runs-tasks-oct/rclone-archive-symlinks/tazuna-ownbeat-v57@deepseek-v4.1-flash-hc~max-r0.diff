+// zipEntry is one entry of a zip built by writeZipEntries. A symlink is
+// written with os.ModeSymlink set in its mode and its target as content.
+type zipEntry struct {
+	name    string
+	target  string // link target if symlink, else content
+	symlink bool
+}
+
+// writeZipEntries builds a zip file with full control over each entry's
+// mode so symlinks can be created.
+func writeZipEntries(t *testing.T, dir, name string, entries ...zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, e := range entries {
+		h := &zip.FileHeader{Name: e.name, Method: zip.Store}
+		mode := os.FileMode(0644)
+		if e.symlink {
+			mode = os.ModeSymlink | 0777
+		}
+		h.SetMode(mode)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(e.target))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// linksContext returns a context with -l/--links turned on.
+func linksContext() context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	return ctx
+}
