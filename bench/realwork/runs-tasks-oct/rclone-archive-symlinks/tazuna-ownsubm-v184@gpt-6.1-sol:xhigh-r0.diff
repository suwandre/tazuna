+++ b/backend/archive/symlinks_test.go
@@ -0,0 +1,261 @@
+//go:build !plan9
+
+package archive
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"io"
+	"log/slog"
+	"os"
+	"path"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/rclone/rclone/backend/archive/archiver"
+	"github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/config/configmap"
+	"github.com/rclone/rclone/fs/sync"
+	"github.com/rclone/rclone/fstest/fstests"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type linkArchiveEntry struct {
+	name, content string
+	mode          os.FileMode
+}
+
+// These entries match squashfs/testdata/symlinks.sqfs.
+var linkArchiveEntries = []linkArchiveEntry{
+	{"src/file.txt", "hello", 0600},
+	{"src/link.txt", "file.txt", os.ModeSymlink | 0777},
+	{"src/dirlink", ".", os.ModeSymlink | 0777},
+	{"src/dangling", "missing.txt", os.ModeSymlink | 0777},
+	{"src/literal.rclonelink", "ordinary file", 0600},
+	{"src/ends.rclonelink", "file.txt", os.ModeSymlink | 0777},
+}
+
+func writeLinkZip(t *testing.T, name string, entries []linkArchiveEntry) {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		fh := &zip.FileHeader{Name: entry.name, Method: zip.Deflate, Modified: time.Unix(1700000000, 0)}
+		fh.SetMode(entry.mode)
+		w, err := zw.CreateHeader(fh)
+		require.NoError(t, err)
+		_, err = io.WriteString(w, entry.content)
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(name, buf.Bytes(), 0600))
+}
+
+func TestArchiveSymlinks(t *testing.T) {
+	for _, a := range archiver.Archivers {
+		if a.Extension != ".zip" && a.Extension != ".sqfs" {
+			continue
+		}
+		t.Run(a.Extension, func(t *testing.T) {
+			for _, links := range []bool{false, true} {
+				name := "Skip"
+				if links {
+					name = "Translate"
+				}
+				t.Run(name, func(t *testing.T) {
+					ctx, ci := fs.AddConfig(context.Background())
+					ci.Links = links
+					dir := t.TempDir()
+					name := "test" + a.Extension
+					if a.Extension == ".zip" {
+						writeLinkZip(t, filepath.Join(dir, name), linkArchiveEntries)
+					} else {
+						data, err := os.ReadFile("squashfs/testdata/symlinks.sqfs")
+						require.NoError(t, err)
+						require.NoError(t, os.WriteFile(filepath.Join(dir, name), data, 0600))
+					}
+					wrapped, err := local.NewFs(ctx, "local", dir, configmap.Simple{})
+					require.NoError(t, err)
+
+					for _, mount := range []struct{ prefix, root string }{{}, {prefix: name}, {root: "src"}} {
+						t.Run(mount.prefix+"/"+mount.root, func(t *testing.T) {
+							var logs bytes.Buffer
+							fs.SetLogger(slog.NewTextHandler(&logs, nil))
+							defer fs.SetLogger(slog.Default().Handler())
+							f, err := a.New(ctx, wrapped, name, mount.prefix, mount.root)
+							require.NoError(t, err)
+							remoteDir := path.Join(mount.prefix, "src")
+							if mount.root != "" {
+								remoteDir = ""
+							}
+							entries, err := f.List(ctx, remoteDir)
+							require.NoError(t, err)
+							var want []string
+							for _, entry := range linkArchiveEntries {
+								remote := path.Join(remoteDir, path.Base(entry.name))
+								if entry.mode&os.ModeSymlink != 0 {
+									_, err := f.NewObject(ctx, remote)
+									assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+									remote += fs.LinkSuffix
+									if !links {
+										_, err := f.NewObject(ctx, remote)
+										assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+										continue
+									}
+								}
+								want = append(want, remote)
+								o, err := f.NewObject(ctx, remote)
+								require.NoError(t, err)
+								assert.Equal(t, remote, o.Remote())
+								assert.Equal(t, int64(len(entry.content)), o.Size())
+								assert.Equal(t, entry.content, fstests.ReadObject(ctx, t, o, -1))
+								assert.Equal(t, entry.content[1:], fstests.ReadObject(ctx, t, o, -1, &fs.SeekOption{Offset: 1}))
+								assert.Equal(t, entry.content[:1], fstests.ReadObject(ctx, t, o, -1, &fs.RangeOption{Start: 0, End: 0}))
+								assert.Equal(t, entry.content[len(entry.content)-1:], fstests.ReadObject(ctx, t, o, -1, &fs.RangeOption{Start: -1, End: 1}))
+								assert.Equal(t, "", fstests.ReadObject(ctx, t, o, -1, &fs.SeekOption{Offset: o.Size()}))
+							}
+							var got []string
+							for _, entry := range entries {
+								got = append(got, entry.Remote())
+								o, err := f.NewObject(ctx, entry.Remote())
+								require.NoError(t, err)
+								assert.Equal(t, entry.Size(), o.Size())
+								assert.Equal(t, entry.ModTime(ctx), o.ModTime(ctx))
+							}
+							assert.ElementsMatch(t, want, got)
+							if !links {
+								assert.Contains(t, logs.String(), "--links")
+							}
+							_, err = f.NewObject(ctx, path.Join(remoteDir, "dirlink/file.txt"))
+							assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+						})
+					}
+
+					if links {
+						t.Run("SingleObject", func(t *testing.T) {
+							for _, nameInArchive := range []string{"link.txt" + fs.LinkSuffix, "literal.rclonelink", "ends.rclonelink" + fs.LinkSuffix} {
+								f, err := a.New(ctx, wrapped, name, "", "src/"+nameInArchive)
+								require.ErrorIs(t, err, fs.ErrorIsFile)
+								entries, err := f.List(ctx, "")
+								require.NoError(t, err)
+								require.Len(t, entries, 1)
+								assert.Equal(t, nameInArchive, entries[0].Remote())
+								o, err := f.NewObject(ctx, nameInArchive)
+								require.NoError(t, err)
+								want := "file.txt"
+								if nameInArchive == "literal.rclonelink" {
+									want = "ordinary file"
+								}
+								assert.Equal(t, want, fstests.ReadObject(ctx, t, o, -1))
+							}
+						})
+						t.Run("Copy", func(t *testing.T) {
+							// Probe symlink support before running the local destination test.
+							out := t.TempDir()
+							if err := os.Symlink("file.txt", filepath.Join(out, "probe")); err != nil {
+								t.Skipf("symlinks unavailable: %v", err)
+							}
+							f, err := NewFs(ctx, "archive", filepath.Join(dir, name)+"/src", configmap.Simple{})
+							require.NoError(t, err)
+							dst, err := local.NewFs(ctx, "local", out, configmap.Simple{})
+							require.NoError(t, err)
+							require.NoError(t, sync.CopyDir(ctx, dst, f, false))
+							for _, entry := range linkArchiveEntries {
+								if entry.mode&os.ModeSymlink != 0 {
+									target, err := os.Readlink(filepath.Join(out, path.Base(entry.name)))
+									require.NoError(t, err)
+									assert.Equal(t, entry.content, target)
+								}
+							}
+						})
+					}
+				})
+			}
+		})
+	}
+}
+
+func TestArchiveZipSymlinkTraversal(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	name := filepath.Join(dir, "hostile.zip")
+	writeLinkZip(t, name, []linkArchiveEntry{
+		{"src/escape/payload.txt", "must not escape", 0600},
+		{"src/./escape", "../outside", os.ModeSymlink | 0777},
+		{"src/escape/", "", os.ModeDir | 0700},
+		{"src/good.txt", "safe", 0600},
+	})
+	f, err := NewFs(ctx, "archive", name+"/src", configmap.Simple{})
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"escape" + fs.LinkSuffix, "good.txt"}, remotes)
+	_, err = f.NewObject(ctx, "escape/payload.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	for _, root := range []string{"src/escape", "src/escape/payload.txt"} {
+		inside, err := NewFs(ctx, "archive", name+"/"+root, configmap.Simple{})
+		require.NoError(t, err)
+		_, err = inside.NewObject(ctx, "payload.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	}
+	skipCtx, skipCI := fs.AddConfig(ctx)
+	skipCI.Links = false
+	skipped, err := NewFs(skipCtx, "archive", name+"/src", configmap.Simple{})
+	require.NoError(t, err)
+	entries, err = skipped.List(skipCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "good.txt", entries[0].Remote())
+	_, err = skipped.NewObject(skipCtx, "escape/payload.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	out := filepath.Join(t.TempDir(), "destination")
+	outside := filepath.Join(filepath.Dir(out), "outside")
+	require.NoError(t, os.Mkdir(outside, 0700))
+	if err := os.Symlink("target", filepath.Join(outside, "probe")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	dst, err := local.NewFs(ctx, "local", out, configmap.Simple{})
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, dst, f, false))
+	target, err := os.Readlink(filepath.Join(out, "escape"))
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", target)
+	data, err := os.ReadFile(filepath.Join(out, "good.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "safe", string(data))
+	_, err = os.Stat(filepath.Join(outside, "payload.txt"))
+	assert.True(t, os.IsNotExist(err), "copy wrote through an archive symlink: %v", err)
+}
+
+func TestArchiveZipSkippedLinksDirectory(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = false
+	name := filepath.Join(t.TempDir(), "links.zip")
+	writeLinkZip(t, name, []linkArchiveEntry{{"src/link", "target", os.ModeSymlink | 0777}})
+	f, err := NewFs(ctx, "archive", name, configmap.Simple{})
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "src", entries[0].Remote())
+	_, ok := entries[0].(fs.Directory)
+	assert.True(t, ok)
+	entries, err = f.List(ctx, "src")
+	require.NoError(t, err)
+	assert.Empty(t, entries)
+
+	f, err = NewFs(ctx, "archive", name+"/src", configmap.Simple{})
+	require.NoError(t, err)
+	entries, err = f.List(ctx, "")
+	require.NoError(t, err)
+	assert.Empty(t, entries)
+}
