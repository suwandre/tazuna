@@ -0,0 +1,30 @@
+# Symlink fixture
+
+`symlinks.sqfs` contains the entries used by `TestArchiveSymlinks`. Generate it
+from the repository root with Python 3 and `mksquashfs`:
+
+```python
+import os
+import pathlib
+import subprocess
+import tempfile
+
+with tempfile.TemporaryDirectory() as tmp:
+    root = pathlib.Path(tmp)
+    src = root / "src"
+    src.mkdir()
+    for name, content in [("file.txt", "hello"),
+                          ("literal.rclonelink", "ordinary file")]:
+        (src / name).write_text(content)
+        (src / name).chmod(0o600)
+    for name, target in [("link.txt", "file.txt"), ("dirlink", "."),
+                         ("dangling", "missing.txt"),
+                         ("ends.rclonelink", "file.txt")]:
+        os.symlink(target, src / name)
+    subprocess.run([
+        "mksquashfs", str(root),
+        "backend/archive/squashfs/testdata/symlinks.sqfs",
+        "-noappend", "-all-root", "-all-time", "1700000000",
+        "-mkfs-time", "1700000000", "-no-xattrs", "-processors", "1",
+    ], check=True)
+```
