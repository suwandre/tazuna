@@ -176,6 +184,9 @@ func (f *Fs) readZip() (singleObject bool, err error) {
 				singleObject = true
 				dt = dirtree.New()
 			}
+			if isLink {
+				remote += fs.LinkSuffix
+			}
 			o := &Object{
 				f:      f,
 				remote: remote,
@@ -191,6 +202,9 @@ func (f *Fs) readZip() (singleObject bool, err error) {
 	if skipped > 0 {
 		fs.Logf(f, "Skipped %d zip entries which escape the archive", skipped)
 	}
+	if skippedLinks > 0 {
+		fs.Logf(f, "Skipped %d symbolic links; use --links to include them", skippedLinks)
+	}
 	dt.CheckParents("")
 	dt.Sort()
 	f.dt = dt
diff --git a/backend/archive/zip/zip_internal_test.go b/backend/archive/zip/zip_internal_test.go
index 6aff03c..6ac2206 100644
--- a/backend/archive/zip/zip_internal_test.go
+++ b/backend/archive/zip/zip_internal_test.go
@@ -5,15 +5,20 @@ import (
 	"bytes"
 	"context"
 	"fmt"
+	"io"
 	"os"
 	"path/filepath"
+	"runtime"
 	"sort"
