diff --git a/backend/archive/squashfs/squashfs_internal_test.go b/backend/archive/squashfs/squashfs_internal_test.go
index 9b071bf..536dedb 100644
--- a/backend/archive/squashfs/squashfs_internal_test.go
+++ b/backend/archive/squashfs/squashfs_internal_test.go
@@ -2,9 +2,15 @@ package squashfs
 
 import (
 	"context"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
 	"testing"
 
 	_ "github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
 	fscache "github.com/rclone/rclone/fs/cache"
 	"github.com/stretchr/testify/assert"
 	"github.com/stretchr/testify/require"
@@ -30,3 +36,84 @@ func TestBackslashInName(t *testing.T) {
 	require.NoError(t, err)
 	assert.Equal(t, int64(6), o.Size())
 }
+
+func TestSymlinks(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks are not generally available on Windows")
+	}
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs executable not found")
+	}
+
+	ctx := context.Background()
+	input := filepath.Join(t.TempDir(), "input")
+	require.NoError(t, os.MkdirAll(filepath.Join(input, "src"), 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "src", "file.txt"), []byte("hello"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "src", "link.txt")))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "src", "regular.rclonelink"), []byte("regular file"), 0600))
+	image := filepath.Join(t.TempDir(), "links.sqfs")
+	output, err := exec.Command(mksquashfs, input, image, "-noappend", "-quiet").CombinedOutput()
+	require.NoError(t, err, string(output))
+
+	localFs, err := fscache.Get(ctx, filepath.Dir(image))
+	require.NoError(t, err)
+
+	t.Run("SkippedWithoutLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, filepath.Base(image), "", "")
+		require.NoError(t, err)
+		entries, err := f.List(ctx, "src")
+		require.NoError(t, err)
+		var names []string
+		for _, entry := range entries {
+			names = append(names, entry.Remote())
+		}
+		assert.Equal(t, []string{"src/file.txt", "src/regular.rclonelink"}, names)
+		_, err = f.NewObject(ctx, "src/link.txt.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err := New(ctx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.Equal(t, []string{"src/file.txt", "src/link.txt.rclonelink", "src/regular.rclonelink"}, names)
+
+	link, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	for _, test := range []struct {
+		option fs.OpenOption
+		want   string
+	}{
+		{nil, "file.txt"},
+		{&fs.SeekOption{Offset: 2}, "le.txt"},
+		{&fs.RangeOption{Start: 1, End: 3}, "ile"},
+	} {
+		var options []fs.OpenOption
+		if test.option != nil {
+			options = append(options, test.option)
+		}
+		rc, err := link.Open(ctx, options...)
+		require.NoError(t, err)
+		data, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, test.want, string(data))
+	}
+
+	regular, err := f.NewObject(ctx, "src/regular.rclonelink")
+	require.NoError(t, err)
+	rc, err := regular.Open(ctx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "regular file", string(data))
+}
