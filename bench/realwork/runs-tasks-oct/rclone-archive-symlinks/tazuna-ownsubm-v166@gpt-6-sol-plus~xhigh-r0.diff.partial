 )
@@ -170,3 +175,131 @@ func TestListCacheNotAliased(t *testing.T) {
 	}
 	assert.Equal(t, []string{"a.txt", "b.txt", "c.txt"}, remotes)
 }
+
+type zipMember struct {
+	name, body string
+	link       bool
+}
+
+func symlinkZip(t *testing.T, dir, name string, members ...zipMember) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, member := range members {
+		header := &zip.FileHeader{Name: member.name, Method: zip.Store}
+		if member.link {
+			header.SetMode(os.ModeSymlink | 0777)
+		}
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(member.body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+func TestZipSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := symlinkZip(t, dir, "links.zip",
+		zipMember{"src/file.txt", "hello", false},
+		zipMember{"src/link.txt", "file.txt", true},
+		zipMember{"src/regular.rclonelink", "regular file", false},
+	)
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	t.Run("SkippedWithoutLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		entries, err := f.List(ctx, "src")
+		require.NoError(t, err)
+		var names []string
+		for _, entry := range entries {
+			names = append(names, entry.Remote())
+		}
+		assert.Equal(t, []string{"src/file.txt", "src/regular.rclonelink"}, names)
+		_, err = f.NewObject(ctx, "src/link.txt.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.Equal(t, []string{"src/file.txt", "src/link.txt.rclonelink", "src/regular.rclonelink"}, names)
+
+	link, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	read := func(options ...fs.OpenOption) string {
+		rc, err := link.Open(ctx, options...)
+		require.NoError(t, err)
+		defer rc.Close()
+		data, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		return string(data)
+	}
+	assert.Equal(t, "file.txt", read())
+	assert.Equal(t, "le.txt", read(&fs.SeekOption{Offset: 2}))
+	assert.Equal(t, "ile", read(&fs.RangeOption{Start: 1, End: 3}))
+
+	regular, err := f.NewObject(ctx, "src/regular.rclonelink")
+	require.NoError(t, err)
+	rc, err := regular.Open(ctx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "regular file", string(data))
+
+	t.Run("CopyLinks", func(t *testing.T) {
+		if runtime.GOOS == "windows" {
+			t.Skip("symlinks are not generally available on Windows")
+		}
+		dstRoot := t.TempDir()
+		dst, err := local.NewFs(ctx, "local", dstRoot, configmap.Simple{"links": "true"})
+		require.NoError(t, err)
+		_, err = operations.Copy(ctx, dst, nil, "src/link.txt.rclonelink", link)
+		require.NoError(t, err)
+		target, err := os.Readlink(filepath.Join(dstRoot, "src", "link.txt"))
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", target)
+	})
+}
+
+func TestZipSymlinkCannotEscapeDestination(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	name := symlinkZip(t, dir, "hostile.zip",
+		zipMember{"pwn", "../outside", true},
+		zipMember{"pwn/authkeys", "not outside", false},
+	)
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	src, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	parent := t.TempDir()
+	outside := filepath.Join(parent, "outside")
+	require.NoError(t, os.Mkdir(outside, 0700))
+	dstRoot := filepath.Join(parent, "out")
+	require.NoError(t, os.Mkdir(dstRoot, 0700))
+	dst, err := local.NewFs(ctx, "local", dstRoot, configmap.Simple{"links": "true"})
+	require.NoError(t, err)
+	_ = sync.CopyDir(ctx, dst, src, false)
+	linkTarget, err := os.Readlink(filepath.Join(dstRoot, "pwn"))
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", linkTarget)
+	entries, err := os.ReadDir(outside)
+	require.NoError(t, err)
+	assert.Empty(t, entries, "archive contents escaped the destination")
+}
