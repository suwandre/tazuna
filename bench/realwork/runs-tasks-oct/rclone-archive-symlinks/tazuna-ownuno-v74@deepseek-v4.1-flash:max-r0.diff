+	name := writeZipWith(t, dir, "links.zip", func(zw *zip.Writer) {
+		addFile(t, zw, "src/file.txt", "hello world")
+		addSymlink(t, zw, "src/link.txt", "file.txt")
+	})
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	linkCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	f, err := New(linkCtx, localFs, name, "", "src/link.txt.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err := f.List(linkCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt.rclonelink", entries[0].Remote())
+	o, err := f.NewObject(linkCtx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", readObject(t, o))
+}
+
+// A hostile archive with a symlink pointing outside the destination
+// and a member beneath it must not make a copy write through the link.
+func TestSymlinkEscapeWriteThroughBlocked(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	outside := t.TempDir()
+	name := writeZipWith(t, dir, "evil.zip", func(zw *zip.Writer) {
+		addSymlink(t, zw, "pwn", outside)
+		addFile(t, zw, "pwn/authkeys", "PWNED")
+	})
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	linkCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	srcFs, err := New(linkCtx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dstFs, err := cache.Get(linkCtx, dstDir)
+	require.NoError(t, err)
+
+	// Reproduce the symlink faithfully.
+	link, err := srcFs.NewObject(linkCtx, "pwn.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(linkCtx, dstFs, nil, "pwn.rclonelink", link)
+	require.NoError(t, err)
+	fi, err := os.Lstat(filepath.Join(dstDir, "pwn"))
+	require.NoError(t, err)
+	require.NotZero(t, fi.Mode()&os.ModeSymlink, "symlink should be reproduced")
+
+	// Writing the member below it must not escape the destination.
+	member, err := srcFs.NewObject(linkCtx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(linkCtx, dstFs, nil, "pwn/authkeys", member)
+	require.Error(t, err, "writing through a planted symlink should be refused")
+	_, err = os.Stat(filepath.Join(outside, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", outside)
+}
