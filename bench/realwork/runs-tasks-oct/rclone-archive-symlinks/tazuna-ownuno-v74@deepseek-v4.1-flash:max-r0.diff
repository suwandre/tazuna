+// Convert a symlink entry with the given target into an Object from
+// native dir. The object is named with the link suffix and its size is
+// the length of the target.
+func (f *Fs) newLinkObject(nativeDir string, item os.FileInfo, target string) *Object {
+	o := f.objectFromFileInfo(nativeDir, item)
+	o.remote += fs.LinkSuffix
+	o.size = int64(len(target))
+	o.target = target
+	o.isLink = true
+	return o
+}
