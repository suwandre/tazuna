+// remotes returns the remote names of entries.
+func remotes(entries fs.DirEntries) []string {
+	names := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	return names
+}
+
+// readObject reads the whole of o and returns it as a string.
+func readObject(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(contents)
+}
+
+// Symlinks are skipped unless -l/--links is in use, when they are
+// exposed with the link suffix and read back their target.
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	// Without --links the symlink is skipped and the regular file
+	// whose name ends in the link suffix stays a regular file.
+	f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "src")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"src/file.txt", "src/real.rclonelink"}, remotes(entries))
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = f.NewObject(ctx, "src/link.txt.rclonelink")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// With --links the symlink is exposed under the link suffix.
+	linkCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(linkCtx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = f.List(linkCtx, "src")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"src/file.txt", "src/link.txt.rclonelink", "src/real.rclonelink"}, remotes(entries))
+
+	const target = "file.txt"
+	o, err := f.NewObject(linkCtx, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "src/link.txt.rclonelink", o.Remote())
+	assert.Equal(t, int64(len(target)), o.Size())
+	assert.Equal(t, target, readObject(t, o))
+	assert.Equal(t, target[2:], readObject(t, o, &fs.SeekOption{Offset: 2}))
+	assert.Equal(t, target[2:5], readObject(t, o, &fs.RangeOption{Start: 2, End: 4}))
+	assert.Equal(t, "", readObject(t, o, &fs.RangeOption{Start: int64(len(target)) + 1, End: -1}))
+
+	// The unsuffixed name doesn't exist when translating links.
+	_, err = f.NewObject(linkCtx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// A regular member whose name ends in the suffix is unchanged.
+	o, err = f.NewObject(linkCtx, "src/real.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("not a link")), o.Size())
+	assert.Equal(t, "not a link", readObject(t, o))
+}
+
+// Mounting an archive at a symlink must use the suffixed name.
+func TestSymlinkSingleObject(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+	linkCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	f, err := New(linkCtx, localFs, "symlink.sqfs", "", "src/link.txt.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err := f.List(linkCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt.rclonelink", entries[0].Remote())
+	o, err := f.NewObject(linkCtx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", readObject(t, o))
