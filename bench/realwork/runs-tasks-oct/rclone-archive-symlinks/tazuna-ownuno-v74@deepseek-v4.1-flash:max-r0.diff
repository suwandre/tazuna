+// symlinkTarget returns the target of entry if it is a symlink.
+func symlinkTarget(entry iofs.DirEntry) (target string, isLink bool, err error) {
+	if entry.Type()&os.ModeSymlink == 0 {
+		return "", false, nil
+	}
+	link, ok := entry.(interface{ Readlink() (string, error) })
+	if !ok {
+		return "", false, fmt.Errorf("symlink %q has no target", entry.Name())
+	}
+	target, err = link.Readlink()
+	if err != nil {
+		return "", false, fmt.Errorf("error reading symlink %q: %w", entry.Name(), err)
+	}
+	return target, true, nil
+}
