+// zipEntry describes a member of a zip file built by writeZipSymlinks.
+// A non-empty link makes the member a symbolic link with that target.
+type zipEntry struct {
+	name    string
+	link    string
+	content string
+}
+
+// writeZipSymlinks builds a zip file in dir with the given entries and
+// returns the archive's leaf name.
+func writeZipSymlinks(t *testing.T, dir, name string, entries ...zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, e := range entries {
+		h := &zip.FileHeader{Name: e.name, Method: zip.Store}
+		if e.link != "" {
+			h.SetMode(os.ModeSymlink | 0777)
+		} else {
+			h.SetMode(0644)
+		}
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		content := e.content
+		if e.link != "" {
+			content = e.link
+		}
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// linksContext returns ctx with -l/--links enabled
+func linksContext() context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	return ctx
+}
+
+// noticeLogLevel makes sure notice level logging is enabled for the
+// duration of the test, returning the context to use.
+//
+// fs.Logf logs through the global config, so the global level is set
+// rather than one embedded in the context.
+func noticeLogLevel(t *testing.T) context.Context {
+	ctx := context.Background()
+	ci := fs.GetConfig(ctx)
+	oldLevel := ci.LogLevel
+	ci.LogLevel = fs.LogLevelNotice
+	t.Cleanup(func() { ci.LogLevel = oldLevel })
+	return ctx
+}
+
+// Without --links symlinks must be skipped, and with it they must be
+// listed under their name plus .rclonelink with their target as their
+// contents. A regular member ending in .rclonelink stays a regular file.
+func TestReadZipSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipSymlinks(t, dir, "links.zip",
+		zipEntry{name: "file.txt", content: "hello"},
+		zipEntry{name: "link.txt", link: "file.txt"},
+		zipEntry{name: "regular.rclonelink", content: "not a link"},
+		zipEntry{name: "sub/link.txt", link: "../file.txt"},
+	)
+
+	localFs, err := cache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	// Without --links the symlink is hidden
+	f, err := New(context.Background(), localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"file.txt", "regular.rclonelink"}, allRemotes(t, f))
+
+	// With --links it appears under its suffixed name
+	ctx := linksContext()
+	f, err = New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"file.txt", "link.txt.rclonelink", "regular.rclonelink", "sub/link.txt.rclonelink"}, allRemotes(t, f))
+
+	// Listing and NewObject must agree on the names which exist
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	for _, entry := range entries {
+		_, isDir := entry.(fs.Directory)
+		o, err := f.NewObject(ctx, entry.Remote())
+		if isDir {
+			assert.ErrorIs(t, err, fs.ErrorNotAFile, entry.Remote())
+			continue
+		}
+		require.NoError(t, err, entry.Remote())
+		assert.Equal(t, entry.Remote(), o.Remote())
+	}
+	// The unsuffixed name doesn't exist
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	// The regular file with the suffix is still a regular file
+	o, err := f.NewObject(ctx, "regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("not a link")), o.Size())
+
+	// The symlink's size is its target length and opening it reads the target
+	o, err = f.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file.txt", string(contents))
+
+	// Range and seek options are honoured
+	for _, test := range []struct {
+		option fs.OpenOption
+		want   string
+	}{
+		{&fs.SeekOption{Offset: 5}, "txt"},
+		{&fs.RangeOption{Start: 0, End: 3}, "file"},
+		{&fs.RangeOption{Start: 5, End: -1}, "txt"},
+	} {
+		rc, err := o.Open(ctx, test.option)
+		require.NoError(t, err)
+		contents, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, test.want, string(contents), "%v", test.option)
+	}
+
+	// A symlink in a subdirectory is listed and found there
+	entries, err = f.List(ctx, "sub")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "sub/link.txt.rclonelink", entries[0].Remote())
+	o, err = f.NewObject(ctx, "sub/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("../file.txt")), o.Size())
+}
+
+// A symlink at the root of a single file archive must be found by its
+// suffixed name.
+func TestReadZipSymlinkSingleObject(t *testing.T) {
+	dir := t.TempDir()
+	name := writeZipSymlinks(t, dir, "links.zip",
+		zipEntry{name: "link.txt", link: "file.txt"},
+	)
+
+	localFs, err := cache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	ctx := linksContext()
+	f, err := New(ctx, localFs, name, "", "link.txt.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt.rclonelink", entries[0].Remote())
+
+	o, err := f.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+}
+
+// Without --links the user must be told symlinks were skipped, naming
+// the flag which would include them.
+func TestReadZipSymlinkNotice(t *testing.T) {
+	var logs []string
+	log.Handler.SetOutput(func(_ slog.Level, text string) {
+		logs = append(logs, text)
+	})
+	defer log.Handler.ResetOutput()
+
+	ctx := noticeLogLevel(t)
+
+	dir := t.TempDir()
+	name := writeZipSymlinks(t, dir, "links.zip",
+		zipEntry{name: "file.txt", content: "hello"},
+		zipEntry{name: "link.txt", link: "file.txt"},
+	)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	_, err = New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Contains(t, strings.Join(logs, "\n"), "--links")
+
+	// With --links nothing is skipped so there is no notice
+	logs = nil
+	_, err = New(linksContext(), localFs, name, "", "")
+	require.NoError(t, err)
+	assert.NotContains(t, strings.Join(logs, "\n"), "--links")
+}
