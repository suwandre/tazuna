+// linksZip writes a zip file to dir containing a symlink "pwn" pointing
+// above the archive root and a member "pwn/authkeys" inside it, then
+// returns the archive's path.
+func linksZip(t *testing.T, dir string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	link := &zip.FileHeader{Name: "pwn", Method: zip.Store}
+	link.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(link)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("../../outside"))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(dir, "hostile.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+	return zipPath
+}
+
+// TestArchiveSymlinkEscape checks that copying a hostile archive with
+// --links recreates its symlinks faithfully but can't write through them
+// out of the destination.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	// dst is two levels below base so the symlink target "../../outside"
+	// would land in base/outside, a sibling of dst's tree
+	base := t.TempDir()
+	dst := filepath.Join(base, "sub", "dst")
+	outside := filepath.Join(base, "outside")
+
+	zipPath := linksZip(t, t.TempDir())
+	fsrc, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	fdst, err := cache.Get(ctx, dst)
+	require.NoError(t, err)
+
+	// The symlink is reproduced faithfully, pointing outside the destination
+	srcLink, err := fsrc.NewObject(ctx, "pwn.rclonelink")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, fdst, nil, "pwn.rclonelink", srcLink)
+	require.NoError(t, err)
+	target, err := os.Readlink(filepath.Join(dst, "pwn"))
+	require.NoError(t, err)
+	assert.Equal(t, "../../outside", target)
+
+	// But writing a member through it must be refused
+	srcFile, err := fsrc.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, fdst, nil, "pwn/authkeys", srcFile)
+	require.Error(t, err, "writing through a planted symlink should be refused")
+
+	// Nothing escaped the destination
+	_, err = os.Stat(filepath.Join(outside, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", outside)
+}
+
+// TestArchiveSymlinkCopy checks that copying an archive with --links
+// recreates its symlinks as symlinks, and that without --links they are
+// skipped.
+func TestArchiveSymlinkCopy(t *testing.T) {
+	fstest.Initialise()
+
+	// makeArchive writes an archive with a file and a symlink to it,
+	// returning its path
+	makeArchive := func(t *testing.T, name string) string {
+		var buf bytes.Buffer
+		zw := zip.NewWriter(&buf)
+		w, err := zw.Create("src/file.txt")
+		require.NoError(t, err)
+		_, err = w.Write([]byte("hello"))
+		require.NoError(t, err)
+		link := &zip.FileHeader{Name: "src/link.txt", Method: zip.Store}
+		link.SetMode(os.ModeSymlink | 0777)
+		w, err = zw.CreateHeader(link)
+		require.NoError(t, err)
+		_, err = w.Write([]byte("file.txt"))
+		require.NoError(t, err)
+		require.NoError(t, zw.Close())
+		zipPath := filepath.Join(t.TempDir(), name)
+		require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+		return zipPath
+	}
+
+	// Without --links the symlink is skipped
+	ctx := context.Background()
+	fsrc, err := cache.Get(ctx, ":archive:"+makeArchive(t, "nolinks.zip"))
+	require.NoError(t, err)
+	dstNoLinks := t.TempDir()
+	fdst, err := cache.Get(ctx, dstNoLinks)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, fdst, fsrc, false))
+	_, err = os.Lstat(filepath.Join(dstNoLinks, "src", "link.txt"))
+	assert.True(t, os.IsNotExist(err), "symlink should be skipped without --links")
+
+	// With --links it is recreated as a symlink
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	fsrc, err = cache.Get(linksCtx, ":archive:"+makeArchive(t, "links.zip"))
+	require.NoError(t, err)
+	dstLinks := t.TempDir()
+	fdst, err = cache.Get(linksCtx, dstLinks)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(linksCtx, fdst, fsrc, false))
+	target, err := os.Readlink(filepath.Join(dstLinks, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+}
