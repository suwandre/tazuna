+// TestSymlinks checks the handling of the symbolic links in
+// testdata/symlinks.sqfs, which contains
+//
+//	file.txt              "hello\n"
+//	regular.rclonelink    a regular file ending in the link suffix
+//	link.txt      -> file.txt
+//	up.txt        -> ../../etc/passwd
+//	sub/link.txt  -> ../file.txt
+//
+// It was built from that tree with
+//
+//	mksquashfs src symlinks.sqfs -noappend -comp gzip -all-root -all-time 0 -mkfs-time 0
+//
+// Without --links symlinks must be skipped, and with it they must be
+// listed under their name plus .rclonelink with their target as their
+// contents. A regular file ending in .rclonelink stays a regular file.
+func TestSymlinks(t *testing.T) {
+	localFs, err := fscache.Get(context.Background(), "testdata")
+	require.NoError(t, err)
+
+	// Without --links the symlinks are hidden
+	f, err := New(context.Background(), localFs, "symlinks.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := f.List(context.Background(), "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.Equal(t, []string{"file.txt", "regular.rclonelink", "sub"}, remotes)
+
+	// With --links they appear under their suffixed name
+	ctx := linksContext()
+	f, err = New(ctx, localFs, "symlinks.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = f.List(ctx, "")
+	require.NoError(t, err)
+	remotes = nil
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"file.txt", "link.txt.rclonelink", "regular.rclonelink", "sub", "up.txt.rclonelink"}, remotes)
+
+	// Listing and NewObject must agree on the names which exist
+	for _, entry := range entries {
+		_, isDir := entry.(fs.Directory)
+		o, err := f.NewObject(ctx, entry.Remote())
+		if isDir {
+			assert.ErrorIs(t, err, fs.ErrorNotAFile, entry.Remote())
+			continue
+		}
+		require.NoError(t, err, entry.Remote())
+		assert.Equal(t, entry.Remote(), o.Remote())
+	}
+	// The unsuffixed name of a symlink doesn't exist
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	// A regular file with the suffix is still a regular file
+	o, err := f.NewObject(ctx, "regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("regular rclonelink file\n")), o.Size())
+
+	// The symlink's size is its target length and opening it reads the target
+	o, err = f.NewObject(ctx, "link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file.txt", string(contents))
+
+	// Range and seek options are honoured
+	for _, test := range []struct {
+		option fs.OpenOption
+		want   string
+	}{
+		{&fs.SeekOption{Offset: 5}, "txt"},
+		{&fs.RangeOption{Start: 0, End: 3}, "file"},
+		{&fs.RangeOption{Start: 5, End: -1}, "txt"},
+	} {
+		rc, err := o.Open(ctx, test.option)
+		require.NoError(t, err)
+		contents, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, test.want, string(contents), "%v", test.option)
+	}
+
+	// A symlink in a subdirectory is listed and found there
+	entries, err = f.List(ctx, "sub")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "sub/link.txt.rclonelink", entries[0].Remote())
+	o, err = f.NewObject(ctx, "sub/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("../file.txt")), o.Size())
+}
+
+// Without --links the user must be told symlinks were skipped, naming
+// the flag which would include them.
+func TestSymlinkNotice(t *testing.T) {
+	var logs []string
+	log.Handler.SetOutput(func(_ slog.Level, text string) {
+		logs = append(logs, text)
+	})
+	defer log.Handler.ResetOutput()
+
+	ctx := noticeLogLevel(t)
+
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, "symlinks.sqfs", "", "")
+	require.NoError(t, err)
+	_, err = f.List(ctx, "")
+	require.NoError(t, err)
+	assert.Contains(t, strings.Join(logs, "\n"), "--links")
+
+	// With --links nothing is skipped so there is no notice
+	logs = nil
+	f, err = New(linksContext(), localFs, "symlinks.sqfs", "", "")
+	require.NoError(t, err)
+	_, err = f.List(linksContext(), "")
+	require.NoError(t, err)
+	assert.NotContains(t, strings.Join(logs, "\n"), "--links")
+}
