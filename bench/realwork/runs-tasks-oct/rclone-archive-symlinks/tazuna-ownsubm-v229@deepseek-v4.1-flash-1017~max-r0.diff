+
+// noticeLogLevel makes sure notice level logging is enabled for the
+// duration of the test, returning the context to use.
+//
+// fs.Logf logs through the global config, so the global level is set
+// rather than one embedded in the context.
+func noticeLogLevel(t *testing.T) context.Context {
+	ctx := context.Background()
+	ci := fs.GetConfig(ctx)
+	oldLevel := ci.LogLevel
