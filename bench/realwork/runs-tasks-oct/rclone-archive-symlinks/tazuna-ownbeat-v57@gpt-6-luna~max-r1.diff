+	entries, err = f.List(linksCtx, "src")
+	require.NoError(t, err)
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	assert.Equal(t, []string{"src/escape.rclonelink", "src/file.txt", "src/link.txt.rclonelink", "src/regular.rclonelink"}, names)
+
+	link, err := f.NewObject(linksCtx, "src/link.txt.rclonelink")
