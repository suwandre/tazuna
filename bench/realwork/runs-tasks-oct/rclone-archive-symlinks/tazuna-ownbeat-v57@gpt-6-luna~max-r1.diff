+	name := "links.zip"
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name, data string
+		mode       os.FileMode
+	}{
+		{"src/file.txt", "hello", 0644},
+		{"src/link.txt", "file.txt", os.ModeSymlink | 0777},
+		{"src/regular.rclonelink", "regular file", 0644},
+		{"src/escape", "../../outside", os.ModeSymlink | 0777},
+		{"src/escape/owned", "must not be copied", 0644},
+	} {
+		header := &zip.FileHeader{Name: entry.name}
+		header.SetMode(entry.mode)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.data))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	plain, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	entries, err := plain.List(ctx, "src")
+	require.NoError(t, err)
+	assert.Len(t, entries, 3)
+	if _, err := plain.NewObject(ctx, "src/link.txt.rclonelink"); !errors.Is(err, fs.ErrorObjectNotFound) {
+		t.Fatalf("expected skipped symlink to be absent, got %v", err)
+	}
+
+	linksCtx, config := fs.AddConfig(ctx)
+	config.Links = true
