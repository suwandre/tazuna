+	regular, err := f.NewObject(linksCtx, "src/regular.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "regular file", string(fstests.ReadObject(linksCtx, t, regular, -1)))
+	if _, err := f.NewObject(linksCtx, "src/escape/owned"); !errors.Is(err, fs.ErrorObjectNotFound) {
+		t.Fatalf("expected member below symlink to be absent, got %v", err)
+	}
+
+	destinationRoot := t.TempDir()
+	destination := filepath.Join(destinationRoot, "out")
+	require.NoError(t, os.Mkdir(destination, 0700))
+	dstFs, err := cache.Get(linksCtx, destination)
+	require.NoError(t, err)
+	require.NoError(t, rclonesync.CopyDir(linksCtx, dstFs, f, false))
+	gotTarget, err := os.Readlink(filepath.Join(destination, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", gotTarget)
+	assert.NoFileExists(t, filepath.Join(destinationRoot, "outside", "owned"))
+	assert.NoFileExists(t, filepath.Join(destination, "src", "escape", "owned"))
+}
