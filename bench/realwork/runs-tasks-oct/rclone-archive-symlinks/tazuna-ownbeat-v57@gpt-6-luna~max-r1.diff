+	assert.Equal(t, "le", string(fstests.ReadObject(linksCtx, t, link, -1, &fs.RangeOption{Start: 2, End: 3})))
+	assert.Equal(t, "e.txt", string(fstests.ReadObject(linksCtx, t, link, -1, &fs.SeekOption{Offset: 3})))
