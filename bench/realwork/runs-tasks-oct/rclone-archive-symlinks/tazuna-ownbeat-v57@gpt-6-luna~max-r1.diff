+func TestSymlinkEntries(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs not found")
+	}
+	ctx := context.Background()
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "target.txt"), []byte("target data"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "ordinary.rclonelink"), []byte("regular"), 0600))
+	if err := os.Symlink("target.txt", filepath.Join(input, "link")); err != nil {
+		t.Skipf("can't create symlink: %v", err)
+	}
+	archiveDir := t.TempDir()
+	archivePath := filepath.Join(archiveDir, "links.sqfs")
+	output, err := exec.Command(mksquashfs, input, archivePath, "-noappend", "-quiet").CombinedOutput()
+	require.NoError(t, err, string(output))
+
+	localFs, err := fscache.Get(ctx, archiveDir)
+	require.NoError(t, err)
+	plain, err := New(ctx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := plain.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 2)
+	if _, err := plain.NewObject(ctx, "link.rclonelink"); !errors.Is(err, fs.ErrorObjectNotFound) {
+		t.Fatalf("expected skipped symlink to be absent, got %v", err)
+	}
+
+	linksCtx, config := fs.AddConfig(ctx)
+	config.Links = true
+	f, err := New(linksCtx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = f.List(linksCtx, "")
+	require.NoError(t, err)
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Remote())
+	}
+	sort.Strings(names)
+	assert.Equal(t, []string{"link.rclonelink", "ordinary.rclonelink", "target.txt"}, names)
+
+	link, err := f.NewObject(linksCtx, "link.rclonelink")
+	require.NoError(t, err)
+	if _, err := f.NewObject(linksCtx, "link"); !errors.Is(err, fs.ErrorObjectNotFound) {
+		t.Fatalf("expected symlink without link suffix to be absent, got %v", err)
+	}
+	assert.Equal(t, int64(len("target.txt")), link.Size())
+	assert.Equal(t, "target.txt", string(fstests.ReadObject(linksCtx, t, link, -1)))
+	assert.Equal(t, "arg", string(fstests.ReadObject(linksCtx, t, link, -1, &fs.RangeOption{Start: 1, End: 3})))
+	assert.Equal(t, "et.txt", string(fstests.ReadObject(linksCtx, t, link, -1, &fs.SeekOption{Offset: 4})))
+
+	regular, err := f.NewObject(linksCtx, "ordinary.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "regular", string(fstests.ReadObject(linksCtx, t, regular, -1)))
+
+	single, err := New(linksCtx, localFs, "links.sqfs", "", "link.rclonelink")
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = single.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.rclonelink", entries[0].Remote())
+	_, err = single.NewObject(linksCtx, "link.rclonelink")
+	require.NoError(t, err)
+}
