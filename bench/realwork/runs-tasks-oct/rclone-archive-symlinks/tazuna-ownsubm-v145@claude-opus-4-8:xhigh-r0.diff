+// writeZipWithSymlinks builds a zip file that includes symlinks
+func writeZipWithSymlinks(t *testing.T, dir, name string, entries map[string]interface{}) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for path, content := range entries {
+		if target, isSymlink := content.(string); isSymlink && strings.HasPrefix(target, "->") {
+			// Create a symlink entry
+			target = strings.TrimPrefix(target, "->")
+			header := &zip.FileHeader{
+				Name:   path,
+				Method: zip.Store,
+			}
+			header.SetMode(os.ModeSymlink | 0755)
+			w, err := zw.CreateHeader(header)
+			require.NoError(t, err)
+			_, err = w.Write([]byte(target))
+			require.NoError(t, err)
+		} else if content == nil {
+			// Directory
+			w, err := zw.Create(path + "/")
+			require.NoError(t, err)
+			_ = w
+		} else if text, isString := content.(string); isString {
+			// Regular file
+			w, err := zw.Create(path)
+			require.NoError(t, err)
+			_, err = w.Write([]byte(text))
+			require.NoError(t, err)
+		}
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
