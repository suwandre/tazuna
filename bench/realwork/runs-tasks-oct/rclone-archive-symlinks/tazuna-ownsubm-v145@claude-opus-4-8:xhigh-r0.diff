+// TestSymlinks verifies that symlinks in zip files are properly handled
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	
+	// Create a zip with symlinks
+	name := writeZipWithSymlinks(t, dir, "symlinks.zip", map[string]interface{}{
+		"file.txt":      "file content",
+		"link.txt":      "->file.txt",
+		"dir":           nil,
+		"dir/file2.txt": "dir file content",
+		"dir/link2.txt": "->file2.txt",
+		"abslink.txt":   "->/etc/passwd",
+	})
+	
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	
+	t.Run("without --links", func(t *testing.T) {
+		// Without --links, symlinks should be skipped
+		ctx := context.Background()
+		ci := fs.GetConfig(ctx)
+		ci.Links = false
+		
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		
+		remotes := allRemotes(t, f)
+		// Only regular files should be listed
+		assert.Equal(t, []string{"dir/file2.txt", "file.txt"}, remotes)
+		
+		// Attempting to access a symlink should fail
+		_, err = f.NewObject(ctx, "link.txt.rclonelink")
+		assert.Error(t, err)
+	})
+	
+	t.Run("with --links", func(t *testing.T) {
+		// With --links, symlinks should appear with .rclonelink suffix
+		ctx := context.Background()
+		ci := fs.GetConfig(ctx)
+		ci.Links = true
+		
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		
+		remotes := allRemotes(t, f)
+		// Both regular files and symlinks should be listed
+		assert.Equal(t, []string{
+			"abslink.txt.rclonelink",
+			"dir/file2.txt",
+			"dir/link2.txt.rclonelink",
+			"file.txt",
+			"link.txt.rclonelink",
+		}, remotes)
+		
+		// Access a symlink and verify it returns the target
+		obj, err := f.NewObject(ctx, "link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, "link.txt.rclonelink", obj.Remote())
+		assert.Equal(t, int64(8), obj.Size()) // len("file.txt")
+		
+		// Read the symlink content
+		rc, err := obj.Open(ctx)
+		require.NoError(t, err)
+		defer rc.Close()
+		target, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", string(target))
+		
+		// Verify range reads work
+		obj2, err := f.NewObject(ctx, "dir/link2.txt.rclonelink")
+		require.NoError(t, err)
+		rc2, err := obj2.Open(ctx, &fs.RangeOption{Start: 0, End: 3})
+		require.NoError(t, err)
+		defer rc2.Close()
+		partial, err := io.ReadAll(rc2)
+		require.NoError(t, err)
+		assert.Equal(t, "file", string(partial))
+	})
