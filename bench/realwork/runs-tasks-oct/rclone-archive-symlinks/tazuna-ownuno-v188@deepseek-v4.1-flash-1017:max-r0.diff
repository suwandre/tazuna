+// TestArchiveSymlinkEscape checks that a hostile archive can't use a
+// symbolic link to make a --links copy write outside the destination.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	ctx := context.Background()
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	// The directory outside the destination the archive tries to write into
+	evil := t.TempDir()
+	evilFile := filepath.Join(evil, "authkeys")
+
+	// The archive holds a symlink "pwn" to that directory and a member
+	// "pwn/authkeys" which would be written through it
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	fh := &zip.FileHeader{Name: "pwn"}
+	fh.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(fh)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(evil))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	zipPath := filepath.Join(t.TempDir(), "evil.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	srcFs, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+
+	dstPath := t.TempDir()
+	dstFs, err := cache.Get(ctx, dstPath)
+	require.NoError(t, err)
+
+	// Reproduce the symlink faithfully...
+	linkObj, err := srcFs.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn"+fs.LinkSuffix, linkObj)
+	require.NoError(t, err)
+
+	// ...but writing the member through it must be refused.
+	memberObj, err := srcFs.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, dstFs, nil, "pwn/authkeys", memberObj)
+	require.Error(t, err, "writing through a planted symlink should be refused")
+
+	// Nothing escaped the destination
+	_, err = os.Stat(evilFile)
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evilFile)
+}
