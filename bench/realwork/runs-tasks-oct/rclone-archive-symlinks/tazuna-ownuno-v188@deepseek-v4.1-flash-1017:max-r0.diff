+// writeZipSymlinks builds a zip file in dir with a regular file, a
+// symbolic link and a regular file whose name ends in the link suffix.
+func writeZipSymlinks(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+
+	w, err := zw.Create("file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("hello"))
+	require.NoError(t, err)
+
+	fh := &zip.FileHeader{Name: "link.txt", Method: zip.Deflate}
+	fh.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(fh)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+
+	w, err = zw.Create("regular.rclonelink")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("not a link"))
+	require.NoError(t, err)
+
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
