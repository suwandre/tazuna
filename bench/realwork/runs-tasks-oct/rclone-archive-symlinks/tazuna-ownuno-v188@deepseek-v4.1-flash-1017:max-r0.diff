+// readLinkTarget returns the target of the symbolic link entry.
+func readLinkTarget(item os.DirEntry) (string, error) {
+	link, ok := item.(interface{ Readlink() (string, error) })
+	if !ok {
+		return "", fmt.Errorf("can't read the target of symbolic link %q", item.Name())
+	}
+	target, err := link.Readlink()
+	if err != nil {
+		return "", fmt.Errorf("error reading the target of symbolic link %q: %w", item.Name(), err)
+	}
+	return target, nil
