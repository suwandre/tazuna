+// newLinkReader returns a reader for the target of a symbolic link,
+// honouring the offset and limit decoded from the open options. A
+// negative limit means no limit.
+func newLinkReader(target string, offset, limit int64) io.ReadCloser {
+	// Clamp offset into range to avoid panic
+	if offset < 0 {
+		offset = 0
+	}
+	if offset > int64(len(target)) {
+		offset = int64(len(target))
+	}
+	return readers.NewLimitedReadCloser(io.NopCloser(strings.NewReader(target[offset:])), limit)
+}
