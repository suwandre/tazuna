+	assert.Equal(t, []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix, "src/regular" + fs.LinkSuffix}, allRemotes(t, f))
+
+	link, err := f.NewObject(linksCtx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	in, err := link.Open(linksCtx)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	assert.Equal(t, "file.txt", string(contents))
+
+	in, err = link.Open(linksCtx, &fs.SeekOption{Offset: 2})
+	require.NoError(t, err)
+	contents, err = io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	assert.Equal(t, "le.txt", string(contents))
+
+	in, err = link.Open(linksCtx, &fs.RangeOption{Start: 2, End: 5})
+	require.NoError(t, err)
+	contents, err = io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	assert.Equal(t, "le.t", string(contents))
+
+	regular, err := f.NewObject(linksCtx, "src/regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	in, err = regular.Open(linksCtx)
+	require.NoError(t, err)
+	contents, err = io.ReadAll(in)
+	require.NoError(t, err)
+	require.NoError(t, in.Close())
+	assert.Equal(t, "regular file", string(contents))
+
+	_, err = f.NewObject(linksCtx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	// A translated link can also be selected as the archive root.
+	single, err := New(linksCtx, localFs, name, "", "src/link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err := single.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+	object, err := single.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, entries[0].Remote(), object.Remote())
+
+	// Copying the translated object to a links-enabled local destination
+	// recreates the original symlink.
+	dstDir := t.TempDir()
+	dst, err := cache.Get(linksCtx, dstDir)
+	require.NoError(t, err)
+	_, err = operations.Copy(linksCtx, dst, nil, "src/link.txt"+fs.LinkSuffix, link)
+	require.NoError(t, err)
+	target, err := os.Readlink(filepath.Join(dstDir, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
