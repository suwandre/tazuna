+// TestArchiveSymlinkEscape checks that a translated archive symlink cannot
+// redirect a later archive member outside the destination.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	if err := os.Symlink("target", filepath.Join(t.TempDir(), "link")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	dstDir := t.TempDir()
+	evilDir := t.TempDir()
+	target, err := filepath.Rel(dstDir, evilDir)
+	require.NoError(t, err)
+	target = filepath.ToSlash(target)
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	linkHeader := &zip.FileHeader{Name: "pwn"}
+	linkHeader.SetMode(os.ModeSymlink | 0o777)
+	w, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(target))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(t.TempDir(), "evil.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	src, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	dst, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	// The write through the recreated link may fail, but it must not reach
+	// the directory outside the destination.
+	_ = sync.CopyDir(ctx, dst, src, false)
+	_, err = os.Stat(filepath.Join(evilDir, "authkeys"))
+	assert.Error(t, err)
+}
