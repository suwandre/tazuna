+// TestSymlinks checks that squashfs symbolic links use the translated-link
+// convention and are read from their stored targets rather than followed.
+func TestSymlinks(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+
+	source := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(source, "file.txt"), []byte("file"), 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(source, "regular"+fs.LinkSuffix), []byte("regular"), 0600))
+	if err := os.Symlink("file.txt", filepath.Join(source, "link.txt")); err != nil {
+		t.Skipf("can't create symbolic links: %v", err)
+	}
+
+	image := filepath.Join(t.TempDir(), "links.sqfs")
+	cmd := exec.Command(mksquashfs, source, image, "-noappend")
+	require.NoError(t, cmd.Run())
+
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, filepath.Dir(image))
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err := f.List(ctx, "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"regular" + fs.LinkSuffix, "file.txt"}, remotes)
+	_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	hidden, err := New(ctx, localFs, filepath.Base(image), "", "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	entries, err = hidden.List(ctx, "")
+	require.NoError(t, err)
+	assert.Empty(t, entries)
+	_, err = hidden.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	f, err = New(linksCtx, localFs, filepath.Base(image), "", "")
+	require.NoError(t, err)
+	entries, err = f.List(linksCtx, "")
+	require.NoError(t, err)
+	assert.Len(t, entries, 3)
+
+	link, err := f.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	rc, err := link.Open(linksCtx, &fs.RangeOption{Start: 2, End: 5})
+	require.NoError(t, err)
+	got, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "le.t", string(got))
+
+	regular, err := f.NewObject(linksCtx, "regular"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("regular")), regular.Size())
+	rc, err = regular.Open(linksCtx)
+	require.NoError(t, err)
+	got, err = io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "regular", string(got))
+
+	single, err := New(linksCtx, localFs, filepath.Base(image), "", "link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	entries, err = single.List(linksCtx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, entries[0].Remote())
+	_, err = single.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+}
