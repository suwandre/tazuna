+// TestSymlinkEntry checks that a symlink in an image is skipped without
+// -l/--links and exposed as a .rclonelink object with it, reading back
+// as its target and honouring seek and range options.
+func TestSymlinkEntry(t *testing.T) {
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+	assert.Equal(t, map[string]int64{
+		"file.txt":        5,
+		"note.rclonelink": 5,
+	}, symlinkObjectNames(t, ctx, f, ""))
+	assert.Equal(t, map[string]int64{
+		"sub/nested.txt": 6,
+	}, symlinkObjectNames(t, ctx, f, "sub"))
+
+	// Symlinks are not found without the flag
+	_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	f, err = New(ctx, localFs, "symlink.sqfs", "", "")
+	require.NoError(t, err)
+	assert.Equal(t, map[string]int64{
+		"file.txt":                 5,
+		"link.txt" + fs.LinkSuffix: 8,
+		"note.rclonelink":          5,
+	}, symlinkObjectNames(t, ctx, f, ""))
+	assert.Equal(t, map[string]int64{
+		"sub/link.txt" + fs.LinkSuffix: 10,
+		"sub/nested.txt":               6,
+	}, symlinkObjectNames(t, ctx, f, "sub"))
+
+	// Listing and NewObject agree on names
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(8), o.Size())
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	target, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file.txt", string(target))
+
+	// Opening honours seek and range options
+	rc, err = o.Open(ctx, &fs.SeekOption{Offset: 4})
+	require.NoError(t, err)
+	rest, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, ".txt", string(rest))
+	rc, err = o.Open(ctx, &fs.RangeOption{Start: 0, End: 3})
+	require.NoError(t, err)
+	head, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file", string(head))
+
+	// A regular file which happens to end in the suffix stays regular
+	o, err = f.NewObject(ctx, "note.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(5), o.Size())
+	rc, err = o.Open(ctx)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "plain", string(contents))
+}
