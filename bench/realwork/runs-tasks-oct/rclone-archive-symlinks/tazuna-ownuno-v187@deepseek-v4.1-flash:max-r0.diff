+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeSymlinkZip(t, dir, "links.zip", "file.txt", "link.txt", "file.txt")
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"file.txt"}, allRemotes(t, f))
+	_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	f, err = New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"file.txt", "link.txt" + fs.LinkSuffix}, allRemotes(t, f))
+
+	// Listing and NewObject agree on names
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	target, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file.txt", string(target))
+
+	// Opening honours seek and range options
+	rc, err = o.Open(ctx, &fs.SeekOption{Offset: 4})
+	require.NoError(t, err)
+	rest, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, ".txt", string(rest))
+	rc, err = o.Open(ctx, &fs.RangeOption{Start: 0, End: 3})
+	require.NoError(t, err)
+	head, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "file", string(head))
+}
+
+// TestZipLinkSuffixRegular checks a regular member whose name ends in
+// the link suffix stays a regular file even with -l/--links in use.
+func TestZipLinkSuffixRegular(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	dir := t.TempDir()
+	name := writeZip(t, dir, "note.zip", "note"+fs.LinkSuffix)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	o, err := f.NewObject(ctx, "note"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("data for note"+fs.LinkSuffix)), o.Size())
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "data for note"+fs.LinkSuffix, string(contents))
+}
