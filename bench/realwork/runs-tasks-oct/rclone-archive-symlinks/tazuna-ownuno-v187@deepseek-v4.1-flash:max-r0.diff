+// skipIfNoSymlinks skips the test if this process can't create symlinks.
+func skipIfNoSymlinks(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("Skipping as symlinks need privileges on Windows")
+	}
+	dir := t.TempDir()
+	if err := os.Symlink("target", filepath.Join(dir, "link")); err != nil {
+		t.Skipf("Skipping as symlinks are unavailable: %v", err)
+	}
+}
+
+// archiveObjectNames returns the sorted names of the objects in dir.
+func archiveObjectNames(t *testing.T, ctx context.Context, f fs.Fs, dir string) []string {
+	entries, err := f.List(ctx, dir)
+	require.NoError(t, err)
+	names := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		if _, ok := entry.(fs.Object); ok {
+			names = append(names, entry.Remote())
+		}
+	}
+	sort.Strings(names)
+	return names
+}
+
+// archiveRead reads remote from f with the options passed.
+func archiveRead(t *testing.T, ctx context.Context, f fs.Fs, remote string, options ...fs.OpenOption) string {
+	o, err := f.NewObject(ctx, remote)
+	require.NoError(t, err)
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	contents, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	if len(options) == 0 {
+		assert.Equal(t, o.Size(), int64(len(contents)))
+	}
+	return string(contents)
+}
+
+// checkArchiveSymlink checks that an archive exposes a symlink as a
+// .rclonelink object with -l/--links, and copies it back to a symlink.
+func checkArchiveSymlink(t *testing.T, ctx context.Context, archivePath string) {
+	plainCtx, plainConfig := fs.AddConfig(ctx)
+	plainConfig.Links = false
+	f, err := fs.NewFs(plainCtx, ":archive:"+archivePath)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"file.txt", "note" + fs.LinkSuffix}, archiveObjectNames(t, plainCtx, f, ""))
+	_, err = f.NewObject(plainCtx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, linksConfig := fs.AddConfig(ctx)
+	linksConfig.Links = true
+	f, err = fs.NewFs(linksCtx, ":archive:"+archivePath)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"file.txt", "link.txt" + fs.LinkSuffix, "note" + fs.LinkSuffix}, archiveObjectNames(t, linksCtx, f, ""))
+
+	// Listing and NewObject agree on names
+	_, err = f.NewObject(linksCtx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	assert.Equal(t, "file.txt", archiveRead(t, linksCtx, f, "link.txt"+fs.LinkSuffix))
+	// A regular member whose name ends in the suffix stays a regular file
+	assert.Equal(t, "plain", archiveRead(t, linksCtx, f, "note"+fs.LinkSuffix))
+	// Opening honours seek and range options
+	assert.Equal(t, ".txt", archiveRead(t, linksCtx, f, "link.txt"+fs.LinkSuffix, &fs.SeekOption{Offset: 4}))
+	assert.Equal(t, "file", archiveRead(t, linksCtx, f, "link.txt"+fs.LinkSuffix, &fs.RangeOption{Start: 0, End: 3}))
+
+	dst := filepath.Join(t.TempDir(), "out")
+	require.NoError(t, os.Mkdir(dst, 0777))
+	fdst, err := fs.NewFs(linksCtx, dst)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(linksCtx, fdst, f, false))
+
+	link := filepath.Join(dst, "link.txt")
+	fi, err := os.Lstat(link)
+	require.NoError(t, err)
+	assert.NotZero(t, fi.Mode()&os.ModeSymlink, "link.txt should be a symlink")
+	linkTarget, err := os.Readlink(link)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", linkTarget)
+}
+
+// TestArchiveZipSymlinkCopy checks that a symlink in a zip is skipped
+// without -l/--links and exposed as a .rclonelink object with it, which
+// copies back to a symlink on a destination that supports them.
+func TestArchiveZipSymlinkCopy(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoSymlinks(t)
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("file.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("hello"))
+	require.NoError(t, err)
+	hdr := &zip.FileHeader{Name: "link.txt"}
+	hdr.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(hdr)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("file.txt"))
+	require.NoError(t, err)
+	w, err = zw.Create("note" + fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("plain"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	zipPath := filepath.Join(t.TempDir(), "test.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	checkArchiveSymlink(t, context.Background(), zipPath)
+}
+
+// TestArchiveSquashfsSymlinkCopy checks that a symlink in a squashfs
+// image is skipped without -l/--links and exposed as a .rclonelink
+// object with it, which copies back to a symlink.
+//
+// Note that this uses mksquashfs as an external binary.
+func TestArchiveSquashfsSymlinkCopy(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoSymlinks(t)
+	skipIfNoExe(t, "mksquashfs")
+
+	dir := t.TempDir()
+	input := filepath.Join(dir, "input")
+	require.NoError(t, os.Mkdir(input, 0777))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("hello"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "link.txt")))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "note"+fs.LinkSuffix), []byte("plain"), 0600))
+	image := filepath.Join(dir, "test.sqfs")
+	run(t, "mksquashfs", input, image)
+
+	checkArchiveSymlink(t, context.Background(), image)
+}
+
+// TestArchiveZipSymlinkEscapeBlocked checks that a hostile archive can't
+// write outside the destination through a symlink pointing above the
+// root with a member inside it.
+func TestArchiveZipSymlinkEscapeBlocked(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoSymlinks(t)
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	hdr := &zip.FileHeader{Name: "a"}
+	hdr.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(hdr)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("../outside"))
+	require.NoError(t, err)
+	w, err = zw.Create("a/pwned.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("pwned"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+
+	dir := t.TempDir()
+	zipPath := filepath.Join(dir, "evil.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+	dst := filepath.Join(dir, "dst")
+	require.NoError(t, os.Mkdir(dst, 0777))
+
+	fsrc, err := fs.NewFs(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	fdst, err := fs.NewFs(ctx, dst)
+	require.NoError(t, err)
+
+	assert.Error(t, sync.CopyDir(ctx, fdst, fsrc, false))
+
+	_, err = os.Stat(filepath.Join(dir, "outside", "pwned.txt"))
+	assert.True(t, os.IsNotExist(err), "the archive wrote outside the destination")
+}
