+// writeZipWithSymlink builds a zip file containing a regular file, a
+// translated-link candidate and a regular file whose name has the link suffix.
+func writeZipWithSymlink(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	w, err := zw.Create("target.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("target contents"))
+	require.NoError(t, err)
+
+	h := &zip.FileHeader{Name: "link.txt"}
+	h.SetMode(os.ModeSymlink | 0777)
+	w, err = zw.CreateHeader(h)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("target.txt"))
+	require.NoError(t, err)
+
+	w, err = zw.Create("regular" + fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("regular file"))
+	require.NoError(t, err)
+
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// writeZipWithSymlinkChild builds a zip with an entry below a symbolic link.
+func writeZipWithSymlinkChild(t *testing.T, dir, name string) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	h := &zip.FileHeader{Name: "pwn"}
+	h.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(h)
+	require.NoError(t, err)
+	_, err = w.Write([]byte("../../outside"))
+	require.NoError(t, err)
+	w, err = zw.Create("pwn/authkeys")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("PWNED"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
