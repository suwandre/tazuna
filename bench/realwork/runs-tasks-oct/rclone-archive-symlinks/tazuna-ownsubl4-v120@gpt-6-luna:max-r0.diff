+func TestSymlinkInSquashfs(t *testing.T) {
+	mksquashfs, err := exec.LookPath("mksquashfs")
+	if err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+
+	source := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(source, "target.txt"), []byte("target"), 0600))
+	if err := os.Symlink("target.txt", filepath.Join(source, "link.txt")); err != nil {
+		t.Skipf("symbolic links are not supported: %v", err)
+	}
+	archiveDir := t.TempDir()
+	archivePath := filepath.Join(archiveDir, "links.sqfs")
+	cmd := exec.Command(mksquashfs, source, archivePath)
+	require.NoError(t, cmd.Run())
+
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, archiveDir)
+	require.NoError(t, err)
+	withoutLinks, err := New(ctx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := withoutLinks.List(ctx, "")
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	assert.Equal(t, "target.txt", entries[0].Remote())
+	_, err = withoutLinks.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	_, err = withoutLinks.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	linksCtx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	withLinks, err := New(linksCtx, localFs, "links.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(linksCtx, "")
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	assert.ElementsMatch(t, []string{"target.txt", "link.txt" + fs.LinkSuffix}, remotes)
+
+	_, err = withLinks.NewObject(linksCtx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	link, err := withLinks.NewObject(linksCtx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("target.txt")), link.Size())
+	rc, err := link.Open(linksCtx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "target.txt", string(data))
+}
