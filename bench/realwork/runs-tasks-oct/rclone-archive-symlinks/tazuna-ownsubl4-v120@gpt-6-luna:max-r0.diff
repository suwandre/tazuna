+// hasSymlinkParent reports whether remote is below a symbolic link path.
+func hasSymlinkParent(remote string, symlinkPaths map[string]struct{}) bool {
+	for parent := path.Dir(remote); parent != "." && parent != "" && parent != "/"; parent = path.Dir(parent) {
