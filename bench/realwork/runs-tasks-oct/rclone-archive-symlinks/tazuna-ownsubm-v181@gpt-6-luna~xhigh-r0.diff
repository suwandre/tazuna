+// A symlink in a zip must not let a member beneath it write outside the
+// destination when copying with --links.
+func TestZipSymlinkEscape(t *testing.T) {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	base := t.TempDir()
+	probe := filepath.Join(base, "symlink-probe")
+	if err := os.Symlink("target", probe); err != nil {
+		t.Skipf("symlinks are not supported: %v", err)
+	}
+	require.NoError(t, os.Remove(probe))
+	dir := filepath.Join(base, "archives")
+	require.NoError(t, os.Mkdir(dir, 0700))
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	linkHeader := &zip.FileHeader{Name: "link"}
+	linkHeader.SetMode(os.ModeSymlink | 0777)
+	linkWriter, err := zw.CreateHeader(linkHeader)
+	require.NoError(t, err)
+	_, err = linkWriter.Write([]byte("../outside"))
+	require.NoError(t, err)
+	member, err := zw.Create("link/escaped.txt")
+	require.NoError(t, err)
+	_, err = member.Write([]byte("must not escape"))
+	require.NoError(t, err)
+	require.NoError(t, zw.Close())
+	const archiveName = "evil.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, archiveName), buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	src, err := New(ctx, localFs, archiveName, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"link.rclonelink"}, allRemotes(t, src))
+	_, err = src.NewObject(ctx, "link/escaped.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	dstRoot := filepath.Join(base, "out")
+	dst, err := cache.Get(ctx, dstRoot)
+	require.NoError(t, err)
+	require.NoError(t, rclonesync.CopyDir(ctx, dst, src, false))
+	linkPath := filepath.Join(dstRoot, "link")
+	fi, err := os.Lstat(linkPath)
+	require.NoError(t, err)
+	assert.True(t, fi.Mode()&os.ModeSymlink != 0)
+	gotTarget, err := os.Readlink(linkPath)
+	require.NoError(t, err)
+	assert.Equal(t, "../outside", gotTarget)
+	_, err = os.Stat(filepath.Join(base, "outside"))
+	assert.True(t, os.IsNotExist(err), "member escaped the destination")
+}
