+// zipRemote returns the safe remote path and whether the member is a directory.
+func zipRemote(file *zip.File) (remote string, isDir bool, err error) {
+	remote, err = sanitize.Path(file.Name)
+	if err != nil {
+		return "", false, err
+	}
+	isDir = strings.HasSuffix(file.Name, "/")
+	if !isDir && sanitize.Leaf(path.Base(file.Name)) != nil {
+		return "", false, errors.New("invalid zip member name")
+	}
+	return remote, isDir, nil
+}
+
+// hasSymlinkParent reports whether remote is beneath a symlink in the archive.
+func hasSymlinkParent(remote string, symlinks map[string]struct{}) bool {
+	for parent := path.Dir(remote); parent != "." && parent != "/"; parent = path.Dir(parent) {
+		if _, ok := symlinks[parent]; ok {
+			return true
+		}
+	}
+	return false
+}
