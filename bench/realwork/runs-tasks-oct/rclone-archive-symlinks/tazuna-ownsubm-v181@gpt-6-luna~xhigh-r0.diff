+func TestZipSymlinks(t *testing.T) {
+	ctx := context.Background()
+	ctxLinks, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	dir := t.TempDir()
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name, data string
+		mode       os.FileMode
+	}{
+		{name: "src/file.txt", data: "contents", mode: 0644},
+		{name: "src/link.txt", data: "file.txt", mode: os.ModeSymlink | 0777},
+		{name: "src/already", data: "file.txt", mode: os.ModeSymlink | 0777},
+		{name: "src/already.rclonelink", data: "regular", mode: 0644},
+	} {
+		header := &zip.FileHeader{Name: entry.name}
+		header.SetMode(entry.mode)
+		w, err := zw.CreateHeader(header)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.data))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	name := "links.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	plain, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"src/already.rclonelink", "src/file.txt"}, allRemotes(t, plain))
+	_, err = plain.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	withLinks, err := New(ctxLinks, localFs, name, "", "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"src/already.rclonelink", "src/file.txt", "src/link.txt.rclonelink"}, allRemotes(t, withLinks))
+
+	link, err := withLinks.NewObject(ctxLinks, "src/link.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	assert.Equal(t, "file.txt", readObject(t, ctxLinks, link))
+	assert.Equal(t, "le.t", readObject(t, ctxLinks, link, &fs.RangeOption{Start: 2, End: 5}))
+	assert.Equal(t, "le.txt", readObject(t, ctxLinks, link, &fs.SeekOption{Offset: 2}))
+	_, err = withLinks.NewObject(ctxLinks, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	regular, err := withLinks.NewObject(ctxLinks, "src/already.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "regular", readObject(t, ctxLinks, regular))
+}
+
+func readObject(t *testing.T, ctx context.Context, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	defer func() { assert.NoError(t, rc.Close()) }()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(data)
+}
