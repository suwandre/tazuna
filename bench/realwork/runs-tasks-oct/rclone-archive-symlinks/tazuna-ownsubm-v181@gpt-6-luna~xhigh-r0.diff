+func TestSquashfsSymlinks(t *testing.T) {
+	ctx := context.Background()
+	ctxLinks, ci := fs.AddConfig(ctx)
+	ci.Links = true
+	localFs, err := fscache.Get(ctx, "testdata")
+	require.NoError(t, err)
+
+	plain, err := New(ctx, localFs, "symlinks.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err := plain.List(ctx, "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"already.rclonelink", "file.txt"}, squashfsRemotes(entries))
+	_, err = plain.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	withLinks, err := New(ctxLinks, localFs, "symlinks.sqfs", "", "")
+	require.NoError(t, err)
+	entries, err = withLinks.List(ctxLinks, "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"already.rclonelink", "file.txt", "link.txt" + fs.LinkSuffix}, squashfsRemotes(entries))
+
+	link, err := withLinks.NewObject(ctxLinks, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("file.txt")), link.Size())
+	assert.Equal(t, "file.txt", readSquashfsObject(t, ctxLinks, link))
+	assert.Equal(t, "le.t", readSquashfsObject(t, ctxLinks, link, &fs.RangeOption{Start: 2, End: 5}))
+	assert.Equal(t, "le.txt", readSquashfsObject(t, ctxLinks, link, &fs.SeekOption{Offset: 2}))
+	_, err = withLinks.NewObject(ctxLinks, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	regular, err := withLinks.NewObject(ctxLinks, "already.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, "regular", readSquashfsObject(t, ctxLinks, regular))
+}
+
+func squashfsRemotes(entries fs.DirEntries) []string {
+	remotes := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	sort.Strings(remotes)
+	return remotes
+}
+
+func readSquashfsObject(t *testing.T, ctx context.Context, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	defer func() { assert.NoError(t, rc.Close()) }()
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	return string(data)
+}
