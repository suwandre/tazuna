+
+// writeLinkZip builds a zip with a regular file, a symlink to it, a
+// regular file whose name ends in the link suffix and a member "inside"
+// a symlink which points above the root.
+func writeLinkZip(t *testing.T, dir, name string) {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	add := func(n, content string, mode os.FileMode) {
+		h := &zip.FileHeader{Name: n, Method: zip.Store}
+		h.SetMode(mode)
+		w, err := zw.CreateHeader(h)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(content))
+		require.NoError(t, err)
+	}
+	add("src/file.txt", "hello", 0644)
+	add("src/link.txt", "file.txt", os.ModeSymlink|0777)
+	add("src/real.rclonelink", "plain", 0644)
+	add("evil", "../..", os.ModeSymlink|0777)
+	add("evil/pwned", "pwned", 0644)
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+}
+
+func TestSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	writeLinkZip(t, dir, "l.zip")
+	localFs, err := cache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	t.Run("Skipped", func(t *testing.T) {
+		f, err := New(context.Background(), localFs, "l.zip", "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"src/file.txt", "src/real.rclonelink"}, allRemotes(t, f))
+		_, err = f.NewObject(context.Background(), "src/link.txt.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(context.Background())
+		ci.Links = true
+		f, err := New(ctx, localFs, "l.zip", "", "")
+		require.NoError(t, err)
+		// evil/pwned is skipped as it is inside the evil symlink
+		assert.Equal(t, []string{"evil.rclonelink", "src/file.txt", "src/link.txt.rclonelink", "src/real.rclonelink"}, allRemotes(t, f))
+
+		o, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(8), o.Size())
+		rc, err := o.Open(ctx)
+		require.NoError(t, err)
+		b, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "file.txt", string(b))
+
+		rc, err = o.Open(ctx, &fs.RangeOption{Start: 2, End: 4})
+		require.NoError(t, err)
+		b, err = io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "le.", string(b))
+
+		rc, err = o.Open(ctx, &fs.SeekOption{Offset: 5})
+		require.NoError(t, err)
+		b, err = io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "txt", string(b))
+
+		// A regular file with the suffix stays regular
