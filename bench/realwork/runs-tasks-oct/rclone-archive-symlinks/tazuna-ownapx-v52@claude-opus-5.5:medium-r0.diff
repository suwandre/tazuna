+// makeLinkImage builds a squashfs image with a file, a symlink to it, a
+// regular file named with the link suffix and a symlink above the root.
+func makeLinkImage(t *testing.T) string {
+	if _, err := exec.LookPath("mksquashfs"); err != nil {
+		t.Skip("mksquashfs not found")
+	}
+	dir := t.TempDir()
+	in := filepath.Join(dir, "in")
+	require.NoError(t, os.MkdirAll(filepath.Join(in, "src"), 0755))
+	require.NoError(t, os.WriteFile(filepath.Join(in, "src", "file.txt"), []byte("hello"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(in, "src", "real.rclonelink"), []byte("plain"), 0644))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(in, "src", "link.txt")))
+	require.NoError(t, os.Symlink("../..", filepath.Join(in, "evil")))
+	out, err := exec.Command("mksquashfs", in, filepath.Join(dir, "l.sqfs"), "-quiet", "-no-progress").CombinedOutput()
+	require.NoError(t, err, string(out))
+	return dir
+}
+
+func TestSymlinks(t *testing.T) {
+	dir := makeLinkImage(t)
+	localFs, err := fscache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	names := func(t *testing.T, f fs.Fs) (out []string) {
+		entries, err := f.List(context.Background(), "src")
+		require.NoError(t, err)
+		for _, e := range entries {
+			out = append(out, e.Remote())
+		}
+		sort.Strings(out)
+		return out
+	}
+
+	t.Run("Skipped", func(t *testing.T) {
+		f, err := New(context.Background(), localFs, "l.sqfs", "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"src/file.txt", "src/real.rclonelink"}, names(t, f))
+		_, err = f.NewObject(context.Background(), "src/link.txt.rclonelink")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(context.Background(), "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx, ci := fs.AddConfig(context.Background())
+		ci.Links = true
+		f, err := New(ctx, localFs, "l.sqfs", "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"src/file.txt", "src/link.txt.rclonelink", "src/real.rclonelink"}, names(t, f))
+
+		o, err := f.NewObject(ctx, "src/link.txt.rclonelink")
+		require.NoError(t, err)
+		assert.Equal(t, int64(8), o.Size())
+		read := func(opts ...fs.OpenOption) string {
+			rc, err := o.Open(ctx, opts...)
+			require.NoError(t, err)
+			b, err := io.ReadAll(rc)
+			require.NoError(t, err)
+			require.NoError(t, rc.Close())
+			return string(b)
+		}
+		assert.Equal(t, "file.txt", read())
+		assert.Equal(t, "le.", read(&fs.RangeOption{Start: 2, End: 4}))
+		assert.Equal(t, "txt", read(&fs.SeekOption{Offset: 5}))
+
+		// A regular file with the suffix stays regular
+		o, err = f.NewObject(ctx, "src/real.rclonelink")
+		require.NoError(t, err)
+		assert.False(t, o.(*Object).isLink)
+		assert.Equal(t, int64(5), o.Size())
+
+		// Listing and lookup agree on the unsuffixed name
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+}
