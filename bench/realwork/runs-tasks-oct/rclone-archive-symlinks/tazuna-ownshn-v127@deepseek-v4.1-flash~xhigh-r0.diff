+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	assert.Equal(t, []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix, "src/real.txt.rclonelink"}, listRemotes(t, f, "src"))
+
+	// A regular file whose name ends in the link suffix is not a symlink
+	o, err := f.NewObject(ctx, "src/real.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("not a link")), o.Size())
+	rc, err := o.Open(ctx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	assert.Equal(t, "not a link", string(data))
+
+	// The symlink is only found with the link suffix
+	_, err = f.NewObject(ctx, "src/link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	o, err = f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, "src/link.txt"+fs.LinkSuffix, o.Remote())
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	assert.Equal(t, "file.txt", readAll(t, o))
+	assert.Equal(t, "le.txt", readAll(t, o, &fs.SeekOption{Offset: 2}))
+	assert.Equal(t, "ile", readAll(t, o, &fs.RangeOption{Start: 1, End: 3}))
+}
+
+func readAll(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
+
+// A root naming a symlink with the link suffix exposes just that
+// symlink.
+func TestSymlinkRoot(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipSymlinks(t, dir)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	f, err := New(ctx, localFs, name, "", "src/link.txt"+fs.LinkSuffix)
+	require.ErrorIs(t, err, fs.ErrorIsFile)
+	assert.Equal(t, []string{"link.txt" + fs.LinkSuffix}, listRemotes(t, f, ""))
+	o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", readAll(t, o))
+}
+
+// A hostile archive with a symlink pointing outside the destination
+// and a member inside it must not be able to write outside the
+// destination when copied with --links.
+func TestSymlinkEscape(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	outside := t.TempDir()
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+
+	hdr := &zip.FileHeader{Name: "escape", Method: zip.Deflate}
+	hdr.SetMode(os.ModeSymlink | 0777)
+	w, err := zw.CreateHeader(hdr)
+	require.NoError(t, err)
+	_, err = w.Write([]byte(outside))
+	require.NoError(t, err)
+
+	w, err = zw.Create("escape/pwn.txt")
+	require.NoError(t, err)
+	_, err = w.Write([]byte("pwned"))
+	require.NoError(t, err)
+
+	require.NoError(t, zw.Close())
+	name := "escape.zip"
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	src, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dst, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	// The copy may fail when it tries to write through the symlink,
+	// but it must never create a file outside the destination.
+	_ = fssync.CopyDir(ctx, dst, src, false)
+
+	_, err = os.Stat(filepath.Join(outside, "pwn.txt"))
+	assert.True(t, os.IsNotExist(err), "copy escaped the destination")
+}
+
+// Copying a symlink with --links recreates it on a destination which
+// supports symlinks.
+func TestSymlinkCopy(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	name := writeZipSymlinks(t, dir)
+
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	src, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	dstDir := t.TempDir()
+	dst, err := cache.Get(ctx, dstDir)
+	require.NoError(t, err)
+
+	require.NoError(t, fssync.CopyDir(ctx, dst, src, false))
+
+	target, err := os.Readlink(filepath.Join(dstDir, "src", "link.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "file.txt", target)
+	data, err := os.ReadFile(filepath.Join(dstDir, "src", "file.txt"))
+	require.NoError(t, err)
+	assert.Equal(t, "hello", string(data))
+}
