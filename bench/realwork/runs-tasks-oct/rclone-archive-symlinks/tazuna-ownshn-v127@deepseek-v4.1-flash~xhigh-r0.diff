+// writeSquashfs builds a squashfs image with a regular file, a
+// symlink and a regular file whose name ends in the link suffix.
+func writeSquashfs(t *testing.T) string {
+	if _, err := exec.LookPath("mksquashfs"); err != nil {
+		t.Skip("mksquashfs executable not installed")
+	}
+	input := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(input, "file.txt"), []byte("hello"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "link.txt")))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "real.txt.rclonelink"), []byte("not a link"), 0600))
+	output := filepath.Join(t.TempDir(), "links.sqfs")
+	cmd := exec.Command("mksquashfs", input, output, "-noappend")
+	out, err := cmd.CombinedOutput()
+	require.NoError(t, err, string(out))
+	return output
+}
+
+func listRemotes(t *testing.T, f fs.Fs, dir string) []string {
+	entries, err := f.List(context.Background(), dir)
+	require.NoError(t, err)
+	remotes := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	sort.Strings(remotes)
+	return remotes
+}
+
+func readAll(t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(context.Background(), options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
+
+// Symlinks are only exposed with -l/--links, when they appear as a
+// regular file with the link suffix whose contents are the target.
+func TestSymlink(t *testing.T) {
+	image := writeSquashfs(t)
+	ctx := context.Background()
+	localFs, err := fscache.Get(ctx, filepath.Dir(image))
+	require.NoError(t, err)
+	name := filepath.Base(image)
+
+	t.Run("NoLinks", func(t *testing.T) {
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+		assert.Equal(t, []string{"file.txt", "real.txt.rclonelink"}, listRemotes(t, f, ""))
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = true
+
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+
+	assert.Equal(t, []string{"file.txt", "link.txt" + fs.LinkSuffix, "real.txt.rclonelink"}, listRemotes(t, f, ""))
+
+	// A regular file whose name ends in the link suffix is not a symlink
+	o, err := f.NewObject(ctx, "real.txt.rclonelink")
+	require.NoError(t, err)
+	assert.Equal(t, int64(len("not a link")), o.Size())
+	assert.Equal(t, "not a link", readAll(t, o))
+
+	// The symlink is only found with the link suffix
+	_, err = f.NewObject(ctx, "link.txt")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	o, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+	require.NoError(t, err)
+	assert.Equal(t, "link.txt"+fs.LinkSuffix, o.Remote())
+	assert.Equal(t, int64(len("file.txt")), o.Size())
+	assert.Equal(t, "file.txt", readAll(t, o))
+	assert.Equal(t, "le.txt", readAll(t, o, &fs.SeekOption{Offset: 2}))
+	assert.Equal(t, "ile", readAll(t, o, &fs.RangeOption{Start: 1, End: 3}))
+}
+
+// A root naming a symlink with the link suffix exposes just that
