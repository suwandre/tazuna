+// writeSymlinkZip builds a zip in dir holding the entries given, where a
+// non-empty target makes an entry a symlink.
+func writeSymlinkZip(t *testing.T, dir, name string, entries []zipTestEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		if entry.target != "" {
+			fh := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+			fh.SetMode(os.ModeSymlink | 0777)
+			w, err := zw.CreateHeader(fh)
+			require.NoError(t, err)
+			_, err = w.Write([]byte(entry.target))
+			require.NoError(t, err)
+			continue
+		}
+		w, err := zw.Create(entry.name)
+		require.NoError(t, err)
+		if !strings.HasSuffix(entry.name, "/") {
+			_, err = w.Write([]byte(entry.content))
+			require.NoError(t, err)
+		}
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// zipTestEntry describes an entry for writeSymlinkZip.
+type zipTestEntry struct {
+	name, content, target string
+}
+
+// linksContext returns a context with -l/--links enabled.
+func linksContext() context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	return ctx
+}
+
+// listRemotes returns the remotes listed in dir, sorted.
+func listRemotes(t *testing.T, f fs.Fs, dir string) []string {
+	entries, err := f.List(context.Background(), dir)
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	sort.Strings(remotes)
+	return remotes
+}
+
+// newArchiveFs makes an archive Fs for remote. It is created directly
+// rather than from the Fs cache so tests can use different configs.
+func newArchiveFs(ctx context.Context, t *testing.T, remote string) fs.Fs {
+	f, err := NewFs(ctx, "archive", remote, configmap.Simple{})
+	if err != fs.ErrorIsFile {
+		require.NoError(t, err)
+	}
+	return f
+}
