+// writeSymlinkZip builds a zip in dir holding the entries given, where a
+// non-empty target makes an entry a symbolic link.
+func writeSymlinkZip(t *testing.T, dir, name string, entries []zipTestEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range entries {
+		if entry.target != "" {
+			fh := &zip.FileHeader{Name: entry.name, Method: zip.Deflate}
+			fh.SetMode(os.ModeSymlink | 0777)
+			w, err := zw.CreateHeader(fh)
+			require.NoError(t, err)
+			_, err = w.Write([]byte(entry.target))
+			require.NoError(t, err)
+			continue
+		}
+		w, err := zw.Create(entry.name)
+		require.NoError(t, err)
+		if !strings.HasSuffix(entry.name, "/") {
+			_, err = w.Write([]byte(entry.content))
+			require.NoError(t, err)
+		}
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// zipTestEntry describes an entry for writeSymlinkZip. A non-empty target
+// makes the entry a symlink.
+type zipTestEntry struct {
+	name, content, target string
+}
+
+// linksContext returns a context with -l/--links enabled.
+func linksContext() context.Context {
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+	return ctx
+}
+
+// newZipFs opens the zip called name in dir.
+func newZipFs(ctx context.Context, t *testing.T, dir, name string) *Fs {
+	localFs, err := cache.Get(ctx, dir)
+	require.NoError(t, err)
+	f, err := New(ctx, localFs, name, "", "")
+	require.NoError(t, err)
+	zf, ok := f.(*Fs)
+	require.True(t, ok)
+	return zf
+}
+
+// listRemotes returns the remotes listed in dir, sorted.
+func listRemotes(t *testing.T, f fs.Fs, dir string) []string {
+	entries, err := f.List(context.Background(), dir)
+	require.NoError(t, err)
+	var remotes []string
+	for _, entry := range entries {
+		remotes = append(remotes, entry.Remote())
+	}
+	sort.Strings(remotes)
+	return remotes
+}
+
+// Without -l/--links symlinks are skipped, and with it they are exposed
+// as objects named with the fs.LinkSuffix whose contents are the target.
+func TestSymlinksRequireLinks(t *testing.T) {
+	dir := t.TempDir()
+	name := writeSymlinkZip(t, dir, "test.zip", []zipTestEntry{
+		{name: "file.txt", content: "hello"},
+		{name: "link.txt", target: "file.txt"},
+	})
+
+	t.Run("NoLinks", func(t *testing.T) {
+		f := newZipFs(context.Background(), t, dir, name)
+		assert.Equal(t, []string{"file.txt"}, listRemotes(t, f, ""))
+		_, err := f.NewObject(context.Background(), "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+		_, err = f.NewObject(context.Background(), "link.txt"+fs.LinkSuffix)
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx := linksContext()
+		f := newZipFs(ctx, t, dir, name)
+		want := []string{"file.txt", "link.txt" + fs.LinkSuffix}
+		assert.Equal(t, want, listRemotes(t, f, ""))
+
+		// NewObject must agree with the listing
+		o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "link.txt"+fs.LinkSuffix, o.Remote())
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// Opening reads back the target, honouring range and seek options
+		rc, err := o.Open(ctx)
+		require.NoError(t, err)
+		contents, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "file.txt", string(contents))
+
+		rc, err = o.Open(ctx, &fs.SeekOption{Offset: 5})
+		require.NoError(t, err)
+		contents, err = io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "txt", string(contents))
+
+		for _, test := range []struct {
+			ro   fs.RangeOption
+			want string
+		}{
+			{fs.RangeOption{Start: 0, End: 3}, "file"},
+			{fs.RangeOption{Start: 5, End: -1}, "txt"},
+			{fs.RangeOption{Start: 6, End: 1000}, "xt"},
+			{fs.RangeOption{Start: -1, End: 3}, "txt"},
+			{fs.RangeOption{Start: 100, End: -1}, ""},
+		} {
+			rc, err := o.Open(ctx, &test.ro)
+			require.NoError(t, err)
+			contents, err := io.ReadAll(rc)
+			require.NoError(t, err)
+			require.NoError(t, rc.Close())
+			assert.Equal(t, test.want, string(contents), test.ro.String())
+		}
+	})
