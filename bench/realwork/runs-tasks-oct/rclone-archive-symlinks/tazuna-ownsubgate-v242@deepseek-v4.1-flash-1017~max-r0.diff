+// TestArchiveZipSymlinks checks symlinks in a zip are skipped without
+// -l/--links and exposed as .rclonelink files with it.
+func TestArchiveZipSymlinks(t *testing.T) {
+	fstest.Initialise()
+	dir := t.TempDir()
+	zipPath := filepath.Join(dir, writeSymlinkZip(t, dir, "test.zip", []zipTestEntry{
+		{name: "src/file.txt", content: "hello"},
+		{name: "src/link.txt", target: "file.txt"},
+	}))
+
+	t.Run("NoLinks", func(t *testing.T) {
+		f := newArchiveFs(context.Background(), t, zipPath)
+		assert.Equal(t, []string{"src/file.txt"}, listRemotes(t, f, "src"))
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx := linksContext()
+		f := newArchiveFs(ctx, t, zipPath)
+		assert.Equal(t, []string{"src/file.txt", "src/link.txt" + fs.LinkSuffix}, listRemotes(t, f, "src"))
+
+		o, err := f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		_, err = f.NewObject(ctx, "src/link.txt")
+		assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+		// Opening reads back the target, honouring range options
+		for _, test := range []struct {
+			option fs.OpenOption
+			want   string
+		}{
+			{nil, "file.txt"},
+			{&fs.SeekOption{Offset: 5}, "txt"},
+			{&fs.RangeOption{Start: 1, End: 3}, "ile"},
+			{&fs.RangeOption{Start: -1, End: 3}, "txt"},
+		} {
+			var options []fs.OpenOption
+			if test.option != nil {
+				options = append(options, test.option)
+			}
+			rc, err := o.Open(ctx, options...)
+			require.NoError(t, err)
+			contents, err := io.ReadAll(rc)
+			require.NoError(t, err)
+			require.NoError(t, rc.Close())
+			assert.Equal(t, test.want, string(contents), "%v", test.option)
+		}
+
+		// Copying to a destination which supports symlinks recreates it
+		outDir := t.TempDir()
+		Fdst, err := cache.Get(ctx, outDir)
+		require.NoError(t, err)
+		require.NoError(t, sync.CopyDir(ctx, Fdst, f, false))
+		fi, err := os.Lstat(filepath.Join(outDir, "src", "link.txt"))
+		require.NoError(t, err)
+		require.NotZero(t, fi.Mode()&os.ModeSymlink, "link.txt should be a symlink")
+		linkTarget, err := os.Readlink(filepath.Join(outDir, "src", "link.txt"))
+		require.NoError(t, err)
+		assert.Equal(t, "file.txt", linkTarget)
+	})
+
+	// A root naming the symlink exposes just the symlink, but must use
+	// fs.LinkSuffix like the local backend does
+	t.Run("Single", func(t *testing.T) {
+		ctx := linksContext()
+		_, err := NewFs(ctx, "archive", zipPath+"/src/link.txt", configmap.Simple{})
+		assert.ErrorIs(t, err, archiver.ErrLinkNeedsSuffix)
+
+		f := newArchiveFs(ctx, t, zipPath+"/src/link.txt"+fs.LinkSuffix)
+		assert.Equal(t, []string{"link.txt" + fs.LinkSuffix}, listRemotes(t, f, ""))
+		o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		rc, err := o.Open(ctx)
+		require.NoError(t, err)
+		contents, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "file.txt", string(contents))
+	})
+}
