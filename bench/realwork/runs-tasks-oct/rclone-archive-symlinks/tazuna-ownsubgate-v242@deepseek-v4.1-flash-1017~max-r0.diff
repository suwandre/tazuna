+// TestArchiveSymlinkEscape checks a hostile archive - a symlink pointing
+// outside the destination plus a member inside it - can't make a copy
+// write outside the destination.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	fstest.Initialise()
+	ctx := linksContext()
+
+	outside := t.TempDir()
+	dir := t.TempDir()
+	zipPath := filepath.Join(dir, writeSymlinkZip(t, dir, "evil.zip", []zipTestEntry{
+		{name: "pwn", target: outside},
+		{name: "pwn/authkeys", content: "PWNED"},
+		{name: "ok.txt", content: "hello"},
+	}))
+
+	f := newArchiveFs(ctx, t, zipPath)
+	assert.Equal(t, []string{"ok.txt", "pwn" + fs.LinkSuffix}, listRemotes(t, f, ""))
+	_, err := f.NewObject(ctx, "pwn/authkeys")
+	assert.ErrorIs(t, err, fs.ErrorObjectNotFound)
+
+	outDir := t.TempDir()
+	Fdst, err := cache.Get(ctx, outDir)
+	require.NoError(t, err)
+	require.NoError(t, sync.CopyDir(ctx, Fdst, f, false))
+
+	// The symlink is reproduced but nothing is written through it
+	_, err = os.Lstat(filepath.Join(outDir, "pwn"))
+	require.NoError(t, err)
+	_, err = os.Stat(filepath.Join(outside, "authkeys"))
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", outside)
+}
+
+// TestArchiveSquashfsSymlinks checks symlinks in a squashfs image are
+// skipped without -l/--links and exposed as .rclonelink files with it.
+func TestArchiveSquashfsSymlinks(t *testing.T) {
+	fstest.Initialise()
+	skipIfNoExe(t, "mksquashfs")
+
+	input := t.TempDir()
+	require.NoError(t, os.Mkdir(filepath.Join(input, "src"), 0777))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "src", "file.txt"), []byte("hello"), 0600))
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "src", "link.txt")))
+	// A regular entry whose name ends in fs.LinkSuffix stays a regular
+	// file, even when a symlink translates to the same name
+	require.NoError(t, os.Symlink("file.txt", filepath.Join(input, "src", "clash.txt")))
+	require.NoError(t, os.WriteFile(filepath.Join(input, "src", "clash.txt"+fs.LinkSuffix), []byte("regular"), 0600))
+	output := filepath.Join(t.TempDir(), "test.sqfs")
+	run(t, "mksquashfs", input, output, "-noappend", "-quiet")
+
+	t.Run("NoLinks", func(t *testing.T) {
+		f := newArchiveFs(context.Background(), t, output)
+		assert.Equal(t, []string{"src/clash.txt" + fs.LinkSuffix, "src/file.txt"}, listRemotes(t, f, "src"))
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx := linksContext()
+		f := newArchiveFs(ctx, t, output)
+		assert.Equal(t, []string{"src/clash.txt" + fs.LinkSuffix, "src/file.txt", "src/link.txt" + fs.LinkSuffix}, listRemotes(t, f, "src"))
+
+		o, err := f.NewObject(ctx, "src/link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		rc, err := o.Open(ctx, &fs.RangeOption{Start: 1, End: 3})
+		require.NoError(t, err)
+		contents, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "ile", string(contents))
+
+		// The regular entry which clashes with the symlink is what is
+		// listed and looked up
+		o, err = f.NewObject(ctx, "src/clash.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		rc, err = o.Open(ctx)
+		require.NoError(t, err)
+		contents, err = io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "regular", string(contents))
+
+		// Copying to a destination which supports symlinks recreates it
+		outDir := t.TempDir()
+		Fdst, err := cache.Get(ctx, outDir)
+		require.NoError(t, err)
+		require.NoError(t, sync.CopyDir(ctx, Fdst, f, false))
+		fi, err := os.Lstat(filepath.Join(outDir, "src", "link.txt"))
+		require.NoError(t, err)
+		require.NotZero(t, fi.Mode()&os.ModeSymlink, "link.txt should be a symlink")
+	})
+
+	// A root naming the symlink exposes just the symlink, but must use
+	// fs.LinkSuffix like the local backend does
+	t.Run("Single", func(t *testing.T) {
+		ctx := linksContext()
+		_, err := NewFs(ctx, "archive", output+"/src/link.txt", configmap.Simple{})
+		assert.ErrorIs(t, err, archiver.ErrLinkNeedsSuffix)
+
+		f := newArchiveFs(ctx, t, output+"/src/link.txt"+fs.LinkSuffix)
+		assert.Equal(t, []string{"link.txt" + fs.LinkSuffix}, listRemotes(t, f, ""))
+		o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		rc, err := o.Open(ctx)
+		require.NoError(t, err)
+		contents, err := io.ReadAll(rc)
+		require.NoError(t, err)
+		require.NoError(t, rc.Close())
+		assert.Equal(t, "file.txt", string(contents))
+	})
+}
