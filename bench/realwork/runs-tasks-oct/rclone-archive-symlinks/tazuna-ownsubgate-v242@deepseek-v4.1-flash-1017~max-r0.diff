+++ b/backend/archive/archiver/links_test.go
@@ -0,0 +1,34 @@
+package archiver
+
+import (
+	"io"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestOpenLink(t *testing.T) {
+	const target = "file.txt"
+	for _, test := range []struct {
+		name          string
+		offset, limit int64
+		want          string
+	}{
+		{"All", 0, -1, target},
+		{"Seek", 5, -1, "txt"},
+		{"Range", 1, 3, "ile"},
+		{"RangePastEnd", 6, 100, "xt"},
+		{"NegativeOffset", -10, -1, target},
+		{"OffsetPastEnd", 100, -1, ""},
+		{"ZeroLimit", 0, 0, ""},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			rc := OpenLink(target, test.offset, test.limit)
+			got, err := io.ReadAll(rc)
+			require.NoError(t, err)
+			require.NoError(t, rc.Close())
+			assert.Equal(t, test.want, string(got))
+		})
+	}
+}
