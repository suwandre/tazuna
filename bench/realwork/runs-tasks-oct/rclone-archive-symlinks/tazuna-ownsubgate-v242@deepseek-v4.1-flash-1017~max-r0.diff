--- /dev/null
+++ b/backend/archive/archiver/links.go
@@ -0,0 +1,36 @@
+package archiver
+
+import (
+	"errors"
+	"io"
+	"strings"
+
+	"github.com/rclone/rclone/fs"
+)
+
+// MaxLinkTargetSize is the largest symlink target read from an archive.
+//
+// This is comfortably above any OS path limit (Windows allows 32767
+// UTF-16 units).
+const MaxLinkTargetSize = 128 * 1024
+
+// ErrLinkTargetTooLong is returned when a symlink target is larger than
+// MaxLinkTargetSize.
+var ErrLinkTargetTooLong = errors.New("symlink target is too long to be a path")
+
+// ErrLinkNeedsSuffix is returned when a symlink is named without
+// fs.LinkSuffix, as symlinks are only exposed under their translated
+// name.
+var ErrLinkNeedsSuffix = errors.New("need \"" + fs.LinkSuffix + "\" suffix to refer to symlink when using -l/--links")
+
+// OpenLink returns a reader over a symlink target, restricted to the
+// offset and limit passed in. The length of the target is its size.
+func OpenLink(target string, offset, limit int64) io.ReadCloser {
+	size := int64(len(target))
+	offset = min(max(offset, 0), size)
+	end := size
+	if limit >= 0 {
+		end = min(offset+limit, size)
+	}
+	return io.NopCloser(strings.NewReader(target[offset:end]))
+}
