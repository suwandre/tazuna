+// maxLinkTargetSize is the largest symlink target read from an archive,
+// comfortably above any OS path limit (Windows allows 32767 UTF-16 units).
+const maxLinkTargetSize = 128 * 1024
+
+// readLinkTarget returns the target of a symlink entry, which is stored
+// as the entry's contents.
+func readLinkTarget(file *zip.File) (target string, err error) {
+	rc, err := file.Open()
+	if err != nil {
+		return "", err
+	}
+	defer fs.CheckClose(rc, &err)
+	buf, err := io.ReadAll(io.LimitReader(rc, maxLinkTargetSize+1))
+	if err != nil {
+		return "", err
+	}
+	if len(buf) > maxLinkTargetSize {
+		return "", errors.New("symlink target is too long")
+	}
+	return string(buf), nil
+}
+
+// dropShadowedLinks removes translated links from dt when a regular
+// entry with the same name exists, so a regular member whose name ends
+// in .rclonelink isn't hidden by a symlink of the same name.
+func dropShadowedLinks(dt dirtree.DirTree) {
+	for dir, entries := range dt {
+		regular := make(map[string]struct{}, len(entries))
+		for _, entry := range entries {
+			if o, ok := entry.(*Object); ok && !o.translatedLink {
+				regular[o.Remote()] = struct{}{}
+			}
+		}
+		if len(regular) == 0 {
+			continue
+		}
+		kept := entries[:0]
+		for _, entry := range entries {
+			if o, ok := entry.(*Object); ok && o.translatedLink {
+				if _, found := regular[o.Remote()]; found {
+					continue
+				}
+			}
+			kept = append(kept, entry)
+		}
+		dt[dir] = kept
+	}
+}
