+// LinkTargetMaxSize is the largest symlink target accepted from an
+// archive, comfortably above any OS path limit (Windows allows 32767
+// UTF-16 units).
+const LinkTargetMaxSize = 128 * 1024
+
+// ReadLinkTarget returns the symlink target as a reader, honouring the
+// offset and limit passed in. A negative limit means no limit.
+func ReadLinkTarget(target string, offset, limit int64) io.ReadCloser {
+	// Clamp offset into range to avoid a panic on a hostile target size
+	if offset < 0 {
+		offset = 0
+	}
+	if offset > int64(len(target)) {
+		offset = int64(len(target))
+	}
+	return readers.NewLimitedReadCloser(io.NopCloser(strings.NewReader(target[offset:])), limit)
+}
