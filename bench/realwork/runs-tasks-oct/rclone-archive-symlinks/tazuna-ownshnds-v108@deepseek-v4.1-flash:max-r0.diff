+// zipEntry describes an entry for writeSymlinkZip.
+type zipEntry struct {
+	name   string
+	target string // content of the entry
+	link   bool   // make a symlink entry whose content is target
+}
+
+// writeSymlinkZip builds a zip file in dir with the entries given and
+// returns its leaf name.
+func writeSymlinkZip(t *testing.T, dir, name string, entries ...zipEntry) string {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, e := range entries {
+		hdr := &zip.FileHeader{Name: e.name}
+		if e.link {
+			hdr.SetMode(os.ModeSymlink | 0777)
+		} else {
+			hdr.SetMode(0644)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		if !strings.HasSuffix(e.name, "/") {
+			_, err = w.Write([]byte(e.target))
+			require.NoError(t, err)
+		}
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(filepath.Join(dir, name), buf.Bytes(), 0600))
+	return name
+}
+
+// withLinks returns a copy of ctx with -l/--links in effect
+func withLinks(ctx context.Context, links bool) context.Context {
+	ctx, ci := fs.AddConfig(ctx)
+	ci.Links = links
+	return ctx
+}
+
+// readObject reads the whole of obj
+func readObject(ctx context.Context, t *testing.T, o fs.Object, options ...fs.OpenOption) string {
+	rc, err := o.Open(ctx, options...)
+	require.NoError(t, err)
+	data, err := io.ReadAll(rc)
+	require.NoError(t, err)
+	require.NoError(t, rc.Close())
+	return string(data)
+}
+
+// A symlink in a zip is skipped without -l/--links and exposed under
+// its name plus fs.LinkSuffix with it, with its size being the length
+// of the target.
+func TestReadZipSymlink(t *testing.T) {
+	dir := t.TempDir()
+	name := writeSymlinkZip(t, dir, "test.zip",
+		zipEntry{name: "file.txt", target: "hello"},
+		zipEntry{name: "link.txt", target: "file.txt", link: true},
+		zipEntry{name: "sub/up.txt", target: "../file.txt", link: true},
+	)
+	localFs, err := cache.Get(context.Background(), dir)
+	require.NoError(t, err)
+
+	t.Run("NoLinks", func(t *testing.T) {
+		ctx := withLinks(context.Background(), false)
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		assert.Equal(t, []string{"file.txt"}, allRemotes(t, f))
+		_, err = f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		assert.Equal(t, fs.ErrorObjectNotFound, err)
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.Equal(t, fs.ErrorObjectNotFound, err)
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		ctx := withLinks(context.Background(), true)
+		f, err := New(ctx, localFs, name, "", "")
+		require.NoError(t, err)
+
+		want := []string{"file.txt", "link.txt" + fs.LinkSuffix, "sub/up.txt" + fs.LinkSuffix}
+		assert.Equal(t, want, allRemotes(t, f))
+
+		// Listing and NewObject must agree on the names
+		entries, err := f.List(ctx, "")
+		require.NoError(t, err)
+		var remotes []string
+		for _, entry := range entries {
+			remotes = append(remotes, entry.Remote())
+		}
+		sort.Strings(remotes)
+		assert.Equal(t, []string{"file.txt", "link.txt" + fs.LinkSuffix, "sub"}, remotes)
+
+		o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(ctx, t, o))
+
+		// The symlink isn't visible under its own name
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.Equal(t, fs.ErrorObjectNotFound, err)
+
+		// Range and seek options are honoured
+		assert.Equal(t, "le.", readObject(ctx, t, o, &fs.RangeOption{Start: 2, End: 4}))
+		assert.Equal(t, ".txt", readObject(ctx, t, o, &fs.SeekOption{Offset: 4}))
+		// A range beyond the end reads nothing rather than panicking
+		assert.Equal(t, "", readObject(ctx, t, o, &fs.RangeOption{Start: 100, End: 200}))
+	})
+}
