+// Symlinks in a squashfs image are skipped without -l/--links and
+// exposed under their name plus fs.LinkSuffix with it, with the size
+// being the length of the target.
+func TestSymlinks(t *testing.T) {
+	ctx := context.Background()
+
+	t.Run("NoLinks", func(t *testing.T) {
+		f := symlinkTestFs(t, false)
+		// The symlinks are absent, but regular members are unaffected
+		assert.Equal(t, []string{"clash.rclonelink", "file.txt", "name.rclonelink"}, listRemotes(ctx, t, f, ""))
+		_, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		assert.Equal(t, fs.ErrorObjectNotFound, err)
+		_, err = f.NewObject(ctx, "link.txt")
+		assert.Equal(t, fs.ErrorObjectNotFound, err)
+	})
+
+	t.Run("Links", func(t *testing.T) {
+		f := symlinkTestFs(t, true)
+		want := []string{
+			"absolute.txt" + fs.LinkSuffix,
+			"clash.rclonelink",
+			"file.txt",
+			"link.txt" + fs.LinkSuffix,
+			"linkdir" + fs.LinkSuffix,
+			"name.rclonelink",
+		}
+		// The symlink "clash" clashes with the regular "clash.rclonelink"
+		// so it is not exposed
+		assert.Equal(t, want, listRemotes(ctx, t, f, ""))
+		assert.Equal(t, []string{"sub/inside.txt"}, listRemotes(ctx, t, f, "sub"))
+
+		// Listing and NewObject agree on which names exist
+		for _, remote := range want {
+			_, err := f.NewObject(ctx, remote)
+			assert.NoError(t, err, remote)
+		}
+		for _, remote := range []string{"link.txt", "linkdir", "absolute.txt", "clash"} {
+			_, err := f.NewObject(ctx, remote)
+			assert.Equal(t, fs.ErrorObjectNotFound, err, remote)
+		}
+
+		o, err := f.NewObject(ctx, "link.txt"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, int64(len("file.txt")), o.Size())
+		assert.Equal(t, "file.txt", readObject(ctx, t, o))
+
+		// Range and seek options are honoured
+		assert.Equal(t, "le.", readObject(ctx, t, o, &fs.RangeOption{Start: 2, End: 4}))
+		assert.Equal(t, ".txt", readObject(ctx, t, o, &fs.SeekOption{Offset: 4}))
+		// A range beyond the end reads nothing rather than panicking
+		assert.Equal(t, "", readObject(ctx, t, o, &fs.RangeOption{Start: 100, End: 200}))
+
+		// A regular member ending in fs.LinkSuffix is a regular file
+		o, err = f.NewObject(ctx, "name"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "regular\n", readObject(ctx, t, o))
+
+		// The clashing name resolves to the regular member
+		o, err = f.NewObject(ctx, "clash"+fs.LinkSuffix)
+		require.NoError(t, err)
+		assert.Equal(t, "regular clash\n", readObject(ctx, t, o))
+	})
+}
