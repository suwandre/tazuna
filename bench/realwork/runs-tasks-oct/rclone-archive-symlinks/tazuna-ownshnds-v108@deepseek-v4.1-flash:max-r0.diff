+// writeSymlinkZip writes a zip containing a file and a symlink to it
+// to path.
+func writeSymlinkZip(t *testing.T, path string) {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name, target string
+		link         bool
+	}{
+		{"src/", "", false},
+		{"src/file.txt", "hello world", false},
+		{"src/link.txt", "file.txt", true},
+	} {
+		hdr := &zip.FileHeader{Name: entry.name}
+		if entry.link {
+			hdr.SetMode(os.ModeSymlink | 0777)
+		} else {
+			hdr.SetMode(0644)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.target))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	require.NoError(t, os.WriteFile(path, buf.Bytes(), 0600))
+}
+
+// TestArchiveSymlinkCopy checks that copying with -l/--links recreates
+// the symlinks stored in an archive.
+func TestArchiveSymlinkCopy(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks not applicable on Windows")
+	}
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	zipPath := filepath.Join(t.TempDir(), "test.zip")
+	writeSymlinkZip(t, zipPath)
+	sqfsPath, err := filepath.Abs(filepath.Join("squashfs", "testdata", "symlink.sqfs"))
+	require.NoError(t, err)
+
+	for _, test := range []struct {
+		name     string
+		archive  string
+		file     string
+		contents string
+		link     string
+		target   string
+	}{
+		{"Zip", zipPath, "src/file.txt", "hello world", "src/link.txt", "file.txt"},
+		{"Squashfs", sqfsPath, "file.txt", "hello world\n", "link.txt", "file.txt"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			fsrc, err := cache.Get(ctx, ":archive:"+test.archive)
+			require.NoError(t, err)
+			fdst, err := cache.Get(ctx, t.TempDir())
+			require.NoError(t, err)
+
+			require.NoError(t, sync.CopyDir(ctx, fdst, fsrc, false))
+
+			// The regular file was copied
+			filePath := filepath.Join(fdst.Root(), test.file)
+			contents, err := os.ReadFile(filePath)
+			require.NoError(t, err)
+			assert.Equal(t, test.contents, string(contents))
+
+			// The symlink was recreated with the right target
+			linkPath := filepath.Join(fdst.Root(), test.link)
+			fi, err := os.Lstat(linkPath)
+			require.NoError(t, err)
+			require.True(t, fi.Mode()&os.ModeSymlink != 0, "should be a symlink")
+			target, err := os.Readlink(linkPath)
+			require.NoError(t, err)
+			assert.Equal(t, test.target, target)
+		})
+	}
+}
+
+// TestArchiveSymlinkEscape checks that a hostile archive can't make a
+// copy write outside the destination: a symlink pointing above the root
+// is recreated faithfully, but a member "inside" it is refused.
+func TestArchiveSymlinkEscape(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks not applicable on Windows")
+	}
+	fstest.Initialise()
+	ctx, ci := fs.AddConfig(context.Background())
+	ci.Links = true
+
+	evil := t.TempDir()
+	evilFile := filepath.Join(evil, "authkeys")
+
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, entry := range []struct {
+		name, target string
+		link         bool
+	}{
+		{"pwn", evil, true},
+		{"pwn/authkeys", "PWNED", false},
+	} {
+		hdr := &zip.FileHeader{Name: entry.name}
+		if entry.link {
+			hdr.SetMode(os.ModeSymlink | 0777)
+		} else {
+			hdr.SetMode(0644)
+		}
+		w, err := zw.CreateHeader(hdr)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(entry.target))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	zipPath := filepath.Join(t.TempDir(), "evil.zip")
+	require.NoError(t, os.WriteFile(zipPath, buf.Bytes(), 0600))
+
+	fsrc, err := cache.Get(ctx, ":archive:"+zipPath)
+	require.NoError(t, err)
+	fdst, err := cache.Get(ctx, t.TempDir())
+	require.NoError(t, err)
+
+	// The symlink itself is reproduced faithfully
+	srcLink, err := fsrc.NewObject(ctx, "pwn"+fs.LinkSuffix)
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, fdst, nil, "pwn"+fs.LinkSuffix, srcLink)
+	require.NoError(t, err)
+	target, err := os.Readlink(filepath.Join(fdst.Root(), "pwn"))
+	require.NoError(t, err)
+	require.Equal(t, evil, target)
+
+	// But the member inside it must not be written through the symlink
+	srcFile, err := fsrc.NewObject(ctx, "pwn/authkeys")
+	require.NoError(t, err)
+	_, err = operations.Copy(ctx, fdst, nil, "pwn/authkeys", srcFile)
+	require.Error(t, err, "writing through a planted symlink should be refused")
+
+	// Nothing escaped the destination
+	_, err = os.Stat(evilFile)
+	assert.True(t, os.IsNotExist(err), "a file escaped the destination into %q", evilFile)
+}
