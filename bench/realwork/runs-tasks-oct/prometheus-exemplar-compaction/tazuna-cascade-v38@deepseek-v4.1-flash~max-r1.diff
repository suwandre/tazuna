+func TestCircularExemplarStorage_HasExemplarAtOrAfter(t *testing.T) {
+	series1 := labels.FromStrings("trace_id", "foo")
+	series2 := labels.FromStrings("trace_id", "bar")
+
+	exs, err := NewCircularExemplarStorage(4, eMetrics, 0)
+	require.NoError(t, err)
+	es := exs.(*CircularExemplarStorage)
+
+	// Empty storage.
+	require.False(t, es.HasExemplarAtOrAfter(series1, math.MinInt64))
+
+	require.NoError(t, es.AddExemplar(series1, exemplar.Exemplar{Labels: series1, Value: 1, Ts: 0}))
+	require.NoError(t, es.AddExemplar(series1, exemplar.Exemplar{Labels: series1, Value: 2, Ts: 100}))
+	require.NoError(t, es.AddExemplar(series2, exemplar.Exemplar{Labels: series2, Value: 3, Ts: -50}))
+
+	// Zero and negative timestamps are real timestamps.
+	require.True(t, es.HasExemplarAtOrAfter(series1, 0))
+	require.True(t, es.HasExemplarAtOrAfter(series1, 100))
+	require.False(t, es.HasExemplarAtOrAfter(series1, 101))
+	require.True(t, es.HasExemplarAtOrAfter(series2, -50))
+	require.False(t, es.HasExemplarAtOrAfter(series2, -49))
+
+	// Unknown series.
+	require.False(t, es.HasExemplarAtOrAfter(labels.FromStrings("trace_id", "unknown"), math.MinInt64))
+}
