+// TestExemplarSurvivesRestartAfterHeadGC verifies that an exemplar at or after
+// the WAL replay cutoff survives a restart after the head has persisted and
+// dropped the samples of its series. Exemplars are not written to blocks, so
+// the series record must survive WAL checkpointing for the exemplar to be
+// replayed. A second compaction and restart checks that the protection also
+// holds for exemplars restored by WAL replay or the chunk snapshot.
+func TestExemplarSurvivesRestartAfterHeadGC(t *testing.T) {
+	const chunkRange = 1000
+	staleV := math.Float64frombits(value.StaleNaN)
+
+	type sample struct {
+		t int64
+		v float64
+	}
+	var (
+		doCompact = func(t *testing.T, db *DB, _ storage.SeriesRef) {
+			require.NoError(t, db.Compact(context.Background()))
+		}
+		doCompactSelected = func(t *testing.T, db *DB, ref storage.SeriesRef) {
+			require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+		}
+		doCompactStale = func(t *testing.T, db *DB, _ storage.SeriesRef) {
+			require.NoError(t, db.CompactStaleHead())
+		}
+	)
+
+	// The filler series moves the head forward so that DB.Compact persists the
+	// first two chunk ranges and the replay cutoff becomes 2000, then 3000.
+	cases := map[string]struct {
+		samples    []sample
+		exemplarTs int64
+		compact    func(t *testing.T, db *DB, ref storage.SeriesRef)
+		// releasesChunks is set when the compaction persists the series'
+		// samples and must release its chunks while keeping the series.
+		releasesChunks bool
+	}{
+		"compact/exemplar newer than last sample": {
+			samples:    []sample{{100, 1}},
+			exemplarTs: 4050,
+			compact:    doCompact,
+		},
+		"selected/exemplar newer than last sample": {
+			samples:        []sample{{100, 1}},
+			exemplarTs:     4050,
+			compact:        doCompactSelected,
+			releasesChunks: true,
+		},
+		"selected/exemplar older than last sample": {
+			samples:        []sample{{100, 1}, {3500, 2}},
+			exemplarTs:     3050,
+			compact:        doCompactSelected,
+			releasesChunks: true,
+		},
+		"stale/exemplar newer than last sample": {
+			samples:        []sample{{100, 1}, {200, staleV}},
+			exemplarTs:     4050,
+			compact:        doCompactStale,
+			releasesChunks: true,
+		},
+		"stale/exemplar older than last sample": {
+			samples:        []sample{{100, 1}, {3500, 2}, {3550, staleV}},
+			exemplarTs:     3050,
+			compact:        doCompactStale,
+			releasesChunks: true,
+		},
+	}
+
+	for name, tc := range cases {
+		for _, appV2 := range []bool{false, true} {
+			for _, snapshot := range []bool{false, true} {
+				t.Run(fmt.Sprintf("%s/appV2=%v/snapshot=%v", name, appV2, snapshot), func(t *testing.T) {
+					opts := DefaultOptions()
+					opts.MinBlockDuration = chunkRange
+					opts.MaxBlockDuration = chunkRange
+					opts.EnableExemplarStorage = true
+					opts.MaxExemplars = 100
+					opts.EnableMemorySnapshotOnShutdown = snapshot
+					dir := t.TempDir()
+					openDB := func() *DB {
+						db, err := Open(dir, nil, nil, opts, nil)
+						require.NoError(t, err)
+						db.DisableCompactions()
+						return db
+					}
+					db := openDB()
+					t.Cleanup(func() { require.NoError(t, db.Close()) })
+
+					series := labels.FromStrings("name", "with_exemplar")
+					filler := labels.FromStrings("name", "filler")
+					ex := exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "abc"), Value: 1, Ts: tc.exemplarTs, HasTs: true}
+
+					appendFiller := func(ts ...int64) {
+						app := db.Appender(context.Background())
+						for _, t0 := range ts {
+							_, err := app.Append(0, filler, t0, 1)
+							require.NoError(t, err)
+						}
+						require.NoError(t, app.Commit())
+					}
+
+					// The filler and the series are appended in one transaction so
+					// that the head's max time does not move in between. The exemplar
+					// is attached to the first sample of the series.
+					fillerTs := []int64{100, 900, 1700, 2700}
+					var ref storage.SeriesRef
+					if appV2 {
+						app := db.AppenderV2(context.Background())
+						for _, t0 := range fillerTs {
+							_, err := app.Append(0, filler, 0, t0, 1, nil, nil, storage.AOptions{})
+							require.NoError(t, err)
+						}
+						for i, s := range tc.samples {
+							var aOpts storage.AOptions
+							if i == 0 {
+								aOpts.Exemplars = []exemplar.Exemplar{ex}
+							}
+							var err error
+							ref, err = app.Append(ref, series, 0, s.t, s.v, nil, nil, aOpts)
+							require.NoError(t, err)
+						}
+						require.NoError(t, app.Commit())
+					} else {
+						app := db.Appender(context.Background())
+						for _, t0 := range fillerTs {
+							_, err := app.Append(0, filler, t0, 1)
+							require.NoError(t, err)
+						}
+						for i, s := range tc.samples {
+							var err error
+							ref, err = app.Append(ref, series, s.t, s.v)
+							require.NoError(t, err)
+							if i == 0 {
+								_, err = app.AppendExemplar(ref, series, ex)
+								require.NoError(t, err)
+							}
+						}
+						require.NoError(t, app.Commit())
+					}
+
+					checkpointAt := func(mint int64) {
+						_, prevIdx, err := wlog.LastCheckpoint(db.head.wal.Dir())
+						if err != nil {
+							prevIdx = -1
+						}
+						for range 10 {
+							db.head.lastWALTruncationTime.Store(0)
+							require.NoError(t, db.head.truncateWAL(mint))
+							if _, idx, err := wlog.LastCheckpoint(db.head.wal.Dir()); err == nil && idx > prevIdx {
+								return
+							}
+						}
+						require.FailNow(t, "no new WAL checkpoint was produced")
+					}
+
+					checkSeriesKept := func() {
+						ms := db.head.series.getByHash(series.Hash(), series)
+						require.NotNil(t, ms, "series with a retained exemplar must stay in the head")
+						require.Equal(t, chunks.HeadSeriesRef(ref), ms.ref, "series must keep its reference")
+					}
+
+					restartAndCheck := func() {
+						require.NoError(t, db.Close())
+						db = openDB()
+						q, err := db.ExemplarQuerier(context.Background())
+						require.NoError(t, err)
+						res, err := q.Select(math.MinInt64, math.MaxInt64, []*labels.Matcher{labels.MustNewMatcher(labels.MatchEqual, "name", "with_exemplar")})
+						require.NoError(t, err)
+						require.Len(t, res, 1, "exemplar must survive the restart")
+						require.Len(t, res[0].Exemplars, 1)
+						// The WAL does not record HasTs, so compare the other fields.
+						got := res[0].Exemplars[0]
+						require.Equal(t, ex.Ts, got.Ts)
+						require.Equal(t, ex.Value, got.Value)
+						require.Equal(t, ex.Labels, got.Labels)
+						require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")))
+						checkSeriesKept()
+					}
+
+					// First round: persist the series' samples, checkpoint the WAL and restart.
+					chunksBefore := prom_testutil.ToFloat64(db.head.metrics.chunks)
+					removedBefore := prom_testutil.ToFloat64(db.head.metrics.chunksRemoved)
+					tc.compact(t, db, ref)
+					checkSeriesKept()
+					if tc.releasesChunks {
+						ms := db.head.series.getByID(chunks.HeadSeriesRef(ref))
+						ms.Lock()
+						require.Nil(t, ms.headChunks)
+						require.Empty(t, ms.mmappedChunks)
+						require.Nil(t, ms.app)
+						ms.Unlock()
+						removed := prom_testutil.ToFloat64(db.head.metrics.chunksRemoved) - removedBefore
+						require.Positive(t, removed)
+						require.Equal(t, chunksBefore-removed, prom_testutil.ToFloat64(db.head.metrics.chunks))
+
+						// Compacting the now empty series again must neither write
+						// a block nor count chunks again.
+						blocks := len(db.Blocks())
+						removedBefore = prom_testutil.ToFloat64(db.head.metrics.chunksRemoved)
+						tc.compact(t, db, ref)
+						require.Len(t, db.Blocks(), blocks)
+						require.Equal(t, removedBefore, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+						checkSeriesKept()
+					} else {
+						// The empty retained series must not hold back the head's
+						// minimum time, which is the oldest remaining filler sample.
+						require.Equal(t, int64(1700), db.head.MinTime())
+					}
+					checkpointAt(2000)
+					restartAndCheck()
+
+					// Second round: the exemplar now comes from WAL replay or the
+					// chunk snapshot.
+					appendFiller(3700)
+					tc.compact(t, db, ref)
+					checkSeriesKept()
+					checkpointAt(3000)
+					restartAndCheck()
+				})
+			}
+		}
+	}
+}
