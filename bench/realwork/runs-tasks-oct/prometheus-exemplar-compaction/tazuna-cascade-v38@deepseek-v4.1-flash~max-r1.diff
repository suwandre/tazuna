+// HasExemplarAtOrAfter reports whether the storage holds an exemplar for the
+// series with the given labels at or after mint. Zero and negative timestamps
+// are treated like any other timestamp.
+func (ce *CircularExemplarStorage) HasExemplarAtOrAfter(l labels.Labels, mint int64) bool {
+	ce.lock.RLock()
+	defer ce.lock.RUnlock()
+
+	if len(ce.exemplars) == 0 {
+		return false
+	}
+
+	var buf [1024]byte
+	seriesLabels := l.Bytes(buf[:])
+
+	idx, ok := ce.index[string(seriesLabels)]
+	if !ok {
+		return false
+	}
+	// The exemplars of a series are kept in timestamp order, so the newest one
+	// bounds all others.
+	return ce.exemplars[idx.newest].exemplar.Ts >= mint
+}
+
 func (ce *CircularExemplarStorage) ValidateExemplar(l labels.Labels, e exemplar.Exemplar) error {
 	var buf [1024]byte
 	seriesLabels := l.Bytes(buf[:])
