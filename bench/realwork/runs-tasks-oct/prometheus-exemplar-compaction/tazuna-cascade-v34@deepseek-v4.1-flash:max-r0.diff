+// TestExemplarRetention_HeadCompactionSurvivesRestart exercises the original
+// bug through DB.Compact: the series' samples are persisted into a block, the
+// series has no unpersisted samples left and would be removed from the head,
+// and the WAL is checkpointed at a mint past the series' sample time while the
+// exemplar's WAL record is still within replay range. The series record must be
+// kept, so the exemplar reference still resolves after a restart.
+func TestExemplarRetention_HeadCompactionSurvivesRestart(t *testing.T) {
+	const chunkRange = 1000
+	opts := exemplarTestOptions(chunkRange)
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	sel := labels.FromStrings("name", "selected")
+	mid := labels.FromStrings("name", "mid")
+	filler := labels.FromStrings("name", "filler")
+	exLabel := labels.FromStrings("trace_id", "abc")
+
+	app := db.Appender(t.Context())
+	ref, err := app.Append(0, sel, 100, 1)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, sel, exemplar.Exemplar{Labels: exLabel, Value: 2, Ts: 2500})
+	require.NoError(t, err)
+	_, err = app.Append(0, mid, 1000, 2)
+	require.NoError(t, err)
+	// Keeps the head compactable across two chunk ranges.
+	_, err = app.Append(0, filler, 3000, 3)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	// Roll the WAL so that the compaction's truncateWAL call really produces a
+	// checkpoint of the segments holding the series and exemplar records.
+	for range 30 {
+		_, err := db.head.wal.NextSegment()
+		require.NoError(t, err)
+	}
+
+	require.NoError(t, db.Compact(t.Context()))
+	require.Len(t, db.Blocks(), 2, "both chunk ranges holding sel and mid must have been compacted")
+
+	ms := db.Head().series.getByID(chunks.HeadSeriesRef(ref))
+	require.NotNil(t, ms, "sel must be retained in the head")
+	ms.Lock()
+	require.Nil(t, ms.headChunks)
+	require.Empty(t, ms.mmappedChunks)
+	ms.Unlock()
+	require.GreaterOrEqual(t, db.Head().MinTime(), int64(2500),
+		"the empty retained series must not hold back the head's minimum time")
+
+	require.NoError(t, db.Close())
+	db, err = Open(db.Dir(), nil, nil, opts, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+
+	require.NotNil(t, db.Head().series.getByID(chunks.HeadSeriesRef(ref)),
+		"sel's series record must be replayed, otherwise the exemplar ref cannot resolve")
+	got := queryTestExemplars(t, db, labels.MustNewMatcher(labels.MatchEqual, "name", "selected"))
+	require.Len(t, got, 1, "the exemplar must survive the restart")
+	require.True(t, exemplar.Exemplar{Labels: exLabel, Value: 2, Ts: 2500}.Equals(got[0]))
+	require.Zero(t, prom_testutil.ToFloat64(db.Head().metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")))
+
+	// A further compaction plus restart must not lose it either.
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.NoError(t, db.Close())
+	db, err = Open(db.Dir(), nil, nil, opts, nil)
+	require.NoError(t, err)
+	got = queryTestExemplars(t, db, labels.MustNewMatcher(labels.MatchEqual, "name", "selected"))
+	require.Len(t, got, 1, "the exemplar must survive a compaction after replay")
+}
