+// TestExemplarRetention_StaleSeries verifies that CompactStaleHead retains the
+// identity of a stale series that still has an exemplar at or after the head's
+// minimum valid time, while releasing its chunks.
+func TestExemplarRetention_StaleSeries(t *testing.T) {
+	const chunkRange = 1000
+	opts := exemplarTestOptions(chunkRange)
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+
+	staleV := math.Float64frombits(value.StaleNaN)
+	sel := labels.FromStrings("name", "stale")
+
+	app := db.Appender(t.Context())
+	ref, err := app.Append(0, sel, 100, 1)
+	require.NoError(t, err)
+	_, err = app.Append(ref, sel, 200, staleV)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, sel, exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "1"), Value: 2, Ts: 200})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+	require.Equal(t, uint64(1), db.Head().NumStaleSeries())
+
+	ms := db.Head().series.getByID(chunks.HeadSeriesRef(ref))
+	require.NotNil(t, ms)
+
+	require.NoError(t, db.CompactStaleHead())
+
+	require.Len(t, db.Blocks(), 1)
+	require.Same(t, ms, db.Head().series.getByID(chunks.HeadSeriesRef(ref)),
+		"the same in-memory series must be retained")
+	require.Equal(t, uint64(1), db.Head().NumSeries())
+	require.Equal(t, uint64(1), db.Head().NumStaleSeries(), "the stale series must not be counted as deleted")
+	ms.Lock()
+	require.Nil(t, ms.headChunks)
+	require.Empty(t, ms.mmappedChunks)
+	require.Nil(t, ms.app)
+	ms.Unlock()
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(db.Head().metrics.chunks))
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(db.Head().metrics.chunksRemoved))
+
+	// A second stale compaction must neither write another block nor count
+	// chunks again.
+	require.NoError(t, db.CompactStaleHead())
+	require.Len(t, db.Blocks(), 1)
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(db.Head().metrics.chunksRemoved))
+}
