+	require.NotNil(t, ms.headChunks, "the late sample's chunk must be kept")
+	require.Equal(t, int64(200), ms.maxTime())
+	ms.Unlock()
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(db.Head().metrics.chunks))
+}
