+// TestExemplarRetention_ZeroAndNegativeTimestamps verifies that a zero or
+// negative exemplar timestamp is treated as a real timestamp: the series is
+// retained while the cutoff is at or below it and removed once the cutoff
+// moves past it.
+func TestExemplarRetention_ZeroAndNegativeTimestamps(t *testing.T) {
+	const chunkRange = 1000
+	opts := exemplarTestOptions(chunkRange)
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+
+	zero := labels.FromStrings("name", "zero")
+	negative := labels.FromStrings("name", "negative")
+
+	app := db.Appender(t.Context())
+	zeroRef, err := app.Append(0, zero, 0, 1)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(zeroRef, zero, exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "0"), Value: 1, Ts: 0})
+	require.NoError(t, err)
+	negRef, err := app.Append(0, negative, 0, 1)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(negRef, negative, exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "1"), Value: 1, Ts: -5})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	db.Head().minValidTime.Store(0)
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{zeroRef, negRef}))
+	require.NotNil(t, db.Head().series.getByID(chunks.HeadSeriesRef(zeroRef)),
+		"an exemplar at the cutoff must protect the series")
+	require.Nil(t, db.Head().series.getByID(chunks.HeadSeriesRef(negRef)),
+		"an exemplar before the cutoff must not protect the series")
+
+	db.Head().minValidTime.Store(1)
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{zeroRef}))
+	require.Nil(t, db.Head().series.getByID(chunks.HeadSeriesRef(zeroRef)),
+		"once the cutoff moves past the exemplar the series can be removed")
+}
