+// TestExemplarRetention_ReleasesMappedChunks verifies that memory-mapped
+// chunks are released and counted exactly once, just like head chunks, when an
+// exemplar keeps the series identity alive.
+func TestExemplarRetention_ReleasesMappedChunks(t *testing.T) {
+	const chunkRange = 10000
+	opts := exemplarTestOptions(chunkRange)
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+
+	sel := labels.FromStrings("name", "selected")
+	app := db.Appender(t.Context())
+	var ref storage.SeriesRef
+	for i := range DefaultSamplesPerChunk + 1 {
+		var err error
+		ref, err = app.Append(ref, sel, int64(i), float64(i))
+		require.NoError(t, err)
+	}
+	_, err := app.AppendExemplar(ref, sel, exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "abc"), Value: 2, Ts: chunkRange})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	// Move all but the newest head chunk to disk.
+	db.ForceHeadMMap()
+	ms := db.Head().series.getByID(chunks.HeadSeriesRef(ref))
+	require.NotNil(t, ms)
+	ms.Lock()
+	mapped := len(ms.mmappedChunks)
+	require.NotZero(t, mapped, "test precondition: at least one chunk must be mapped")
+	head := int(ms.headChunkCount.Load())
+	ms.Unlock()
+	require.Equal(t, float64(mapped+head), prom_testutil.ToFloat64(db.Head().metrics.chunks))
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+
+	require.Same(t, ms, db.Head().series.getByID(chunks.HeadSeriesRef(ref)))
+	ms.Lock()
+	require.Nil(t, ms.headChunks)
+	require.Empty(t, ms.mmappedChunks)
+	require.Nil(t, ms.app)
+	ms.Unlock()
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(db.Head().metrics.chunks))
+	require.Equal(t, float64(mapped+head), prom_testutil.ToFloat64(db.Head().metrics.chunksRemoved))
+}
