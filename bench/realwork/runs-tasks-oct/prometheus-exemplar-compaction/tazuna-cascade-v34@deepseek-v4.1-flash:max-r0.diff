+// TestExemplarRetention_SelectedSeriesRestartCompactionLoop checks that after a
+// selected-series compaction the WAL still replays the already-persisted
+// samples, and a later compaction releases them again.
+func TestExemplarRetention_SelectedSeriesRestartCompactionLoop(t *testing.T) {
+	const chunkRange = 1000
+	opts := exemplarTestOptions(chunkRange)
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	sel := labels.FromStrings("name", "selected")
+	app := db.Appender(t.Context())
+	ref, err := app.Append(0, sel, 100, 1)
+	require.NoError(t, err)
+	_, err = app.Append(ref, sel, 200, 2)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, sel, exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "abc"), Value: 2, Ts: 5000})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Len(t, db.Blocks(), 1)
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(db.Head().metrics.chunks))
+
+	require.NoError(t, db.Close())
+	db, err = Open(db.Dir(), nil, nil, opts, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+
+	// WAL replay brings the persisted samples back; a later compaction can
