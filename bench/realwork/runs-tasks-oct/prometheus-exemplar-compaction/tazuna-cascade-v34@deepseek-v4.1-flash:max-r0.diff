+// TestExemplarRetention_OrdinaryGCKeepsIdentity drives the plain time-based
+// head GC (not selected or stale compaction) after the series' samples have
+// been persisted, and verifies the series identity and appender handling.
+func TestExemplarRetention_OrdinaryGCKeepsIdentity(t *testing.T) {
+	const chunkRange = 1000
+	opts := exemplarTestOptions(chunkRange)
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+
+	sel := labels.FromStrings("name", "selected")
+	app := db.Appender(t.Context())
+	ref, err := app.Append(0, sel, 100, 1)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, sel, exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "abc"), Value: 2, Ts: 1500})
+	require.NoError(t, err)
+	// Keeps the head compactable for the range holding sel's sample.
+	_, err = app.Append(0, labels.FromStrings("name", "filler"), 3100, 3)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	// Persist sel's chunk and let the truncation-driven GC run.
+	require.NoError(t, db.Compact(t.Context()))
+
+	ms := db.Head().series.getByID(chunks.HeadSeriesRef(ref))
+	require.NotNil(t, ms, "the series must be kept: its exemplar is still replayable")
+	ms.Lock()
+	require.Nil(t, ms.headChunks)
+	require.Empty(t, ms.mmappedChunks)
+	require.Nil(t, ms.app, "the appender of the removed chunk must be released")
+	ms.Unlock()
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(db.Head().metrics.chunks),
+		"only the filler's chunk may remain")
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(db.Head().metrics.chunksRemoved))
+}
