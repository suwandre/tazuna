+// exemplarTestOptions returns DB options with exemplar storage enabled and a
+// small chunk range, so that a head compaction can be driven by hand.
+func exemplarTestOptions(chunkRange int64) *Options {
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = config.DefaultExemplarsConfig.MaxExemplars
+	return opts
+}
+
+// queryTestExemplars returns the exemplars the DB currently serves for the
+// given matcher.
+func queryTestExemplars(t *testing.T, db *DB, matcher *labels.Matcher) []exemplar.Exemplar {
+	t.Helper()
+	q, err := db.ExemplarQuerier(t.Context())
+	require.NoError(t, err)
+	res, err := q.Select(0, math.MaxInt64, []*labels.Matcher{matcher})
+	require.NoError(t, err)
+	if len(res) == 0 {
+		return nil
+	}
+	return res[0].Exemplars
+}
+
+// TestExemplarRetention_SelectedSeries verifies that CompactSelectedSeries
+// keeps the identity of a series that still has an exemplar at or after the
+// head's minimum valid time, while releasing its chunks. Compacting the
+// retained, empty series again must not write another block or count its
+// chunks again, and once the cutoff moves past the exemplar the series is
+// removed as usual.
+func TestExemplarRetention_SelectedSeries(t *testing.T) {
+	const chunkRange = 1000
+	opts := exemplarTestOptions(chunkRange)
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+
+	sel := labels.FromStrings("name", "selected")
+	exLabel := labels.FromStrings("trace_id", "abc")
+
+	app := db.Appender(t.Context())
+	ref, err := app.Append(0, sel, 100, 1)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, sel, exemplar.Exemplar{Labels: exLabel, Value: 2, Ts: 1500})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	ms := db.Head().series.getByID(chunks.HeadSeriesRef(ref))
+	require.NotNil(t, ms)
+	ms.Lock()
+	require.True(t, ms.hasExemplarAtOrAfter(math.MinInt64))
+	require.False(t, ms.hasExemplarAtOrAfter(1501))
+	ms.Unlock()
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+
+	require.Len(t, db.Blocks(), 1, "the series' samples must have been persisted")
+	require.Same(t, ms, db.Head().series.getByID(chunks.HeadSeriesRef(ref)),
+		"the same in-memory series must be retained")
+	require.Equal(t, uint64(1), db.Head().NumSeries())
+	ms.Lock()
+	require.Nil(t, ms.headChunks, "head chunks must be released")
+	require.Empty(t, ms.mmappedChunks, "mmapped chunks must be released")
+	require.Nil(t, ms.app, "the appender must be released")
+	ms.Unlock()
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(db.Head().metrics.chunks))
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(db.Head().metrics.chunksRemoved))
+
+	// Compacting the retained, now empty series again must be a no-op: no
+	// block, no chunk accounting.
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Len(t, db.Blocks(), 1, "an empty retained series must not produce another block")
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(db.Head().metrics.chunksRemoved))
+	require.Same(t, ms, db.Head().series.getByID(chunks.HeadSeriesRef(ref)))
+
+	// The exemplar is still served.
+	got := queryTestExemplars(t, db, labels.MustNewMatcher(labels.MatchEqual, "name", "selected"))
+	require.Len(t, got, 1)
+	require.True(t, exemplar.Exemplar{Labels: exLabel, Value: 2, Ts: 1500}.Equals(got[0]))
+
+	// Once the replay cutoff moves past the exemplar, the series can be removed.
+	db.Head().minValidTime.Store(1501)
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Equal(t, uint64(0), db.Head().NumSeries())
+	require.Nil(t, db.Head().series.getByID(chunks.HeadSeriesRef(ref)))
+}
