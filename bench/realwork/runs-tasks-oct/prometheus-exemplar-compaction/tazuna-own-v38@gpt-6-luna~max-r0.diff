+func TestHead_GC_ExemplarRetentionCutoff(t *testing.T) {
+	for _, tc := range []struct {
+		name         string
+		exemplarTs   int64
+		minValidTime int64
+		wantKeep     bool
+	}{
+		{
+			name:         "zero timestamp at cutoff",
+			exemplarTs:   0,
+			minValidTime: 0,
+			wantKeep:     true,
+		},
+		{
+			name:         "negative timestamp at cutoff",
+			exemplarTs:   -1,
+			minValidTime: -1,
+			wantKeep:     true,
+		},
+		{
+			name:         "older than sample but replayable",
+			exemplarTs:   50,
+			minValidTime: 0,
+			wantKeep:     true,
+		},
+		{
+			name:         "before cutoff",
+			exemplarTs:   -1,
+			minValidTime: 0,
+			wantKeep:     false,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			h, _ := newTestHead(t, 1000, compression.None, false)
+			lset := labels.FromStrings("name", "series")
+
+			app := h.Appender(context.Background())
+			ref, err := app.Append(0, lset, 100, 1)
+			require.NoError(t, err)
+			require.NoError(t, app.Commit())
+
+			ex := exemplar.Exemplar{
+				Ts:     tc.exemplarTs,
+				Value:  1,
+				Labels: labels.FromStrings("trace_id", "trace"),
+			}
+			app = h.Appender(context.Background())
+			_, err = app.AppendExemplar(ref, lset, ex)
+			require.NoError(t, err)
+			require.NoError(t, app.Commit())
+
+			series := h.series.getByID(chunks.HeadSeriesRef(ref))
+			require.NotNil(t, series)
+			h.minTime.Store(101)
+			h.minValidTime.Store(tc.minValidTime)
+
+			actualMint, _, _ := h.gc()
+			require.Equal(t, int64(101), actualMint, "an empty retained series must not hold back the head mint")
+			require.Equal(t, tc.wantKeep, h.series.getByID(chunks.HeadSeriesRef(ref)) != nil)
+			if tc.wantKeep {
+				require.Same(t, series, h.series.getByID(chunks.HeadSeriesRef(ref)))
+				series.Lock()
+				require.Nil(t, series.headChunks)
+				require.Nil(t, series.mmappedChunks)
+				require.Nil(t, series.app)
+				series.Unlock()
+			}
+			require.Equal(t, float64(0), prom_testutil.ToFloat64(h.metrics.chunks))
+			require.Equal(t, float64(1), prom_testutil.ToFloat64(h.metrics.chunksRemoved))
+		})
+	}
+}
