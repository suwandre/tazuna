+func TestCompactSelectedSeries_ExemplarSurvivesChunkSnapshotAndFurtherCompaction(t *testing.T) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = 100
+	opts.EnableMemorySnapshotOnShutdown = true
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	seriesLabels := labels.FromStrings("name", "snapshot_selected")
+	ex := exemplar.Exemplar{Ts: -1, Value: 1, Labels: labels.FromStrings("trace_id", "snapshot")}
+	app := db.Appender(context.Background())
+	ref, err := app.Append(0, seriesLabels, 100, 1)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, seriesLabels, ex)
+	require.NoError(t, err)
+	_, err = app.Append(ref, seriesLabels, 1200, 2)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+	db.head.mmapHeadChunks()
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+	require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.chunks))
+
+	dir := db.Dir()
+	require.NoError(t, db.Close())
+	db, err = Open(dir, nil, nil, opts, nil)
+	require.NoError(t, err)
+	db.DisableCompactions()
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+
+	queryExemplar := func(d *DB) {
+		t.Helper()
+		q, err := d.ExemplarQuerier(context.Background())
+		require.NoError(t, err)
+		got, err := q.Select(ex.Ts, ex.Ts, []*labels.Matcher{labels.MustNewMatcher(labels.MatchEqual, "name", "snapshot_selected")})
+		require.NoError(t, err)
+		require.Len(t, got, 1)
+		require.Equal(t, seriesLabels, got[0].SeriesLabels)
+		require.Len(t, got[0].Exemplars, 1)
+		require.True(t, ex.Equals(got[0].Exemplars[0]))
+	}
+	queryExemplar(db)
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+	require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.chunks),
+		"the memory snapshot must restore the retained identity without persisted samples")
+
+	// Compact a new sample after restoring the exemplar from the snapshot, then snapshot and restart again.
+	app = db.Appender(context.Background())
+	_, err = app.Append(ref, seriesLabels, 1600, 3)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+	chunksRemovedBefore := prom_testutil.ToFloat64(db.head.metrics.chunksRemoved)
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+	require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.chunks))
+	require.Equal(t, chunksRemovedBefore+1, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+
+	dir = db.Dir()
+	require.NoError(t, db.Close())
+	db, err = Open(dir, nil, nil, opts, nil)
+	require.NoError(t, err)
+	db.DisableCompactions()
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+	queryExemplar(db)
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+	require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.chunks),
+		"the second memory snapshot must not restore chunks from the earlier compaction")
+}
