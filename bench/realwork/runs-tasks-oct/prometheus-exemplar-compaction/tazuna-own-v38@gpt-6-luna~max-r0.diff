+func TestCompact_ExemplarSeriesSurvivesWALCheckpointAndRestart(t *testing.T) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = 100
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	target := labels.FromStrings("name", "target")
+	filler := labels.FromStrings("name", "filler")
+	app := db.Appender(context.Background())
+	targetRef, err := app.Append(0, target, 100, 1)
+	require.NoError(t, err)
+	fillerRef, err := app.Append(0, filler, 1100, 2)
+	require.NoError(t, err)
+	_, err = app.Append(fillerRef, filler, 1601, 3)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	// Keep the exemplar's WAL segment newer than the series and sample records.
+	for range 12 {
+		_, err := db.head.wal.NextSegment()
+		require.NoError(t, err)
+	}
+	ex := exemplar.Exemplar{Ts: 2500, Value: 1, Labels: labels.FromStrings("trace_id", "trace")}
+	app = db.Appender(context.Background())
+	_, err = app.AppendExemplar(targetRef, target, ex)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	series := db.head.series.getByID(chunks.HeadSeriesRef(targetRef))
+	require.NotNil(t, series)
+	require.True(t, db.head.compactable(), "the head must have a range to compact")
+	require.NoError(t, db.Compact(context.Background()))
+
+	require.Same(t, series, db.head.series.getByID(chunks.HeadSeriesRef(targetRef)),
+		"ordinary head GC must retain the same series while its exemplar is replayable")
+	require.Equal(t, uint64(2), db.Head().NumSeries())
+	require.Equal(t, int64(1100), db.Head().MinTime(), "the empty target series must not hold back HeadMinTime")
+	series.Lock()
+	require.Nil(t, series.headChunks)
+	require.Nil(t, series.mmappedChunks)
+	require.Nil(t, series.app)
+	series.Unlock()
+	if _, ok := db.head.getWALExpiry(chunks.HeadSeriesRef(targetRef)); ok {
+		t.Fatal("retained series must not need a WAL expiry")
+	}
+
+	forceCheckpointAt := func(mint int64) {
+		t.Helper()
+		_, lastIdx, err := wlog.LastCheckpoint(db.head.wal.Dir())
+		require.NoError(t, err, "DB.Compact must have checkpointed the older WAL segments")
+		for range 10 {
+			db.head.lastWALTruncationTime.Store(0)
+			require.NoError(t, db.head.truncateWAL(mint))
+			if _, idx, err := wlog.LastCheckpoint(db.head.wal.Dir()); err == nil && idx > lastIdx {
+				return
+			}
+		}
+		t.Fatalf("no new WAL checkpoint produced for mint=%d", mint)
+	}
+	checkpointHasTargetSeries := func() bool {
+		t.Helper()
+		checkpointDir, _, err := wlog.LastCheckpoint(db.head.wal.Dir())
+		require.NoError(t, err)
+		for _, rec := range readTestWAL(t, checkpointDir) {
+			seriesRecs, ok := rec.([]record.RefSeries)
+			if !ok {
+				continue
+			}
+			for _, s := range seriesRecs {
+				if s.Ref == chunks.HeadSeriesRef(targetRef) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+
+	// The replay cutoff moves beyond the evicted sample's WAL expiry but stays at or before the exemplar.
+	forceCheckpointAt(1101)
+	require.True(t, checkpointHasTargetSeries(),
+		"the checkpoint must retain the target series record for the exemplar in a later WAL segment")
+	checkpointDir, _, err := wlog.LastCheckpoint(db.head.wal.Dir())
+	require.NoError(t, err)
+	for _, rec := range readTestWAL(t, checkpointDir) {
+		exemplars, ok := rec.([]record.RefExemplar)
+		if !ok {
+			continue
+		}
+		for _, e := range exemplars {
+			require.NotEqual(t, chunks.HeadSeriesRef(targetRef), e.Ref,
+				"the exemplar must remain in a newer, still-replayed WAL segment")
+		}
+	}
+	walHasTargetExemplar := false
+	for _, rec := range readTestWAL(t, db.head.wal.Dir()) {
+		exemplars, ok := rec.([]record.RefExemplar)
+		if !ok {
+			continue
+		}
+		for _, e := range exemplars {
+			if e.Ref == chunks.HeadSeriesRef(targetRef) && e.T == ex.Ts {
+				walHasTargetExemplar = true
+			}
+		}
+	}
+	require.True(t, walHasTargetExemplar, "the exemplar record must remain in the uncheckpointed WAL segments")
+
+	dir := db.Dir()
+	require.NoError(t, db.Close())
+	db, err = Open(dir, nil, nil, opts, nil)
+	require.NoError(t, err)
+	db.DisableCompactions()
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+
+	queryExemplar := func(d *DB) {
+		t.Helper()
+		q, err := d.ExemplarQuerier(context.Background())
+		require.NoError(t, err)
+		got, err := q.Select(ex.Ts, ex.Ts, []*labels.Matcher{labels.MustNewMatcher(labels.MatchEqual, "name", "target")})
+		require.NoError(t, err)
+		require.Len(t, got, 1)
+		require.Equal(t, target, got[0].SeriesLabels)
+		require.Len(t, got[0].Exemplars, 1)
+		require.True(t, ex.Equals(got[0].Exemplars[0]))
+	}
+	queryExemplar(db)
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(targetRef)))
+	require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")))
+}
