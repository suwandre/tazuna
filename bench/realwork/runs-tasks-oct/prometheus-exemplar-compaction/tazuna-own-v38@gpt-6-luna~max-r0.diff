+// HasExemplarsAtOrAfter reports whether the series has an exemplar at or after mint.
+func (ce *CircularExemplarStorage) hasExemplarsAtOrAfter(l labels.Labels, mint int64) bool {
+	var buf [1024]byte
+	seriesLabels := l.Bytes(buf[:])
+
+	ce.lock.RLock()
+	defer ce.lock.RUnlock()
+
+	idx := ce.index[string(seriesLabels)]
+	return idx != nil && ce.exemplars[idx.newest].exemplar.Ts >= mint
+}
