+func TestCompactSeriesWithExemplarsRetainsIdentityAndReleasesChunks(t *testing.T) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = 100
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	selectedLabels := labels.FromStrings("name", "selected")
+	selectedExemplar := exemplar.Exemplar{
+		Ts:     0,
+		Value:  1,
+		Labels: labels.FromStrings("trace_id", "selected"),
+	}
+	appV2 := db.AppenderV2(context.Background())
+	selectedRef, err := appV2.Append(0, selectedLabels, 0, 100, 1, nil, nil, storage.AOptions{Exemplars: []exemplar.Exemplar{selectedExemplar}})
+	require.NoError(t, err)
+	_, err = appV2.Append(selectedRef, selectedLabels, 0, 1200, 2, nil, nil, storage.AOptions{})
+	require.NoError(t, err)
+	require.NoError(t, appV2.Commit())
+
+	staleLabels := labels.FromStrings("name", "stale")
+	staleExemplar := exemplar.Exemplar{
+		Ts:     -1,
+		Value:  1,
+		Labels: labels.FromStrings("trace_id", "stale"),
+	}
+	app := db.Appender(context.Background())
+	staleRef, err := app.Append(0, staleLabels, 800, 1)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(staleRef, staleLabels, staleExemplar)
+	require.NoError(t, err)
+	staleValue := math.Float64frombits(value.StaleNaN)
+	_, err = app.Append(staleRef, staleLabels, 1200, staleValue)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	// Compact two chunks per series so the test covers both head and memory-mapped chunks.
+	db.head.mmapHeadChunks()
+	selectedSeries := db.head.series.getByID(chunks.HeadSeriesRef(selectedRef))
+	staleSeries := db.head.series.getByID(chunks.HeadSeriesRef(staleRef))
+	for _, series := range []*memSeries{selectedSeries, staleSeries} {
+		require.NotNil(t, series)
+		series.Lock()
+		require.Len(t, series.mmappedChunks, 1)
+		require.Equal(t, uint32(1), series.headChunkCount.Load())
+		require.NotNil(t, series.app)
+		series.Unlock()
+	}
+	require.Equal(t, float64(4), prom_testutil.ToFloat64(db.head.metrics.chunks))
+	require.Equal(t, uint64(1), db.Head().NumStaleSeries())
+
+	assertNoChunks := func(series *memSeries) {
+		t.Helper()
+		require.NotNil(t, series)
+		series.Lock()
+		defer series.Unlock()
+		require.Nil(t, series.headChunks)
+		require.Zero(t, series.headChunkCount.Load())
+		require.Nil(t, series.mmappedChunks)
+		require.Nil(t, series.app)
+	}
+	chunksRemovedBefore := prom_testutil.ToFloat64(db.head.metrics.chunksRemoved)
+	headMinTime := db.Head().MinTime()
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selectedRef}))
+	require.Same(t, selectedSeries, db.head.series.getByID(chunks.HeadSeriesRef(selectedRef)))
+	assertNoChunks(selectedSeries)
+	require.Equal(t, uint64(2), db.Head().NumSeries())
+	require.Equal(t, uint64(1), db.Head().NumStaleSeries())
+	require.Equal(t, headMinTime, db.Head().MinTime())
+	require.Equal(t, float64(2), prom_testutil.ToFloat64(db.head.metrics.chunks))
+	require.Equal(t, chunksRemovedBefore+2, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+
+	require.NoError(t, db.CompactStaleHead())
+	require.Same(t, staleSeries, db.head.series.getByID(chunks.HeadSeriesRef(staleRef)))
+	assertNoChunks(staleSeries)
+	require.Equal(t, uint64(2), db.Head().NumSeries())
+	require.Zero(t, db.Head().NumStaleSeries())
+	require.Equal(t, headMinTime, db.Head().MinTime())
+	require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.chunks))
+	require.Equal(t, chunksRemovedBefore+4, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+
+	blocksAfterCompaction := len(db.Blocks())
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selectedRef}))
+	require.NoError(t, db.CompactStaleHead())
+	require.Len(t, db.Blocks(), blocksAfterCompaction,
+		"compacting retained empty series must not write another block")
+	require.Equal(t, chunksRemovedBefore+4, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved),
+		"empty retained series must not count their chunks as removed twice")
+
+	checkExemplar := func(d *DB, seriesLabels labels.Labels, ex exemplar.Exemplar) {
+		t.Helper()
+		q, err := d.ExemplarQuerier(context.Background())
+		require.NoError(t, err)
+		got, err := q.Select(ex.Ts, ex.Ts, []*labels.Matcher{labels.MustNewMatcher(labels.MatchEqual, "name", seriesLabels.Get("name"))})
+		require.NoError(t, err)
+		require.Len(t, got, 1)
+		require.Equal(t, seriesLabels, got[0].SeriesLabels)
+		require.Len(t, got[0].Exemplars, 1)
+		require.True(t, ex.Equals(got[0].Exemplars[0]))
+	}
+	checkBothExemplars := func(d *DB) {
+		t.Helper()
+		checkExemplar(d, selectedLabels, selectedExemplar)
+		checkExemplar(d, staleLabels, staleExemplar)
+	}
+
+	dir := db.Dir()
+	require.NoError(t, db.Close())
+	db, err = Open(dir, nil, nil, opts, nil)
+	require.NoError(t, err)
+	db.DisableCompactions()
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+	checkBothExemplars(db)
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(selectedRef)))
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(staleRef)))
+	require.NotZero(t, prom_testutil.ToFloat64(db.head.metrics.chunks),
+		"WAL replay may restore samples that the selected/stale blocks already persisted")
+	require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")))
+
+	selectedSeries = db.head.series.getByID(chunks.HeadSeriesRef(selectedRef))
+	staleSeries = db.head.series.getByID(chunks.HeadSeriesRef(staleRef))
+	chunksRemovedBefore = prom_testutil.ToFloat64(db.head.metrics.chunksRemoved)
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selectedRef}))
+	require.Same(t, selectedSeries, db.head.series.getByID(chunks.HeadSeriesRef(selectedRef)))
+	assertNoChunks(selectedSeries)
+	require.NoError(t, db.CompactStaleHead())
+	require.Same(t, staleSeries, db.head.series.getByID(chunks.HeadSeriesRef(staleRef)))
+	assertNoChunks(staleSeries)
+	require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.chunks))
+	require.Equal(t, chunksRemovedBefore+4, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+
+	dir = db.Dir()
+	require.NoError(t, db.Close())
+	db, err = Open(dir, nil, nil, opts, nil)
+	require.NoError(t, err)
+	db.DisableCompactions()
+	checkBothExemplars(db)
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(selectedRef)))
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(staleRef)))
+	require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")))
+}
