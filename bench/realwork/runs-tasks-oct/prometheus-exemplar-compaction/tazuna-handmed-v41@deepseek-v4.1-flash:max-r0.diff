+// HasExemplarAtOrAfter reports whether the storage holds at least one exemplar
+// for the series with the given labels whose timestamp is at or after mint.
+// Exemplars with a zero or negative timestamp count like any other.
+func (ce *CircularExemplarStorage) HasExemplarAtOrAfter(l labels.Labels, mint int64) bool {
+	ce.lock.RLock()
+	defer ce.lock.RUnlock()
+
+	var buf [1024]byte
+	idx, ok := ce.index[string(l.Bytes(buf[:]))]
+	if !ok {
+		return false
+	}
+	return ce.exemplars[idx.newest].exemplar.Ts >= mint
+}
