+// hasExemplarAtOrAfter reports whether the head's exemplar storage holds an
+// exemplar for the series with the given labels whose timestamp is at or after
+// mint.
+func (h *Head) hasExemplarAtOrAfter(l labels.Labels, mint int64) bool {
+	ce, ok := h.exemplars.(*CircularExemplarStorage)
+	if !ok {
+		return false
+	}
+	return ce.HasExemplarAtOrAfter(l, mint)
+}
+
+// retainForExemplarsFn returns a predicate that reports whether a series whose
+// samples have been persisted to a block must nevertheless keep its identity in
+// the head because an exemplar recorded for it may still be replayed.
+//
+// Exemplars before the head's min valid time are discarded during WAL replay, so
+// only exemplars at or after it require the series record to remain resolvable.
+// While such a series stays in the head, keepSeriesInWALCheckpointFn keeps its
+// series record in WAL checkpoints, so replayed exemplar records can resolve it.
+func (h *Head) retainForExemplarsFn() func(*memSeries) bool {
+	minValidTime := h.minValidTime.Load()
+	return func(s *memSeries) bool {
+		return h.hasExemplarAtOrAfter(s.lset, minValidTime)
+	}
+}
