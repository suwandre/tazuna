+func TestCircularExemplarStorage_HasExemplarAtOrAfter(t *testing.T) {
+	es, err := NewCircularExemplarStorage(4, NewExemplarMetrics(nil), 0)
+	require.NoError(t, err)
+	ce := es.(*CircularExemplarStorage)
+	lbls := labels.FromStrings(labels.MetricName, "m")
+	for i, e := range []exemplar.Exemplar{{Ts: -5, Value: 1}, {Ts: 0, Value: 2}, {Ts: 10, Value: 3}} {
+		require.NoError(t, ce.AddExemplar(lbls, e), "exemplar %d", i)
+	}
+
+	require.True(t, ce.HasExemplarAtOrAfter(lbls, -5))
+	require.True(t, ce.HasExemplarAtOrAfter(lbls, 0), "zero is a real timestamp")
+	require.True(t, ce.HasExemplarAtOrAfter(lbls, 9))
+	require.True(t, ce.HasExemplarAtOrAfter(lbls, 10))
+	require.False(t, ce.HasExemplarAtOrAfter(lbls, 11))
+	require.False(t, ce.HasExemplarAtOrAfter(labels.FromStrings(labels.MetricName, "other"), math.MinInt64))
+
+	// Disabled storage never holds exemplars.
+	disabled, err := NewCircularExemplarStorage(0, NewExemplarMetrics(nil), 0)
+	require.NoError(t, err)
+	require.False(t, disabled.(*CircularExemplarStorage).HasExemplarAtOrAfter(lbls, math.MinInt64))
+}
