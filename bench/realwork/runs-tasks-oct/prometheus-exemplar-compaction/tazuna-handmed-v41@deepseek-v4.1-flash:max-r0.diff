+func TestCompactSelectedSeries_ExemplarExpiresWithAdvancingCutoff(t *testing.T) {
+	opts := exemplarRetentionTestOpts()
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	lbls := labels.FromStrings(labels.MetricName, "with_exemplar")
+	ref := exemplarRetentionTestSeries(t, db, lbls, 100, 200)
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Equal(t, uint64(1), db.head.NumSeries(), "the series must be kept while its exemplar can be replayed")
+
+	// Append enough filler data and run a regular head compaction so the replay
+	// cutoff moves past the exemplar. The now-empty series must be removed.
+	filler := labels.FromStrings(labels.MetricName, "filler")
+	app := db.Appender(context.Background())
+	_, err := app.Append(0, filler, 100, 0.1)
+	require.NoError(t, err)
+	_, err = app.Append(0, filler, 1700, 0.2)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	require.NoError(t, db.Compact(context.Background()))
+	require.Greater(t, db.head.minValidTime.Load(), int64(200), "test precondition: the replay cutoff moved past the exemplar")
+	require.Nil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)), "the series may be removed once the cutoff is past the exemplar")
+	require.Equal(t, uint64(1), db.head.NumSeries(), "only the filler series is left")
+}
