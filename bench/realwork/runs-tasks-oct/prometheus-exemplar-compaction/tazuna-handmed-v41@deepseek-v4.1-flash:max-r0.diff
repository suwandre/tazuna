+func TestHeadCompaction_ExemplarKeepsSeriesIdentityAcrossRestart(t *testing.T) {
+	for _, snapshot := range []bool{false, true} {
+		t.Run(fmt.Sprintf("snapshot=%t", snapshot), func(t *testing.T) {
+			opts := exemplarRetentionTestOpts()
+			opts.EnableMemorySnapshotOnShutdown = snapshot
+			db := newTestDB(t, withOpts(opts))
+			db.DisableCompactions()
+			dir := db.Dir()
+
+			lbls := labels.FromStrings(labels.MetricName, "with_exemplar")
+			ref := exemplarRetentionTestSeries(t, db, lbls, 100, 5000)
+
+			// A filler series pushes the head over the compactable threshold.
+			filler := labels.FromStrings(labels.MetricName, "filler")
+			app := db.Appender(context.Background())
+			_, err := app.Append(0, filler, 100, 0.1)
+			require.NoError(t, err)
+			_, err = app.Append(0, filler, 1700, 0.2)
+			require.NoError(t, err)
+			require.NoError(t, app.Commit())
+
+			require.NoError(t, db.Compact(context.Background()))
+			require.Len(t, db.Blocks(), 1)
+
+			require.NoError(t, db.Close())
+			reopened, err := Open(dir, nil, nil, opts, nil)
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, reopened.Close()) })
+
+			require.Zero(t, prom_testutil.ToFloat64(reopened.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")))
+			got := exemplarRetentionQuery(t, reopened, lbls)
+			require.Len(t, got, 1)
+			require.Equal(t, int64(5000), got[0].Ts)
+
+			// A further compaction plus restart must not lose the exemplar either.
+			require.NoError(t, reopened.CompactSelectedSeries([]storage.SeriesRef{ref}))
+			require.NoError(t, reopened.Close())
+			reopened2, err := Open(dir, nil, nil, opts, nil)
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, reopened2.Close()) })
+
+			require.Zero(t, prom_testutil.ToFloat64(reopened2.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")))
+			got = exemplarRetentionQuery(t, reopened2, lbls)
+			require.Len(t, got, 1)
+			require.Equal(t, int64(5000), got[0].Ts)
+		})
+	}
+}
