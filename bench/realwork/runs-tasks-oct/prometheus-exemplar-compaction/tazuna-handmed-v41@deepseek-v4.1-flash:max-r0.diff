+func exemplarRetentionTestOpts() *Options {
+	opts := DefaultOptions()
+	opts.MinBlockDuration = 1000
+	opts.MaxBlockDuration = 1000
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = config.DefaultExemplarsConfig.MaxExemplars
+	return opts
+}
+
+func exemplarRetentionTestSeries(t *testing.T, db *DB, lbls labels.Labels, sampleTs int64, exTs int64) storage.SeriesRef {
+	t.Helper()
+	app := db.Appender(context.Background())
+	ref, err := app.Append(0, lbls, sampleTs, 1.0)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, lbls, exemplar.Exemplar{
+		Ts:     exTs,
+		Value:  2.0,
+		Labels: labels.FromStrings("trace_id", "abc"),
+	})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+	return ref
+}
+
+func exemplarRetentionQuery(t *testing.T, db *DB, lbls labels.Labels) []exemplar.Exemplar {
+	t.Helper()
+	eq, err := db.ExemplarQuerier(context.Background())
+	require.NoError(t, err)
+	res, err := eq.Select(0, math.MaxInt64, []*labels.Matcher{
+		labels.MustNewMatcher(labels.MatchEqual, labels.MetricName, lbls.Get(labels.MetricName)),
+	})
+	require.NoError(t, err)
+	require.Len(t, res, 1)
+	return res[0].Exemplars
+}
+
+func TestCompactSelectedSeries_ExemplarKeepsSeriesIdentity(t *testing.T) {
+	opts := exemplarRetentionTestOpts()
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+	dir := db.Dir()
+
+	lbls := labels.FromStrings(labels.MetricName, "with_exemplar")
+	ref := exemplarRetentionTestSeries(t, db, lbls, 100, 200)
+
+	seriesBefore := db.head.series.getByID(chunks.HeadSeriesRef(ref))
+	require.NotNil(t, seriesBefore)
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(db.head.metrics.chunks))
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+
+	seriesAfter := db.head.series.getByID(chunks.HeadSeriesRef(ref))
+	require.Same(t, seriesBefore, seriesAfter, "the series must keep its identity")
+	require.Equal(t, uint64(1), db.head.NumSeries())
+
+	seriesAfter.Lock()
+	require.Nil(t, seriesAfter.headChunks)
+	require.Empty(t, seriesAfter.mmappedChunks)
+	require.Nil(t, seriesAfter.app)
+	seriesAfter.Unlock()
+
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(db.head.metrics.chunks))
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+	require.Len(t, db.Blocks(), 1)
+
+	// Compacting the now empty series again must neither write a block nor
+	// remove chunks a second time.
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Len(t, db.Blocks(), 1)
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+
+	require.NoError(t, db.Close())
+	reopened, err := Open(dir, nil, nil, opts, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, reopened.Close()) })
+
+	require.Zero(t, prom_testutil.ToFloat64(reopened.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")))
+	got := exemplarRetentionQuery(t, reopened, lbls)
+	require.Len(t, got, 1)
+	require.True(t, exemplar.Exemplar{Ts: 200, Value: 2.0, Labels: labels.FromStrings("trace_id", "abc")}.Equals(got[0]))
+
+	// Only selected-series blocks exist, so WAL replay brings the sample back.
+	// A later compaction must release it again.
+	require.Equal(t, uint64(1), reopened.head.NumSeries())
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(reopened.head.metrics.chunks))
+	require.NoError(t, reopened.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(reopened.head.metrics.chunks))
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(reopened.head.metrics.chunksRemoved))
+}
