+func TestCompactSelectedSeries_ExemplarRetainedSeriesAcceptsNewSamples(t *testing.T) {
+	opts := exemplarRetentionTestOpts()
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	lbls := labels.FromStrings(labels.MetricName, "with_exemplar")
+	ref := exemplarRetentionTestSeries(t, db, lbls, 100, 200)
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(db.head.metrics.chunks))
+
+	// The retained series accepts new samples and reuses the same reference.
+	app := db.Appender(context.Background())
+	newRef, err := app.Append(ref, lbls, 300, 3.0)
+	require.NoError(t, err)
+	require.Equal(t, ref, newRef)
+	require.NoError(t, app.Commit())
+
+	q, err := db.Querier(0, 1000)
+	require.NoError(t, err)
+	got := query(t, q, labels.MustNewMatcher(labels.MatchEqual, labels.MetricName, "with_exemplar"))
+	require.Equal(t, []chunks.Sample{sample{t: 100, f: 1.0}, sample{t: 300, f: 3.0}}, got[`{__name__="with_exemplar"}`])
+}
