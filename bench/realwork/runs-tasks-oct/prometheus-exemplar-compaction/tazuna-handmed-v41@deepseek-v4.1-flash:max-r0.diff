+func TestCompactSelectedSeries_ExemplarRetainedUntilCutoffPasses(t *testing.T) {
+	opts := exemplarRetentionTestOpts()
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	lbls := labels.FromStrings(labels.MetricName, "with_exemplar")
+	ref := exemplarRetentionTestSeries(t, db, lbls, 100, 200)
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Equal(t, uint64(1), db.head.NumSeries(), "the exemplar is at the replay cutoff, so the series must be kept")
+
+	// Advance the replay cutoff past the exemplar: the series may now be removed.
+	db.head.minValidTime.Store(201)
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Equal(t, uint64(0), db.head.NumSeries(), "the exemplar is before the replay cutoff, so the series may be removed")
+}
