+func TestCompactSelectedSeries_ZeroAndNegativeExemplarTimestamps(t *testing.T) {
+	for _, exTs := range []int64{0, -1} {
+		t.Run(fmt.Sprintf("exemplar_ts=%d", exTs), func(t *testing.T) {
+			opts := exemplarRetentionTestOpts()
+			db := newTestDB(t, withOpts(opts))
+			db.DisableCompactions()
+
+			lbls := labels.FromStrings(labels.MetricName, "with_exemplar")
+			ref := exemplarRetentionTestSeries(t, db, lbls, 100, exTs)
+
+			// The default replay cutoff is math.MinInt64, so the exemplar counts.
+			require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+			require.Equal(t, uint64(1), db.head.NumSeries(), "exemplar at t=%d must keep the series", exTs)
+		})
+	}
+
+	// A zero exemplar timestamp also counts once the cutoff is exactly zero.
+	opts := exemplarRetentionTestOpts()
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+	db.head.minValidTime.Store(0)
+
+	lbls := labels.FromStrings(labels.MetricName, "with_exemplar")
+	ref := exemplarRetentionTestSeries(t, db, lbls, 100, 0)
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Equal(t, uint64(1), db.head.NumSeries(), "exemplar at t=0 must keep the series when the cutoff is 0")
+}
