diff --git a/tsdb/head_test.go b/tsdb/head_test.go
index ba80c35..b218de4 100644
--- a/tsdb/head_test.go
+++ b/tsdb/head_test.go
@@ -7539,6 +7539,63 @@ func TestWALSampleAndExemplarOrder(t *testing.T) {
 // panic, that we have seen in the wild once.
 //
 // TODO(bwplotka): This no longer can happen in AppenderV2, remove once AppenderV1 is removed, see #17632.
+func TestHeadTruncateKeepsSeriesWithExemplarAtOrAfterCutoff(t *testing.T) {
+	cases := []struct {
+		name        string
+		sampleTs    int64
+		exemplarTs  *int64
+		truncateAt  int64
+		wantRetains bool
+	}{
+		{name: "no exemplar", sampleTs: -100, truncateAt: 0},
+		{name: "zero timestamp at cutoff", sampleTs: -100, exemplarTs: new(int64(0)), truncateAt: 0, wantRetains: true},
+		{name: "negative timestamp at cutoff", sampleTs: -1000, exemplarTs: new(int64(-500)), truncateAt: -500, wantRetains: true},
+		{name: "negative timestamp before cutoff", sampleTs: -1000, exemplarTs: new(int64(-501)), truncateAt: -500},
+	}
+	for _, tc := range cases {
+		for _, appenderV2 := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/appenderV2=%t", tc.name, appenderV2), func(t *testing.T) {
+				h, _ := newTestHead(t, DefaultBlockDuration, compression.None, false)
+				require.NoError(t, h.Init(math.MinInt64))
+				lbls := labels.FromStrings("foo", "bar")
+				var exemplars []exemplar.Exemplar
+				if tc.exemplarTs != nil {
+					exemplars = []exemplar.Exemplar{{Value: 1, Ts: *tc.exemplarTs, HasTs: true}}
+				}
+				var ref storage.SeriesRef
+				if appenderV2 {
+					app := h.AppenderV2(context.Background())
+					var err error
+					ref, err = app.Append(0, lbls, 0, tc.sampleTs, 1, nil, nil, storage.AOptions{Exemplars: exemplars})
+					require.NoError(t, err)
+					require.NoError(t, app.Commit())
+				} else {
+					app := h.Appender(context.Background())
+					var err error
+					ref, err = app.Append(0, lbls, tc.sampleTs, 1)
+					require.NoError(t, err)
+					for _, e := range exemplars {
+						_, err = app.AppendExemplar(ref, lbls, e)
+						require.NoError(t, err)
+					}
+					require.NoError(t, app.Commit())
+				}
+
+				require.NoError(t, h.Truncate(tc.truncateAt))
+				s := h.series.getByID(chunks.HeadSeriesRef(ref))
+				if !tc.wantRetains {
+					require.Nil(t, s)
+					return
+				}
+				require.NotNil(t, s)
+				require.Nil(t, s.headChunks)
+				require.Nil(t, s.app)
+				require.Equal(t, tc.truncateAt, h.MinTime(), "retained series without samples must not hold back the head's min time")
+			})
+		}
+	}
+}
