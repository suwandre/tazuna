+// releaseInOrderChunks removes all in-order chunks and the appender from the series and
+// returns the number of removed chunks. Chunk IDs remain unchanged.
+// Has to be called with the series lock held.
+func (s *memSeries) releaseInOrderChunks() int {
+	removed := len(s.mmappedChunks) + int(s.headChunkCount.Load())
+	s.firstChunkID = wrapChunkID(s.firstChunkID + chunks.HeadChunkID(removed))
+	s.mmappedChunks = nil
+	s.setHeadChunks(nil, 0)
+	s.app = nil
+	return removed
+}
