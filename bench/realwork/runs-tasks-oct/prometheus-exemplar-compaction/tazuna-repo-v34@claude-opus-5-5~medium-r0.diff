+// observeExemplar records that an exemplar with timestamp t has been stored for the series.
+// Has to be called with the series lock held.
+func (s *memSeries) observeExemplar(t int64) {
+	if s.state&seriesHasExemplarFlag == 0 || t > s.maxExemplarTime {
+		s.maxExemplarTime = t
+	}
+	s.state |= seriesHasExemplarFlag
+}
+
+// hasExemplarAtOrAfter reports whether an exemplar with a timestamp at or after t has been
+// stored for the series. Has to be called with the series lock held.
+func (s *memSeries) hasExemplarAtOrAfter(t int64) bool {
+	return s.state&seriesHasExemplarFlag != 0 && s.maxExemplarTime >= t
+}
