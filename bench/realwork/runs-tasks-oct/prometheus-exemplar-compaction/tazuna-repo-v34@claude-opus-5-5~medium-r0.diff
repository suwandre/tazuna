+// TestExemplarSurvivesRestartAfterSeriesCompaction checks that a series that has
+// an exemplar at or after the WAL replay cutoff keeps its identity through head GC,
+// so that the exemplar is still restored by WAL replay or the memory snapshot after
+// a restart, while the persisted samples of the series are released.
+func TestExemplarSurvivesRestartAfterSeriesCompaction(t *testing.T) {
+	const chunkRange = 1000
+
+	type compactFn func(t *testing.T, db *DB, ref storage.SeriesRef)
+	var (
+		compact = func(t *testing.T, db *DB, _ storage.SeriesRef) {
+			require.NoError(t, db.Compact(context.Background()))
+		}
+		compactSelected = func(t *testing.T, db *DB, ref storage.SeriesRef) {
+			require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+		}
+		compactStale = func(t *testing.T, db *DB, _ storage.SeriesRef) {
+			require.NoError(t, db.CompactStaleHead())
+		}
+	)
+
+	cases := []struct {
+		name string
+		// Sample timestamps of the series with the exemplar. The last one is a stale marker if stale is set.
+		samples    []int64
+		stale      bool
+		exemplarTs int64
+		// Head max time the other series reaches before the series with the exemplar is evicted.
+		otherMaxt int64
+		// Compact the head up to the chunk range of the series' samples before evicting it.
+		precompact bool
+		// Evicts the series with the exemplar; no-op when called again on the emptied series.
+		evict compactFn
+		// Further compaction before the second restart.
+		again compactFn
+		// Head max time the other series reaches after the eviction.
+		otherMaxtAfter int64
+	}{
+		{
+			name:           "compact/exemplar after last sample",
+			samples:        []int64{2100, 2200},
+			exemplarTs:     9000,
+			otherMaxt:      3600,
+			evict:          compact,
+			otherMaxtAfter: 3600,
+		},
+		{
+			name:           "selected/exemplar after last sample",
+			samples:        []int64{3100, 3200},
+			exemplarTs:     9000,
+			otherMaxt:      3600,
+			precompact:     true,
+			evict:          compactSelected,
+			otherMaxtAfter: 5000,
+		},
+		{
+			name:           "selected/exemplar before last sample",
+			samples:        []int64{3100, 3200},
+			exemplarTs:     3150,
+			otherMaxt:      3600,
+			precompact:     true,
+			evict:          compactSelected,
+			otherMaxtAfter: 3600,
+		},
+		{
+			name:           "stale/exemplar after last sample",
+			samples:        []int64{3100, 3200},
+			stale:          true,
+			exemplarTs:     9000,
+			otherMaxt:      3600,
+			precompact:     true,
+			evict:          compactStale,
+			otherMaxtAfter: 5000,
+		},
+		{
+			name:           "stale/exemplar before last sample",
+			samples:        []int64{3100, 3200},
+			stale:          true,
+			exemplarTs:     3150,
+			otherMaxt:      3600,
+			precompact:     true,
+			evict:          compactStale,
+			otherMaxtAfter: 3600,
+		},
+	}
+
+	// Both appenders share the commit path, so each restart path is only run with one of them
+	// to keep the number of fsync heavy restarts down.
+	variants := []struct{ appenderV2, snapshot bool }{{false, false}, {true, true}}
+	for _, tc := range cases {
+		for _, variant := range variants {
+			appenderV2, snapshot := variant.appenderV2, variant.snapshot
+			t.Run(fmt.Sprintf("%s/appenderV2=%t/snapshot=%t", tc.name, appenderV2, snapshot), func(t *testing.T) {
+				t.Parallel()
+				opts := DefaultOptions()
+				opts.MinBlockDuration = chunkRange
+				opts.MaxBlockDuration = chunkRange
+				opts.EnableExemplarStorage = true
+				opts.MaxExemplars = 100
+				opts.EnableMemorySnapshotOnShutdown = snapshot
+				db := newTestDB(t, withOpts(opts))
+				db.DisableCompactions()
+				dir := db.Dir()
+
+				lbls := labels.FromStrings("__name__", "with_exemplar")
+				other := labels.FromStrings("__name__", "other")
+				ex := exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "abc"), Value: 1, Ts: tc.exemplarTs, HasTs: true}
+
+				var ref storage.SeriesRef
+				appendSeries := func() {
+					var err error
+					for i, ts := range tc.samples {
+						v := float64(i)
+						if tc.stale && i == len(tc.samples)-1 {
+							v = math.Float64frombits(value.StaleNaN)
+						}
+						if appenderV2 {
+							app := db.AppenderV2(context.Background())
+							var aOpts storage.AOptions
+							if i == 0 {
+								aOpts.Exemplars = []exemplar.Exemplar{ex}
+							}
+							ref, err = app.Append(ref, lbls, 0, ts, v, nil, nil, aOpts)
+							require.NoError(t, err)
+							require.NoError(t, app.Commit())
+							continue
+						}
+						app := db.Appender(context.Background())
+						ref, err = app.Append(ref, lbls, ts, v)
+						require.NoError(t, err)
+						if i == 0 {
+							_, err = app.AppendExemplar(ref, lbls, ex)
+							require.NoError(t, err)
+						}
+						require.NoError(t, app.Commit())
+					}
+				}
+				// The other series starts at 2000, so that the first compaction writes a single block.
+				var otherMaxt int64 = 1900
+				appendOther := func(maxt int64) {
+					app := db.Appender(context.Background())
+					for ts := otherMaxt + 100; ts <= maxt; ts += 100 {
+						_, err := app.Append(0, other, ts, float64(ts))
+						require.NoError(t, err)
+					}
+					require.NoError(t, app.Commit())
+					otherMaxt = maxt
+				}
+				// Checkpoints the WAL at the head's min time, as later compactions would.
+				checkpoint := func() {
+					prev := -1
+					if _, idx, err := wlog.LastCheckpoint(db.head.wal.Dir()); err == nil {
+						prev = idx
+					}
+					for range 10 {
+						db.head.lastWALTruncationTime.Store(0)
+						require.NoError(t, db.head.truncateWAL(db.head.MinTime()))
+						if _, idx, err := wlog.LastCheckpoint(db.head.wal.Dir()); err == nil && idx > prev {
+							return
+						}
+					}
+					t.Fatal("no new checkpoint was created")
+				}
+				restart := func() {
+					require.NoError(t, db.Close())
+					db = newTestDB(t, withDir(dir), withOpts(opts))
+					db.DisableCompactions()
+				}
+				requireExemplar := func() {
+					t.Helper()
+					q, err := db.ExemplarQuerier(context.Background())
+					require.NoError(t, err)
+					res, err := q.Select(math.MinInt64, math.MaxInt64, []*labels.Matcher{labels.MustNewMatcher(labels.MatchEqual, "__name__", "with_exemplar")})
+					require.NoError(t, err)
+					require.Len(t, res, 1)
+					require.Len(t, res[0].Exemplars, 1)
+					got := res[0].Exemplars[0]
+					require.Equal(t, ex.Ts, got.Ts)
+					require.Equal(t, ex.Value, got.Value)
+					testutil.RequireEqual(t, ex.Labels, got.Labels)
+					require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")))
+				}
+				requireRetainedWithoutChunks := func() {
+					t.Helper()
+					s := db.head.series.getByID(chunks.HeadSeriesRef(ref))
+					require.NotNil(t, s, "series with an exemplar after the replay cutoff must be kept")
+					s.Lock()
+					defer s.Unlock()
+					require.Nil(t, s.headChunks)
+					require.Empty(t, s.mmappedChunks)
+					require.Nil(t, s.app)
+				}
+
+				appendOther(tc.samples[0])
+				appendSeries()
+				appendOther(tc.otherMaxt)
+				if tc.precompact {
+					compact(t, db, ref)
+					require.Equal(t, int64(3000), db.head.MinTime())
+				}
+
+				chunksBefore := prom_testutil.ToFloat64(db.head.metrics.chunks)
+				removedBefore := prom_testutil.ToFloat64(db.head.metrics.chunksRemoved)
+				var released float64
+				if s := db.head.series.getByID(chunks.HeadSeriesRef(ref)); s != nil {
+					released = float64(len(s.mmappedChunks)) + float64(s.headChunkCount.Load())
+				}
+				tc.evict(t, db, ref)
+				requireRetainedWithoutChunks()
+				removedAfter := prom_testutil.ToFloat64(db.head.metrics.chunksRemoved)
+				if tc.precompact {
+					// Only the series' chunks are released.
+					require.Equal(t, 1.0, released)
+					require.Equal(t, chunksBefore-released, prom_testutil.ToFloat64(db.head.metrics.chunks))
+					require.Equal(t, removedBefore+released, removedAfter)
+				}
+				// The empty retained series does not hold back the head's min time.
+				require.Equal(t, int64(3000), db.head.MinTime())
+
+				// Evicting the empty series again neither writes a block nor counts chunks again.
+				numBlocks := len(db.Blocks())
+				tc.evict(t, db, ref)
+				requireRetainedWithoutChunks()
+				require.Len(t, db.Blocks(), numBlocks)
+				require.Equal(t, removedAfter, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+
+				if tc.otherMaxtAfter > otherMaxt {
+					appendOther(tc.otherMaxtAfter)
+					compact(t, db, ref)
+					requireRetainedWithoutChunks()
+				}
+				checkpoint()
+				restart()
+				requireExemplar()
+
+				// A further compaction after the exemplar was restored must keep it too.
+				if tc.exemplarTs > tc.otherMaxtAfter {
+					appendOther(tc.otherMaxtAfter + 1000)
+					compact(t, db, ref)
+				} else {
+					tc.evict(t, db, ref)
+				}
+				requireRetainedWithoutChunks()
+				checkpoint()
+				restart()
+				requireExemplar()
+				require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)), "series reference must be kept across restarts")
+			})
+		}
+	}
+}
