+// TestCircularExemplarStorage_SeriesWithExemplarAtOrAfter verifies that the
+// retention check uses each series' newest exemplar timestamp, and treats
+// timestamps at or below zero as ordinary timestamps.
+func TestCircularExemplarStorage_SeriesWithExemplarAtOrAfter(t *testing.T) {
+	l := labels.FromStrings("name", "metric")
+	other := labels.FromStrings("name", "other")
+	exs, err := NewCircularExemplarStorage(10, eMetrics, 0)
+	require.NoError(t, err)
+	es := exs.(*CircularExemplarStorage)
+
+	collect := func(mint int64) []string {
+		var got []string
+		es.seriesWithExemplarAtOrAfter(mint, func(seriesLabels labels.Labels) {
+			got = append(got, seriesLabels.String())
+		})
+		sort.Strings(got)
+		return got
+	}
+
+	require.Empty(t, collect(math.MinInt64), "no exemplars stored yet")
+
+	for _, ts := range []int64{-100, 0, 500, 1000} {
+		require.NoError(t, es.AddExemplar(l, exemplar.Exemplar{Ts: ts, HasTs: true, Value: 1.0}))
+	}
+	require.NoError(t, es.AddExemplar(other, exemplar.Exemplar{Ts: -50, HasTs: true, Value: 1.0}))
+
+	require.Equal(t, []string{l.String()}, collect(1000), "newest exemplar at the cutoff must be kept")
+	require.Equal(t, []string{l.String(), other.String()}, collect(-50), "negative exemplar timestamps are ordinary timestamps")
+	require.Equal(t, []string{l.String()}, collect(500))
+	require.Empty(t, collect(1001), "cutoff past the newest exemplar must release the series")
+}
