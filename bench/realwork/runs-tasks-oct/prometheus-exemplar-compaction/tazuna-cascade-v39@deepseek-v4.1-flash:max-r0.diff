+// TestCompactSelectedSeries_ExemplarAndLateAppendSurvives verifies that the
+// existing protection for samples appended concurrently with the compaction is
+// unaffected by the exemplar-driven retention: the late sample keeps its chunks
+// instead of being released like the persisted ones.
+func TestCompactSelectedSeries_ExemplarAndLateAppendSurvives(t *testing.T) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = 100
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	filler := labels.FromStrings("name", "filler")
+	sel := labels.FromStrings("name", "selected")
+
+	app := db.Appender(context.Background())
+	_, err := app.Append(0, filler, 100, 0.1)
+	require.NoError(t, err)
+	_, err = app.Append(0, filler, 700, 0.7)
+	require.NoError(t, err)
+	selRef, err := app.Append(0, sel, 100, 10.0)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(selRef, sel, exemplar.Exemplar{Ts: 5000, Value: 10.0})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	var hookErr error
+	compactHeadViewBeforeEvictTestingCallback = func() {
+		hookApp := db.Appender(context.Background())
+		if _, err := hookApp.Append(selRef, sel, 400, 40.0); err != nil {
+			hookErr = err
+			return
+		}
+		hookErr = hookApp.Commit()
+	}
+	t.Cleanup(func() { compactHeadViewBeforeEvictTestingCallback = nil })
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selRef}))
+	require.NoError(t, hookErr)
+
+	series := db.Head().series.getByID(chunks.HeadSeriesRef(selRef))
+	require.NotNil(t, series)
+	series.Lock()
+	require.NotNil(t, series.headChunks, "the late sample must keep its chunk")
+	series.Unlock()
+}
