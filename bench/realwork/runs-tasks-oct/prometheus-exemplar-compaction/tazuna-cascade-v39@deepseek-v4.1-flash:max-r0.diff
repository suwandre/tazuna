+// TestDBCompact_ExemplarKeepsSeriesRecord is the DB.Compact counterpart of
+// TestCompactSelectedSeries_ExemplarKeepsSeriesRecord: an ordinary head
+// compaction must not remove a series from the head while the exemplar storage
+// still holds an exemplar at or after the WAL replay cutoff, even though the
+// series has no unpersisted samples left.
+func TestDBCompact_ExemplarKeepsSeriesRecord(t *testing.T) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = 100
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+	dir := db.Dir()
+
+	// sel gets an exemplar with a timestamp well past its last sample; filler
+	// keeps pushing the head forward so that ordinary compactions run and
+	// eventually leave sel with no unpersisted samples.
+	sel := labels.FromStrings("name", "selected")
+	filler := labels.FromStrings("name", "filler")
+
+	app := db.Appender(context.Background())
+	selRef, err := app.Append(0, sel, 100, 1.0)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(selRef, sel, exemplar.Exemplar{Ts: 5000, Value: 1.0})
+	require.NoError(t, err)
+	_, err = app.Append(0, filler, 100, 0.1)
+	require.NoError(t, err)
+	_, err = app.Append(0, filler, 2000, 0.2)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	require.NoError(t, db.Compact(context.Background()))
+	require.NotNil(t, db.Head().series.getByID(chunks.HeadSeriesRef(selRef)),
+		"sel must keep its identity after head compaction")
+
+	selSeries := db.Head().series.getByID(chunks.HeadSeriesRef(selRef))
+	selSeries.Lock()
+	require.Nil(t, selSeries.headChunks)
+	require.Empty(t, selSeries.mmappedChunks)
+	require.Nil(t, selSeries.app)
+	selSeries.Unlock()
+	require.Greater(t, db.Head().MinTime(), int64(100),
+		"the retained, empty series must not hold back the head's minimum time")
+
+	// Advance and compact twice more so the WAL has gone through several
+	// segments and the original series record has aged out.
+	for _, ts := range []int64{3000, 4000} {
+		app = db.Appender(context.Background())
+		_, err = app.Append(0, filler, ts, 0.3)
+		require.NoError(t, err)
+		require.NoError(t, app.Commit())
+		require.NoError(t, db.Compact(context.Background()))
+	}
+	require.NotNil(t, db.Head().series.getByID(chunks.HeadSeriesRef(selRef)))
+
+	// Force a checkpoint past the series' sample but below the exemplar, so the
+	// series record has to be carried forward.
+	forceTestCheckpointAt(t, db, 3500)
+
+	require.NoError(t, db.Close())
+	reopened, err := Open(dir, nil, nil, opts, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, reopened.Close()) })
+
+	requireExemplarSelectable(t, reopened, sel, 5000)
+	require.Zero(t, prom_testutil.ToFloat64(reopened.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")),
+		"WAL replay must not report unknown exemplar references")
+}
