+// TestCompactSelectedSeries_ExemplarOutsideReplayWindow verifies that a series is
+// released once the replay cutoff has moved to or past its exemplar, and that
+// exemplar timestamps of zero and below count as ordinary timestamps as long as
+// they are at or after the cutoff.
+func TestCompactSelectedSeries_ExemplarOutsideReplayWindow(t *testing.T) {
+	t.Run("cutoff past exemplar", func(t *testing.T) {
+		const chunkRange = 1000
+		opts := DefaultOptions()
+		opts.MinBlockDuration = chunkRange
+		opts.MaxBlockDuration = chunkRange
+		opts.EnableExemplarStorage = true
+		opts.MaxExemplars = 100
+		db := newTestDB(t, withOpts(opts))
+		db.DisableCompactions()
+
+		sel := labels.FromStrings("name", "selected")
+		app := db.Appender(context.Background())
+		selRef, err := app.Append(0, sel, 100, 1.0)
+		require.NoError(t, err)
+		_, err = app.AppendExemplar(selRef, sel, exemplar.Exemplar{Ts: 200, Value: 1.0})
+		require.NoError(t, err)
+		require.NoError(t, app.Commit())
+
+		require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selRef}))
+		require.NotNil(t, db.Head().series.getByID(chunks.HeadSeriesRef(selRef)))
+
+		// Move the replay cutoff past the exemplar and evict again.
+		db.head.minValidTime.Store(201)
+		fingerprints := db.head.snapshotFingerprints([]storage.SeriesRef{selRef}, db.head.iso.committedAppendID())
+		require.NoError(t, db.head.truncateSelectedSeries([]storage.SeriesRef{selRef}, math.MaxInt64, fingerprints))
+		require.Nil(t, db.Head().series.getByID(chunks.HeadSeriesRef(selRef)),
+			"the series must be released once the replay cutoff is past its exemplar")
+	})
+
+	for _, tc := range []struct {
+		name string
+		ts   int64
+		mint int64
+	}{
+		{name: "zero timestamp", ts: 0, mint: 0},
+		{name: "negative timestamp", ts: -100, mint: -100},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			const chunkRange = 1000
+			opts := DefaultOptions()
+			opts.MinBlockDuration = chunkRange
+			opts.MaxBlockDuration = chunkRange
+			opts.EnableExemplarStorage = true
+			opts.MaxExemplars = 100
+			db := newTestDB(t, withOpts(opts))
+			db.DisableCompactions()
+			dir := db.Dir()
+
+			sel := labels.FromStrings("name", "selected")
+			app := db.Appender(context.Background())
+			selRef, err := app.Append(0, sel, 100, 1.0)
+			require.NoError(t, err)
+			_, err = app.AppendExemplar(selRef, sel, exemplar.Exemplar{Ts: tc.ts, Value: 1.0})
+			require.NoError(t, err)
+			require.NoError(t, app.Commit())
+
+			require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selRef}))
+			require.NotNil(t, db.Head().series.getByID(chunks.HeadSeriesRef(selRef)),
+				"an exemplar at the replay cutoff must keep the series")
+
+			// Use the exemplar timestamp as the replay cutoff, so the checkpoint
+			// keeps the series record and the exemplar survives a restart.
+			forceTestCheckpointAt(t, db, tc.mint)
+			require.NoError(t, db.Close())
+			reopened, err := Open(dir, nil, nil, opts, nil)
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, reopened.Close()) })
+			requireExemplarSelectable(t, reopened, sel, tc.ts)
+		})
+	}
+}
