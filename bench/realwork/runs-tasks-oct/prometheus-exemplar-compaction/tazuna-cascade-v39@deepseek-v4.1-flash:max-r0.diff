+// seriesWithExemplarAtOrAfter calls f once for every series that has at least
+// one stored exemplar with a timestamp at or after mint. It is used to decide
+// which series must keep their identity in the head so that WAL checkpoints
+// retain their series records. Timestamps at or below zero count like any other.
+func (ce *CircularExemplarStorage) seriesWithExemplarAtOrAfter(mint int64, f func(seriesLabels labels.Labels)) {
+	ce.lock.RLock()
+	defer ce.lock.RUnlock()
+
+	for _, idx := range ce.index {
+		// The exemplars of a series are linked oldest to newest, so the newest
+		// one holds the maximum timestamp.
+		if ce.exemplars[idx.newest].exemplar.Ts >= mint {
+			f(idx.seriesLabels)
+		}
+	}
+}
