+// TestCompactSelectedSeries_ExemplarKeepsSeriesRecord verifies that a series whose
+// samples have been persisted to a block is not removed from the head while the
+// exemplar storage still holds an exemplar at or after the WAL replay cutoff.
+// Removing it would drop its series record from the next WAL checkpoint, so WAL
+// replay could not resolve the exemplar record and would discard the exemplar.
+//
+// The test checks that the series keeps its identity, that its chunks and appender
+// are released and accounted for exactly once, and that the exemplar survives a
+// restart.
+func TestCompactSelectedSeries_ExemplarKeepsSeriesRecord(t *testing.T) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = 100
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+	dir := db.Dir()
+
+	sel := labels.FromStrings("name", "selected")
+	app := db.Appender(context.Background())
+	selRef, err := app.Append(0, sel, 100, 1.0)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(selRef, sel, exemplar.Exemplar{Ts: 5000, Value: 1.0})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	chunksBefore := prom_testutil.ToFloat64(db.head.metrics.chunks)
+	chunksRemovedBefore := prom_testutil.ToFloat64(db.head.metrics.chunksRemoved)
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selRef}))
+	require.Len(t, db.Blocks(), 1)
+
+	// Same in-memory series and ref, but with the persisted chunks and appender released.
+	series := db.Head().series.getByID(chunks.HeadSeriesRef(selRef))
+	require.NotNil(t, series, "the series must keep its identity while its exemplar is in the replay window")
+	series.Lock()
+	require.Nil(t, series.headChunks)
+	require.Empty(t, series.mmappedChunks)
+	require.Nil(t, series.app)
+	series.Unlock()
+	require.Equal(t, uint64(1), db.Head().NumSeries())
+	require.Equal(t, chunksBefore-1, prom_testutil.ToFloat64(db.head.metrics.chunks))
+	require.Equal(t, chunksRemovedBefore+1, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+
+	// Compacting the retained, now empty series again must not write another block
+	// nor count chunks again.
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selRef}))
+	require.Len(t, db.Blocks(), 1)
+	require.Equal(t, chunksBefore-1, prom_testutil.ToFloat64(db.head.metrics.chunks))
+	require.Equal(t, chunksRemovedBefore+1, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+
+	// Force a checkpoint whose mint is below the exemplar timestamp, so the
+	// series record has to be carried forward, then restart and verify the
+	// exemplar was replayed.
+	forceTestCheckpointAt(t, db, 1500)
+
+	require.NoError(t, db.Close())
+	reopened, err := Open(dir, nil, nil, opts, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, reopened.Close()) })
+
+	requireExemplarSelectable(t, reopened, sel, 5000)
+	require.Zero(t, prom_testutil.ToFloat64(reopened.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")),
+		"WAL replay must not report unknown exemplar references")
+
+	// After the restart, WAL replay may have brought back the samples of the
+	// series; a further compaction must release them again without losing the
+	// exemplar across another restart.
+	series = reopened.Head().series.getByHash(sel.Hash(), sel)
+	require.NotNil(t, series)
+	require.NoError(t, reopened.CompactSelectedSeries([]storage.SeriesRef{storage.SeriesRef(series.ref)}))
+	forceTestCheckpointAt(t, reopened, 4000)
+	require.NoError(t, reopened.Close())
+
+	reopenedAgain, err := Open(dir, nil, nil, opts, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, reopenedAgain.Close()) })
+	requireExemplarSelectable(t, reopenedAgain, sel, 5000)
+}
