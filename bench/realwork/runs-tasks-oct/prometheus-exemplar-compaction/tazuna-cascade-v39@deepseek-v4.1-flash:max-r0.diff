+// requireExemplarSelectable asserts that the exemplar query API returns exactly
+// one exemplar with the given timestamp for the series.
+func requireExemplarSelectable(t *testing.T, db *DB, lbls labels.Labels, ts int64) {
+	t.Helper()
+	q, err := db.ExemplarQuerier(context.Background())
+	require.NoError(t, err)
+	res, err := q.Select(math.MinInt64, math.MaxInt64, []*labels.Matcher{
+		labels.MustNewMatcher(labels.MatchEqual, "name", lbls.Get("name")),
+	})
+	require.NoError(t, err)
+	require.Len(t, res, 1, "series %s must still have an exemplar", lbls.String())
+	require.Len(t, res[0].Exemplars, 1)
+	require.Equal(t, ts, res[0].Exemplars[0].Ts)
+}
+
+// forceTestCheckpointAt forces truncateWAL to produce a checkpoint with the given
+// mint, retrying because a checkpoint is only produced once enough WAL segments
+// have accumulated.
+func forceTestCheckpointAt(t *testing.T, db *DB, mint int64) {
+	t.Helper()
+	for range 10 {
+		db.head.lastWALTruncationTime.Store(math.MinInt64)
+		require.NoError(t, db.head.truncateWAL(mint))
+		if _, _, err := wlog.LastCheckpoint(db.head.wal.Dir()); err == nil {
+			return
+		}
+	}
+	t.Fatalf("no checkpoint produced for mint=%d", mint)
+}
