index 10a0745..7909bb4 100644
--- a/tsdb/exemplar_test.go
+++ b/tsdb/exemplar_test.go
@@ -1258,6 +1258,85 @@ func TestCircularExemplarStorage_Concurrent_AddExemplar_Resize(t *testing.T) {
 	}
 }
 
+// TestCircularExemplarStorage_SeriesHashesWithExemplarAtOrAfter verifies the query the head
+// uses to decide which series still need to be kept in memory because WAL replay would restore
+// one of their exemplars.
+func TestCircularExemplarStorage_SeriesHashesWithExemplarAtOrAfter(t *testing.T) {
+	series := labels.FromStrings("service", "asdf")
+	other := labels.FromStrings("service", "qwer")
+
+	newStorage := func(t *testing.T) *CircularExemplarStorage {
+		t.Helper()
+		exs, err := NewCircularExemplarStorage(8, eMetrics, 0)
+		require.NoError(t, err)
+		return exs.(*CircularExemplarStorage)
+	}
+	hasHash := func(hashes map[uint64]struct{}, l labels.Labels) bool {
+		_, ok := hashes[l.Hash()]
+		return ok
+	}
+
+	es := newStorage(t)
+	require.NoError(t, es.AddExemplar(series, exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "a"), Value: 1, Ts: 100}))
+	require.NoError(t, es.AddExemplar(series, exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "b"), Value: 2, Ts: 300}))
+
+	for _, tc := range []struct {
+		name         string
+		cutoff       int64
+		wantSeries   bool
+		wantOther    bool
+		wantNumEntry int
+	}{
+		{name: "newest at cutoff", cutoff: 300, wantSeries: true, wantNumEntry: 1},
+		{name: "cutoff below newest", cutoff: 200, wantSeries: true, wantNumEntry: 1},
+		{name: "cutoff at oldest", cutoff: 100, wantSeries: true, wantNumEntry: 1},
+		{name: "cutoff above newest", cutoff: 301, wantNumEntry: 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			hashes := es.SeriesHashesWithExemplarAtOrAfter(tc.cutoff)
+			require.Len(t, hashes, tc.wantNumEntry)
+			require.Equal(t, tc.wantSeries, hasHash(hashes, series))
+			require.Equal(t, tc.wantOther, hasHash(hashes, other))
+		})
+	}
+
+	// Zero and negative timestamps are real timestamps, not "no exemplar" sentinels.
+	for _, tc := range []struct {
+		name   string
+		ts     int64
+		cutoff int64
+		want   bool
+	}{
+		{name: "zero ts at zero cutoff", ts: 0, cutoff: 0, want: true},
+		{name: "zero ts below cutoff", ts: 0, cutoff: 1, want: false},
+		{name: "negative ts at equal cutoff", ts: -5, cutoff: -5, want: true},
+		{name: "negative ts below cutoff", ts: -5, cutoff: -4, want: false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			es := newStorage(t)
+			require.NoError(t, es.AddExemplar(series, exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "a"), Value: 1, Ts: tc.ts}))
+			require.Equal(t, tc.want, hasHash(es.SeriesHashesWithExemplarAtOrAfter(tc.cutoff), series))
+		})
+	}
+
+	t.Run("each series reported separately", func(t *testing.T) {
+		es := newStorage(t)
+		require.NoError(t, es.AddExemplar(series, exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "a"), Value: 1, Ts: 100}))
+		require.NoError(t, es.AddExemplar(other, exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "b"), Value: 2, Ts: 500}))
+
+		hashes := es.SeriesHashesWithExemplarAtOrAfter(200)
+		require.Len(t, hashes, 1)
+		require.True(t, hasHash(hashes, other))
+		require.False(t, hasHash(hashes, series))
+	})
+
+	t.Run("empty storage", func(t *testing.T) {
+		es, err := NewCircularExemplarStorage(0, eMetrics, 0)
+		require.NoError(t, err)
+		require.Empty(t, es.SeriesHashesWithExemplarAtOrAfter(math.MinInt64))
+	})
+}
+
