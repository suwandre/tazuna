+		// The series' persisted chunks can be released, but if it still has an exemplar that
+		// WAL replay would restore, keep its identity so that the next WAL checkpoint retains
+		// its series record. Keeping the identity must not keep the samples in memory.
+		if _, ok := keep[series.lset.Hash()]; ok {
+			removed, wasMmapReady := series.releaseChunks()
+			rmChunks += removed
+			if wasMmapReady {
+				s.decMmapReady(series.ref)
+			}
+			return
+		}
+
 		headChunkCount := series.headChunkCount.Load()
 		rmChunks += int(headChunkCount)
 		rmChunks += len(series.mmappedChunks)
@@ -3147,6 +3200,22 @@ func (s *memSeries) setHeadChunks(head *memChunk, count uint32) {
 	s.headChunkCount.Store(count)
 }
 
+// releaseChunks drops every in-order chunk and the appender while leaving the series'
+// identity intact. It returns the number of chunks released and whether the series was
+// mmap-ready before the call, so the caller can keep the stripe bookkeeping in sync. Chunk
+// IDs keep advancing, as in truncateChunksBefore, so IDs still held by readers cannot alias
+// chunks created later. The series lock must be held.
+func (s *memSeries) releaseChunks() (removed int, wasMmapReady bool) {
+	headChunkCount := int(s.headChunkCount.Load())
+	wasMmapReady = headChunkCount >= 2
+	removed = headChunkCount + len(s.mmappedChunks)
+	s.firstChunkID = wrapChunkID(s.firstChunkID + chunks.HeadChunkID(removed))
+	s.mmappedChunks = nil
+	s.setHeadChunks(nil, 0)
+	s.app = nil
+	return removed, wasMmapReady
+}
+
 // truncateChunksBefore removes all chunks from the series that
 // have no timestamp at or after mint.
 // Chunk IDs remain unchanged.
diff --git a/tsdb/head_test.go b/tsdb/head_test.go
index ba80c35..b976445 100644
--- a/tsdb/head_test.go
