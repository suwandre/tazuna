+// seriesHashesWithExemplarInReplayRange snapshots the label-set hashes of the head's series
+// that have an exemplar at or after the head's minimum valid time. Such an exemplar can still
+// be replayed from the WAL after a restart, so those series must keep their identity in the
+// head: otherwise the WAL checkpoint drops their series record and replay cannot resolve the
+// exemplar's series reference anymore.
+//
+// The snapshot is taken up front, before the GC walk takes any stripe lock. The exemplar
+// storage lock must not be acquired while a stripe lock is held, because chunk snapshotting
+// takes them in the opposite order (exemplar storage, then stripes).
+func (h *Head) seriesHashesWithExemplarInReplayRange() map[uint64]struct{} {
+	if h.exemplars == nil || h.minValidTime.Load() == math.MaxInt64 {
+		return nil
+	}
+	return h.exemplars.SeriesHashesWithExemplarAtOrAfter(h.minValidTime.Load())
+}
