+// TestHeadCompaction_ExemplarSurvivesRestart covers the three ways the head drops series after
+// persisting their samples: ordinary head compaction (DB.Compact), selected-series compaction
+// (DB.CompactSelectedSeries) and stale-series compaction (DB.CompactStaleHead). In all cases a
+// series that still has an exemplar at or after the WAL replay cutoff must keep its identity so
+// that the WAL checkpoint retains its series record, letting replay resolve the exemplar after a
+// restart. The exemplar record is deliberately placed in a WAL segment newer than the checkpoint
+// so that replay, not the checkpoint, restores it.
+func TestHeadCompaction_ExemplarSurvivesRestart(t *testing.T) {
+	const chunkRange = 1000
+	// The exemplar is far newer than the persisted samples, as happens when a target stops
+	// exposing a sample but still ingests exemplars. It must outlive every checkpoint forced below.
+	const exemplarTs = 300000
+
+	for _, tc := range []struct {
+		name    string
+		stale   bool
+		compact func(*DB, storage.SeriesRef) error
+	}{
+		{
+			name: "db compact",
+			compact: func(db *DB, _ storage.SeriesRef) error {
+				return db.Compact(context.Background())
+			},
+		},
+		{
+			name: "selected series",
+			compact: func(db *DB, ref storage.SeriesRef) error {
+				return db.CompactSelectedSeries([]storage.SeriesRef{ref})
+			},
+		},
+		{
+			name:  "stale series",
+			stale: true,
+			compact: func(db *DB, _ storage.SeriesRef) error {
+				return db.CompactStaleHead()
+			},
+		},
+	} {
+		// Exercise both ways an exemplar can come back after a restart: its record in the WAL,
+		// and the in-memory chunk snapshot written on shutdown.
+		for _, memorySnapshot := range []bool{false, true} {
+			name := tc.name
+			if memorySnapshot {
+				name += " with memory snapshot"
+			}
+			t.Run(name, func(t *testing.T) {
+				opts := DefaultOptions()
+				opts.MinBlockDuration = chunkRange
+				opts.MaxBlockDuration = chunkRange
+				opts.EnableExemplarStorage = true
+				opts.MaxExemplars = 100
+				opts.EnableMemorySnapshotOnShutdown = memorySnapshot
+				db := newTestDB(t, withOpts(opts))
+				db.DisableCompactions()
+
+				sel := labels.FromStrings("name", "selected")
+				app := db.Appender(context.Background())
+				selRef, err := app.Append(0, sel, 100, 1.0)
+				require.NoError(t, err)
+				if tc.stale {
+					_, err = app.Append(selRef, sel, 200, math.Float64frombits(value.StaleNaN))
+					require.NoError(t, err)
+				}
+				// A filler series keeps the head compactable for DB.Compact and pins the head's
+				// maximum time used as the eviction maxt for selected/stale compaction.
+				_, err = app.Append(0, labels.FromStrings("name", "filler"), 100, 1.0)
+				require.NoError(t, err)
+				_, err = app.Append(0, labels.FromStrings("name", "filler"), 5000, 1.0)
+				require.NoError(t, err)
+				require.NoError(t, app.Commit())
+
+				// Roll the WAL well past the segment that declared sel, so the checkpoint below
+				// covers sel's series and sample records but not the exemplar's segment.
+				for range 30 {
+					_, err := db.head.wal.NextSegment()
+					require.NoError(t, err)
+				}
+
+				app = db.Appender(context.Background())
+				_, err = app.AppendExemplar(selRef, sel, exemplar.Exemplar{
+					Labels: labels.FromStrings("trace_id", "abc"),
+					Value:  1,
+					HasTs:  true,
+					Ts:     exemplarTs,
+				})
+				require.NoError(t, err)
+				require.NoError(t, app.Commit())
+
+				require.NoError(t, tc.compact(db, selRef))
+
+				// With the fix sel keeps its identity in the head, so checkpoints keep its series
+				// record even though its samples are in a block.
+				require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(selRef)))
+
+				forceCheckpointAt := func(mint int64) {
+					t.Helper()
+					_, lastIdx, err := wlog.LastCheckpoint(db.head.wal.Dir())
+					if errors.Is(err, record.ErrNotFound) {
+						lastIdx = -1
+					} else {
+						require.NoError(t, err)
+					}
+					for range 10 {
+						db.head.lastWALTruncationTime.Store(0)
+						require.NoError(t, db.head.truncateWAL(mint))
+						if _, idx, err := wlog.LastCheckpoint(db.head.wal.Dir()); err == nil && idx > lastIdx {
+							return
+						}
+					}
+					t.Fatalf("no new checkpoint produced for mint=%d", mint)
+				}
+				// The mint is past the eviction maxt (head.MaxTime()=5000) so that, without the
+				// fix, sel's series record would be dropped, while the exemplar stays within the
+				// replay range.
+				forceCheckpointAt(5001)
+
+				require.NoError(t, db.Close())
+				reopened, err := Open(db.Dir(), nil, nil, opts, nil)
+				require.NoError(t, err)
+				t.Cleanup(func() { require.NoError(t, reopened.Close()) })
+				assertExemplarPresent := func(db *DB) {
+					t.Helper()
+					unknownExemplars := prom_testutil.ToFloat64(
+						db.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars"))
+					require.Zero(t, unknownExemplars,
+						"replay must not report unknown series references for sel's exemplar")
+
+					q, err := db.ExemplarQuerier(context.Background())
+					require.NoError(t, err)
+					res, err := q.Select(0, exemplarTs+1,
+						[]*labels.Matcher{labels.MustNewMatcher(labels.MatchEqual, "name", "selected")})
+					require.NoError(t, err)
+					require.Len(t, res, 1, "the exemplar must survive the restart")
+					require.Len(t, res[0].Exemplars, 1)
+					require.Equal(t, int64(exemplarTs), res[0].Exemplars[0].Ts)
+				}
+				assertExemplarPresent(reopened)
+
+				// Compact and restart once more: the replayed or snapshot-restored exemplar must
+				// still protect the series.
+				replayed := reopened.head.series.getByHash(sel.Hash(), sel)
+				require.NotNil(t, replayed, "the replayed series must keep its identity")
+				require.NoError(t, tc.compact(reopened, storage.SeriesRef(replayed.ref)))
+
+				require.NoError(t, reopened.Close())
+				reopenedAgain, err := Open(db.Dir(), nil, nil, opts, nil)
+				require.NoError(t, err)
+				t.Cleanup(func() { require.NoError(t, reopenedAgain.Close()) })
+				assertExemplarPresent(reopenedAgain)
+			})
+		}
+	}
+}
+
+// TestCompactSelectedSeries_ReplayedSamplesReleasedAgainOnLaterCompaction covers the other
+// side of retaining a series for an exemplar after selected-series compaction: on restart, the
+// WAL may still hold the series' sample records, so replay recreates the chunks that were
+// already persisted to a block. A later compaction must release those chunks again while
+// keeping the series identity the exemplar needs.
+func TestCompactSelectedSeries_ReplayedSamplesReleasedAgainOnLaterCompaction(t *testing.T) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = 100
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	sel := labels.FromStrings("name", "selected")
+	app := db.Appender(context.Background())
+	// A filler series keeps head.MaxTime(), and with it the selected-series eviction maxt,
+	// far above the selected sample.
+	_, err := app.Append(0, labels.FromStrings("name", "filler"), 100, 1.0)
+	require.NoError(t, err)
+	selRef, err := app.Append(0, sel, 1200, 1.0)
+	require.NoError(t, err)
+	_, err = app.Append(0, labels.FromStrings("name", "filler"), 5000, 1.0)
+	require.NoError(t, err)
+	const exemplarTs = int64(300000)
+	_, err = app.AppendExemplar(selRef, sel, exemplar.Exemplar{
+		Labels: labels.FromStrings("trace_id", "abc"),
+		Value:  1,
+		HasTs:  true,
+		Ts:     exemplarTs,
+	})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selRef}))
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(selRef)))
+
+	require.NoError(t, db.Close())
+	reopened, err := Open(db.Dir(), nil, nil, opts, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, reopened.Close()) })
+
+	// The sample record was still within the replay range, so replay recreated the chunk even
+	// though it is already in a block.
+	ms := reopened.head.series.getByID(chunks.HeadSeriesRef(selRef))
+	require.NotNil(t, ms, "the replayed series must keep its identity")
+	ms.Lock()
+	require.NotZero(t, len(ms.mmappedChunks)+int(ms.headChunkCount.Load()),
+		"WAL replay is expected to bring the persisted sample back")
+	ms.Unlock()
+
+	require.NoError(t, reopened.CompactSelectedSeries([]storage.SeriesRef{selRef}))
+
+	ms = reopened.head.series.getByID(chunks.HeadSeriesRef(selRef))
+	require.NotNil(t, ms, "the exemplar still protects the series")
+	ms.Lock()
+	require.Nil(t, ms.headChunks)
+	require.Empty(t, ms.mmappedChunks)
+	require.Nil(t, ms.app)
+	ms.Unlock()
+
+	q, err := reopened.ExemplarQuerier(context.Background())
+	require.NoError(t, err)
+	res, err := q.Select(0, exemplarTs+1,
+		[]*labels.Matcher{labels.MustNewMatcher(labels.MatchEqual, "name", "selected")})
+	require.NoError(t, err)
+	require.Len(t, res, 1)
+	require.Len(t, res[0].Exemplars, 1)
+	require.Equal(t, exemplarTs, res[0].Exemplars[0].Ts)
+}
+
 // TestCompactSelectedSeries_OOOAppendDuringCompactionSurvives verifies that a series is not
 // evicted when an out-of-order sample transitions it from s.ooo == nil to non-nil during
 // compaction.
diff --git a/tsdb/exemplar.go b/tsdb/exemplar.go
index 36b0a7e..a3b07c9 100644
--- a/tsdb/exemplar.go
+++ b/tsdb/exemplar.go
@@ -215,6 +215,32 @@ Outer:
 	return false
 }
 
+// SeriesHashesWithExemplarAtOrAfter returns the label-set hashes of every series that has an
+// exemplar with a timestamp at or after cutoff. Zero and negative timestamps count like any
+// other timestamp.
+//
+// Callers use this to decide, before taking any other lock, which series must keep their
+// identity for WAL replay to resolve those exemplars. The result is keyed by hash to keep the
+// lookup cheap; a hash collision can only cause a series without such an exemplar to be
+// retained too, which delays its removal but stays correct.
+func (ce *CircularExemplarStorage) SeriesHashesWithExemplarAtOrAfter(cutoff int64) map[uint64]struct{} {
+	ce.lock.RLock()
+	defer ce.lock.RUnlock()
+
+	if len(ce.index) == 0 {
+		return nil
+	}
+	hashes := make(map[uint64]struct{}, len(ce.index))
+	for _, idx := range ce.index {
+		// Each series' exemplars are kept ordered by timestamp, so the newest entry holds the
+		// highest timestamp.
+		if ce.exemplars[idx.newest].exemplar.Ts >= cutoff {
+			hashes[idx.seriesLabels.Hash()] = struct{}{}
+		}
+	}
+	return hashes
+}
+
 func (ce *CircularExemplarStorage) ValidateExemplar(l labels.Labels, e exemplar.Exemplar) error {
 	var buf [1024]byte
 	seriesLabels := l.Bytes(buf[:])
