+// TestHeadGC_KeepsSeriesWithExemplarInReplayRange verifies that head GC retains the identity
+// (same memSeries and ref) of a series whose samples were persisted but which still has an
+// exemplar at or after the head's minimum valid time. Such an exemplar can still be replayed
+// from the WAL, so the WAL checkpoint must retain the series record. The persisted chunks and
+// the appender are released, the empty series does not hold back the head's minimum time, and
+// once the cutoff moves past the exemplar the series is deleted as before.
+func TestHeadGC_KeepsSeriesWithExemplarInReplayRange(t *testing.T) {
+	head, _ := newTestHead(t, 1000, compression.None, false)
+	require.NoError(t, head.Init(0))
+
+	lset := labels.FromStrings("foo", "bar")
+	app := head.Appender(context.Background())
+	ref, err := app.Append(0, lset, 100, 1)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, lset, exemplar.Exemplar{
+		Labels: labels.FromStrings("trace_id", "abc"),
+		Value:  1,
+		HasTs:  true,
+		Ts:     1500,
+	})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(head.metrics.chunks))
+
+	// Persisting the sample advances the cutoff to 200; the exemplar at 1500 is still in the
+	// replay range, so the series must survive.
+	require.NoError(t, head.Truncate(200))
+
+	ms := head.series.getByID(chunks.HeadSeriesRef(ref))
+	require.NotNil(t, ms, "series with an exemplar in the replay range must keep its identity")
+	require.Equal(t, ref, storage.SeriesRef(ms.ref))
+	ms.Lock()
+	require.Nil(t, ms.headChunks)
+	require.Empty(t, ms.mmappedChunks)
+	require.Nil(t, ms.app)
+	ms.Unlock()
+	require.Equal(t, uint64(1), head.NumSeries())
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(head.metrics.chunks))
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(head.metrics.chunksRemoved))
+
+	// The empty retained series must not hold the head's minimum time back.
+	require.NoError(t, head.Truncate(300))
+	require.Equal(t, int64(300), head.MinTime())
+	require.NotNil(t, head.series.getByID(chunks.HeadSeriesRef(ref)))
+
+	// A new sample must be able to reuse the retained series identity.
+	app = head.Appender(context.Background())
+	ref2, err := app.Append(ref, lset, 400, 2)
+	require.NoError(t, err)
+	require.Equal(t, ref, ref2)
+	require.NoError(t, app.Commit())
+
+	// Once the cutoff moves past the exemplar, the series is dropped like any other.
+	require.NoError(t, head.Truncate(2000))
+	require.Nil(t, head.series.getByID(chunks.HeadSeriesRef(ref)))
+	require.Equal(t, uint64(0), head.NumSeries())
+}
+
+// TestHeadCompaction_KeepsSeriesWithExemplarInReplayRange covers the head-side eviction used
+// by CompactSelectedSeries and CompactStaleHead: a series with an exemplar in the replay range
+// keeps its identity, but its head and mmapped chunks and its appender are released exactly
+// once, and compacting the now-empty series again releases no further chunks.
+func TestHeadCompaction_KeepsSeriesWithExemplarInReplayRange(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		stale      bool
+		appenderV2 bool
+	}{
+		{name: "selected series"},
+		{name: "stale series", stale: true},
+		{name: "selected series, AppenderV2", appenderV2: true},
+		{name: "stale series, AppenderV2", stale: true, appenderV2: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			head, _ := newTestHead(t, 1000, compression.None, false)
+			require.NoError(t, head.Init(0))
+
+			lset := labels.FromStrings("foo", "bar")
+			lastValue := 4.0
+			if tc.stale {
+				lastValue = math.Float64frombits(value.StaleNaN)
+			}
+			ex := exemplar.Exemplar{
+				Labels: labels.FromStrings("trace_id", "abc"),
+				Value:  1,
+				HasTs:  true,
+				Ts:     5000,
+			}
+
+			var ref storage.SeriesRef
+			if tc.appenderV2 {
+				app := head.AppenderV2(context.Background())
+				var err error
+				for i, ts := range []int64{100, 1200, 2300, 3400} {
+					v := float64(i + 1)
+					if i == 3 {
+						v = lastValue
+					}
+					opts := storage.AOptions{}
+					if i == 0 {
+						// AppenderV2 ingests exemplars alongside a sample of the series. It
+						// does not attempt them for a stale sample, so attach them to the
+						// first one instead.
+						opts.Exemplars = []exemplar.Exemplar{ex}
+					}
+					ref, err = app.Append(ref, lset, 0, ts, v, nil, nil, opts)
+					require.NoError(t, err)
+				}
+				require.NoError(t, app.Commit())
+			} else {
+				app := head.Appender(context.Background())
+				var err error
+				for i, ts := range []int64{100, 1200, 2300, 3400} {
+					v := float64(i + 1)
+					if i == 3 {
+						v = lastValue
+					}
+					ref, err = app.Append(ref, lset, ts, v)
+					require.NoError(t, err)
+				}
+				_, err = app.AppendExemplar(ref, lset, ex)
+				require.NoError(t, err)
+				require.NoError(t, app.Commit())
+			}
+
+			// Move the older chunks to disk, leaving one head chunk.
+			head.mmapHeadChunks()
+			ms := head.series.getByID(chunks.HeadSeriesRef(ref))
+			require.NotNil(t, ms)
+			ms.Lock()
+			require.NotEmpty(t, ms.mmappedChunks)
+			require.NotNil(t, ms.headChunks)
+			require.NotNil(t, ms.app)
+			expectedChunks := len(ms.mmappedChunks) + int(ms.headChunkCount.Load())
+			ms.Unlock()
+			require.Greater(t, expectedChunks, 1)
+			require.Equal(t, float64(expectedChunks), prom_testutil.ToFloat64(head.metrics.chunks))
+
+			truncate := func() {
+				t.Helper()
+				refs := []storage.SeriesRef{ref}
+				fingerprints := head.snapshotFingerprints(refs, math.MaxUint64)
+				if tc.stale {
+					require.NoError(t, head.truncateStaleSeries(refs, 3500, fingerprints))
+				} else {
+					require.NoError(t, head.truncateSelectedSeries(refs, 3500, fingerprints))
+				}
+			}
+
+			truncate()
+
+			require.Same(t, ms, head.series.getByID(chunks.HeadSeriesRef(ref)),
+				"series with an exemplar in the replay range must keep its identity")
+			ms.Lock()
+			require.Nil(t, ms.headChunks)
+			require.Empty(t, ms.mmappedChunks)
+			require.Nil(t, ms.app)
+			ms.Unlock()
+			require.Equal(t, 0.0, prom_testutil.ToFloat64(head.metrics.chunks))
+			require.Equal(t, float64(expectedChunks), prom_testutil.ToFloat64(head.metrics.chunksRemoved))
+
+			// Compacting the now-empty retained series again must not release chunks again.
+			truncate()
+			require.Same(t, ms, head.series.getByID(chunks.HeadSeriesRef(ref)))
+			require.Equal(t, 0.0, prom_testutil.ToFloat64(head.metrics.chunks))
+			require.Equal(t, float64(expectedChunks), prom_testutil.ToFloat64(head.metrics.chunksRemoved))
+		})
+	}
+}
+
