+// TestExemplarRetention_ZeroAndNegativeTimestamps verifies that zero and
+// negative exemplar timestamps count as real timestamps when deciding whether
+// a series must be kept for WAL replay.
+func TestExemplarRetention_ZeroAndNegativeTimestamps(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		sampleTs   int64
+		exemplarTs int64
+		keepCutoff int64
+		dropCutoff int64
+	}{
+		{name: "zero", sampleTs: -100, exemplarTs: 0, keepCutoff: -1, dropCutoff: 1},
+		{name: "negative", sampleTs: -150, exemplarTs: -50, keepCutoff: -51, dropCutoff: -49},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			opts := DefaultOptions()
+			opts.MinBlockDuration = 1000
+			opts.MaxBlockDuration = 1000
+			opts.EnableExemplarStorage = true
+			opts.MaxExemplars = 100
+			db := newTestDB(t, withOpts(opts))
+			db.DisableCompactions()
+
+			sel := labels.FromStrings("name", "series")
+			app := db.Appender(context.Background())
+			ref, err := app.Append(0, sel, tc.sampleTs, 1)
+			require.NoError(t, err)
+			_, err = app.AppendExemplar(ref, sel, exemplar.Exemplar{Ts: tc.exemplarTs, Value: 2})
+			require.NoError(t, err)
+			require.NoError(t, app.Commit())
+
+			require.NoError(t, db.Head().Truncate(tc.keepCutoff))
+			ms := db.head.series.getByID(chunks.HeadSeriesRef(ref))
+			require.NotNilf(t, ms, "an exemplar at %d must keep its series past cutoff %d", tc.exemplarTs, tc.keepCutoff)
+			require.Nil(t, ms.headChunks)
+
+			require.NoError(t, db.Head().Truncate(tc.dropCutoff))
+			require.Nilf(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)),
+				"an exemplar at %d must not survive cutoff %d", tc.exemplarTs, tc.dropCutoff)
+		})
+	}
+}
+
+// TestExemplarRetention_ReplayedSamplesReleasedAgain verifies that, after a
+// selected-series compaction and a restart without a WAL checkpoint, replay
+// may bring back samples whose records are still in the replay range; a later
+// compaction releases them again while the exemplar keeps the series identity.
+func TestExemplarRetention_ReplayedSamplesReleasedAgain(t *testing.T) {
+	opts := DefaultOptions()
+	opts.MinBlockDuration = 1000
+	opts.MaxBlockDuration = 1000
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = 100
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	sel := labels.FromStrings("name", "selected")
+	app := db.Appender(context.Background())
+	ref, err := app.Append(0, sel, 100, 1)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, sel, exemplar.Exemplar{Ts: 2500, Value: 2})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Len(t, db.Blocks(), 1)
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(db.head.metrics.chunks))
+
+	// Restart without a checkpoint: WAL replay restores the sample because its
+	// records are still in the replay range.
+	require.NoError(t, db.Close())
+	reopened, err := Open(db.Dir(), nil, nil, opts, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, reopened.Close()) })
+
+	ms := reopened.head.series.getByID(chunks.HeadSeriesRef(ref))
+	require.NotNil(t, ms)
+	require.NotNil(t, ms.headChunks, "WAL replay restores the persisted sample in the head")
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(reopened.head.metrics.chunks))
+
+	// Compacting again releases the replayed chunk while the exemplar keeps
+	// the series identity.
+	require.NoError(t, reopened.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	ms = reopened.head.series.getByID(chunks.HeadSeriesRef(ref))
+	require.NotNil(t, ms)
+	require.Nil(t, ms.headChunks)
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(reopened.head.metrics.chunks))
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(reopened.head.metrics.chunksRemoved))
+	require.Len(t, reopened.Blocks(), 2, "the replayed sample is persisted again before being released")
+}
+
+// TestExemplarRetention_MemorySnapshotRestart verifies that a retained empty
+// series and its exemplar survive a restart through the on-shutdown memory
+// snapshot, and that a further compaction plus restart does not lose them.
+func TestExemplarRetention_MemorySnapshotRestart(t *testing.T) {
+	opts := DefaultOptions()
+	opts.MinBlockDuration = 1000
+	opts.MaxBlockDuration = 1000
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = 100
+	opts.EnableMemorySnapshotOnShutdown = true
+	dir := t.TempDir()
+	db := newTestDB(t, withOpts(opts), withDir(dir))
+	db.DisableCompactions()
+
+	sel := labels.FromStrings("name", "selected")
+	app := db.Appender(context.Background())
+	ref, err := app.Append(0, sel, 100, 1)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, sel, exemplar.Exemplar{Ts: 2500, Value: 2})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+	require.NoError(t, db.Close())
+
+	reopened, err := Open(dir, nil, nil, opts, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, reopened.Close()) })
+
+	require.NotNil(t, reopened.head.series.getByID(chunks.HeadSeriesRef(ref)),
+		"the retained series must be restored from the memory snapshot")
+	res := exemplarResultsFor(t, reopened, labels.MustNewMatcher(labels.MatchEqual, "name", "selected"))
+	require.Len(t, res, 1, "the exemplar must be restored from the memory snapshot")
+	require.Len(t, res[0].Exemplars, 1)
+
+	// A further compaction plus restart must not lose the exemplar either.
+	require.NoError(t, reopened.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.NoError(t, reopened.Close())
+
+	again, err := Open(dir, nil, nil, opts, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, again.Close()) })
+
+	require.NotNil(t, again.head.series.getByID(chunks.HeadSeriesRef(ref)))
+	res = exemplarResultsFor(t, again, labels.MustNewMatcher(labels.MatchEqual, "name", "selected"))
+	require.Len(t, res, 1)
+	require.Len(t, res[0].Exemplars, 1)
+}
