+// TestExemplarRetention_HeadCompaction exercises the ordinary head compaction
+// path (DB.Compact): the series' only sample is persisted into a block and its
+// chunks are dropped, but the series identity is retained because its exemplar
+// is still within the replay range, so the exemplar survives a restart.
+func TestExemplarRetention_HeadCompaction(t *testing.T) {
+	opts := DefaultOptions()
+	opts.MinBlockDuration = 1000
+	opts.MaxBlockDuration = 1000
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = 100
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	sel := labels.FromStrings("name", "with-exemplar")
+	filler := labels.FromStrings("name", "filler")
+	app := db.Appender(context.Background())
+	selRef, err := app.Append(0, sel, 100, 1)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(selRef, sel, exemplar.Exemplar{Ts: 2500, Value: 2})
+	require.NoError(t, err)
+	_, err = app.Append(0, filler, 0, 1)
+	require.NoError(t, err)
+	_, err = app.Append(0, filler, 2000, 1)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	// The filler series makes the head compactable; the compaction covers
+	// [0, 1000) and persists sel's sample at 100.
+	require.NoError(t, db.Compact(context.Background()))
+	require.Len(t, db.Blocks(), 1)
+
+	ms := db.head.series.getByID(chunks.HeadSeriesRef(selRef))
+	require.NotNil(t, ms, "series must keep its identity while its exemplar can be replayed")
+	require.Nil(t, ms.headChunks)
+	require.Empty(t, ms.mmappedChunks)
+
+	require.NoError(t, db.Close())
+	reopened, err := Open(db.Dir(), nil, nil, opts, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, reopened.Close()) })
+
+	require.Zero(t, prom_testutil.ToFloat64(reopened.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")),
+		"the replayed exemplar must resolve to its retained series record")
+	res := exemplarResultsFor(t, reopened, labels.MustNewMatcher(labels.MatchEqual, "name", "with-exemplar"))
+	require.Len(t, res, 1)
+	require.Len(t, res[0].Exemplars, 1)
+	require.Equal(t, 2.0, res[0].Exemplars[0].Value)
+}
+
+// TestExemplarRetention_CompactSelectedSeries verifies that selected-series
+// compaction retains the identity of a series whose exemplar is still
+// replayable, releases its persisted chunks exactly once, and that the WAL
+// checkpoint and a restart preserve the exemplar. Both appender APIs are
+// exercised.
+func TestExemplarRetention_CompactSelectedSeries(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		append func(t *testing.T, db *DB, lset labels.Labels) storage.SeriesRef
+	}{
+		{
+			name: "Appender",
+			append: func(t *testing.T, db *DB, lset labels.Labels) storage.SeriesRef {
+				app := db.Appender(context.Background())
+				ref, err := app.Append(0, lset, 100, 1)
+				require.NoError(t, err)
+				_, err = app.AppendExemplar(ref, lset, exemplar.Exemplar{Ts: 2500, Value: 2})
+				require.NoError(t, err)
+				require.NoError(t, app.Commit())
+				return ref
+			},
+		},
+		{
+			name: "AppenderV2",
+			append: func(t *testing.T, db *DB, lset labels.Labels) storage.SeriesRef {
+				app := db.AppenderV2(context.Background())
+				ref, err := app.Append(0, lset, 0, 100, 1, nil, nil, storage.AOptions{
+					Exemplars: []exemplar.Exemplar{{Ts: 2500, Value: 2}},
+				})
+				require.NoError(t, err)
+				require.NoError(t, app.Commit())
+				return ref
+			},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			opts := DefaultOptions()
+			opts.MinBlockDuration = 1000
+			opts.MaxBlockDuration = 1000
+			opts.EnableExemplarStorage = true
+			opts.MaxExemplars = 100
+			db := newTestDB(t, withOpts(opts))
+			db.DisableCompactions()
+
+			sel := labels.FromStrings("name", "selected")
+			ref := tc.append(t, db, sel)
+
+			require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+
+			require.Equal(t, uint64(1), db.Head().NumSeries(), "the series identity must be kept for its exemplar")
+			ms := db.head.series.getByID(chunks.HeadSeriesRef(ref))
+			require.NotNil(t, ms)
+			require.Nil(t, ms.headChunks)
+			require.Empty(t, ms.mmappedChunks)
+			require.Nil(t, ms.app)
+			require.Equal(t, 0.0, prom_testutil.ToFloat64(db.head.metrics.chunks))
+			require.Equal(t, 1.0, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+			require.Len(t, db.Blocks(), 1)
+
+			// Re-compacting the retained, now empty series must neither write
+			// another block nor count chunks again.
+			require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+			require.Len(t, db.Blocks(), 1)
+			require.Equal(t, 1.0, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+
+			// The series record must be kept in WAL checkpoints while the
+			// exemplar can be replayed.
+			forceTestCheckpointAt(t, db, 2000)
+			require.True(t, checkpointContainsSeries(t, db, ref))
+
+			require.NoError(t, db.Close())
+			reopened, err := Open(db.Dir(), nil, nil, opts, nil)
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, reopened.Close()) })
+
+			require.Zero(t, prom_testutil.ToFloat64(reopened.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")))
+			res := exemplarResultsFor(t, reopened, labels.MustNewMatcher(labels.MatchEqual, "name", "selected"))
+			require.Len(t, res, 1)
+			require.Len(t, res[0].Exemplars, 1)
+		})
+	}
+}
