+// exemplarResultsFor runs an exemplar query for the given matcher.
+func exemplarResultsFor(t *testing.T, db *DB, matcher *labels.Matcher) []exemplar.QueryResult {
+	t.Helper()
+	q, err := db.ExemplarQuerier(context.Background())
+	require.NoError(t, err)
+	res, err := q.Select(0, math.MaxInt64, []*labels.Matcher{matcher})
+	require.NoError(t, err)
+	return res
+}
