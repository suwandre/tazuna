+// forceTestCheckpointAt repeatedly retries truncateWAL with the given mint,
+// resetting lastWALTruncationTime each time, until it produces a checkpoint
+// newer than any already on disk. Every call rolls to a new WAL segment, so
+// the loop succeeds once enough segments have accumulated.
+func forceTestCheckpointAt(t *testing.T, db *DB, mint int64) {
+	t.Helper()
+	_, lastIdx, err := wlog.LastCheckpoint(db.head.wal.Dir())
+	if errors.Is(err, record.ErrNotFound) {
+		lastIdx = -1
+	} else {
+		require.NoError(t, err)
+	}
+	for range 10 {
+		db.head.lastWALTruncationTime.Store(0)
+		require.NoError(t, db.head.truncateWAL(mint))
+		if _, idx, err := wlog.LastCheckpoint(db.head.wal.Dir()); err == nil && idx > lastIdx {
+			return
+		}
+	}
+	t.Fatalf("no new checkpoint produced for mint=%d", mint)
+}
+
+// checkpointContainsSeries reports whether the newest WAL checkpoint contains
+// a series record for ref.
+func checkpointContainsSeries(t *testing.T, db *DB, ref storage.SeriesRef) bool {
+	t.Helper()
+	checkpointDir, _, err := wlog.LastCheckpoint(db.head.wal.Dir())
+	require.NoError(t, err)
+	for _, rec := range readTestWAL(t, checkpointDir) {
+		seriesRecs, ok := rec.([]record.RefSeries)
+		if !ok {
+			continue
+		}
+		for _, s := range seriesRecs {
+			if storage.SeriesRef(s.Ref) == ref {
+				return true
+			}
+		}
+	}
+	return false
+}
