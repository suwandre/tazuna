+// TestExemplarRetention_HeadTruncateKeepsSeriesRecord verifies that ordinary
+// head GC (as run by Head.Truncate and by head compaction) keeps a series that
+// would otherwise be drained: its exemplar is still at or after the WAL replay
+// cutoff, so its series record must stay available for WAL replay. Once the
+// cutoff moves past the exemplar, the series is removed as before.
+func TestExemplarRetention_HeadTruncateKeepsSeriesRecord(t *testing.T) {
+	opts := DefaultOptions()
+	opts.MinBlockDuration = 1000
+	opts.MaxBlockDuration = 1000
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = 100
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	sel := labels.FromStrings("name", "with-exemplar")
+	app := db.Appender(context.Background())
+	ref, err := app.Append(0, sel, 100, 1)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, sel, exemplar.Exemplar{Ts: 2500, Value: 2, Labels: labels.FromStrings("trace_id", "abc")})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	// Persisting and truncating the sample at 100 would remove the series, but
+	// its exemplar at 2500 is still within the replay range after a truncation
+	// to 1000.
+	require.Equal(t, int64(100), db.Head().MinTime(), "test precondition")
+	require.NoError(t, db.Head().Truncate(1000))
+
+	ms := db.head.series.getByID(chunks.HeadSeriesRef(ref))
+	require.NotNil(t, ms, "series must keep its identity while its exemplar can be replayed")
+	require.Nil(t, ms.headChunks)
+	require.Empty(t, ms.mmappedChunks)
+	require.Nil(t, ms.app)
+	require.Equal(t, uint64(1), db.Head().NumSeries())
+	require.Equal(t, int64(1000), db.Head().MinTime(),
+		"the retained but empty series must not hold back the head's minimum time")
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(db.head.metrics.chunks))
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+
+	// A checkpoint at a mint past the series' sample must still carry its
+	// series record, because the exemplar at 2500 is inside the replay range.
+	forceTestCheckpointAt(t, db, 2000)
+	require.True(t, checkpointContainsSeries(t, db, ref),
+		"the retained series record must survive the WAL checkpoint while its exemplar can be replayed")
+
+	// The in-memory exemplar is still queryable.
+	res := exemplarResultsFor(t, db, labels.MustNewMatcher(labels.MatchEqual, "name", "with-exemplar"))
+	require.Len(t, res, 1)
+	require.Len(t, res[0].Exemplars, 1)
+
+	// Restart: WAL replay must resolve the exemplar's series reference and
+	// restore both the exemplar and the empty series.
+	require.NoError(t, db.Close())
+	reopened, err := Open(db.Dir(), nil, nil, opts, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, reopened.Close()) })
+
+	require.Zero(t, prom_testutil.ToFloat64(reopened.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")),
+		"the replayed exemplar must resolve to its retained series record")
+	res = exemplarResultsFor(t, reopened, labels.MustNewMatcher(labels.MatchEqual, "name", "with-exemplar"))
+	require.Len(t, res, 1)
+	require.Len(t, res[0].Exemplars, 1)
+	require.Equal(t, 2.0, res[0].Exemplars[0].Value)
+	require.NotNil(t, reopened.head.series.getByID(chunks.HeadSeriesRef(ref)),
+		"the retained series must be restored too")
+
+	// Once the cutoff moves past the exemplar, the series can be removed as
+	// before. A sample for an unrelated series initialises the (otherwise
+	// empty) head, which GC requires.
+	app = reopened.Appender(context.Background())
+	_, err = app.Append(0, labels.FromStrings("name", "filler"), 4000, 1)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+	require.NoError(t, reopened.Head().Truncate(5000))
+	require.Equal(t, uint64(0), reopened.Head().NumSeries())
+}
