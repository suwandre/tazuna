+// TestExemplarRetention_ReleasesHeadAndMmappedChunks verifies that keeping a
+// series for its exemplar still releases all of its sample chunks - both the
+// in-memory head chunk and memory-mapped ones - and counts them once, and that
+// compacting the retained, now empty series again releases nothing more.
+func TestExemplarRetention_ReleasesHeadAndMmappedChunks(t *testing.T) {
+	opts := DefaultOptions()
+	opts.MinBlockDuration = 1000
+	opts.MaxBlockDuration = 1000
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = 100
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	sel := labels.FromStrings("name", "selected")
+	app := db.Appender(context.Background())
+	ref, err := app.Append(0, sel, 100, 1)
+	require.NoError(t, err)
+	_, err = app.Append(ref, sel, 1200, 2)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, sel, exemplar.Exemplar{Ts: 2500, Value: 3})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	// Force the older chunk out of the head so the series holds one mmapped
+	// chunk and one head chunk.
+	db.ForceHeadMMap()
+	ms := db.head.series.getByID(chunks.HeadSeriesRef(ref))
+	ms.Lock()
+	require.Len(t, ms.mmappedChunks, 1)
+	require.Equal(t, uint32(1), ms.headChunkCount.Load())
+	ms.Unlock()
+	require.Equal(t, 2.0, prom_testutil.ToFloat64(db.head.metrics.chunks))
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+
+	ms = db.head.series.getByID(chunks.HeadSeriesRef(ref))
+	require.NotNil(t, ms, "series must keep its identity while its exemplar can be replayed")
+	require.Nil(t, ms.headChunks)
+	require.Empty(t, ms.mmappedChunks)
+	require.Nil(t, ms.app)
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(db.head.metrics.chunks))
+	require.Equal(t, 2.0, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved),
+		"the head and mmapped chunks must each be counted once")
+	require.Len(t, db.Blocks(), 2, "one block per chunk range")
+
+	// A second compaction of the now empty series must not count chunks again.
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Len(t, db.Blocks(), 2)
+	require.Equal(t, 2.0, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+}
+
+// TestExemplarRetention_CompactStaleHead is the CompactStaleHead counterpart
+// of TestExemplarRetention_CompactSelectedSeries. It also checks that a
+// retained stale series keeps its stale-series count and that a second
+// compaction of the empty series is a no-op.
+func TestExemplarRetention_CompactStaleHead(t *testing.T) {
+	opts := DefaultOptions()
+	opts.MinBlockDuration = 1000
+	opts.MaxBlockDuration = 1000
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = 100
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	staleV := math.Float64frombits(value.StaleNaN)
+	sel := labels.FromStrings("name", "selected")
+	app := db.Appender(context.Background())
+	ref, err := app.Append(0, sel, 100, 1.0)
+	require.NoError(t, err)
+	_, err = app.Append(ref, sel, 200, staleV)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, sel, exemplar.Exemplar{Ts: 2500, Value: 2})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+	require.Equal(t, uint64(1), db.Head().NumStaleSeries())
+
+	require.NoError(t, db.CompactStaleHead())
+
+	require.Equal(t, uint64(1), db.Head().NumSeries())
+	require.Equal(t, uint64(1), db.Head().NumStaleSeries(), "a retained stale series must not be counted as removed")
+	ms := db.head.series.getByID(chunks.HeadSeriesRef(ref))
+	require.NotNil(t, ms)
+	require.Nil(t, ms.headChunks)
+	require.Empty(t, ms.mmappedChunks)
+	require.Nil(t, ms.app)
+	require.Equal(t, 0.0, prom_testutil.ToFloat64(db.head.metrics.chunks))
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+	require.Len(t, db.Blocks(), 1)
+
+	// A second stale compaction of the now empty series must not add a block
+	// or remove chunks again.
+	require.NoError(t, db.CompactStaleHead())
+	require.Len(t, db.Blocks(), 1)
+	require.Equal(t, 1.0, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+	require.Equal(t, uint64(1), db.Head().NumSeries())
+
+	// Once the cutoff passes the exemplar, the series is finally evicted.
+	require.NoError(t, db.Head().Truncate(3000))
+	require.Equal(t, uint64(0), db.Head().NumSeries())
+	require.Equal(t, uint64(0), db.Head().NumStaleSeries())
+}
