+// HasExemplarAtOrAfter reports whether the series identified by l has at least
+// one exemplar whose timestamp is at or after mint. Zero and negative
+// timestamps are treated like any other timestamp.
+//
+// Exemplars for a series are kept sorted by timestamp, so the newest entry
+// decides the answer.
+func (ce *CircularExemplarStorage) HasExemplarAtOrAfter(l labels.Labels, mint int64) bool {
+	if len(ce.exemplars) == 0 {
+		return false
+	}
+
+	var buf [1024]byte
+	seriesLabels := l.Bytes(buf[:])
+
+	ce.lock.RLock()
+	defer ce.lock.RUnlock()
+
+	idx, ok := ce.index[string(seriesLabels)]
+	if !ok {
+		return false
+	}
+	return ce.exemplars[idx.newest].exemplar.Ts >= mint
+}
+
 func (ce *CircularExemplarStorage) ValidateExemplar(l labels.Labels, e exemplar.Exemplar) error {
 	var buf [1024]byte
 	seriesLabels := l.Bytes(buf[:])
