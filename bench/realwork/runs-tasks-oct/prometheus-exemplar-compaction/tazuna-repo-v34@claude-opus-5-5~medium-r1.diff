+// TestExemplarSurvivesRestartAfterHeadDropsSeries checks that an exemplar whose series
+// had all its samples persisted and dropped from the head is still replayed after the WAL
+// was checkpointed and the DB restarted, also after a second round of compaction and restart.
+func TestExemplarSurvivesRestartAfterHeadDropsSeries(t *testing.T) {
+	t.Parallel()
+	const (
+		chunkRange = 1000
+		// The exemplar is newer than the last sample of its series and stays at or after
+		// the WAL replay cutoff for the whole test.
+		exemplarTs = 100_000
+	)
+	exLbls := labels.FromStrings("__name__", "with_exemplar")
+	otherLbls := labels.FromStrings("__name__", "other")
+	ex := exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "abc"), Value: 42, Ts: exemplarTs}
+	staleV := math.Float64frombits(value.StaleNaN)
+
+	for _, mode := range []string{"compact", "selected", "stale"} {
+		for _, appV2 := range []bool{false, true} {
+			for _, snapshot := range []bool{false, true} {
+				t.Run(fmt.Sprintf("mode=%s/appenderV2=%t/snapshot=%t", mode, appV2, snapshot), func(t *testing.T) {
+					t.Parallel()
+					dir := t.TempDir()
+					opts := DefaultOptions()
+					opts.MinBlockDuration = chunkRange
+					opts.MaxBlockDuration = chunkRange
+					opts.EnableExemplarStorage = true
+					opts.MaxExemplars = 100
+					opts.EnableMemorySnapshotOnShutdown = snapshot
+					openDB := func() *DB {
+						db := newTestDB(t, withDir(dir), withOpts(opts))
+						db.DisableCompactions()
+						return db
+					}
+					db := openDB()
+
+					// The series gets samples and an exemplar.
+					var exRef storage.SeriesRef
+					var err error
+					if appV2 {
+						app := db.AppenderV2(context.Background())
+						exRef, err = app.Append(0, exLbls, 0, 100, 1, nil, nil, storage.AOptions{Exemplars: []exemplar.Exemplar{ex}})
+						require.NoError(t, err)
+						_, err = app.Append(exRef, exLbls, 0, 200, staleV, nil, nil, storage.AOptions{})
+						require.NoError(t, err)
+						_, err = app.Append(0, otherLbls, 0, 100, 1, nil, nil, storage.AOptions{})
+						require.NoError(t, err)
+						_, err = app.Append(0, otherLbls, 0, 1700, 1, nil, nil, storage.AOptions{})
+						require.NoError(t, err)
+						require.NoError(t, app.Commit())
+					} else {
+						app := db.Appender(context.Background())
+						exRef, err = app.Append(0, exLbls, 100, 1)
+						require.NoError(t, err)
+						_, err = app.AppendExemplar(exRef, exLbls, ex)
+						require.NoError(t, err)
+						_, err = app.Append(exRef, exLbls, 200, staleV)
+						require.NoError(t, err)
+						_, err = app.Append(0, otherLbls, 100, 1)
+						require.NoError(t, err)
+						_, err = app.Append(0, otherLbls, 1700, 1)
+						require.NoError(t, err)
+						require.NoError(t, app.Commit())
+					}
+
+					// Persist the series' samples and let the head drop them.
+					switch mode {
+					case "compact":
+						require.NoError(t, db.Compact(context.Background()))
+					case "selected":
+						require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{exRef}))
+					case "stale":
+						require.NoError(t, db.CompactStaleHead())
+					}
+					require.Len(t, db.Blocks(), 1)
+					require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(exRef)))
+
+					// Ingest more data for the other series and compact the head until the
+					// WAL gets checkpointed (again).
+					// Truncate the head as head compaction does, until the WAL gets checkpointed
+					// (again). Truncating the head directly avoids writing blocks that are not
+					// relevant for the test. The cutoff stays before the exemplar.
+					truncMint := int64(chunkRange)
+					checkpointAfterHeadTruncations := func(db *DB) {
+						_, prevIdx, err := wlog.LastCheckpoint(db.head.wal.Dir())
+						if errors.Is(err, record.ErrNotFound) {
+							prevIdx = -1
+						} else {
+							require.NoError(t, err)
+						}
+						// Each truncation starts a new WAL segment. A checkpoint is created once
+						// there are enough segments.
+						for range 10 {
+							truncMint += chunkRange
+							require.NoError(t, db.head.Truncate(truncMint))
+							if _, idx, err := wlog.LastCheckpoint(db.head.wal.Dir()); err == nil && idx > prevIdx {
+								require.Less(t, truncMint, int64(exemplarTs))
+								return
+							}
+						}
+						require.FailNow(t, "no new WAL checkpoint was created")
+					}
+					checkExemplar := func(db *DB) {
+						t.Helper()
+						s := db.head.series.getByID(chunks.HeadSeriesRef(exRef))
+						require.NotNil(t, s, "series with exemplar must keep its reference")
+						require.Equal(t, exLbls, s.labels())
+
+						q, err := db.ExemplarQuerier(context.Background())
+						require.NoError(t, err)
+						res, err := q.Select(math.MinInt64, math.MaxInt64, []*labels.Matcher{labels.MustNewMatcher(labels.MatchEqual, "__name__", "with_exemplar")})
+						require.NoError(t, err)
+						require.Len(t, res, 1)
+						require.Equal(t, []exemplar.Exemplar{ex}, res[0].Exemplars)
+						require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")))
+					}
+
+					checkpointAfterHeadTruncations(db)
+					checkExemplar(db)
+					require.NoError(t, db.Close())
+
+					db = openDB()
+					checkExemplar(db)
+
+					// The protection must also hold after the exemplar was restored on startup.
+					checkpointAfterHeadTruncations(db)
+					checkExemplar(db)
+					require.NoError(t, db.Close())
+
+					db = openDB()
+					checkExemplar(db)
+				})
+			}
+		}
+	}
+}
+
+// TestCompactSelectedAndStaleHead_SeriesWithExemplarReleasesChunks checks that a series
+// that still has an exemplar at or after the WAL replay cutoff keeps its identity when
+// selected or stale compaction persists it, but that its chunks are released.
+func TestCompactSelectedAndStaleHead_SeriesWithExemplarReleasesChunks(t *testing.T) {
+	t.Parallel()
+	const chunkRange = 1000
+	exLbls := labels.FromStrings("__name__", "with_exemplar")
+	otherLbls := labels.FromStrings("__name__", "other")
+	staleV := math.Float64frombits(value.StaleNaN)
+
+	for _, mode := range []string{"selected", "stale"} {
+		for _, tc := range []struct {
+			name        string
+			exemplarTs  *int64
+			keptAfterGC bool // Whether the series survives head GC with a cutoff of chunkRange.
+		}{
+			{name: "no exemplar"},
+			{name: "exemplar older than last sample", exemplarTs: new(int64(150))},
+			{name: "zero exemplar timestamp", exemplarTs: new(int64(0))},
+			{name: "negative exemplar timestamp", exemplarTs: new(int64(-50))},
+			{name: "exemplar newer than last sample", exemplarTs: new(int64(10_000)), keptAfterGC: true},
+		} {
+			t.Run(fmt.Sprintf("mode=%s/%s", mode, tc.name), func(t *testing.T) {
+				t.Parallel()
+				dir := t.TempDir()
+				opts := DefaultOptions()
+				opts.MinBlockDuration = chunkRange
+				opts.MaxBlockDuration = chunkRange
+				opts.EnableExemplarStorage = true
+				opts.MaxExemplars = 100
+				db := newTestDB(t, withDir(dir), withOpts(opts))
+				db.DisableCompactions()
+
+				compact := func(db *DB, ref storage.SeriesRef) {
+					t.Helper()
+					if mode == "selected" {
+						require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+						return
+					}
+					require.NoError(t, db.CompactStaleHead())
+				}
+				seriesChunks := func(s *memSeries) int {
+					s.Lock()
+					defer s.Unlock()
+					return int(s.headChunkCount.Load()) + len(s.mmappedChunks)
+				}
+				checkReleased := func(s *memSeries) {
+					t.Helper()
+					s.Lock()
+					defer s.Unlock()
+					require.Nil(t, s.headChunks)
+					require.Zero(t, s.headChunkCount.Load())
+					require.Empty(t, s.mmappedChunks)
+					require.Nil(t, s.app)
+				}
+
+				// Enough samples for several chunks, the last one being a stale marker.
+				app := db.Appender(context.Background())
+				var ref storage.SeriesRef
+				var err error
+				for ts := int64(1); ts <= 300; ts++ {
+					ref, err = app.Append(ref, exLbls, ts, float64(ts))
+					require.NoError(t, err)
+				}
+				if tc.exemplarTs != nil {
+					_, err = app.AppendExemplar(ref, exLbls, exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "abc"), Value: 1, Ts: *tc.exemplarTs})
+					require.NoError(t, err)
+				}
+				_, err = app.Append(ref, exLbls, 301, staleV)
+				require.NoError(t, err)
+				_, err = app.Append(0, otherLbls, 100, 1)
+				require.NoError(t, err)
+				require.NoError(t, app.Commit())
+				db.head.mmapHeadChunks()
+
+				s := db.head.series.getByID(chunks.HeadSeriesRef(ref))
+				require.NotNil(t, s)
+				numChunks := seriesChunks(s)
+				require.NotEmpty(t, s.mmappedChunks)
+				chunksBefore := prom_testutil.ToFloat64(db.head.metrics.chunks)
+				removedBefore := prom_testutil.ToFloat64(db.head.metrics.chunksRemoved)
+
+				compact(db, ref)
+				require.Len(t, db.Blocks(), 1)
+				require.Equal(t, chunksBefore-float64(numChunks), prom_testutil.ToFloat64(db.head.metrics.chunks))
+				require.Equal(t, removedBefore+float64(numChunks), prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+				if tc.exemplarTs == nil {
+					require.Nil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+					return
+				}
+				require.Same(t, s, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+				require.Equal(t, uint64(2), db.Head().NumSeries())
+				checkReleased(s)
+
+				// Compacting the retained, empty series again neither writes a block nor removes chunks.
+				chunksBefore = prom_testutil.ToFloat64(db.head.metrics.chunks)
+				removedBefore = prom_testutil.ToFloat64(db.head.metrics.chunksRemoved)
+				compact(db, ref)
+				require.Len(t, db.Blocks(), 1)
+				require.Equal(t, chunksBefore, prom_testutil.ToFloat64(db.head.metrics.chunks))
+				require.Equal(t, removedBefore, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+				require.Same(t, s, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+
+				// After a restart, WAL replay brings back the persisted samples. They can be released again.
+				require.NoError(t, db.Close())
+				db = newTestDB(t, withDir(dir), withOpts(opts))
+				db.DisableCompactions()
+				s = db.head.series.getByID(chunks.HeadSeriesRef(ref))
+				require.NotNil(t, s)
+				require.Equal(t, exLbls, s.labels())
+				require.Positive(t, seriesChunks(s))
+				compact(db, ref)
+				require.Same(t, s, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+				checkReleased(s)
+
+				// Head compaction with a gap in the remaining data: the empty retained series must not
+				// hold back the head's minimum time. It is only kept while its exemplar is at or after
+				// the cutoff.
+				app = db.Appender(context.Background())
+				for ts := int64(2500); ts <= 4000; ts += 100 {
+					_, err = app.Append(0, otherLbls, ts, 1)
+					require.NoError(t, err)
+				}
+				require.NoError(t, app.Commit())
+				require.NoError(t, db.Compact(context.Background()))
+				require.Equal(t, int64(2500), db.Head().MinTime())
+				if tc.keptAfterGC {
+					require.Same(t, s, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+				} else {
+					require.Nil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+				}
+			})
+		}
+	}
+}
