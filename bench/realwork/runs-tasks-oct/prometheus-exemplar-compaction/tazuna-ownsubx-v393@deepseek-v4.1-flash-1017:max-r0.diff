+// HasExemplarAtOrAfter reports whether the series with the given labels has at
+// least one exemplar with a timestamp at or after mint. Zero and negative
+// timestamps are treated like any other timestamp.
+func (ce *CircularExemplarStorage) HasExemplarAtOrAfter(l labels.Labels, mint int64) bool {
+	ce.lock.RLock()
+	defer ce.lock.RUnlock()
+
+	if len(ce.exemplars) == 0 {
+		return false
+	}
+	var buf [1024]byte
+	idx, ok := ce.index[string(l.Bytes(buf[:]))]
+	if !ok {
+		return false
+	}
+	// The per-series list is ordered by timestamp, so the newest entry has the
+	// highest timestamp.
+	return ce.exemplars[idx.newest].exemplar.Ts >= mint
+}
