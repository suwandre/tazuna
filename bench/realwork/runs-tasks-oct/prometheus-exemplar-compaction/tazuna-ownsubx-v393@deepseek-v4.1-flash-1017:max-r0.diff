+func testHeadCompactionKeepsSeriesForExemplar(
+	t *testing.T,
+	appendLset func(*testing.T, *DB, labels.Labels) storage.SeriesRef,
+	persistAndEvict func(*DB, storage.SeriesRef) error,
+	checkpointMint int64,
+	memorySnap bool,
+	exemplarTs int64,
+) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = config.DefaultExemplarsConfig.MaxExemplars
+	opts.EnableMemorySnapshotOnShutdown = memorySnap
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	sel := labels.FromStrings("__name__", "exemplar_series")
+	selRef := appendLset(t, db, sel)
+
+	// The filler makes the head compactable by db.Compact. Its chunks start at 800, so the WAL
+	// expiry recorded for an evicted series stays below the checkpoint mint.
+	filler := labels.FromStrings("__name__", "filler")
+	app := db.Appender(context.Background())
+	fillerRef, err := app.Append(0, filler, 800, 1.0)
+	require.NoError(t, err)
+	_, err = app.Append(fillerRef, filler, 1700, 2.0)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	require.NoError(t, persistAndEvict(db, selRef))
+
+	// The persisted series keeps its identity but must not keep its samples in memory.
+	series := db.head.series.getByID(chunks.HeadSeriesRef(selRef))
+	require.NotNil(t, series, "a series with a replayable exemplar must keep its identity through head GC")
+	series.Lock()
+	headChunkCount := series.headChunkCount.Load()
+	mmappedChunkCount := len(series.mmappedChunks)
+	seriesApp := series.app
+	series.Unlock()
+	require.Zero(t, headChunkCount)
+	require.Zero(t, mmappedChunkCount)
+	require.Nil(t, seriesApp)
+
+	// Truncating the WAL forces the checkpoint that, without the retention, would drop the
+	// series record because its WAL expiry is below the truncation mint.
+	forceTestCheckpoint(t, db, checkpointMint)
+
+	// The restart brings the exemplar back from WAL replay or from the memory snapshot.
+	reopen := func() {
+		require.NoError(t, db.Close())
+		db, err = Open(db.Dir(), nil, nil, opts, nil)
+		require.NoError(t, err)
+		t.Cleanup(func() { require.NoError(t, db.Close()) })
+	}
+	reopen()
+
+	res := queryTestExemplars(t, db, labels.MustNewMatcher(labels.MatchEqual, "__name__", "exemplar_series"))
+	require.Len(t, res, 1, "the exemplar must survive the first restart")
+	require.Len(t, res[0].Exemplars, 1)
+	require.Equal(t, exemplarTs, res[0].Exemplars[0].Ts)
+
+	// The protection must survive that restart too. WAL replay may have brought back samples
+	// whose records are still within the replay range; append one more so there is certainly
+	// a chunk to release, then compact again. The chunks must be released while the identity
+	// and the exemplar are kept.
+	nextTs := max(db.head.MaxTime()+1, checkpointMint)
+	app = db.Appender(context.Background())
+	_, err = app.Append(selRef, sel, nextTs, 2.0)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selRef}))
+	series = db.head.series.getByID(chunks.HeadSeriesRef(selRef))
+	require.NotNil(t, series, "a replayed exemplar must keep the series identity through another compaction")
+	series.Lock()
+	headChunkCount = series.headChunkCount.Load()
+	mmappedChunkCount = len(series.mmappedChunks)
+	seriesApp = series.app
+	series.Unlock()
+	require.Zero(t, headChunkCount, "chunks persisted by the second compaction must be released")
+	require.Zero(t, mmappedChunkCount, "chunks persisted by the second compaction must be released")
+	require.Nil(t, seriesApp)
+
+	forceTestCheckpoint(t, db, checkpointMint)
+	reopen()
+
+	res = queryTestExemplars(t, db, labels.MustNewMatcher(labels.MatchEqual, "__name__", "exemplar_series"))
+	require.Len(t, res, 1, "the exemplar must survive a second restart")
+	require.Len(t, res[0].Exemplars, 1)
+	require.Equal(t, exemplarTs, res[0].Exemplars[0].Ts)
+}
+
+// TestHeadGCKeepsSeriesForExemplarAtCutoff verifies that the retention compares exemplar
+// timestamps -- including zero and negative ones -- against the replay cutoff with a signed
+// comparison, and that an exemplar below the cutoff does not keep a series alive.
+func TestHeadGCKeepsSeriesForExemplarAtCutoff(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		minValid   int64
+		exemplarTs int64
+		retained   bool
+	}{
+		{name: "exemplar above cutoff", minValid: 0, exemplarTs: 1, retained: true},
+		{name: "zero exemplar at zero cutoff", minValid: 0, exemplarTs: 0, retained: true},
+		{name: "zero exemplar below cutoff", minValid: 1, exemplarTs: 0, retained: false},
+		{name: "negative exemplar at negative cutoff", minValid: -10, exemplarTs: -10, retained: true},
+		{name: "negative exemplar below negative cutoff", minValid: -10, exemplarTs: -11, retained: false},
+		{name: "negative exemplar at zero cutoff", minValid: 0, exemplarTs: -1, retained: false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			opts := DefaultOptions()
+			opts.EnableExemplarStorage = true
+			opts.MaxExemplars = config.DefaultExemplarsConfig.MaxExemplars
+			db := newTestDB(t, withOpts(opts))
+			db.DisableCompactions()
+
+			lset := labels.FromStrings("__name__", "exemplar_series")
+			app := db.Appender(context.Background())
+			ref, err := app.Append(0, lset, tc.exemplarTs, 1.0)
+			require.NoError(t, err)
+			_, err = app.AppendExemplar(ref, lset, exemplar.Exemplar{Value: 1, Ts: tc.exemplarTs})
+			require.NoError(t, err)
+			require.NoError(t, app.Commit())
+
+			// The series' chunks are considered persisted, so gcSeries decides on the
+			// exemplar retention alone.
+			db.head.SetMinValidTime(tc.minValid)
+			db.head.gcSeries([]storage.SeriesRef{ref}, math.MaxInt64, func(*memSeries) bool { return true })
+
+			if tc.retained {
+				require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)),
+					"an exemplar at or after the replay cutoff must keep the series identity")
+			} else {
+				require.Nil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)),
+					"an exemplar before the replay cutoff must not keep the series")
+			}
+		})
+	}
+}
