+// TestHeadCompactionKeepsSeriesForExemplarWALReplay verifies that a compaction that persists a
+// series does not drop its identity while it still has an exemplar that WAL replay would
+// restore. Otherwise a subsequent WAL checkpoint drops the series record while the exemplar
+// record remains in the replayed range, and the exemplar is lost on restart with an unknown
+// series reference.
+//
+// The retention must itself survive a restart: after the exemplar comes back from WAL replay
+// (or from the memory snapshot) a further compaction must keep the series again.
+func TestHeadCompactionKeepsSeriesForExemplarWALReplay(t *testing.T) {
+	const (
+		sampleTs   = 100
+		exemplarTs = 2500
+	)
+	for _, tc := range []struct {
+		name       string
+		appendLset func(t *testing.T, db *DB, lset labels.Labels) storage.SeriesRef
+		// persistAndEvict performs the compaction that must release the chunks.
+		persistAndEvict func(db *DB, selRef storage.SeriesRef) error
+		// checkpointMint is the WAL truncation mint used after the compaction. It is above the
+		// WAL expiry recorded for an evicted series, so without retention the checkpoint would
+		// drop the series record, but at or below the exemplar timestamp, so the exemplar
+		// record is replayed.
+		checkpointMint int64
+		memorySnap     bool
+	}{
+		{
+			name: "head compaction",
+			appendLset: func(t *testing.T, db *DB, lset labels.Labels) storage.SeriesRef {
+				return appendTestSeriesWithExemplar(t, db, lset, sampleTs, exemplarTs)
+			},
+			persistAndEvict: func(db *DB, _ storage.SeriesRef) error {
+				return db.Compact(context.Background())
+			},
+			checkpointMint: 1000,
+		},
+		{
+			name: "head compaction, memory snapshot",
+			appendLset: func(t *testing.T, db *DB, lset labels.Labels) storage.SeriesRef {
+				return appendTestSeriesWithExemplar(t, db, lset, sampleTs, exemplarTs)
+			},
+			persistAndEvict: func(db *DB, _ storage.SeriesRef) error {
+				return db.Compact(context.Background())
+			},
+			checkpointMint: 1000, memorySnap: true,
+		},
+		{
+			name: "head compaction, AppenderV2",
+			appendLset: func(t *testing.T, db *DB, lset labels.Labels) storage.SeriesRef {
+				return appendTestSeriesWithExemplarV2(t, db, lset, sampleTs, exemplarTs)
+			},
+			persistAndEvict: func(db *DB, _ storage.SeriesRef) error {
+				return db.Compact(context.Background())
+			},
+			checkpointMint: 1000,
+		},
+		{
+			name: "selected series",
+			appendLset: func(t *testing.T, db *DB, lset labels.Labels) storage.SeriesRef {
+				return appendTestSeriesWithExemplar(t, db, lset, sampleTs, exemplarTs)
+			},
+			persistAndEvict: func(db *DB, selRef storage.SeriesRef) error {
+				return db.CompactSelectedSeries([]storage.SeriesRef{selRef})
+			},
+			checkpointMint: 2000,
+		},
+		{
+			name: "stale head",
+			appendLset: func(t *testing.T, db *DB, lset labels.Labels) storage.SeriesRef {
+				return appendTestStaleSeriesWithExemplar(t, db, lset, sampleTs, exemplarTs)
+			},
+			persistAndEvict: func(db *DB, _ storage.SeriesRef) error {
+				return db.CompactStaleHead()
+			},
+			checkpointMint: 2000,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			testHeadCompactionKeepsSeriesForExemplar(t, tc.appendLset, tc.persistAndEvict, tc.checkpointMint, tc.memorySnap, exemplarTs)
+		})
+	}
+}
