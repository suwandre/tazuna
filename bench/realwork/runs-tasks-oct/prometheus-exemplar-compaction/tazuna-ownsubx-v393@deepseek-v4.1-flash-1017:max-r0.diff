+// queryTestExemplars returns all exemplars matching the provided matchers.
+func queryTestExemplars(t *testing.T, db *DB, matchers ...*labels.Matcher) []exemplar.QueryResult {
+	t.Helper()
+	q, err := db.ExemplarQuerier(context.Background())
+	require.NoError(t, err)
+	res, err := q.Select(math.MinInt64, math.MaxInt64, matchers)
+	require.NoError(t, err)
+	return res
+}
