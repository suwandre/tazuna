+// TestEmptyRetainedSeriesDoesNotHoldBackMinTime verifies that a series kept alive only by
+// its exemplar does not hold back the head's minimum time: its chunks were released, so the
+// head advances to the oldest remaining chunk.
+func TestEmptyRetainedSeriesDoesNotHoldBackMinTime(t *testing.T) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = config.DefaultExemplarsConfig.MaxExemplars
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	sel := labels.FromStrings("__name__", "exemplar_series")
+	app := db.Appender(context.Background())
+	ref, err := app.Append(0, sel, 100, 1.0)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(ref, sel, exemplar.Exemplar{Value: 1, Ts: 5000})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	keep := labels.FromStrings("__name__", "kept")
+	app = db.Appender(context.Background())
+	_, err = app.Append(0, keep, 4000, 1.0)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+
+	// The replay cutoff stays below the exemplar, so the series is retained while the head
+	// only looks at the remaining chunks to compute the actual minimum time.
+	require.NoError(t, db.head.truncateMemory(2000))
+	require.Greater(t, db.head.MinTime(), int64(100),
+		"an empty retained series must not hold back the head's minimum time")
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+}
