+// forceTestCheckpoint drives truncateWAL until a checkpoint is actually produced.
+func forceTestCheckpoint(t *testing.T, db *DB, mint int64) {
+	t.Helper()
+	for range 20 {
+		db.head.lastWALTruncationTime.Store(math.MinInt64) // Force re-truncation each iteration.
+		require.NoError(t, db.head.truncateWAL(mint))
+		if _, _, err := wlog.LastCheckpoint(db.head.wal.Dir()); err == nil {
+			return
+		}
+	}
+	t.Fatalf("no checkpoint produced for mint=%d", mint)
+}
