+// TestCompactSelectedSeries_KeepsSeriesWithExemplarAndReleasesChunks verifies that
+// CompactSelectedSeries persists a series with a replayable exemplar, releases its chunks
+// while keeping its identity, and neither writes another block nor counts chunks again when
+// the now-empty series is compacted a second time.
+func TestCompactSelectedSeries_KeepsSeriesWithExemplarAndReleasesChunks(t *testing.T) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = config.DefaultExemplarsConfig.MaxExemplars
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	sel := labels.FromStrings("__name__", "exemplar_series")
+	app := db.Appender(context.Background())
+	var ref storage.SeriesRef
+	var err error
+	for _, ts := range []int64{100, 200, 300} {
+		ref, err = app.Append(ref, sel, ts, float64(ts))
+		require.NoError(t, err)
+	}
+	_, err = app.AppendExemplar(ref, sel, exemplar.Exemplar{Value: 1, Ts: 300})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Len(t, db.Blocks(), 1)
+
+	series := db.head.series.getByID(chunks.HeadSeriesRef(ref))
+	require.NotNil(t, series, "the series identity must be kept for the WAL checkpoint")
+	series.Lock()
+	headChunkCount := series.headChunkCount.Load()
+	mmappedChunkCount := len(series.mmappedChunks)
+	seriesApp := series.app
+	series.Unlock()
+	require.Zero(t, headChunkCount)
+	require.Zero(t, mmappedChunkCount)
+	require.Nil(t, seriesApp)
+
+	chunksRemoved := prom_testutil.ToFloat64(db.head.metrics.chunksRemoved)
+	require.Greater(t, chunksRemoved, 0.0, "released chunks must be counted")
+	require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.chunks))
+
+	// Compacting the retained, now empty series again must not write a block or count chunks.
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{ref}))
+	require.Len(t, db.Blocks(), 1, "an empty retained series must not produce a second block")
+	require.Equal(t, chunksRemoved, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+	require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.chunks))
+	require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+}
