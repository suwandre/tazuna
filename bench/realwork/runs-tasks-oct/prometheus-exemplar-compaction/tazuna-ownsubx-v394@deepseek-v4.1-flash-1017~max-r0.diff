+// TestCompactStaleHead_ExemplarRetainsSeries is the CompactStaleHead counterpart of
+// TestCompactSelectedSeries_ExemplarRetainsSeries.
+func TestCompactStaleHead_ExemplarRetainsSeries(t *testing.T) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
