+// updateExemplarTime records that an exemplar with timestamp t was accepted for
+// this series. Must be called with the series lock held.
+func (s *memSeries) updateExemplarTime(t int64) {
+	if !s.hasExemplar || t > s.maxExemplarTime {
+		s.maxExemplarTime = t
+		s.hasExemplar = true
+	}
+}
