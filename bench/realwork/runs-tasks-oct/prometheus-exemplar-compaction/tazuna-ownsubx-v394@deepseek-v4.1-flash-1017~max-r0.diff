+// TestHeadCompaction_ExemplarKeepsSeriesRecordAcrossRestart reproduces the case where a
+// series is evicted from the head after its samples have been written to a block, while an
+// exemplar newer than that block is still recoverable through WAL replay. The series
+// identity must be retained so that WAL checkpointing keeps its series record; otherwise
+// replay cannot resolve the exemplar's series reference and drops it.
+func TestHeadCompaction_ExemplarKeepsSeriesRecordAcrossRestart(t *testing.T) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = config.DefaultExemplarsConfig.MaxExemplars
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+
+	sel := labels.FromStrings("name", "sel")
+	filler := labels.FromStrings("name", "filler")
+
+	// The series record lands in the first WAL segment.
+	app := db.Appender(context.Background())
+	selRef, err := app.Append(0, sel, 100, 1.0)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	// Push the exemplar (and the data that drives compaction) far enough ahead that
+	// checkpointing rewrites the segment holding the series record but leaves the
+	// exemplar's segment untouched.
+	for range 30 {
+		_, err := db.head.wal.NextSegment()
+		require.NoError(t, err)
+	}
+
+	app = db.Appender(context.Background())
+	_, err = app.AppendExemplar(selRef, sel, exemplar.Exemplar{Ts: 2000, Value: 1, Labels: labels.FromStrings("trace_id", "abc")})
+	require.NoError(t, err)
+	_, err = app.Append(0, filler, 100, 1.0)
+	require.NoError(t, err)
+	_, err = app.Append(0, filler, 1700, 1.0)
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	require.NoError(t, db.Compact(context.Background()))
+
+	// The series has no chunks left, but its exemplar is past the block and still
+	// replayable, so it must keep its identity.
+	retained := db.Head().series.getByID(chunks.HeadSeriesRef(selRef))
+	require.NotNil(t, retained, "series with a replayable exemplar must be retained")
+	require.Nil(t, retained.headChunks)
+	require.Empty(t, retained.mmappedChunks)
+	// The retained, empty series must not hold back the head's minimum time.
+	require.Greater(t, db.Head().MinTime(), int64(100),
+		"the retained empty series must not hold back the head's minimum time")
+
+	// Force a checkpoint whose mint is past the series' WAL expiry (the oldest
+	// remaining sample time) but not past the exemplar, so the series record is
+	// only kept because the series is still in the head.
+	_, lastIdx, err := wlog.LastCheckpoint(db.head.wal.Dir())
+	if errors.Is(err, record.ErrNotFound) {
+		lastIdx = -1
+	} else {
+		require.NoError(t, err)
+	}
+	for range 10 {
+		db.head.lastWALTruncationTime.Store(0)
+		require.NoError(t, db.head.truncateWAL(2000))
+		if _, idx, err := wlog.LastCheckpoint(db.head.wal.Dir()); err == nil && idx > lastIdx {
+			break
+		}
+	}
+
+	require.NoError(t, db.Close())
+	reopened, err := Open(db.Dir(), nil, nil, opts, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, reopened.Close()) })
+
+	unknownExemplars := prom_testutil.ToFloat64(reopened.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars"))
+	require.Zero(t, unknownExemplars, "WAL replay must resolve the replayed exemplar's series reference")
+
+	q, err := reopened.ExemplarQuerier(context.Background())
+	require.NoError(t, err)
+	res, err := q.Select(0, 5000, []*labels.Matcher{labels.MustNewMatcher(labels.MatchEqual, "name", "sel")})
+	require.NoError(t, err)
+	require.Len(t, res, 1, "the exemplar must survive the restart")
+	require.Len(t, res[0].Exemplars, 1)
+	require.Equal(t, int64(2000), res[0].Exemplars[0].Ts)
+}
