+		if s.keepIfEmpty != nil && s.keepIfEmpty(series) {
+			// The series' chunks were just persisted, but it still has an
+			// exemplar that WAL replay can restore. Release the chunks and the
+			// appender, but keep the series identity so the WAL series record
