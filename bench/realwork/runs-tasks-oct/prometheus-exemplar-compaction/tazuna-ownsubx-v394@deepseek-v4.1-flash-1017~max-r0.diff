+// TestCompactSelectedSeries_ExemplarSurvivesReplayAndFurtherCompaction verifies that the
+// exemplar protection survives a restart, whether the exemplar is restored from the WAL or
+// from the chunk snapshot written on shutdown, and that a later compaction of the replayed
+// series keeps the identity again so that a second restart still returns the exemplar.
+func TestCompactSelectedSeries_ExemplarSurvivesReplayAndFurtherCompaction(t *testing.T) {
+	for _, snapshot := range []bool{false, true} {
+		t.Run(fmt.Sprintf("memory_snapshot=%v", snapshot), func(t *testing.T) {
+			const chunkRange = 1000
+			opts := DefaultOptions()
+			opts.MinBlockDuration = chunkRange
+			opts.MaxBlockDuration = chunkRange
+			opts.EnableExemplarStorage = true
+			opts.MaxExemplars = config.DefaultExemplarsConfig.MaxExemplars
+			opts.EnableMemorySnapshotOnShutdown = snapshot
+
+			db, err := Open(t.TempDir(), nil, nil, opts, nil)
+			require.NoError(t, err)
+			db.DisableCompactions()
+			t.Cleanup(func() { require.NoError(t, db.Close()) })
+			dir := db.Dir()
+
+			sel := labels.FromStrings("name", "sel")
+			app := db.Appender(context.Background())
+			selRef, err := app.Append(0, sel, 100, 1.0)
+			require.NoError(t, err)
+			_, err = app.AppendExemplar(selRef, sel, exemplar.Exemplar{Ts: 5000, Value: 1, Labels: labels.FromStrings("trace_id", "abc")})
+			require.NoError(t, err)
+			require.NoError(t, app.Commit())
+
+			require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selRef}))
+			require.NotNil(t, db.Head().series.getByID(chunks.HeadSeriesRef(selRef)))
+			require.Len(t, db.Blocks(), 1)
+
+			// Restart: the exemplar is restored either from the WAL or from the
+			// chunk snapshot, and must keep protecting the series.
+			require.NoError(t, db.Close())
+			db, err = Open(dir, nil, nil, opts, nil)
+			require.NoError(t, err)
+			db.DisableCompactions()
+
+			q, err := db.ExemplarQuerier(context.Background())
+			require.NoError(t, err)
+			res, err := q.Select(0, 6000, []*labels.Matcher{labels.MustNewMatcher(labels.MatchEqual, "name", "sel")})
+			require.NoError(t, err)
+			require.Len(t, res, 1, "the exemplar must be back after replay")
+			require.Len(t, res[0].Exemplars, 1)
+
+			// A further compaction of the replayed series must release its chunks but
+			// keep the identity again.
+			require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selRef}))
+			replayed := db.Head().series.getByID(chunks.HeadSeriesRef(selRef))
+			require.NotNil(t, replayed, "the replayed exemplar must keep protecting the series")
+			require.Nil(t, replayed.headChunks)
+
+			// And it must still be there after another restart.
+			require.NoError(t, db.Close())
+			db, err = Open(dir, nil, nil, opts, nil)
+			require.NoError(t, err)
+			db.DisableCompactions()
+
+			unknownExemplars := prom_testutil.ToFloat64(db.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars"))
+			require.Zero(t, unknownExemplars, "WAL replay must resolve the exemplar's series reference after the second restart")
+			q, err = db.ExemplarQuerier(context.Background())
+			require.NoError(t, err)
+			res, err = q.Select(0, 6000, []*labels.Matcher{labels.MustNewMatcher(labels.MatchEqual, "name", "sel")})
+			require.NoError(t, err)
+			require.Len(t, res, 1, "the exemplar must survive the second restart")
+			require.Len(t, res[0].Exemplars, 1)
+		})
+	}
+}
