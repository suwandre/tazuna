+// TestCompactSelectedSeries_ExemplarRetainsSeries verifies that CompactSelectedSeries
+// keeps the identity of a series whose persisted chunks are evicted but whose exemplar is
+// still replayable, releasing the chunks and appender without writing a second block on a
+// later compaction.
+func TestCompactSelectedSeries_ExemplarRetainsSeries(t *testing.T) {
+	const chunkRange = 1000
+	opts := DefaultOptions()
+	opts.MinBlockDuration = chunkRange
+	opts.MaxBlockDuration = chunkRange
+	opts.EnableExemplarStorage = true
+	opts.MaxExemplars = config.DefaultExemplarsConfig.MaxExemplars
+	db := newTestDB(t, withOpts(opts))
+	db.DisableCompactions()
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+
+	sel := labels.FromStrings("name", "sel")
+	app := db.Appender(context.Background())
+	selRef, err := app.Append(0, sel, 100, 1.0)
+	require.NoError(t, err)
+	_, err = app.AppendExemplar(selRef, sel, exemplar.Exemplar{Ts: 2000, Value: 1, Labels: labels.FromStrings("trace_id", "abc")})
+	require.NoError(t, err)
+	require.NoError(t, app.Commit())
+
+	require.Equal(t, float64(1), prom_testutil.ToFloat64(db.Head().metrics.chunks))
+
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selRef}))
+
+	retained := db.Head().series.getByID(chunks.HeadSeriesRef(selRef))
+	require.NotNil(t, retained, "the series must keep its identity while its exemplar is replayable")
+	require.Nil(t, retained.headChunks, "persisted head chunks must be released")
+	require.Empty(t, retained.mmappedChunks, "persisted mmapped chunks must be released")
+	require.Nil(t, retained.app, "the appender must be released")
+	require.Equal(t, float64(0), prom_testutil.ToFloat64(db.Head().metrics.chunks), "head chunks gauge must drop")
+	require.Equal(t, float64(1), prom_testutil.ToFloat64(db.Head().metrics.chunksRemoved))
+	require.Len(t, db.Blocks(), 1)
+
+	// Compacting the retained, now empty series must neither write another block nor
+	// count its chunks again.
+	require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selRef}))
+	require.Len(t, db.Blocks(), 1, "an empty retained series must not produce another block")
+	require.Equal(t, float64(1), prom_testutil.ToFloat64(db.Head().metrics.chunksRemoved), "chunks must not be counted twice")
+	require.NotNil(t, db.Head().series.getByID(chunks.HeadSeriesRef(selRef)))
+}
