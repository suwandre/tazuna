+// TestCompactSelectedSeries_ExemplarCutoff verifies that the series identity is retained
+// for any exemplar at or after the minimum valid time, including zero and negative
+// timestamps and exemplars older than the series' last sample, and is released once the
+// cutoff moves past the exemplar.
+func TestCompactSelectedSeries_ExemplarCutoff(t *testing.T) {
+	tests := []struct {
+		name         string
+		sampleTs     int64
+		exemplarTs   int64
+		cutoff       int64
+		wantRetained bool
+	}{
+		{name: "zero timestamp retained at cutoff", sampleTs: 100, exemplarTs: 0, cutoff: 0, wantRetained: true},
+		{name: "zero timestamp past cutoff", sampleTs: 100, exemplarTs: 0, cutoff: 1},
+		{name: "negative timestamp retained at cutoff", sampleTs: 100, exemplarTs: -5, cutoff: -5, wantRetained: true},
+		{name: "negative timestamp past cutoff", sampleTs: 100, exemplarTs: -5, cutoff: -4},
+		{name: "older than last sample retained at cutoff", sampleTs: 2000, exemplarTs: 100, cutoff: 50, wantRetained: true},
+		{name: "older than last sample past cutoff", sampleTs: 2000, exemplarTs: 100, cutoff: 150},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			const chunkRange = 1000
+			opts := DefaultOptions()
+			opts.MinBlockDuration = chunkRange
+			opts.MaxBlockDuration = chunkRange
+			opts.EnableExemplarStorage = true
+			opts.MaxExemplars = config.DefaultExemplarsConfig.MaxExemplars
+			db := newTestDB(t, withOpts(opts))
+			db.DisableCompactions()
+			t.Cleanup(func() { require.NoError(t, db.Close()) })
+
+			sel := labels.FromStrings("name", "sel")
+			app := db.Appender(context.Background())
+			selRef, err := app.Append(0, sel, tc.sampleTs, 1.0)
+			require.NoError(t, err)
+			_, err = app.AppendExemplar(selRef, sel, exemplar.Exemplar{Ts: tc.exemplarTs, Value: 1, Labels: labels.FromStrings("trace_id", "abc")})
+			require.NoError(t, err)
+			require.NoError(t, app.Commit())
+
+			db.head.SetMinValidTime(tc.cutoff)
+			require.NoError(t, db.CompactSelectedSeries([]storage.SeriesRef{selRef}))
+
+			got := db.Head().series.getByID(chunks.HeadSeriesRef(selRef))
+			if tc.wantRetained {
+				require.NotNil(t, got, "series must be retained for an exemplar at the cutoff")
+			} else {
+				require.Nil(t, got, "series must be released once the cutoff passes the exemplar")
+			}
+		})
+	}
+}
