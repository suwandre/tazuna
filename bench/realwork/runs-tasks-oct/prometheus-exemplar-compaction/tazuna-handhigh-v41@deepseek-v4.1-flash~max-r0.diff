+
+// TestExemplarSurvivesRestartAfterHeadCompaction verifies that an exemplar is
+// not lost on restart when head compaction persisted the samples of its series.
+// Exemplars only survive a restart through WAL replay, which needs the series
+// record, so the series must keep its identity through head GC while the
+// exemplar is at or after the WAL replay cutoff.
+func TestExemplarSurvivesRestartAfterHeadCompaction(t *testing.T) {
+	const chunkRange = 1000
+
+	compactions := map[string]struct {
+		compact func(*DB) error
+		// Whether the compaction releases the chunks of the selected series
+		// instead of truncating the head.
+		releasesChunks bool
+		stale          bool
+	}{
+		"Compact":               {compact: func(db *DB) error { return db.Compact(context.Background()) }},
+		"CompactSelectedSeries": {releasesChunks: true},
+		"CompactStaleHead":      {compact: func(db *DB) error { return db.CompactStaleHead() }, releasesChunks: true, stale: true},
+	}
+
+	for name, c := range compactions {
+		for _, exemplarTs := range []int64{-50, 0, 150, 1500} {
+			if !c.releasesChunks && exemplarTs < chunkRange {
+				// Head compaction moves the WAL replay cutoff past such exemplars.
+				continue
+			}
+			for _, appV2 := range []bool{false, true} {
+				for _, snapshot := range []bool{false, true} {
+					t.Run(fmt.Sprintf("compaction=%s/exemplarTs=%d/appenderV2=%t/snapshot=%t", name, exemplarTs, appV2, snapshot), func(t *testing.T) {
+						dir := t.TempDir()
+						opts := DefaultOptions()
+						opts.MinBlockDuration = chunkRange
+						opts.MaxBlockDuration = chunkRange
+						opts.EnableExemplarStorage = true
+						opts.MaxExemplars = 100
+						opts.EnableMemorySnapshotOnShutdown = snapshot
+						db := newTestDB(t, withDir(dir), withOpts(opts))
+						db.DisableCompactions()
+
+						lbls := labels.FromStrings("name", "a")
+						other := labels.FromStrings("name", "other")
+						ex := exemplar.Exemplar{Labels: labels.FromStrings("trace_id", "1"), Value: 42, Ts: exemplarTs, HasTs: true}
+						lastV := 2.0
+						if c.stale {
+							lastV = math.Float64frombits(value.StaleNaN)
+						}
+
+						// The series gets samples at 100 and 200 and an exemplar, the
+						// other series keeps receiving samples.
+						var ref storage.SeriesRef
+						if appV2 {
+							app := db.AppenderV2(context.Background())
+							var err error
+							// Exemplars of stale samples are ignored.
+							ref, err = app.Append(0, lbls, 0, 100, 1, nil, nil, storage.AOptions{Exemplars: []exemplar.Exemplar{ex}})
+							require.NoError(t, err)
+							_, err = app.Append(ref, lbls, 0, 200, lastV, nil, nil, storage.AOptions{})
+							require.NoError(t, err)
+							for ts := int64(0); ts <= 1700; ts += 100 {
+								_, err = app.Append(0, other, 0, ts, 1, nil, nil, storage.AOptions{})
+								require.NoError(t, err)
+							}
+							require.NoError(t, app.Commit())
+						} else {
+							app := db.Appender(context.Background())
+							var err error
+							ref, err = app.Append(0, lbls, 100, 1)
+							require.NoError(t, err)
+							_, err = app.Append(ref, lbls, 200, lastV)
+							require.NoError(t, err)
+							_, err = app.AppendExemplar(ref, lbls, ex)
+							require.NoError(t, err)
+							for ts := int64(0); ts <= 1700; ts += 100 {
+								_, err = app.Append(0, other, ts, 1)
+								require.NoError(t, err)
+							}
+							require.NoError(t, app.Commit())
+						}
+
+						compact := c.compact
+						if compact == nil {
+							compact = func(db *DB) error { return db.CompactSelectedSeries([]storage.SeriesRef{ref}) }
+						}
+
+						// truncateAndCheckpoint moves the WAL replay cutoff to the
+						// exemplar and checkpoints the WAL.
+						truncateAndCheckpoint := func(db *DB) {
+							require.NoError(t, db.head.Truncate(exemplarTs))
+							_, prevIdx, err := wlog.LastCheckpoint(db.head.wal.Dir())
+							if err != nil {
+								prevIdx = -1
+							}
+							for range 10 {
+								db.head.lastWALTruncationTime.Store(math.MinInt64)
+								require.NoError(t, db.head.truncateWAL(exemplarTs))
+								if _, idx, err := wlog.LastCheckpoint(db.head.wal.Dir()); err == nil && idx > prevIdx {
+									return
+								}
+							}
+							require.FailNow(t, "no checkpoint was created")
+						}
+
+						requireExemplar := func(db *DB) {
+							q, err := db.ExemplarQuerier(context.Background())
+							require.NoError(t, err)
+							res, err := q.Select(math.MinInt64, math.MaxInt64, []*labels.Matcher{labels.MustNewMatcher(labels.MatchEqual, "name", "a")})
+							require.NoError(t, err)
+							require.Len(t, res, 1)
+							require.Len(t, res[0].Exemplars, 1)
+							got := res[0].Exemplars[0]
+							require.Equal(t, ex.Ts, got.Ts)
+							require.Equal(t, ex.Value, got.Value)
+							require.Equal(t, ex.Labels, got.Labels)
+						}
+
+						chunksBefore := prom_testutil.ToFloat64(db.head.metrics.chunks)
+						require.NoError(t, compact(db))
+						require.Len(t, db.Blocks(), 1)
+						s := db.head.series.getByID(chunks.HeadSeriesRef(ref))
+						require.NotNil(t, s, "the series must keep its identity while it has an exemplar")
+						require.Equal(t, lbls, s.labels())
+						require.Nil(t, s.headChunks)
+						require.Empty(t, s.mmappedChunks)
+						require.Nil(t, s.app)
+						require.GreaterOrEqual(t, db.head.MinTime(), int64(0), "the empty series must not hold back the head's min time")
+						if c.releasesChunks {
+							require.Equal(t, chunksBefore-1, prom_testutil.ToFloat64(db.head.metrics.chunks))
+							require.Equal(t, 1.0, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+
+							// Compacting the retained empty series again is a no-op.
+							require.NoError(t, compact(db))
+							require.Len(t, db.Blocks(), 1)
+							require.Equal(t, chunksBefore-1, prom_testutil.ToFloat64(db.head.metrics.chunks))
+							require.Equal(t, 1.0, prom_testutil.ToFloat64(db.head.metrics.chunksRemoved))
+							require.Same(t, s, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+						} else {
+							require.Equal(t, int64(chunkRange), db.head.MinTime(), "the empty series must not hold back the head's min time")
+						}
+						requireExemplar(db)
+
+						truncateAndCheckpoint(db)
+						require.Same(t, s, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+
+						// The exemplar survives a restart and the protection
+						// survives a further compaction and restart.
+						for range 2 {
+							require.NoError(t, db.Close())
+							db = newTestDB(t, withDir(dir), withOpts(opts))
+							db.DisableCompactions()
+							requireExemplar(db)
+							require.Zero(t, prom_testutil.ToFloat64(db.head.metrics.walReplayUnknownRefsTotal.WithLabelValues("exemplars")))
+							require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+
+							require.NoError(t, compact(db))
+							require.NotNil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+							truncateAndCheckpoint(db)
+							requireExemplar(db)
+						}
+
+						// Once the cutoff moves past the exemplar, the series can be removed.
+						require.NoError(t, db.head.Truncate(max(exemplarTs, db.head.MinTime())+1))
+						require.Nil(t, db.head.series.getByID(chunks.HeadSeriesRef(ref)))
+					})
+				}
+			}
+		}
+	}
+}
