+
+// sectionBaseWithSlugs returns the base path of the branch node p with
+// any slug set on p or its ancestors applied.
+func sectionBaseWithSlugs(p *pageState, unnormalized bool) (string, bool) {
+	if p.IsHome() {
+		return "", false
+	}
+	pathInfo := func(p *pageState) *paths.Path {
+		if unnormalized {
+			return p.PathInfo().Unnormalized()
+		}
+		return p.PathInfo()
+	}
+
+	base := pathInfo(p).Base()
+	var hasSlug bool
+	if parent, ok := p.Parent().(*pageState); ok && !parent.IsHome() {
+		var parentBase string
+		parentBase, hasSlug = sectionBaseWithSlugs(parent, unnormalized)
+		if hasSlug {
+			base = parentBase + strings.TrimPrefix(base, pathInfo(parent).Base())
+		}
+	}
+	if slug := p.m.Slug(); slug != "" {
+		base = path.Join(path.Dir(base), slug)
+		hasSlug = true
+	}
+	return base, hasSlug
+}
diff --git a/hugolib/page_permalink_test.go b/hugolib/page_permalink_test.go
index d5ae693..4a2d0ec 100644
--- a/hugolib/page_permalink_test.go
+++ b/hugolib/page_permalink_test.go
@@ -201,3 +201,79 @@ path = '/books/**'
 
 	b.AssertFileContent("public/shelf/my-book/index.html", "RelPermalink: /shelf/my-book/")
 }
+
+func TestSlugInSectionTaxonomyAndTerm(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ['rss','sitemap']
+defaultContentLanguage = 'en'
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+tags: [foo]
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+tags: [foo]
+---
+-- content/help/p1.es.md --
+---
+title: P1
+---
+-- content/help/nosection/p2.es.md --
+---
+title: P2
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+---
+-- content/help/sub/p3.es.md --
+---
+title: P3
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: fu
+---
+-- layouts/all.html --
+{{ .Title }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "Help|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "How to frob|/help/how-to-frob/|")
+	b.AssertFileContent("public/tags/foo/index.html", "Foo|/tags/foo/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "Ayuda|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Como frobear|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/p1/index.html", "P1|/es/ayuda/p1/|")
+	b.AssertFileContent("public/es/ayuda/nosection/p2/index.html", "P2|/es/ayuda/nosection/p2/|")
+	b.AssertFileContent("public/es/ayuda/sub/index.html", "Sub|/es/ayuda/sub/|")
+	b.AssertFileContent("public/es/ayuda/sub/p3/index.html", "P3|/es/ayuda/sub/p3/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "Etiquetas|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "Foo|/es/etiquetas/fu/|")
+}
