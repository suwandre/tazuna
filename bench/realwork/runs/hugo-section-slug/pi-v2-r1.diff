+func (d TargetPathDescriptor) withSectionSlugs(dir string) string {
+	if len(d.SectionSlugs) == 0 {
+		return dir
+	}
+	elems := strings.Split(dir, slash)
+	// Skip the leading empty element.
+	n := 0
+	if elems[0] == "" {
+		n = 1
+	}
+	for i := n; i < len(elems); i++ {
+		if j := i - n; j < len(d.SectionSlugs) && d.SectionSlugs[j] != "" {
+			elems[i] = d.SectionSlugs[j]
+		}
+	}
+	return strings.Join(elems, slash)
+}
