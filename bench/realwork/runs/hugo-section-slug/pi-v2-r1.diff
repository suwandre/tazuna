diff --git a/hugolib/page_test.go b/hugolib/page_test.go
index 88a6b22..6ef9248 100644
--- a/hugolib/page_test.go
+++ b/hugolib/page_test.go
@@ -2542,3 +2542,73 @@ isCJKLanguage: true
 	b.AssertFileContent("public/p500/index.html", "500|500|1")
 	b.AssertFileContent("public/p501/index.html", "501|600|2")
 }
+
+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ['rss','sitemap']
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+[taxonomies]
+tag = 'tags'
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: Frob
+tags: [t1]
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Frobear
+slug: como-frobear
+tags: [t1]
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+slug: sub-es
+---
+-- content/help/sub/p1.es.md --
+---
+title: P1
+---
+-- content/tags/_index.es.md --
+---
+title: Tags
+slug: etiquetas
+---
+-- content/tags/t1/_index.es.md --
+---
+title: T1
+slug: e1
+---
+-- layouts/all.html --
+{{ .Title }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "Help|/help/")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "Frob|/help/how-to-frob/")
+	b.AssertFileContent("public/es/ayuda/index.html", "Ayuda|/es/ayuda/")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Frobear|/es/ayuda/como-frobear/")
+	b.AssertFileContent("public/es/ayuda/sub-es/index.html", "Sub|/es/ayuda/sub-es/")
+	b.AssertFileContent("public/es/ayuda/sub-es/p1/index.html", "P1|/es/ayuda/sub-es/p1/")
+	b.AssertFileContent("public/es/etiquetas/index.html", "Tags|/es/etiquetas/")
+	b.AssertFileContent("public/es/etiquetas/e1/index.html", "T1|/es/etiquetas/e1/")
+	b.AssertFileExists("public/es/help/index.html", false)
+}
