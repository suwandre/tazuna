diff --git a/hugolib/page__paths.go b/hugolib/page__paths.go
index 46a3a99..5032569 100644
--- a/hugolib/page__paths.go
+++ b/hugolib/page__paths.go
@@ -116,17 +116,25 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 	alwaysInSubDir := p.Kind() == kinds.KindSitemap
 	pageInfoPage := p.PathInfo()
 
-	pageInfoCurrentSection := p.CurrentSection().PathInfo()
-	if p.s.Conf.DisablePathToLower() {
+	currentSection := p.CurrentSection()
+	pageInfoCurrentSection := currentSection.PathInfo()
+	disablePathToLower := p.s.Conf.DisablePathToLower()
+	if disablePathToLower {
 		pageInfoPage = pageInfoPage.Unnormalized()
 		pageInfoCurrentSection = pageInfoCurrentSection.Unnormalized()
 	}
 
+	dir := dirWithSlugs(currentSection, disablePathToLower)
+	if !kinds.IsBranch(p.Kind()) {
+		dir += strings.TrimPrefix(pageInfoPage.ContainerDir(), strings.TrimSuffix(pageInfoCurrentSection.Base(), "/"))
+	}
+
 	desc := page.TargetPathDescriptor{
 		PathSpec:    d.PathSpec,
 		Kind:        p.Kind(),
 		Path:        pageInfoPage,
 		Section:     pageInfoCurrentSection,
+		Dir:         dir,
 		UglyURLs:    s.h.Conf.IsUglyURLs(p.Section()),
 		ForcePrefix: s.h.Conf.IsMultihost() || alwaysInSubDir,
 		URL:         pm.pageConfig.URL,
@@ -207,3 +215,27 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 
 	return desc, nil
 }
+
+// dirWithSlugs returns the directory of the branch page p, with the slug of p
+// or of any of its branch ancestors, if set, in place of its path element.
+func dirWithSlugs(p page.Page, unnormalized bool) string {
+	if p.IsHome() {
+		return ""
+	}
+
+	parent := p.Parent()
+	parentDir := dirWithSlugs(parent, unnormalized)
+	if slug := p.Slug(); slug != "" {
+		return parentDir + "/" + slug
+	}
+
+	return parentDir + strings.TrimPrefix(pathInfoBase(p, unnormalized), strings.TrimSuffix(pathInfoBase(parent, unnormalized), "/"))
+}
+
+func pathInfoBase(p page.Page, unnormalized bool) string {
+	pi := p.PathInfo()
+	if unnormalized {
+		pi = pi.Unnormalized()
+	}
+	return pi.Base()
+}
diff --git a/hugolib/slug_test.go b/hugolib/slug_test.go
new file mode 100644
index 0000000..fdb37bb
--- /dev/null
+++ b/hugolib/slug_test.go
@@ -0,0 +1,179 @@
+package hugolib
+
+import (
+	"testing"
+)
+
+func TestSlugInMultilingualSectionTaxonomyAndTermPages(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+defaultContentLanguage = 'en'
+
+[taxonomies]
+tag = 'tags'
+
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+tags: [foo]
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+tags: [foo]
+---
+-- content/help/faq.en.md --
+---
+title: FAQ
+---
+-- content/help/faq.es.md --
+---
+title: Preguntas
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: bar
+---
+-- content/help/baz.es.md --
+---
+title: Baz
+tags: [baz]
+---
+-- layouts/home.html --
+{{ .Title }}
+-- layouts/section.html --
+{{ .Title }}
+-- layouts/page.html --
+{{ .Title }}
+-- layouts/taxonomy.html --
+{{ .Title }}
+-- layouts/term.html --
+{{ .Title }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileExists("public/help/index.html", true)
+	b.AssertFileExists("public/help/how-to-frob/index.html", true)
+	b.AssertFileExists("public/help/faq/index.html", true)
+	b.AssertFileExists("public/tags/foo/index.html", true)
+
+	b.AssertFileExists("public/es/ayuda/index.html", true)
+	b.AssertFileExists("public/es/ayuda/como-frobear/index.html", true)
+	b.AssertFileExists("public/es/ayuda/faq/index.html", true)
+	b.AssertFileExists("public/es/etiquetas/index.html", true)
+	b.AssertFileExists("public/es/etiquetas/bar/index.html", true)
+	b.AssertFileExists("public/es/etiquetas/baz/index.html", true)
+
+	b.AssertFileExists("public/es/help/index.html", false)
+	b.AssertFileExists("public/es/ayuda/how-to-frob/index.html", false)
+	b.AssertFileExists("public/es/tags/index.html", false)
+	b.AssertFileExists("public/es/tags/foo/index.html", false)
+}
+
+func TestSlugInNestedSections(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- content/a/_index.md --
+---
+title: A
+slug: x
+---
+-- content/a/b/_index.md --
+---
+title: B
+slug: y
+---
+-- content/a/b/c/index.md --
+---
+title: C
+---
+-- content/a/d/_index.md --
+---
+title: D
+---
+-- content/a/d/e.md --
+---
+title: E
+---
+-- layouts/home.html --
+{{ .Title }}
+-- layouts/section.html --
+{{ .Title }}
+-- layouts/page.html --
+{{ .Title }}
+-- layouts/taxonomy.html --
+{{ .Title }}
+-- layouts/term.html --
+{{ .Title }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileExists("public/x/index.html", true)
+	b.AssertFileExists("public/x/y/index.html", true)
+	b.AssertFileExists("public/x/y/c/index.html", true)
+	b.AssertFileExists("public/x/d/index.html", true)
+	b.AssertFileExists("public/x/d/e/index.html", true)
+
+	b.AssertFileExists("public/a/index.html", false)
+	b.AssertFileExists("public/a/b/c/index.html", false)
+}
+
+func TestSlugInSectionWithDisablePathToLower(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disablePathToLower = true
+-- content/Help/_index.md --
+---
+title: Help
+slug: Ayuda
+---
+-- content/Help/Sub/_index.md --
+---
+title: Sub
+---
+-- content/Help/Sub/Page.md --
+---
+title: Page
+---
+-- layouts/home.html --
+{{ .Title }}
+-- layouts/section.html --
+{{ .Title }}
+-- layouts/page.html --
+{{ .Title }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileExists("public/Ayuda/Sub/index.html", true)
+	b.AssertFileExists("public/Ayuda/Sub/Page/index.html", true)
+	b.AssertFileExists("public/Help/index.html", false)
+}
