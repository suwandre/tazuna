+
+// pathsWithSectionSlugs returns the section base (used for branch pages) and the
+// container dir (used for regular pages) with the path segment of any section,
+// taxonomy or term having a slug replaced by that slug.
+// An empty string is returned if no slugs apply.
+// The paths given may be unnormalized.
+func (p *pageState) pathsWithSectionSlugs(pagePath, sectionPath *paths.Path) (sectionBase, containerDir string) {
+	if kinds.IsBranch(p.Kind()) {
+		if p.Kind() == kinds.KindHome {
+			return "", ""
+		}
+		return p.applySectionSlugs(p.PathInfo().Base(), sectionPath.Base()), ""
+	}
+	return "", p.applySectionSlugs(p.PathInfo().ContainerDir(), pagePath.ContainerDir())
+}
+
+// applySectionSlugs replaces the segments of display with the slugs of the
+// matching branch pages. The branch pages are looked up using the normalized
+// path norm, which must have the same number of segments as display.
+func (p *pageState) applySectionSlugs(norm, display string) string {
+	if norm == "" || norm == "/" {
+		return ""
+	}
+	normSegments := strings.Split(strings.Trim(norm, "/"), "/")
+	displaySegments := strings.Split(strings.Trim(display, "/"), "/")
+	if len(normSegments) != len(displaySegments) {
+		return ""
+	}
+
+	tree := p.s.pageMap.treePages
+	var (
+		prefix  string
+		changed bool
+	)
+	for i, seg := range normSegments {
+		prefix += "/" + seg
+		n, ok := tree.Get(prefix).(*pageState)
+		if !ok || n == nil || !kinds.IsBranch(n.Kind()) {
+			continue
+		}
+		if slug := n.m.Slug(); slug != "" {
+			displaySegments[i] = slug
+			changed = true
+		}
+	}
+	if !changed {
+		return ""
+	}
+	return "/" + strings.Join(displaySegments, "/")
+}
