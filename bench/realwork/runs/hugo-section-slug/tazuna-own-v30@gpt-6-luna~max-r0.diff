+func applyBranchSlugsToPaths(p *pageState, currentSection page.Page, pageInfoPage, pageInfoCurrentSection *paths.Path) (*paths.Path, *paths.Path) {
+	if currentSection.IsHome() {
+		return pageInfoPage, pageInfoCurrentSection
+	}
+
+	sections := currentSection.Ancestors().Reverse()
+	sections = append(sections, currentSection)
+
+	var (
+		sourceBranchPath string
+		targetBranchPath string
+		hasBranchSlug    bool
+	)
+
+	for _, section := range sections {
+		if section.IsHome() {
+			continue
+		}
+
+		sectionPathInfo := section.PathInfo()
+		if p.s.Conf.DisablePathToLower() {
+			sectionPathInfo = sectionPathInfo.Unnormalized()
+		}
+		sectionPath := sectionPathInfo.Base()
+		targetPath := sectionPath
+		if sourceBranchPath != "" && strings.HasPrefix(sectionPath, sourceBranchPath+"/") {
+			targetPath = targetBranchPath + strings.TrimPrefix(sectionPath, sourceBranchPath)
+		}
+		if slug := section.Slug(); slug != "" {
+			targetPath = path.Join(path.Dir(targetPath), slug)
+			hasBranchSlug = true
+		}
+
+		sourceBranchPath = sectionPath
+		targetBranchPath = targetPath
+	}
+
+	if !hasBranchSlug {
+		return pageInfoPage, pageInfoCurrentSection
+	}
+
+	remap := func(pathInfo *paths.Path) *paths.Path {
+		pagePath := pathInfo.Path()
+		if pagePath != sourceBranchPath && !strings.HasPrefix(pagePath, sourceBranchPath+"/") {
+			return pathInfo
+		}
+
+		pagePath = targetBranchPath + strings.TrimPrefix(pagePath, sourceBranchPath)
+		pathInfo = p.s.Conf.PathParser().Parse(files.ComponentFolderContent, pagePath)
+		if p.s.Conf.DisablePathToLower() {
+			pathInfo = pathInfo.Unnormalized()
+		}
+		return pathInfo
+	}
+
+	return remap(pageInfoPage), remap(pageInfoCurrentSection)
+}
