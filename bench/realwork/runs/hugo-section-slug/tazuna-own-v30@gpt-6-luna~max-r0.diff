+func TestSectionSlugAffectsDescendantPaths(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ["taxonomy", "term"]
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- layouts/page.html --
+{{ .RelPermalink }}
+-- layouts/list.html --
+{{ .RelPermalink }}
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+slug: como-frobear
+---
+-- content/help/guides/_index.en.md --
+---
+title: Guides
+---
+-- content/help/guides/_index.es.md --
+---
+slug: guias
+---
+-- content/help/guides/tips.en.md --
+---
+title: Tips
+---
+-- content/help/guides/tips.es.md --
+---
+title: Consejos
+---
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "/help/")
+	b.AssertFileContent("public/es/ayuda/index.html", "/es/ayuda/")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "/help/how-to-frob/")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "/es/ayuda/como-frobear/")
+	b.AssertFileContent("public/es/ayuda/guias/tips/index.html", "/es/ayuda/guias/tips/")
+}
