@@ -132,6 +132,12 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 		URL:         pm.pageConfig.URL,
 	}
 
+	if kinds.IsBranch(p.Kind()) {
+		desc.Dir = applySectionSlugs(p, pageInfoCurrentSection.Base())
+	} else {
+		desc.Dir = applySectionSlugs(p.Parent(), pageInfoPage.ContainerDir())
+	}
+
 	if pm.Slug() != "" {
 		desc.BaseName = pm.Slug()
 	} else if pm.isStandalone() && pm.standaloneOutputFormat.BaseName != "" {
@@ -207,3 +213,25 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 
 	return desc, nil
 }
+
+// applySectionSlugs returns dir with the path segments of p and its ancestors
+// replaced by their slugs, or an empty string if no slugs are set.
+func applySectionSlugs(p page.Page, dir string) string {
+	var segs []string
+	for ; p != nil && !p.IsHome(); p = p.Parent() {
+		slug := p.Slug()
+		if slug == "" {
+			continue
+		}
+		if segs == nil {
+			segs = strings.Split(strings.TrimPrefix(dir, "/"), "/")
+		}
+		if i := strings.Count(p.PathInfo().Base(), "/") - 1; i >= 0 && i < len(segs) {
+			segs[i] = slug
+		}
+	}
+	if segs == nil {
+		return ""
+	}
+	return "/" + strings.Join(segs, "/")
+}
diff --git a/hugolib/page_permalink_test.go b/hugolib/page_permalink_test.go
index d5ae693..4ff3b65 100644
--- a/hugolib/page_permalink_test.go
+++ b/hugolib/page_permalink_test.go
@@ -201,3 +201,78 @@ path = '/books/**'
 
 	b.AssertFileContent("public/shelf/my-book/index.html", "RelPermalink: /shelf/my-book/")
 }
+
+func TestSlugInBranchPages(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ['rss','sitemap']
+defaultContentLanguage = 'en'
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+slug: Sub ES
+---
+-- content/help/sub/p1.es.md --
+---
+title: P1
+---
+-- content/help/nosection/p2.es.md --
+---
+title: P2
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: fu
+---
+-- content/p3.es.md --
+---
+title: P3
+tags: [foo]
+---
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "section|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "page|/help/how-to-frob/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "section|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/sub-es/index.html", "section|/es/ayuda/sub-es/|")
+	b.AssertFileContent("public/es/ayuda/sub-es/p1/index.html", "page|/es/ayuda/sub-es/p1/|")
+	b.AssertFileContent("public/es/ayuda/nosection/p2/index.html", "page|/es/ayuda/nosection/p2/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "taxonomy|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "term|/es/etiquetas/fu/|")
+	b.AssertFileExists("public/es/help/index.html", false)
+}
