+// applySectionSlugs returns dir with the segments that are sections (of p's section
+// chain) with a slug replaced by that slug, or "" if no slug applies.
+func applySectionSlugs(p *pageState, dir string) string {
+	var slugs map[string]string
+	for s := p.CurrentSection(); s != nil && !s.IsHome(); s = s.Parent() {
+		if slug := s.Slug(); slug != "" {
+			if slugs == nil {
+				slugs = make(map[string]string)
+			}
+			slugs[s.Path()] = slug
+		}
+	}
+	if slugs == nil {
+		return ""
+	}
+
+	segs := strings.Split(strings.Trim(dir, "/"), "/")
+	var prefix string
+	var changed bool
+	for i, seg := range segs {
+		prefix += "/" + strings.ToLower(seg)
+		if slug, ok := slugs[prefix]; ok {
+			segs[i] = slug
+			changed = true
+		}
+	}
+	if !changed {
+		return ""
+	}
+	return "/" + strings.Join(segs, "/")
+}
