@@ -207,3 +211,47 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 
 	return desc, nil
 }
+
+// sectionSlugPath returns the section path of p with section, taxonomy and term
+// directory names replaced by their slugs. It returns an empty string if no
+// slug is set in the section hierarchy.
+func sectionSlugPath(p *pageState, unnormalized bool) string {
+	cur := p.CurrentSection()
+	if cur == nil || cur.IsHome() {
+		return ""
+	}
+	if !kinds.IsBranch(p.Kind()) && cur.Path() != p.PathInfo().ContainerDir() {
+		return ""
+	}
+
+	chain := append(cur.Ancestors().Reverse(), cur)
+
+	var (
+		segments   []string
+		hasSlug    bool
+		parentPath string
+	)
+	for _, q := range chain {
+		if q.IsHome() {
+			continue
+		}
+		pi := q.PathInfo()
+		if unnormalized {
+			pi = pi.Unnormalized()
+		}
+		seg := q.Slug()
+		if seg != "" {
+			hasSlug = true
+		} else {
+			seg = strings.Trim(strings.TrimPrefix(pi.Base(), parentPath), "/")
+		}
+		segments = append(segments, seg)
+		parentPath = pi.Base()
+	}
+
+	if !hasSlug {
+		return ""
+	}
+
+	return path.Join(segments...)
+}
