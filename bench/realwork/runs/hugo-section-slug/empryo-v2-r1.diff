+
+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ['rss','sitemap']
+[taxonomies]
+tag = "tags"
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+---
+-- content/help/other/_index.es.md --
+---
+title: Otro
+slug: otro-slug
+---
+-- content/help/other/p1.es.md --
+---
+title: P1
+---
+-- content/help/p2.es.md --
+---
+title: P2
+---
+-- content/help/other/p1.en.md --
+---
+title: P1
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: foo-es
+---
+-- content/p3.es.md --
+---
+title: P3
+tags: [foo]
+---
+-- layouts/all.html --
+{{ .Title }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "Help|/help/")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "How to frob|/help/how-to-frob/")
+	b.AssertFileContent("public/help/other/p1/index.html", "P1|/help/other/p1/")
+
+	b.AssertFileExists("public/es/help/index.html", false)
+	b.AssertFileContent("public/es/ayuda/index.html", "Ayuda|/es/ayuda/")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Como frobear|/es/ayuda/como-frobear/")
+	b.AssertFileContent("public/es/ayuda/otro-slug/index.html", "Otro|/es/ayuda/otro-slug/")
+	b.AssertFileContent("public/es/ayuda/otro-slug/p1/index.html", "P1|/es/ayuda/otro-slug/p1/")
+	b.AssertFileContent("public/es/ayuda/p2/index.html", "P2|/es/ayuda/p2/")
+
+	b.AssertFileContent("public/es/etiquetas/index.html", "Etiquetas|/es/etiquetas/")
+	b.AssertFileContent("public/es/etiquetas/foo-es/index.html", "Foo|/es/etiquetas/foo-es/")
+}
