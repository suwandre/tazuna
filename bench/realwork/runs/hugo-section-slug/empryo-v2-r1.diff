+// sectionBaseWithSlugs returns the base path of p's current section where each
+// section (including the current) with a slug set has its path segment replaced by that slug.
+// It returns an empty string if no section in the chain has a slug.
+func sectionBaseWithSlugs(p *pageState) string {
+	normalize := func(pi *paths.Path) string {
+		if p.s.Conf.DisablePathToLower() {
+			pi = pi.Unnormalized()
+		}
+		return pi.Base()
+	}
+
+	var (
+		segments []string
+		hasSlug  bool
+		cur      = p.CurrentSection()
+	)
+
+	for cur != nil && !cur.IsHome() {
+		parent := cur.Parent()
+		base := normalize(cur.PathInfo())
+		var parentBase string
+		if parent != nil && !parent.IsHome() {
+			parentBase = normalize(parent.PathInfo())
+		}
+		segment := strings.TrimPrefix(strings.TrimPrefix(base, parentBase), "/")
+		if slug := cur.Slug(); slug != "" {
+			segment = slug
+			hasSlug = true
+		}
+		segments = append(segments, segment)
+		cur = parent
+	}
+
+	if !hasSlug {
+		return ""
+	}
+
+	slices.Reverse(segments)
+	return "/" + strings.Join(segments, "/")
+}
