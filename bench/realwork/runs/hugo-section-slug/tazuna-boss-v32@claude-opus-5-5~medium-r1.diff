+package hugolib
+
+import (
+	"testing"
+)
+
+func TestSlugInSectionsAndTerms(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- layouts/page.html --
+Page: {{ .Kind }}|{{ .RelPermalink }}|
+-- layouts/list.html --
+List: {{ .Kind }}|{{ .RelPermalink }}|
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: Frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Frobear
+slug: como-frobear
+---
+-- content/help/p1.es.md --
+---
+title: P1
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+---
+-- content/help/sub/p2.es.md --
+---
+title: P2
+---
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "List: section|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "Page: page|/help/how-to-frob/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "List: section|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Page: page|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/p1/index.html", "Page: page|/es/ayuda/p1/|")
+	b.AssertFileContent("public/es/ayuda/sub/index.html", "List: section|/es/ayuda/sub/|")
+	b.AssertFileContent("public/es/ayuda/sub/p2/index.html", "Page: page|/es/ayuda/sub/p2/|")
+	b.AssertFileExists("public/es/help/index.html", false)
+	b.AssertFileExists("public/es/help/sub/p2/index.html", false)
+}
+
+func TestSlugInTaxonomyAndTerms(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com/"
+defaultContentLanguage = "es"
+[languages.es]
+weight = 1
+-- layouts/page.html --
+Page: {{ .Kind }}|{{ .RelPermalink }}|
+-- layouts/list.html --
+List: {{ .Kind }}|{{ .RelPermalink }}|
+-- content/tags/_index.md --
+---
+title: Tags
+slug: etiquetas
+---
+-- content/tags/foo/_index.md --
+---
+title: Foo
+slug: bar
+---
+-- content/tags/baz/_index.md --
+---
+title: Baz
+---
+-- content/post/p1.md --
+---
+title: P1
+tags: [foo, qux]
+---
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/etiquetas/index.html", "List: taxonomy|/etiquetas/|")
+	b.AssertFileContent("public/etiquetas/bar/index.html", "List: term|/etiquetas/bar/|")
+	b.AssertFileContent("public/etiquetas/baz/index.html", "List: term|/etiquetas/baz/|")
+	b.AssertFileContent("public/etiquetas/qux/index.html", "List: term|/etiquetas/qux/|")
+	b.AssertFileContent("public/post/p1/index.html", "Page: page|/post/p1/|")
+	b.AssertFileExists("public/tags/index.html", false)
+	b.AssertFileExists("public/tags/foo/index.html", false)
+}
