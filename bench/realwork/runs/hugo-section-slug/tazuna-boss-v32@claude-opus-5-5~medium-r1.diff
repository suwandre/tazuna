+
+// slugDirOverride returns the dir of p's target path with the slugs of its branch
+// ancestors applied, or "" if they don't change it.
+func slugDirOverride(p *pageState, unnormalized bool) string {
+	section := p.CurrentSection().(*pageState)
+	if section.IsHome() {
+		return ""
+	}
+
+	sectionDir := pathInfoOf(section, unnormalized).Base()
+	dir := sectionDir
+	if !kinds.IsBranch(p.Kind()) {
+		dir = pathInfoOf(p, unnormalized).ContainerDir()
+	}
+
+	slugSectionDir := slugBranchDir(p.s.pageMap.treePages, section.PathInfo().Base(), sectionDir)
+	if slugSectionDir == sectionDir {
+		return ""
+	}
+	return slugSectionDir + strings.TrimPrefix(dir, sectionDir)
+}
+
+// slugBranchDir returns dir with the slugs of the branch pages along it applied.
+// key is the normalized form of dir, used to look up the branch pages in tree.
+func slugBranchDir(tree *doctree.NodeShiftTree[contentNode], key, dir string) string {
+	keys := strings.Split(key[1:], "/")
+	names := strings.Split(dir[1:], "/")
+
+	var b strings.Builder
+	var lookup string
+	for i, k := range keys {
+		lookup += "/" + k
+		name := names[i]
+		if n := tree.Get(lookup); n != nil && cnh.isBranchNode(n) {
+			if slug := n.(*pageState).Slug(); slug != "" {
+				name = slug
+			}
+		}
+		b.WriteString("/" + name)
+	}
+	return b.String()
+}
+
+func pathInfoOf(p *pageState, unnormalized bool) *paths.Path {
+	if unnormalized {
+		return p.PathInfo().Unnormalized()
+	}
+	return p.PathInfo()
+}
