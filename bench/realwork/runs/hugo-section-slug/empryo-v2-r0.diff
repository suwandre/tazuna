+// sectionDirWithSlugs returns dir with every segment that maps to a section
+// (an ancestor of p, or p itself if it's a branch page) having a slug replaced
+// by that slug. It returns an empty string if nothing needs to be replaced.
+func sectionDirWithSlugs(p *pageState, dir string, unnormalized bool) string {
+	var slugs map[string]string
+	add := func(pg page.Page) {
+		slug := pg.Slug()
+		if slug == "" || pg.IsHome() {
+			return
+		}
+		pi := pg.PathInfo()
+		if unnormalized {
+			pi = pi.Unnormalized()
+		}
+		if slugs == nil {
+			slugs = make(map[string]string)
+		}
+		slugs[pi.Base()] = slug
+	}
+	for _, a := range p.Ancestors() {
+		add(a)
+	}
+	if kinds.IsBranch(p.Kind()) {
+		add(p)
+	}
+	if slugs == nil {
+		return ""
+	}
+
+	segs := strings.Split(strings.Trim(dir, "/"), "/")
+	var prefix string
+	var replaced bool
+	for i, seg := range segs {
+		prefix += "/" + seg
+		if slug, ok := slugs[prefix]; ok {
+			segs[i] = slug
+			replaced = true
+		}
+	}
+	if !replaced {
+		return ""
+	}
+	return strings.Join(segs, "/")
+}
