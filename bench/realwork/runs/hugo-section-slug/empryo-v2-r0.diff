+
+package hugolib
+
+import "testing"
+
+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ["rss", "sitemap"]
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+[taxonomies]
+tag = "tags"
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+---
+-- content/help/other/_index.es.md --
+---
+title: Otro
+---
+-- content/help/other/p1.es.md --
+---
+title: P1
+tags: [t1]
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/t1/_index.es.md --
+---
+title: T1
+slug: etiqueta-uno
+---
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "section|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "page|/help/how-to-frob/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "section|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/other/index.html", "section|/es/ayuda/other/|")
+	b.AssertFileContent("public/es/ayuda/other/p1/index.html", "page|/es/ayuda/other/p1/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "taxonomy|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/etiqueta-uno/index.html", "term|/es/etiquetas/etiqueta-uno/|")
+}
