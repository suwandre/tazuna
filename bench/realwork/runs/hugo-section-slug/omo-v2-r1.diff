diff --git a/hugolib/page__paths.go b/hugolib/page__paths.go
index 46a3a99..4809e5f 100644
--- a/hugolib/page__paths.go
+++ b/hugolib/page__paths.go
@@ -203,7 +203,47 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 		} else {
 			s.Log.Debugf("Set expanded permalink path for %s in %v to %#v", p.Kind(), desc.Section.Path(), opath)
 		}
+	} else if desc.URL == "" {
+		desc.ExpandedPermalink = sectionSlugsPath(p, desc)
 	}
 
 	return desc, nil
 }
+
+// sectionSlugsPath returns the path of p with the slugs of its section
+// ancestors (and itself, if it's a section) applied.
+// It returns an empty string if no slug is involved.
+func sectionSlugsPath(p *pageState, desc page.TargetPathDescriptor) string {
+	cs := p.CurrentSection()
+	sections := append(cs.Ancestors().Reverse(), cs)
+
+	var hasSlug bool
+	elems := make([]string, 0, len(sections))
+	for _, sec := range sections {
+		if sec.IsHome() {
+			continue
+		}
+		if slug := sec.Slug(); slug != "" {
+			hasSlug = true
+			elems = append(elems, slug)
+			continue
+		}
+		pi := sec.PathInfo()
+		if p.s.Conf.DisablePathToLower() {
+			pi = pi.Unnormalized()
+		}
+		elems = append(elems, path.Base(pi.Base()))
+	}
+
+	if !hasSlug {
+		return ""
+	}
+
+	sectionsPath := path.Join(elems...)
+	if kinds.IsBranch(p.Kind()) {
+		return sectionsPath
+	}
+
+	rest := strings.TrimPrefix(desc.Path.ContainerDir(), desc.Section.Base())
+	return path.Join(sectionsPath, rest, desc.BaseName)
+}
