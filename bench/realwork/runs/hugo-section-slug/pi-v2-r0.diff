--- a/hugolib/page__paths.go
+++ b/hugolib/page__paths.go
@@ -16,6 +16,7 @@ package hugolib
 import (
 	"net/url"
 	"path"
+	"slices"
 	"strings"
 
 	"github.com/gohugoio/hugo/output"
@@ -132,7 +133,11 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 		URL:         pm.pageConfig.URL,
 	}
 
-	if pm.Slug() != "" {
+	if p.Kind() == kinds.KindPage || p.Kind() == kinds.KindSection || p.Kind() == kinds.KindTaxonomy || p.Kind() == kinds.KindTerm {
+		desc.SectionPath = sectionPathWithSlugs(p)
+	}
+
+	if pm.Slug() != "" && !kinds.IsBranch(p.Kind()) {
 		desc.BaseName = pm.Slug()
 	} else if pm.isStandalone() && pm.standaloneOutputFormat.BaseName != "" {
 		desc.BaseName = pm.standaloneOutputFormat.BaseName
@@ -207,3 +212,37 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 
 	return desc, nil
 }
+
+// sectionPathWithSlugs returns the path of the page's container (the page itself for
+// branch pages) with section slugs applied, or empty if no section has a slug.
+func sectionPathWithSlugs(p *pageState) string {
+	var sections page.Pages
+	if kinds.IsBranch(p.Kind()) {
+		sections = append(sections, p)
+	}
+	sections = append(sections, p.Ancestors()...)
+
+	var hasSlug bool
+	segments := make([]string, 0, len(sections))
+	for _, sp := range slices.Backward(sections) {
+		if sp.IsHome() {
+			continue
+		}
+		segment := sp.Slug()
+		if segment == "" {
+			pi := sp.PathInfo()
+			if p.s.Conf.DisablePathToLower() {
+				pi = pi.Unnormalized()
+			}
+			segment = path.Base(pi.Base())
+		} else {
+			hasSlug = true
+		}
+		segments = append(segments, segment)
+	}
+
+	if !hasSlug {
+		return ""
+	}
+	return strings.Join(segments, "/")
+}
