+
+package hugolib
+
+import (
+	"testing"
+)
+
+func TestSectionTaxonomyTermSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ["rss", "sitemap"]
+[taxonomies]
+tag = "tags"
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: Frob
+tags: [t1]
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Frob es
+slug: como-frobear
+tags: [t1]
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+slug: sub-es
+---
+-- content/help/sub/p1.es.md --
+---
+title: P1
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/t1/_index.es.md --
+---
+title: T1
+slug: et1
+---
+-- content/docs/_index.md --
+---
+title: Docs
+---
+-- content/docs/Mixed/_index.md --
+---
+title: Mixed
+slug: mixed-slug
+---
+-- content/docs/Mixed/Child/_index.md --
+---
+title: Child
+---
+-- content/docs/Mixed/Child/p.md --
+---
+title: P
+---
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}|
+`
+	b := Test(t, files)
+	b.AssertFileExists("public/help/index.html", true)
+	b.AssertFileExists("public/help/how-to-frob/index.html", true)
+	b.AssertFileExists("public/es/ayuda/index.html", true)
+	b.AssertFileExists("public/es/ayuda/como-frobear/index.html", true)
+	b.AssertFileExists("public/es/ayuda/sub-es/index.html", true)
+	b.AssertFileExists("public/es/ayuda/sub-es/p1/index.html", true)
+	b.AssertFileExists("public/es/etiquetas/index.html", true)
+	b.AssertFileExists("public/es/etiquetas/et1/index.html", true)
+	b.AssertFileExists("public/tags/t1/index.html", true)
+	b.AssertFileExists("public/docs/mixed-slug/child/index.html", true)
+	b.AssertFileExists("public/docs/mixed-slug/child/p/index.html", true)
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/etiquetas/et1/index.html", "term|/es/etiquetas/et1/|")
+}
