+// limitations under the License.
+
+package hugolib
+
+import "testing"
+
+func TestSectionSlugMultilingual(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+defaultContentLanguage = "en"
+[languages]
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: frob es
+slug: como-frobear
+---
+-- layouts/list.html --
+List: {{ .Title }}|{{ .RelPermalink }}|{{ range .Pages }}{{ .RelPermalink }} {{ end }}
+-- layouts/page.html --
+Page: {{ .Title }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/es/ayuda/index.html", "List: Ayuda|/es/ayuda/|/es/ayuda/como-frobear/ ")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Page: frob es|/es/ayuda/como-frobear/")
+	b.AssertFileContent("public/help/index.html", "List: Help|/help/|/help/how-to-frob/ ")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "Page: frob|/help/how-to-frob/")
+	b.AssertFileExists("public/es/help/index.html", false)
+}
+
+func TestSectionSlugNested(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+-- content/docs/_index.md --
+---
+title: Docs
+slug: documentation
+---
+-- content/docs/guides/_index.md --
+---
+title: Guides
+slug: handbook
+---
+-- content/docs/guides/frob/index.md --
+---
+title: Frob
+---
+-- content/docs/plain/_index.md --
+---
+title: Plain
+---
+-- content/docs/plain/p.md --
+---
+title: P
+---
+-- content/docs/misc/why/_index.md --
+---
+title: Why
+slug: why
+---
+-- layouts/list.html --
+List: {{ .Title }}|{{ .RelPermalink }}|
+-- layouts/page.html --
+Page: {{ .Title }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/documentation/index.html", "List: Docs|/documentation/|")
+	b.AssertFileContent("public/documentation/handbook/index.html", "List: Guides|/documentation/handbook/|")
+	b.AssertFileContent("public/documentation/handbook/frob/index.html", "Page: Frob|/documentation/handbook/frob/|")
+	b.AssertFileContent("public/documentation/plain/p/index.html", "Page: P|/documentation/plain/p/|")
+	b.AssertFileContent("public/documentation/misc/why/index.html", "List: Why|/documentation/misc/why/|")
+	b.AssertFileExists("public/docs/index.html", false)
+}
+
+func TestSectionSlugDisablePathToLower(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disablePathToLower = true
+-- content/Docs/_index.md --
+---
+title: Docs
+---
+-- content/Docs/Guides/_index.md --
+---
+title: Guides
+slug: Handbook
+---
+-- content/Docs/Guides/Frob/index.md --
+---
+title: Frob
+---
+-- layouts/list.html --
+List: {{ .Title }}|{{ .RelPermalink }}|
+-- layouts/page.html --
+Page: {{ .Title }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/Docs/Handbook/index.html", "List: Guides|/Docs/Handbook/|")
+	b.AssertFileContent("public/Docs/Handbook/Frob/index.html", "Page: Frob|/Docs/Handbook/Frob/|")
+}
+
+func TestSectionSlugTaxonomyAndTerm(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+-- content/tags/_index.md --
+---
+title: Tags
+slug: etiquetas
+---
+-- content/tags/foo/_index.md --
+---
+title: Foo
+slug: bar
+---
+-- content/posts/p1.md --
+---
+title: P1
+tags: ["foo", "qux"]
+---
+-- layouts/list.html --
+List: {{ .Kind }}|{{ .RelPermalink }}|
+-- layouts/page.html --
+Page: {{ .Title }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/etiquetas/index.html", "List: taxonomy|/etiquetas/|")
+	b.AssertFileContent("public/etiquetas/bar/index.html", "List: term|/etiquetas/bar/|")
+	b.AssertFileContent("public/etiquetas/qux/index.html", "List: term|/etiquetas/qux/|")
+	b.AssertFileExists("public/tags/index.html", false)
+}
