+
+// applySectionSlugs returns dir with the slug of each section in its path applied,
+// e.g. "/ayuda/como-frobear" for "/help/how-to-frob" with the slugs "ayuda" and "como-frobear".
+// The lookup uses normDir, dir may be unnormalized (see DisablePathToLower).
+func (p *pageState) applySectionSlugs(normDir, dir string) string {
+	if normDir == "/" {
+		// The home page has no segment in the path.
+		return dir
+	}
+
+	normSegs := strings.Split(normDir, "/")
+	segs := strings.Split(dir, "/")
+	for i := 1; i < len(normSegs); i++ {
+		sectionDir := strings.Join(normSegs[:i+1], "/")
+		if k, n := p.s.pageMap.treePages.LongestPrefix(sectionDir, false, func(n contentNode) bool { return cnh.isBranchNode(n) }); n != nil && k == sectionDir {
+			if slug := n.(page.Page).Slug(); slug != "" {
+				segs[i] = slug
+			}
+		}
+	}
+
+	return strings.Join(segs, "/")
+}
diff --git a/hugolib/section_slug_test.go b/hugolib/section_slug_test.go
