+
+// dirWithSlugs returns the target directory of p with any section slugs applied.
+func (p *pageState) dirWithSlugs() string {
+	switch {
+	case kinds.IsBranch(p.Kind()):
+		return p.sectionPathWithSlugs()
+	case p.Kind() == kinds.KindPage:
+		cs, ok := p.CurrentSection().(*pageState)
+		if !ok {
+			return ""
+		}
+		dir := p.targetPathInfo().ContainerDir()
+		csBase := cs.targetPathInfo().Base()
+		if dir != csBase && !strings.HasPrefix(dir, csBase+"/") {
+			return dir
+		}
+		return cs.sectionPathWithSlugs() + dir[len(csBase):]
+	default:
+		return ""
+	}
+}
+
+// sectionPathWithSlugs returns the path of the branch node p with any slug
+// set on p or its ancestors applied.
+func (p *pageState) sectionPathWithSlugs() string {
+	base := p.targetPathInfo().Base()
+	if p.IsHome() {
+		return base
+	}
+	parent, ok := p.Parent().(*pageState)
+	if !ok {
+		return base
+	}
+	parentBase := parent.targetPathInfo().Base()
+	if !strings.HasPrefix(base, parentBase+"/") {
+		return base
+	}
+	rel := base[len(parentBase):]
+	if slug := p.m.Slug(); slug != "" {
+		rel = path.Join(path.Dir(rel), slug)
+	}
+	return parent.sectionPathWithSlugs() + rel
+}
+
+func (p *pageState) targetPathInfo() *paths.Path {
+	if p.s.Conf.DisablePathToLower() {
+		return p.PathInfo().Unnormalized()
+	}
+	return p.PathInfo()
+}
