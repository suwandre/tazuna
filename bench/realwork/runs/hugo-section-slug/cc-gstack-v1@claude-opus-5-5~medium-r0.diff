index d5ae693..c056390 100644
--- a/hugolib/page_permalink_test.go
+++ b/hugolib/page_permalink_test.go
@@ -201,3 +201,67 @@ path = '/books/**'
 
 	b.AssertFileContent("public/shelf/my-book/index.html", "RelPermalink: /shelf/my-book/")
 }
+
+func TestSlugInSectionTaxonomyAndTerm(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ['rss','sitemap']
+defaultContentLanguage = 'en'
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+---
+-- content/help/sub/p1.es.md --
+---
+title: P1
+tags: [foo]
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: fu
+---
+-- layouts/all.html --
+{{ .Title }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "Help|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "How to frob|/help/how-to-frob/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "Ayuda|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Como frobear|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/sub/index.html", "Sub|/es/ayuda/sub/|")
+	b.AssertFileContent("public/es/ayuda/sub/p1/index.html", "P1|/es/ayuda/sub/p1/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "Etiquetas|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "Foo|/es/etiquetas/fu/|")
+}
