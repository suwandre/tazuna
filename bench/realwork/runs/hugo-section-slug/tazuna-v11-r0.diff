 	if pm.Slug() != "" {
 		desc.BaseName = pm.Slug()
 	} else if pm.isStandalone() && pm.standaloneOutputFormat.BaseName != "" {
@@ -207,3 +209,37 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 
 	return desc, nil
 }
+
+// sectionSlugsDir returns the dir of p with any section slugs applied
+// or an empty string if no slugs are in play.
+func sectionSlugsDir(p *pageState, desc page.TargetPathDescriptor) string {
+	var dir string
+	sections := p.Ancestors()
+	switch p.Kind() {
+	case kinds.KindPage:
+		dir = desc.Path.ContainerDir()
+	case kinds.KindSection, kinds.KindTaxonomy, kinds.KindTerm:
+		dir = desc.Section.Base()
+		sections = append(page.Pages{p}, sections...)
+	default:
+		return ""
+	}
+
+	slugs := make(map[int]string)
+	for _, s := range sections {
+		if slug := s.Slug(); slug != "" && !s.IsHome() {
+			slugs[strings.Count(s.Path(), "/")] = slug
+		}
+	}
+	if len(slugs) == 0 {
+		return ""
+	}
+
+	elems := strings.Split(strings.Trim(dir, "/"), "/")
+	for i := range elems {
+		if slug, ok := slugs[i+1]; ok {
+			elems[i] = slug
+		}
+	}
+	return strings.Join(elems, "/")
+}
diff --git a/hugolib/page_permalink_test.go b/hugolib/page_permalink_test.go
index d5ae693..5663d38 100644
--- a/hugolib/page_permalink_test.go
+++ b/hugolib/page_permalink_test.go
@@ -201,3 +201,79 @@ path = '/books/**'
 
 	b.AssertFileContent("public/shelf/my-book/index.html", "RelPermalink: /shelf/my-book/")
 }
+
+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ["rss", "sitemap"]
+[taxonomies]
+tag = "tags"
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+slug: sub-es
+---
+-- content/help/sub/page.es.md --
+---
+title: Page
+tags: ["a"]
+---
+-- content/help/sub/page.en.md --
+---
+title: Page
+tags: ["a"]
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/a/_index.es.md --
+---
+title: A
+slug: aa
+---
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "section|/help/")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "page|/help/how-to-frob/")
+	b.AssertFileContent("public/help/sub/page/index.html", "page|/help/sub/page/")
+	b.AssertFileContent("public/es/ayuda/index.html", "section|/es/ayuda/")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|/es/ayuda/como-frobear/")
+	b.AssertFileContent("public/es/ayuda/sub-es/index.html", "section|/es/ayuda/sub-es/")
+	b.AssertFileContent("public/es/ayuda/sub-es/page/index.html", "page|/es/ayuda/sub-es/page/")
+	b.AssertFileContent("public/es/etiquetas/index.html", "taxonomy|/es/etiquetas/")
+	b.AssertFileContent("public/es/etiquetas/aa/index.html", "term|/es/etiquetas/aa/")
+	b.AssertFileContent("public/tags/a/index.html", "term|/tags/a/")
+}
