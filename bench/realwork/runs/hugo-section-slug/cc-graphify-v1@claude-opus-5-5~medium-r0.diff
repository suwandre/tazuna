@@ -207,3 +218,17 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 
 	return desc, nil
 }
+
+// sectionBaseWithSlugs returns the base path of the branch node p with any
+// slug set on p or its ancestors applied.
+func sectionBaseWithSlugs(p page.Page, pathInfo func(page.Page) *paths.Path) string {
+	parent := p.Parent()
+	if parent == nil {
+		return pathInfo(p).Base()
+	}
+	rel := strings.TrimPrefix(pathInfo(p).Base(), pathInfo(parent).Base())
+	if slug := p.Slug(); slug != "" {
+		rel = path.Join(path.Dir(rel), slug)
+	}
+	return path.Join(sectionBaseWithSlugs(parent, pathInfo), rel)
+}
diff --git a/hugolib/page_permalink_test.go b/hugolib/page_permalink_test.go
index d5ae693..53c5ada 100644
--- a/hugolib/page_permalink_test.go
+++ b/hugolib/page_permalink_test.go
@@ -201,3 +201,69 @@ path = '/books/**'
 
 	b.AssertFileContent("public/shelf/my-book/index.html", "RelPermalink: /shelf/my-book/")
 }
+
+func TestSlugInSectionTaxonomyAndTermPages(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com/"
+disableKinds = ["rss", "sitemap", "robotsTXT", "404"]
+defaultContentLanguage = "en"
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+tags: [foo]
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+slug: subayuda
+---
+-- content/help/sub/deep/p1.es.md --
+---
+title: P1
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: fu
+---
+-- layouts/all.html --
+{{ .Title }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "Help|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "How to frob|/help/how-to-frob/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "Ayuda|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Como frobear|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/subayuda/index.html", "Sub|/es/ayuda/subayuda/|")
+	b.AssertFileContent("public/es/ayuda/subayuda/deep/p1/index.html", "P1|/es/ayuda/subayuda/deep/p1/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "Etiquetas|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "Foo|/es/etiquetas/fu/|")
+}
