+// sectionBaseWithSlugs returns the path of section with each section's slug
+// replacing its directory name, or "" if no section in the chain has a slug.
+func sectionBaseWithSlugs(section page.Page) string {
+	chain := append(section.Ancestors().Reverse(), section)
+	var hasSlug bool
+	var b strings.Builder
+	for _, s := range chain {
+		if s.IsHome() {
+			continue
+		}
+		name := s.Slug()
+		if name != "" {
+			hasSlug = true
+		} else {
+			name = path.Base(s.PathInfo().Base())
+		}
+		b.WriteString("/" + name)
+	}
+	if !hasSlug {
+		return ""
+	}
+	return b.String()
+}
