+// sectionDirWithSlugs returns the directory of the branch node p with the slugs
+// of p and its ancestors applied, and whether any slug was applied.
+func sectionDirWithSlugs(p *pageState) (dir string, slugged bool) {
+	if p.IsHome() {
+		return "", false
+	}
+	base := p.sectionBase()
+	var parentBase string
+	if parent, ok := p.Parent().(*pageState); ok && !parent.IsHome() {
+		parentBase = parent.sectionBase()
+		dir, slugged = sectionDirWithSlugs(parent)
+	}
+	rel := strings.TrimPrefix(base, parentBase)
+	if slug := p.m.Slug(); slug != "" {
+		rel = path.Join(path.Dir(rel), slug)
+		slugged = true
+	}
+	return dir + rel, slugged
+}
+
+func (p *pageState) sectionBase() string {
+	pi := p.PathInfo()
+	if p.s.Conf.DisablePathToLower() {
+		pi = pi.Unnormalized()
+	}
+	return pi.Base()
+}
