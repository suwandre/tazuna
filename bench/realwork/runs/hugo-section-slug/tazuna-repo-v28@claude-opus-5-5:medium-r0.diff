+func TestSlugInSectionTaxonomyAndTermPages(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["rss", "sitemap", "robotsTXT", "404"]
+defaultContentLanguage = "en"
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+[taxonomies]
+tag = "tags"
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+tags: [foo]
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+tags: [foo]
+---
+-- content/help/how-to-frob/data.es.txt --
+data
+-- content/help/plain.es.md --
+---
+title: Plain
+---
+-- content/help/nosection/p1.es.md --
+---
+title: P1
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+---
+-- content/help/sub/p2.es.md --
+---
+title: P2
+---
+-- content/help/sub/deeper/_index.es.md --
+---
+title: Deeper
+slug: mas-profundo
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: fu
+---
+-- layouts/all.html --
+{{ .Title }}|{{ .RelPermalink }}|{{ range .Resources }}{{ .RelPermalink }}{{ end }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "Help|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "How to frob|/help/how-to-frob/|")
+	b.AssertFileContent("public/tags/foo/index.html", "|/tags/foo/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "Ayuda|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Como frobear|/es/ayuda/como-frobear/|/es/ayuda/como-frobear/data.es.txt")
+	b.AssertFileContent("public/es/ayuda/plain/index.html", "Plain|/es/ayuda/plain/|")
+	b.AssertFileContent("public/es/ayuda/nosection/p1/index.html", "P1|/es/ayuda/nosection/p1/|")
+	b.AssertFileContent("public/es/ayuda/sub/index.html", "Sub|/es/ayuda/sub/|")
+	b.AssertFileContent("public/es/ayuda/sub/p2/index.html", "P2|/es/ayuda/sub/p2/|")
+	b.AssertFileContent("public/es/ayuda/sub/mas-profundo/index.html", "Deeper|/es/ayuda/sub/mas-profundo/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "Etiquetas|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "Foo|/es/etiquetas/fu/|")
+}
