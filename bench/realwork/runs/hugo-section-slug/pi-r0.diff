@@ -207,3 +208,46 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 
 	return desc, nil
 }
+
+// sectionDirWithSlugs returns the path of p's current section with section slugs
+// applied, or an empty string if none of the sections has a slug.
+func sectionDirWithSlugs(p *pageState) string {
+	cs := p.CurrentSection()
+	sections := append(cs.Ancestors().Reverse(), cs)
+
+	var (
+		elems   []string
+		hasSlug bool
+	)
+	for _, sec := range sections {
+		if sec.IsHome() {
+			continue
+		}
+		if slug := sec.Slug(); slug != "" {
+			hasSlug = true
+			elems = append(elems, slug)
+			continue
+		}
+		pi := sec.PathInfo()
+		if p.s.Conf.DisablePathToLower() {
+			pi = pi.Unnormalized()
+		}
+		elems = append(elems, pi.BaseNameNoIdentifier())
+	}
+
+	if !hasSlug {
+		return ""
+	}
+
+	if !kinds.IsBranch(p.Kind()) {
+		// Dirs below the current section without a section page of their own.
+		pi, csPi := p.PathInfo(), cs.PathInfo()
+		if p.s.Conf.DisablePathToLower() {
+			pi, csPi = pi.Unnormalized(), csPi.Unnormalized()
+		}
+		rest := strings.TrimPrefix(pi.ContainerDir(), csPi.Base())
+		elems = append(elems, strings.Trim(rest, "/"))
+	}
+
+	return "/" + path.Join(elems...)
+}
