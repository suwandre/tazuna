+// limitations under the License.
+
+package hugolib
+
+import "testing"
+
+// TestSectionTaxonomyTermSlug tests slug in section, taxonomy and term pages.
+func TestSectionTaxonomyTermSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ["rss", "sitemap"]
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+[taxonomies]
+tag = "tags"
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: Frob
+tags: [a]
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Frobear
+slug: como-frobear
+tags: [a]
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+slug: sub-es
+---
+-- content/help/sub/page.es.md --
+---
+title: Page
+---
+-- content/help/other/page.es.md --
+---
+title: Other
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/a/_index.es.md --
+---
+title: A
+slug: aa
+---
+-- layouts/all.html --
+{{ .Title }}|{{ .RelPermalink }}
+`
+	b := Test(t, files)
+
+	b.AssertFileExists("public/help/index.html", true)
+	b.AssertFileExists("public/help/how-to-frob/index.html", true)
+	b.AssertFileExists("public/es/ayuda/index.html", true)
+	b.AssertFileExists("public/es/ayuda/como-frobear/index.html", true)
+	b.AssertFileExists("public/es/ayuda/sub-es/index.html", true)
+	b.AssertFileExists("public/es/ayuda/sub-es/page/index.html", true)
+	b.AssertFileExists("public/es/ayuda/other/page/index.html", true)
+	b.AssertFileExists("public/es/help/index.html", false)
+	b.AssertFileExists("public/es/etiquetas/index.html", true)
+	b.AssertFileExists("public/es/etiquetas/aa/index.html", true)
+	b.AssertFileExists("public/tags/a/index.html", true)
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Frobear|/es/ayuda/como-frobear/")
+}
