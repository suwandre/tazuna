+// sectionDirWithSlugs returns dir with the elements owned by cs and its
+// ancestor sections replaced by their slugs, or an empty string if none has a slug.
+func sectionDirWithSlugs(cs page.Page, dir string) string {
+	els := strings.Split(strings.Trim(dir, "/"), "/")
+	var found bool
+	for _, s := range append(page.Pages{cs}, cs.Ancestors()...) {
+		if s.IsHome() || s.Slug() == "" {
+			continue
+		}
+		if i := len(s.SectionsEntries()) - 1; i >= 0 && i < len(els) {
+			els[i] = s.Slug()
+			found = true
+		}
+	}
+	if !found {
+		return ""
+	}
+	return "/" + strings.Join(els, "/")
+}
