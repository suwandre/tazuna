+// See issue 5090.
+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+defaultContentLanguage = 'en'
+disableKinds = ['rss','sitemap']
+[languages.en]
+[languages.es]
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+---
+-- content/help/faq.en.md --
+---
+title: FAQ
+---
+-- content/help/faq.es.md --
+---
+title: FAQ
+---
+-- content/help/sub/deep/_index.es.md --
+---
+title: Deep
+---
+-- content/help/sub/deep/p1.es.md --
+---
+title: P1
+---
+-- layouts/all.html --
+{{ .Title }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "Help|/help/")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "How to frob|/help/how-to-frob/")
+	b.AssertFileContent("public/help/faq/index.html", "FAQ|/help/faq/")
+	b.AssertFileContent("public/es/ayuda/index.html", "Ayuda|/es/ayuda/")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Como frobear|/es/ayuda/como-frobear/")
+	b.AssertFileContent("public/es/ayuda/faq/index.html", "FAQ|/es/ayuda/faq/")
+	b.AssertFileContent("public/es/ayuda/sub/deep/index.html", "Deep|/es/ayuda/sub/deep/")
+	b.AssertFileContent("public/es/ayuda/sub/deep/p1/index.html", "P1|/es/ayuda/sub/deep/p1/")
+	b.AssertFileExists("public/es/help", false)
+}
+
+func TestSectionSlugUglyURLs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ['home','rss','sitemap','taxonomy','term']
+uglyURLs = true
+-- content/s1/_index.md --
+---
+title: S1
+slug: s1-slug
+---
+-- content/s1/p1.md --
+---
+title: P1
+---
+-- layouts/all.html --
+{{ .Title }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/s1-slug/index.html", "S1|/s1-slug/")
+	b.AssertFileContent("public/s1-slug/p1.html", "P1|/s1-slug/p1.html")
+}
+
+func TestTaxonomyAndTermSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ['home','rss','sitemap']
+[taxonomies]
+tag = 'tags'
+-- content/tags/_index.md --
+---
+title: Tags
+slug: labels
+---
+-- content/tags/hugo/_index.md --
+---
+title: Hugo
+slug: hugo-slug
+---
+-- content/tags/go/_index.md --
+---
+title: Go
+---
+-- content/p1.md --
+---
+title: P1
+tags: [hugo, go]
+---
+-- layouts/all.html --
+{{ .Title }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/labels/index.html", "Tags|/labels/")
+	b.AssertFileContent("public/labels/hugo-slug/index.html", "Hugo|/labels/hugo-slug/")
+	b.AssertFileContent("public/labels/go/index.html", "Go|/labels/go/")
+}
