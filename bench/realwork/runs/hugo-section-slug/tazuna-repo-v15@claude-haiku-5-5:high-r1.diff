+package hugolib
+
+import (
+	"testing"
+)
+
+func TestSectionSlugMultilingual(t *testing.T) {
+	files := `
+-- hugo.toml --
+[languages]
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+---
+-- layouts/list.html --
+List: {{ .RelPermalink }}|{{ with .Site.GetPage "/help/how-to-frob" }}{{ .RelPermalink }}{{ end }}
+-- layouts/page.html --
+Page: {{ .RelPermalink }}|{{ with .Site.GetPage "/help/how-to-frob" }}{{ .RelPermalink }}{{ end }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "List: /help/|/help/how-to-frob/")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "Page: /help/how-to-frob/|/help/how-to-frob/")
+	b.AssertFileContent("public/es/ayuda/index.html", "List: /es/ayuda/|/es/ayuda/como-frobear/")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Page: /es/ayuda/como-frobear/|/es/ayuda/como-frobear/")
+	b.AssertFileExists("public/es/help/index.html", false)
+	b.AssertFileExists("public/es/ayuda/how-to-frob/index.html", false)
+}
+
+func TestSectionSlugNested(t *testing.T) {
+	files := `
+-- hugo.toml --
+-- content/a/_index.md --
+---
+slug: x
+---
+-- content/a/b/_index.md --
+---
+slug: y
+---
+-- content/a/b/c/p.md --
+-- content/a/b/d/index.md --
+-- content/a/e/p.md --
+-- layouts/list.html --
+List: {{ .RelPermalink }}
+-- layouts/page.html --
+Page: {{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/x/index.html", "List: /x/")
+	b.AssertFileContent("public/x/y/index.html", "List: /x/y/")
+	b.AssertFileContent("public/x/y/c/p/index.html", "Page: /x/y/c/p/")
+	b.AssertFileContent("public/x/y/d/index.html", "Page: /x/y/d/")
+	b.AssertFileContent("public/x/e/p/index.html", "Page: /x/e/p/")
+	b.AssertFileExists("public/a/index.html", false)
+	b.AssertFileExists("public/a/b/index.html", false)
+}
+
+func TestTaxonomyAndTermSlug(t *testing.T) {
+	files := `
+-- hugo.toml --
+-- content/tags/_index.md --
+---
+slug: etiketten
+---
+-- content/tags/go/_index.md --
+---
+slug: golang
+---
+-- content/post/p1.md --
+---
+tags: [go, hugo]
+---
+-- layouts/taxonomy.html --
+Taxonomy: {{ .RelPermalink }}
+-- layouts/term.html --
+Term: {{ .RelPermalink }}
+-- layouts/page.html --
+Page: {{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/etiketten/index.html", "Taxonomy: /etiketten/")
+	b.AssertFileContent("public/etiketten/golang/index.html", "Term: /etiketten/golang/")
+	b.AssertFileContent("public/etiketten/hugo/index.html", "Term: /etiketten/hugo/")
+	b.AssertFileContent("public/post/p1/index.html", "Page: /post/p1/")
+	b.AssertFileExists("public/tags/index.html", false)
+	b.AssertFileExists("public/tags/go/index.html", false)
+}
