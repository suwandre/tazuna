+// pathInfoWithBranchSlugs returns pi with the elements of its branch ancestors
+// (sections, taxonomies, terms; itself included) replaced by their slugs.
+func (s *Site) pathInfoWithBranchSlugs(pi *paths.Path) *paths.Path {
+	var elems []string
+	dir := pi.Dir()
+	for dir != "/" && dir != "" {
+		key, n := s.pageMap.treePages.LongestPrefix(dir, false, cnh.isBranchNode)
+		if n == nil {
+			break
+		}
+		if slug := n.(page.Page).Slug(); slug != "" {
+			if elems == nil {
+				elems = strings.Split(pi.Unnormalized().Path(), "/")
+			}
+			elems[strings.Count(key, "/")] = slug
+		}
+		dir = paths.Dir(key)
+	}
+	if elems == nil {
+		return pi
+	}
+	return s.h.Conf.PathParser().Parse(pi.Component(), strings.Join(elems, "/"))
+}
