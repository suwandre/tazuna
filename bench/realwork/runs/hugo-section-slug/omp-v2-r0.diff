@@ -207,3 +211,39 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 
 	return desc, nil
 }
+
+// sectionSlugDir returns the section dir of p with any section slugs applied,
+// or "" if none of the sections has a slug.
+func sectionSlugDir(p *pageState, desc page.TargetPathDescriptor) string {
+	sections := make(page.Pages, 0, 4)
+	for _, a := range p.Ancestors() {
+		if kinds.IsBranch(a.Kind()) && !a.IsHome() {
+			sections = append(sections, a)
+		}
+	}
+
+	var dir string
+	if kinds.IsBranch(p.Kind()) {
+		sections = append(sections, p)
+		dir = desc.Section.Base()
+	} else {
+		dir = desc.Path.ContainerDir()
+	}
+
+	segments := strings.Split(strings.Trim(dir, "/"), "/")
+	var found bool
+	for _, s := range sections {
+		slug := s.Slug()
+		if slug == "" {
+			continue
+		}
+		if i := strings.Count(s.Path(), "/") - 1; i >= 0 && i < len(segments) {
+			segments[i] = slug
+			found = true
+		}
+	}
+	if !found {
+		return ""
+	}
+	return "/" + strings.Join(segments, "/")
+}
