+// dirWithSectionSlugs returns dir with the segments of any slugged sections
+// (the current section and its ancestors) replaced by their slugs.
+// It returns an empty string if no slug applies.
+func (p *pageState) dirWithSectionSlugs(dir string) string {
+	section := p.CurrentSection()
+	var segments []string
+	for _, s := range append(page.Pages{section}, section.Ancestors()...) {
+		if s.Slug() == "" || s.IsHome() {
+			continue
+		}
+		if segments == nil {
+			segments = strings.Split(strings.Trim(dir, "/"), "/")
+		}
+		if i := strings.Count(s.Path(), "/") - 1; i < len(segments) {
+			segments[i] = s.Slug()
+		}
+	}
+	if segments == nil {
+		return ""
+	}
+	return "/" + strings.Join(segments, "/")
+}
