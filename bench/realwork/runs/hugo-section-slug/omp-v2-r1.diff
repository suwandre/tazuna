+
+package hugolib
+
+import "testing"
+
+func TestSlugInSectionsAndDescendants(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ["taxonomy", "term", "RSS", "sitemap", "robotsTXT"]
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: Frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Frobear
+slug: como-frobear
+---
+-- content/help/deep/_index.es.md --
+---
+title: Profundo
+---
+-- content/help/deep/page.es.md --
+---
+title: Deep page
+---
+-- content/help/deep/sub/_index.es.md --
+---
+title: Sub
+slug: sub-slug
+---
+-- content/help/deep/sub/page.es.md --
+---
+title: Sub page
+---
+-- layouts/page.html --
+{{ .Title }}|{{ .RelPermalink }}|
+-- layouts/section.html --
+{{ .Title }}|{{ .RelPermalink }}|
+-- layouts/home.html --
+Home|{{ range site.Pages }}{{ .RelPermalink }}|{{ end }}
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "Help|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "Frob|/help/how-to-frob/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "Ayuda|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Frobear|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/deep/index.html", "Profundo|/es/ayuda/deep/|")
+	b.AssertFileContent("public/es/ayuda/deep/page/index.html", "Deep page|/es/ayuda/deep/page/|")
+	b.AssertFileContent("public/es/ayuda/deep/sub-slug/index.html", "Sub|/es/ayuda/deep/sub-slug/|")
+	b.AssertFileContent("public/es/ayuda/deep/sub-slug/page/index.html", "Sub page|/es/ayuda/deep/sub-slug/page/|")
+	b.AssertFileExists("public/es/help/index.html", false)
+}
+
+func TestSlugInSectionUglyURLs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com"
+uglyURLs = true
+disableKinds = ["taxonomy", "term", "RSS", "sitemap", "robotsTXT", "home"]
+-- content/help/_index.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/p1.md --
+---
+title: P1
+---
+-- layouts/page.html --
+{{ .Title }}|{{ .RelPermalink }}|
+-- layouts/section.html --
+{{ .Title }}|{{ .RelPermalink }}|
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/ayuda/index.html", "Ayuda|/ayuda/index.html|")
+	b.AssertFileContent("public/ayuda/p1.html", "P1|/ayuda/p1.html|")
+}
+
+func TestSlugInTaxonomyAndTermPages(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com"
+disableKinds = ["RSS", "sitemap", "robotsTXT", "home"]
+[taxonomies]
+tag = "tags"
+-- content/tags/_index.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.md --
+---
+title: Foo
+slug: fu
+---
+-- content/tags/bar/_index.md --
+---
+title: Bar
+---
+-- content/p1.md --
+---
+title: P1
+tags: [foo, bar]
+---
+-- layouts/page.html --
+{{ .Title }}|{{ range .GetTerms "tags" }}{{ .RelPermalink }}|{{ end }}
+-- layouts/taxonomy.html --
+{{ .Title }}|{{ .RelPermalink }}|
+-- layouts/term.html --
+{{ .Title }}|{{ .RelPermalink }}|
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/etiquetas/index.html", "Etiquetas|/etiquetas/|")
+	b.AssertFileContent("public/etiquetas/fu/index.html", "Foo|/etiquetas/fu/|")
+	b.AssertFileContent("public/etiquetas/bar/index.html", "Bar|/etiquetas/bar/|")
+	b.AssertFileContent("public/p1/index.html", "P1|/etiquetas/fu/|/etiquetas/bar/|")
+}
