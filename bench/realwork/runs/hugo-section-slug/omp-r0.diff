+
+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com/"
+defaultContentLanguage = "en"
+disableKinds = ['rss','sitemap']
+[languages.en]
+[languages.es]
+-- content/help/_index.en.md --
+-- content/help/_index.es.md --
+---
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+-- content/help/how-to-frob/index.es.md --
+---
+slug: como-frobear
+---
+-- content/help/faq/_index.es.md --
+---
+slug: preguntas
+---
+-- content/help/faq/q1.en.md --
+-- content/help/faq/q1.es.md --
+-- content/help/deep/er/p1.en.md --
+-- content/help/deep/er/p1.es.md --
+-- content/help/deep/er/p2/index.es.md --
+-- layouts/list.html --
+List: {{ .RelPermalink }}|
+-- layouts/page.html --
+Page: {{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "List: /help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "Page: /help/how-to-frob/|")
+	b.AssertFileContent("public/help/faq/q1/index.html", "Page: /help/faq/q1/|")
+	b.AssertFileContent("public/help/deep/er/p1/index.html", "Page: /help/deep/er/p1/|")
+
+	b.AssertFileContent("public/es/ayuda/index.html", "List: /es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Page: /es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/preguntas/index.html", "List: /es/ayuda/preguntas/|")
+	b.AssertFileContent("public/es/ayuda/preguntas/q1/index.html", "Page: /es/ayuda/preguntas/q1/|")
+	b.AssertFileContent("public/es/ayuda/deep/er/p1/index.html", "Page: /es/ayuda/deep/er/p1/|")
+	b.AssertFileContent("public/es/ayuda/deep/er/p2/index.html", "Page: /es/ayuda/deep/er/p2/|")
+	b.AssertFileExists("public/es/help/index.html", false)
+}
+
+func TestTaxonomyAndTermSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com/"
+disableKinds = ['rss','sitemap']
+-- content/tags/_index.md --
+---
+slug: etiquetas
+---
+-- content/tags/hugo/_index.md --
+---
+slug: h
+---
+-- content/p1.md --
+---
+tags: [hugo, go]
+---
+-- layouts/list.html --
+List: {{ .Kind }}|{{ .RelPermalink }}|
+-- layouts/page.html --
+Page: {{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/etiquetas/index.html", "List: taxonomy|/etiquetas/|")
+	b.AssertFileContent("public/etiquetas/h/index.html", "List: term|/etiquetas/h/|")
+	b.AssertFileContent("public/etiquetas/go/index.html", "List: term|/etiquetas/go/|")
+	b.AssertFileExists("public/tags/index.html", false)
+}
