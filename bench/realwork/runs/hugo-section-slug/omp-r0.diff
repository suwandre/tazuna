+
+// dirWithSectionSlugs returns dir with the path elements of the current section
+// and its ancestors replaced by their slugs.
+// It returns an empty string if no section has a slug.
+func (p *pageState) dirWithSectionSlugs(dir string) string {
+	var elems []string
+	for sec := p.CurrentSection(); sec != nil && !sec.IsHome(); sec = sec.Parent() {
+		slug := sec.Slug()
+		if slug == "" {
+			continue
+		}
+		if elems == nil {
+			elems = strings.Split(strings.Trim(dir, "/"), "/")
+		}
+		if i := strings.Count(sec.PathInfo().Base(), "/") - 1; i >= 0 && i < len(elems) {
+			elems[i] = slug
+		}
+	}
+	if elems == nil {
+		return ""
+	}
+	return "/" + strings.Join(elems, "/")
+}
