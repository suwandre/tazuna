+// slugDir returns the directory of p with the slugs of its section (and, for
+// branch pages, its own slug) replacing the corresponding path elements.
+// It returns an empty string if there are no slugs to apply.
+func slugDir(p *pageState, pagePath, sectionPath *paths.Path) string {
+	isBranch := kinds.IsBranch(p.Kind())
+	dir := pagePath.ContainerDir()
+	if isBranch {
+		dir = sectionPath.Base()
+	}
+
+	elems := strings.Split(strings.Trim(dir, "/"), "/")
+	var replaced bool
+	replace := func(pg page.Page) {
+		if pg.IsHome() || pg.Slug() == "" {
+			return
+		}
+		if i := strings.Count(strings.Trim(pg.Path(), "/"), "/"); i < len(elems) {
+			elems[i] = pg.Slug()
+			replaced = true
+		}
+	}
+
+	if isBranch {
+		replace(p)
+	}
+	for _, a := range p.Ancestors() {
+		replace(a)
+	}
+
+	if !replaced {
+		return ""
+	}
+	return "/" + strings.Join(elems, "/")
+}
