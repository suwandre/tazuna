+func TestSlugInSectionTaxonomyAndTerm(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+disableKinds = ["rss", "sitemap"]
+[taxonomies]
+tag = "tags"
+-- content/help/_index.md --
+---
+title: Help
+slug: ayuda
+---
+-- content/help/faq.md --
+-- content/help/how-to-frob/index.md --
+---
+title: Frob
+slug: como-frobear
+tags: [a]
+---
+-- content/help/sub/_index.md --
+---
+title: Sub
+---
+-- content/help/sub/p.md --
+-- content/tags/_index.md --
+---
+title: Tags
+slug: etiquetas
+---
+-- content/tags/a/_index.md --
+---
+title: A
+slug: eh
+---
+-- layouts/all.html --
+{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/ayuda/index.html", "/ayuda/|")
+	b.AssertFileContent("public/ayuda/faq/index.html", "/ayuda/faq/|")
+	b.AssertFileContent("public/ayuda/como-frobear/index.html", "/ayuda/como-frobear/|")
+	b.AssertFileContent("public/ayuda/sub/index.html", "/ayuda/sub/|")
+	b.AssertFileContent("public/ayuda/sub/p/index.html", "/ayuda/sub/p/|")
+	b.AssertFileContent("public/etiquetas/index.html", "/etiquetas/|")
+	b.AssertFileContent("public/etiquetas/eh/index.html", "/etiquetas/eh/|")
+}
