+// sectionSlugsPath returns the path of p with the slug of any branch
+// ancestor (or p itself) replacing its path segment(s).
+// It returns "" if no slug is involved.
+func sectionSlugsPath(p *pageState, baseName string) string {
+	isBranch := kinds.IsBranch(p.Kind())
+	if !isBranch && p.Kind() != kinds.KindPage {
+		return ""
+	}
+
+	unnormalized := p.s.Conf.DisablePathToLower()
+	basePath := func(pp page.Page) string {
+		pi := pp.PathInfo()
+		if unnormalized {
+			pi = pi.Unnormalized()
+		}
+		return pi.Base()
+	}
+
+	chain := p.Ancestors().Reverse()
+	if isBranch {
+		chain = append(chain, p)
+	}
+
+	var (
+		hasSlug bool
+		prev    string
+		b       strings.Builder
+	)
+	add := func(s string) {
+		if s = strings.Trim(s, "/"); s != "" {
+			b.WriteString("/")
+			b.WriteString(s)
+		}
+	}
+	for _, n := range chain {
+		if n.IsHome() {
+			continue
+		}
+		base := basePath(n)
+		if slug := n.Slug(); slug != "" {
+			hasSlug = true
+			add(slug)
+		} else {
+			add(strings.TrimPrefix(base, prev))
+		}
+		prev = base
+	}
+
+	if !hasSlug {
+		return ""
+	}
+
+	if !isBranch {
+		pi := p.PathInfo()
+		if unnormalized {
+			pi = pi.Unnormalized()
+		}
+		add(strings.TrimPrefix(pi.ContainerDir(), prev))
+		add(baseName)
+	}
+
+	return b.String()
+}
