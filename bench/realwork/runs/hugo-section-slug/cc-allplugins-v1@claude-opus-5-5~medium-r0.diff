+// sectionSlugPath returns base with the path elements of sect and its
+// ancestors replaced by their slugs, or "" if none of them has a slug.
+func sectionSlugPath(sect page.Page, base string) string {
+	var elems []string
+	for ; sect != nil && !sect.IsHome(); sect = sect.Parent() {
+		slug := sect.Slug()
+		if slug == "" {
+			continue
+		}
+		if elems == nil {
+			elems = strings.Split(base, "/")
+		}
+		if i := strings.Count(sect.PathInfo().Base(), "/"); i < len(elems) {
+			elems[i] = slug
+		}
+	}
+	if elems == nil {
+		return ""
+	}
+	return strings.Join(elems, "/")
+}
diff --git a/hugolib/page_permalink_test.go b/hugolib/page_permalink_test.go
index d5ae693..85bbaae 100644
--- a/hugolib/page_permalink_test.go
+++ b/hugolib/page_permalink_test.go
@@ -201,3 +201,76 @@ path = '/books/**'
 
 	b.AssertFileContent("public/shelf/my-book/index.html", "RelPermalink: /shelf/my-book/")
 }
+
+func TestSlugInSectionTaxonomyAndTerm(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com"
+disableKinds = ['rss','sitemap']
+defaultContentLanguage = "en"
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}|
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+tags: [foo]
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+tags: [foo]
+---
+-- content/help/misc/p1.es.md --
+---
+title: P1
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+slug: Subsección
+---
+-- content/help/sub/p2.es.md --
+---
+title: P2
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: fu
+---
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "section|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "page|/help/how-to-frob/|")
+	b.AssertFileContent("public/tags/foo/index.html", "term|/tags/foo/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "section|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/misc/p1/index.html", "page|/es/ayuda/misc/p1/|")
+	b.AssertFileContent("public/es/ayuda/subsección/index.html", "section|/es/ayuda/subsecci%C3%B3n/|")
+	b.AssertFileContent("public/es/ayuda/subsección/p2/index.html", "page|/es/ayuda/subsecci%C3%B3n/p2/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "taxonomy|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "term|/es/etiquetas/fu/|")
+}
