+// dirWithSectionSlugs returns the directory used when building the path of p,
+// with any section, taxonomy and term path element replaced by the slug of
+// the corresponding page, if set. It returns an empty string if no slugs are
+// involved.
+func dirWithSectionSlugs(p *pageState, pagePath, sectionPath *paths.Path) string {
+	var dir string
+	switch p.Kind() {
+	case kinds.KindPage:
+		dir = pagePath.ContainerDir()
+	case kinds.KindSection, kinds.KindTaxonomy, kinds.KindTerm:
+		dir = sectionPath.Base()
+	default:
+		return ""
+	}
+
+	if dir == "" || dir == "/" {
+		return ""
+	}
+
+	// The section (or the branch page itself) and its ancestors.
+	slugs := make(map[string]string)
+	collect := func(sp page.Page) {
+		if sp == nil || sp.IsHome() || sp.Slug() == "" {
+			return
+		}
+		pi := sp.PathInfo()
+		if p.s.Conf.DisablePathToLower() {
+			pi = pi.Unnormalized()
+		}
+		slugs[pi.Base()] = sp.Slug()
+	}
+	cs := p.CurrentSection()
+	collect(cs)
+	for _, a := range cs.Ancestors() {
+		collect(a)
+	}
+	if len(slugs) == 0 {
+		return ""
+	}
+
+	elems := strings.Split(strings.TrimPrefix(dir, "/"), "/")
+	var (
+		changed bool
+		prefix  string
+	)
+	for i, e := range elems {
+		prefix += "/" + e
+		if slug, found := slugs[prefix]; found {
+			elems[i] = slug
+			changed = true
+		}
+	}
+	if !changed {
+		return ""
+	}
+
+	return "/" + strings.Join(elems, "/")
+}
