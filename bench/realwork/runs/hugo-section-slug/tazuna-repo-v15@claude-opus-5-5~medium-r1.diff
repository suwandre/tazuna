+// sectionBaseWithSlugs returns the base path of section s with
+// the slugs of s and its ancestor sections applied.
+func sectionBaseWithSlugs(s page.Page, unnormalized bool) string {
+	if s == nil || s.IsHome() {
+		return ""
+	}
+	base := pathInfo(s, unnormalized).Base()
+	if parent := s.Parent(); parent != nil && !parent.IsHome() {
+		parentBase := pathInfo(parent, unnormalized).Base()
+		if rest, ok := strings.CutPrefix(base, parentBase); ok {
+			base = sectionBaseWithSlugs(parent, unnormalized) + rest
+		}
+	}
+	if slug := s.Slug(); slug != "" {
+		base = path.Join(path.Dir(base), slug)
+	}
+	return base
+}
+
+func pathInfo(p page.Page, unnormalized bool) *paths.Path {
+	pi := p.PathInfo()
+	if unnormalized {
+		pi = pi.Unnormalized()
+	}
+	return pi
+}
diff --git a/hugolib/page_permalink_test.go b/hugolib/page_permalink_test.go
