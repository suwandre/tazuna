+package hugolib
+
+import "testing"
+
+func TestSlugInSectionsAndTerms(t *testing.T) {
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/_index.es.md --
+---
+slug: inicio
+---
+-- content/help/_index.md --
+-- content/help/_index.es.md --
+---
+slug: ayuda
+---
+-- content/help/how-to-frob/index.md --
+-- content/help/how-to-frob/index.es.md --
+---
+slug: como-frobear
+---
+-- content/help/nested/_index.md --
+-- content/help/nested/_index.es.md --
+---
+slug: anidada
+---
+-- content/help/nested/page.md --
+-- content/help/nested/page.es.md --
+-- content/help/foo/bar/index.md --
+-- content/help/foo/bar/index.es.md --
+-- content/tags/_index.md --
+-- content/tags/_index.es.md --
+---
+slug: etiquetas
+---
+-- content/tags/foo/_index.md --
+---
+slug: bar
+---
+-- content/post.md --
+---
+tags: [foo]
+---
+-- content/post.es.md --
+---
+tags: [foo]
+---
+-- layouts/page.html --
+Page: {{ .RelPermalink }}
+-- layouts/list.html --
+List: {{ .Kind }} {{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileExists("public/help/index.html", true)
+	b.AssertFileExists("public/help/how-to-frob/index.html", true)
+	b.AssertFileExists("public/ayuda/index.html", false)
+	b.AssertFileExists("public/es/ayuda/index.html", true)
+	b.AssertFileExists("public/es/ayuda/como-frobear/index.html", true)
+	b.AssertFileExists("public/es/ayuda/anidada/index.html", true)
+	b.AssertFileExists("public/es/ayuda/anidada/page/index.html", true)
+	b.AssertFileExists("public/es/ayuda/foo/bar/index.html", true)
+	b.AssertFileExists("public/es/help/index.html", false)
+	b.AssertFileExists("public/es/inicio/index.html", false)
+	b.AssertFileExists("public/es/index.html", true)
+
+	b.AssertFileContent("public/es/ayuda/index.html", "List: section /es/ayuda/")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Page: /es/ayuda/como-frobear/")
+	b.AssertFileContent("public/es/ayuda/anidada/page/index.html", "Page: /es/ayuda/anidada/page/")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "Page: /help/how-to-frob/")
+	b.AssertFileContent("public/help/nested/page/index.html", "Page: /help/nested/page/")
+	b.AssertFileContent("public/help/foo/bar/index.html", "Page: /help/foo/bar/")
+
+	b.AssertFileContent("public/tags/bar/index.html", "List: term /tags/bar/")
+	b.AssertFileExists("public/tags/foo/index.html", false)
+	b.AssertFileExists("public/es/etiquetas/foo/index.html", true)
+	b.AssertFileContent("public/es/etiquetas/foo/index.html", "List: term /es/etiquetas/foo/")
+	b.AssertFileContent("public/tags/index.html", "List: taxonomy /tags/")
+	b.AssertFileContent("public/es/etiquetas/index.html", "List: taxonomy /es/etiquetas/")
+}
