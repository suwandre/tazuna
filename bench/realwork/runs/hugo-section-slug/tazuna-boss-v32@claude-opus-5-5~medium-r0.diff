+// sectionSlugDir returns the path of section s with the slugs of s and its ancestors applied,
+// e.g. /ayuda/como-frobear. It equals s.PathInfo().Base() when no slugs are set.
+func sectionSlugDir(s page.Page, disablePathToLower bool) string {
+	if s.IsHome() {
+		return ""
+	}
+
+	pi, parentPi := s.PathInfo(), s.Parent().PathInfo()
+	if disablePathToLower {
+		pi, parentPi = pi.Unnormalized(), parentPi.Unnormalized()
+	}
+
+	rel := strings.Trim(strings.TrimPrefix(pi.Base(), parentPi.Base()), "/")
+	if slug := s.Slug(); slug != "" {
+		if i := strings.LastIndexByte(rel, '/'); i >= 0 {
+			rel = rel[:i+1] + slug
+		} else {
+			rel = slug
+		}
+	}
+
+	return sectionSlugDir(s.Parent(), disablePathToLower) + "/" + rel
+}
