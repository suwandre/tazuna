 		URL:         pm.pageConfig.URL,
 	}
 
+	desc.SectionPath = sectionPathWithSlugs(p)
+
 	if pm.Slug() != "" {
 		desc.BaseName = pm.Slug()
 	} else if pm.isStandalone() && pm.standaloneOutputFormat.BaseName != "" {
@@ -207,3 +209,37 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 
 	return desc, nil
 }
+
+// sectionPathWithSlugs returns the path of the current section of p with the
+// section slugs applied, or an empty string if no section in the hierarchy has a slug.
+func sectionPathWithSlugs(p *pageState) string {
+	current := p.CurrentSection()
+	sections := append(current.Ancestors().Reverse(), current)
+
+	var (
+		hasSlug  bool
+		parent   string // The base of the previous section.
+		resolved string // The previous section path with slugs applied.
+	)
+	for _, s := range sections {
+		if s.IsHome() {
+			continue
+		}
+		base := s.PathInfo().Base()
+		if p.s.Conf.DisablePathToLower() {
+			base = s.PathInfo().Unnormalized().Base()
+		}
+		name := strings.TrimPrefix(base, parent)
+		if slug := s.Slug(); slug != "" {
+			name = "/" + slug
+			hasSlug = true
+		}
+		resolved += name
+		parent = base
+	}
+
+	if !hasSlug {
+		return ""
+	}
+	return resolved
+}
diff --git a/hugolib/page_test.go b/hugolib/page_test.go
index 88a6b22..623afb4 100644
--- a/hugolib/page_test.go
+++ b/hugolib/page_test.go
@@ -2542,3 +2542,102 @@ isCJKLanguage: true
 	b.AssertFileContent("public/p500/index.html", "500|500|1")
 	b.AssertFileContent("public/p501/index.html", "501|600|2")
 }
+
+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ["rss", "sitemap"]
+[taxonomies]
+tag = "tags"
+[languages.en]
+[languages.es]
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Cómo frobear
+slug: como-frobear
+---
+-- content/help/faq/_index.es.md --
+---
+title: FAQ
+slug: preguntas
+---
+-- content/help/faq/q1.es.md --
+---
+title: Q1
+---
+-- content/help/faq/q2.es.md --
+---
+title: Q2
+slug: p2
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: fu
+---
+-- content/blog/_index.md --
+---
+title: Blog
+---
+-- content/blog/p1.md --
+---
+title: P1
+tags: [foo]
+---
+-- content/blog/p1.es.md --
+---
+title: P1
+tags: [foo]
+---
+-- layouts/page.html --
+{{ .Title }}|{{ .RelPermalink }}
+-- layouts/section.html --
+{{ .Title }}|{{ .RelPermalink }}
+-- layouts/taxonomy.html --
+{{ .Title }}|{{ .RelPermalink }}
+-- layouts/term.html --
+{{ .Title }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileExists("public/help/index.html", true)
+	b.AssertFileExists("public/help/how-to-frob/index.html", true)
+	b.AssertFileExists("public/blog/p1/index.html", true)
+	b.AssertFileExists("public/es/ayuda/index.html", true)
+	b.AssertFileExists("public/es/ayuda/como-frobear/index.html", true)
+	b.AssertFileExists("public/es/ayuda/preguntas/index.html", true)
+	b.AssertFileExists("public/es/ayuda/preguntas/q1/index.html", true)
+	b.AssertFileExists("public/es/ayuda/preguntas/p2/index.html", true)
+	b.AssertFileExists("public/es/etiquetas/index.html", true)
+	b.AssertFileExists("public/es/etiquetas/fu/index.html", true)
+	b.AssertFileExists("public/es/help/index.html", false)
+
+	b.AssertFileContent("public/es/ayuda/preguntas/q1/index.html", "Q1|/es/ayuda/preguntas/q1/")
+	b.AssertFileContent("public/es/blog/p1/index.html", "P1|/es/blog/p1/")
+	b.AssertFileContent("public/es/ayuda/preguntas/index.html", "FAQ|/es/ayuda/preguntas/")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "Foo|/es/etiquetas/fu/")
+}
