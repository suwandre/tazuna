+// sectionBaseWithSlugs returns the base path of the section p with any slugs
+// set on p or its ancestor sections applied.
+func sectionBaseWithSlugs(p page.Page, unnormalized bool) string {
+	pathBase := func(p page.Page) string {
+		if unnormalized {
+			return p.PathInfo().Unnormalized().Base()
+		}
+		return p.PathInfo().Base()
+	}
+
+	base := pathBase(p)
+	if p.IsHome() {
+		return base
+	}
+	if p.Slug() != "" {
+		base = path.Join(path.Dir(base), p.Slug())
+	}
+
+	parent := p.Parent()
+	if parent == nil || parent.IsHome() {
+		return base
+	}
+	parentBase := pathBase(parent)
+	rest, ok := strings.CutPrefix(base, parentBase)
+	if !ok {
+		return base
+	}
+	return path.Join(sectionBaseWithSlugs(parent, unnormalized), rest)
+}
diff --git a/hugolib/page_permalink_test.go b/hugolib/page_permalink_test.go
index d5ae693..20c8d6f 100644
--- a/hugolib/page_permalink_test.go
+++ b/hugolib/page_permalink_test.go
@@ -201,3 +201,71 @@ path = '/books/**'
 
 	b.AssertFileContent("public/shelf/my-book/index.html", "RelPermalink: /shelf/my-book/")
 }
+
+func TestSlugInSectionTaxonomyAndTermPages(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com/"
+disableKinds = ["rss", "sitemap", "robotsTXT", "404"]
+defaultContentLanguage = "en"
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+[taxonomies]
+tag = "tags"
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+tags: [foo]
+---
+-- content/help/nested/_index.es.md --
+---
+title: Anidado
+slug: anidado
+---
+-- content/help/nested/p1.es.md --
+---
+title: P1
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: fu
+---
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "section|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "page|/help/how-to-frob/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "section|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/anidado/index.html", "section|/es/ayuda/anidado/|")
+	b.AssertFileContent("public/es/ayuda/anidado/p1/index.html", "page|/es/ayuda/anidado/p1/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "taxonomy|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "term|/es/etiquetas/fu/|")
+}
