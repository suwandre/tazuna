+// sectionDir returns dir with the Section's base path replaced by SectionBase.
+func (d TargetPathDescriptor) sectionDir(dir string) string {
+	if d.SectionBase == "" {
+		return dir
+	}
+	if rest, ok := strings.CutPrefix(dir, d.Section.Base()); ok && (rest == "" || rest[0] == '/') {
+		return d.SectionBase + rest
+	}
+	return dir
+}
