+
+// sectionBaseWithSlugs returns the path of the given section where any path
+// element that maps to a section (or taxonomy/term) page with a slug set
+// is replaced with that slug.
+// It returns an empty string if no slugs are involved.
+func sectionBaseWithSlugs(p *pageState, section *paths.Path) string {
+	base := section.Base()
+	if base == "" || base == "/" {
+		return ""
+	}
+	// Tree keys are normalized.
+	normSegments := strings.Split(strings.Trim(p.CurrentSection().PathInfo().Base(), "/"), "/")
+	segments := strings.Split(strings.Trim(base, "/"), "/")
+	if len(normSegments) != len(segments) {
+		return ""
+	}
+
+	var found bool
+	for i := range segments {
+		key := "/" + strings.Join(normSegments[:i+1], "/")
+		n := p.s.pageMap.treePages.Get(key)
+		if n == nil {
+			continue
+		}
+		sp, ok := n.(*pageState)
+		if !ok || !kinds.IsBranch(sp.Kind()) {
+			continue
+		}
+		if slug := sp.m.Slug(); slug != "" {
+			segments[i] = slug
+			found = true
+		}
+	}
+	if !found {
+		return ""
+	}
+	return "/" + strings.Join(segments, "/")
+}
diff --git a/hugolib/page_permalink_test.go b/hugolib/page_permalink_test.go
