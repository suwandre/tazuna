+// limitations under the License.
+
+package hugolib
+
+import "testing"
+
+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: Frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Frobear
+slug: como-frobear
+---
+-- content/help/other.es.md --
+---
+title: Otro
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+---
+-- layouts/page.html --
+Page|{{ .Title }}|{{ .RelPermalink }}
+-- layouts/list.html --
+List|{{ .Title }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "/help/")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "/help/how-to-frob/")
+	b.AssertFileContent("public/es/ayuda/index.html", "/es/ayuda/")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "/es/ayuda/como-frobear/")
+	b.AssertFileContent("public/es/ayuda/other/index.html", "/es/ayuda/other/")
+	b.AssertFileContent("public/es/ayuda/sub/index.html", "/es/ayuda/sub/")
+}
