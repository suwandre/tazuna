@@ -207,3 +210,25 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 
 	return desc, nil
 }
+
+// sectionBaseWithSlugs returns the base path of the current section of p with
+// the last element of each section replaced by its slug, if set.
+// It returns an empty string if no section has a slug.
+func sectionBaseWithSlugs(p *pageState) string {
+	var els []string
+	var hasSlug bool
+	for s := p.CurrentSection(); s != nil && !s.IsHome(); s = s.Parent() {
+		name := s.Slug()
+		if name != "" {
+			hasSlug = true
+		} else {
+			name = path.Base(s.PathInfo().Base())
+		}
+		els = append(els, name)
+	}
+	if !hasSlug {
+		return ""
+	}
+	slices.Reverse(els)
+	return "/" + strings.Join(els, "/")
+}
