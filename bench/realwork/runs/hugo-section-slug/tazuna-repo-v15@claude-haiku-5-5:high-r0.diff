@@ -114,9 +115,10 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 	d := s.Deps
 	pm := p.m
 	alwaysInSubDir := p.Kind() == kinds.KindSitemap
-	pageInfoPage := p.PathInfo()
