+package hugolib
+
+import (
+	"testing"
+)
+
+func TestSlugSectionTaxonomyAndTermLocalized(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+[taxonomies]
+tag = "tags"
+-- content/help/_index.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+---
+-- content/help/faq.en.md --
+---
+title: FAQ
+tags: [foo]
+---
+-- content/help/faq.es.md --
+---
+title: Preguntas
+tags: [foo]
+---
+-- content/tags/_index.md --
+---
+title: Tags
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: fu
+---
+-- layouts/page.html --
+Page: {{ .RelPermalink }}
+-- layouts/section.html --
+Section: {{ .RelPermalink }}
+-- layouts/taxonomy.html --
+Taxonomy: {{ .RelPermalink }}
+-- layouts/term.html --
+Term: {{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "Section: /help/")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "Page: /help/how-to-frob/")
+	b.AssertFileContent("public/help/faq/index.html", "Page: /help/faq/")
+	b.AssertFileContent("public/tags/index.html", "Taxonomy: /tags/")
+	b.AssertFileContent("public/tags/foo/index.html", "Term: /tags/foo/")
+
+	b.AssertFileContent("public/es/ayuda/index.html", "Section: /es/ayuda/")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Page: /es/ayuda/como-frobear/")
+	b.AssertFileContent("public/es/ayuda/faq/index.html", "Page: /es/ayuda/faq/")
+	b.AssertFileContent("public/es/etiquetas/index.html", "Taxonomy: /es/etiquetas/")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "Term: /es/etiquetas/fu/")
+
+	b.AssertFileExists("public/es/help/index.html", false)
+	b.AssertFileExists("public/es/tags/index.html", false)
+}
+
+func TestSlugSectionNestedLocalized(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.md --
+-- content/help/_index.es.md --
+---
+slug: ayuda
+---
+-- content/help/sub/_index.md --
+-- content/help/sub/_index.es.md --
+---
+slug: sub-es
+---
+-- content/help/sub/faq.en.md --
+-- content/help/sub/faq.es.md --
+-- content/help/sub/deep/index.en.md --
+-- content/help/sub/deep/index.es.md --
+---
+slug: profundo
+---
+-- layouts/page.html --
+Page: {{ .RelPermalink }}
+-- layouts/section.html --
+Section: {{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/sub/index.html", "Section: /help/sub/")
+	b.AssertFileContent("public/help/sub/deep/index.html", "Page: /help/sub/deep/")
+	b.AssertFileContent("public/help/sub/faq/index.html", "Page: /help/sub/faq/")
+	b.AssertFileContent("public/es/ayuda/sub-es/index.html", "Section: /es/ayuda/sub-es/")
+	b.AssertFileContent("public/es/ayuda/sub-es/faq/index.html", "Page: /es/ayuda/sub-es/faq/")
+	b.AssertFileContent("public/es/ayuda/sub-es/profundo/index.html", "Page: /es/ayuda/sub-es/profundo/")
+	b.AssertFileExists("public/es/ayuda/sub/index.html", false)
+	b.AssertFileExists("public/es/ayuda/sub-es/deep/index.html", false)
+}
+
+func TestSlugSectionDisablePathToLower(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+disablePathToLower = true
+defaultContentLanguage = "en"
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/Help/_index.md --
+-- content/Help/_index.es.md --
+---
+slug: Ayuda Mixta
+---
+-- content/Help/Guide.en.md --
+-- content/Help/Guide.es.md --
+-- layouts/page.html --
+Page: {{ .RelPermalink }}
+-- layouts/section.html --
+Section: {{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/Help/index.html", "Section: /Help/")
+	b.AssertFileContent("public/Help/Guide/index.html", "Page: /Help/Guide/")
+	b.AssertFileContent("public/es/Ayuda-Mixta/index.html", "Section: /es/Ayuda-Mixta/")
+	b.AssertFileContent("public/es/Ayuda-Mixta/Guide/index.html", "Page: /es/Ayuda-Mixta/Guide/")
+}
