-	pageInfoCurrentSection := p.CurrentSection().PathInfo()
+	currentSection := p.CurrentSection()
+	pp := s.Conf.PathParser()
+	pageInfoPage := withSectionSlugs(pp, p.PathInfo(), currentSection)
+	pageInfoCurrentSection := withSectionSlugs(pp, currentSection.PathInfo(), currentSection)
 	if p.s.Conf.DisablePathToLower() {
 		pageInfoPage = pageInfoPage.Unnormalized()
 		pageInfoCurrentSection = pageInfoCurrentSection.Unnormalized()
@@ -207,3 +209,26 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 
 	return desc, nil
 }
+
+// withSectionSlugs returns pi with the directory elements of sec and its
+// ancestors replaced by their slugs, if set.
+func withSectionSlugs(pp *paths.PathParser, pi *paths.Path, sec page.Page) *paths.Path {
+	var elems []string
+	for s := sec; !s.IsHome(); s = s.Parent() {
+		slug := s.Slug()
+		if slug == "" {
+			continue
+		}
+		if elems == nil {
+			elems = strings.Split(pi.Unnormalized().Path(), "/")
+		}
+		// The base starts with "/", so its slash count is the index of its last element.
+		elems[strings.Count(s.PathInfo().Base(), "/")] = slug
+	}
+
+	if elems == nil {
+		return pi
+	}
+
+	return pp.Parse(pi.Component(), strings.Join(elems, "/"))
+}
