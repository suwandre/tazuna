+// withSectionSlugs replaces the elements of the slash separated path p
+// that have a slug set in d.SectionSlugs.
+func (d TargetPathDescriptor) withSectionSlugs(p string) string {
+	if len(d.SectionSlugs) == 0 {
+		return p
+	}
+	els := strings.Split(p, "/")
+	out := make([]string, len(els))
+	for i, el := range els {
+		out[i] = el
+		if slug, ok := d.SectionSlugs[strings.Join(els[:i+1], "/")]; ok {
+			out[i] = slug
+		}
+	}
+	return strings.Join(out, "/")
+}
