+// sectionsWithSlug returns p, if it's a branch, and its ancestor branches that
+// have a slug set, excluding the home page.
+func sectionsWithSlug(p *pageState) page.Pages {
+	var sections page.Pages
+	add := func(pp page.Page) {
+		if kinds.IsBranch(pp.Kind()) && !pp.IsHome() && pp.Slug() != "" {
+			sections = append(sections, pp)
+		}
+	}
+	add(p)
+	for _, a := range p.Ancestors() {
+		add(a)
+	}
+	return sections
+}
