+func TestSectionTaxonomyTermSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ['rss','sitemap']
+[taxonomies]
+tag = 'tags'
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: Frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Frobear
+slug: como-frobear
+---
+-- content/help/other.es.md --
+---
+title: Otro
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+slug: sub-es
+---
+-- content/help/sub/p1.es.md --
+---
+title: P1
+tags: [a]
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/a/_index.es.md --
+---
+title: A
+slug: aaa
+---
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	for _, f := range []string{
+		"public/help/index.html",
+		"public/help/how-to-frob/index.html",
+		"public/es/ayuda/index.html",
+		"public/es/ayuda/como-frobear/index.html",
+		"public/es/ayuda/other/index.html",
+		"public/es/ayuda/sub-es/index.html",
+		"public/es/ayuda/sub-es/p1/index.html",
+		"public/es/etiquetas/index.html",
+		"public/es/etiquetas/aaa/index.html",
+	} {
+		b.AssertFileExists(f, true)
+	}
+	b.AssertFileExists("public/es/help/index.html", false)
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|/es/ayuda/como-frobear/")
+	b.AssertFileContent("public/es/ayuda/sub-es/index.html", "section|/es/ayuda/sub-es/")
+	b.AssertFileContent("public/es/etiquetas/aaa/index.html", "term|/es/etiquetas/aaa/")
+}
