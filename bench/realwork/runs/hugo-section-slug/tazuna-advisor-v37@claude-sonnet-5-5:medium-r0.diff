+// sectionBaseWithSlugs returns the section path of p with section slugs applied,
+// or an empty string if no section in the hierarchy has a slug.
+func sectionBaseWithSlugs(p *pageState) string {
+	cs := p.CurrentSection()
+	sections := append(cs.Ancestors().Reverse(), cs)
+	var segments []string
+	hasSlug := false
+	for _, s := range sections {
+		if s.IsHome() {
+			continue
+		}
+		seg := path.Base(s.PathInfo().Base())
+		if slug := s.Slug(); slug != "" {
+			seg = slug
+			hasSlug = true
+		}
+		segments = append(segments, seg)
+	}
+	if !hasSlug {
+		return ""
+	}
+	return "/" + strings.Join(segments, "/")
+}
