+func TestLocalizedSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+defaultContentLanguage = 'en'
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Cómo frobear
+slug: como-frobear
+---
+-- layouts/list.html --
+{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileExists("public/help/index.html", true)
+	b.AssertFileExists("public/es/help/index.html", true)
+}
