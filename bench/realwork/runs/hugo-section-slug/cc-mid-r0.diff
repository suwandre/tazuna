 }
 
+// applySectionSlugs replaces the elements of dir with the slug of the
+// corresponding ancestor section, if set. If includeSelf is set, the last
+// element is replaced with the slug of p itself, if set.
+// It returns an empty string if no slugs apply.
+func applySectionSlugs(p *pageState, dir string, includeSelf bool) string {
+	slugs := make(map[string]string)
+	for _, a := range p.Ancestors() {
+		if a.IsHome() || a.Slug() == "" {
+			continue
+		}
+		slugs[strings.ToLower(a.Path())] = a.Slug()
+	}
+	if includeSelf && p.Slug() != "" {
+		slugs[strings.ToLower(p.Path())] = p.Slug()
+	}
+	if len(slugs) == 0 {
+		return ""
+	}
+
+	var (
+		found  bool
+		prefix string
+		parts  []string
+	)
+	for _, elem := range strings.Split(strings.Trim(dir, "/"), "/") {
+		if elem == "" {
+			continue
+		}
+		prefix += "/" + elem
+		if slug, ok := slugs[strings.ToLower(prefix)]; ok {
+			elem = slug
+			found = true
+		}
+		parts = append(parts, elem)
+	}
+	if !found {
+		return ""
+	}
+	return "/" + strings.Join(parts, "/")
+}
