+
+// dirWithSectionSlugs returns the directory of p with the elements for any
+// section having a slug replaced by that slug, or "" if there are none.
+func dirWithSectionSlugs(p *pageState, desc page.TargetPathDescriptor) string {
+	var dir string
+	switch p.Kind() {
+	case kinds.KindPage:
+		dir = desc.Path.ContainerDir()
+	case kinds.KindSection, kinds.KindTaxonomy, kinds.KindTerm:
+		dir = desc.Section.Base()
+	default:
+		return ""
+	}
+
+	cs := p.CurrentSection()
+	sections := append(cs.Ancestors().Reverse(), cs)
+
+	var elems []string
+	for _, s := range sections {
+		if s.IsHome() || s.Slug() == "" {
+			continue
+		}
+		if elems == nil {
+			elems = paths.FieldsSlash(dir)
+		}
+		if i := len(paths.FieldsSlash(s.PathInfo().Base())) - 1; i >= 0 && i < len(elems) {
+			elems[i] = s.Slug()
+		}
+	}
+
+	if elems == nil {
+		return ""
+	}
+	return "/" + strings.Join(elems, "/")
+}
diff --git a/hugolib/site_sections_test.go b/hugolib/site_sections_test.go
