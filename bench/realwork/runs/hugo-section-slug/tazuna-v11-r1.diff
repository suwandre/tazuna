 	b.AssertFileContent("public/s1/p1.html", "content/s1/p1.md")
 }
+
+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+disableKinds = ['rss','sitemap']
+[languages.en]
+[languages.es]
+[taxonomies]
+tag = 'tags'
+-- content/help/_index.en.md --
+-- content/help/_index.es.md --
+---
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+tags: [foo]
+---
+-- content/help/how-to-frob/index.es.md --
+---
+slug: como-frobear
+tags: [foo]
+---
+-- content/help/other.es.md --
+-- content/tags/_index.es.md --
+---
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+slug: fu
+---
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}|{{ .Permalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "section|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "page|/help/how-to-frob/|")
+	b.AssertFileContent("public/tags/foo/index.html", "term|/tags/foo/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "section|/es/ayuda/|https://example.org/es/ayuda/")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/other/index.html", "page|/es/ayuda/other/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "taxonomy|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "term|/es/etiquetas/fu/|")
+	b.AssertFileExists("public/es/help/index.html", false)
+
+	b = Test(t, strings.Replace(files, `disableKinds`, "uglyURLs = true\ndisableKinds", 1))
+
+	b.AssertFileContent("public/es/ayuda/index.html", "section|/es/ayuda/index.html|")
+	b.AssertFileContent("public/es/ayuda/como-frobear.html", "page|/es/ayuda/como-frobear.html|")
+}
+
+// A taxonomy slug applies to terms without content files.
+func TestTaxonomySlugTermWithoutContentFile(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ['home','rss','sitemap']
+[taxonomies]
+tag = 'tags'
+-- content/tags/_index.md --
+---
+slug: etiquetas
+---
+-- content/p1.md --
+---
+tags: [foo]
+---
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/etiquetas/index.html", "taxonomy|/etiquetas/")
+	b.AssertFileContent("public/etiquetas/foo/index.html", "term|/etiquetas/foo/")
+}
