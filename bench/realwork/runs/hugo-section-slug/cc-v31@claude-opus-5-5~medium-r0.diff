+// applySectionSlugs replaces the path segments in dir belonging to sect
+// and its ancestor sections with their slugs, if set.
+func applySectionSlugs(sect page.Page, dir string) string {
+	if dir == "" || dir == "/" {
+		return dir
+	}
+	segs := strings.Split(strings.TrimPrefix(dir, "/"), "/")
+	var changed bool
+	for ; sect != nil && !sect.IsHome(); sect = sect.Parent() {
+		slug := sect.Slug()
+		if slug == "" {
+			continue
+		}
+		if i := strings.Count(sect.Path(), "/") - 1; i < len(segs) {
+			segs[i] = slug
+			changed = true
+		}
+	}
+	if !changed {
+		return dir
+	}
+	return "/" + strings.Join(segs, "/")
+}
