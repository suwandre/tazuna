+func (d TargetPathDescriptor) applySectionSlugs(p string) string {
+	if len(d.SectionSlugs) == 0 {
+		return p
+	}
+	segs := strings.Split(strings.Trim(p, slash), slash)
+	var prefix string
+	for i, seg := range segs {
+		prefix += slash + seg
+		if slug, ok := d.SectionSlugs[prefix]; ok {
+			segs[i] = slug
+		}
+	}
+	return slash + strings.Join(segs, slash)
+}
