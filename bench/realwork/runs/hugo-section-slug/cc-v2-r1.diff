+
+// sectionSlugs returns the slugs set on p (if a branch page) and its ancestors, keyed by path.
+func sectionSlugs(p *pageState) map[string]string {
+	var slugs map[string]string
+	add := func(bp page.Page) {
+		if bp.IsHome() || bp.Slug() == "" {
+			return
+		}
+		pi := bp.PathInfo()
+		if p.s.Conf.DisablePathToLower() {
+			pi = pi.Unnormalized()
+		}
+		if slugs == nil {
+			slugs = make(map[string]string)
+		}
+		slugs[pi.Base()] = bp.Slug()
+	}
+	if kinds.IsBranch(p.Kind()) {
+		add(p)
+	}
+	for _, a := range p.Ancestors() {
+		add(a)
+	}
+	return slugs
+}
