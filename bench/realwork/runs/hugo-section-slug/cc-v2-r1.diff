 	if opath != "" {
 		opath, _ = url.QueryUnescape(opath)
 		opath = path.Clean(opath)
@@ -207,3 +211,28 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 
 	return desc, nil
