diff --git a/hugolib/page__paths.go b/hugolib/page__paths.go
index 46a3a99..1d3a8b5 100644
--- a/hugolib/page__paths.go
+++ b/hugolib/page__paths.go
@@ -97,6 +97,33 @@ func newPagePaths(ps *pageState) (pagePaths, error) {
 	}, nil
 }
 
+// sectionSlugs returns the slugs set in front matter for the section, taxonomy
+// and term pages in the ancestor chain of p (including p itself if it is a branch),
+// keyed by their normalized base path.
+func sectionSlugs(p *pageState) map[string]string {
+	var slugs map[string]string
+	add := func(pp page.Page) {
+		if pp.IsHome() || pp.Slug() == "" {
+			return
+		}
+		pi := pp.PathInfo()
+		if p.s.Conf.DisablePathToLower() {
+			pi = pi.Unnormalized()
+		}
+		if slugs == nil {
+			slugs = make(map[string]string)
+		}
+		slugs[pi.Base()] = pp.Slug()
+	}
+	if kinds.IsBranch(p.Kind()) {
+		add(p)
+	}
+	for _, a := range p.Ancestors() {
+		add(a)
+	}
+	return slugs
+}
+
 type pagePaths struct {
 	outputFormats     page.OutputFormats
 	firstOutputFormat page.OutputFormat
@@ -132,6 +159,8 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 		URL:         pm.pageConfig.URL,
 	}
 
+	desc.Slugs = sectionSlugs(p)
+
 	if pm.Slug() != "" {
 		desc.BaseName = pm.Slug()
 	} else if pm.isStandalone() && pm.standaloneOutputFormat.BaseName != "" {
diff --git a/hugolib/page_slug_section_test.go b/hugolib/page_slug_section_test.go
new file mode 100644
index 0000000..50adc69
--- /dev/null
+++ b/hugolib/page_slug_section_test.go
@@ -0,0 +1,99 @@
+// Copyright 2026 The Hugo Authors. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+// http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package hugolib
+
+import "testing"
+
+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ["rss", "sitemap"]
+[taxonomies]
+tag = "tags"
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: Frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Frobear
+slug: como-frobear
+---
+-- content/help/other.es.md --
+---
+title: Otro
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+slug: subes
+---
+-- content/help/sub/p1.es.md --
+---
+title: P1
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: fu
+---
+-- content/help/tagged.es.md --
+---
+title: Tagged
+tags: [foo]
+---
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileExists("public/help/index.html", true)
+	b.AssertFileExists("public/help/how-to-frob/index.html", true)
+	b.AssertFileExists("public/es/ayuda/index.html", true)
+	b.AssertFileExists("public/es/ayuda/como-frobear/index.html", true)
+	b.AssertFileExists("public/es/ayuda/other/index.html", true)
+	b.AssertFileExists("public/es/ayuda/subes/index.html", true)
+	b.AssertFileExists("public/es/ayuda/subes/p1/index.html", true)
+	b.AssertFileExists("public/es/help/index.html", false)
+	b.AssertFileExists("public/es/etiquetas/index.html", true)
+	b.AssertFileExists("public/es/etiquetas/fu/index.html", true)
+
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "section|/es/ayuda/|")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "term|/es/etiquetas/fu/|")
+}
diff --git a/resources/page/page_paths.go b/resources/page/page_paths.go
index 4f24488..069d793 100644
--- a/resources/page/page_paths.go
+++ b/resources/page/page_paths.go
@@ -71,6 +71,11 @@ type TargetPathDescriptor struct {
 	// URL from front matter if set. Will override any Slug etc.
 	URL string
 
+	// Slugs maps the (normalized) base path of a section, taxonomy or term
+	// (e.g. "/help") to its slug. It replaces the matching path segment
+	// when building the path of that branch and of all its descendants.
+	Slugs map[string]string
+
 	// Used to create paginator links.
 	Addends string
 
@@ -81,6 +86,23 @@ type TargetPathDescriptor struct {
 	UglyURLs bool
 }
 
+// applySlugs replaces path segments of base with the slug of the
+// section, taxonomy or term that lives at that path, if any.
+func (d TargetPathDescriptor) applySlugs(base string) string {
+	if len(d.Slugs) == 0 || base == "" || base == "/" {
+		return base
+	}
+	segs := strings.Split(strings.Trim(base, "/"), "/")
+	var prefix string
+	for i, s := range segs {
+		prefix += "/" + s
+		if slug, ok := d.Slugs[prefix]; ok {
+			segs[i] = slug
+		}
+	}
+	return "/" + strings.Join(segs, "/")
+}
+
 // TODO(bep) move this type.
 type TargetPaths struct {
 	// Where to store the file on disk relative to the publish dir. OS slashes.
@@ -166,7 +188,7 @@ func CreateTargetPaths(d TargetPathDescriptor) (tp TargetPaths) {
 		if d.ExpandedPermalink != "" {
 			pb.Add(d.ExpandedPermalink)
 		} else {
-			pb.Add(d.Section.Base())
+			pb.Add(d.applySlugs(d.Section.Base()))
 		}
 		needsBase = false
 	}
