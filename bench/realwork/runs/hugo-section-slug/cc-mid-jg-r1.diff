@@ -207,3 +210,44 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 
 	return desc, nil
 }
+
+// sectionPathWithSlugs returns the path of the current section of p where
+// the directory name of every section that has a slug is replaced by that slug.
+// It returns an empty string if no slug is in play or if the section
+// hierarchy doesn't map 1:1 to the path elements.
+func sectionPathWithSlugs(p *pageState, sectionPath *paths.Path) string {
+	currentSection := p.CurrentSection()
+	if currentSection.IsHome() {
+		return ""
+	}
+
+	// Regular pages must live directly in the current section.
+	if !kinds.IsBranch(p.Kind()) && p.PathInfo().ContainerDir() != currentSection.PathInfo().Base() {
+		return ""
+	}
+
+	sections := currentSection.Ancestors().Reverse()
+	sections = append(sections, currentSection)
+	if home := sections[0]; home.IsHome() {
+		sections = sections[1:]
+	}
+
+	elems := strings.Split(strings.Trim(sectionPath.Base(), "/"), "/")
+	if len(elems) != len(sections) {
+		return ""
+	}
+
+	var hasSlug bool
+	for i, sec := range sections {
+		if slug := sec.Slug(); slug != "" {
+			elems[i] = slug
+			hasSlug = true
+		}
+	}
+
+	if !hasSlug {
+		return ""
+	}
+
+	return path.Join(elems...)
+}
diff --git a/hugolib/site_sections_test.go b/hugolib/site_sections_test.go
index 779c380..691ce38 100644
--- a/hugolib/site_sections_test.go
+++ b/hugolib/site_sections_test.go
@@ -182,3 +182,76 @@ title: content/s1.md
 	b.AssertFileContent("public/s1.html", "content/s1.md")
 	b.AssertFileContent("public/s1/p1.html", "content/s1/p1.md")
 }
+
+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ['rss','sitemap']
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+[taxonomies]
+tag = 'tags'
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+---
+-- content/help/other.es.md --
+---
+title: Otro
+tags: [foo]
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+---
+-- content/help/sub/p1.es.md --
+---
+title: P1
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: fu
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "section|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "page|/help/how-to-frob/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "section|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/other/index.html", "page|/es/ayuda/other/|")
+	b.AssertFileContent("public/es/ayuda/sub/index.html", "section|/es/ayuda/sub/|")
+	b.AssertFileContent("public/es/ayuda/sub/p1/index.html", "page|/es/ayuda/sub/p1/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "taxonomy|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "term|/es/etiquetas/fu/|")
+}
