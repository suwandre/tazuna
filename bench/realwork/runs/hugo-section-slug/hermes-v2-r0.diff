 	return l.outputFormats
 }
 
+// sectionBaseWithSlugs returns the base path of p's current section with
+// section slugs applied, or "" if neither the section nor any of its ancestors has a slug.
+func sectionBaseWithSlugs(p *pageState, unnormalized bool) string {
+	switch p.Kind() {
+	case kinds.KindPage, kinds.KindSection, kinds.KindTaxonomy, kinds.KindTerm:
+	default:
+		return ""
+	}
+
+	cs := p.CurrentSection()
+	sections := append(cs.Ancestors().Reverse(), cs)
+
+	var (
+		b       strings.Builder
+		prev    string
+		hasSlug bool
+	)
+	for _, s := range sections {
+		if s.IsHome() {
+			continue
+		}
+		pi := s.PathInfo()
+		if unnormalized {
+			pi = pi.Unnormalized()
+		}
+		base := pi.Base()
+		seg := strings.Trim(strings.TrimPrefix(base, prev), "/")
+		prev = base
+		if slug := s.Slug(); slug != "" {
+			seg = slug
+			hasSlug = true
+		}
+		b.WriteString("/" + seg)
+	}
+
+	if !hasSlug {
+		return ""
+	}
+
+	if p.Kind() == kinds.KindPage {
+		// Only if the page lives directly in its current section.
+		if p.PathInfo().ContainerDir() != cs.PathInfo().Base() {
+			return ""
+		}
+	}
+
+	return b.String()
+}
