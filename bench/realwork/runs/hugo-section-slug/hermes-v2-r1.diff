+// sectionSlugsByDepth returns the slugs set on p (if it's a branch) and its
+// ancestors, keyed by the 1-based depth of the path segment they replace.
+func sectionSlugsByDepth(p *pageState) map[int]string {
+	var slugs map[int]string
+	add := func(bp page.Page) {
+		if bp.IsHome() || bp.Slug() == "" {
+			return
+		}
+		if slugs == nil {
+			slugs = make(map[int]string)
+		}
+		slugs[strings.Count(bp.Path(), "/")] = bp.Slug()
+	}
+	if kinds.IsBranch(p.Kind()) {
+		add(p)
+	}
+	for _, a := range p.Ancestors() {
+		add(a)
+	}
+	return slugs
+}
+
+func applySectionSlugs(dir string, slugs map[int]string) string {
+	if dir == "" {
+		return dir
+	}
+	elems := strings.Split(strings.Trim(dir, "/"), "/")
+	for i := range elems {
+		if slug, ok := slugs[i+1]; ok {
+			elems[i] = slug
+		}
+	}
+	return "/" + strings.Join(elems, "/")
+}
