+// sluggedSectionDir returns the section path of p with the last element
+// of each section replaced by its slug, if set.
+// It returns an empty string if no section in the chain has a slug.
+func sluggedSectionDir(p *pageState, unnormalized bool) string {
+	var chain []page.Page
+	for cur := p.CurrentSection(); cur != nil && !cur.IsHome(); cur = cur.Parent() {
+		chain = append(chain, cur)
+	}
+
+	var (
+		hasSlug bool
+		prev    string
+		b       strings.Builder
+	)
+	for i := len(chain) - 1; i >= 0; i-- {
+		pi := chain[i].PathInfo()
+		if unnormalized {
+			pi = pi.Unnormalized()
+		}
+		rel := strings.TrimPrefix(pi.Base(), prev)
+		prev = pi.Base()
+		if slug := chain[i].Slug(); slug != "" {
+			hasSlug = true
+			rel = path.Join(path.Dir(rel), slug)
+		}
+		b.WriteString(rel)
+	}
+
+	if !hasSlug {
+		return ""
+	}
+	if !kinds.IsBranch(p.Kind()) {
+		// Directories without an _index file aren't sections.
+		pi := p.PathInfo()
+		if unnormalized {
+			pi = pi.Unnormalized()
+		}
+		b.WriteString(strings.TrimPrefix(pi.ContainerDir(), prev))
+	}
+	return b.String()
+}
