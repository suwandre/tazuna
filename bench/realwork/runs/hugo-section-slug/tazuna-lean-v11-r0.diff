+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'https://example.org/'
+defaultContentLanguage = 'en'
+defaultContentLanguageInSubdir = false
+disableKinds = ['rss','sitemap']
+[languages.en]
+[languages.es]
+[taxonomies]
+tag = 'tags'
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: Frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Frobear
+slug: como-frobear
+---
+-- content/help/sub/p.es.md --
+---
+title: P
+tags: [t1]
+---
+-- content/help/sub/p.en.md --
+---
+title: P
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/t1/_index.es.md --
+---
+title: T1
+slug: uno
+---
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileExists("public/help/index.html", true)
+	b.AssertFileExists("public/help/how-to-frob/index.html", true)
+	b.AssertFileExists("public/help/sub/p/index.html", true)
+	b.AssertFileContent("public/es/ayuda/index.html", "section|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/sub/p/index.html", "page|/es/ayuda/sub/p/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "taxonomy|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/uno/index.html", "term|/es/etiquetas/uno/|")
+}
