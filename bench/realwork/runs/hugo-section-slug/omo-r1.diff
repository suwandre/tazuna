+func (d TargetPathDescriptor) applySectionSlugs(dir string) string {
+	if len(d.SectionSlugs) == 0 {
+		return dir
+	}
+	orig := strings.Split(dir, "/")
+	elems := slices.Clone(orig)
+	for i := range orig {
+		if slug, ok := d.SectionSlugs[strings.Join(orig[:i+1], "/")]; ok {
+			elems[i] = slug
+		}
+	}
+	return strings.Join(elems, "/")
+}
