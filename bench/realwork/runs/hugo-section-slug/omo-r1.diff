+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package hugolib
+
+import "testing"
+
+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ["rss", "sitemap"]
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+[taxonomies]
+tag = "tags"
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+---
+-- content/help/faq/_index.es.md --
+---
+title: FAQ
+slug: preguntas
+---
+-- content/help/faq/q1.es.md --
+---
+title: Q1
+---
+-- content/help/faq/q1.en.md --
+---
+title: Q1
+---
+-- content/help/other.es.md --
+---
+title: Other
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: bar
+---
+-- content/p1.es.md --
+---
+title: P1
+tags: [foo]
+---
+-- layouts/page.html --
+Page|{{ .Title }}|{{ .RelPermalink }}
+-- layouts/section.html --
+Section|{{ .Title }}|{{ .RelPermalink }}
+-- layouts/taxonomy.html --
+Taxonomy|{{ .Title }}|{{ .RelPermalink }}
+-- layouts/term.html --
+Term|{{ .Title }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "Section|Help|/help/")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "Page|How to frob|/help/how-to-frob/")
+	b.AssertFileContent("public/help/faq/q1/index.html", "/help/faq/q1/")
+
+	b.AssertFileContent("public/es/ayuda/index.html", "Section|Ayuda|/es/ayuda/")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Page|Como frobear|/es/ayuda/como-frobear/")
+	b.AssertFileContent("public/es/ayuda/preguntas/index.html", "Section|FAQ|/es/ayuda/preguntas/")
+	b.AssertFileContent("public/es/ayuda/preguntas/q1/index.html", "/es/ayuda/preguntas/q1/")
+	b.AssertFileContent("public/es/ayuda/other/index.html", "/es/ayuda/other/")
+	b.AssertFileExists("public/es/help/index.html", false)
+
+	b.AssertFileContent("public/es/etiquetas/index.html", "Taxonomy|Etiquetas|/es/etiquetas/")
+	b.AssertFileContent("public/es/etiquetas/bar/index.html", "Term|Foo|/es/etiquetas/bar/")
+}
