+// dirWithSectionSlugs returns the directory of p with each path element
+// replaced by the slug of the section, taxonomy or term page at that path, if any.
+// It returns an empty string if no slugs apply.
+func dirWithSectionSlugs(p *pageState, desc page.TargetPathDescriptor) string {
+	dir := desc.Path.ContainerDir()
+	if kinds.IsBranch(p.Kind()) {
+		dir = desc.Section.Base()
+	}
+	if dir == "" || dir == "/" {
+		return ""
+	}
+
+	slugs := map[string]string{}
+	add := func(bp page.Page) {
+		if bp.IsHome() {
+			return
+		}
+		if slug := bp.Slug(); slug != "" {
+			pi := bp.PathInfo()
+			if p.s.Conf.DisablePathToLower() {
+				pi = pi.Unnormalized()
+			}
+			slugs[pi.Base()] = slug
+		}
+	}
+	for _, a := range p.Ancestors() {
+		add(a)
+	}
+	if kinds.IsBranch(p.Kind()) {
+		add(p)
+	}
+	if len(slugs) == 0 {
+		return ""
+	}
+
+	elems := strings.Split(strings.Trim(dir, "/"), "/")
+	out := make([]string, len(elems))
+	for i, e := range elems {
+		out[i] = e
+		if slug, ok := slugs["/"+strings.Join(elems[:i+1], "/")]; ok {
+			out[i] = slug
+		}
+	}
+	return strings.Join(out, "/")
+}
