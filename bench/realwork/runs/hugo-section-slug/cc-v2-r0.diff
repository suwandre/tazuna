 }
+
+func TestSectionTaxonomyTermSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.org/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ["rss", "sitemap"]
+[taxonomies]
+tag = "tags"
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Cómo frobear
+slug: como-frobear
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+slug: sub-es
+---
+-- content/help/sub/p.es.md --
+---
+title: P
+tags: [t1]
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/t1/_index.es.md --
+---
+title: T1
+slug: etiqueta-uno
+---
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileExists("public/help/index.html", true)
+	b.AssertFileExists("public/help/how-to-frob/index.html", true)
+	b.AssertFileExists("public/es/ayuda/index.html", true)
+	b.AssertFileExists("public/es/ayuda/como-frobear/index.html", true)
+	b.AssertFileExists("public/es/ayuda/sub-es/index.html", true)
+	b.AssertFileExists("public/es/ayuda/sub-es/p/index.html", true)
+	b.AssertFileExists("public/es/help/index.html", false)
+	b.AssertFileExists("public/es/etiquetas/index.html", true)
+	b.AssertFileExists("public/es/etiquetas/etiqueta-uno/index.html", true)
+
+	b.AssertFileContent("public/es/ayuda/index.html", "section|/es/ayuda/")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|/es/ayuda/como-frobear/")
+	b.AssertFileContent("public/es/ayuda/sub-es/p/index.html", "page|/es/ayuda/sub-es/p/")
+	b.AssertFileContent("public/es/etiquetas/index.html", "taxonomy|/es/etiquetas/")
+	b.AssertFileContent("public/es/etiquetas/etiqueta-uno/index.html", "term|/es/etiquetas/etiqueta-uno/")
+}
