+
+// sectionSlugPaths returns the section path (for branch pages) and the container
+// directory (for regular pages) with the directory name of any section in the
+// page's hierarchy (including the page itself) replaced by its slug.
+// An empty string is returned when no slug applies.
+func sectionSlugPaths(p *pageState, pagePath, sectionPath *paths.Path) (sectionBase, containerDir string) {
+	var chain page.Pages
+	if kinds.IsBranch(p.Kind()) {
+		chain = append(chain, p)
+	}
+	chain = append(chain, p.Ancestors()...)
+
+	var slugs map[int]string
+	for _, a := range chain {
+		if a.IsHome() || a.Slug() == "" {
+			continue
+		}
+		n := strings.Count(a.PathInfo().Base(), "/")
+		if n == 0 {
+			continue
+		}
+		if slugs == nil {
+			slugs = make(map[int]string)
+		}
+		slugs[n-1] = a.Slug()
+	}
+
+	if slugs == nil {
+		return "", ""
+	}
+
+	apply := func(base string) string {
+		els := strings.Split(strings.Trim(base, "/"), "/")
+		changed := false
+		for i := range els {
+			if slug, ok := slugs[i]; ok && els[i] != "" {
+				els[i] = slug
+				changed = true
+			}
+		}
+		if !changed {
+			return ""
+		}
+		return "/" + strings.Join(els, "/")
+	}
+
+	if kinds.IsBranch(p.Kind()) {
+		return apply(sectionPath.Base()), ""
+	}
+	return "", apply(pagePath.ContainerDir())
+}
diff --git a/hugolib/site_sections_test.go b/hugolib/site_sections_test.go
index 779c380..d6a37e2 100644
--- a/hugolib/site_sections_test.go
+++ b/hugolib/site_sections_test.go
@@ -182,3 +182,73 @@ title: content/s1.md
 	b.AssertFileContent("public/s1.html", "content/s1.md")
 	b.AssertFileContent("public/s1/p1.html", "content/s1/p1.md")
 }
+
+func TestSectionSlug(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com/"
+defaultContentLanguage = "en"
+defaultContentLanguageInSubdir = false
+disableKinds = ['rss','sitemap']
+[taxonomies]
+tag = 'tags'
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: Frob
+tags: [t1]
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Frobear
+slug: como-frobear
+tags: [t1]
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+slug: sub-es
+---
+-- content/help/sub/p1.es.md --
+---
+title: P1
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/t1/_index.es.md --
+---
+title: T1
+slug: et1
+---
+-- layouts/all.html --
+{{ .Title }}|{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "Help|/help/")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "Frob|/help/how-to-frob/")
+	b.AssertFileContent("public/es/ayuda/index.html", "Ayuda|/es/ayuda/")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Frobear|/es/ayuda/como-frobear/")
+	b.AssertFileContent("public/es/ayuda/sub-es/index.html", "Sub|/es/ayuda/sub-es/")
+	b.AssertFileContent("public/es/ayuda/sub-es/p1/index.html", "P1|/es/ayuda/sub-es/p1/")
+	b.AssertFileContent("public/es/etiquetas/index.html", "Etiquetas|/es/etiquetas/")
+	b.AssertFileContent("public/es/etiquetas/et1/index.html", "T1|/es/etiquetas/et1/")
+}
