+func TestSectionSlugURLs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+defaultContentLanguage = 'en'
+defaultContentLanguageInSubdir = true
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+-- content/help/_index.en.md --
+-- content/help/_index.es.md --
+---
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+-- content/help/how-to-frob/index.es.md --
+---
+slug: como-frobear
+---
+-- layouts/list.html --
+{{ .RelPermalink }}
+-- layouts/single.html --
+{{ .RelPermalink }}
+`
+
+	b := Test(t, files)
+	b.AssertFileExists("public/en/help/index.html", true)
+}
