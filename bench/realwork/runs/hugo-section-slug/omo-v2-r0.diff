diff --git a/hugolib/page__paths.go b/hugolib/page__paths.go
index 46a3a99..720ef49 100644
--- a/hugolib/page__paths.go
+++ b/hugolib/page__paths.go
@@ -205,5 +205,53 @@ func createTargetPathDescriptor(p *pageState) (page.TargetPathDescriptor, error)
 		}
 	}
 
+	if desc.ExpandedPermalink == "" && desc.URL == "" {
+		switch p.Kind() {
+		case kinds.KindPage, kinds.KindSection, kinds.KindTaxonomy, kinds.KindTerm:
+			if sections := p.sectionsPathWithSlugs(); sections != "" {
+				if kinds.IsBranch(p.Kind()) {
+					desc.ExpandedPermalink = sections
+				} else {
+					desc.ExpandedPermalink = path.Join(sections, desc.BaseName)
+				}
+			}
+		}
+	}
+
 	return desc, nil
 }
+
+// sectionsPathWithSlugs returns the path of the current section where every
+// section with a slug has its path element(s) replaced by that slug.
+// It returns an empty string if no section has a slug.
+func (p *pageState) sectionsPathWithSlugs() string {
+	current := p.CurrentSection()
+	sections := append(current.Ancestors().Reverse(), current)
+
+	var (
+		elems   []string
+		parent  string
+		hasSlug bool
+	)
+	for _, s := range sections {
+		if s.IsHome() {
+			continue
+		}
+		pi := s.PathInfo()
+		if p.s.Conf.DisablePathToLower() {
+			pi = pi.Unnormalized()
+		}
+		elem := strings.Trim(strings.TrimPrefix(pi.Base(), parent), "/")
+		parent = pi.Base()
+		if slug := s.Slug(); slug != "" {
+			elem = slug
+			hasSlug = true
+		}
+		elems = append(elems, elem)
+	}
+
+	if !hasSlug {
+		return ""
+	}
+	return path.Join(elems...)
+}
