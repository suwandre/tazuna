+// sectionSlugBase returns p's base path with any slug set on p or its ancestors applied.
+// The bool is false if no slug was found.
+func sectionSlugBase(p page.Page, toLower bool) (string, bool) {
+	if p == nil || p.IsHome() {
+		return "", false
+	}
+	parent := p.Parent()
+	parentBase, found := sectionSlugBase(parent, toLower)
+	pi, ppi := p.PathInfo(), parent.PathInfo()
+	if !toLower {
+		pi, ppi = pi.Unnormalized(), ppi.Unnormalized()
+	}
+	rel := pi.Base()
+	if !parent.IsHome() {
+		rel = strings.TrimPrefix(rel, ppi.Base())
+	}
+	if slug := p.Slug(); slug != "" {
+		rel = path.Join(path.Dir(rel), slug)
+		found = true
+	}
+	return parentBase + rel, found
+}
diff --git a/hugolib/page_permalink_test.go b/hugolib/page_permalink_test.go
index d5ae693..fd5fde7 100644
--- a/hugolib/page_permalink_test.go
+++ b/hugolib/page_permalink_test.go
@@ -201,3 +201,82 @@ path = '/books/**'
 
 	b.AssertFileContent("public/shelf/my-book/index.html", "RelPermalink: /shelf/my-book/")
 }
+
+func TestSlugInSectionTaxonomyAndTerm(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ['rss','sitemap']
+defaultContentLanguage = 'en'
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+[taxonomies]
+tag = 'tags'
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+tags: [foo]
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+tags: [foo]
+---
+-- content/help/regular.es.md --
+---
+title: Regular
+---
+-- content/help/nodir/p1.es.md --
+---
+title: P1
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+slug: Subsección
+---
+-- content/help/sub/p2.es.md --
+---
+title: P2
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: fu
+---
+-- layouts/all.html --
+{{ .Title }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "Help|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "How to frob|/help/how-to-frob/|")
+	b.AssertFileContent("public/tags/foo/index.html", "|/tags/foo/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "Ayuda|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "Como frobear|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/regular/index.html", "Regular|/es/ayuda/regular/|")
+	b.AssertFileContent("public/es/ayuda/nodir/p1/index.html", "P1|/es/ayuda/nodir/p1/|")
+	b.AssertFileContent("public/es/ayuda/subsección/index.html", "Sub|/es/ayuda/subsecci%C3%B3n/|")
+	b.AssertFileContent("public/es/ayuda/subsección/p2/index.html", "P2|/es/ayuda/subsecci%C3%B3n/p2/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "Etiquetas|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "Foo|/es/etiquetas/fu/|")
+}
