+// slugifyDir replaces the path segments in dir belonging to s or any of its
+// ancestor sections with their slug, if set.
+func slugifyDir(s page.Page, dir string) string {
+	var parts []string
+	for ; s != nil && !s.IsHome(); s = s.Parent() {
+		slug := s.Slug()
+		if slug == "" {
+			continue
+		}
+		if parts == nil {
+			parts = strings.Split(dir, "/")
+		}
+		if i := strings.Count(s.Path(), "/"); i < len(parts) {
+			parts[i] = slug
+		}
+	}
+	if parts == nil {
+		return dir
+	}
+	return strings.Join(parts, "/")
+}
