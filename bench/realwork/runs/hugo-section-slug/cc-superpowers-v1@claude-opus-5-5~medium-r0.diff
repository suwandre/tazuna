@@ -201,3 +201,73 @@ path = '/books/**'
 
 	b.AssertFileContent("public/shelf/my-book/index.html", "RelPermalink: /shelf/my-book/")
 }
+
+func TestSlugInBranchPages(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "https://example.com"
+disableKinds = ["rss", "sitemap", "robotstxt", "404"]
+[languages.en]
+weight = 1
+[languages.es]
+weight = 2
+[taxonomies]
+tag = "tags"
+-- layouts/all.html --
+{{ .Kind }}|{{ .Title }}|{{ .RelPermalink }}|
+-- content/help/_index.en.md --
+---
+title: Help
+---
+-- content/help/_index.es.md --
+---
+title: Ayuda
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+title: How to frob
+---
+-- content/help/how-to-frob/index.es.md --
+---
+title: Como frobear
+slug: como-frobear
+---
+-- content/help/sub/_index.es.md --
+---
+title: Sub
+---
+-- content/help/sub/p1.es.md --
+---
+title: P1
+tags: [foo]
+---
+-- content/help/sub/nosection/p2.es.md --
+---
+title: P2
+---
+-- content/tags/_index.es.md --
+---
+title: Etiquetas
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+title: Foo
+slug: fu
+---
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "section|Help|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "page|How to frob|/help/how-to-frob/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "section|Ayuda|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|Como frobear|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/sub/index.html", "section|Sub|/es/ayuda/sub/|")
+	b.AssertFileContent("public/es/ayuda/sub/p1/index.html", "page|P1|/es/ayuda/sub/p1/|")
+	b.AssertFileContent("public/es/ayuda/sub/nosection/p2/index.html", "page|P2|/es/ayuda/sub/nosection/p2/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "taxonomy|Etiquetas|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "term|Foo|/es/etiquetas/fu/|")
+}
