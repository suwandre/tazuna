 }
 
+// sectionBaseWithSlugs returns the base path of the branch page p with any slugs
+// set in p or its ancestors applied.
+func sectionBaseWithSlugs(p page.Page, unnormalized bool) string {
+	if p.IsHome() {
+		return ""
+	}
+	pathBase := func(p page.Page) string {
+		if unnormalized {
+			return p.PathInfo().Unnormalized().Base()
+		}
+		return p.PathInfo().Base()
+	}
+	base := pathBase(p)
+	if parent := p.Parent(); parent != nil && !parent.IsHome() {
+		parentBase := pathBase(parent)
+		if parentSlugBase := sectionBaseWithSlugs(parent, unnormalized); parentSlugBase != parentBase {
+			base = parentSlugBase + strings.TrimPrefix(base, parentBase)
+		}
+	}
+	if slug := p.Slug(); slug != "" {
+		base = path.Join(path.Dir(base), slug)
+	}
+	return base
+}
