+
+// dirWithSectionSlugs returns dir with the path elements of any section
+// (including p itself, if it is a branch) with a slug replaced by that slug.
+// It returns "" if no slug applies.
+func dirWithSectionSlugs(p *pageState, dir string) string {
+	sections := p.Ancestors()
+	if kinds.IsBranch(p.Kind()) {
+		sections = append(sections, p)
+	}
+
+	var elems []string
+	for _, s := range sections {
+		slug := s.Slug()
+		if slug == "" || s.IsHome() || !kinds.IsBranch(s.Kind()) {
+			continue
+		}
+		if elems == nil {
+			elems = strings.Split(strings.Trim(dir, "/"), "/")
+		}
+		if i := strings.Count(s.Path(), "/") - 1; i < len(elems) {
+			elems[i] = slug
+		}
+	}
+
+	if elems == nil {
+		return ""
+	}
+	return "/" + strings.Join(elems, "/")
+}
diff --git a/hugolib/page_permalink_test.go b/hugolib/page_permalink_test.go
index d5ae693..14481ae 100644
--- a/hugolib/page_permalink_test.go
+++ b/hugolib/page_permalink_test.go
@@ -201,3 +201,57 @@ path = '/books/**'
 
 	b.AssertFileContent("public/shelf/my-book/index.html", "RelPermalink: /shelf/my-book/")
 }
+
+func TestSlugInSectionTaxonomyAndTermPages(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ['rss','sitemap']
+defaultContentLanguage = 'en'
+[languages.en]
+[languages.es]
+[taxonomies]
+tag = 'tags'
+-- content/help/_index.en.md --
+-- content/help/_index.es.md --
+---
+slug: ayuda
+---
+-- content/help/how-to-frob/index.en.md --
+---
+tags: [foo]
+---
+-- content/help/how-to-frob/index.es.md --
+---
+slug: como-frobear
+tags: [foo, bar]
+---
+-- content/help/sub/_index.es.md --
+-- content/help/sub/p1.es.md --
+-- content/help/plain/p2.es.md --
+-- content/tags/_index.es.md --
+---
+slug: etiquetas
+---
+-- content/tags/foo/_index.es.md --
+---
+slug: fu
+---
+-- layouts/all.html --
+{{ .Kind }}|{{ .RelPermalink }}|
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/help/index.html", "section|/help/|")
+	b.AssertFileContent("public/help/how-to-frob/index.html", "page|/help/how-to-frob/|")
+	b.AssertFileContent("public/es/ayuda/index.html", "section|/es/ayuda/|")
+	b.AssertFileContent("public/es/ayuda/como-frobear/index.html", "page|/es/ayuda/como-frobear/|")
+	b.AssertFileContent("public/es/ayuda/sub/index.html", "section|/es/ayuda/sub/|")
+	b.AssertFileContent("public/es/ayuda/sub/p1/index.html", "page|/es/ayuda/sub/p1/|")
+	b.AssertFileContent("public/es/ayuda/plain/p2/index.html", "page|/es/ayuda/plain/p2/|")
+	b.AssertFileContent("public/es/etiquetas/index.html", "taxonomy|/es/etiquetas/|")
+	b.AssertFileContent("public/es/etiquetas/fu/index.html", "term|/es/etiquetas/fu/|")
+	b.AssertFileContent("public/es/etiquetas/bar/index.html", "term|/es/etiquetas/bar/|")
+}
