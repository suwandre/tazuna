+
+// applySectionSlugs replaces the path segments of the section hierarchy with
+// the slugs defined in the front matter of the corresponding section pages
+// (this includes taxonomy and term pages).
+func applySectionSlugs(p *pageState, desc *page.TargetPathDescriptor) error {
+	if p.IsHome() {
+		return nil
+	}
+
+	isBranch := kinds.IsBranch(p.Kind())
+
+	// Collect the slugs by (lower cased) section path, starting with the
+	// page itself if it is a branch page.
+	var slugs map[string]string
+	add := func(pp page.Page) {
+		if pp == nil || pp.IsHome() {
+			return
+		}
+		pm, ok := pp.(*pageState)
+		if !ok || pm.m.Slug() == "" {
+			return
+		}
+		if slugs == nil {
+			slugs = make(map[string]string)
+		}
+		slugs[strings.ToLower(pm.PathInfo().Base())] = pm.m.Slug()
+	}
+
+	if isBranch {
+		add(p)
+	}
+	for _, a := range p.Ancestors() {
+		add(a)
+	}
+
+	if slugs == nil {
+		return nil
+	}
+
+	var dir string
+	if isBranch {
+		dir = desc.Section.Base()
+	} else {
+		dir = desc.Path.ContainerDir()
+	}
+
+	segments := strings.Split(strings.Trim(dir, "/"), "/")
+	var changed bool
+	var prefix string
+	for i, seg := range segments {
+		if seg == "" {
+			continue
+		}
+		prefix += "/" + seg
+		if slug, found := slugs[strings.ToLower(prefix)]; found {
+			segments[i] = slug
+			changed = true
+		}
+	}
+
+	if !changed {
+		return nil
+	}
+
+	result := strings.Join(segments, "/")
+	if isBranch {
+		desc.SectionBase = result
+	} else {
+		desc.ContainerDir = result
+	}
+	return nil
+}
