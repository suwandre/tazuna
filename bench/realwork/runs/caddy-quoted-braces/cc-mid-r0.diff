 	d.nesting++
@@ -406,7 +406,7 @@ func (d *Dispenser) Reset() {
 // a line break or open curly brace was encountered instead of
 // an argument.
 func (d *Dispenser) ArgErr() error {
-	if d.Val() == "{" {
+	if d.isOpenBrace() {
 		return d.Err("unexpected token '{', expecting argument")
 	}
 	return d.Errf("wrong argument count or unexpected line ending after '%s'", d.Val())
@@ -531,3 +531,15 @@ func (d *Dispenser) isNextOnNewLine() bool {
 }
 
 const MatcherNameCtxKey = "matcher_name"
+
+// isOpenBrace returns true if the current token is an unquoted
+// opening curly brace. Quoted braces are plain values.
+func (d *Dispenser) isOpenBrace() bool {
+	return d.Val() == "{" && !d.Token().Quoted()
+}
+
+// isCloseBrace returns true if the current token is an unquoted
+// closing curly brace. Quoted braces are plain values.
+func (d *Dispenser) isCloseBrace() bool {
+	return d.Val() == "}" && !d.Token().Quoted()
+}
