--- a/caddyconfig/caddyfile/lexer.go
+++ b/caddyconfig/caddyfile/lexer.go
@@ -347,6 +347,16 @@ func (t Token) Quoted() bool {
 	return t.wasQuoted > 0
 }
 
+// isBrace reports whether the token is the unquoted text s.
+// Quoted tokens are string literals, so they never act as
+// structural punctuation.
+func (t Token) isBrace(s string) bool {
+	return t.wasQuoted == 0 && t.Text == s
+}
+
+func (t Token) isOpenBrace() bool  { return t.isBrace("{") }
+func (t Token) isCloseBrace() bool { return t.isBrace("}") }
+
 // NumLineBreaks counts how many line breaks are in the token text.
 func (t Token) NumLineBreaks() int {
 	lineBreaks := strings.Count(t.Text, "\n")
