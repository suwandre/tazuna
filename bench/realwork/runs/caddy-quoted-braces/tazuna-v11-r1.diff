diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..101c7c7 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,56 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesDoNotAffectBlockParsing(t *testing.T) {
+	for i, input := range []string{
+		":8080 {\n\trespond \"{\"\n}",
+		":8080 {\n\trespond \"}\"\n}",
+		":8080 {\n\trespond \"{}\"\n}",
+		":8080 {\n\trespond `{`\n}",
+		":8080 {\n\trespond \"{\" 200\n}",
+		":8080 {\n\theader {\n\t\tX-Test \"{\"\n\t\tX-Other \"}\"\n\t}\n}",
+		"(snip) {\n\trespond \"{\"\n}\n:8080 {\n\timport snip\n}",
+		"(snip) {\n\trespond \"}\"\n}\n:8080 {\n\timport snip\n}",
+	} {
+		blocks, err := Parse("Caddyfile", []byte(input))
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) == 0 {
+			t.Errorf("Test %d: expected at least one server block", i)
+		}
+	}
+
+	// a quoted brace is just an argument, not a block opener or closer
+	blocks, err := Parse("Caddyfile", []byte(":8080 {\n\trespond \"{\"\n}"))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(blocks) != 1 || len(blocks[0].Segments) != 1 {
+		t.Fatalf("expected 1 block with 1 segment, got %+v", blocks)
+	}
+	d := NewDispenser(blocks[0].Segments[0])
+	if !d.Next() || d.Val() != "respond" {
+		t.Fatalf("expected 'respond', got '%s'", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Errorf("expected quoted '{' to be an argument, got '%s'", d.Val())
+	}
+	if d.NextBlock(d.Nesting()) {
+		t.Error("quoted '{' must not open a block")
+	}
+}
+
+func TestUnbalancedUnquotedBracesStillError(t *testing.T) {
+	for i, input := range []string{
+		":8080 {\n\trespond {\n",
+		":8080 {\n\trespond \"}\"\n",
+		":8080 {\n\trespond \"{\"\n\trespond \"}\"\n",
+	} {
+		if _, err := Parse("Caddyfile", []byte(input)); err == nil {
+			t.Errorf("Test %d: expected error but got none", i)
+		}
+	}
+}
