diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..ae92c5b 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,43 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesDoNotAffectBlocks(t *testing.T) {
+	for i, input := range []string{
+		":8080 {\n\trespond \"{\"\n}",
+		":8080 {\n\trespond \"}\"\n}",
+		":8080 {\n\trespond `{`\n}",
+		":8080 {\n\trespond `}`\n}",
+		":8080 {\n\theader {\n\t\tX-Foo \"}\"\n\t}\n\trespond \"{\" 200\n}",
+		"(snip) {\n\trespond \"}\"\n}\n:8080 {\n\timport snip\n}",
+	} {
+		p := testParser(input)
+		blocks, err := p.parseAll()
+		if err != nil {
+			t.Fatalf("Test %d: parseAll: %v", i, err)
+		}
+		if len(blocks) != 1 {
+			t.Fatalf("Test %d: expected exactly one server block, got %d", i, len(blocks))
+		}
+		if actual := blocks[0].GetKeysText()[0]; actual != ":8080" {
+			t.Fatalf("Test %d: expected server block key :8080, got %q", i, actual)
+		}
+
+		if i != 0 {
+			continue
+		}
+		if len(blocks[0].Segments) != 1 {
+			t.Fatalf("Test %d: expected 1 segment, got %d", i, len(blocks[0].Segments))
+		}
+		segment := blocks[0].Segments[0]
+		if len(segment) != 2 {
+			t.Fatalf("Test %d: expected 2 tokens in segment, got %d", i, len(segment))
+		}
+		if segment[0].Text != "respond" {
+			t.Fatalf("Test %d: expected first token %q, got %q", i, "respond", segment[0].Text)
+		}
+		if segment[1].Text != "{" || segment[1].wasQuoted != '"' {
+			t.Fatalf("Test %d: expected quoted %q token, got %q (quote %q)", i, "{", segment[1].Text, segment[1].wasQuoted)
+		}
+	}
+}
