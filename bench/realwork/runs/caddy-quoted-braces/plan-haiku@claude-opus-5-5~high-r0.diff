diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..407fb18 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,37 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBraces(t *testing.T) {
+	input := "dir \"{\" \"}\"\ndir2 {\n\tsub \"}\"\n}"
+	d := NewTestDispenser(input)
+
+	d.Next() // dir
+	if actual, expected := d.RemainingArgs(), []string{"{", "}"}; !reflect.DeepEqual(actual, expected) {
+		t.Fatalf("RemainingArgs: expected %v, got %v", expected, actual)
+	}
+
+	d.Next() // dir2
+	var vals []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		vals = append(vals, d.Val())
+	}
+	if expected := []string{"sub", "}"}; !reflect.DeepEqual(vals, expected) {
+		t.Fatalf("NextBlock values: expected %v, got %v", expected, vals)
+	}
+	if d.Nesting() != 0 {
+		t.Fatalf("expected nesting 0 after block, got %d", d.Nesting())
+	}
+
+	d = NewTestDispenser("dir \"{\"")
+	d.Next() // dir
+	if d.NextBlock(0) {
+		t.Fatal("NextBlock: expected false for quoted '{' argument")
+	}
+	if !d.NextArg() {
+		t.Fatal("NextArg: expected true for quoted '{' argument")
+	}
+	if actual := d.Val(); actual != "{" {
+		t.Fatalf("NextArg: expected value %q, got %q", "{", actual)
+	}
+}
diff --git a/caddyconfig/caddyfile/lexer.go b/caddyconfig/caddyfile/lexer.go
