+// isOpenCurlyBrace reports whether the current token is an unquoted "{".
+// Quoted "{" tokens are regular arguments, not block openings.
+func (d *Dispenser) isOpenCurlyBrace() bool {
+	return !d.Token().Quoted() && d.Val() == "{"
+}
+
+// isCloseCurlyBrace reports whether the current token is an unquoted "}".
+// Quoted "}" tokens are regular arguments, not block closings.
+func (d *Dispenser) isCloseCurlyBrace() bool {
+	return !d.Token().Quoted() && d.Val() == "}"
+}
+
 // isNewLine determines whether the current token is on a different
 // line (higher line number) than the previous token. It handles imported
 // tokens correctly. If there isn't a previous token, it returns true.
diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..2b32f46 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,60 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedCurlyBraceIsArgument(t *testing.T) {
+	// a quoted "{" after a directive is an argument, not a block opening
+	d := NewTestDispenser(`dir "{"`)
+	if !d.Next() || d.Val() != "dir" {
+		t.Fatalf("expected to load 'dir', got '%s'", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Fatalf("NextArg(): expected quoted '{' as argument, got '%s'", d.Val())
+	}
+	if d.NextArg() {
+		t.Errorf("NextArg(): should not load another argument (val: '%s')", d.Val())
+	}
+	if d.NextBlock(0) {
+		t.Errorf("NextBlock(): quoted '{' should not open a block")
+	}
+
+	// a quoted "}" after a directive is an argument too
+	d = NewTestDispenser(`dir "}"`)
+	d.Next()
+	if !d.NextArg() || d.Val() != "}" {
+		t.Errorf("NextArg(): expected quoted '}' as argument, got '%s'", d.Val())
+	}
+}
+
+func TestDispenser_NextBlockWithQuotedCurlyBraces(t *testing.T) {
+	for i, tc := range []struct {
+		input    string
+		expected []string // values iterated inside the block
+	}{
+		{"dir {\n\tfoo \"}\"\n}", []string{"foo", "}"}},
+		{"dir {\n\tfoo \"{\"\n}", []string{"foo", "{"}},
+		{"dir {\n\tfoo `}`\n\tbar `{`\n}", []string{"foo", "}", "bar", "{"}},
+		{"dir {\n\tfoo \"}\"\n\tbar\n}\nnext", []string{"foo", "}", "bar"}},
+	} {
+		d := NewTestDispenser(tc.input)
+		if !d.Next() || d.Val() != "dir" {
+			t.Fatalf("Test %d: expected to load 'dir', got '%s'", i, d.Val())
+		}
+		var got []string
+		for nesting := d.Nesting(); d.NextBlock(nesting); {
+			got = append(got, d.Val())
+		}
+		if len(got) != len(tc.expected) {
+			t.Errorf("Test %d: expected values %q, got %q", i, tc.expected, got)
+			continue
+		}
+		for j := range got {
+			if got[j] != tc.expected[j] {
+				t.Errorf("Test %d: value %d: expected '%s', got '%s'", i, j, tc.expected[j], got[j])
+			}
+		}
+		if d.Nesting() != 0 {
+			t.Errorf("Test %d: expected nesting 0 after block, got %d", i, d.Nesting())
+		}
+	}
+}
