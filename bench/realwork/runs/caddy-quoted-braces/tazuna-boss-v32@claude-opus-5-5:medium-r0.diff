diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..4d8520b 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -18,6 +18,7 @@ import (
 	"bytes"
 	"os"
 	"path/filepath"
+	"reflect"
 	"strings"
 	"testing"
 )
@@ -1034,3 +1035,108 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+// TestParseQuotedCurlyBraces ensures that quoted (or backtick or heredoc)
+// "{" and "}" tokens are treated as ordinary arguments, not block delimiters.
+func TestParseQuotedCurlyBraces(t *testing.T) {
+	for i, tc := range []struct {
+		input        string
+		wantErr      bool
+		wantSegments [][]string // segment token texts, in order, for the first server block
+	}{
+		{
+			input:        ":8080 {\n\trespond \"{\"\n}",
+			wantSegments: [][]string{{"respond", "{"}},
+		},
+		{
+			input:        ":8080 {\n\trespond \"}\"\n}",
+			wantSegments: [][]string{{"respond", "}"}},
+		},
+		{
+			input:        ":8080 {\n\trespond `{`\n}",
+			wantSegments: [][]string{{"respond", "{"}},
+		},
+		{
+			input:        ":8080 {\n\trespond `}`\n}",
+			wantSegments: [][]string{{"respond", "}"}},
+		},
+		{
+			input:        ":8080 {\n\trespond <<EOF\n{\nEOF\n}",
+			wantSegments: [][]string{{"respond", "{"}},
+		},
+		{
+			input: ":8080 {\n\thandle {\n\t\trespond \"}\"\n\t}\n}",
+			wantSegments: [][]string{
+				{"handle", "{", "respond", "}", "}"},
+			},
+		},
+		{
+			input: ":8080 {\n\thandle {\n\t\trespond \"{\"\n\t\trespond \"{\"\n\t}\n\trespond \"}\"\n}",
+			wantSegments: [][]string{
+				{"handle", "{", "respond", "{", "respond", "{", "}"},
+				{"respond", "}"},
+			},
+		},
+		{
+			// a quoted "}" must not close the block, so this is missing its real closing brace
+			input:   ":8080 {\n\trespond \"}\"\n",
+			wantErr: true,
+		},
+	} {
+		blocks, err := Parse("Testfile", []byte(tc.input))
+		if tc.wantErr {
+			if err == nil {
+				t.Errorf("Test %d: expected error but got none", i)
+			}
+			continue
+		}
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 {
+			t.Fatalf("Test %d: expected 1 server block, got %d", i, len(blocks))
+		}
+		var gotSegments [][]string
+		for _, seg := range blocks[0].Segments {
+			var texts []string
+			for _, tkn := range seg {
+				texts = append(texts, tkn.Text)
+			}
+			gotSegments = append(gotSegments, texts)
+		}
+		if !reflect.DeepEqual(gotSegments, tc.wantSegments) {
+			t.Errorf("Test %d: expected segments %q, got %q", i, tc.wantSegments, gotSegments)
+		}
+	}
+}
+
+// TestParseQuotedCurlyBracesInSnippet checks that quoted braces inside an
+// imported snippet are preserved and do not affect block nesting.
+func TestParseQuotedCurlyBracesInSnippet(t *testing.T) {
+	p := testParser(`
+		(common) {
+			respond "}"
+			respond "{"
+		}
+		:8080 {
+			import common
+		}
+	`)
+	blocks, err := p.parseAll()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(blocks) != 1 {
+		t.Fatalf("Expected exactly one server block, got %d", len(blocks))
+	}
+	if len(blocks[0].Segments) != 2 {
+		t.Fatalf("Expected 2 segments from snippet, got %d", len(blocks[0].Segments))
+	}
+	if actual, expected := blocks[0].Segments[0][1].Text, "}"; expected != actual {
+		t.Errorf("Expected first segment argument to be '%s' but was '%s'", expected, actual)
+	}
+	if actual, expected := blocks[0].Segments[1][1].Text, "{"; expected != actual {
+		t.Errorf("Expected second segment argument to be '%s' but was '%s'", expected, actual)
+	}
+}
