+// isOpenCurly reports whether the current token is an unquoted
+// opening curly brace. Quoted braces are plain values.
+func (d *Dispenser) isOpenCurly() bool {
+	return d.Val() == "{" && !d.Token().Quoted()
+}
+
+// isCloseCurly reports whether the current token is an unquoted
+// closing curly brace. Quoted braces are plain values.
+func (d *Dispenser) isCloseCurly() bool {
+	return d.Val() == "}" && !d.Token().Quoted()
+}
