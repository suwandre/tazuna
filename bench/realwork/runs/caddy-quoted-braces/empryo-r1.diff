diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..fce21ca 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,37 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestParseQuotedBraces(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		input string
+		want  [][]string
+	}{
+		{"quoted open", ":8080 {\n\trespond \"{\"\n}\n", [][]string{{"respond", "{"}}},
+		{"quoted close", ":8080 {\n\trespond \"}\"\n}\n", [][]string{{"respond", "}"}}},
+		{"quoted both", ":8080 {\n\trespond \"{\"\n\trespond \"}\"\n}\n", [][]string{{"respond", "{"}, {"respond", "}"}}},
+		{"backtick open", ":8080 {\n\trespond `{`\n}\n", [][]string{{"respond", "{"}}},
+		{"inside nested block", ":8080 {\n\thandle {\n\t\trespond \"{\"\n\t}\n\trespond \"}\"\n}\n", [][]string{{"handle", "{", "respond", "{", "}"}, {"respond", "}"}}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			blocks, err := Parse("Caddyfile", []byte(tc.input))
+			if err != nil {
+				t.Fatalf("Parse: %v", err)
+			}
+			if len(blocks) != 1 || len(blocks[0].Segments) != len(tc.want) {
+				t.Fatalf("unexpected blocks: %+v", blocks)
+			}
+			for i, seg := range tc.want {
+				if len(blocks[0].Segments[i]) != len(seg) {
+					t.Fatalf("segment %d: got %d tokens, want %v", i, len(blocks[0].Segments[i]), seg)
+				}
+				for j, v := range seg {
+					if got := blocks[0].Segments[i][j].Text; got != v {
+						t.Errorf("segment %d token %d: got %q want %q", i, j, got, v)
+					}
+				}
+			}
+		})
+	}
+}
