--- a/caddyconfig/caddyfile/dispenser.go
+++ b/caddyconfig/caddyfile/dispenser.go
@@ -90,7 +90,7 @@ func (d *Dispenser) NextArg() bool {
 	if !d.nextOnSameLine() {
 		return false
 	}
-	if d.Val() == "{" {
+	if d.isOpenCurly() {
 		// roll back; a block opening is not an argument
 		d.cursor--
 		return false
@@ -179,12 +179,12 @@ func (d *Dispenser) NextBlock(initialNestingLevel int) bool {
 	if !d.nextOnSameLine() { // block must open on same line
 		return false
 	}
-	if d.Val() != "{" {
+	if !d.isOpenCurly() {
 		d.cursor-- // roll back if not opening brace
 		return false
 	}
 	d.Next() // consume open curly brace
-	if d.Val() == "}" {
+	if d.isCloseCurly() {
 		return false // open and then closed right away
 	}
 	d.nesting++
@@ -406,7 +406,7 @@ func (d *Dispenser) Reset() {
 // a line break or open curly brace was encountered instead of
 // an argument.
 func (d *Dispenser) ArgErr() error {
-	if d.Val() == "{" {
+	if d.isOpenCurly() {
 		return d.Err("unexpected token '{', expecting argument")
 	}
 	return d.Errf("wrong argument count or unexpected line ending after '%s'", d.Val())
@@ -531,3 +531,13 @@ func (d *Dispenser) isNextOnNewLine() bool {
 }
 
 const MatcherNameCtxKey = "matcher_name"
+
+// isOpenCurly returns true if the current token is an unquoted "{".
+func (d *Dispenser) isOpenCurly() bool {
+	return d.Val() == "{" && !d.Token().Quoted()
+}
+
+// isCloseCurly returns true if the current token is an unquoted "}".
+func (d *Dispenser) isCloseCurly() bool {
+	return d.Val() == "}" && !d.Token().Quoted()
+}
diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..18d7306 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,20 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBracesIgnored(t *testing.T) {
+	input := `foo {
+		bar "{"
+		baz "}"
+	}`
+	d := NewTestDispenser(input)
+	var lines []string
+	for d.Next() {
+		for nesting := d.Nesting(); d.NextBlock(nesting); {
+			lines = append(lines, d.Val()+" "+strings.Join(d.RemainingArgs(), " "))
+		}
+	}
+	if len(lines) != 2 || lines[0] != "bar {" || lines[1] != "baz }" {
+		t.Errorf("unexpected block lines: %v", lines)
+	}
+}
