diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..68db918 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,28 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBracesAreArguments(t *testing.T) {
+	input := "foo \"{\" \"}\" {\n\tbar \"{\"\n\tbaz \"}\"\n}"
+	d := NewTestDispenser(input)
+
+	if !d.Next() || d.Val() != "foo" {
+		t.Fatalf("expected 'foo', got '%s'", d.Val())
+	}
+	for _, want := range []string{"{", "}"} {
+		if !d.NextArg() || d.Val() != want {
+			t.Fatalf("expected quoted argument %q, got %q", want, d.Val())
+		}
+	}
+	if d.NextArg() {
+		t.Fatalf("unquoted '{' must not be an argument, got '%s'", d.Val())
+	}
+
+	var subdirs [][]string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		subdirs = append(subdirs, append([]string{d.Val()}, d.RemainingArgs()...))
+	}
+	if len(subdirs) != 2 || subdirs[0][1] != "{" || subdirs[1][1] != "}" {
+		t.Errorf("unexpected block contents: %v", subdirs)
+	}
+}
diff --git a/caddyconfig/caddyfile/lexer.go b/caddyconfig/caddyfile/lexer.go
index 40ea2e5..e18aacb 100644
--- a/caddyconfig/caddyfile/lexer.go
+++ b/caddyconfig/caddyfile/lexer.go
@@ -347,6 +347,18 @@ func (t Token) Quoted() bool {
 	return t.wasQuoted > 0
 }
 
+// isOpenBrace returns true if the token is an unquoted
+// opening curly brace, i.e. one that opens a block.
+func (t Token) isOpenBrace() bool {
+	return t.Text == "{" && !t.Quoted()
+}
+
+// isCloseBrace returns true if the token is an unquoted
+// closing curly brace, i.e. one that closes a block.
+func (t Token) isCloseBrace() bool {
+	return t.Text == "}" && !t.Quoted()
+}
+
 // NumLineBreaks counts how many line breaks are in the token text.
 func (t Token) NumLineBreaks() int {
 	lineBreaks := strings.Count(t.Text, "\n")
