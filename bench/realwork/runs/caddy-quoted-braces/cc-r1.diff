diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..ec6b06a 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,40 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesDoNotAffectBlocks(t *testing.T) {
+	for i, tc := range []struct {
+		input string
+		args  []string // expected tokens of the first directive's segment
+	}{
+		{"localhost {\n\trespond \"{\"\n}", []string{"respond", "{"}},
+		{"localhost {\n\trespond \"}\"\n}", []string{"respond", "}"}},
+		{"localhost {\n\trespond `{`\n}", []string{"respond", "{"}},
+		{"localhost {\n\trespond \"{\" 200\n}", []string{"respond", "{", "200"}},
+		{"localhost {\n\trespond \"}\" {\n\t\tclose\n\t}\n}", []string{"respond", "}", "{", "close", "}"}},
+		{"(snip) {\n\trespond \"{\"\n}\nlocalhost {\n\timport snip\n}", []string{"respond", "{"}},
+		{"localhost {\n\trespond \"{\" \"}\"\n}", []string{"respond", "{", "}"}},
+	} {
+		blocks, err := Parse("Caddyfile", []byte(tc.input))
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 {
+			t.Errorf("Test %d: expected 1 server block, got %d", i, len(blocks))
+			continue
+		}
+		segs := blocks[0].Segments
+		if len(segs) != 1 {
+			t.Errorf("Test %d: expected 1 segment, got %d", i, len(segs))
+			continue
+		}
+		var got []string
+		for _, tkn := range segs[0] {
+			got = append(got, tkn.Text)
+		}
+		if strings.Join(got, "\x00") != strings.Join(tc.args, "\x00") {
+			t.Errorf("Test %d: expected tokens %q, got %q", i, tc.args, got)
+		}
+	}
+}
