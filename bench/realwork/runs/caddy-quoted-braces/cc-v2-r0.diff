+	if !d.NextArg() || d.Val() != "{" {
+		t.Errorf("expected quoted { to be an argument, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "}" {
+		t.Errorf("expected quoted } to be an argument, got %q", d.Val())
+	}
+}
