+func TestDispenser_NextBlockQuotedBraces(t *testing.T) {
+	d := NewTestDispenser(`foobar {
+		sub1 "{"
+		sub2 "}"
+		sub3 {
+			nested "}"
+		}
+	}`)
+
+	var subs []string
+	for d.Next() {
+		for nesting := d.Nesting(); d.NextBlock(nesting); {
+			subs = append(subs, d.Val())
+			if d.Val() == "sub1" || d.Val() == "sub2" || d.Val() == "nested" {
+				if !d.NextArg() {
+					t.Fatalf("expected argument after %s", d.Val())
+				}
+			}
+		}
+	}
+	if got, want := strings.Join(subs, ","), "sub1,sub2,sub3,{,nested,}"; got != want {
+		t.Errorf("expected subdirectives %q, got %q", want, got)
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("expected nesting 0, got %d", d.Nesting())
+	}
+}
