+// isOpenBrace returns true if the token is an unquoted opening
+// curly brace, i.e. one that opens a block. A quoted "{" is just
+// a regular string value.
+func (t Token) isOpenBrace() bool {
+	return t.Text == "{" && t.wasQuoted == 0
+}
+
+// isCloseBrace returns true if the token is an unquoted closing
+// curly brace, i.e. one that closes a block. A quoted "}" is just
+// a regular string value.
+func (t Token) isCloseBrace() bool {
+	return t.Text == "}" && t.wasQuoted == 0
+}
