 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesDoNotAffectBlockParsing(t *testing.T) {
+	for i, tc := range []struct {
+		input    string
+		wantArgs [][]string // expected token text per segment of the first block
+	}{
+		{input: ":8080 {\n\trespond \"{\"\n}\n", wantArgs: [][]string{{"respond", "{"}}},
+		{input: ":8080 {\n\trespond \"}\"\n}\n", wantArgs: [][]string{{"respond", "}"}}},
+		{input: ":8080 {\n\trespond `{`\n}\n", wantArgs: [][]string{{"respond", "{"}}},
+		{input: ":8080 {\n\theader {\n\t\tX \"}\"\n\t\tY \"{\"\n\t}\n}\n", wantArgs: [][]string{{"header", "{", "X", "}", "Y", "{", "}"}}},
+		{input: ":8080 {\n\trespond \"{\" 200\n\trespond \"}\" 200\n}\n", wantArgs: [][]string{{"respond", "{", "200"}, {"respond", "}", "200"}}},
+		{input: ":8080\nrespond \"}\"\n", wantArgs: [][]string{{"respond", "}"}}},
+	} {
+		blocks, err := Parse("Caddyfile", []byte(tc.input))
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 {
+			t.Errorf("Test %d: expected 1 server block, got %d", i, len(blocks))
+			continue
+		}
+		segments := blocks[0].Segments
+		if len(segments) != len(tc.wantArgs) {
+			t.Errorf("Test %d: expected %d segments, got %d", i, len(tc.wantArgs), len(segments))
+			continue
+		}
+		for j, seg := range segments {
+			var got []string
+			for _, tkn := range seg {
+				got = append(got, tkn.Text)
+			}
+			if strings.Join(got, "\x00") != strings.Join(tc.wantArgs[j], "\x00") {
+				t.Errorf("Test %d, segment %d: expected %q, got %q", i, j, tc.wantArgs[j], got)
+			}
+		}
+	}
+}
+
+func TestQuotedBracesInSnippet(t *testing.T) {
+	p := testParser(`
+		(snip) {
+			respond "}"
+		}
+		(snip2) {
+			respond "{"
+		}
+		:8080 {
+			import snip
+			import snip2
+		}
+	`)
+	blocks, err := p.parseAll()
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(blocks) != 1 || len(blocks[0].Segments) != 2 {
+		t.Fatalf("expected 1 block with 2 segments, got %+v", blocks)
+	}
+	if got := blocks[0].Segments[0][1].Text; got != "}" {
+		t.Errorf("expected first value %q, got %q", "}", got)
+	}
+	if got := blocks[0].Segments[1][1].Text; got != "{" {
+		t.Errorf("expected second value %q, got %q", "{", got)
+	}
+}
