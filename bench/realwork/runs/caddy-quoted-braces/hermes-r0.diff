+func TestQuotedBracesDoNotAffectBlockParsing(t *testing.T) {
+	for i, tc := range []struct {
+		input        string
+		expectedKeys []string
+		expectedSegs [][]string
+		wantErr      bool
+	}{
+		{
+			input:        ":8080 {\n\trespond \"{\"\n}",
+			expectedKeys: []string{":8080"},
+			expectedSegs: [][]string{{"respond", "{"}},
+		},
+		{
+			input:        ":8080 {\n\trespond \"}\"\n}",
+			expectedKeys: []string{":8080"},
+			expectedSegs: [][]string{{"respond", "}"}},
+		},
+		{
+			input:        ":8080 {\n\trespond `{`\n\theader X `}`\n}",
+			expectedKeys: []string{":8080"},
+			expectedSegs: [][]string{{"respond", "{"}, {"header", "X", "}"}},
+		},
+		{
+			input:        ":8080 {\n\theader {\n\t\tX \"{\"\n\t\tY \"}\"\n\t}\n\trespond ok\n}",
+			expectedKeys: []string{":8080"},
+			expectedSegs: [][]string{{"header", "{", "X", "{", "Y", "}", "}"}, {"respond", "ok"}},
+		},
+		{
+			// no braces around the site block
+			input:        ":8080\nrespond \"{\"",
+			expectedKeys: []string{":8080"},
+			expectedSegs: [][]string{{"respond", "{"}},
+		},
+		{
+			// a quoted "}" must not close the site block
+			input:   ":8080 {\n\trespond \"}\"",
+			wantErr: true,
+		},
+	} {
+		p := testParser(tc.input)
+		blocks, err := p.parseAll()
+		if tc.wantErr {
+			if err == nil {
+				t.Errorf("Test %d: expected error but got none", i)
+			}
+			continue
+		}
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 {
+			t.Errorf("Test %d: expected 1 block, got %d", i, len(blocks))
+			continue
+		}
+		if keys := blocks[0].GetKeysText(); !slices.Equal(keys, tc.expectedKeys) {
+			t.Errorf("Test %d: expected keys %v, got %v", i, tc.expectedKeys, keys)
+		}
+		if len(blocks[0].Segments) != len(tc.expectedSegs) {
+			t.Errorf("Test %d: expected %d segments, got %d", i, len(tc.expectedSegs), len(blocks[0].Segments))
+			continue
+		}
+		for j, seg := range blocks[0].Segments {
+			var texts []string
+			for _, tkn := range seg {
+				texts = append(texts, tkn.Text)
+			}
+			if !slices.Equal(texts, tc.expectedSegs[j]) {
+				t.Errorf("Test %d: segment %d: expected %v, got %v", i, j, tc.expectedSegs[j], texts)
+			}
+		}
+	}
+}
+
+func TestQuotedBracesInSnippetsAndImportBlocks(t *testing.T) {
+	p := testParser(`
+		(snip) {
+			respond "{"
+		}
+
+		(snip2) {
+			{blocks.foo}
+		}
+
+		:8080 {
+			import snip
+			import snip2 {
+				foo {
+					respond "}"
+				}
+			}
+		}
+	`)
+	if _, err := p.parseAll(); err != nil {
+		t.Errorf("Expected error to be nil but got '%v'", err)
+	}
+}
+
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
