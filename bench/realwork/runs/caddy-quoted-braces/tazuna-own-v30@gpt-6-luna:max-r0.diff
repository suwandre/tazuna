+func TestDispenser_NextArgQuotedBraces(t *testing.T) {
+	d := NewTestDispenser(`respond "{" "}" "{}" {`)
+	if !d.Next() {
+		t.Fatal("expected directive token")
+	}
+
+	for _, want := range []string{"{", "}", "{}"} {
+		if !d.NextArg() {
+			t.Fatalf("expected quoted %q to be an argument", want)
+		}
+		if token := d.Token(); token.Text != want || !token.Quoted() {
+			t.Errorf("expected quoted token %q, got %#v", want, token)
+		}
+	}
+
+	if d.NextArg() {
+		t.Error("unquoted opening brace should not be an argument")
+	}
+	if d.Val() != "{}" {
+		t.Errorf("expected cursor to remain on last argument, got %q", d.Val())
+	}
+}
