+func TestParseQuotedBraces(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		input string
+		want  string
+	}{
+		{
+			name: "opening brace",
+			input: `:8080 {
+				respond "{"
+			}`,
+			want: "{",
+		},
+		{
+			name: "closing brace",
+			input: `:8080 {
+				respond "}"
+			}`,
+			want: "}",
+		},
+		{
+			name: "empty block braces",
+			input: `:8080 {
+				respond "{}"
+			}`,
+			want: "{}",
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			blocks, err := Parse("Testfile", []byte(tc.input))
+			if err != nil {
+				t.Fatalf("parsing Caddyfile: %v", err)
+			}
+			if len(blocks) != 1 {
+				t.Fatalf("expected 1 server block, got %d", len(blocks))
+			}
+			if len(blocks[0].Segments) != 1 {
+				t.Fatalf("expected 1 segment, got %d", len(blocks[0].Segments))
+			}
+			segment := blocks[0].Segments[0]
+			if len(segment) != 2 {
+				t.Fatalf("expected 2 segment tokens, got %v", segment)
+			}
+			if segment[1].Text != tc.want || !segment[1].Quoted() {
+				t.Errorf("expected quoted token %q, got %#v", tc.want, segment[1])
+			}
+		})
+	}
+}
