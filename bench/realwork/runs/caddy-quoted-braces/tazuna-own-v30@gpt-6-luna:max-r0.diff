+func TestDispenser_NextBlockQuotedBraces(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		brace string
+	}{
+		{name: "opening brace", brace: `"{"`},
+		{name: "closing brace", brace: `"}"`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			d := NewTestDispenser("outer {\ninner " + tc.brace + "\n}")
+			d.Next() // outer
+
+			var tokens []Token
+			for nesting := d.Nesting(); d.NextBlock(nesting); {
+				tokens = append(tokens, d.Token())
+			}
+
+			if len(tokens) != 2 {
+				t.Fatalf("expected 2 tokens in block, got %v", tokens)
+			}
+			if tokens[0].Text != "inner" {
+				t.Errorf("expected first token to be inner, got %q", tokens[0].Text)
+			}
+			if !tokens[1].Quoted() {
+				t.Errorf("expected quoted brace token, got %#v", tokens[1])
+			}
+			if d.Nesting() != 0 {
+				t.Errorf("expected nesting level 0, got %d", d.Nesting())
+			}
+			if d.Val() != "}" || d.Token().Quoted() {
+				t.Errorf("expected to stop at the unquoted closing brace, got %#v", d.Token())
+			}
+		})
+	}
+}
