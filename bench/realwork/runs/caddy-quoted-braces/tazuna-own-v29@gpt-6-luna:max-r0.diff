diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..ca93926 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -168,6 +168,26 @@ func TestDispenser_NextBlock(t *testing.T) {
 	assertNextBlock(false, 8, 0) // empty block is as if it didn't exist
 }
 
+func TestDispenser_NextBlockQuotedBraces(t *testing.T) {
+	d := NewTestDispenser(`site {
+	respond "{"
+	respond "}"
+}`)
+
+	d.Next() // site
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		// Quoted braces must remain ordinary tokens while traversing the block.
+		if d.Val() == "{" || d.Val() == "}" {
+			if !d.Token().Quoted() {
+				t.Fatalf("brace token %q should be quoted", d.Val())
+			}
+		}
+	}
+	if d.Nesting() != 0 {
+		t.Fatalf("expected nesting to return to zero, got %d", d.Nesting())
+	}
+}
