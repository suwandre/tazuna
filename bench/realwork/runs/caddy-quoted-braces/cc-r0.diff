diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..a8ed3a9 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,78 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesDoNotAffectBlocks(t *testing.T) {
+	for i, test := range []struct {
+		input    string
+		expected [][]string // expected token texts of each directive segment in the first server block
+	}{
+		{`:8080 {
+			respond "{"
+		}`, [][]string{{"respond", "{"}}},
+		{`:8080 {
+			respond "}"
+		}`, [][]string{{"respond", "}"}}},
+		{`:8080 {
+			respond ` + "`{`" + `
+		}`, [][]string{{"respond", "{"}}},
+		{`:8080 {
+			respond "{" 200
+			header X-Test "}"
+		}`, [][]string{{"respond", "{", "200"}, {"header", "X-Test", "}"}}},
+		{`:8080 {
+			route {
+				respond "{"
+			}
+			respond "}"
+		}`, [][]string{{"route", "{", "respond", "{", "}"}, {"respond", "}"}}},
+		{`(snip) {
+			respond "{"
+		}
+		:8080 {
+			import snip
+		}`, [][]string{{"respond", "{"}}},
+	} {
+		blocks, err := Parse("Caddyfile", []byte(test.input))
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 {
+			t.Errorf("Test %d: expected 1 server block, got %d", i, len(blocks))
+			continue
+		}
+		var actual [][]string
+		for _, segment := range blocks[0].Segments {
+			var texts []string
+			for _, tok := range segment {
+				texts = append(texts, tok.Text)
+			}
+			actual = append(actual, texts)
+		}
+		if len(actual) != len(test.expected) {
+			t.Errorf("Test %d: expected %d segments, got %d: %v", i, len(test.expected), len(actual), actual)
+			continue
+		}
+		for j := range actual {
+			if strings.Join(actual[j], " ") != strings.Join(test.expected[j], " ") {
+				t.Errorf("Test %d: segment %d: expected %v, got %v", i, j, test.expected[j], actual[j])
+			}
+		}
+	}
+}
+
+func TestUnbalancedBracesAroundQuotedBraces(t *testing.T) {
+	for i, input := range []string{
+		`:8080 {
+			respond "}"
+		`,
+		`:8080 {
+			respond "{"
+		`,
+	} {
+		if _, err := Parse("Caddyfile", []byte(input)); err == nil {
+			t.Errorf("Test %d: expected error for unbalanced braces", i)
+		}
+	}
+}
