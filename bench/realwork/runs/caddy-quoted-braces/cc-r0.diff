diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..bfead5d 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,32 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBracesAreNotBlockDelimiters(t *testing.T) {
+	d := NewTestDispenser(`foobar {
+		sub1 "{"
+		sub2 "}"
+	}
+	next`)
+
+	if !d.Next() || d.Val() != "foobar" {
+		t.Fatalf("expected foobar, got %q", d.Val())
+	}
+	var subs []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		subs = append(subs, d.Val())
+		if !d.NextArg() {
+			t.Fatalf("expected argument after %s", d.Val())
+		}
+		subs = append(subs, d.Val())
+		if d.NextArg() {
+			t.Fatalf("unexpected extra argument %q", d.Val())
+		}
+	}
+	if actual, expected := strings.Join(subs, " "), "sub1 { sub2 }"; actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+	if !d.Next() || d.Val() != "next" {
+		t.Errorf("expected next token after block, got %q", d.Val())
+	}
+}
