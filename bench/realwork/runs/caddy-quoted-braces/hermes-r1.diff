diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..29898e6 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,36 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBracesAreNotBlockDelimiters(t *testing.T) {
+	d := NewTestDispenser(`dir "{" "}" {
+		sub "}" "{"
+		other
+	}
+	next`)
+
+	if !d.Next() || d.Val() != "dir" {
+		t.Fatalf("expected to load 'dir', got '%s'", d.Val())
+	}
+	// quoted braces are ordinary arguments
+	for _, expected := range []string{"{", "}"} {
+		if !d.NextArg() || d.Val() != expected {
+			t.Fatalf("expected argument %q, got %q", expected, d.Val())
+		}
+	}
+	var got []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		got = append(got, d.Val())
+	}
+	// "}" and "{" are plain args of 'sub' and don't change nesting
+	expected := []string{"sub", "}", "{", "other"}
+	if !reflect.DeepEqual(got, expected) {
+		t.Errorf("expected block tokens %v, got %v", expected, got)
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("expected nesting 0 after block, got %d", d.Nesting())
+	}
+	if !d.Next() || d.Val() != "next" {
+		t.Errorf("expected to land on 'next', got '%s'", d.Val())
+	}
+}
