diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..775835d 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,44 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBraces(t *testing.T) {
+	input := "dir1 \"{\" \"}\" `{` \"{}\"\n" +
+		"dir2 \"{\"\n" +
+		"dir3 {\n" +
+		"\tsub1 \"}\"\n" +
+		"\tsub2 `{`\n" +
+		"}"
+	d := NewTestDispenser(input)
+
+	// quoted braces are arguments, not the end of the line
+	d.Next() // dir1
+	if args := d.RemainingArgs(); !reflect.DeepEqual(args, []string{"{", "}", "{", "{}"}) {
+		t.Errorf("RemainingArgs(): expected quoted braces as args, got %q", args)
+	}
+
+	// a quoted open brace does not open a block
+	d.Next() // dir2
+	if d.NextBlock(0) {
+		t.Errorf("NextBlock(): quoted '{' should not open a block")
+	}
+	if d.Val() != "dir2" {
+		t.Errorf("NextBlock(): expected cursor to roll back to 'dir2', got '%s'", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Errorf("NextArg(): expected quoted '{' as an argument, got '%s'", d.Val())
+	}
+
+	// quoted braces inside a real block do not change nesting
+	d.Next() // dir3
+	var block []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		block = append(block, d.Val())
+	}
+	if want := []string{"sub1", "}", "sub2", "{"}; !reflect.DeepEqual(block, want) {
+		t.Errorf("NextBlock(): expected block tokens %q, got %q", want, block)
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("NextBlock(): expected nesting 0 after block, got %d", d.Nesting())
+	}
+}
