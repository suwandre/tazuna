--- a/caddyconfig/caddyfile/lexer.go
+++ b/caddyconfig/caddyfile/lexer.go
@@ -347,6 +347,20 @@ func (t Token) Quoted() bool {
 	return t.wasQuoted > 0
 }
 
+// isBlockOpen returns true if the token is an unquoted open curly
+// brace, which opens a block. A quoted or heredoc brace is a
+// literal argument and does not open a block.
+func (t Token) isBlockOpen() bool {
+	return t.wasQuoted == 0 && t.Text == "{"
+}
+
+// isBlockClose returns true if the token is an unquoted close curly
+// brace, which closes a block. A quoted or heredoc brace is a
+// literal argument and does not close a block.
+func (t Token) isBlockClose() bool {
+	return t.wasQuoted == 0 && t.Text == "}"
+}
+
 // NumLineBreaks counts how many line breaks are in the token text.
 func (t Token) NumLineBreaks() int {
 	lineBreaks := strings.Count(t.Text, "\n")
