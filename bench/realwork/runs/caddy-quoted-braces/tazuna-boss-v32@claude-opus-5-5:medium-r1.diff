 )
@@ -1034,3 +1035,151 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestParseQuotedBraces(t *testing.T) {
+	// segmentTexts returns the token texts of each segment, for comparison.
+	segmentTexts := func(segs []Segment) [][]string {
+		var out [][]string
+		for _, seg := range segs {
+			var texts []string
+			for _, tok := range seg {
+				texts = append(texts, tok.Text)
+			}
+			out = append(out, texts)
+		}
+		return out
+	}
+
+	for i, test := range []struct {
+		input     string
+		shouldErr bool
+		segments  [][]string // token texts of each segment in the (only) server block
+	}{
+		// quoted braces are literal arguments
+		{`:8080 {
+	respond "{"
+}`, false, [][]string{
+			{"respond", "{"},
+		}},
+		{`:8080 {
+	respond "}"
+}`, false, [][]string{
+			{"respond", "}"},
+		}},
+		{":8080 {\n\trespond `{`\n}", false, [][]string{
+			{"respond", "{"},
+		}},
+		{":8080 {\n\trespond `}`\n}", false, [][]string{
+			{"respond", "}"},
+		}},
+		{`:8080 {
+	respond "{}"
+}`, false, [][]string{
+			{"respond", "{}"},
+		}},
+		{`:8080 {
+	respond "{" 200
+}`, false, [][]string{
+			{"respond", "{", "200"},
+		}},
+		{`:8080 {
+	respond "}" "{"
+	respond "{" "}"
+}`, false, [][]string{
+			{"respond", "}", "{"},
+			{"respond", "{", "}"},
+		}},
+		{`:8080 {
+	respond <<EOF
+{
+EOF
+}`, false, [][]string{
+			{"respond", "{"},
+		}},
+		{`:8080 {
+	respond <<EOF
+}
+EOF
+}`, false, [][]string{
+			{"respond", "}"},
+		}},
+
+		// quoted braces inside a nested block must not change nesting
+		{`:8080 {
+	handle {
+		respond "}"
+	}
+}`, false, [][]string{
+			{"handle", "{", "respond", "}", "}"},
+		}},
+		{`:8080 {
+	handle {
+		respond "{"
+	}
+}`, false, [][]string{
+			{"handle", "{", "respond", "{", "}"},
+		}},
+		{`:8080 {
+	handle {
+		respond "}"
+		respond "{"
+	}
+	respond "}"
+}`, false, [][]string{
+			{"handle", "{", "respond", "}", "respond", "{", "}"},
+			{"respond", "}"},
+		}},
+
+		// quoted braces inside a snippet must not end the snippet
+		{`(snip) {
+	respond "}"
+}
+:8080 {
+	import snip
+}`, false, [][]string{
+			{"respond", "}"},
+		}},
+
+		// quoted braces are not block delimiters, so an unterminated
+		// block is still an error
+		{`:8080 {
+	respond "{"`, true, nil},
+		{`:8080 {
+	respond "}"`, true, nil},
+
+		// unquoted braces keep their existing behavior
+		{`:8080 {
+	respond {}
+}`, true, nil},
+		{`:8080 {
+	respond }
+}`, true, nil},
+		{`localhost{
+}`, true, nil},
+
+		// a quoted address may end in a brace; it is not a block opener
+		{`"localhost{" {
+}`, false, nil},
+	} {
+		p := testParser(test.input)
+		blocks, err := p.parseAll()
+
+		if test.shouldErr {
+			if err == nil {
+				t.Errorf("Test %d: Expected an error, but didn't get one", i)
+			}
+			continue
+		}
+		if err != nil {
+			t.Errorf("Test %d: Expected no error, but got: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 {
+			t.Errorf("Test %d: Expected 1 server block, got %d", i, len(blocks))
+			continue
+		}
+		if actual := segmentTexts(blocks[0].Segments); !reflect.DeepEqual(actual, test.segments) {
+			t.Errorf("Test %d: Expected segments %q, got %q", i, test.segments, actual)
+		}
+	}
+}
