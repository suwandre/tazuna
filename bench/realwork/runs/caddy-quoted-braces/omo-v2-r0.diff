@@ -17,6 +17,7 @@ package caddyfile
 import (
 	"errors"
 	"reflect"
+	"slices"
 	"strings"
 	"testing"
 )
@@ -168,6 +169,37 @@ func TestDispenser_NextBlock(t *testing.T) {
 	assertNextBlock(false, 8, 0) // empty block is as if it didn't exist
 }
 
+func TestDispenser_NextBlock_QuotedBraces(t *testing.T) {
+	d := NewTestDispenser(`foobar {
+		sub1 "{"
+		sub2 "}"
+	}
+	other`)
+
+	d.Next() // foobar
+	var vals []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		vals = append(vals, d.Val())
+	}
+	if expected := []string{"sub1", "{", "sub2", "}"}; !slices.Equal(vals, expected) {
+		t.Errorf("Expected block tokens %v, got %v", expected, vals)
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("Expected nesting 0 after block, got %d", d.Nesting())
+	}
+
+	if !d.Next() || d.Val() != "other" {
+		t.Errorf("Expected next token to be 'other', got '%s'", d.Val())
+	}
+
+	// a quoted brace is an argument, not a block opening
+	d = NewTestDispenser(`foobar "{" arg`)
+	d.Next() // foobar
+	if !d.NextArg() || d.Val() != "{" {
+		t.Errorf("Expected quoted '{' to be an argument, got '%s'", d.Val())
+	}
+}
