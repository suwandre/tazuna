diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..1fa390b 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,55 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesDoNotAffectBlockParsing(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		input string
+		keys  string
+		segs  []string
+	}{
+		{"quoted open brace", ":8080 {\n\trespond \"{\"\n}", ":8080", []string{"respond"}},
+		{"quoted close brace", ":8080 {\n\trespond \"}\"\n}", ":8080", []string{"respond"}},
+		{"quoted both and following directive", ":8080 {\n\trespond \"{\" 200\n\theader \"}\"\n}", ":8080", []string{"respond", "header"}},
+		{"quoted brace in nested block", ":8080 {\n\thandle {\n\t\trespond \"{\"\n\t}\n\trespond \"ok\"\n}", ":8080", []string{"handle", "respond"}},
+		{"backtick brace", ":8080 {\n\trespond `{`\n}", ":8080", []string{"respond"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			blocks, err := Parse("Caddyfile", []byte(tc.input))
+			if err != nil {
+				t.Fatalf("Parse: %v", err)
+			}
+			if len(blocks) != 1 || blocks[0].GetKeysText()[0] != tc.keys {
+				t.Fatalf("unexpected blocks: %+v", blocks)
+			}
+			if len(blocks[0].Segments) != len(tc.segs) {
+				t.Fatalf("expected %d segments, got %d", len(tc.segs), len(blocks[0].Segments))
+			}
+			for i, d := range tc.segs {
+				if got := blocks[0].Segments[i].Directive(); got != d {
+					t.Fatalf("segment %d: expected %q, got %q", i, d, got)
+				}
+			}
+		})
+	}
+}
+
+func TestDispenserQuotedBraces(t *testing.T) {
+	d := NewTestDispenser("respond \"{\" \"}\" {\n\tfoo bar\n}")
+	if !d.Next() {
+		t.Fatal("expected token")
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Fatalf("expected quoted { as arg, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "}" {
+		t.Fatalf("expected quoted } as arg, got %q", d.Val())
+	}
+	if d.NextArg() {
+		t.Fatal("unquoted { must not be an arg")
+	}
+	if !d.NextBlock(0) || d.Val() != "foo" {
+		t.Fatalf("expected block, got %q", d.Val())
+	}
+}
