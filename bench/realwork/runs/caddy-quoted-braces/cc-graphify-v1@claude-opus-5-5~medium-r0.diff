diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..dbeb8d7 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,36 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBraces(t *testing.T) {
+	d := NewTestDispenser(`dir1 "{" arg2 {
+		sub "}"
+		"{"
+	}
+	dir2`)
+
+	if !d.Next() || d.Val() != "dir1" {
+		t.Fatalf("expected dir1, got %q", d.Val())
+	}
+	args := d.RemainingArgs()
+	if len(args) != 2 || args[0] != "{" || args[1] != "arg2" {
+		t.Fatalf("expected args [{ arg2], got %q", args)
+	}
+
+	var blockVals []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		blockVals = append(blockVals, d.Val())
+		blockVals = append(blockVals, d.RemainingArgs()...)
+	}
+	expected := []string{"sub", "}", "{"}
+	if strings.Join(blockVals, " ") != strings.Join(expected, " ") {
+		t.Errorf("expected block values %q, got %q", expected, blockVals)
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("expected nesting 0 after block, got %d", d.Nesting())
+	}
+
+	if !d.Next() || d.Val() != "dir2" {
+		t.Errorf("expected dir2, got %q", d.Val())
+	}
+}
diff --git a/caddyconfig/caddyfile/lexer.go b/caddyconfig/caddyfile/lexer.go
