diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..e6aba37 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,99 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesAreNotBlockDelimiters(t *testing.T) {
+	for i, tc := range []struct {
+		input     string
+		shouldErr bool
+		segments  [][]string // token texts per segment of the first server block
+	}{
+		{
+			input: `:8080 {
+				respond "{"
+			}`,
+			segments: [][]string{{"respond", "{"}},
+		},
+		{
+			input: `:8080 {
+				respond "}"
+			}`,
+			segments: [][]string{{"respond", "}"}},
+		},
+		{
+			input: ":8080 {\n\trespond `{`\n\trespond `}`\n}",
+			segments: [][]string{
+				{"respond", "{"},
+				{"respond", "}"},
+			},
+		},
+		{
+			input: `:8080 {
+				handle {
+					respond "{" 200
+				}
+				respond "}"
+			}`,
+			segments: [][]string{
+				{"handle", "{", "respond", "{", "200", "}"},
+				{"respond", "}"},
+			},
+		},
+		{
+			input: `(snip) {
+				respond "{"
+			}
+			:8080 {
+				import snip
+			}`,
+			segments: [][]string{{"respond", "{"}},
+		},
+		{
+			// a quoted "{" cannot open a server block
+			input: `:8080 "{"
+				respond foo
+			}`,
+			shouldErr: true,
+		},
+		{
+			// a quoted "}" cannot close a block
+			input: `:8080 {
+				handle {
+					respond foo
+				"}"`,
+			shouldErr: true,
+		},
+	} {
+		p := testParser(tc.input)
+		blocks, err := p.parseAll()
+		if tc.shouldErr {
+			if err == nil {
+				t.Errorf("Test %d: expected an error, but got none", i)
+			}
+			continue
+		}
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		var block ServerBlock
+		for _, b := range blocks {
+			if len(b.Keys) > 0 {
+				block = b
+			}
+		}
+		if len(block.Segments) != len(tc.segments) {
+			t.Errorf("Test %d: expected %d segments, got %d", i, len(tc.segments), len(block.Segments))
+			continue
+		}
+		for j, seg := range block.Segments {
+			var actual []string
+			for _, tkn := range seg {
+				actual = append(actual, tkn.Text)
+			}
+			if strings.Join(actual, " ") != strings.Join(tc.segments[j], " ") {
+				t.Errorf("Test %d, segment %d: expected %q, got %q", i, j, tc.segments[j], actual)
+			}
+		}
+	}
+}
