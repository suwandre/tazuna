+func TestDispenser_QuotedCurlyBraces(t *testing.T) {
+	input := `dir "{" ` + "`}`" + ` {
+			  sub "}"
+			  }`
+	d := NewTestDispenser(input)
+
+	if !d.Next() {
+		t.Fatal("Next(): Expected a token, got none")
+	}
+	if d.Val() != "dir" {
+		t.Fatalf("Expected token 'dir', got '%s'", d.Val())
+	}
+
+	expectedArgs := []string{"{", "}"}
+	for i, expected := range expectedArgs {
+		if !d.NextArg() {
+			t.Fatalf("NextArg(): Expected argument %d ('%s'), got none", i, expected)
+		}
+		if d.Val() != expected {
+			t.Errorf("NextArg(): Expected argument '%s', got '%s'", expected, d.Val())
+		}
+	}
+
+	if d.NextArg() {
+		t.Errorf("NextArg(): Expected false for the real opening brace, got true (val '%s')", d.Val())
+	}
+
+	var tokens []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		tokens = append(tokens, d.Val())
+	}
+	if expected := []string{"sub", "}"}; !reflect.DeepEqual(tokens, expected) {
+		t.Errorf("NextBlock(): Expected %v, got %v", expected, tokens)
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("Expected nesting to be 0, got %d", d.Nesting())
+	}
+
+	// a quoted brace should count as a remaining argument
+	d = NewTestDispenser(`dir "{"`)
+	d.Next() // dir
+	if args := d.RemainingArgs(); !reflect.DeepEqual(args, []string{"{"}) {
+		t.Errorf("RemainingArgs(): Expected %v, got %v", []string{"{"}, args)
+	}
+}
