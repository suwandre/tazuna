+func TestQuotedCurlyBraces(t *testing.T) {
+	for i, tc := range []struct {
+		input        string
+		expectErr    bool
+		keys         []string
+		segmentTexts [][]string
+	}{
+		{
+			input: `:8080 {
+						respond "{"
+					}`,
+			keys:         []string{":8080"},
+			segmentTexts: [][]string{{"respond", "{"}},
+		},
+		{
+			input: ":8080 {\n\trespond `}` 200\n}",
+			keys:  []string{":8080"},
+			segmentTexts: [][]string{
+				{"respond", "}", "200"},
+			},
+		},
+		{
+			input: `:8080 {
+						respond "{" {
+							close
+						}
+					}`,
+			keys:         []string{":8080"},
+			segmentTexts: [][]string{{"respond", "{", "{", "close", "}"}},
+		},
+		{
+			input: `(snip) {
+						respond "}"
+					}
+					:8080 {
+						import snip
+					}`,
+			keys:         []string{":8080"},
+			segmentTexts: [][]string{{"respond", "}"}},
+		},
+		{
+			input: `:8080 {
+						respond "{"
+					`,
+			expectErr: true,
+		},
+	} {
+		p := testParser(tc.input)
+		blocks, err := p.parseAll()
+		if tc.expectErr {
+			if err == nil {
+				t.Errorf("Test %d: Expected an error, but got none", i)
+			}
+			continue
+		}
+		if err != nil {
+			t.Errorf("Test %d: Unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 {
+			t.Errorf("Test %d: Expected 1 block, got %d", i, len(blocks))
+			continue
+		}
+		if actual := blocks[0].GetKeysText(); !reflect.DeepEqual(actual, tc.keys) {
+			t.Errorf("Test %d: Expected keys %v, got %v", i, tc.keys, actual)
+		}
+		if len(blocks[0].Segments) != len(tc.segmentTexts) {
+			t.Errorf("Test %d: Expected %d segments, got %d", i, len(tc.segmentTexts), len(blocks[0].Segments))
+			continue
+		}
+		for j, expected := range tc.segmentTexts {
+			var actual []string
+			for _, token := range blocks[0].Segments[j] {
+				actual = append(actual, token.Text)
+			}
+			if !reflect.DeepEqual(actual, expected) {
+				t.Errorf("Test %d: Segment %d: Expected texts %v, got %v", i, j, expected, actual)
+			}
+		}
+	}
+}
+
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
