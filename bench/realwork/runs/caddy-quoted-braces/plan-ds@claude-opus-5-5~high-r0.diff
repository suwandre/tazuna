+// isOpenCurlyBrace returns true if the current token
+// is an unquoted opening curly brace.
+func (d *Dispenser) isOpenCurlyBrace() bool {
+	return d.Val() == "{" && !d.Token().Quoted()
+}
+
+// isCloseCurlyBrace returns true if the current token
+// is an unquoted closing curly brace.
+func (d *Dispenser) isCloseCurlyBrace() bool {
+	return d.Val() == "}" && !d.Token().Quoted()
+}
