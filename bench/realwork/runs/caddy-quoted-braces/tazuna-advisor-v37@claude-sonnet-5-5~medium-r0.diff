diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..7974189 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,34 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBraces(t *testing.T) {
+	d := NewTestDispenser(`foo {
+		bar "{"
+		baz "}" x
+	}
+	next`)
+
+	if !d.Next() || d.Val() != "foo" {
+		t.Fatalf("expected foo, got %q", d.Val())
+	}
+	var got []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		got = append(got, d.Val())
+		for d.NextArg() {
+			got = append(got, d.Val())
+		}
+	}
+	expected := []string{"bar", "{", "baz", "}", "x"}
+	if len(got) != len(expected) {
+		t.Fatalf("expected %v, got %v", expected, got)
+	}
+	for i := range expected {
+		if got[i] != expected[i] {
+			t.Errorf("token %d: expected %q, got %q", i, expected[i], got[i])
+		}
+	}
+	if !d.Next() || d.Val() != "next" {
+		t.Errorf("expected to reach 'next', got %q", d.Val())
+	}
+}
diff --git a/caddyconfig/caddyfile/lexer.go b/caddyconfig/caddyfile/lexer.go
index 40ea2e5..1d1fe91 100644
--- a/caddyconfig/caddyfile/lexer.go
+++ b/caddyconfig/caddyfile/lexer.go
@@ -398,3 +398,15 @@ func isNextOnNewLine(t1, t2 Token) bool {
 	// then the second token is on a new line
 	return t1.Line+t1.NumLineBreaks() < t2.Line
 }
+
+// isOpenBrace returns true if the token is an unquoted '{',
+// i.e. one that opens a block.
+func (t Token) isOpenBrace() bool {
+	return t.Text == "{" && !t.Quoted()
+}
+
+// isCloseBrace returns true if the token is an unquoted '}',
+// i.e. one that closes a block.
+func (t Token) isCloseBrace() bool {
+	return t.Text == "}" && !t.Quoted()
+}
