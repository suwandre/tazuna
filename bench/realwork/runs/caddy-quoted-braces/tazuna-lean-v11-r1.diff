diff --git a/caddyconfig/caddyfile/lexer.go b/caddyconfig/caddyfile/lexer.go
index 40ea2e5..74c7c32 100644
--- a/caddyconfig/caddyfile/lexer.go
+++ b/caddyconfig/caddyfile/lexer.go
@@ -347,6 +347,18 @@ func (t Token) Quoted() bool {
 	return t.wasQuoted > 0
 }
 
+// isOpenBrace returns true if the token is an unquoted "{",
+// i.e. one that opens a block. A quoted "{" is just text.
+func (t Token) isOpenBrace() bool {
+	return t.Text == "{" && t.wasQuoted == 0
+}
+
+// isCloseBrace returns true if the token is an unquoted "}",
+// i.e. one that closes a block. A quoted "}" is just text.
+func (t Token) isCloseBrace() bool {
+	return t.Text == "}" && t.wasQuoted == 0
+}
+
 // NumLineBreaks counts how many line breaks are in the token text.
 func (t Token) NumLineBreaks() int {
 	lineBreaks := strings.Count(t.Text, "\n")
