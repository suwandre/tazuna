diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..1b419cc 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -18,6 +18,7 @@ import (
 	"bytes"
 	"os"
 	"path/filepath"
+	"reflect"
 	"strings"
 	"testing"
 )
@@ -1034,3 +1035,58 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesDoNotAffectBlockParsing(t *testing.T) {
+	for i, tc := range []struct {
+		input    string
+		segments [][]string // expected token texts per segment of the first server block
+	}{
+		{`:8080 {
+			respond "{"
+		}`, [][]string{{"respond", "{"}}},
+		{`:8080 {
+			respond "}"
+		}`, [][]string{{"respond", "}"}}},
+		{`:8080 {
+			respond ` + "`{`" + `
+			respond "}" 200
+		}`, [][]string{{"respond", "{"}, {"respond", "}", "200"}}},
+		{`:8080 {
+			foo {
+				bar "{"
+			}
+			baz "}"
+		}`, [][]string{{"foo", "{", "bar", "{", "}"}, {"baz", "}"}}},
+		{`:8080 {
+			respond "{" {
+				close
+			}
+		}`, [][]string{{"respond", "{", "{", "close", "}"}}},
+	} {
+		blocks, err := Parse("Caddyfile", []byte(tc.input))
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 {
+			t.Errorf("Test %d: expected 1 server block, got %d", i, len(blocks))
+			continue
+		}
+		var actual [][]string
+		for _, seg := range blocks[0].Segments {
+			var texts []string
+			for _, tok := range seg {
+				texts = append(texts, tok.Text)
+			}
+			actual = append(actual, texts)
+		}
+		if !reflect.DeepEqual(actual, tc.segments) {
+			t.Errorf("Test %d: expected segments %v, got %v", i, tc.segments, actual)
+		}
+	}
+
+	// an unquoted brace must still be required to balance
+	if _, err := Parse("Caddyfile", []byte(":8080 {\n\trespond \"{\"\n")); err == nil {
+		t.Error("expected error for unclosed block, got none")
+	}
+}
