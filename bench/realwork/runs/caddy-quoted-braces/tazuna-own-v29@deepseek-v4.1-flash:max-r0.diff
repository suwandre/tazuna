diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..f516d22 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -310,6 +310,37 @@ func TestParseOneAndImport(t *testing.T) {
 		{`localhost
 		  dir1 "{" a b "}"`, false, []string{"localhost"}, []int{5}},
 
+		// Quoted braces should not open or close a block
+		{`localhost
+		  dir1 "{"`, false, []string{"localhost"}, []int{2}},
+
+		{`localhost
+		  dir1 "}"`, false, []string{"localhost"}, []int{2}},
+
+		{`localhost {
+		    dir1 "{"
+		  }`, false, []string{"localhost"}, []int{2}},
+
+		{`localhost {
+		    dir1 "}"
+		  }`, false, []string{"localhost"}, []int{2}},
+
+		{`localhost {
+		    dir1 "{" "}"
+		  }`, false, []string{"localhost"}, []int{3}},
+
+		// A quoted opening brace must not swallow the rest of the block
+		{`localhost {
+		    dir1 "{" "x"
+		    dir2 y
+		  }`, false, []string{"localhost"}, []int{3, 2}},
+
+		// A quoted closing brace must not end the block early
+		{`localhost {
+		    dir1 "}"
+		    dir2 y
+		  }`, false, []string{"localhost"}, []int{2, 2}},
+
 		// Unexpected '{}' at end of line
 		{`localhost
 		  dir1 {}`, true, []string{"localhost"}, []int{}},
