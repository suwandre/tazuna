diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..d633b57 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,57 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBracesAreNotBlocks(t *testing.T) {
+	input := `dir "{"
+	other "}"
+	block {
+		sub "{"
+		sub2 "}"
+	}`
+	tokens, err := Tokenize([]byte(input), "Caddyfile")
+	if err != nil {
+		t.Fatalf("unexpected tokenize error: %v", err)
+	}
+	d := NewDispenser(tokens)
+
+	// quoted open brace is an argument, not a block opening
+	if !d.Next() || d.Val() != "dir" {
+		t.Fatalf("expected 'dir', got '%s'", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Fatalf("expected quoted '{' as argument, got '%s'", d.Val())
+	}
+	if d.NextBlock(d.Nesting()) {
+		t.Fatal("quoted '{' must not open a block")
+	}
+
+	// quoted close brace is an argument
+	if !d.Next() || d.Val() != "other" {
+		t.Fatalf("expected 'other', got '%s'", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "}" {
+		t.Fatalf("expected quoted '}' as argument, got '%s'", d.Val())
+	}
+
+	// quoted braces inside a real block do not change nesting
+	if !d.Next() || d.Val() != "block" {
+		t.Fatalf("expected 'block', got '%s'", d.Val())
+	}
+	var got []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		got = append(got, d.Val())
+	}
+	expected := []string{"sub", "{", "sub2", "}"}
+	if len(got) != len(expected) {
+		t.Fatalf("expected tokens %v, got %v", expected, got)
+	}
+	for i := range expected {
+		if got[i] != expected[i] {
+			t.Errorf("token %d: expected %q, got %q", i, expected[i], got[i])
+		}
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("expected nesting 0 after block, got %d", d.Nesting())
+	}
+}
diff --git a/caddyconfig/caddyfile/lexer.go b/caddyconfig/caddyfile/lexer.go
