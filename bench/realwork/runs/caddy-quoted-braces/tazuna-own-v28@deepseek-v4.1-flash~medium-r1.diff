+func TestDispenser_QuotedBraces(t *testing.T) {
+	input := `dir1 "{"
+			  dir2 "}"
+			  dir3 "{" "}"`
+	d := NewTestDispenser(input)
+
+	if !d.Next() || d.Val() != "dir1" {
+		t.Fatalf("expected dir1, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Fatalf("expected quoted '{' as argument, got %q", d.Val())
+	}
+	if d.NextArg() {
+		t.Fatalf("expected no more arguments, got %q", d.Val())
+	}
+
+	if !d.Next() || d.Val() != "dir2" {
+		t.Fatalf("expected dir2, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "}" {
+		t.Fatalf("expected quoted '}' as argument, got %q", d.Val())
+	}
+
+	if !d.Next() || d.Val() != "dir3" {
+		t.Fatalf("expected dir3, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Fatalf("expected quoted '{' as argument, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "}" {
+		t.Fatalf("expected quoted '}' as argument, got %q", d.Val())
+	}
+	if d.NextArg() {
+		t.Fatalf("expected no more arguments, got %q", d.Val())
+	}
+}
