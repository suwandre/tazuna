+func TestQuotedBraces(t *testing.T) {
+	for i, tc := range []struct {
+		input string
+	}{
+		{input: ":8080 {\n\trespond \"{\"\n}\n"},
+		{input: ":8080 {\n\trespond \"}\"\n}\n"},
+		{input: ":8080 {\n\trespond \"{\" \"}\"\n}\n"},
+		{input: ":8080 {\n\trespond \"a{b}c\"\n}\n"},
+	} {
+		adapter := caddyfile.Adapter{
+			ServerType: ServerType{},
+		}
+
+		result, _, err := adapter.Adapt([]byte(tc.input), nil)
+		if err != nil {
+			t.Errorf("Test %d: expected no error, got: %v", i, err)
+			continue
+		}
+		if len(result) == 0 {
+			t.Errorf("Test %d: expected adapted config, got empty result", i)
+		}
+	}
+}
