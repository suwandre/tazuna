diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..effec70 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -18,6 +18,7 @@ import (
 	"bytes"
 	"os"
 	"path/filepath"
+	"reflect"
 	"strings"
 	"testing"
 )
@@ -1034,3 +1035,86 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesAreNotBlockDelimiters(t *testing.T) {
+	for i, tc := range []struct {
+		input    string
+		segments [][]string // token texts of each segment in the first server block
+		wantErr  bool
+	}{
+		{
+			input: `:8080 {
+				respond "{"
+			}`,
+			segments: [][]string{{"respond", "{"}},
+		},
+		{
+			input: `:8080 {
+				respond "}"
+			}`,
+			segments: [][]string{{"respond", "}"}},
+		},
+		{
+			input:    ":8080 {\n\trespond `{` 200\n\trespond `}`\n}",
+			segments: [][]string{{"respond", "{", "200"}, {"respond", "}"}},
+		},
+		{
+			input: `:8080 {
+				handle {
+					respond "{" 200
+				}
+				respond "}"
+			}`,
+			segments: [][]string{
+				{"handle", "{", "respond", "{", "200", "}"},
+				{"respond", "}"},
+			},
+		},
+		{
+			input: `(snip) {
+				respond "{"
+			}
+			:8080 {
+				import snip
+			}`,
+			segments: [][]string{{"respond", "{"}},
+		},
+		{
+			input: `:8080 {
+				respond }
+			}`,
+			wantErr: true,
+		},
+	} {
+		p := testParser(tc.input)
+		blocks, err := p.parseAll()
+		if tc.wantErr {
+			if err == nil {
+				t.Errorf("Test %d: expected error but got none", i)
+			}
+			continue
+		}
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 {
+			t.Errorf("Test %d: expected 1 server block, got %d", i, len(blocks))
+			continue
+		}
+		segs := blocks[0].Segments
+		if len(segs) != len(tc.segments) {
+			t.Errorf("Test %d: expected %d segments, got %d: %v", i, len(tc.segments), len(segs), segs)
+			continue
+		}
+		for j, seg := range segs {
+			var actual []string
+			for _, tkn := range seg {
+				actual = append(actual, tkn.Text)
+			}
+			if !reflect.DeepEqual(actual, tc.segments[j]) {
+				t.Errorf("Test %d, segment %d: expected %v, got %v", i, j, tc.segments[j], actual)
+			}
+		}
+	}
+}
