diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..80babe2 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,31 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBraces(t *testing.T) {
+	input := `dir "{" {
+				sub "}"
+			}`
+	d := NewTestDispenser(input)
+	d.Next() // dir
+
+	if !d.NextArg() || d.Val() != "{" {
+		t.Fatalf("expected quoted '{' to be an argument, got %q", d.Val())
+	}
+	if d.NextArg() {
+		t.Fatalf("expected unquoted '{' to not be an argument, got %q", d.Val())
+	}
+	nesting := d.Nesting()
+	if !d.NextBlock(nesting) || d.Val() != "sub" {
+		t.Fatalf("expected block to open with 'sub', got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "}" {
+		t.Fatalf("expected quoted '}' to be an argument, got %q", d.Val())
+	}
+	if d.NextBlock(nesting) {
+		t.Fatalf("expected block to close, got %q", d.Val())
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("expected nesting 0, got %d", d.Nesting())
+	}
+}
diff --git a/caddyconfig/caddyfile/lexer.go b/caddyconfig/caddyfile/lexer.go
index 40ea2e5..fb92731 100644
--- a/caddyconfig/caddyfile/lexer.go
+++ b/caddyconfig/caddyfile/lexer.go
@@ -347,6 +347,20 @@ func (t Token) Quoted() bool {
 	return t.wasQuoted > 0
 }
 
+// isOpenCurlyBrace returns true if the token is an unquoted
+// opening curly brace, which opens a block. A quoted "{" is
+// just a regular token value.
+func (t Token) isOpenCurlyBrace() bool {
+	return t.Text == "{" && t.wasQuoted == 0
+}
+
+// isCloseCurlyBrace returns true if the token is an unquoted
+// closing curly brace, which closes a block. A quoted "}" is
+// just a regular token value.
+func (t Token) isCloseCurlyBrace() bool {
+	return t.Text == "}" && t.wasQuoted == 0
+}
+
 // NumLineBreaks counts how many line breaks are in the token text.
 func (t Token) NumLineBreaks() int {
 	lineBreaks := strings.Count(t.Text, "\n")
