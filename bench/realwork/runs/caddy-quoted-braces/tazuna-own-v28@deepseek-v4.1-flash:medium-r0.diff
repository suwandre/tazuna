 	return t.wasQuoted > 0
 }
 
+// isOpenCurlyBrace returns true if the token is a structural
+// (unquoted) open curly brace. A quoted "{" is just an argument,
+// not a block opening.
+func isOpenCurlyBrace(t Token) bool {
+	return t.Text == "{" && t.wasQuoted == 0
+}
+
+// isCloseCurlyBrace returns true if the token is a structural
+// (unquoted) close curly brace. A quoted "}" is just an argument,
+// not a block closing.
+func isCloseCurlyBrace(t Token) bool {
+	return t.Text == "}" && t.wasQuoted == 0
+}
