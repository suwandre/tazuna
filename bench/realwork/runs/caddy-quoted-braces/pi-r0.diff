+// isOpenBrace returns true if the current token is an unquoted
+// opening curly brace. A quoted "{" is a regular value and does
+// not open a block.
+func (d *Dispenser) isOpenBrace() bool {
+	if d.cursor < 0 || d.cursor >= len(d.tokens) {
+		return false
+	}
+	return d.tokens[d.cursor].isOpenBrace()
+}
+
+// isCloseBrace returns true if the current token is an unquoted
+// closing curly brace. A quoted "}" is a regular value and does
+// not close a block.
+func (d *Dispenser) isCloseBrace() bool {
+	if d.cursor < 0 || d.cursor >= len(d.tokens) {
+		return false
+	}
+	return d.tokens[d.cursor].isCloseBrace()
+}
