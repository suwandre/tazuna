diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..9f64502 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,51 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesDoNotAffectBlocks(t *testing.T) {
+	for i, tc := range []struct {
+		input    string
+		segments [][]string // expected segment texts in the first server block
+	}{
+		{":8080 {\n\trespond \"{\"\n}", [][]string{{"respond", "{"}}},
+		{":8080 {\n\trespond \"}\"\n}", [][]string{{"respond", "}"}}},
+		{":8080 {\n\trespond \"{\" 200\n\tfoo bar\n}", [][]string{{"respond", "{", "200"}, {"foo", "bar"}}},
+		{":8080 {\n\trespond `}` {\n\t\tclose\n\t}\n\tfoo\n}", [][]string{{"respond", "}", "{", "close", "}"}, {"foo"}}},
+		{":8080 {\n\thandle {\n\t\trespond \"{\"\n\t}\n}", [][]string{{"handle", "{", "respond", "{", "}"}}},
+	} {
+		blocks, err := Parse("Caddyfile", []byte(tc.input))
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 {
+			t.Errorf("Test %d: expected 1 server block, got %d", i, len(blocks))
+			continue
+		}
+		segs := blocks[0].Segments
+		if len(segs) != len(tc.segments) {
+			t.Errorf("Test %d: expected %d segments, got %d", i, len(tc.segments), len(segs))
+			continue
+		}
+		for j, seg := range segs {
+			var got []string
+			for _, tok := range seg {
+				got = append(got, tok.Text)
+			}
+			if strings.Join(got, "\x00") != strings.Join(tc.segments[j], "\x00") {
+				t.Errorf("Test %d segment %d: expected %q, got %q", i, j, tc.segments[j], got)
+			}
+		}
+	}
+}
+
+func TestQuotedBracesInSnippetAndImport(t *testing.T) {
+	p := testParser("(snip) {\n\trespond \"{\"\n}\n:8080 {\n\timport snip\n}\n:8081 {\n\trespond \"}\"\n}")
+	blocks, err := p.parseAll()
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(blocks) != 2 {
+		t.Fatalf("expected 2 server blocks, got %d", len(blocks))
+	}
+}
