+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,29 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBracesAreNotBlockDelimiters(t *testing.T) {
+	input := "foo \"{\" bar {\n\tbaz \"}\"\n\tqux `{`\n}\n"
+	d := NewTestDispenser(input)
+	var got []string
+	for d.Next() {
+		got = append(got, d.Val())
+		if d.Val() != "foo" {
+			continue
+		}
+		if !d.NextArg() || d.Val() != "{" {
+			t.Fatalf("expected quoted brace to be an argument, got %q", d.Val())
+		}
+		if !d.NextArg() || d.Val() != "bar" {
+			t.Fatalf("expected bar, got %q", d.Val())
+		}
+		var sub []string
+		for nesting := d.Nesting(); d.NextBlock(nesting); {
+			sub = append(sub, d.Val())
+			sub = append(sub, d.RemainingArgs()...)
+		}
+		if strings.Join(sub, " ") != "baz } qux {" {
+			t.Errorf("unexpected block contents: %q", sub)
+		}
+	}
+}
