diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..f470301 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -18,6 +18,7 @@ import (
 	"bytes"
 	"os"
 	"path/filepath"
+	"reflect"
 	"strings"
 	"testing"
 )
@@ -1034,3 +1035,48 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestParseQuotedBraces(t *testing.T) {
+	for i, tc := range []struct {
+		input    string
+		expected [][]string // tokens of each directive in the first server block
+	}{
+		{
+			input:    ":8080 {\n\trespond \"{\"\n}\n",
+			expected: [][]string{{"respond", "{"}},
+		},
+		{
+			input:    ":8080 {\n\trespond \"}\"\n}\n",
+			expected: [][]string{{"respond", "}"}},
+		},
+		{
+			input:    ":8080 {\n\trespond `{`\n\trespond \"{\" 200\n}\n",
+			expected: [][]string{{"respond", "{"}, {"respond", "{", "200"}},
+		},
+		{
+			input:    ":8080 {\n\tfoo {\n\t\tbar \"{\"\n\t\tbaz \"}\"\n\t}\n\tother\n}\n",
+			expected: [][]string{{"foo", "{", "bar", "{", "baz", "}", "}"}, {"other"}},
+		},
+	} {
+		blocks, err := Parse("Caddyfile", []byte(tc.input))
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 {
+			t.Errorf("Test %d: expected 1 server block, got %d", i, len(blocks))
+			continue
+		}
+		var actual [][]string
+		for _, seg := range blocks[0].Segments {
+			var texts []string
+			for _, tok := range seg {
+				texts = append(texts, tok.Text)
+			}
+			actual = append(actual, texts)
+		}
+		if !reflect.DeepEqual(actual, tc.expected) {
+			t.Errorf("Test %d: expected %q, got %q", i, tc.expected, actual)
+		}
+	}
+}
