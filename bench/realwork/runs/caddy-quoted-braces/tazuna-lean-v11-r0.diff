diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..51ab156 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,38 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBraces(t *testing.T) {
+	d := NewTestDispenser(`respond "{" "}"
+		foo {
+			bar "{"
+			baz "}"
+		}`)
+
+	if !d.Next() || d.Val() != "respond" {
+		t.Fatalf("expected respond, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Errorf("NextArg(): expected quoted '{' as argument, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "}" {
+		t.Errorf("NextArg(): expected quoted '}' as argument, got %q", d.Val())
+	}
+
+	d.Next() // foo
+	var subs []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		subs = append(subs, d.Val())
+		if !d.NextArg() {
+			t.Errorf("expected argument for %s", d.Val())
+		}
+		subs = append(subs, d.Val())
+	}
+	expected := []string{"bar", "{", "baz", "}"}
+	if !reflect.DeepEqual(subs, expected) {
+		t.Errorf("expected %q, got %q", expected, subs)
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("expected nesting 0, got %d", d.Nesting())
+	}
+}
