diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..1986fed 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,44 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesDoNotAffectBlockParsing(t *testing.T) {
+	for i, tc := range []struct {
+		input    string
+		segments [][]string // expected segments of the first server block
+	}{
+		{":8080 {\n\trespond \"{\"\n}", [][]string{{"respond", "{"}}},
+		{":8080 {\n\trespond \"}\"\n}", [][]string{{"respond", "}"}}},
+		{":8080 {\n\trespond `{`\n}", [][]string{{"respond", "{"}}},
+		{":8080 {\n\trespond \"{\" 200\n\trespond \"}\"\n}", [][]string{{"respond", "{", "200"}, {"respond", "}"}}},
+		{":8080 {\n\tfoo {\n\t\tbar \"{\"\n\t\tbaz \"}\"\n\t}\n}", [][]string{{"foo", "{", "bar", "{", "baz", "}", "}"}}},
+		{":8080 {\n\trespond \"{\"\n}\n:8081 {\n\trespond \"}\"\n}", [][]string{{"respond", "{"}}},
+	} {
+		blocks, err := Parse("Caddyfile", []byte(tc.input))
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) == 0 {
+			t.Errorf("Test %d: expected server blocks", i)
+			continue
+		}
+		var got [][]string
+		for _, seg := range blocks[0].Segments {
+			var s []string
+			for _, tok := range seg {
+				s = append(s, tok.Text)
+			}
+			got = append(got, s)
+		}
+		if len(got) != len(tc.segments) {
+			t.Errorf("Test %d: expected %v segments, got %v", i, tc.segments, got)
+			continue
+		}
+		for j := range got {
+			if strings.Join(got[j], "\x00") != strings.Join(tc.segments[j], "\x00") {
+				t.Errorf("Test %d: segment %d: expected %q, got %q", i, j, tc.segments[j], got[j])
+			}
+		}
+	}
+}
