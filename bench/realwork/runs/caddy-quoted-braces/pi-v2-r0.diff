+func TestDispenser_QuotedBracesAreArgs(t *testing.T) {
+	d := NewTestDispenser(`foo "{" "}" bar`)
+	var args []string
+	for d.Next() {
+		args = d.RemainingArgs()
+	}
+	if len(args) != 3 || args[0] != "{" || args[1] != "}" || args[2] != "bar" {
+		t.Errorf("unexpected args: %v", args)
+	}
+}
