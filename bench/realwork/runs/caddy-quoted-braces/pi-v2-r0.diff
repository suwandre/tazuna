diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..fee9638 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,63 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestParseQuotedBraces(t *testing.T) {
+	for i, tc := range []struct {
+		input    string
+		expected [][]string // segments of the single server block
+	}{
+		{
+			input:    ":8080 {\n\trespond \"{\"\n}",
+			expected: [][]string{{"respond", "{"}},
+		},
+		{
+			input:    ":8080 {\n\trespond \"}\"\n}",
+			expected: [][]string{{"respond", "}"}},
+		},
+		{
+			input:    ":8080 {\n\trespond `{`\n\trespond \"}\" 200\n}",
+			expected: [][]string{{"respond", "{"}, {"respond", "}", "200"}},
+		},
+		{
+			input:    ":8080 {\n\trespond \"{\" {\n\t\tclose\n\t}\n}",
+			expected: [][]string{{"respond", "{", "{", "close", "}"}},
+		},
+	} {
+		blocks, err := Parse("Caddyfile", []byte(tc.input))
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 {
+			t.Errorf("Test %d: expected 1 server block, got %d", i, len(blocks))
+			continue
+		}
+		if len(blocks[0].Segments) != len(tc.expected) {
+			t.Errorf("Test %d: expected %d segments, got %d", i, len(tc.expected), len(blocks[0].Segments))
+			continue
+		}
+		for j, seg := range blocks[0].Segments {
+			if len(seg) != len(tc.expected[j]) {
+				t.Errorf("Test %d segment %d: expected %v, got %v", i, j, tc.expected[j], seg)
+				continue
+			}
+			for k, tok := range seg {
+				if tok.Text != tc.expected[j][k] {
+					t.Errorf("Test %d segment %d token %d: expected %q, got %q", i, j, k, tc.expected[j][k], tok.Text)
+				}
+			}
+		}
+	}
+}
+
+func TestParseQuotedBraceAsSnippetAndImport(t *testing.T) {
+	input := "(snip) {\n\trespond \"}\"\n}\n:8080 {\n\timport snip\n}"
+	blocks, err := Parse("Caddyfile", []byte(input))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(blocks) != 1 || len(blocks[0].Segments) != 1 || blocks[0].Segments[0][1].Text != "}" {
+		t.Fatalf("unexpected result: %+v", blocks)
+	}
+}
