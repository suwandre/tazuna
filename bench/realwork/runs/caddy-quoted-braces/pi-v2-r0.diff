 }
 
 const MatcherNameCtxKey = "matcher_name"
+
+// isOpenCurly returns true if the current token is an unquoted
+// opening curly brace. Quoted braces are ordinary values.
+func (d *Dispenser) isOpenCurly() bool {
+	if d.cursor < 0 || d.cursor >= len(d.tokens) {
+		return false
+	}
+	t := d.tokens[d.cursor]
+	return t.Text == "{" && t.wasQuoted == 0
+}
+
+// isCloseCurly returns true if the current token is an unquoted
+// closing curly brace. Quoted braces are ordinary values.
+func (d *Dispenser) isCloseCurly() bool {
+	if d.cursor < 0 || d.cursor >= len(d.tokens) {
+		return false
+	}
+	t := d.tokens[d.cursor]
+	return t.Text == "}" && t.wasQuoted == 0
+}
