 }
 
+func TestDispenser_QuotedBraces(t *testing.T) {
+	input := `dir1 "{" "}" {
+			  	sub1 "{"
+			  	sub2 "}"
+			  }
+			  dir2`
+	d := NewTestDispenser(input)
+
+	if !d.Next() || d.Val() != "dir1" {
+		t.Fatalf("Expected dir1, got '%s'", d.Val())
+	}
+	for _, want := range []string{"{", "}"} {
+		if !d.NextArg() || d.Val() != want {
+			t.Fatalf("Expected quoted '%s' as argument, got '%s'", want, d.Val())
+		}
+	}
+	if d.NextArg() {
+		t.Fatalf("Expected no more arguments before block, got '%s'", d.Val())
+	}
+
+	var subs []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		subs = append(subs, d.Val())
+		if !d.NextArg() {
+			t.Fatalf("Expected argument after '%s'", d.Val())
+		}
+		subs = append(subs, d.Val())
+	}
+	if got := strings.Join(subs, " "); got != `sub1 { sub2 }` {
+		t.Errorf("Unexpected block contents: %s", got)
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("Expected nesting 0 after block, got %d", d.Nesting())
+	}
+	if !d.Next() || d.Val() != "dir2" {
+		t.Errorf("Expected dir2 after block, got '%s'", d.Val())
+	}
+}
