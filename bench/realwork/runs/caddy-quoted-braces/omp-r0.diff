 	return t.wasQuoted > 0
 }
 
+// isOpenBrace reports whether t is an unquoted open curly brace,
+// i.e. one that opens a block rather than being a literal value.
+func (t Token) isOpenBrace() bool {
+	return t.Text == "{" && t.wasQuoted == 0
+}
+
+// isCloseBrace reports whether t is an unquoted close curly brace,
+// i.e. one that closes a block rather than being a literal value.
+func (t Token) isCloseBrace() bool {
+	return t.Text == "}" && t.wasQuoted == 0
+}
