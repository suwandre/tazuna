+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -168,6 +168,42 @@ func TestDispenser_NextBlock(t *testing.T) {
 	assertNextBlock(false, 8, 0) // empty block is as if it didn't exist
 }
 
+func TestDispenser_QuotedCurlyBraces(t *testing.T) {
+	input := `dir1 "{" {
+				sub1 "}"
+				sub2 "{"
+			  }
+			  dir2 "}"`
+	d := NewTestDispenser(input)
+
+	d.Next() // dir1
+	if !d.NextArg() || d.Val() != "{" {
+		t.Fatalf("NextArg(): expected quoted '{' as argument, got '%s'", d.Val())
+	}
+	var subdirs []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		subdir := d.Val()
+		args := d.RemainingArgs()
+		if len(args) != 1 {
+			t.Fatalf("subdirective %s: expected 1 argument, got %v", subdir, args)
+		}
+		subdirs = append(subdirs, subdir+" "+args[0])
+	}
+	if expected := []string{"sub1 }", "sub2 {"}; !reflect.DeepEqual(subdirs, expected) {
+		t.Errorf("expected subdirectives %v, got %v", expected, subdirs)
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("expected nesting 0, got %d", d.Nesting())
+	}
+
+	if !d.Next() || d.Val() != "dir2" {
+		t.Fatalf("expected dir2, got '%s'", d.Val())
+	}
+	if args := d.RemainingArgs(); !reflect.DeepEqual(args, []string{"}"}) {
+		t.Errorf("expected [}] arguments, got %v", args)
+	}
+}
