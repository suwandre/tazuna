diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..51c045a 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -168,6 +168,49 @@ func TestDispenser_NextBlock(t *testing.T) {
 	assertNextBlock(false, 8, 0) // empty block is as if it didn't exist
 }
 
+func TestDispenser_QuotedBraces(t *testing.T) {
+	input := `dir1 "{" {
+			  	sub1 "}"
+			  	sub2 ` + "`{`" + `
+			  }
+			  dir2 "}"`
+	d := NewTestDispenser(input)
+
+	d.Next() // dir1
+	if !d.NextArg() || d.Val() != "{" {
+		t.Fatalf("expected quoted '{' to be an argument, got %q", d.Val())
+	}
+	if d.NextArg() {
+		t.Fatalf("expected unquoted '{' to not be an argument, got %q", d.Val())
+	}
+
+	var subdirs []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		subdirs = append(subdirs, d.Val())
+		if !d.NextArg() {
+			t.Fatalf("expected argument after %q", d.Val())
+		}
+		subdirs = append(subdirs, d.Val())
+	}
+	expected := []string{"sub1", "}", "sub2", "{"}
+	if !reflect.DeepEqual(subdirs, expected) {
+		t.Errorf("expected block contents %v, got %v", expected, subdirs)
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("expected nesting 0 after block, got %d", d.Nesting())
+	}
+
+	if !d.Next() || d.Val() != "dir2" {
+		t.Fatalf("expected dir2, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "}" {
+		t.Fatalf("expected quoted '}' to be an argument, got %q", d.Val())
+	}
+	if d.NextBlock(0) {
+		t.Errorf("expected no block after dir2")
+	}
+}
