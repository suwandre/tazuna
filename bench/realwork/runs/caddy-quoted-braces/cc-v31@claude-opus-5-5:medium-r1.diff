+func TestDispenser_QuotedBraces(t *testing.T) {
+	input := `dir1 "{" "}" {
+			  	sub1 "}"
+			  	sub2 "{"
+			  }
+			  dir2 "{"`
+	d := NewTestDispenser(input)
+
+	d.Next() // dir1
+	for _, expected := range []string{"{", "}"} {
+		if !d.NextArg() {
+			t.Fatalf("NextArg(): Expected quoted %q to be an argument", expected)
+		}
+		if d.Val() != expected {
+			t.Fatalf("Val(): Expected %q but got %q", expected, d.Val())
+		}
+	}
+	if d.NextArg() {
+		t.Fatalf("NextArg(): Unquoted '{' should not be an argument")
+	}
+
+	var subdirs []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		subdir := d.Val()
+		if !d.NextArg() {
+			t.Fatalf("NextArg(): Expected argument after %s", subdir)
+		}
+		subdirs = append(subdirs, subdir+" "+d.Val())
+	}
+	if len(subdirs) != 2 || subdirs[0] != "sub1 }" || subdirs[1] != "sub2 {" {
+		t.Errorf("Expected subdirectives [sub1 } sub2 {], got %v", subdirs)
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("Expected nesting 0 after block, got %d", d.Nesting())
+	}
+
+	if !d.Next() || d.Val() != "dir2" {
+		t.Fatalf("Next(): Expected dir2, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Errorf("NextArg(): Expected quoted '{' argument, got %q", d.Val())
+	}
+	if d.NextBlock(0) {
+		t.Errorf("NextBlock(): Quoted '{' should not open a block")
+	}
+}
