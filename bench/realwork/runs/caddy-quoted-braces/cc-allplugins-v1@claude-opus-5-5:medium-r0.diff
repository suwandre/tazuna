+func TestDispenser_QuotedBraces(t *testing.T) {
+	input := `dir1 "{" {
+			  	sub1 "}"
+			  	sub2 "{"
+			  }
+			  dir2 "}"`
+	d := NewTestDispenser(input)
+
+	d.Next() // dir1
+	if !d.NextArg() || d.Val() != "{" {
+		t.Fatalf("Expected quoted '{' to be an argument, got %q", d.Val())
+	}
+	if d.NextArg() {
+		t.Fatalf("Expected unquoted '{' not to be an argument, got %q", d.Val())
+	}
+	var subdirs []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		subdir := d.Val()
+		if !d.NextArg() {
+			t.Fatalf("Expected argument for %s", subdir)
+		}
+		subdirs = append(subdirs, subdir+" "+d.Val())
+	}
+	if len(subdirs) != 2 || subdirs[0] != "sub1 }" || subdirs[1] != "sub2 {" {
+		t.Errorf("Unexpected subdirectives: %q", subdirs)
+	}
+	if !d.Next() || d.Val() != "dir2" {
+		t.Fatalf("Expected dir2, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "}" {
+		t.Errorf("Expected quoted '}' to be an argument, got %q", d.Val())
+	}
+}
