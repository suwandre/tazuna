diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..b18c488 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,22 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBraces(t *testing.T) {
+	d := NewTestDispenser(`dir "{" "}" arg`)
+	if !d.Next() {
+		t.Fatal("expected directive")
+	}
+	if got := d.RemainingArgs(); len(got) != 3 || got[0] != "{" || got[1] != "}" || got[2] != "arg" {
+		t.Errorf("expected quoted braces as args, got %q", got)
+	}
+
+	d = NewTestDispenser(`dir "{"`)
+	d.Next()
+	if d.NextBlock(0) {
+		t.Error("quoted brace must not open a block")
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Errorf("expected quoted brace as argument, got %q", d.Val())
+	}
+}
diff --git a/caddyconfig/caddyfile/lexer.go b/caddyconfig/caddyfile/lexer.go
