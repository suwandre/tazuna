diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..c969d87 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,32 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestParseQuotedBraces(t *testing.T) {
+	for i, tc := range []struct {
+		input string
+		args  []string
+	}{
+		{"localhost {\n\trespond \"{\"\n}", []string{"respond", "{"}},
+		{"localhost {\n\trespond \"}\"\n}", []string{"respond", "}"}},
+		{"localhost {\n\trespond `{` 200\n}", []string{"respond", "{", "200"}},
+		{"localhost {\n\trespond \"{\" {\n\t\tclose\n\t}\n}", []string{"respond", "{", "{", "close", "}"}},
+	} {
+		blocks, err := Parse("Caddyfile", []byte(tc.input))
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 || len(blocks[0].Segments) != 1 {
+			t.Errorf("Test %d: unexpected structure: %+v", i, blocks)
+			continue
+		}
+		var got []string
+		for _, tkn := range blocks[0].Segments[0] {
+			got = append(got, tkn.Text)
+		}
+		if strings.Join(got, " ") != strings.Join(tc.args, " ") {
+			t.Errorf("Test %d: expected %q, got %q", i, tc.args, got)
+		}
+	}
+}
