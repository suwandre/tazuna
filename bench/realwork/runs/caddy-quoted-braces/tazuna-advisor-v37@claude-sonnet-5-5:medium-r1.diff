+++ b/caddyconfig/caddyfile/lexer.go
@@ -343,6 +343,12 @@ func (l *lexer) finalizeHeredoc(val []rune, marker string) ([]rune, error) {
 
 // Quoted returns true if the token was enclosed in quotes
 // (i.e. double quotes, backticks, or heredoc).
+// isOpenBrace returns true if t is an unquoted opening curly brace.
+func (t Token) isOpenBrace() bool { return t.Text == "{" && !t.Quoted() }
+
+// isCloseBrace returns true if t is an unquoted closing curly brace.
+func (t Token) isCloseBrace() bool { return t.Text == "}" && !t.Quoted() }
+
 func (t Token) Quoted() bool {
 	return t.wasQuoted > 0
 }
