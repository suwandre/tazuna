diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..bffb3e2 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,41 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBraces(t *testing.T) {
+	input := `dir1 "{" "}" {
+			  	sub1 "{"
+			  	sub2 "}" arg
+			  }
+			  dir2 "{"`
+	d := NewTestDispenser(input)
+
+	d.Next() // dir1
+	if args := d.RemainingArgs(); len(args) != 2 || args[0] != "{" || args[1] != "}" {
+		t.Errorf("Expected quoted braces as arguments, got %v", args)
+	}
+
+	var subdirs [][]string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		subdirs = append(subdirs, append([]string{d.Val()}, d.RemainingArgs()...))
+	}
+	if len(subdirs) != 2 {
+		t.Fatalf("Expected 2 subdirectives, got %d: %v", len(subdirs), subdirs)
+	}
+	if subdirs[0][0] != "sub1" || len(subdirs[0]) != 2 || subdirs[0][1] != "{" {
+		t.Errorf("Unexpected first subdirective: %v", subdirs[0])
+	}
+	if subdirs[1][0] != "sub2" || len(subdirs[1]) != 3 || subdirs[1][1] != "}" || subdirs[1][2] != "arg" {
+		t.Errorf("Unexpected second subdirective: %v", subdirs[1])
+	}
+
+	if !d.Next() || d.Val() != "dir2" {
+		t.Fatalf("Expected dir2, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Errorf("Expected quoted '{' as argument, got %q", d.Val())
+	}
+	if d.NextBlock(0) {
+		t.Error("Quoted '{' should not open a block")
+	}
+}
diff --git a/caddyconfig/caddyfile/lexer.go b/caddyconfig/caddyfile/lexer.go
index 40ea2e5..9c0bd2d 100644
--- a/caddyconfig/caddyfile/lexer.go
+++ b/caddyconfig/caddyfile/lexer.go
@@ -347,6 +347,20 @@ func (t Token) Quoted() bool {
 	return t.wasQuoted > 0
 }
 
+// isOpenCurlyBrace returns true if the token is an unquoted
+// opening curly brace, i.e. one that opens a block. A quoted
+// "{" is just a regular argument.
+func (t Token) isOpenCurlyBrace() bool {
+	return t.Text == "{" && !t.Quoted()
+}
+
+// isCloseCurlyBrace returns true if the token is an unquoted
+// closing curly brace, i.e. one that closes a block. A quoted
+// "}" is just a regular argument.
+func (t Token) isCloseCurlyBrace() bool {
+	return t.Text == "}" && !t.Quoted()
+}
+
 // NumLineBreaks counts how many line breaks are in the token text.
 func (t Token) NumLineBreaks() int {
 	lineBreaks := strings.Count(t.Text, "\n")
