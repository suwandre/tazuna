diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..b5819e4 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,32 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesDoNotAffectBlocks(t *testing.T) {
+	for _, input := range []string{
+		":8080 {\n\trespond \"{\"\n}",
+		":8080 {\n\trespond \"}\"\n}",
+		":8080 {\n\trespond \"{\" \"}\"\n}",
+		":8080 {\n\trespond `{`\n}",
+		":8080 {\n\thandle {\n\t\trespond \"{\"\n\t}\n}",
+	} {
+		blocks, err := Parse("Caddyfile", []byte(input))
+		if err != nil {
+			t.Errorf("input %q: unexpected error: %v", input, err)
+			continue
+		}
+		if len(blocks) != 1 || len(blocks[0].Segments) != 1 {
+			t.Errorf("input %q: unexpected result: %+v", input, blocks)
+		}
+	}
+
+	// quoted braces are plain arguments for the dispenser
+	blocks, err := Parse("Caddyfile", []byte(":8080 {\n\trespond \"{\" 200\n}"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	d := NewDispenser(blocks[0].Segments[0])
+	if !d.Next() || !d.NextArg() || d.Val() != "{" || !d.NextArg() || d.Val() != "200" {
+		t.Errorf("expected quoted brace to be an argument, got %q", d.Val())
+	}
+}
