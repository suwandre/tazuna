+func TestQuotedBracesInSnippetsAndBlocks(t *testing.T) {
+	p := testParser(`
+		(snip) {
+			respond "{"
+		}
+
+		:8080 {
+			import snip
+			respond "}"
+		}
+	`)
+	blocks, err := p.parseAll()
+	if err != nil {
+		t.Fatalf("Expected error to be nil but got '%v'", err)
+	}
+	if len(blocks) != 1 {
+		t.Fatalf("Expected 1 server block, got %d", len(blocks))
+	}
+	if len(blocks[0].Segments) != 2 {
+		t.Fatalf("Expected 2 segments, got %d", len(blocks[0].Segments))
+	}
+	if got := blocks[0].Segments[0][1].Text; got != "{" {
+		t.Errorf("Expected first argument '{', got %q", got)
+	}
+	if got := blocks[0].Segments[1][1].Text; got != "}" {
+		t.Errorf("Expected second argument '}', got %q", got)
+	}
+}
