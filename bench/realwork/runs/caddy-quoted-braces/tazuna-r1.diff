--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,33 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBracesAreNotBlocks(t *testing.T) {
+	input := `foo "{" "}"
+	bar {
+		baz "{"
+	}`
+	d := NewTestDispenser(input)
+	if !d.Next() || d.Val() != "foo" {
+		t.Fatal("expected foo")
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Fatalf("expected quoted '{' to be an argument, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "}" {
+		t.Fatalf("expected quoted '}' to be an argument, got %q", d.Val())
+	}
+	if !d.Next() || d.Val() != "bar" {
+		t.Fatal("expected bar")
+	}
+	var inside []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		inside = append(inside, d.Val())
+		for d.NextArg() {
+			inside = append(inside, d.Val())
+		}
+	}
+	if strings.Join(inside, ",") != "baz,{" {
+		t.Errorf("unexpected block contents: %v", inside)
+	}
+}
