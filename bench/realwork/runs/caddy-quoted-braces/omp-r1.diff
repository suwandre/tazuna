+	"slices"
 	"strings"
 	"testing"
 )
@@ -168,6 +169,32 @@ func TestDispenser_NextBlock(t *testing.T) {
 	assertNextBlock(false, 8, 0) // empty block is as if it didn't exist
 }
 
+func TestDispenser_NextBlock_QuotedBraces(t *testing.T) {
+	d := NewTestDispenser(`foobar {
+			  	sub1 "{"
+			  	sub2 "}"
+			  	"}"
+			  }
+			  next`)
+
+	if !d.Next() || d.Val() != "foobar" {
+		t.Fatalf("expected foobar, got %q", d.Val())
+	}
+	var got []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		got = append(got, d.Val())
+	}
+	if want := []string{"sub1", "{", "sub2", "}", "}"}; !slices.Equal(got, want) {
+		t.Errorf("expected block tokens %q, got %q", want, got)
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("expected nesting 0, got %d", d.Nesting())
+	}
+	if !d.Next() || d.Val() != "next" {
+		t.Errorf("expected to land on 'next', got %q", d.Val())
+	}
+}
