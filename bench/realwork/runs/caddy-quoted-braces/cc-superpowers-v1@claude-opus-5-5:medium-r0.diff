+func TestDispenser_QuotedBraces(t *testing.T) {
+	input := `dir1 "{" "}" {
+				sub1 "}"
+				sub2 ` + "`{`" + `
+			  }
+			  dir2`
+	d := NewTestDispenser(input)
+
+	d.Next() // dir1
+	if args := d.RemainingArgs(); !reflect.DeepEqual(args, []string{"{", "}"}) {
+		t.Errorf("RemainingArgs(): expected quoted braces as arguments, got %q", args)
+	}
+
+	var subdirs [][]string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		subdirs = append(subdirs, append([]string{d.Val()}, d.RemainingArgs()...))
+	}
+	expected := [][]string{{"sub1", "}"}, {"sub2", "{"}}
+	if !reflect.DeepEqual(subdirs, expected) {
+		t.Errorf("NextBlock(): expected subdirectives %q, got %q", expected, subdirs)
+	}
+
+	if !d.Next() || d.Val() != "dir2" {
+		t.Errorf("Next(): expected dir2 after block, got %q", d.Val())
+	}
+}
