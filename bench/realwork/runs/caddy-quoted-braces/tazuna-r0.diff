+// isOpenBrace returns true if the current token is an unquoted
+// opening curly brace. A quoted "{" is just a regular value.
+func (d *Dispenser) isOpenBrace() bool {
+	return d.isUnquotedVal("{")
+}
+
+// isCloseBrace returns true if the current token is an unquoted
+// closing curly brace. A quoted "}" is just a regular value.
+func (d *Dispenser) isCloseBrace() bool {
+	return d.isUnquotedVal("}")
+}
+
+func (d *Dispenser) isUnquotedVal(val string) bool {
+	if d.cursor < 0 || d.cursor >= len(d.tokens) {
+		return false
+	}
+	tok := d.tokens[d.cursor]
+	return tok.Text == val && !tok.Quoted()
+}
