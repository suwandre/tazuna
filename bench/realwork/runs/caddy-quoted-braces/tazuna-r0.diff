diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..ca22d15 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,32 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesDoNotAffectBlocks(t *testing.T) {
+	for i, input := range []string{
+		":8080 {\n\trespond \"{\"\n}\n",
+		":8080 {\n\trespond \"}\"\n}\n",
+		":8080 {\n\trespond \"{\" \"}\"\n}\n",
+		":8080 {\n\trespond `{`\n}\n",
+		":8080 {\n\theader {\n\t\tX-Foo \"{\"\n\t}\n}\n",
+		":8080 {\n\trespond \"{\"\n}\n:8081 {\n\trespond \"}\"\n}\n",
+	} {
+		blocks, err := Parse("Caddyfile", []byte(input))
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) == 0 || len(blocks[0].Segments) != 1 {
+			t.Errorf("Test %d: unexpected parse result: %+v", i, blocks)
+		}
+	}
+
+	blocks, err := Parse("Caddyfile", []byte(":8080 {\n\trespond \"{\"\n}\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	seg := blocks[0].Segments[0]
+	if len(seg) != 2 || seg[1].Text != "{" {
+		t.Errorf("Expected segment [respond {], got %v", seg)
+	}
+}
