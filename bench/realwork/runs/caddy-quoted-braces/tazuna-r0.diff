 // Nesting returns the current nesting level. Necessary
 // if using NextBlock()
 func (d *Dispenser) Nesting() int {
@@ -406,7 +426,7 @@ func (d *Dispenser) Reset() {
 // a line break or open curly brace was encountered instead of
 // an argument.
 func (d *Dispenser) ArgErr() error {
-	if d.Val() == "{" {
+	if d.isOpenBrace() {
 		return d.Err("unexpected token '{', expecting argument")
 	}
 	return d.Errf("wrong argument count or unexpected line ending after '%s'", d.Val())
diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..bfb9a67 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,25 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBracesAreNotBlocks(t *testing.T) {
+	tokens, err := Tokenize([]byte(`foo "{" "}" bar`), "Testfile")
+	if err != nil {
+		t.Fatal(err)
+	}
+	d := NewDispenser(tokens)
+	d.Next()
+	var args []string
+	for d.NextArg() {
+		args = append(args, d.Val())
+	}
+	if len(args) != 3 || args[0] != "{" || args[1] != "}" || args[2] != "bar" {
+		t.Errorf("Expected quoted braces as arguments, got %v", args)
+	}
+
+	d.Reset()
+	d.Next()
+	if d.NextBlock(0) {
+		t.Error("Expected quoted '{' not to open a block")
+	}
+}
