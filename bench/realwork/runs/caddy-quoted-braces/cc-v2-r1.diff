+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -168,6 +168,45 @@ func TestDispenser_NextBlock(t *testing.T) {
 	assertNextBlock(false, 8, 0) // empty block is as if it didn't exist
 }
 
+func TestDispenser_QuotedBraces(t *testing.T) {
+	d := NewTestDispenser(`foobar "{"
+			  foobar "}"
+			  foobar {
+			  	sub "{" "}"
+			  }`)
+
+	// a quoted open brace is an argument, not a block opening
+	d.Next() // foobar
+	if d.NextBlock(0) {
+		t.Error("NextBlock(): quoted '{' should not open a block")
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Errorf("NextArg(): expected quoted '{' as argument, got %q", d.Val())
+	}
+
+	d.Next() // foobar
+	if !d.NextArg() || d.Val() != "}" {
+		t.Errorf("NextArg(): expected quoted '}' as argument, got %q", d.Val())
+	}
+
+	d.Next() // foobar
+	if !d.NextBlock(0) || d.Val() != "sub" {
+		t.Fatalf("NextBlock(): expected block with 'sub', got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "{" {
+		t.Errorf("NextArg(): expected quoted '{' as argument, got %q", d.Val())
+	}
+	if !d.NextArg() || d.Val() != "}" {
+		t.Errorf("NextArg(): expected quoted '}' as argument, got %q", d.Val())
+	}
+	if d.NextBlock(0) {
+		t.Error("NextBlock(): block should have ended")
+	}
+	if d.nesting != 0 {
+		t.Errorf("Nesting should be 0, not %d", d.nesting)
+	}
+}
