--- a/caddyconfig/caddyfile/lexer.go
+++ b/caddyconfig/caddyfile/lexer.go
@@ -398,3 +398,17 @@ func isNextOnNewLine(t1, t2 Token) bool {
 	// then the second token is on a new line
 	return t1.Line+t1.NumLineBreaks() < t2.Line
 }
+
+// isOpenCurly returns true if the token is an unquoted opening
+// curly brace, which delimits a block. A quoted "{" is a plain
+// argument and has no structural meaning.
+func (t Token) isOpenCurly() bool {
+	return t.Text == "{" && t.wasQuoted == 0
+}
+
+// isCloseCurly returns true if the token is an unquoted closing
+// curly brace, which ends a block. A quoted "}" is a plain
+// argument and has no structural meaning.
+func (t Token) isCloseCurly() bool {
+	return t.Text == "}" && t.wasQuoted == 0
+}
