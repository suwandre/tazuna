 }
 
+func TestDispenser_QuotedBraces(t *testing.T) {
+	input := `dir1 "{"
+			  dir2 "}" {
+			  	sub1 "{"
+			  	sub2 "}"
+			  }
+			  dir3`
+	d := NewTestDispenser(input)
+
+	d.Next() // dir1
+	if !d.NextArg() || d.Val() != "{" {
+		t.Fatalf("NextArg(): expected quoted '{' to be an argument, got %q", d.Val())
+	}
+	if d.NextBlock(0) {
+		t.Errorf("NextBlock(): quoted '{' should not open a block")
+	}
+
+	d.Next() // dir2
+	if !d.NextArg() || d.Val() != "}" {
+		t.Fatalf("NextArg(): expected quoted '}' to be an argument, got %q", d.Val())
+	}
+	if d.NextArg() {
+		t.Errorf("NextArg(): unquoted '{' should not be an argument")
+	}
+
+	var subs []string
+	for d.NextBlock(0) {
+		subs = append(subs, d.Val())
+		if !d.NextArg() {
+			t.Fatalf("NextArg(): expected argument after %s", d.Val())
+		}
+	}
+	if len(subs) != 2 || subs[0] != "sub1" || subs[1] != "sub2" {
+		t.Errorf("NextBlock(): expected [sub1 sub2], got %v", subs)
+	}
+	if d.nesting != 0 {
+		t.Errorf("NextBlock(): expected nesting 0, got %d", d.nesting)
+	}
+
+	if !d.Next() || d.Val() != "dir3" {
+		t.Errorf("Next(): expected dir3, got %q", d.Val())
+	}
+}
