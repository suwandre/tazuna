 	}
 	return d.Errf("wrong argument count or unexpected line ending after '%s'", d.Val())
@@ -531,3 +531,25 @@ func (d *Dispenser) isNextOnNewLine() bool {
 }
 
 const MatcherNameCtxKey = "matcher_name"
+
+// isOpenBrace returns true if the current token is an unquoted
+// opening curly brace, which delimits a block. A quoted "{" is
+// just a regular string value.
+func (d *Dispenser) isOpenBrace() bool {
+	if d.cursor < 0 || d.cursor >= len(d.tokens) {
+		return false
+	}
+	t := d.tokens[d.cursor]
+	return t.Text == "{" && t.wasQuoted == 0
+}
+
+// isCloseBrace returns true if the current token is an unquoted
+// closing curly brace, which ends a block. A quoted "}" is
+// just a regular string value.
+func (d *Dispenser) isCloseBrace() bool {
+	if d.cursor < 0 || d.cursor >= len(d.tokens) {
+		return false
+	}
+	t := d.tokens[d.cursor]
+	return t.Text == "}" && t.wasQuoted == 0
+}
diff --git a/caddyconfig/caddyfile/dispenser_test.go b/caddyconfig/caddyfile/dispenser_test.go
index f5d2260..92fbaec 100644
--- a/caddyconfig/caddyfile/dispenser_test.go
+++ b/caddyconfig/caddyfile/dispenser_test.go
@@ -371,3 +371,25 @@ func TestDispenser_ArgErr_Err(t *testing.T) {
 		t.Errorf("Errf(): should be able to unwrap the error chain")
 	}
 }
+
+func TestDispenser_QuotedBracesAreNotBlockDelimiters(t *testing.T) {
+	d := NewTestDispenser(`foo "{" "}" bar {
+		sub "}"
+		sub2 "{"
+	}`)
+	if !d.Next() || d.Val() != "foo" {
+		t.Fatalf("expected foo, got %q", d.Val())
+	}
+	for _, want := range []string{"{", "}", "bar"} {
+		if !d.NextArg() || d.Val() != want {
+			t.Fatalf("expected arg %q, got %q", want, d.Val())
+		}
+	}
+	var subs []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		subs = append(subs, d.Val()+d.RemainingArgs()[0])
+	}
+	if got := strings.Join(subs, ","); got != "sub},sub2{" {
+		t.Errorf("unexpected block contents: %s", got)
+	}
+}
