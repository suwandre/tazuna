diff --git a/caddyconfig/caddyfile/parse_test.go b/caddyconfig/caddyfile/parse_test.go
index 9403f7a..93d4fa4 100644
--- a/caddyconfig/caddyfile/parse_test.go
+++ b/caddyconfig/caddyfile/parse_test.go
@@ -1034,3 +1034,68 @@ func TestImportedSnippetDefinitionRetainsBlockPlaceholder(t *testing.T) {
 func testParser(input string) parser {
 	return parser{Dispenser: NewTestDispenser(input)}
 }
+
+func TestQuotedBracesDoNotAffectBlockParsing(t *testing.T) {
+	for i, tc := range []struct {
+		input    string
+		segments [][]string // expected token texts per segment
+	}{
+		{`:8080 {
+	respond "{"
+}`, [][]string{{"respond", "{"}}},
+		{`:8080 {
+	respond "}"
+}`, [][]string{{"respond", "}"}}},
+		{`:8080 {
+	respond "{" 200
+	header X "}"
+}`, [][]string{{"respond", "{", "200"}, {"header", "X", "}"}}},
+		{`:8080 {
+	route {
+		respond ` + "`{`" + `
+	}
+}`, [][]string{{"route", "{", "respond", "{", "}"}}},
+	} {
+		blocks, err := Parse("Caddyfile", []byte(tc.input))
+		if err != nil {
+			t.Errorf("Test %d: unexpected error: %v", i, err)
+			continue
+		}
+		if len(blocks) != 1 {
+			t.Errorf("Test %d: expected 1 server block, got %d", i, len(blocks))
+			continue
+		}
+		if len(blocks[0].Segments) != len(tc.segments) {
+			t.Errorf("Test %d: expected %d segments, got %d", i, len(tc.segments), len(blocks[0].Segments))
+			continue
+		}
+		for j, seg := range blocks[0].Segments {
+			var texts []string
+			for _, tok := range seg {
+				texts = append(texts, tok.Text)
+			}
+			if strings.Join(texts, " ") != strings.Join(tc.segments[j], " ") {
+				t.Errorf("Test %d segment %d: expected %v, got %v", i, j, tc.segments[j], texts)
+			}
+		}
+	}
+}
+
+func TestQuotedBracesInSnippetAndBlockTokens(t *testing.T) {
+	input := `(snip) {
+	respond "{"
+}
+:8080 {
+	import snip
+	route {
+		respond "}"
+	}
+}`
+	blocks, err := Parse("Caddyfile", []byte(input))
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if len(blocks) != 1 || len(blocks[0].Segments) != 2 {
+		t.Fatalf("unexpected parse result: %+v", blocks)
+	}
+}
