+// isBrace returns true if the token is an unquoted curly brace
+// with the given text ("{" or "}"). Quoted braces are plain
+// values and never open or close a block.
+func (t Token) isBrace(brace string) bool {
+	return t.wasQuoted == 0 && t.Text == brace
