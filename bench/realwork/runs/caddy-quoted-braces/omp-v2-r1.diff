@@ -168,6 +168,35 @@ func TestDispenser_NextBlock(t *testing.T) {
 	assertNextBlock(false, 8, 0) // empty block is as if it didn't exist
 }
 
+func TestDispenser_QuotedBracesAreArgs(t *testing.T) {
+	d := NewTestDispenser(`foo "{" "}" bar {
+				sub "}"
+			}`)
+
+	if !d.Next() || d.Val() != "foo" {
+		t.Fatalf("expected directive foo, got %q", d.Val())
+	}
+	for _, expected := range []string{"{", "}", "bar"} {
+		if !d.NextArg() || d.Val() != expected {
+			t.Fatalf("expected arg %q, got %q", expected, d.Val())
+		}
+	}
+	if d.NextArg() {
+		t.Fatalf("unquoted '{' must not be an argument, got %q", d.Val())
+	}
+
+	var got []string
+	for nesting := d.Nesting(); d.NextBlock(nesting); {
+		got = append(got, d.Val())
+	}
+	if len(got) != 2 || got[0] != "sub" || got[1] != "}" {
+		t.Errorf("unexpected block tokens: %v", got)
+	}
+	if d.Nesting() != 0 {
+		t.Errorf("expected nesting 0 after block, got %d", d.Nesting())
+	}
+}
