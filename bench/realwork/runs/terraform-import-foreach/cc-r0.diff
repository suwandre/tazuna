@@ -0,0 +1,55 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	statements := refactoring.FindImportStatements(rootCfg)
+
+	type result struct {
+		Containing string
+		Resource   string
+		ID         string
+	}
+	var got []result
+	for _, stmt := range statements {
+		id, diags := stmt.Import.ID.Value(nil)
+		if diags.HasErrors() {
+			t.Fatalf("unexpected error evaluating id: %s", diags.Error())
+		}
+		got = append(got, result{
+			Containing: stmt.ContainingModule.String(),
+			Resource:   stmt.AbsToResource.String(),
+			ID:         id.AsString(),
+		})
+	}
+
+	want := []result{
+		// Multiple blocks targeting instances of the same resource are all
+		// kept.
+		{"", "test_resource.multi", "a"},
+		{"", "test_resource.multi", "b"},
+
+		// Blocks in the parent override all of the blocks for the same
+		// resource in the child module.
+		{"", "module.child.test_resource.overridden", "parent_a"},
+		{"", "module.child.test_resource.overridden", "parent_b"},
+
+		// Resources not mentioned by the parent keep all their blocks.
+		{"module.child", "module.child.test_resource.kept", "child_a"},
+		{"module.child", "module.child.test_resource.kept", "child_b"},
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong result\n%s", diff)
+	}
+}
