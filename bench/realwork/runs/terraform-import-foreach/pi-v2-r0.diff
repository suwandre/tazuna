--- /dev/null
+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,37 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	cfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	stmts := refactoring.FindImportStatements(cfg)
+
+	// Multiple blocks in the same module targeting the same resource are all
+	// kept, while a block in a parent module overrides blocks in a child module
+	// targeting the same resource.
+	got := map[string]int{}
+	for _, s := range stmts {
+		got[s.ContainingModule.String()+"|"+s.AbsToResource.String()]++
+	}
+	want := map[string]int{
+		"|test_thing.a":                          2,
+		"|module.child.test_thing.b":             1,
+		"module.child|module.child.test_thing.c": 2,
+	}
+	if len(got) != len(want) {
+		t.Fatalf("wrong statements\ngot:  %#v\nwant: %#v", got, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Errorf("wrong count for %q: got %d, want %d (all: %#v)", k, got[k], v, got)
+		}
+	}
+}
