diff --git a/internal/terraform/context_apply_import_test.go b/internal/terraform/context_apply_import_test.go
index 0f5b087..d5e08f5 100644
--- a/internal/terraform/context_apply_import_test.go
+++ b/internal/terraform/context_apply_import_test.go
@@ -584,3 +584,200 @@ func childModuleImportTestProvider() *testing_provider.MockProvider {
 
 	return p
 }
+
+func TestContextApply_import_multipleBlocksSameResource(t *testing.T) {
+	// Multiple import blocks may target different instances of the same
+	// expanded resource. All of them must be honored, regardless of the order
+	// in which they are declared or whether they are in a child module.
+	tests := map[string]struct {
+		config map[string]string
+		want   map[string]string
+	}{
+		"for_each": {
+			config: map[string]string{
+				"main.tf": `
+resource "test_object" "a" {
+  for_each = toset(["a", "b", "c"])
+}
+
+import {
+  to = test_object.a["a"]
+  id = "aaa"
+}
+
+import {
+  to = test_object.a["b"]
+  id = "bbb"
+}
+
+import {
+  to = test_object.a["c"]
+  id = "ccc"
+}
+`,
+			},
+			want: map[string]string{
+				`test_object.a["a"]`: "aaa",
+				`test_object.a["b"]`: "bbb",
+				`test_object.a["c"]`: "ccc",
+			},
+		},
+		"for_each reversed": {
+			config: map[string]string{
+				"main.tf": `
+resource "test_object" "a" {
+  for_each = toset(["a", "b"])
+}
+
+import {
+  to = test_object.a["b"]
+  id = "bbb"
+}
+
+import {
+  to = test_object.a["a"]
+  id = "aaa"
+}
+`,
+			},
+			want: map[string]string{
+				`test_object.a["a"]`: "aaa",
+				`test_object.a["b"]`: "bbb",
+			},
+		},
+		"count": {
+			config: map[string]string{
+				"main.tf": `
+resource "test_object" "a" {
+  count = 2
+}
+
+import {
+  to = test_object.a[0]
+  id = "zero"
+}
+
+import {
+  to = test_object.a[1]
+  id = "one"
+}
+`,
+			},
+			want: map[string]string{
+				`test_object.a[0]`: "zero",
+				`test_object.a[1]`: "one",
+			},
+		},
+		"in child module": {
+			config: map[string]string{
+				"main.tf": `
+module "child" {
+  source = "./child"
+}
+`,
+				"child/main.tf": `
+resource "test_object" "a" {
+  for_each = toset(["a", "b"])
+}
+
+import {
+  to = test_object.a["a"]
+  id = "aaa"
+}
+
+import {
+  to = test_object.a["b"]
+  id = "bbb"
+}
+`,
+			},
+			want: map[string]string{
+				`module.child.test_object.a["a"]`: "aaa",
+				`module.child.test_object.a["b"]`: "bbb",
+			},
+		},
+		"from root into child module": {
+			config: map[string]string{
+				"main.tf": `
+module "child" {
+  source = "./child"
+}
+
+import {
+  to = module.child.test_object.a["a"]
+  id = "aaa"
+}
+
+import {
+  to = module.child.test_object.a["b"]
+  id = "bbb"
+}
+`,
+				"child/main.tf": `
+resource "test_object" "a" {
+  for_each = toset(["a", "b"])
+}
+`,
+			},
+			want: map[string]string{
+				`module.child.test_object.a["a"]`: "aaa",
+				`module.child.test_object.a["b"]`: "bbb",
+			},
+		},
+	}
+
+	for name, tc := range tests {
+		t.Run(name, func(t *testing.T) {
+			m := testModuleInline(t, tc.config)
+
+			p := mockProviderWithResourceTypeSchema("test_object", &configschema.Block{
+				Attributes: map[string]*configschema.Attribute{
+					"id": {Type: cty.String, Computed: true},
+				},
+			})
+			p.ImportResourceStateFn = func(req providers.ImportResourceStateRequest) providers.ImportResourceStateResponse {
+				return providers.ImportResourceStateResponse{
+					ImportedResources: []providers.ImportedResource{{
+						TypeName: "test_object",
+						State: cty.ObjectVal(map[string]cty.Value{
+							"id": cty.StringVal(req.ID),
+						}),
+					}},
+				}
+			}
+			ctx := testContext2(t, &ContextOpts{
+				Providers: map[addrs.Provider]providers.Factory{
+					addrs.NewDefaultProvider("test"): testProviderFuncFixed(p),
+				},
+			})
+
+			diags := ctx.Validate(m, nil)
+			tfdiags.AssertNoErrors(t, diags)
+
+			plan, diags := ctx.Plan(m, states.NewState(), DefaultPlanOpts)
+			tfdiags.AssertNoErrors(t, diags)
+
+			if got, want := len(plan.Changes.Resources), len(tc.want); got != want {
+				t.Fatalf("wrong number of planned changes: got %d, want %d", got, want)
+			}
+			for _, rc := range plan.Changes.Resources {
+				addr := rc.Addr.String()
+				wantID, ok := tc.want[addr]
+				if !ok {
+					t.Errorf("unexpected planned change for %s", addr)
+					continue
+				}
+				if rc.Action != plans.NoOp {
+					t.Errorf("wrong action for %s: got %s, want %s", addr, rc.Action, plans.NoOp)
+				}
+				if rc.Importing == nil {
+					t.Errorf("%s is not being imported", addr)
+					continue
+				}
+				if got := rc.Importing.ID; got != wantID {
+					t.Errorf("wrong import id for %s: got %q, want %q", addr, got, wantID)
+				}
+			}
+		})
+	}
+}
