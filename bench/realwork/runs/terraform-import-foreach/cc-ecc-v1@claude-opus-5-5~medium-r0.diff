diff --git a/internal/refactoring/import_statement_test.go b/internal/refactoring/import_statement_test.go
new file mode 100644
index 0000000..24a7a68
--- /dev/null
+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,52 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	// LAZY: We don't need the expanded instances from loadRefactoringFixture
+	// but reuse the helper function anyway.
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	type result struct {
+		ID               string
+		ContainingModule string
+		AbsToResource    string
+	}
+
+	var got []result
+	for _, stmt := range refactoring.FindImportStatements(rootCfg) {
+		id, diags := stmt.Import.ID.Value(nil)
+		if diags.HasErrors() {
+			t.Fatal(diags.Error())
+		}
+		got = append(got, result{
+			ID:               id.AsString(),
+			ContainingModule: stmt.ContainingModule.String(),
+			AbsToResource:    stmt.AbsToResource.String(),
+		})
+	}
+
+	want := []result{
+		// Multiple import blocks targeting instances of the same resource
+		// must all be returned, in declaration order.
+		{`foo-b`, ``, `test_resource.foo`},
+		{`foo-a`, ``, `test_resource.foo`},
+		// The root module import block overrides the child module block.
+		{`root`, ``, `module.child.test_resource.overridden`},
+		{`bar-0`, `module.child`, `module.child.test_resource.bar`},
+		{`bar-1`, `module.child`, `module.child.test_resource.bar`},
+	}
+
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong result\n%s", diff)
+	}
+}
