@@ -0,0 +1,55 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/hashicorp/hcl/v2"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	// LAZY: We don't need the expanded instances from loadRefactoringFixture
+	// but reuse the helper function anyway.
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	stmts := refactoring.FindImportStatements(rootCfg)
+
+	type result struct {
+		Module   string
+		Resource string
+		ID       string
+	}
+	var got []result
+	for _, stmt := range stmts {
+		id, diags := stmt.Import.ID.Value(&hcl.EvalContext{})
+		if diags.HasErrors() {
+			t.Fatalf("invalid import id: %s", diags.Error())
+		}
+		got = append(got, result{
+			Module:   stmt.ContainingModule.String(),
+			Resource: stmt.AbsToResource.String(),
+			ID:       id.AsString(),
+		})
+	}
+
+	want := []result{
+		{"", "test_resource.single", "single"},
+		{"", "test_resource.each", "each_a"},
+		{"", "test_resource.each", "each_b"},
+		{"", "module.child.test_resource.overridden", "root_overridden_a"},
+		// The root module's import block for overridden takes precedence over
+		// both child module import blocks, but the child module's blocks for
+		// a different resource are all retained.
+		{"module.child", "module.child.test_resource.each", "child_each_a"},
+		{"module.child", "module.child.test_resource.each", "child_each_b"},
+	}
+
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong import statements\n%s", diff)
+	}
+}
