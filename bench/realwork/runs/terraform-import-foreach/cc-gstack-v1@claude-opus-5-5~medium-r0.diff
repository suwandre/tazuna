+// Multiple import blocks may target different instances of the same
+// expanded resource, and each of them must be honored.
+func TestContext2Plan_importMultipleBlocksSameResource(t *testing.T) {
+	m := testModuleInline(t, map[string]string{
+		"main.tf": `
+resource "test_object" "single" {
+  test_string = "foo"
+}
+
+resource "test_object" "each" {
+  for_each    = toset(["a", "b", "c"])
+  test_string = "foo"
+}
+
+resource "test_object" "count" {
+  count       = 2
+  test_string = "foo"
+}
+
+import {
+  to = test_object.single
+  id = "single"
+}
+
+import {
+  to = test_object.each["b"]
+  id = "each_b"
+}
+
+import {
+  to = test_object.each["a"]
+  id = "each_a"
+}
+
+import {
+  to = test_object.each["c"]
+  id = "each_c"
+}
+
+import {
+  to = test_object.count[0]
+  id = "count_0"
+}
+
+import {
+  to = test_object.count[1]
+  id = "count_1"
+}
+
+module "child" {
+  source = "./child"
+}
+`,
+		"child/main.tf": `
+resource "test_object" "each" {
+  for_each    = toset(["a", "b"])
+  test_string = "foo"
+}
+
+import {
+  to = test_object.each["a"]
+  id = "child_each_a"
+}
+
+import {
+  to = test_object.each["b"]
+  id = "child_each_b"
+}
+`,
+	})
+
+	p := simpleMockProvider()
+	ctx := testContext2(t, &ContextOpts{
+		Providers: map[addrs.Provider]providers.Factory{
+			addrs.NewDefaultProvider("test"): testProviderFuncFixed(p),
+		},
+	})
+	p.ReadResourceResponse = &providers.ReadResourceResponse{
+		NewState: cty.ObjectVal(map[string]cty.Value{
+			"test_string": cty.StringVal("foo"),
+		}),
+	}
+	p.ImportResourceStateResponse = &providers.ImportResourceStateResponse{
+		ImportedResources: []providers.ImportedResource{
+			{
+				TypeName: "test_object",
+				State: cty.ObjectVal(map[string]cty.Value{
+					"test_string": cty.StringVal("foo"),
+				}),
+			},
+		},
+	}
+
+	diags := ctx.Validate(m, &ValidateOpts{})
+	tfdiags.AssertNoErrors(t, diags)
+
+	plan, diags := ctx.Plan(m, states.NewState(), DefaultPlanOpts)
+	tfdiags.AssertNoErrors(t, diags)
+
+	want := map[string]string{
+		`test_object.single`:                 "single",
+		`test_object.each["a"]`:              "each_a",
+		`test_object.each["b"]`:              "each_b",
+		`test_object.each["c"]`:              "each_c",
+		`test_object.count[0]`:               "count_0",
+		`test_object.count[1]`:               "count_1",
+		`module.child.test_object.each["a"]`: "child_each_a",
+		`module.child.test_object.each["b"]`: "child_each_b",
+	}
+
+	if got, want := len(plan.Changes.Resources), len(want); got != want {
+		t.Errorf("wrong number of resource changes: got %d, want %d", got, want)
+	}
+
+	for _, instPlan := range plan.Changes.Resources {
+		addr := instPlan.Addr.String()
+		wantID, ok := want[addr]
+		if !ok {
+			t.Errorf("unexpected change for %s", addr)
+			continue
+		}
+		if instPlan.Importing == nil {
+			t.Errorf("%s: expected import of %q, but it is not being imported (action %s)", addr, wantID, instPlan.Action)
+			continue
+		}
+		if got := instPlan.Importing.ID; got != wantID {
+			t.Errorf("%s: wrong import ID\ngot:  %q\nwant: %q", addr, got, wantID)
+		}
+		if got, want := instPlan.Action, plans.NoOp; got != want {
+			t.Errorf("%s: wrong planned action\ngot:  %s\nwant: %s", addr, got, want)
+		}
+	}
+}
