@@ -0,0 +1,67 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	stmts := refactoring.FindImportStatements(rootCfg)
+
+	// The two import blocks targeting the for_each resource must both survive,
+	// because they target different instances of the same config object.
+	// Previously they were deduplicated down to a single statement.
+	// The child module's import block targeting the same object as the root
+	// module's must be dropped in favour of the root module's.
+	want := map[string]string{
+		"test_resource.each=a":                        "main.tf",
+		"test_resource.each=b":                        "main.tf",
+		"test_resource.plain=plain":                   "main.tf",
+		"module.child.test_resource.overridden=root":  "main.tf",
+		"module.child.test_resource.child_only=child": "child/main.tf",
+	}
+
+	if len(stmts) != len(want) {
+		t.Fatalf("wrong number of statements: got %d, want %d\n%#v", len(stmts), len(want), stmts)
+	}
+
+	got := make(map[string]string, len(stmts))
+	for _, stmt := range stmts {
+		id, diags := stmt.Import.ID.Value(nil)
+		if diags.HasErrors() {
+			t.Fatalf("failed to evaluate import id: %s", diags.Error())
+		}
+
+		// The config resource address alone doesn't distinguish the imports
+		// for different instances of an expanded resource, so we pair it with
+		// the import ID to form a unique key.
+		key := stmt.AbsToResource.String() + "=" + id.AsString()
+
+		// Record the file the import block was declared in, relative to the
+		// root module, so we can tell imports declared in the root module
+		// apart from those declared in the child module.
+		rel, err := filepath.Rel(rootCfg.Module.SourceDir, stmt.Import.DeclRange.Filename)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got[key] = filepath.ToSlash(rel)
+	}
+
+	for key, wantFile := range want {
+		gotFile, ok := got[key]
+		if !ok {
+			t.Errorf("missing import statement for %s", key)
+			continue
+		}
+		if gotFile != wantFile {
+			t.Errorf("wrong declaring file for %s: got %q, want %q", key, gotFile, wantFile)
+		}
+	}
+}
