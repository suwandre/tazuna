+func TestContext2Plan_importMultipleBlocksConfigGeneration(t *testing.T) {
+	// Regression test for https://github.com/hashicorp/terraform/issues/39010:
+	// multiple import blocks can target the same config object when it uses
+	// for_each or count. Config generation isn't supported in that situation,
+	// but Terraform must still report the problem rather than panicking
+	// because we tried to expand the same missing resource twice.
+	m := testModuleInline(t, map[string]string{
+		"main.tf": `
+import {
+  to = test_object.missing["a"]
+  id = "aaa"
+}
+
+import {
+  to = test_object.missing["b"]
+  id = "bbb"
+}
+`,
+	})
+
+	ctx := testContext2(t, &ContextOpts{
+		Providers: map[addrs.Provider]providers.Factory{
+			addrs.NewDefaultProvider("test"): testProviderFuncFixed(simpleMockProvider()),
+		},
+	})
+
+	_, diags := ctx.Plan(m, states.NewState(), &PlanOpts{
+		Mode:               plans.NormalMode,
+		GenerateConfigPath: "generated.tf",
+	})
+
+	// This configuration isn't valid because config generation isn't
+	// compatible with for_each, but the important part is that we get proper
+	// diagnostics rather than a panic from trying to expand the same missing
+	// resource twice.
+	if !diags.HasErrors() {
+		t.Fatal("expected errors, got none")
+	}
+	if !strings.Contains(diags.Err().Error(), "Invalid import 'to' expression") {
+		t.Fatalf("expected an import 'to' expression error, got:\n%s", diags.Err())
+	}
+}
