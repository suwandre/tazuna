+  id = "a"
+}
+
+import {
+  to = test_resource.each["b"]
+  id = "b"
+}
+
+# a single-instance resource with its own import block.
+resource "test_resource" "plain" {}
+
+import {
+  to = test_resource.plain
+  id = "plain"
+}
+
+# this one is overridden by the parent module's import block targeting the
+# same object.
+module "child" {
+  source = "./child"
+}
+
+import {
+  to = module.child.test_resource.overridden
+  id = "root"
+}
