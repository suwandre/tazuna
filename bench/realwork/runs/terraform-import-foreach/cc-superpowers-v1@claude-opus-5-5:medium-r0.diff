diff --git a/internal/refactoring/import_statement_test.go b/internal/refactoring/import_statement_test.go
new file mode 100644
index 0000000..a7282b6
--- /dev/null
+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,59 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/hcl/v2"
+
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	// LAZY: We don't need the expanded instances from loadRefactoringFixture
+	// but reuse the helper function anyway.
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	type result struct {
+		AbsToResource    string
+		ContainingModule string
+		To               string
+		ID               string
+	}
+
+	var got []result
+	for _, stmt := range refactoring.FindImportStatements(rootCfg) {
+		traversal, diags := hcl.AbsTraversalForExpr(stmt.Import.To)
+		if diags.HasErrors() {
+			t.Fatal(diags.Error())
+		}
+		to, tDiags := addrs.ParseAbsResourceInstance(traversal)
+		if tDiags.HasErrors() {
+			t.Fatal(tDiags.Err())
+		}
+		id, _ := stmt.Import.ID.Value(nil)
+		got = append(got, result{
+			AbsToResource:    stmt.AbsToResource.String(),
+			ContainingModule: stmt.ContainingModule.String(),
+			To:               to.String(),
+			ID:               id.AsString(),
+		})
+	}
+
+	want := []result{
+		{"test_resource.foo", "", `test_resource.foo["b"]`, "bbb"},
+		{"test_resource.foo", "", `test_resource.foo["a"]`, "aaa"},
+		{"module.child.test_resource.baz", "", `module.child.test_resource.baz["a"]`, "parent"},
+		{"module.child.test_resource.bar", "module.child", `test_resource.bar[0]`, "zero"},
+		{"module.child.test_resource.bar", "module.child", `test_resource.bar[1]`, "one"},
+	}
+
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong import statements\n%s", diff)
+	}
+}
