+// Multiple separate import blocks may target different instances of the same
+// resource, and all of them must be honored.
+func TestContext2Plan_importMultipleBlocksSameResource(t *testing.T) {
+	tcs := map[string]struct {
+		config map[string]string
+		want   map[string]string
+	}{
+		"for_each": {
+			config: map[string]string{
+				"main.tf": `
+resource "test_object" "a" {
+  for_each    = toset(["a", "b", "c"])
+  test_string = each.key
+}
+
+import {
+  to = test_object.a["b"]
+  id = "bbb"
+}
+
+import {
+  to = test_object.a["a"]
+  id = "aaa"
+}
+
+import {
+  to = test_object.a["c"]
+  id = "ccc"
+}
+`,
+			},
+			want: map[string]string{
+				`test_object.a["a"]`: "aaa",
+				`test_object.a["b"]`: "bbb",
+				`test_object.a["c"]`: "ccc",
+			},
+		},
+		"count": {
+			config: map[string]string{
+				"main.tf": `
+resource "test_object" "a" {
+  count       = 2
+  test_string = "foo"
+}
+
+import {
+  to = test_object.a[0]
+  id = "zero"
+}
+
+import {
+  to = test_object.a[1]
+  id = "one"
+}
+`,
+			},
+			want: map[string]string{
+				`test_object.a[0]`: "zero",
+				`test_object.a[1]`: "one",
+			},
+		},
+		"for_each import block and single import block": {
+			config: map[string]string{
+				"main.tf": `
+resource "test_object" "a" {
+  for_each    = toset(["a", "b", "c"])
+  test_string = each.key
+}
+
+import {
+  for_each = toset(["a", "b"])
+  to       = test_object.a[each.key]
+  id       = "${each.key}${each.key}${each.key}"
+}
+
+import {
+  to = test_object.a["c"]
+  id = "ccc"
+}
+`,
+			},
+			want: map[string]string{
+				`test_object.a["a"]`: "aaa",
+				`test_object.a["b"]`: "bbb",
+				`test_object.a["c"]`: "ccc",
+			},
+		},
+		"in module": {
+			config: map[string]string{
+				"main.tf": `
+module "sub" {
+  source = "./sub"
+}
+`,
+				"sub/main.tf": `
+resource "test_object" "a" {
+  for_each    = toset(["a", "b"])
+  test_string = each.key
+}
+
+import {
+  to = test_object.a["a"]
+  id = "aaa"
+}
+
+import {
+  to = test_object.a["b"]
+  id = "bbb"
+}
+`,
+			},
+			want: map[string]string{
+				`module.sub.test_object.a["a"]`: "aaa",
+				`module.sub.test_object.a["b"]`: "bbb",
+			},
+		},
+	}
+
+	for name, tc := range tcs {
+		t.Run(name, func(t *testing.T) {
+			m := testModuleInline(t, tc.config)
+
+			p := simpleMockProvider()
+			ctx := testContext2(t, &ContextOpts{
+				Providers: map[addrs.Provider]providers.Factory{
+					addrs.NewDefaultProvider("test"): testProviderFuncFixed(p),
+				},
+			})
+			p.ReadResourceResponse = &providers.ReadResourceResponse{
+				NewState: cty.ObjectVal(map[string]cty.Value{
+					"test_string": cty.StringVal("foo"),
+				}),
+			}
+			p.ImportResourceStateResponse = &providers.ImportResourceStateResponse{
+				ImportedResources: []providers.ImportedResource{
+					{
+						TypeName: "test_object",
+						State: cty.ObjectVal(map[string]cty.Value{
+							"test_string": cty.StringVal("foo"),
+						}),
+					},
+				},
+			}
+
+			diags := ctx.Validate(m, &ValidateOpts{})
+			tfdiags.AssertNoErrors(t, diags)
+
+			plan, diags := ctx.Plan(m, states.NewState(), DefaultPlanOpts)
+			tfdiags.AssertNoErrors(t, diags)
+
+			if got, want := len(plan.Changes.Resources), len(tc.want); got != want {
+				t.Errorf("wrong number of resource changes: got %d, want %d", got, want)
+			}
+			for addrStr, wantID := range tc.want {
+				addr := mustResourceInstanceAddr(addrStr)
+				instPlan := plan.Changes.ResourceInstance(addr)
+				if instPlan == nil {
+					t.Errorf("no plan for %s", addr)
+					continue
+				}
+				if instPlan.Action == plans.Create {
+					t.Errorf("%s planned for create instead of import", addr)
+				}
+				if got := instPlan.Importing; got == nil || got.ID != wantID {
+					t.Errorf("wrong import for %s: got %#v, want ID %q", addr, got, wantID)
+				}
+			}
+		})
+	}
+}
