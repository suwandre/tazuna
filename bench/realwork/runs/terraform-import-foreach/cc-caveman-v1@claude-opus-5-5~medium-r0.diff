+// overriddenByParent returns true if any import statement already collected
+// from an ancestor module targets the same resource instance as the given
+// import block.
+func overriddenByParent(existing []ImportStatement, path addrs.Module, toAddr addrs.ConfigResource, imp *configs.Import) bool {
+	key, keyOK := staticImportResourceKey(imp.To)
+	for _, e := range existing {
+		// Import blocks within the same module never override one another;
+		// duplicate targets there are reported during config loading.
+		if e.ContainingModule.Equal(path) || !e.AbsToResource.Equal(toAddr) {
+			continue
+		}
+
+		eKey, eKeyOK := staticImportResourceKey(e.Import.To)
+		if !keyOK || !eKeyOK || key == eKey {
+			return true
+		}
+	}
+	return false
+}
+
+// staticImportResourceKey returns the resource instance key of an import
+// block's "to" address, if it can be determined without evaluation.
+func staticImportResourceKey(expr hcl.Expression) (addrs.InstanceKey, bool) {
+	if expr == nil {
+		return nil, false
+	}
+	traversal, diags := hcl.AbsTraversalForExpr(expr)
+	if diags.HasErrors() {
+		return nil, false
+	}
+	to, toDiags := addrs.ParseAbsResourceInstance(traversal)
+	if toDiags.HasErrors() {
+		return nil, false
+	}
+	return to.Resource.Key, true
+}
