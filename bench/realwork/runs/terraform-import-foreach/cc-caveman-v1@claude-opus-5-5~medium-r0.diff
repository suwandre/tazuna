+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	// LAZY: We don't need the expanded instances from loadRefactoringFixture
+	// but reuse the helper function anyway.
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	stmts := refactoring.FindImportStatements(rootCfg)
+
+	var got []string
+	for _, stmt := range stmts {
+		got = append(got, fmt.Sprintf("%s in %q: %s", stmt.AbsToResource, stmt.ContainingModule, stmt.Import.DeclRange))
+	}
+
+	want := []string{
+		`test_resource.foo in "": testdata/import-statements/main.tf:5,1-7`,
+		`test_resource.foo in "": testdata/import-statements/main.tf:10,1-7`,
+		`module.child.test_resource.bar in "": testdata/import-statements/main.tf:20,1-7`,
+		`module.child.test_resource.baz in "": testdata/import-statements/main.tf:27,1-7`,
+		`module.child.test_resource.bar in "module.child": testdata/import-statements/child/main.tf:10,1-7`,
+	}
+
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong import statements\n%s", diff)
+	}
+}
