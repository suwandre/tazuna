+// Multiple import blocks with static addresses may each target a different
+// instance of the same expanded resource, and all of them must be honored.
+func TestContext2Plan_importMultipleBlocksSameResource(t *testing.T) {
+	m := testModuleInline(t, map[string]string{
+		"main.tf": `
+resource "test_object" "a" {
+  for_each    = toset(["first", "second", "third"])
+  test_string = "foo"
+}
+
+resource "test_object" "b" {
+  count       = 2
+  test_string = "foo"
+}
+
+resource "test_object" "c" {
+  test_string = "foo"
+}
+
+import {
+  to = test_object.a["second"]
+  id = "a_second_id"
+}
+
+import {
+  to = test_object.a["first"]
+  id = "a_first_id"
+}
+
+import {
+  to = test_object.a["third"]
+  id = "a_third_id"
+}
+
+import {
+  to = test_object.b[0]
+  id = "b_0_id"
+}
+
+import {
+  to = test_object.b[1]
+  id = "b_1_id"
+}
+
+import {
+  to = test_object.c
+  id = "c_id"
+}
+`,
+	})
+
+	p := simpleMockProvider()
+	ctx := testContext2(t, &ContextOpts{
+		Providers: map[addrs.Provider]providers.Factory{
+			addrs.NewDefaultProvider("test"): testProviderFuncFixed(p),
+		},
+	})
+	p.ReadResourceResponse = &providers.ReadResourceResponse{
+		NewState: cty.ObjectVal(map[string]cty.Value{
+			"test_string": cty.StringVal("foo"),
+		}),
+	}
+	p.ImportResourceStateResponse = &providers.ImportResourceStateResponse{
+		ImportedResources: []providers.ImportedResource{
+			{
+				TypeName: "test_object",
+				State: cty.ObjectVal(map[string]cty.Value{
+					"test_string": cty.StringVal("foo"),
+				}),
+			},
+		},
+	}
+
+	diags := ctx.Validate(m, &ValidateOpts{})
+	tfdiags.AssertNoDiagnostics(t, diags)
+
+	plan, diags := ctx.Plan(m, states.NewState(), DefaultPlanOpts)
+	tfdiags.AssertNoDiagnostics(t, diags)
+
+	want := map[string]string{
+		`test_object.a["first"]`:  "a_first_id",
+		`test_object.a["second"]`: "a_second_id",
+		`test_object.a["third"]`:  "a_third_id",
+		`test_object.b[0]`:        "b_0_id",
+		`test_object.b[1]`:        "b_1_id",
+		`test_object.c`:           "c_id",
+	}
+
+	if got := len(plan.Changes.Resources); got != len(want) {
+		t.Errorf("wrong number of resource changes: got %d, want %d", got, len(want))
+	}
+
+	for addr, wantID := range want {
+		instPlan := plan.Changes.ResourceInstance(mustResourceInstanceAddr(addr))
+		if instPlan == nil {
+			t.Errorf("no plan for %s", addr)
+			continue
+		}
+		if instPlan.Importing == nil {
+			t.Errorf("%s: expected import of %q, got %s", addr, wantID, instPlan.Action)
+			continue
+		}
+		if instPlan.Importing.ID != wantID {
+			t.Errorf("%s: wrong import ID\ngot:  %s\nwant: %s", addr, instPlan.Importing.ID, wantID)
+		}
+		if got, want := instPlan.Action, plans.NoOp; got != want {
+			t.Errorf("%s: wrong planned action\ngot:  %s\nwant: %s", addr, got, want)
+		}
+	}
+}
