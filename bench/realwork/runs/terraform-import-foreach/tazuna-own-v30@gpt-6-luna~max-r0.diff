+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/configs"
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	resource := addrs.Resource{
+		Mode: addrs.ManagedResourceMode,
+		Type: "test_resource",
+		Name: "foo",
+	}
+
+	parentTarget := addrs.ConfigResource{
+		Module:   addrs.Module{"child"},
+		Resource: resource,
+	}
+	parentImportA := &configs.Import{ToResource: parentTarget}
+	parentImportB := &configs.Import{ToResource: parentTarget}
+	childImport := &configs.Import{
+		ToResource: addrs.ConfigResource{Resource: resource},
+	}
+
+	childCfg := &configs.Config{
+		Path: addrs.Module{"child"},
+		Module: &configs.Module{
+			Import: []*configs.Import{childImport},
+		},
+	}
+	rootCfg := &configs.Config{
+		Path: addrs.RootModule,
+		Children: map[string]*configs.Config{
+			"child": childCfg,
+		},
+		Module: &configs.Module{
+			Import: []*configs.Import{parentImportA, parentImportB},
+		},
+	}
+
+	got := refactoring.FindImportStatements(rootCfg)
+	if len(got) != 2 {
+		t.Fatalf("wrong number of import statements: got %d, want 2", len(got))
+	}
+
+	gotImports := make(map[*configs.Import]bool)
+	for _, stmt := range got {
+		if !stmt.ContainingModule.IsRoot() {
+			t.Errorf("unexpected import from module %s", stmt.ContainingModule)
+		}
+		gotImports[stmt.Import] = true
+	}
+
+	for _, want := range []*configs.Import{parentImportA, parentImportB} {
+		if !gotImports[want] {
+			t.Errorf("missing import statement %p", want)
+		}
+	}
+	if gotImports[childImport] {
+		t.Errorf("child import was not overridden by the parent")
+	}
+}
