+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements_multipleInstancesSameModule(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements/for-each")
+
+	got := refactoring.FindImportStatements(rootCfg)
+	if len(got) != 2 {
+		t.Fatalf("expected 2 import statements, got %d", len(got))
+	}
+
+	wantResource := addrs.ConfigResource{
+		Module: addrs.RootModule,
+		Resource: addrs.Resource{
+			Mode: addrs.ManagedResourceMode,
+			Type: "test_object",
+			Name: "a",
+		},
+	}
+
+	// Walk order is preserved, so the blocks come back in declaration order.
+	for i, stmt := range got {
+		if !stmt.AbsToResource.Equal(wantResource) {
+			t.Errorf("statement %d: expected target %s, got %s", i, wantResource, stmt.AbsToResource)
+		}
+		if !stmt.ContainingModule.IsRoot() {
+			t.Errorf("statement %d: expected containing module to be root, got %s", i, stmt.ContainingModule)
+		}
+		if stmt.Import != rootCfg.Module.Import[i] {
+			t.Errorf("statement %d: returned a different import block than declared at index %d", i, i)
+		}
+	}
+}
+
+func TestFindImportStatements_parentOverridesChild(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements/parent-overrides-child")
+
+	got := refactoring.FindImportStatements(rootCfg)
+	if len(got) != 1 {
+		t.Fatalf("expected 1 import statement, got %d", len(got))
+	}
+
+	wantResource := addrs.ConfigResource{
+		Module: addrs.Module{"child"},
+		Resource: addrs.Resource{
+			Mode: addrs.ManagedResourceMode,
+			Type: "test_object",
+			Name: "x",
+		},
+	}
+
+	stmt := got[0]
+	if !stmt.AbsToResource.Equal(wantResource) {
+		t.Errorf("expected target %s, got %s", wantResource, stmt.AbsToResource)
+	}
+	if !stmt.ContainingModule.IsRoot() {
+		t.Errorf("expected the parent's import block (root module), got containing module %s", stmt.ContainingModule)
+	}
+	if stmt.Import != rootCfg.Module.Import[0] {
+		t.Errorf("expected the parent's import block, got a different block")
+	}
+
+	// Sanity check that the child really declares an import block for the
+	// same resource, so the override is what is being exercised here.
+	childCfg := rootCfg.Children["child"]
+	if childCfg == nil || len(childCfg.Module.Import) != 1 {
+		t.Fatalf("expected child module to declare one import block")
+	}
+}
