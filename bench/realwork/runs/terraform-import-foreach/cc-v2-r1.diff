new file mode 100644
index 0000000..8577b2b
--- /dev/null
+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,43 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"sort"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	var got []string
+	for _, stmt := range refactoring.FindImportStatements(rootCfg) {
+		id, diags := stmt.Import.ID.Value(nil)
+		if diags.HasErrors() {
+			t.Fatal(diags.Error())
+		}
+		got = append(got, id.AsString())
+	}
+	sort.Strings(got)
+
+	want := []string{
+		// Multiple blocks in one module may target instances of the same
+		// resource, and all of them must be returned.
+		"root-a-x",
+		"root-a-y",
+		"other-c-x",
+		"other-c-y",
+		// The root module's block for module.child.test_object.b overrides
+		// the child module's own blocks for that resource.
+		"root-child-b-x",
+	}
+	sort.Strings(want)
+
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong import statements\n%s", diff)
+	}
+}
