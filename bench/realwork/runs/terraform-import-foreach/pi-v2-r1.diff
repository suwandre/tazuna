+func staticImportTarget(imp *configs.Import) (addrs.AbsResourceInstance, bool) {
+	if imp.To == nil || imp.ForEach != nil {
+		return addrs.AbsResourceInstance{}, false
+	}
+	traversal, hd := hcl.AbsTraversalForExpr(imp.To)
+	if hd.HasErrors() {
+		return addrs.AbsResourceInstance{}, false
+	}
+	to, diags := addrs.ParseAbsResourceInstance(traversal)
+	if diags.HasErrors() {
+		return addrs.AbsResourceInstance{}, false
+	}
+	return to, true
