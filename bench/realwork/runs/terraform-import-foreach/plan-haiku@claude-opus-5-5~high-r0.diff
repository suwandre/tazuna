+func TestContext2Plan_importForEachMultipleBlocks(t *testing.T) {
+	m := testModuleInline(t, map[string]string{
+		"main.tf": `
+resource "test_object" "a" {
+  for_each    = toset(["first", "second"])
+  test_string = "foo"
+}
+
+import {
+  to = test_object.a["first"]
+  id = "first_id"
+}
+
+import {
+  to = test_object.a["second"]
+  id = "second_id"
+}
+`,
+	})
+
+	plan := planImportMultipleBlocks(t, m)
+	checkImportMultipleBlocksPlan(t, plan, map[string]string{
+		`test_object.a["first"]`:  "first_id",
+		`test_object.a["second"]`: "second_id",
+	})
+}
+
+func TestContext2Plan_importForEachMultipleBlocksInModule(t *testing.T) {
+	m := testModuleInline(t, map[string]string{
+		"main.tf": `
+module "child" {
+  source = "./mod"
+}
+`,
+		"mod/main.tf": `
+resource "test_object" "a" {
+  for_each    = toset(["first", "second"])
+  test_string = "foo"
+}
+
+import {
+  to = test_object.a["first"]
+  id = "first_id"
+}
+
+import {
+  to = test_object.a["second"]
+  id = "second_id"
+}
+`,
+	})
+
+	plan := planImportMultipleBlocks(t, m)
+	checkImportMultipleBlocksPlan(t, plan, map[string]string{
+		`module.child.test_object.a["first"]`:  "first_id",
+		`module.child.test_object.a["second"]`: "second_id",
+	})
+}
