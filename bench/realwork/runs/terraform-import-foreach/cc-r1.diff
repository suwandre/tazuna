+// importOverridden returns true if any of the existing statements, declared in
+// a module other than the given one, already targets the given resource and
+// could target the same instance of it.
+func importOverridden(existing []ImportStatement, module addrs.Module, to addrs.ConfigResource, imp *configs.Import) bool {
+	key, keyKnown := staticImportInstanceKey(imp)
+	for _, ex := range existing {
+		if ex.ContainingModule.Equal(module) || !ex.AbsToResource.Equal(to) {
+			continue
+		}
+		exKey, exKeyKnown := staticImportInstanceKey(ex.Import)
+		if !keyKnown || !exKeyKnown || key == exKey {
+			// Either the instances are the same, or at least one of the
+			// blocks targets instances we can't determine until expansion.
+			return true
+		}
+	}
+	return false
+}
+
+// staticImportInstanceKey returns the instance key of the import block's
+// target, if the target address can be determined without evaluating
+// expressions.
+func staticImportInstanceKey(imp *configs.Import) (addrs.InstanceKey, bool) {
+	if imp.To == nil {
+		return addrs.NoKey, false
+	}
+	var diags tfdiags.Diagnostics
+	traversal, hd := hcl.AbsTraversalForExpr(imp.To)
+	diags = diags.Append(hd)
+	to, td := addrs.ParseAbsResourceInstance(traversal)
+	diags = diags.Append(td)
+	if diags.HasErrors() {
+		return addrs.NoKey, false
+	}
+	return to.Resource.Key, true
+}
