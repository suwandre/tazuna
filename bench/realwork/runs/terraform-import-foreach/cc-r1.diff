@@ -0,0 +1,54 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/hashicorp/hcl/v2"
+
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	stmts := refactoring.FindImportStatements(rootCfg)
+
+	// Every instance of a resource may be targeted by its own import block,
+	// but a block in a parent module overrides a block in a child module that
+	// targets the same instance.
+	want := map[string]string{
+		`test_resource.foo["a"]`:              "root-a",
+		`test_resource.foo["b"]`:              "root-b",
+		`module.child.test_resource.bar["x"]`: "root-x",
+		`module.child.test_resource.bar["y"]`: "child-y",
+	}
+
+	got := make(map[string]string)
+	for _, stmt := range stmts {
+		traversal, diags := hcl.AbsTraversalForExpr(stmt.Import.To)
+		if diags.HasErrors() {
+			t.Fatal(diags.Error())
+		}
+		to, tDiags := addrs.ParseAbsResourceInstance(traversal)
+		if tDiags.HasErrors() {
+			t.Fatal(tDiags.Err())
+		}
+		// the To address is relative to the module containing the block
+		to.Module = append(stmt.ContainingModule.UnkeyedInstanceShim(), to.Module...)
+
+		id, diags := stmt.Import.ID.Value(nil)
+		if diags.HasErrors() {
+			t.Fatal(diags.Error())
+		}
+		got[to.String()] = id.AsString()
+	}
+
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong import statements\n%s", diff)
+	}
+}
