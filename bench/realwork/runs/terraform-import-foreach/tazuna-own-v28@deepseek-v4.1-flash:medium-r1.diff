@@ -0,0 +1,65 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	mustConfigResource := func(module addrs.Module, name string) addrs.ConfigResource {
+		return addrs.ConfigResource{
+			Module: module,
+			Resource: addrs.Resource{
+				Mode: addrs.ManagedResourceMode,
+				Type: "test_resource",
+				Name: name,
+			},
+		}
+	}
+
+	// We only compare the addresses and containing modules here; the Import
+	// blocks themselves contain hcl expressions that aren't comparable.
+	type summary struct {
+		To       addrs.ConfigResource
+		Module   addrs.Module
+		ImportID string
+	}
+
+	gotStatements := refactoring.FindImportStatements(rootCfg)
+	got := make([]summary, 0, len(gotStatements))
+	for _, stmt := range gotStatements {
+		id, _ := stmt.Import.ID.Value(nil)
+		got = append(got, summary{
+			To:       stmt.AbsToResource,
+			Module:   stmt.ContainingModule,
+			ImportID: id.AsString(),
+		})
+	}
+
+	want := []summary{
+		{To: mustConfigResource(nil, "multi"), Module: nil, ImportID: "first_id"},
+		{To: mustConfigResource(nil, "multi"), Module: nil, ImportID: "second_id"},
+		{To: mustConfigResource(nil, "single"), Module: nil, ImportID: "single_id"},
+		// The parent module's import block overrides the child's.
+		{To: mustConfigResource(addrs.Module{"child"}, "overridden"), Module: nil, ImportID: "child_id"},
+		// The child-only import block survives.
+		{To: mustConfigResource(addrs.Module{"child"}, "child_only"), Module: addrs.Module{"child"}, ImportID: "child_only_id"},
+		// Distinct instances of the same resource in the child module are not
+		// overridden by the parent module's blocks targeting other instances.
+		{To: mustConfigResource(addrs.Module{"child"}, "multi"), Module: addrs.Module{"child"}, ImportID: "child_first_id"},
+		{To: mustConfigResource(addrs.Module{"child"}, "multi"), Module: addrs.Module{"child"}, ImportID: "child_second_id"},
+	}
+
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong import statements\n%s", diff)
+	}
+}
