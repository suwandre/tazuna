+// findImportStatement locates an already-recorded statement that targets the
+// same object as the given candidate.
+func findImportStatement(into []ImportStatement, candidate ImportStatement) (ImportStatement, bool) {
+	candidateTarget := candidate.target()
+	for _, stmt := range into {
+		if stmt.target() == candidateTarget {
+			return stmt, true
+		}
+	}
+	return ImportStatement{}, false
+}
+
+// target returns a string that uniquely identifies the object an import
+// statement targets. It uses the statically-parseable instance address when
+// available so that distinct instances of the same resource are distinguished,
+// and falls back to the un-keyed resource address for dynamic targets.
+func (s ImportStatement) target() string {
+	if to, ok := configs.ParseImportToStatic(s.Import.To); ok {
+		// to.Module is an instance address relative to the module the import
+		// block was declared in, so we prefix the (static) containing module
+		// path to form a fully-qualified address. The instance keys within
+		// to.Module are preserved so that, for example, module.foo["a"] and
+		// module.foo["b"] remain distinct.
+		module := append(s.ContainingModule.UnkeyedInstanceShim(), to.Module...)
+		return module.String() + " " + to.Resource.String()
+	}
+	return s.AbsToResource.String()
+}
