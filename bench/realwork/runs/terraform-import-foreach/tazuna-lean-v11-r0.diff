@@ -0,0 +1,36 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"sort"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	cfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	var got []string
+	for _, stmt := range refactoring.FindImportStatements(cfg) {
+		got = append(got, stmt.AbsToResource.String()+" in "+stmt.ContainingModule.String()+" from "+stmt.Import.To.Range().Filename)
+	}
+	sort.Strings(got)
+
+	// Multiple blocks for the same for_each resource in one module must all
+	// be kept, while a block in a parent module overrides blocks in a child
+	// module targeting the same resource (module.child.test_object.x).
+	want := []string{
+		"module.child.test_object.x in  from testdata/import-statements/main.tf",
+		"module.child.test_object.y in module.child from testdata/import-statements/child/main.tf",
+		"test_object.a in  from testdata/import-statements/main.tf",
+		"test_object.a in  from testdata/import-statements/main.tf",
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong result\n%s", diff)
+	}
+}
