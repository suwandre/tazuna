diff --git a/internal/refactoring/import_statement_test.go b/internal/refactoring/import_statement_test.go
new file mode 100644
index 0000000..5178ce2
--- /dev/null
+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,65 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"sort"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/hashicorp/hcl/v2"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	var got []string
+	for _, stmt := range refactoring.FindImportStatements(rootCfg) {
+		traversal, diags := hcl.AbsTraversalForExpr(stmt.Import.To)
+		if diags.HasErrors() {
+			t.Fatal(diags.Error())
+		}
+		to := stmt.ContainingModule.String() + ":" + traversalString(traversal)
+		got = append(got, to)
+	}
+	sort.Strings(got)
+
+	want := []string{
+		// All blocks targeting distinct instances of the same resource in
+		// the same module are kept.
+		":test_object.a[\"x\"]",
+		":test_object.a[\"y\"]",
+		// The root module's block overrides the child module's blocks for
+		// test_object.b.
+		":module.child.test_object.b[0]",
+		"module.child:test_object.c[0]",
+		"module.child:test_object.c[1]",
+	}
+	sort.Strings(want)
+
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong import statements\n%s", diff)
+	}
+}
+
+func traversalString(traversal hcl.Traversal) string {
+	var ret string
+	for _, step := range traversal {
+		switch s := step.(type) {
+		case hcl.TraverseRoot:
+			ret += s.Name
+		case hcl.TraverseAttr:
+			ret += "." + s.Name
+		case hcl.TraverseIndex:
+			if s.Key.Type().FriendlyName() == "string" {
+				ret += "[\"" + s.Key.AsString() + "\"]"
+			} else {
+				ret += "[" + s.Key.AsBigFloat().String() + "]"
+			}
+		}
+	}
+	return ret
+}
