@@ -0,0 +1,48 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	type result struct {
+		Resource string
+		Module   string
+		ID       string
+	}
+	var got []result
+	for _, stmt := range refactoring.FindImportStatements(rootCfg) {
+		id, diags := stmt.Import.ID.Value(nil)
+		if diags.HasErrors() {
+			t.Fatalf("unexpected error evaluating id: %s", diags.Error())
+		}
+		got = append(got, result{
+			Resource: stmt.AbsToResource.String(),
+			Module:   stmt.ContainingModule.String(),
+			ID:       id.AsString(),
+		})
+	}
+
+	// Multiple blocks targeting instances of the same resource within one
+	// module are all kept, while the root module's block for module.child's
+	// test_object.b replaces the child module's own block.
+	want := []result{
+		{Resource: "test_object.a", Module: "", ID: "root-x"},
+		{Resource: "test_object.a", Module: "", ID: "root-y"},
+		{Resource: "module.child.test_object.b", Module: "", ID: "root-z"},
+		{Resource: "module.child.test_object.c", Module: "module.child", ID: "child-p"},
+		{Resource: "module.child.test_object.c", Module: "module.child", ID: "child-q"},
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong result\n%s", diff)
+	}
+}
