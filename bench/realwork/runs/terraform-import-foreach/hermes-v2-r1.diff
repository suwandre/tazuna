+module "child" {
+  source = "./child"
+}
+
+resource "test_object" "a" {
+  for_each = { x = 1, y = 2 }
+}
+
+import {
+  to = test_object.a["x"]
+  id = "id-x"
+}
+
+import {
+  to = test_object.a["y"]
+  id = "id-y"
+}
+
+# Overrides the import blocks declared inside the child module.
+import {
+  to = module.child.test_object.b
+  id = "from-parent"
+}
