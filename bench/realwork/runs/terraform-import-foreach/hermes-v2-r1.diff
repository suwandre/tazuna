diff --git a/internal/terraform/context_plan_import_test.go b/internal/terraform/context_plan_import_test.go
index cce43fa..5dd47d7 100644
--- a/internal/terraform/context_plan_import_test.go
+++ b/internal/terraform/context_plan_import_test.go
@@ -2559,3 +2559,75 @@ import {
 		Mode: plans.NormalMode,
 	})
 }
+
+// Multiple import blocks targeting different instances of the same for_each
+// resource must all be honored.
+func TestContext2Plan_importMultipleBlocksForEachResource(t *testing.T) {
+	m := testModuleInline(t, map[string]string{
+		"main.tf": `
+resource "test_object" "a" {
+  for_each    = toset(["x", "y", "z"])
+  test_string = "foo"
+}
+
+import {
+  to = test_object.a["x"]
+  id = "id-x"
+}
+
+import {
+  to = test_object.a["y"]
+  id = "id-y"
+}
+
+import {
+  to = test_object.a["z"]
+  id = "id-z"
+}
+`,
+	})
+
+	p := simpleMockProvider()
+	ctx := testContext2(t, &ContextOpts{
+		Providers: map[addrs.Provider]providers.Factory{
+			addrs.NewDefaultProvider("test"): testProviderFuncFixed(p),
+		},
+	})
+	p.ReadResourceResponse = &providers.ReadResourceResponse{
+		NewState: cty.ObjectVal(map[string]cty.Value{
+			"test_string": cty.StringVal("foo"),
+		}),
+	}
+	p.ImportResourceStateResponse = &providers.ImportResourceStateResponse{
+		ImportedResources: []providers.ImportedResource{
+			{
+				TypeName: "test_object",
+				State: cty.ObjectVal(map[string]cty.Value{
+					"test_string": cty.StringVal("foo"),
+				}),
+			},
+		},
+	}
+
+	plan, diags := ctx.Plan(m, states.NewState(), DefaultPlanOpts)
+	if diags.HasErrors() {
+		t.Fatalf("unexpected errors\n%s", diags.Err().Error())
+	}
+
+	for _, key := range []string{"x", "y", "z"} {
+		addr := mustResourceInstanceAddr(`test_object.a["` + key + `"]`)
+		instPlan := plan.Changes.ResourceInstance(addr)
+		if instPlan == nil {
+			t.Fatalf("no plan for %s at all", addr)
+		}
+		if instPlan.Action == plans.Create {
+			t.Errorf("%s is planned for creation; its import block was dropped", addr)
+		}
+		if instPlan.Importing == nil {
+			t.Fatalf("%s is not being imported", addr)
+		}
+		if got, want := instPlan.Importing.ID, "id-"+key; got != want {
+			t.Errorf("wrong import ID for %s\ngot:  %s\nwant: %s", addr, got, want)
+		}
+	}
+}
