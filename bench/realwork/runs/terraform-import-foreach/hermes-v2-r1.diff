diff --git a/internal/refactoring/import_statement_test.go b/internal/refactoring/import_statement_test.go
new file mode 100644
index 0000000..bed0496
--- /dev/null
+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,51 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/hashicorp/terraform/internal/configs"
+	"github.com/hashicorp/terraform/internal/refactoring"
+	"github.com/zclconf/go-cty/cty"
+)
+
+func TestFindImportStatements_multiplePerResource(t *testing.T) {
+	cfg, _ := loadRefactoringFixture(t, "testdata/import-multiple")
+
+	stmts := refactoring.FindImportStatements(cfg)
+
+	got := map[string]bool{}
+	for _, s := range stmts {
+		got[s.AbsToResource.String()+" "+importIDLiteral(t, s.Import)] = true
+	}
+
+	want := []string{
+		`test_object.a id-x`,
+		`test_object.a id-y`,
+		`module.child.test_object.b from-parent`,
+		`module.child.test_object.c id-p`,
+		`module.child.test_object.c id-q`,
+	}
+	if len(stmts) != len(want) {
+		t.Errorf("wrong number of statements: got %d, want %d\n%v", len(stmts), len(want), got)
+	}
+	for _, w := range want {
+		if !got[w] {
+			t.Errorf("missing import statement %q\ngot: %v", w, got)
+		}
+	}
+}
+
+func importIDLiteral(t *testing.T, imp *configs.Import) string {
+	t.Helper()
+	v, diags := imp.ID.Value(nil)
+	if diags.HasErrors() {
+		t.Fatal(diags.Error())
+	}
+	if v.Type() != cty.String {
+		t.Fatalf("unexpected id type %#v", v.Type())
+	}
+	return v.AsString()
+}
