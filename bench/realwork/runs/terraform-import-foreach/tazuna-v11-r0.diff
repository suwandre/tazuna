+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,34 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	cfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	stmts := refactoring.FindImportStatements(cfg)
+
+	var got []string
+	for _, stmt := range stmts {
+		got = append(got, stmt.ContainingModule.String()+" -> "+stmt.AbsToResource.String())
+	}
+	want := []string{
+		" -> test_thing.foo",
+		" -> test_thing.foo",
+		" -> module.child.test_thing.bar",
+	}
+	if len(got) != len(want) {
+		t.Fatalf("wrong statements\ngot:  %#v\nwant: %#v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Errorf("wrong statement %d\ngot:  %s\nwant: %s", i, got[i], want[i])
+		}
+	}
+}
