diff --git a/internal/refactoring/import_statement_test.go b/internal/refactoring/import_statement_test.go
new file mode 100644
index 0000000..80259e3
--- /dev/null
+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,40 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	// Report each statement as "<containing module> <config resource> <id>",
+	// using the id to tell apart blocks that target the same resource.
+	var got []string
+	for _, stmt := range refactoring.FindImportStatements(rootCfg) {
+		idVal, diags := stmt.Import.ID.Value(nil)
+		if diags.HasErrors() {
+			t.Fatalf("unexpected error evaluating id: %s", diags.Error())
+		}
+		got = append(got, stmt.ContainingModule.String()+" "+stmt.AbsToResource.String()+" "+idVal.AsString())
+	}
+
+	want := []string{
+		" test_resource.multi a",
+		" test_resource.multi b",
+		" module.child.test_resource.overridden parent",
+		// The child's blocks for "overridden" are dropped in favor of the
+		// parent's, but its blocks for its own resource are all kept.
+		"module.child module.child.test_resource.own own-x",
+		"module.child module.child.test_resource.own own-y",
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong import statements\n%s", diff)
+	}
+}
