+// Multiple import blocks may target different instances of the same for_each
+// resource; all of them must be honored.
+func TestContext2Plan_importMultipleBlocksForEachResource(t *testing.T) {
+	m := testModuleInline(t, map[string]string{
+		"main.tf": `
+resource "test_object" "a" {
+  for_each    = toset(["first", "second", "third"])
+  test_string = "foo"
+}
+
+import {
+  to = test_object.a["first"]
+  id = "first_id"
+}
+
+import {
+  to = test_object.a["second"]
+  id = "second_id"
+}
+
+import {
+  to = test_object.a["third"]
+  id = "third_id"
+}
+`,
+	})
+
+	p := simpleMockProvider()
+	ctx := testContext2(t, &ContextOpts{
+		Providers: map[addrs.Provider]providers.Factory{
+			addrs.NewDefaultProvider("test"): testProviderFuncFixed(p),
+		},
+	})
+	p.ReadResourceResponse = &providers.ReadResourceResponse{
+		NewState: cty.ObjectVal(map[string]cty.Value{
+			"test_string": cty.StringVal("foo"),
+		}),
+	}
+	p.ImportResourceStateResponse = &providers.ImportResourceStateResponse{
+		ImportedResources: []providers.ImportedResource{
+			{
+				TypeName: "test_object",
+				State: cty.ObjectVal(map[string]cty.Value{
+					"test_string": cty.StringVal("foo"),
+				}),
+			},
+		},
+	}
+
+	plan, diags := ctx.Plan(m, states.NewState(), DefaultPlanOpts)
+	if diags.HasErrors() {
+		t.Fatalf("unexpected errors\n%s", diags.Err().Error())
+	}
+
+	want := map[string]string{
+		`test_object.a["first"]`:  "first_id",
+		`test_object.a["second"]`: "second_id",
+		`test_object.a["third"]`:  "third_id",
+	}
+	if got := len(plan.Changes.Resources); got != len(want) {
+		t.Fatalf("wrong number of changes: got %d, want %d", got, len(want))
+	}
+	for _, instPlan := range plan.Changes.Resources {
+		wantID, ok := want[instPlan.Addr.String()]
+		if !ok {
+			t.Errorf("unexpected change for %s", instPlan.Addr)
+			continue
+		}
+		if instPlan.Importing == nil {
+			t.Errorf("%s is not being imported (action %s)", instPlan.Addr, instPlan.Action)
+			continue
+		}
+		if instPlan.Importing.ID != wantID {
+			t.Errorf("%s: wrong import ID: got %q, want %q", instPlan.Addr, instPlan.Importing.ID, wantID)
+		}
+		if got, want := instPlan.Action, plans.NoOp; got != want {
+			t.Errorf("%s: wrong action: got %s, want %s", instPlan.Addr, got, want)
+		}
+	}
+}
