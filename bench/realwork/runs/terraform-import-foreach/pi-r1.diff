diff --git a/internal/refactoring/import_statement_test.go b/internal/refactoring/import_statement_test.go
new file mode 100644
index 0000000..2927d2e
--- /dev/null
+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,50 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	stmts := refactoring.FindImportStatements(rootCfg)
+	if got, want := len(stmts), 3; got != want {
+		t.Fatalf("wrong number of import statements %d; want %d", got, want)
+	}
+
+	each := addrs.ConfigResource{
+		Module:   addrs.RootModule,
+		Resource: addrs.Resource{Mode: addrs.ManagedResourceMode, Type: "test_resource", Name: "each"},
+	}
+	overridden := addrs.ConfigResource{
+		Module:   addrs.Module{"child"},
+		Resource: addrs.Resource{Mode: addrs.ManagedResourceMode, Type: "test_resource", Name: "overridden"},
+	}
+
+	var eachCount, overriddenCount int
+	for _, stmt := range stmts {
+		switch {
+		case stmt.AbsToResource.Equal(each):
+			eachCount++
+		case stmt.AbsToResource.Equal(overridden):
+			overriddenCount++
+			if !stmt.ContainingModule.IsRoot() {
+				t.Errorf("import block from child module should have been overridden by the parent")
+			}
+		default:
+			t.Errorf("unexpected import statement for %s", stmt.AbsToResource)
+		}
+	}
+	if eachCount != 2 {
+		t.Errorf("wrong number of import statements for %s: %d; want 2", each, eachCount)
+	}
+	if overriddenCount != 1 {
+		t.Errorf("wrong number of import statements for %s: %d; want 1", overridden, overriddenCount)
+	}
+}
