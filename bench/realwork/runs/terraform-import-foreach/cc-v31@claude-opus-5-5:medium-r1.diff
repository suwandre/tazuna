@@ -0,0 +1,51 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	// LAZY: We don't need the expanded instances from loadRefactoringFixture
+	// but reuse the helper function anyway.
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	type stmt struct {
+		To     string
+		Module string
+		ID     string
+	}
+
+	var got []stmt
+	for _, s := range refactoring.FindImportStatements(rootCfg) {
+		id, diags := s.Import.ID.Value(nil)
+		if diags.HasErrors() {
+			t.Fatal(diags.Error())
+		}
+		got = append(got, stmt{
+			To:     s.AbsToResource.String(),
+			Module: s.ContainingModule.String(),
+			ID:     id.AsString(),
+		})
+	}
+
+	want := []stmt{
+		{To: "test_resource.each", Module: "", ID: "a"},
+		{To: "test_resource.each", Module: "", ID: "b"},
+		{To: "test_resource.single", Module: "", ID: "single"},
+		{To: "module.child.test_resource.counted", Module: "", ID: "parent-0"},
+		// The child's blocks for test_resource.counted are overridden by the
+		// root module's block.
+		{To: "module.child.test_resource.child_only", Module: "module.child", ID: "child-only"},
+	}
+
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong result\n%s", diff)
+	}
+}
