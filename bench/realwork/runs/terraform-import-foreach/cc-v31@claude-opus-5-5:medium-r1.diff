+module "child" {
+  source = "./child"
+}
+
+resource "test_resource" "each" {
+  for_each = { a = "a", b = "b" }
+}
+
+resource "test_resource" "single" {}
+
+# Multiple import blocks in the same module targeting different instances of
+# the same resource must all be kept.
+import {
+  to = test_resource.each["a"]
+  id = "a"
+}
+
+import {
+  to = test_resource.each["b"]
+  id = "b"
+}
+
+import {
+  to = test_resource.single
+  id = "single"
+}
+
+# This overrides the import blocks in the child module targeting the same
+# resource.
+import {
+  to = module.child.test_resource.counted[0]
+  id = "parent-0"
+}
