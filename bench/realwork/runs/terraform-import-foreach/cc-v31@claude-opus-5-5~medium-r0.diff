@@ -0,0 +1,79 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	// LAZY: We don't need the expanded instances from loadRefactoringFixture
+	// but reuse the helper function anyway.
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	stmts := refactoring.FindImportStatements(rootCfg)
+
+	type result struct {
+		AbsToResource    string
+		ContainingModule string
+		To               string
+	}
+	var got []result
+	for _, stmt := range stmts {
+		got = append(got, result{
+			AbsToResource:    stmt.AbsToResource.String(),
+			ContainingModule: stmt.ContainingModule.String(),
+			To:               stmt.Import.ToResource.String(),
+		})
+	}
+
+	want := []result{
+		// Multiple import blocks targeting instances of the same resource in
+		// the same module must all be retained.
+		{
+			AbsToResource:    "test_resource.a",
+			ContainingModule: "",
+			To:               "test_resource.a",
+		},
+		{
+			AbsToResource:    "test_resource.a",
+			ContainingModule: "",
+			To:               "test_resource.a",
+		},
+		// The root module import block overrides the child module's import
+		// block for the same resource.
+		{
+			AbsToResource:    "module.child.test_resource.b",
+			ContainingModule: "",
+			To:               "module.child.test_resource.b",
+		},
+		{
+			AbsToResource:    "module.child.test_resource.c",
+			ContainingModule: "module.child",
+			To:               "test_resource.c",
+		},
+		{
+			AbsToResource:    "module.child.test_resource.c",
+			ContainingModule: "module.child",
+			To:               "test_resource.c",
+		},
+	}
+
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong result\n%s", diff)
+	}
+
+	// Make sure the distinct import blocks were retained, rather than the
+	// same one twice.
+	if stmts[0].Import == stmts[1].Import {
+		t.Errorf("import blocks for test_resource.a were not distinct")
+	}
+	if stmts[3].Import == stmts[4].Import {
+		t.Errorf("import blocks for module.child.test_resource.c were not distinct")
+	}
+}
