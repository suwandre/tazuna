diff --git a/internal/refactoring/testdata/import-statements/main.tf b/internal/refactoring/testdata/import-statements/main.tf
new file mode 100644
index 0000000..ac3d170
--- /dev/null
+++ b/internal/refactoring/testdata/import-statements/main.tf
@@ -0,0 +1,29 @@
+resource "test_resource" "foo" {
+  for_each = {
+    a = "a"
+    b = "b"
+  }
+}
+
+# Both of these target the same configuration resource but different
+# instances, so both must be honored.
+import {
+  to = test_resource.foo["a"]
+  id = "a"
+}
+
+import {
+  to = test_resource.foo["b"]
+  id = "b"
+}
+
+# This import block targets a resource in the child module, and so overrides
+# the child module's own import block for that same resource.
+import {
+  to = module.child.test_resource.bar
+  id = "parent"
+}
+
+module "child" {
+  source = "./child"
+}
