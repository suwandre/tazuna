@@ -0,0 +1,85 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"sort"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	// LAZY: We don't need the expanded instances from loadRefactoringFixture
+	// but reuse the helper function anyway.
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	configResourceFoo := addrs.ConfigResource{
+		Module: addrs.RootModule,
+		Resource: addrs.Resource{
+			Mode: addrs.ManagedResourceMode,
+			Type: "test_resource",
+			Name: "foo",
+		},
+	}
+
+	configResourceBar := addrs.ConfigResource{
+		Module: addrs.Module{"child"},
+		Resource: addrs.Resource{
+			Mode: addrs.ManagedResourceMode,
+			Type: "test_resource",
+			Name: "bar",
+		},
+	}
+
+	stmts := refactoring.FindImportStatements(rootCfg)
+
+	// Two import blocks in the root module target different instances of the
+	// same resource, so both must be returned. The third is the root module's
+	// import block for a resource in a child module, which overrides the
+	// child module's own import block for that resource.
+	if got, want := len(stmts), 3; got != want {
+		t.Fatalf("wrong number of import statements\ngot:  %d\nwant: %d", got, want)
+	}
+
+	var fooIDs []string
+	var barStmt *refactoring.ImportStatement
+	for i, stmt := range stmts {
+		val, diags := stmt.Import.ID.Value(nil)
+		if diags.HasErrors() {
+			t.Fatalf("invalid import ID: %s", diags.Error())
+		}
+		id := val.AsString()
+
+		switch {
+		case stmt.AbsToResource.Equal(configResourceFoo):
+			if got, want := stmt.ContainingModule, addrs.RootModule; !got.Equal(want) {
+				t.Errorf("wrong containing module for %s\ngot:  %s\nwant: %s", stmt.AbsToResource, got, want)
+			}
+			fooIDs = append(fooIDs, id)
+		case stmt.AbsToResource.Equal(configResourceBar):
+			barStmt = &stmts[i]
+			if got, want := id, "parent"; got != want {
+				t.Errorf("wrong import ID for %s\ngot:  %s\nwant: %s", stmt.AbsToResource, got, want)
+			}
+			if got, want := stmt.ContainingModule, addrs.RootModule; !got.Equal(want) {
+				t.Errorf("wrong containing module for %s\ngot:  %s\nwant: %s", stmt.AbsToResource, got, want)
+			}
+		default:
+			t.Errorf("unexpected import statement for %s in %s", stmt.AbsToResource, stmt.ContainingModule)
+		}
+	}
+
+	sort.Strings(fooIDs)
+	if diff := cmp.Diff([]string{"a", "b"}, fooIDs); diff != "" {
+		t.Errorf("wrong import IDs for %s\n%s", configResourceFoo, diff)
+	}
+
+	if barStmt == nil {
+		t.Fatalf("missing import statement for %s", configResourceBar)
+	}
+}
