@@ -0,0 +1,59 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	got := refactoring.FindImportStatements(rootCfg)
+
+	// We identify each surviving import statement by the literal ID from its
+	// configuration, and check which module declared it. This lets us verify
+	// both that multiple import blocks targeting distinct instances of an
+	// expanded resource are retained, and that a parent module import block
+	// overrides one declared in a child module.
+	type wantStatement struct {
+		id     string
+		module addrs.Module
+	}
+	want := []wantStatement{
+		{id: "each-a", module: addrs.RootModule},
+		{id: "each-b", module: addrs.RootModule},
+		{id: "counted-0", module: addrs.RootModule},
+		{id: "counted-1", module: addrs.RootModule},
+		{id: "child-baz", module: addrs.Module{"child"}},
+		{id: "parent", module: addrs.RootModule},
+	}
+
+	if len(got) != len(want) {
+		t.Fatalf("wrong number of import statements\ngot:  %d\nwant: %d", len(got), len(want))
+	}
+
+	gotByID := make(map[string]refactoring.ImportStatement, len(got))
+	for _, stmt := range got {
+		idVal, diags := stmt.Import.ID.Value(nil)
+		if diags.HasErrors() {
+			t.Fatalf("failed to evaluate import ID: %s", diags.Error())
+		}
+		gotByID[idVal.AsString()] = stmt
+	}
+
+	for _, w := range want {
+		stmt, ok := gotByID[w.id]
+		if !ok {
+			t.Errorf("missing import statement with id %q", w.id)
+			continue
+		}
+		if !stmt.ContainingModule.Equal(w.module) {
+			t.Errorf("wrong containing module for import id %q\ngot:  %s\nwant: %s", w.id, stmt.ContainingModule, w.module)
+		}
+	}
+}
