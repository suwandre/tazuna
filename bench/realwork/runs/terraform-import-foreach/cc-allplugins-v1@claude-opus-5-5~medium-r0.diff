diff --git a/internal/refactoring/import_statement_test.go b/internal/refactoring/import_statement_test.go
new file mode 100644
index 0000000..f6fb947
--- /dev/null
+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,77 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/hashicorp/hcl/v2"
+
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	got := refactoring.FindImportStatements(rootCfg)
+
+	// want maps each target resource to the import "to" expressions, in
+	// declaration order, of the import blocks that should be kept for it.
+	want := map[string][]string{
+		// multiple blocks in the same module are all kept
+		`test_object.fe`: {`test_object.fe["a"]`, `test_object.fe["b"]`},
+		// blocks in the child module are kept when no ancestor targets the
+		// same resource
+		`module.child.test_object.fe`: {`test_object.fe["x"]`, `test_object.fe["y"]`},
+		// blocks in the root module override all blocks in the child module
+		`module.child.test_object.overridden`: {`module.child.test_object.overridden["p"]`, `module.child.test_object.overridden["q"]`},
+	}
+
+	if got.Len() != len(want) {
+		t.Errorf("wrong number of resources: got %d, want %d", got.Len(), len(want))
+	}
+
+	for addrStr, wantTos := range want {
+		addr := mustConfigResourceAddr(addrStr)
+		stmts, ok := got.GetOk(addr)
+		if !ok {
+			t.Errorf("no import statements for %s", addrStr)
+			continue
+		}
+		var gotTos []string
+		for _, stmt := range stmts {
+			if !stmt.AbsToResource.Equal(addr) {
+				t.Errorf("%s: wrong AbsToResource %s", addrStr, stmt.AbsToResource)
+			}
+			traversal, diags := hcl.AbsTraversalForExpr(stmt.Import.To)
+			if diags.HasErrors() {
+				t.Fatal(diags.Error())
+			}
+			to, tDiags := addrs.ParseAbsResourceInstance(traversal)
+			if tDiags.HasErrors() {
+				t.Fatal(tDiags.Err())
+			}
+			gotTos = append(gotTos, to.String())
+		}
+		if len(gotTos) != len(wantTos) {
+			t.Errorf("%s: wrong import targets\ngot:  %v\nwant: %v", addrStr, gotTos, wantTos)
+			continue
+		}
+		for i := range gotTos {
+			if gotTos[i] != wantTos[i] {
+				t.Errorf("%s: wrong import targets\ngot:  %v\nwant: %v", addrStr, gotTos, wantTos)
+				break
+			}
+		}
+	}
+}
+
+func mustConfigResourceAddr(s string) addrs.ConfigResource {
+	addr, diags := addrs.ParseAbsResourceStr(s)
+	if diags.HasErrors() {
+		panic(diags.Err())
+	}
+	return addr.Config()
+}
