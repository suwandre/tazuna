+// overridden reports whether any of the existing import statements for a
+// resource targets the same instance as mi.
+//
+// Targets whose instance key cannot be determined statically (for example
+// `test_object.a[var.key]`) are never considered overridden.
+func overridden(existing []ImportStatement, mi *configs.Import) bool {
+	key, ok := staticInstanceKey(mi.To)
+	if !ok {
+		return false
+	}
+	for _, e := range existing {
+		if existingKey, ok := staticInstanceKey(e.Import.To); ok && existingKey == key {
+			return true
+		}
+	}
+	return false
+}
+
+// staticInstanceKey returns the instance key of a statically-written import
+// "to" address, rendered as a string, or ok=false if the address has no static
+// form. An address without an instance key yields an empty string and ok=true.
+func staticInstanceKey(expr hcl.Expression) (key string, ok bool) {
+	if expr == nil {
+		return "", false
+	}
+	trav, hclDiags := hcl.AbsTraversalForExpr(expr)
+	if hclDiags.HasErrors() {
+		return "", false
+	}
+	addr, diags := addrs.ParseAbsResourceInstance(trav)
+	if diags.HasErrors() {
+		return "", false
+	}
+	if addr.Resource.Key == addrs.NoKey {
+		return "", true
+	}
+	return addr.Resource.Key.String(), true
+}
