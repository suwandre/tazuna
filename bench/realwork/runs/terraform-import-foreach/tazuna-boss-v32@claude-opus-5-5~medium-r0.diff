+// TestContext2Plan_importForEachMultipleBlocks checks that separate import
+// blocks targeting different instances of the same for_each resource are all
+// honored, rather than only the first one.
+func TestContext2Plan_importForEachMultipleBlocks(t *testing.T) {
+	m := testModuleInline(t, map[string]string{
+		"main.tf": `
+resource "test_object" "a" {
+  for_each = toset(["x", "y"])
+  test_string = "foo"
+}
+
+import {
+  to = test_object.a["x"]
+  id = "123"
+}
+
+import {
+  to = test_object.a["y"]
+  id = "456"
+}
+`,
+	})
+
+	p := simpleMockProvider()
+	ctx := testContext2(t, &ContextOpts{
+		Providers: map[addrs.Provider]providers.Factory{
+			addrs.NewDefaultProvider("test"): testProviderFuncFixed(p),
+		},
+	})
+	p.ReadResourceResponse = &providers.ReadResourceResponse{
+		NewState: cty.ObjectVal(map[string]cty.Value{
+			"test_string": cty.StringVal("foo"),
+		}),
+	}
+	p.ImportResourceStateResponse = &providers.ImportResourceStateResponse{
+		ImportedResources: []providers.ImportedResource{
+			{
+				TypeName: "test_object",
+				State: cty.ObjectVal(map[string]cty.Value{
+					"test_string": cty.StringVal("foo"),
+				}),
+			},
+		},
+	}
+
+	plan, diags := ctx.Plan(m, states.NewState(), DefaultPlanOpts)
+	if diags.HasErrors() {
+		t.Fatalf("unexpected errors\n%s", diags.Err().Error())
+	}
+
+	want := map[string]string{
+		`test_object.a["x"]`: "123",
+		`test_object.a["y"]`: "456",
+	}
+	got := map[string]string{}
+	for _, instPlan := range plan.Changes.Resources {
+		if instPlan.Importing == nil {
+			t.Errorf("expected %s to be imported, but it is not marked as importing", instPlan.Addr)
+			continue
+		}
+		got[instPlan.Addr.String()] = instPlan.Importing.ID
+		if action := instPlan.Action; action != plans.NoOp {
+			t.Errorf("wrong planned action for %s\ngot:  %s\nwant: %s", instPlan.Addr, action, plans.NoOp)
+		}
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong imported instances\n%s", diff)
+	}
+}
+
+// TestContext2Plan_importForEachMultipleBlocksReverseOrder is like
+// TestContext2Plan_importForEachMultipleBlocks but with three instances and
