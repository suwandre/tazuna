+func TestContextPlan_import_in_parent_and_child_module_without_config(t *testing.T) {
+	m := testModuleInline(t, map[string]string{
+		"main.tf": `
+module "child" {
+  source = "./child"
+}
+
+import {
+  to = module.child.test_object.missing
+  id = "test-a"
+}
+		`,
+		"child/main.tf": `
+import {
+  to = test_object.missing
+  id = "test-b"
+}
+		`,
+	})
+
+	ctx := testContext2(t, &ContextOpts{
+		Providers: map[addrs.Provider]providers.Factory{
+			addrs.NewDefaultProvider("test"): testProviderFuncFixed(simpleMockProvider()),
+		},
+	})
+
+	validateDiags := ctx.Validate(m, nil)
+
+	wantErr := "module.child.test_object.missing not found. Only resources within the root module are eligible for config generation."
+	if !validateDiags.HasErrors() {
+		t.Errorf("unexpected success from validate\nwant: message containing %q", wantErr)
+	} else if got, want := validateDiags.Err().Error(), wantErr; !strings.Contains(got, want) {
+		t.Errorf("wrong error from validate:\ngot:  %s\nwant: message containing %q", got, want)
+	}
+
+	_, planDiags := ctx.Plan(m, states.NewState(), &PlanOpts{
+		Mode: plans.NormalMode,
+	})
+
+	wantErr = "Configuration for import target does not exist"
+	if !planDiags.HasErrors() {
+		t.Errorf("unexpected success from plan\nwant: message containing %q", wantErr)
+	} else if got, want := planDiags.Err().Error(), wantErr; !strings.Contains(got, want) {
+		t.Errorf("wrong error from plan:\ngot:  %s\nwant: message containing %q", got, want)
+	}
+}
