diff --git a/internal/refactoring/import_statement_test.go b/internal/refactoring/import_statement_test.go
new file mode 100644
index 0000000..0346b7a
--- /dev/null
+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,130 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/configs"
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+type importStatementSummary struct {
+	AbsToResource    string
+	ContainingModule string
+	ID               string
+}
+
+func summarizeImportStatements(t *testing.T, stmts []refactoring.ImportStatement) []importStatementSummary {
+	t.Helper()
+
+	var ret []importStatementSummary
+	for _, stmt := range stmts {
+		summary := importStatementSummary{
+			AbsToResource:    stmt.AbsToResource.String(),
+			ContainingModule: stmt.ContainingModule.String(),
+		}
+		if stmt.Import.ID != nil {
+			id, diags := stmt.Import.ID.Value(nil)
+			if diags.HasErrors() {
+				t.Fatalf("invalid import id: %s", diags.Error())
+			}
+			summary.ID = id.AsString()
+		}
+		ret = append(ret, summary)
+	}
+	return ret
+}
+
+func TestFindImportStatements(t *testing.T) {
+	// LAZY: We don't need the expanded instances from loadRefactoringFixture
+	// but reuse the helper function anyway.
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	// Every import block must be returned, with those of a module before those
+	// of its descendants. Import blocks target resource instances, so it's
+	// only during planning that we can decide which of the import blocks
+	// targeting the same resource apply to each of its instances.
+	want := []importStatementSummary{
+		{
+			AbsToResource:    "test_resource.foo",
+			ContainingModule: "",
+			ID:               "a",
+		},
+		{
+			AbsToResource:    "test_resource.foo",
+			ContainingModule: "",
+			ID:               "b",
+		},
+		{
+			AbsToResource:    "module.child.test_resource.bar",
+			ContainingModule: "",
+			ID:               "parent",
+		},
+		{
+			AbsToResource:    "module.child.test_resource.bar",
+			ContainingModule: "module.child",
+			ID:               "child",
+		},
+		{
+			AbsToResource:    "module.child.module.grandchild.test_resource.baz",
+			ContainingModule: "module.child",
+			ID:               "grandchild",
+		},
+	}
+
+	got := summarizeImportStatements(t, refactoring.FindImportStatements(rootCfg))
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong result\n%s", diff)
+	}
+}
+
+func TestFindImportStatements_modulePathCapacity(t *testing.T) {
+	resourceInModule := func(module string) addrs.ConfigResource {
+		return addrs.ConfigResource{
+			Module: addrs.Module{module},
+			Resource: addrs.Resource{
+				Mode: addrs.ManagedResourceMode,
+				Type: "test_resource",
+				Name: "foo",
+			},
+		}
+	}
+
+	// The module paths of nested modules may have spare capacity, which must
+	// not lead to the addresses of import statements sharing memory.
+	childPath := make(addrs.Module, 0, 4)
+	childPath = append(childPath, "child")
+
+	rootCfg := &configs.Config{
+		Module: &configs.Module{},
+		Children: map[string]*configs.Config{
+			"child": {
+				Path: childPath,
+				Module: &configs.Module{
+					Import: []*configs.Import{
+						{ToResource: resourceInModule("first")},
+						{ToResource: resourceInModule("second")},
+					},
+				},
+			},
+		},
+	}
+
+	var got []string
+	for _, stmt := range refactoring.FindImportStatements(rootCfg) {
+		got = append(got, stmt.AbsToResource.String())
+	}
+
+	want := []string{
+		"module.child.module.first.test_resource.foo",
+		"module.child.module.second.test_resource.foo",
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong result\n%s", diff)
+	}
+}
