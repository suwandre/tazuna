diff --git a/internal/refactoring/import_statement_test.go b/internal/refactoring/import_statement_test.go
new file mode 100644
index 0000000..43cdccc
--- /dev/null
+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,36 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	cfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	var got []string
+	for _, s := range refactoring.FindImportStatements(cfg) {
+		got = append(got, s.ContainingModule.String()+"|"+s.AbsToResource.String())
+	}
+
+	// Multiple blocks targeting instances of one resource in the same module
+	// are all kept. A parent module's import block overrides the child's
+	// blocks for the same resource.
+	want := []string{
+		"|test_object.a",
+		"|test_object.a",
+		"|module.child.test_object.b",
+	}
+	if len(got) != len(want) {
+		t.Fatalf("wrong statements\ngot:  %q\nwant: %q", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("wrong statements\ngot:  %q\nwant: %q", got, want)
+		}
+	}
+}
