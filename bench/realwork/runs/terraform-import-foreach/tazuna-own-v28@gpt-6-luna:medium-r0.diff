diff --git a/internal/refactoring/import_statement_test.go b/internal/refactoring/import_statement_test.go
new file mode 100644
index 0000000..2761700
--- /dev/null
+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,28 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring
+
+import (
+	"testing"
+
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/configs"
+)
+
+func TestFindImportStatementsForEachResource(t *testing.T) {
+	cfg := &configs.Config{
+		Path: addrs.RootModule,
+		Module: &configs.Module{
+			Import: []*configs.Import{
+				{ToResource: addrs.ConfigResource{Resource: addrs.Resource{Mode: addrs.ManagedResourceMode, Type: "test", Name: "example"}}},
+				{ToResource: addrs.ConfigResource{Resource: addrs.Resource{Mode: addrs.ManagedResourceMode, Type: "test", Name: "example"}}},
+			},
+		},
+	}
+
+	got := FindImportStatements(cfg)
+	if len(got) != 2 {
+		t.Fatalf("got %d import statements, want 2", len(got))
+	}
+}
