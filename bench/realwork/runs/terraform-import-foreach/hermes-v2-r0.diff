+++ b/internal/refactoring/import_statement_test.go
@@ -0,0 +1,61 @@
+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: BUSL-1.1
+
+package refactoring_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/hashicorp/hcl/v2"
+
+	"github.com/hashicorp/terraform/internal/addrs"
+	"github.com/hashicorp/terraform/internal/refactoring"
+)
+
+func TestFindImportStatements(t *testing.T) {
+	rootCfg, _ := loadRefactoringFixture(t, "testdata/import-statements")
+
+	stmts := refactoring.FindImportStatements(rootCfg)
+
+	type result struct {
+		Resource string
+		Module   string
+		To       string
+	}
+	var got []result
+	for _, stmt := range stmts {
+		got = append(got, result{
+			Resource: stmt.AbsToResource.String(),
+			Module:   stmt.ContainingModule.String(),
+			To:       importTo(t, stmt),
+		})
+	}
+
+	want := []result{
+		{Resource: "test_resource.multi", Module: "", To: `test_resource.multi["a"]`},
+		{Resource: "test_resource.multi", Module: "", To: `test_resource.multi["b"]`},
+		{Resource: "module.child.test_resource.overridden", Module: "", To: "module.child.test_resource.overridden"},
+		{Resource: "module.child.test_resource.own", Module: "module.child", To: `test_resource.own["x"]`},
+		{Resource: "module.child.test_resource.own", Module: "module.child", To: `test_resource.own["y"]`},
+	}
+
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong result\n%s", diff)
+	}
+}
+
+// importTo returns the string form of the import block's "to" address,
+// relative to the module containing the block.
+func importTo(t *testing.T, stmt refactoring.ImportStatement) string {
+	t.Helper()
+	traversal, diags := hcl.AbsTraversalForExpr(stmt.Import.To)
+	if diags.HasErrors() {
+		t.Fatal(diags.Error())
+	}
+	addr, addrDiags := addrs.ParseAbsResourceInstance(traversal)
+	if addrDiags.HasErrors() {
+		t.Fatal(addrDiags.Err())
+	}
+	return addr.String()
+}
