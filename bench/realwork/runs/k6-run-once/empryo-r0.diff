diff --git a/internal/cmd/tests/cmd_run_once_test.go b/internal/cmd/tests/cmd_run_once_test.go
new file mode 100644
index 0000000..02a34ee
--- /dev/null
+++ b/internal/cmd/tests/cmd_run_once_test.go
@@ -0,0 +1,56 @@
+package tests
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("default function", func(t *testing.T) {
+		t.Parallel()
+		script := `export const options = {vus: 5, duration: '1h'}; export default function () {}`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "default: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	})
+
+	t.Run("single scenario keeps exec", func(t *testing.T) {
+		t.Parallel()
+		script := `
+export const options = {scenarios: {s: {executor: 'constant-vus', vus: 5, duration: '1h', exec: 'other'}}};
+export function other() {}
+`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "s: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "exec: other")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		script := `
+export const options = {scenarios: {a: {executor: 'shared-iterations'}, b: {executor: 'shared-iterations'}}};
+export default function () {}
+`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Contains(t, ts.Stderr.String()+ts.Stdout.String(), "--once can run a single scenario only")
+	})
+
+	t.Run("combined with shortcut", func(t *testing.T) {
+		t.Parallel()
+		script := `export default function () {}`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--iterations", "10"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Contains(t, ts.Stderr.String()+ts.Stdout.String(), "--once cannot be combined with --iterations")
+	})
+}
diff --git a/lib/executor/once.go b/lib/executor/once.go
new file mode 100644
index 0000000..0a1c9c9
--- /dev/null
+++ b/lib/executor/once.go
@@ -0,0 +1,45 @@
+package executor
+
+import (
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+)
+
+// ApplyOnce transforms the options so the script runs with 1 VU and 1 iteration,
+// while preserving the scenario configuration (exec, env, tags, and scenario
+// options). The executor is replaced by shared-iterations, and the shortcut
+// options (vus, iterations, duration, stages) are discarded.
+//
+// It must be applied after the configuration consolidation.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	result := opts
+
+	scenario := NewSharedIterationsConfig(lib.DefaultScenarioName)
+	switch len(opts.Scenarios) {
+	case 0:
+	case 1:
+		for _, sc := range opts.Scenarios {
+			scenario = NewSharedIterationsConfig(sc.GetName())
+			if exec := sc.GetExec(); exec != consts.DefaultFn {
+				scenario.Exec = null.StringFrom(exec)
+			}
+			scenario.Env = sc.GetEnv()
+			scenario.Tags = sc.GetTags()
+			scenario.Options = sc.GetScenarioOptions()
+		}
+	default:
+		return opts, ExecutionConflictError("--once can run a single scenario only")
+	}
+	scenario.VUs = null.IntFrom(1)
+	scenario.Iterations = null.IntFrom(1)
+
+	result.Scenarios = lib.ScenarioConfigs{scenario.GetName(): scenario}
+	result.VUs.Valid = false
+	result.Iterations.Valid = false
+	result.Duration.Valid = false
+	result.Stages = nil
+
+	return result, nil
+}
