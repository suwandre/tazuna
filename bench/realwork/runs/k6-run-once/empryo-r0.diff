@@ -0,0 +1,73 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		got, err := ApplyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages:     []lib.Stage{{Target: null.IntFrom(5)}},
+		})
+		require.NoError(t, err)
+		assert.False(t, got.VUs.Valid)
+		assert.False(t, got.Iterations.Valid)
+		assert.False(t, got.Duration.Valid)
+		assert.Nil(t, got.Stages)
+		require.Len(t, got.Scenarios, 1)
+		sc, ok := got.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		orig := NewRampingVUsConfig("browser")
+		orig.Exec = null.StringFrom("myfn")
+		orig.Env = map[string]string{"A": "b"}
+		orig.Tags = map[string]string{"t": "v"}
+		orig.StartTime = types.NullDurationFrom(5 * time.Second)
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		orig.Stages = []Stage{{Target: null.IntFrom(10), Duration: types.NullDurationFrom(time.Second)}}
+
+		got, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"browser": orig}})
+		require.NoError(t, err)
+		require.Len(t, got.Scenarios, 1)
+		sc, ok := got.Scenarios["browser"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "browser", sc.Name)
+		assert.Equal(t, sharedIterationsType, sc.Type)
+		assert.Equal(t, "myfn", sc.GetExec())
+		assert.Equal(t, orig.Env, sc.Env)
+		assert.Equal(t, orig.Tags, sc.Tags)
+		assert.Equal(t, orig.Options, sc.Options)
+		assert.Zero(t, sc.GetStartTime())
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": NewSharedIterationsConfig("a"),
+			"b": NewSharedIterationsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
