+const onceFlagName = "once"
+
+// onceFlagSet returns the flag set with the --once flag.
+func onceFlagSet() *pflag.FlagSet {
+	flags := pflag.NewFlagSet("", 0)
+	flags.SortFlags = false
+	flags.Bool(onceFlagName, false, "run the script once, with 1 VU and 1 iteration, preserving the scenario configuration")
+	return flags
+}
+
+// validateOnceFlag returns an error if --once is combined with a shortcut flag.
+func validateOnceFlag(flags *pflag.FlagSet) error {
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			return fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name)
+		}
+	}
+	return nil
+}
