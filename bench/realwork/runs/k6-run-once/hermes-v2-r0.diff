+const onceFlagName = "once"
+
+// onceFlagSet returns a FlagSet with the --once flag, which runs the script
+// with 1 VU and 1 iteration while preserving the scenario configuration.
+func onceFlagSet() *pflag.FlagSet {
+	flags := pflag.NewFlagSet("", 0)
+	flags.SortFlags = false
+	flags.Bool(onceFlagName, false,
+		"run the script once, with 1 VU and 1 iteration, preserving the scenario configuration")
+	return flags
+}
+
+// onceConflictingFlags are the execution shortcut flags that can't be used with --once.
+var onceConflictingFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// applyOnce checks whether the --once flag was set and, if so, transforms the
+// consolidated options to run a single scenario with 1 VU and 1 iteration.
+func applyOnce(flags *pflag.FlagSet, opts lib.Options) (lib.Options, error) {
+	if flags.Lookup(onceFlagName) == nil {
+		return opts, nil
+	}
+	once, err := flags.GetBool(onceFlagName)
+	if err != nil {
+		return opts, err
+	}
+	if !once {
+		return opts, nil
+	}
+
+	for _, name := range onceConflictingFlags {
+		if flags.Changed(name) {
+			return opts, fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name)
+		}
+	}
+
+	return executor.ApplyOnce(opts)
+}
+
