+package tests
+
+import (
+	"bytes"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func TestRunOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = { vus: 5, iterations: 50 };
+		export function setup() { console.log('setup-ran'); }
+		export default function () { console.log('default-ran'); }
+		export function teardown() { console.log('teardown-ran'); }
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Equal(t, 1, bytes.Count([]byte(stdout), []byte("default-ran")))
+	assert.Contains(t, stdout, "setup-ran")
+	assert.Contains(t, stdout, "teardown-ran")
+}
+
+func TestRunOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				mine: {
+					executor: 'constant-vus',
+					vus: 10,
+					duration: '1h',
+					exec: 'foo',
+					env: { MY_ENV: 'hello' },
+					tags: { mytag: 'tagvalue' },
+				},
+			},
+		};
+		export default function () { console.log('default-ran'); }
+		export function foo() { console.log('foo-ran ' + __ENV.MY_ENV); }
+	`
+	ts := getSingleFileTestState(t, script,
+		[]string{"--once", "--log-output=stdout", "--out", "json=results.json"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Contains(t, stdout, "foo-ran hello")
+	assert.NotContains(t, stdout, "default-ran")
+
+	results, err := fsext.ReadFile(ts.FS, "results.json")
+	require.NoError(t, err)
+	assert.Equal(t, 1.0, sum(getSampleValues(t, results, "iterations",
+		map[string]string{"scenario": "mine", "mytag": "tagvalue"})))
+}
+
+func TestRunOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				a: { executor: 'constant-vus', vus: 1, duration: '1s' },
+				b: { executor: 'constant-vus', vus: 1, duration: '1s' },
+			},
+		};
+		export default function () {}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.Contains(t, allOutput(ts),
+		"--once can run a single scenario only")
+}
+
+func TestRunOnceConflictingFlags(t *testing.T) {
+	t.Parallel()
+
+	for _, flags := range [][]string{
+		{"--iterations", "10"},
+		{"--vus", "2"},
+		{"--duration", "5s"},
+		{"--stage", "5s:2"},
+	} {
+		t.Run(flags[0], func(t *testing.T) {
+			t.Parallel()
+
+			ts := getSingleFileTestState(t, `export default function () {}`,
+				append([]string{"--once"}, flags...), exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.Contains(t, allOutput(ts),
+				"--once cannot be combined with "+flags[0])
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				mine: {
+					executor: 'constant-vus', vus: 10, duration: '1h',
+					exec: 'foo', env: { MY_ENV: 'hello' }, tags: { mytag: 'tagvalue' },
+				},
+			},
+		};
+		export function foo() {}
+	`
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(script), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", "archive.tar", "test.js"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	data, err := fsext.ReadFile(ts.FS, "archive.tar")
+	require.NoError(t, err)
+
+	// Run the produced archive and check that it was transformed.
+	ts2 := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts2.FS, filepath.Join(ts2.Cwd, "archive.tar"), data, 0o644))
+	ts2.CmdArgs = []string{"k6", "run", "--log-output=stdout", "archive.tar"}
+	cmd.ExecuteWithGlobalState(ts2.GlobalState)
+
+	stdout := ts2.Stdout.String()
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+}
+
+// allOutput returns everything the command printed, including the log entries.
+func allOutput(ts *GlobalTestState) string {
+	var sb strings.Builder
+	sb.WriteString(ts.Stderr.String())
+	sb.WriteString(ts.Stdout.String())
+	for _, e := range ts.LoggerHook.Drain() {
+		sb.WriteString(e.Message)
+		sb.WriteString("\n")
+	}
+	return sb.String()
+}
diff --git a/lib/executor/once.go b/lib/executor/once.go
new file mode 100644
index 0000000..171cd61
--- /dev/null
+++ b/lib/executor/once.go
@@ -0,0 +1,56 @@
+package executor
+
+import (
+	"errors"
+
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+// ApplyOnce transforms the (already consolidated) options so the script runs
+// exactly once: with 1 VU and 1 iteration.
+//
+// If no scenarios are configured, the default scenario is used. If exactly one
+// scenario is configured, it is replaced with a shared-iterations executor that
+// preserves only the scenario's name, exec function, env, tags and options
+// (e.g. browser options). Everything else (executor type and its specific
+// fields, startTime, gracefulStop) is discarded. The execution shortcut options
+// (vus, iterations, duration, stages) are discarded as well, so the derivation
+// of scenarios from shortcuts doesn't override the result.
+//
+// More than one scenario is an error, since there is no unambiguous way to run
+// them "once".
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, errors.New("--once can run a single scenario only, but the script defines multiple scenarios")
+	}
+
+	var cfg SharedIterationsConfig
+	switch len(opts.Scenarios) {
+	case 0:
+		cfg = NewSharedIterationsConfig(lib.DefaultScenarioName)
+	default:
+		for name, sc := range opts.Scenarios { // exactly one iteration
+			cfg = NewSharedIterationsConfig(name)
+			if execFn := sc.GetExec(); execFn != consts.DefaultFn {
+				cfg.Exec = null.StringFrom(execFn)
+			}
+			cfg.Env = sc.GetEnv()
+			cfg.Tags = sc.GetTags()
+			cfg.Options = sc.GetScenarioOptions()
+		}
+	}
+	cfg.VUs = null.IntFrom(1)
+	cfg.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{cfg.Name: cfg}
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+
+	return opts, nil
+}
