@@ -0,0 +1,105 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts, err := ApplyOnce(lib.Options{})
+		require.NoError(t, err)
+		require.Len(t, opts.Scenarios, 1)
+
+		sc, ok := opts.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, sharedIterationsType, sc.GetType())
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.Equal(t, "default", sc.GetExec())
+		assert.Empty(t, validate(opts))
+	})
+
+	t.Run("shortcut options are discarded", func(t *testing.T) {
+		t.Parallel()
+
+		opts, err := ApplyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second)}},
+		})
+		require.NoError(t, err)
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		assert.Nil(t, opts.Stages)
+
+		// the result must be stable after the shortcuts derivation
+		derived, err := DeriveScenariosFromShortcuts(opts, nil)
+		require.NoError(t, err)
+		assert.Equal(t, opts.Scenarios, derived.Scenarios)
+	})
+
+	t.Run("single scenario keeps exec, env, tags and options", func(t *testing.T) {
+		t.Parallel()
+
+		orig := NewRampingArrivalRateConfig("browser")
+		orig.Exec = null.StringFrom("myFunc")
+		orig.Env = map[string]string{"FOO": "bar"}
+		orig.Tags = map[string]string{"tag": "value"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		orig.StartTime = types.NewNullDuration(5*time.Second, true)
+		orig.GracefulStop = types.NewNullDuration(7*time.Second, true)
+		orig.TimeUnit = types.NewNullDuration(time.Second, true)
+		orig.PreAllocatedVUs = null.IntFrom(50)
+
+		opts, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"browser": orig}})
+		require.NoError(t, err)
+		require.Len(t, opts.Scenarios, 1)
+
+		sc, ok := opts.Scenarios["browser"].(SharedIterationsConfig)
+		require.True(t, ok, "expected a shared-iterations executor, got %T", opts.Scenarios["browser"])
+		assert.Equal(t, "browser", sc.GetName())
+		assert.Equal(t, "myFunc", sc.GetExec())
+		assert.Equal(t, orig.Env, sc.GetEnv())
+		assert.Equal(t, orig.Tags, sc.GetTags())
+		assert.Equal(t, orig.Options, sc.GetScenarioOptions())
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.StartTime.Valid)
+		assert.False(t, sc.GracefulStop.Valid)
+		assert.False(t, sc.MaxDuration.Valid)
+		assert.Empty(t, validate(opts))
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		_, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"one": NewPerVUIterationsConfig("one"),
+			"two": NewPerVUIterationsConfig("two"),
+		}})
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "--once can run a single scenario only")
+	})
+}
+
+func validate(opts lib.Options) []error {
+	var errs []error
+	for _, sc := range opts.Scenarios {
+		errs = append(errs, sc.Validate()...)
+	}
+	return errs
+}
