+
+// DeriveSingleRunScenario transforms the scenarios configuration so the test
+// runs exactly once, with 1 VU and 1 iteration. It's meant to be applied on
+// the already consolidated options.
+//
+// If there are no scenarios, a default shared-iterations scenario is created.
+// If there is a single scenario, it's replaced by a shared-iterations one that
+// preserves the original exec, env, tags and scenario options. Multiple
+// scenarios aren't supported. Any execution shortcut options (vus, iterations,
+// duration, stages) are discarded.
+func DeriveSingleRunScenario(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ExecutionConflictError("--once can run a single scenario only")
+	}
+
+	result := opts
+	result.VUs = null.NewInt(0, false)
+	result.Iterations = null.NewInt(0, false)
+	result.Duration = types.NewNullDuration(0, false)
+	result.Stages = nil
+
+	ds := NewSharedIterationsConfig(lib.DefaultScenarioName)
+	for name, sc := range opts.Scenarios {
+		ds.Name = name
+		exec := sc.GetExec()
+		ds.Exec = null.NewString(exec, exec != consts.DefaultFn)
+		ds.Env = sc.GetEnv()
+		ds.Tags = sc.GetTags()
+		ds.Options = sc.GetScenarioOptions()
+	}
+	ds.VUs = null.IntFrom(1)
+	ds.Iterations = null.IntFrom(1)
+	result.Scenarios = lib.ScenarioConfigs{ds.Name: ds}
+
+	return result, nil
+}
