+package tests
+
+import (
+	"testing"
+
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+)
+
+func TestRunOnceWithoutScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = { vus: 10, duration: '1h' };
+		export function setup() { console.log('setup'); }
+		export default function () { console.log('default'); }
+		export function teardown() { console.log('teardown'); }
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	entries := ts.LoggerHook.Drain()
+	stdout := ts.Stdout.String()
+	t.Log(stdout)
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Equal(t, 1, countLogMessages(entries, "setup"))
+	assert.Equal(t, 1, countLogMessages(entries, "default"))
+	assert.Equal(t, 1, countLogMessages(entries, "teardown"))
+}
+
+func TestRunOnceWithSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		import exec from 'k6/execution';
+
+		export const options = {
+			scenarios: {
+				myScenario: {
+					executor: 'constant-arrival-rate',
+					rate: 100,
+					duration: '1h',
+					preAllocatedVUs: 50,
+					exec: 'myFunc',
+					env: { MY_VAR: 'myValue' },
+					tags: { myTag: 'myTagValue' },
+				},
+			},
+		};
+
+		export default function () { console.log('default'); }
+
+		export function myFunc() {
+			console.log('myFunc ' + exec.scenario.name + ' ' + __ENV.MY_VAR + ' ' +
+				exec.vu.metrics.tags.myTag + ' ' + exec.scenario.executor);
+		}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	entries := ts.LoggerHook.Drain()
+	stdout := ts.Stdout.String()
+	t.Log(stdout)
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "exec: myFunc")
+	assert.Equal(t, 1, countLogMessages(entries, "myFunc myScenario myValue myTagValue shared-iterations"))
+	assert.Equal(t, 0, countLogMessages(entries, "default"))
+}
+
+func TestRunOnceWithMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				one: { executor: 'per-vu-iterations' },
+				two: { executor: 'per-vu-iterations' },
+			},
+		};
+		export default function () {}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.True(t, testutils.LogContains(
+		ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once can run a single scenario only"))
+}
+
+func TestRunOnceWithShortcutFlags(t *testing.T) {
+	t.Parallel()
+
+	testCases := map[string][]string{
+		"iterations": {"--iterations", "10"},
+		"vus":        {"--vus", "10"},
+		"duration":   {"--duration", "10s"},
+		"stage":      {"--stage", "10s:10"},
+	}
+	for name, flags := range testCases {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+
+			ts := getSingleFileTestState(t, `export default function () {}`,
+				append([]string{"--once"}, flags...), exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.True(t, testutils.LogContains(
+				ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once cannot be combined with --"+name))
+		})
+	}
+}
+
+func countLogMessages(entries []logrus.Entry, msg string) int {
+	count := 0
+	for _, line := range entries {
+		if line.Message == msg {
+			count++
+		}
+	}
+	return count
+}
