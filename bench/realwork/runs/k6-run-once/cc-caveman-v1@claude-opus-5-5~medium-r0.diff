+// applyOnceFlag transforms the consolidated config to run a single iteration
+// with a single VU, if the --once flag was specified. It's applied after all
+// config layers are consolidated, so it overrides them all, while preserving
+// the scenario configuration (exec, env, tags, options).
+func applyOnceFlag(flags *pflag.FlagSet, conf Config) (Config, error) {
+	if flags.Lookup("once") == nil {
+		return conf, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return conf, err
+	}
+
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			err = fmt.Errorf("--once cannot be combined with --%s", name)
+			return conf, errext.WithExitCodeIfNone(err, exitcodes.InvalidConfig)
+		}
+	}
+
+	conf.Options, err = executor.DeriveSingleRunScenario(conf.Options)
+	if err != nil {
+		return conf, errext.WithExitCodeIfNone(err, exitcodes.InvalidConfig)
+	}
+	return conf, nil
+}
