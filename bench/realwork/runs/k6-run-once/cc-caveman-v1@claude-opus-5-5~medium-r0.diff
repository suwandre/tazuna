+package executor
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestDeriveSingleRunScenario(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts := lib.Options{
+			VUs:      null.IntFrom(10),
+			Duration: types.NullDurationFrom(30_000_000_000),
+		}
+		result, err := DeriveSingleRunScenario(opts)
+		require.NoError(t, err)
+
+		assert.False(t, result.VUs.Valid)
+		assert.False(t, result.Duration.Valid)
+		assert.False(t, result.Iterations.Valid)
+		assert.Nil(t, result.Stages)
+		require.Len(t, result.Scenarios, 1)
+
+		sc, ok := result.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		ramping := NewRampingVUsConfig("browser")
+		ramping.StartVUs = null.IntFrom(5)
+		ramping.Stages = []Stage{{Duration: types.NullDurationFrom(1_000_000_000), Target: null.IntFrom(10)}}
+		ramping.StartTime = types.NullDurationFrom(5_000_000_000)
+		ramping.Exec = null.StringFrom("browserTest")
+		ramping.Env = map[string]string{"FOO": "bar"}
+		ramping.Tags = map[string]string{"tag": "val"}
+		ramping.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+
+		opts := lib.Options{Scenarios: lib.ScenarioConfigs{"browser": ramping}}
+		result, err := DeriveSingleRunScenario(opts)
+		require.NoError(t, err)
+		require.Len(t, result.Scenarios, 1)
+
+		sc, ok := result.Scenarios["browser"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "browser", sc.GetName())
+		assert.Equal(t, sharedIterationsType, sc.GetType())
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, null.StringFrom("browserTest"), sc.Exec)
+		assert.Equal(t, ramping.Env, sc.Env)
+		assert.Equal(t, ramping.Tags, sc.Tags)
+		assert.Equal(t, ramping.Options, sc.Options)
+		assert.False(t, sc.StartTime.Valid)
+		assert.Empty(t, sc.Validate())
+
+		// the original options must not be modified
+		assert.Equal(t, ramping, opts.Scenarios["browser"])
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts := lib.Options{Scenarios: lib.ScenarioConfigs{
+			"one": NewPerVUIterationsConfig("one"),
+			"two": NewPerVUIterationsConfig("two"),
+		}}
+		_, err := DeriveSingleRunScenario(opts)
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
