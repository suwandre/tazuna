+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts := lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NewNullDuration(time.Minute, true),
+			Stages:     []lib.Stage{{Duration: types.NewNullDuration(time.Second, true), Target: null.IntFrom(5)}},
+		}
+		res, err := ApplyOnce(opts)
+		require.NoError(t, err)
+
+		assert.False(t, res.VUs.Valid)
+		assert.False(t, res.Iterations.Valid)
+		assert.False(t, res.Duration.Valid)
+		assert.Nil(t, res.Stages)
+
+		require.Len(t, res.Scenarios, 1)
+		sc, ok := res.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, lib.DefaultScenarioName, sc.Name)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.Exec.Valid)
+		assert.Empty(t, res.Validate())
+	})
+
+	t.Run("empty scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		res, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{}})
+		require.NoError(t, err)
+		require.Len(t, res.Scenarios, 1)
+		assert.Contains(t, res.Scenarios, lib.DefaultScenarioName)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		orig := NewRampingVUsConfig("browser_test")
+		orig.StartVUs = null.IntFrom(5)
+		orig.Stages = []Stage{{Duration: types.NewNullDuration(time.Minute, true), Target: null.IntFrom(50)}}
+		orig.StartTime = types.NewNullDuration(10*time.Second, true)
+		orig.GracefulStop = types.NewNullDuration(time.Minute, true)
+		orig.Exec = null.StringFrom("myFunc")
+		orig.Env = map[string]string{"FOO": "bar"}
+		orig.Tags = map[string]string{"team": "a"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+
+		res, err := ApplyOnce(lib.Options{
+			Scenarios: lib.ScenarioConfigs{"browser_test": orig},
+			VUs:       null.IntFrom(3),
+		})
+		require.NoError(t, err)
+		assert.False(t, res.VUs.Valid)
+
+		require.Len(t, res.Scenarios, 1)
+		sc, ok := res.Scenarios["browser_test"].(SharedIterationsConfig)
+		require.True(t, ok, "executor must be replaced by shared-iterations")
+		assert.Equal(t, "browser_test", sc.Name)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.Equal(t, "myFunc", sc.GetExec())
+		assert.Equal(t, orig.Env, sc.Env)
+		assert.Equal(t, orig.Tags, sc.Tags)
+		assert.Equal(t, orig.Options, sc.Options)
+		// everything else is discarded
+		assert.False(t, sc.StartTime.Valid)
+		assert.False(t, sc.GracefulStop.Valid)
+		assert.Empty(t, res.Validate())
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts := lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": NewPerVUIterationsConfig("a"),
+			"b": NewPerVUIterationsConfig("b"),
+		}}
+		_, err := ApplyOnce(opts)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "--once can run a single scenario only")
+	})
+}
