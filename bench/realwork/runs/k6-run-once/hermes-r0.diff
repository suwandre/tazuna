+// ApplyOnce transforms the provided options so that the test runs exactly once:
+// a single scenario with 1 VU and 1 iteration (a shared-iterations executor).
+//
+// If no scenarios are configured, the default scenario is created. If exactly
+// one scenario is configured, it is replaced by a shared-iterations one that
+// keeps only its name, exec, env, tags and scenario options, and discards any
+// other executor-specific fields. More than one scenario is an error.
+//
+// The shortcut options (vus, iterations, duration, stages) are discarded, since
+// they are superseded by the resulting scenario. This is expected to be called
+// after the configuration consolidation, so the result is the final configuration.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	result := opts
+
+	scenario := NewSharedIterationsConfig(lib.DefaultScenarioName)
+	switch len(opts.Scenarios) {
+	case 0:
+	case 1:
+		for name, orig := range opts.Scenarios {
+			scenario = NewSharedIterationsConfig(name)
+			if exec := orig.GetExec(); exec != consts.DefaultFn {
+				scenario.Exec = null.StringFrom(exec)
+			}
+			scenario.Env = orig.GetEnv()
+			scenario.Tags = orig.GetTags()
+			scenario.Options = orig.GetScenarioOptions()
+		}
+	default:
+		return opts, ExecutionConflictError("--once can run a single scenario only")
+	}
+	scenario.VUs = null.IntFrom(1)
+	scenario.Iterations = null.IntFrom(1)
+
+	result.Scenarios = lib.ScenarioConfigs{scenario.Name: scenario}
+	result.VUs = null.Int{}
+	result.Iterations = null.Int{}
+	result.Duration = types.NullDuration{}
+	result.Stages = nil
+
+	return result, nil
+}
+
 // DeriveScenariosFromShortcuts checks for conflicting options and turns any
 // shortcut options (i.e. duration, iterations, stages) into the proper
 // long-form scenario/executor configuration in the scenarios property.
