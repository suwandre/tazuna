+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("default function", func(t *testing.T) {
+		t.Parallel()
+
+		ts := getSingleFileTestState(t, `
+			import { Counter } from 'k6/metrics';
+			const c = new Counter('calls');
+			export const options = { vus: 5, iterations: 50 };
+			export default function () { c.add(1); }
+		`, []string{"--once", "--out", "json=results.json", "--no-usage-report"}, 0)
+
+		results := runAndReadResults(t, ts)
+		assert.Contains(t, ts.Stdout.String(), "1 iterations shared among 1 VUs")
+		assert.Equal(t, float64(1), sum(getSampleValues(t, results, "calls", nil)))
+	})
+
+	t.Run("single scenario keeps exec, env and tags", func(t *testing.T) {
+		t.Parallel()
+
+		ts := getSingleFileTestState(t, `
+			import { Counter } from 'k6/metrics';
+			const c = new Counter('calls');
+			export const options = {
+				scenarios: {
+					only: {
+						executor: 'constant-vus', vus: 7, duration: '1h',
+						exec: 'other', env: { FOO: 'bar' }, tags: { mytag: 'myvalue' },
+					},
+				},
+			};
+			export function other() { c.add(1, { foo: __ENV.FOO }); }
+			export default function () { throw new Error('default must not run'); }
+		`, []string{"--once", "--out", "json=results.json", "--no-usage-report"}, 0)
+
+		results := runAndReadResults(t, ts)
+		assert.Contains(t, ts.Stdout.String(), "1 iterations shared among 1 VUs")
+		assert.Equal(t, float64(1), sum(getSampleValues(t, results, "calls",
+			map[string]string{"scenario": "only", "mytag": "myvalue", "foo": "bar"})))
+	})
+
+	t.Run("setup and teardown run", func(t *testing.T) {
+		t.Parallel()
+
+		ts := getSingleFileTestState(t, `
+			export function setup() { console.log('SETUP'); }
+			export default function () { console.log('DEFAULT'); }
+			export function teardown() { console.log('TEARDOWN'); }
+		`, []string{"--once", "--no-usage-report", "--log-output=stdout"}, 0)
+
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		out := ts.Stdout.String()
+		assert.Contains(t, out, "SETUP")
+		assert.Contains(t, out, "DEFAULT")
+		assert.Contains(t, out, "TEARDOWN")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		ts := getSingleFileTestState(t, `
+			export const options = { scenarios: {
+				a: { executor: 'shared-iterations' },
+				b: { executor: 'shared-iterations' },
+			} };
+			export default function () {}
+		`, []string{"--once", "--no-usage-report", "--log-output=stdout"}, exitcodes.InvalidConfig)
+
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Contains(t, ts.Stdout.String(), "--once can run a single scenario only")
+	})
+
+	for _, flag := range [][]string{
+		{"--iterations", "10"}, {"--vus", "2"}, {"-d", "10s"}, {"--stage", "1s:2"},
+	} {
+		t.Run("combined with "+flag[0], func(t *testing.T) {
+			t.Parallel()
+
+			args := append([]string{"--once", "--no-usage-report", "--log-output=stdout"}, flag...)
+			ts := getSingleFileTestState(t, `export default function () {}`, args, exitcodes.InvalidConfig)
+
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+			assert.Contains(t, ts.Stdout.String(), "--once cannot be combined with")
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, "/test.js", []byte(`
+		export const options = { scenarios: {
+			only: { executor: 'constant-vus', vus: 7, duration: '1h', exec: 'other' },
+		} };
+		export function other() {}
+	`), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", "/out.tar", "/test.js"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	data, err := fsext.ReadFile(ts.FS, "/out.tar")
+	require.NoError(t, err)
+	tr := tar.NewReader(bytes.NewReader(data))
+	for {
+		hdr, err := tr.Next()
+		require.NoError(t, err, "metadata.json not found in the archive")
+		if hdr.Name != "metadata.json" {
+			continue
+		}
+		var meta struct {
+			Options struct {
+				Scenarios map[string]map[string]any `json:"scenarios"`
+			} `json:"options"`
+		}
+		raw, err := io.ReadAll(tr)
+		require.NoError(t, err)
+		require.NoError(t, json.Unmarshal(raw, &meta))
+
+		require.Len(t, meta.Options.Scenarios, 1)
+		sc := meta.Options.Scenarios["only"]
+		assert.Equal(t, "shared-iterations", sc["executor"])
+		assert.EqualValues(t, 1, sc["vus"])
+		assert.EqualValues(t, 1, sc["iterations"])
+		assert.Equal(t, "other", sc["exec"])
+		assert.NotContains(t, sc, "duration")
+		return
+	}
+}
