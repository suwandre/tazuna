+func applyOnceFlag(flags *pflag.FlagSet, opts lib.Options) (lib.Options, error) {
+	if flags == nil || flags.Lookup("once") == nil {
+		return opts, nil
+	}
+
+	once, err := flags.GetBool("once")
+	if err != nil {
+		return opts, err
+	}
+	if !once {
+		return opts, nil
+	}
+
+	for _, flag := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(flag) {
+			return opts, errext.WithExitCodeIfNone(
+				fmt.Errorf("--once cannot be combined with --%s", flag),
+				exitcodes.InvalidConfig,
+			)
+		}
+	}
+
+	if len(opts.Scenarios) > 1 {
+		return opts, errext.WithExitCodeIfNone(
+			errors.New("--once can run a single scenario only"),
+			exitcodes.InvalidConfig,
+		)
+	}
+
+	scenarioName := lib.DefaultScenarioName
+	var scenario lib.ExecutorConfig
+	for name, config := range opts.Scenarios {
+		scenarioName = name
+		scenario = config
+	}
+
+	onceScenario := executor.NewSharedIterationsConfig(scenarioName)
+	onceScenario.VUs = null.IntFrom(1)
+	onceScenario.Iterations = null.IntFrom(1)
+	if scenario != nil {
+		onceScenario.Exec = null.StringFrom(scenario.GetExec())
+		onceScenario.Env = scenario.GetEnv()
+		onceScenario.Tags = scenario.GetTags()
+		onceScenario.Options = scenario.GetScenarioOptions()
+	}
+
+	opts.VUs = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Iterations = null.Int{}
+	opts.Stages = nil
+	opts.Scenarios = lib.ScenarioConfigs{scenarioName: onceScenario}
+
+	return opts, nil
+}
