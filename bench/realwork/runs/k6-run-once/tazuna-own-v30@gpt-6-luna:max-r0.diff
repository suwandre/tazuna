@@ -0,0 +1,127 @@
+package cmd
+
+import (
+	"testing"
+	"time"
+
+	"github.com/spf13/pflag"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func onceTestFlags(t *testing.T, args ...string) *pflag.FlagSet {
+	t.Helper()
+
+	flags := pflag.NewFlagSet("", pflag.ContinueOnError)
+	flags.AddFlagSet(optionFlagSet())
+	flags.AddFlagSet(onceFlagSet())
+	require.NoError(t, flags.Parse(args))
+	return flags
+}
+
+func TestApplyOnceFlagWithoutScenarios(t *testing.T) {
+	t.Parallel()
+
+	flags := onceTestFlags(t, "--once")
+	opts := lib.Options{
+		VUs:        null.IntFrom(4),
+		Iterations: null.IntFrom(8),
+		Duration:   types.NullDurationFrom(time.Minute),
+		Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second)}},
+		RunTags:    map[string]string{"cli": "preserved"},
+	}
+
+	got, err := applyOnceFlag(flags, opts)
+	require.NoError(t, err)
+
+	assert.False(t, got.VUs.Valid)
+	assert.False(t, got.Iterations.Valid)
+	assert.False(t, got.Duration.Valid)
+	assert.Nil(t, got.Stages)
+	assert.Equal(t, map[string]string{"cli": "preserved"}, got.RunTags)
+
+	config, ok := got.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+	require.True(t, ok)
+	assert.Equal(t, int64(1), config.VUs.Int64)
+	assert.Equal(t, int64(1), config.Iterations.Int64)
+}
+
+func TestApplyOnceFlagPreservesScenarioSettings(t *testing.T) {
+	t.Parallel()
+
+	flags := onceTestFlags(t, "--once")
+	scenarioOptions := &lib.ScenarioOptions{Browser: map[string]any{"headless": true}}
+	original := executor.ConstantVUsConfig{
+		BaseConfig: executor.BaseConfig{
+			Name:         "browserScenario",
+			Type:         "constant-vus",
+			StartTime:    types.NullDurationFrom(time.Hour),
+			GracefulStop: types.NullDurationFrom(time.Minute),
+			Env:          map[string]string{"SCENARIO_ENV": "preserved"},
+			Exec:         null.StringFrom("browserScenarioFunction"),
+			Tags:         map[string]string{"scenarioTag": "preserved"},
+			Options:      scenarioOptions,
+		},
+		VUs:      null.IntFrom(5),
+		Duration: types.NullDurationFrom(time.Hour),
+	}
+	opts := lib.Options{Scenarios: lib.ScenarioConfigs{"browserScenario": original}}
+
+	got, err := applyOnceFlag(flags, opts)
+	require.NoError(t, err)
+
+	config, ok := got.Scenarios["browserScenario"].(executor.SharedIterationsConfig)
+	require.True(t, ok)
+	assert.Equal(t, "shared-iterations", config.GetType())
+	assert.Equal(t, "browserScenarioFunction", config.GetExec())
+	assert.Equal(t, map[string]string{"SCENARIO_ENV": "preserved"}, config.GetEnv())
+	assert.Equal(t, map[string]string{"scenarioTag": "preserved"}, config.GetTags())
+	assert.Same(t, scenarioOptions, config.GetScenarioOptions())
+	assert.Equal(t, null.IntFrom(1), config.VUs)
+	assert.Equal(t, null.IntFrom(1), config.Iterations)
+	assert.False(t, config.StartTime.Valid)
+	assert.True(t, config.Exec.Valid)
+	assert.Zero(t, config.GetStartTime())
+}
+
+func TestApplyOnceFlagRejectsMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	flags := onceTestFlags(t, "--once")
+	opts := lib.Options{Scenarios: lib.ScenarioConfigs{
+		"first":  executor.NewSharedIterationsConfig("first"),
+		"second": executor.NewSharedIterationsConfig("second"),
+	}}
+
+	_, err := applyOnceFlag(flags, opts)
+	require.ErrorContains(t, err, "--once can run a single scenario only")
+}
+
+func TestApplyOnceFlagRejectsShortcutFlags(t *testing.T) {
+	t.Parallel()
+
+	testCases := []struct {
+		flag  string
+		value string
+	}{
+		{flag: "vus", value: "1"},
+		{flag: "iterations", value: "1"},
+		{flag: "duration", value: "1s"},
+		{flag: "stage", value: "1s:1"},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.flag, func(t *testing.T) {
+			t.Parallel()
+			flags := onceTestFlags(t, "--once", "--"+tc.flag, tc.value)
+
+			_, err := applyOnceFlag(flags, lib.Options{})
+			require.EqualError(t, err, "--once cannot be combined with --"+tc.flag)
+		})
+	}
+}
