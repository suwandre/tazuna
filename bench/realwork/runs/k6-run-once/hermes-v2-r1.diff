+package tests
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		script := `
+			export const options = { vus: 5, duration: '1h' };
+			export default function () {}
+		`
+		ts := getSingleFileTestState(t, script,
+			[]string{"--once", "--out", "json=results.json", "--no-usage-report"}, 0)
+		results := runAndReadResults(t, ts)
+
+		assert.Equal(t, 1.0, sum(getSampleValues(t, results, "iterations", nil)))
+	})
+
+	t.Run("single scenario keeps exec env and tags", func(t *testing.T) {
+		t.Parallel()
+
+		script := `
+			import exec from 'k6/execution';
+			import { check } from 'k6';
+
+			export const options = {
+				scenarios: {
+					only: {
+						executor: 'constant-vus',
+						vus: 10,
+						duration: '1h',
+						exec: 'other',
+						env: { FOO: 'bar' },
+						tags: { mytag: 'myvalue' },
+					},
+				},
+			};
+
+			export function other() {
+				if (__ENV.FOO !== 'bar') { throw new Error('env not preserved: ' + __ENV.FOO); }
+				if (exec.scenario.name !== 'only') { throw new Error('bad scenario'); }
+			}
+		`
+		ts := getSingleFileTestState(t, script,
+			[]string{"--once", "--out", "json=results.json", "--no-usage-report"}, 0)
+		results := runAndReadResults(t, ts)
+
+		assert.Equal(t, 1.0, sum(getSampleValues(t, results, "iterations",
+			map[string]string{"scenario": "only", "mytag": "myvalue"})))
+	})
+
+	t.Run("setup and teardown run", func(t *testing.T) {
+		t.Parallel()
+
+		script := `
+			export function setup() { console.log('SETUP_RAN'); }
+			export function teardown() { console.log('TEARDOWN_RAN'); }
+			export default function () { console.log('ITERATION_RAN'); }
+		`
+		ts := getSingleFileTestState(t, script,
+			[]string{"--once", "--log-output=stdout", "--no-usage-report"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "SETUP_RAN")
+		assert.Contains(t, stdout, "TEARDOWN_RAN")
+		assert.Equal(t, 1, strings.Count(stdout, "ITERATION_RAN"))
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		script := `
+			export const options = { scenarios: {
+				a: { executor: 'per-vu-iterations', vus: 1, iterations: 1 },
+				b: { executor: 'per-vu-iterations', vus: 1, iterations: 1 },
+			}};
+			export default function () {}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+	})
+
+	for _, flag := range [][]string{
+		{"--iterations", "10"}, {"--vus", "2"}, {"--duration", "10s"}, {"--stage", "10s:5"},
+	} {
+		t.Run("incompatible with "+flag[0], func(t *testing.T) {
+			t.Parallel()
+
+			ts := getSingleFileTestState(t, `export default function () {}`,
+				append([]string{"--once"}, flag...), exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with "+flag[0])
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: { only: { executor: 'constant-vus', vus: 10, duration: '1h', exec: 'other' } },
+		};
+		export function other() {}
+	`
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, ts.Cwd+"/test.js", []byte(script), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", "/test/archive.tar", "test.js"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	data, err := fsext.ReadFile(ts.FS, ts.Cwd+"/archive.tar")
+	require.NoError(t, err)
+	require.NotEmpty(t, data)
+
+	arc, err := lib.ReadArchive(bytes.NewReader(data))
+	require.NoError(t, err)
+
+	require.Len(t, arc.Options.Scenarios, 1)
+	sc := arc.Options.Scenarios["only"]
+	require.NotNil(t, sc)
+	assert.Equal(t, "shared-iterations", sc.GetType())
+	assert.Equal(t, "other", sc.GetExec())
+	assert.False(t, arc.Options.VUs.Valid)
+	assert.False(t, arc.Options.Duration.Valid)
+}
diff --git a/lib/executor/once.go b/lib/executor/once.go
new file mode 100644
index 0000000..d0714f3
--- /dev/null
+++ b/lib/executor/once.go
@@ -0,0 +1,54 @@
+package executor
+
+import (
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+// ApplyOnce transforms the provided consolidated options so that the script is
+// executed exactly once: with 1 VU and 1 iteration. It is what the `--once`
+// flag uses.
+//
+// If no scenarios are defined, a default scenario running the default function
+// is created. If exactly one scenario is defined, its executor is replaced by
+// a shared-iterations one with 1 VU and 1 iteration, while keeping its name,
+// exec, env, tags and scenario options. All the other executor-specific fields
+// (e.g. startTime, gracefulStop, vus, duration, stages) are discarded. More than
+// one scenario is an error.
+//
+// The execution shortcut options (vus, iterations, duration, stages) are
+// cleared, since the resulting scenario supersedes them.
+//
+// This should be called after the config consolidation and before the
+// scenarios derivation from the shortcuts.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ExecutionConflictError("--once can run a single scenario only")
+	}
+
+	sic := NewSharedIterationsConfig(lib.DefaultScenarioName)
+	for name, sc := range opts.Scenarios {
+		sic = NewSharedIterationsConfig(name)
+		// GetExec() falls back to the default function name; only keep explicit values.
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			sic.Exec = null.StringFrom(exec)
+		}
+		sic.Env = sc.GetEnv()
+		sic.Tags = sc.GetTags()
+		sic.Options = sc.GetScenarioOptions()
+	}
+	sic.VUs = null.IntFrom(1)
+	sic.Iterations = null.IntFrom(1)
+
+	result := opts
+	result.Scenarios = lib.ScenarioConfigs{sic.Name: sic}
+	result.VUs = null.Int{}
+	result.Iterations = null.Int{}
+	result.Duration = types.NullDuration{}
+	result.Stages = nil
+
+	return result, nil
+}
