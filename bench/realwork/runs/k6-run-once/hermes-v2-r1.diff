@@ -0,0 +1,43 @@
+package cmd
+
+import (
+	"fmt"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/pflag"
+)
+
+const onceFlagName = "once"
+
+// onceIncompatibleFlags are the flags that define the execution (VUs,
+// iterations, duration, etc.) and so can't be combined with --once.
+var onceIncompatibleFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// onceFlagSet returns the flag set with the --once flag.
+func onceFlagSet() *pflag.FlagSet {
+	flags := pflag.NewFlagSet("", pflag.ContinueOnError)
+	flags.SortFlags = false
+	flags.Bool(onceFlagName, false,
+		"run the script once, with 1 VU and 1 iteration, keeping the scenario configuration (exec, env, tags, options)")
+	return flags
+}
+
+// isOnceEnabled returns true if the command has the --once flag and it is set.
+func isOnceEnabled(cmd *cobra.Command) bool {
+	if cmd == nil || cmd.Flags().Lookup(onceFlagName) == nil {
+		return false
+	}
+	once, err := cmd.Flags().GetBool(onceFlagName)
+	return err == nil && once
+}
+
+// validateOnceFlagCombination returns an error if --once was combined with any
+// of the execution shortcut flags.
+func validateOnceFlagCombination(flags *pflag.FlagSet) error {
+	for _, name := range onceIncompatibleFlags {
+		if flags.Changed(name) {
+			return fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name)
+		}
+	}
+	return nil
+}
