+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := applyOnce(lib.Options{
+			VUs: null.IntFrom(10), Iterations: null.IntFrom(5), Duration: types.NullDurationFrom(time.Minute),
+		})
+		require.NoError(t, err)
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		opts, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"foo": executor.ConstantVUsConfig{
+				BaseConfig: executor.BaseConfig{
+					Name: "foo", Type: "constant-vus", Exec: null.StringFrom("fn"),
+					Env:       map[string]string{"A": "b"},
+					Tags:      map[string]string{"c": "d"},
+					Options:   &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}},
+					StartTime: types.NullDurationFrom(time.Second),
+				},
+				VUs:      null.IntFrom(10),
+				Duration: types.NullDurationFrom(time.Minute),
+			},
+		}})
+		require.NoError(t, err)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios["foo"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "foo", sc.Name)
+		assert.Equal(t, "shared-iterations", sc.Type)
+		assert.Equal(t, "fn", sc.Exec.String)
+		assert.Equal(t, map[string]string{"A": "b"}, sc.Env)
+		assert.Equal(t, map[string]string{"c": "d"}, sc.Tags)
+		assert.Equal(t, map[string]any{"type": "chromium"}, sc.Options.Browser)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.MaxDuration.Valid)
+		assert.Zero(t, sc.StartTime.Duration)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": executor.NewSharedIterationsConfig("a"),
+			"b": executor.NewSharedIterationsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+		var ecerr errext.HasExitCode
+		require.ErrorAs(t, err, &ecerr)
+		assert.Equal(t, exitcodes.InvalidConfig, ecerr.ExitCode())
+	})
+}
+
+func TestIsOnceEnabled(t *testing.T) {
+	t.Parallel()
+
+	newFlags := func(args ...string) *pflag.FlagSet {
+		fs := optionFlagSet()
+		require.NoError(t, fs.Parse(args))
+		return fs
+	}
+
+	once, err := isOnceEnabled(newFlags())
+	require.NoError(t, err)
+	assert.False(t, once)
+
+	once, err = isOnceEnabled(newFlags("--once"))
+	require.NoError(t, err)
+	assert.True(t, once)
+
+	for _, flag := range []string{"--vus=2", "--iterations=10", "--duration=1s", "--stage=1s:2"} {
+		_, err = isOnceEnabled(newFlags("--once", flag))
+		require.ErrorContains(t, err, "--once cannot be combined with "+strings.SplitN(flag, "=", 2)[0])
+	}
+}
