+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("default function", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `
+			export const options = { vus: 5, iterations: 20 };
+			export function setup() { console.log("setup"); }
+			export default function() { console.log("default"); }
+			export function teardown() { console.log("teardown"); }
+		`, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "default: 1 iterations shared among 1 VUs")
+		assert.Equal(t, 1, strings.Count(stdout, "msg=default "))
+		assert.Contains(t, stdout, "msg=setup ")
+		assert.Contains(t, stdout, "msg=teardown ")
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `
+			export const options = { scenarios: { foo: {
+				executor: 'constant-vus', vus: 5, duration: '1h', exec: 'bar',
+			} } };
+			export function bar() { console.log("bar"); }
+			export default function() { console.log("default"); }
+		`, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "foo: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "exec: bar")
+		assert.Equal(t, 1, strings.Count(stdout, "msg=bar "))
+		assert.NotContains(t, stdout, "msg=default ")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `
+			export const options = { scenarios: {
+				a: { executor: 'shared-iterations' },
+				b: { executor: 'shared-iterations' },
+			} };
+			export default function() {}
+		`, []string{"--once"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.True(t, testutils.LogContains(
+			ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once can run a single scenario only"))
+	})
+
+	t.Run("combined with iterations", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `export default function() {}`,
+			[]string{"--once", "--iterations", "10"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.True(t, testutils.LogContains(
+			ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once cannot be combined with --iterations"))
+	})
+}
