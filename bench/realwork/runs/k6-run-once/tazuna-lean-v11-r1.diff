+// onceIncompatibleFlags lists the shortcut flags that can't be combined with --once.
+var onceIncompatibleFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// isOnceEnabled reports whether the --once flag is set. It also validates that
+// it isn't combined with any of the execution shortcut flags.
+func isOnceEnabled(flags *pflag.FlagSet) (bool, error) {
+	if flags == nil || flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceIncompatibleFlags {
+		if flags.Changed(name) {
+			return false, errext.WithExitCodeIfNone(
+				fmt.Errorf("--once cannot be combined with --%s", name),
+				exitcodes.InvalidConfig,
+			)
+		}
+	}
+	return true, nil
+}
+
+// applyOnce transforms the options so the script runs with 1 VU and 1 iteration.
+// If there are no scenarios, the default one is used. If there is exactly one,
+// it is replaced by a shared-iterations executor that preserves its name, exec,
+// env, tags and options. Everything else is discarded.
+//
+// It must be called after the config consolidation, so the scenarios coming
+// from any source (script, file, env) are taken into account.
+func applyOnce(opts lib.Options) (lib.Options, error) {
+	scenario := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	switch len(opts.Scenarios) {
+	case 0:
+	case 1:
+		for name, sc := range opts.Scenarios {
+			scenario.Name = name
+			scenario.Exec = null.NewString(sc.GetExec(), sc.GetExec() != "")
+			scenario.Env = sc.GetEnv()
+			scenario.Tags = sc.GetTags()
+			scenario.Options = sc.GetScenarioOptions()
+		}
+	default:
+		return opts, errext.WithExitCodeIfNone(
+			errors.New("--once can run a single scenario only"),
+			exitcodes.InvalidConfig,
+		)
+	}
+	scenario.VUs = null.IntFrom(1)
+	scenario.Iterations = null.IntFrom(1)
+
+	// The shortcut options must be dropped, otherwise they would conflict with
+	// the scenario during the derivation.
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	opts.Scenarios = lib.ScenarioConfigs{scenario.Name: scenario}
+	return opts, nil
+}
+
