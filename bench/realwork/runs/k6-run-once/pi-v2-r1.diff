index 0000000..f3d3be4
--- /dev/null
+++ b/internal/cmd/tests/cmd_run_once_test.go
@@ -0,0 +1,101 @@
+package tests
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func runOnceTest(t *testing.T, script string, args ...string) *GlobalTestState {
+	t.Helper()
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "script.js"), []byte(script), 0o644))
+	ts.CmdArgs = append([]string{"k6", "run", "script.js"}, args...)
+	return ts
+}
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("default function", func(t *testing.T) {
+		t.Parallel()
+		ts := runOnceTest(t, `
+			export const options = { vus: 5, iterations: 50 };
+			export default function () { console.log("iter-marker"); }
+		`, "--once")
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Equal(t, 1, strings.Count(ts.Stdout.String()+ts.Stderr.String(), "iter-marker"))
+	})
+
+	t.Run("single scenario keeps exec and env", func(t *testing.T) {
+		t.Parallel()
+		ts := runOnceTest(t, `
+			export const options = { scenarios: { s: {
+				executor: 'constant-vus', vus: 4, duration: '1m', exec: 'other', env: { FOO: 'bar' },
+			} } };
+			export function other() { console.log("other-" + __ENV.FOO); }
+		`, "--once")
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Equal(t, 1, strings.Count(ts.Stdout.String()+ts.Stderr.String(), "other-bar"))
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := runOnceTest(t, `
+			export const options = { scenarios: {
+				a: { executor: 'constant-vus', vus: 1, duration: '1s' },
+				b: { executor: 'constant-vus', vus: 1, duration: '1s' },
+			} };
+			export default function () {}
+		`, "--once")
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Contains(t, allOutput(ts), "--once can run a single scenario only")
+	})
+
+	t.Run("combined with shortcut", func(t *testing.T) {
+		t.Parallel()
+		ts := runOnceTest(t, `export default function () {}`, "--once", "--iterations", "10")
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Contains(t, allOutput(ts), "--once cannot be combined with --iterations")
+	})
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "script.js"), []byte(`
+		export const options = { scenarios: { s: { executor: 'constant-vus', vus: 4, duration: '1m', exec: 'other' } } };
+		export function other() {}
+	`), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "script.js"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+	require.NoError(t, testutils.Untar(t, ts.FS, "archive.tar", "tmp/"))
+
+	data, err := fsext.ReadFile(ts.FS, "tmp/metadata.json")
+	require.NoError(t, err)
+	assert.Contains(t, string(data), `"shared-iterations"`)
+	assert.Contains(t, string(data), `"exec": "other"`)
+	assert.NotContains(t, string(data), `"constant-vus"`)
+}
+
+func allOutput(ts *GlobalTestState) string {
+	var sb strings.Builder
+	sb.WriteString(ts.Stdout.String())
+	sb.WriteString(ts.Stderr.String())
+	for _, e := range ts.LoggerHook.Drain() {
+		sb.WriteString(e.Message)
+		sb.WriteString("\n")
+	}
+	return sb.String()
+}
