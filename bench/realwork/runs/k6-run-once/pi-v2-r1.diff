@@ -0,0 +1,81 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestDeriveOnceScenarioNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	opts := lib.Options{
+		VUs:        null.IntFrom(10),
+		Iterations: null.IntFrom(100),
+		Duration:   types.NullDurationFrom(time.Minute),
+		Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second)}},
+	}
+	res, err := DeriveOnceScenario(opts)
+	require.NoError(t, err)
+	require.False(t, res.VUs.Valid)
+	require.False(t, res.Iterations.Valid)
+	require.False(t, res.Duration.Valid)
+	require.Nil(t, res.Stages)
+	require.Len(t, res.Scenarios, 1)
+
+	sc, ok := res.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+	require.True(t, ok)
+	require.Equal(t, int64(1), sc.VUs.Int64)
+	require.Equal(t, int64(1), sc.Iterations.Int64)
+	require.Equal(t, "default", sc.GetExec())
+	require.Empty(t, sc.Validate())
+}
+
+func TestDeriveOnceScenarioSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	orig := NewRampingVUsConfig("mine")
+	orig.Exec = null.StringFrom("myfn")
+	orig.Env = map[string]string{"A": "b"}
+	orig.Tags = map[string]string{"t": "v"}
+	orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+	orig.StartTime = types.NullDurationFrom(time.Hour)
+	orig.GracefulStop = types.NullDurationFrom(time.Hour)
+	orig.StartVUs = null.IntFrom(5)
+
+	res, err := DeriveOnceScenario(lib.Options{
+		Scenarios: lib.ScenarioConfigs{"mine": orig},
+		VUs:       null.IntFrom(3),
+	})
+	require.NoError(t, err)
+	require.False(t, res.VUs.Valid)
+	require.Len(t, res.Scenarios, 1)
+
+	sc, ok := res.Scenarios["mine"].(SharedIterationsConfig)
+	require.True(t, ok)
+	require.Equal(t, "mine", sc.GetName())
+	require.Equal(t, sharedIterationsType, sc.GetType())
+	require.Equal(t, int64(1), sc.VUs.Int64)
+	require.Equal(t, int64(1), sc.Iterations.Int64)
+	require.Equal(t, "myfn", sc.GetExec())
+	require.Equal(t, orig.Env, sc.GetEnv())
+	require.Equal(t, orig.Tags, sc.GetTags())
+	require.Equal(t, orig.Options, sc.GetScenarioOptions())
+	require.Zero(t, sc.GetStartTime())
+	require.NotEqual(t, time.Hour, sc.GetGracefulStop())
+}
+
+func TestDeriveOnceScenarioMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	_, err := DeriveOnceScenario(lib.Options{Scenarios: lib.ScenarioConfigs{
+		"a": NewPerVUIterationsConfig("a"),
+		"b": NewPerVUIterationsConfig("b"),
+	}})
+	require.ErrorIs(t, err, ErrOnceMultipleScenarios)
+}
