+const onceFlagName = "once"
+
+// onceFlagSet returns the flag set with the --once flag, used by the commands
+// that can run (or archive) a test with a single VU and a single iteration.
+func onceFlagSet() *pflag.FlagSet {
+	flags := pflag.NewFlagSet("", 0)
+	flags.SortFlags = false
+	flags.Bool(onceFlagName, false,
+		"run the script once with 1 VU and 1 iteration, preserving the scenario configuration")
+	return flags
+}
+
+// onceShortcutFlags are the flags that can't be combined with --once.
+var onceShortcutFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// isOnceMode reports whether the --once flag is registered and enabled.
+func isOnceMode(flags *pflag.FlagSet) (bool, error) {
+	if flags == nil || flags.Lookup(onceFlagName) == nil {
+		return false, nil
+	}
+	return flags.GetBool(onceFlagName)
+}
+
+// validateOnceFlags returns an error if --once is combined with any of the shortcut flags.
+func validateOnceFlags(flags *pflag.FlagSet) error {
+	for _, name := range onceShortcutFlags {
+		if flags.Changed(name) {
+			return errext.WithExitCodeIfNone(
+				fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name),
+				exitcodes.InvalidConfig,
+			)
+		}
+	}
+	return nil
+}
+
