+	"go.k6.io/k6/v2/internal/lib/consts"
 	"go.k6.io/k6/v2/lib"
 	"go.k6.io/k6/v2/lib/types"
 )
@@ -131,3 +132,44 @@ func DeriveScenariosFromShortcuts(opts lib.Options, logger logrus.FieldLogger) (
 
 	return result, nil
 }
+
+// ErrOnceMultipleScenarios is returned by DeriveOnceScenario when the script defines
+// more than one scenario.
+var ErrOnceMultipleScenarios = ExecutionConflictError("--once can run a single scenario only")
+
+// DeriveOnceScenario returns a copy of the options configured to run a single scenario
+// with 1 VU and 1 iteration.
+//
+// If no scenarios are defined, the default scenario is used. If exactly one scenario is
+// defined, its exec, env, tags, and options (e.g. browser) are preserved, while its executor
+// is replaced with shared-iterations and all the other fields are discarded.
+// The execution shortcuts (vus, iterations, duration, stages) are discarded as well.
+func DeriveOnceScenario(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ErrOnceMultipleScenarios
+	}
+
+	name := lib.DefaultScenarioName
+	once := NewSharedIterationsConfig(name)
+	for scenarioName, sc := range opts.Scenarios { // at most one
+		name = scenarioName
+		once = NewSharedIterationsConfig(name)
+		if fn := sc.GetExec(); fn != consts.DefaultFn {
+			once.Exec = null.StringFrom(fn)
+		}
+		once.Env = sc.GetEnv()
+		once.Tags = sc.GetTags()
+		once.Options = sc.GetScenarioOptions()
+	}
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	result := opts
+	result.VUs = null.Int{}
+	result.Iterations = null.Int{}
+	result.Duration = types.NullDuration{}
+	result.Stages = nil
+	result.Scenarios = lib.ScenarioConfigs{name: once}
+
+	return result, nil
+}
