diff --git a/internal/cmd/once.go b/internal/cmd/once.go
new file mode 100644
index 0000000..a0c1e32
--- /dev/null
+++ b/internal/cmd/once.go
@@ -0,0 +1,48 @@
+package cmd
+
+import (
+	"fmt"
+
+	"github.com/spf13/pflag"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+// onceConflictingFlags are the shortcut flags that can't be combined with --once.
+var onceConflictingFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// isOnceRequested reports whether --once was set, and fails if it was combined
+// with any of the shortcut flags.
+func isOnceRequested(flags *pflag.FlagSet) (bool, error) {
+	if flags == nil || flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceConflictingFlags {
+		if flags.Changed(name) {
+			return false, fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+	return true, nil
+}
+
+// applyOnce turns the consolidated config into a single scenario running with
+// 1 VU and 1 iteration. It must run after config consolidation, so scenarios
+// from every source are already merged.
+func applyOnce(conf Config) (Config, error) {
+	scenarios, err := executor.DeriveOnceScenarios(conf.Scenarios)
+	if err != nil {
+		return conf, err
+	}
+	conf.Scenarios = scenarios
+	conf.VUs = null.Int{}
+	conf.Iterations = null.Int{}
+	conf.Duration = types.NullDuration{}
+	conf.Stages = nil
+	return conf, nil
+}
diff --git a/internal/cmd/once_test.go b/internal/cmd/once_test.go
new file mode 100644
index 0000000..1775062
--- /dev/null
+++ b/internal/cmd/once_test.go
@@ -0,0 +1,68 @@
+package cmd
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+)
+
+func TestIsOnceRequested(t *testing.T) {
+	t.Parallel()
+
+	parse := func(args ...string) (bool, error) {
+		fs := optionFlagSet()
+		require.NoError(t, fs.Parse(args))
+		return isOnceRequested(fs)
+	}
+
+	once, err := parse()
+	require.NoError(t, err)
+	require.False(t, once)
+
+	once, err = parse("--once")
+	require.NoError(t, err)
+	require.True(t, once)
+
+	for _, f := range []string{"--vus=2", "--iterations=10", "--duration=1s", "--stage=1s:2"} {
+		_, err = parse("--once", f)
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "--once cannot be combined with --"+f[2:len(f)-len(f[indexEq(f):])])
+	}
+
+	once, err = isOnceRequested(nil)
+	require.NoError(t, err)
+	require.False(t, once)
+}
+
+func indexEq(s string) int {
+	for i := range s {
+		if s[i] == '=' {
+			return i
+		}
+	}
+	return len(s)
+}
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	conf := Config{}
+	conf.VUs = null.IntFrom(10)
+	conf.Iterations = null.IntFrom(100)
+	res, err := applyOnce(conf)
+	require.NoError(t, err)
+	require.False(t, res.VUs.Valid)
+	require.False(t, res.Iterations.Valid)
+	require.Contains(t, res.Scenarios, lib.DefaultScenarioName)
+
+	conf.Scenarios = lib.ScenarioConfigs{
+		"a": executor.NewPerVUIterationsConfig("a"),
+		"b": executor.NewPerVUIterationsConfig("b"),
+	}
+	_, err = applyOnce(conf)
+	require.ErrorIs(t, err, executor.ErrOnceMultipleScenarios)
+}
