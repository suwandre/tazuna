index 0000000..d3c382a
--- /dev/null
+++ b/internal/cmd/tests/cmd_run_once_test.go
@@ -0,0 +1,60 @@
+package tests
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("default export", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		ts.CmdArgs = []string{"k6", "run", "--once", "-"}
+		ts.Stdin = bytes.NewBufferString(`export const options = {vus: 5, iterations: 50};
+export default function() { console.log("ran"); }`)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Equal(t, 1, bytes.Count(ts.Stderr.Bytes(), []byte("ran")))
+	})
+
+	t.Run("single scenario keeps exec and env", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		ts.CmdArgs = []string{"k6", "run", "--once", "-"}
+		ts.Stdin = bytes.NewBufferString(`export const options = {scenarios: {s: {
+  executor: "constant-vus", vus: 5, duration: "1m", exec: "foo", env: {X: "y"}}}};
+export function foo() { console.log("foo-" + __ENV.X); }`)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		out := ts.Stderr.String()
+		assert.Equal(t, 1, bytes.Count([]byte(out), []byte("foo-y")))
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		ts.CmdArgs = []string{"k6", "run", "--once", "-"}
+		ts.Stdin = bytes.NewBufferString(`export const options = {scenarios: {
+  a: {executor: "shared-iterations"}, b: {executor: "shared-iterations"}}};
+export default function() {}`)
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		require.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+	})
+
+	t.Run("conflict with iterations", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		ts.CmdArgs = []string{"k6", "run", "--once", "--iterations", "10", "-"}
+		ts.Stdin = bytes.NewBufferString(`export default function() {}`)
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		require.Contains(t, ts.Stderr.String(), "--once cannot be combined with --iterations")
+	})
+}
diff --git a/lib/executor/once.go b/lib/executor/once.go
new file mode 100644
index 0000000..c9c4d05
--- /dev/null
+++ b/lib/executor/once.go
@@ -0,0 +1,62 @@
+package executor
+
+import (
+	"errors"
+
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// ErrOnceMultipleScenarios is returned when --once is used with more than one scenario.
+var ErrOnceMultipleScenarios = errors.New("--once can run a single scenario only")
+
+type baseConfigGetter interface {
+	baseConfig() BaseConfig
+}
+
+func (bc BaseConfig) baseConfig() BaseConfig { return bc }
+
+// DeriveOnceScenarios returns a scenarios set that runs a single scenario with
+// 1 VU and 1 iteration. With no scenarios, it creates the default scenario. With
+// a single scenario, it preserves its name, exec, env, tags and options, and
+// replaces the executor with shared-iterations, discarding everything else.
+func DeriveOnceScenarios(scenarios lib.ScenarioConfigs) (lib.ScenarioConfigs, error) {
+	switch len(scenarios) {
+	case 0:
+		return lib.ScenarioConfigs{
+			lib.DefaultScenarioName: onceConfig(NewBaseConfig(lib.DefaultScenarioName, sharedIterationsType)),
+		}, nil
+	case 1:
+		for name, sc := range scenarios {
+			var base BaseConfig
+			if g, ok := sc.(baseConfigGetter); ok {
+				base = g.baseConfig()
+			} else {
+				base.Env = sc.GetEnv()
+				base.Tags = sc.GetTags()
+				base.Options = sc.GetScenarioOptions()
+			}
+			// Exec is only kept when explicitly set, so defaults stay implicit.
+			var exec null.String
+			if base.Exec.Valid {
+				exec = base.Exec
+			}
+			nb := NewBaseConfig(name, sharedIterationsType)
+			nb.Exec = exec
+			nb.Env = base.Env
+			nb.Tags = base.Tags
+			nb.Options = base.Options
+			return lib.ScenarioConfigs{name: onceConfig(nb)}, nil
+		}
+	}
+	return nil, ErrOnceMultipleScenarios
+}
+
+func onceConfig(base BaseConfig) SharedIterationsConfig {
+	sic := NewSharedIterationsConfig(base.Name)
+	sic.BaseConfig = base
+	sic.VUs = null.IntFrom(1)
+	sic.Iterations = null.IntFrom(1)
+	return sic
+}
diff --git a/lib/executor/once_test.go b/lib/executor/once_test.go
new file mode 100644
index 0000000..4c890af
--- /dev/null
+++ b/lib/executor/once_test.go
@@ -0,0 +1,61 @@
+package executor
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestDeriveOnceScenarios(t *testing.T) {
+	t.Parallel()
+
+	t.Run("none", func(t *testing.T) {
+		t.Parallel()
+		res, err := DeriveOnceScenarios(nil)
+		require.NoError(t, err)
+		sic, ok := res[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		require.Equal(t, int64(1), sic.VUs.Int64)
+		require.Equal(t, int64(1), sic.Iterations.Int64)
+	})
+
+	t.Run("single", func(t *testing.T) {
+		t.Parallel()
+		in := NewRampingVUsConfig("foo")
+		in.Exec = null.StringFrom("fn")
+		in.Env = map[string]string{"A": "b"}
+		in.Tags = map[string]string{"t": "v"}
+		in.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		in.StartTime = types.NewNullDuration(5, true)
+		in.StartVUs = null.IntFrom(10)
+
+		res, err := DeriveOnceScenarios(lib.ScenarioConfigs{"foo": in})
+		require.NoError(t, err)
+		require.Len(t, res, 1)
+		sic, ok := res["foo"].(SharedIterationsConfig)
+		require.True(t, ok)
+		require.Equal(t, "foo", sic.Name)
+		require.Equal(t, sharedIterationsType, sic.Type)
+		require.Equal(t, "fn", sic.GetExec())
+		require.Equal(t, in.Env, sic.Env)
+		require.Equal(t, in.Tags, sic.Tags)
+		require.Equal(t, in.Options, sic.Options)
+		require.Zero(t, sic.StartTime.Duration)
+		require.Equal(t, int64(1), sic.VUs.Int64)
+		require.Equal(t, int64(1), sic.Iterations.Int64)
+		require.Empty(t, sic.Validate())
+	})
+
+	t.Run("multiple", func(t *testing.T) {
+		t.Parallel()
+		_, err := DeriveOnceScenarios(lib.ScenarioConfigs{
+			"a": NewPerVUIterationsConfig("a"),
+			"b": NewPerVUIterationsConfig("b"),
+		})
+		require.ErrorIs(t, err, ErrOnceMultipleScenarios)
+	})
+}
