+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("default function", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `
+			export const options = {vus: 5, iterations: 10};
+			export default function() { console.log("iter-marker"); }`,
+			[]string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		stdout := ts.Stdout.String()
+		assert.Equal(t, 1, strings.Count(stdout, "iter-marker"))
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	})
+
+	t.Run("single scenario keeps exec, env and tags", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `
+			export const options = {scenarios: {foo: {
+				executor: 'constant-vus', vus: 5, duration: '1h', exec: 'other',
+				env: {MYVAR: 'hello'}, tags: {mytag: 'x'},
+			}}};
+			export function other() { console.log("other-" + __ENV.MYVAR); }
+			export default function() { console.log("wrong"); }
+			export function setup() { console.log("setup-marker"); }
+			export function teardown() { console.log("teardown-marker"); }`,
+			[]string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		stdout := ts.Stdout.String()
+		assert.Equal(t, 1, strings.Count(stdout, "other-hello"))
+		assert.NotContains(t, stdout, "wrong")
+		assert.Contains(t, stdout, "setup-marker")
+		assert.Contains(t, stdout, "teardown-marker")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `
+			export const options = {scenarios: {
+				a: {executor: 'shared-iterations'}, b: {executor: 'shared-iterations'},
+			}};
+			export default function() {}`,
+			[]string{"--once", "--log-output=stdout"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Contains(t, ts.Stdout.String(), "--once can run a single scenario only")
+	})
+
+	t.Run("combined with shortcut flags", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `export default function() {}`,
+			[]string{"--once", "--iterations", "10", "--log-output=stdout"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Contains(t, ts.Stdout.String(), "--once cannot be combined with --iterations")
+	})
+}
diff --git a/lib/executor/once.go b/lib/executor/once.go
new file mode 100644
index 0000000..9cb3fe4
--- /dev/null
+++ b/lib/executor/once.go
@@ -0,0 +1,61 @@
+package executor
+
+import (
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+)
+
+// OnceScenarioError is returned by DeriveOnceScenarios when the options can't
+// be turned into a single-run configuration.
+type OnceScenarioError string
+
+func (e OnceScenarioError) Error() string {
+	return string(e)
+}
+
+var _ error = OnceScenarioError("")
+
+// DeriveOnceScenarios transforms the supplied options so that the test runs
+// with exactly 1 VU and 1 iteration.
+//
+// If no scenarios are configured, a default scenario is created. If there is
+// exactly one scenario, it is replaced with a shared-iterations executor that
+// preserves its name, exec, env, tags and scenario options, while discarding
+// every other field (e.g. vus, iterations, duration, stages, startTime). It is
+// an error to have more than one scenario.
+//
+// The execution shortcuts (vus, iterations, duration, stages) are cleared, as
+// they are superseded by the generated scenario.
+func DeriveOnceScenarios(opts lib.Options) (lib.Options, error) {
+	result := opts
+
+	if len(opts.Scenarios) > 1 {
+		return opts, OnceScenarioError("--once can run a single scenario only")
+	}
+
+	name := lib.DefaultScenarioName
+	once := NewSharedIterationsConfig(name)
+	for scName, sc := range opts.Scenarios {
+		name = scName
+		once = NewSharedIterationsConfig(name)
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			once.Exec = null.StringFrom(exec)
+		}
+		once.Env = sc.GetEnv()
+		once.Tags = sc.GetTags()
+		once.Options = sc.GetScenarioOptions()
+	}
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	result.Scenarios = lib.ScenarioConfigs{name: once}
+	result.VUs = null.Int{}
+	result.Iterations = null.Int{}
+	result.Duration.Valid = false
+	result.Duration.Duration = 0
+	result.Stages = nil
+
+	return result, nil
+}
diff --git a/lib/executor/once_test.go b/lib/executor/once_test.go
new file mode 100644
index 0000000..fc54bfb
--- /dev/null
+++ b/lib/executor/once_test.go
@@ -0,0 +1,75 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestDeriveOnceScenarios(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts := lib.Options{
+			VUs:        null.IntFrom(5),
+			Iterations: null.IntFrom(10),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages:     []lib.Stage{{Target: null.IntFrom(3)}},
+		}
+		res, err := DeriveOnceScenarios(opts)
+		require.NoError(t, err)
+		assert.False(t, res.VUs.Valid)
+		assert.False(t, res.Iterations.Valid)
+		assert.False(t, res.Duration.Valid)
+		assert.Nil(t, res.Stages)
+		require.Len(t, res.Scenarios, 1)
+		sc, ok := res.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		cfg := NewConstantVUsConfig("foo")
+		cfg.VUs = null.IntFrom(10)
+		cfg.Duration = types.NullDurationFrom(time.Minute)
+		cfg.StartTime = types.NullDurationFrom(5 * time.Second)
+		cfg.Exec = null.StringFrom("myfn")
+		cfg.Env = map[string]string{"A": "b"}
+		cfg.Tags = map[string]string{"t": "v"}
+		cfg.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+
+		res, err := DeriveOnceScenarios(lib.Options{Scenarios: lib.ScenarioConfigs{"foo": cfg}})
+		require.NoError(t, err)
+		require.Len(t, res.Scenarios, 1)
+		sc, ok := res.Scenarios["foo"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "foo", sc.GetName())
+		assert.Equal(t, sharedIterationsType, sc.GetType())
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.Equal(t, "myfn", sc.GetExec())
+		assert.Equal(t, cfg.Env, sc.GetEnv())
+		assert.Equal(t, cfg.Tags, sc.GetTags())
+		assert.Equal(t, cfg.Options, sc.GetScenarioOptions())
+		assert.Zero(t, sc.GetStartTime())
+		assert.False(t, sc.MaxDuration.Valid)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := DeriveOnceScenarios(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": NewPerVUIterationsConfig("a"),
+			"b": NewPerVUIterationsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
