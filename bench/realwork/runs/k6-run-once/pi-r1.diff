+
+// validateOnceFlag returns an error if the --once flag was set together with
+// any of the flags that define the execution shape.
+func validateOnceFlag(flags *pflag.FlagSet) error {
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			return fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+	return nil
+}
+
+// isOnceSet reports whether the command has the --once flag enabled.
+func isOnceSet(flags *pflag.FlagSet) bool {
+	if flags == nil || flags.Lookup("once") == nil {
+		return false
+	}
+	once, err := flags.GetBool("once")
+	return err == nil && once
+}
