+// onceFlagConflicts are the shortcut flags that can't be combined with --once.
+var onceFlagConflicts = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// onceRequested reports whether --once is set, and errors if it is combined
+// with any of the execution shortcut flags.
+func onceRequested(flags *pflag.FlagSet) (bool, error) {
+	if flags == nil || flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceFlagConflicts {
+		if flags.Changed(name) {
+			return false, errext.WithExitCodeIfNone(
+				fmt.Errorf("--once cannot be combined with --%s", name), exitcodes.InvalidConfig)
+		}
+	}
+	return true, nil
+}
