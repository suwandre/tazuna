+func TestOnceRequested(t *testing.T) {
+	t.Parallel()
+
+	newFlags := func(args ...string) *pflag.FlagSet {
+		flags := optionFlagSet()
+		require.NoError(t, flags.Parse(args))
+		return flags
+	}
+
+	once, err := onceRequested(newFlags())
+	require.NoError(t, err)
+	assert.False(t, once)
+
+	once, err = onceRequested(newFlags("--once"))
+	require.NoError(t, err)
+	assert.True(t, once)
+
+	for _, f := range []string{"--iterations=10", "--vus=2", "--duration=1s", "--stage=1s:2"} {
+		_, err = onceRequested(newFlags("--once", f))
+		require.ErrorContains(t, err, "--once cannot be combined with --"+strings.TrimLeft(strings.SplitN(f, "=", 2)[0], "-"))
