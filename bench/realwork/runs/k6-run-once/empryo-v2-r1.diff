diff --git a/lib/executor/once.go b/lib/executor/once.go
new file mode 100644
index 0000000..2990cef
--- /dev/null
+++ b/lib/executor/once.go
@@ -0,0 +1,65 @@
+package executor
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+)
+
+// ApplyOnce rewrites the options so the test runs with exactly 1 VU and 1
+// iteration while preserving the scenario-level exec, env, tags and options.
+//
+// With no scenarios, a default scenario is created. With a single scenario, its
+// executor is replaced with a shared-iterations one. More than one scenario is
+// an error. It is expected to be called after the config consolidation.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	result := opts
+
+	var base BaseConfig
+	name := lib.DefaultScenarioName
+	switch len(opts.Scenarios) {
+	case 0:
+		// No scenarios: shortcuts (vus, iterations, duration, stages) are discarded.
+	case 1:
+		for n, sc := range opts.Scenarios {
+			name = n
+			base = BaseConfig{
+				Exec:    null.NewString(sc.GetExec(), sc.GetExec() != ""),
+				Env:     sc.GetEnv(),
+				Tags:    sc.GetTags(),
+				Options: sc.GetScenarioOptions(),
+			}
+		}
+	default:
+		names := make([]string, 0, len(opts.Scenarios))
+		for n := range opts.Scenarios {
+			names = append(names, n)
+		}
+		sort.Strings(names)
+		return opts, ExecutionConflictError(fmt.Sprintf(
+			"--once can run a single scenario only, but the script defines %d: %s",
+			len(names), strings.Join(names, ", "),
+		))
+	}
+
+	sic := NewSharedIterationsConfig(name)
+	sic.Exec = base.Exec
+	sic.Env = base.Env
+	sic.Tags = base.Tags
+	sic.Options = base.Options
+	sic.VUs = null.IntFrom(1)
+	sic.Iterations = null.IntFrom(1)
+
+	result.Scenarios = lib.ScenarioConfigs{name: sic}
+	result.VUs = null.Int{}
+	result.Iterations = null.Int{}
+	result.Duration.Valid = false
+	result.Duration.Duration = 0
+	result.Stages = nil
+
+	return result, nil
+}
diff --git a/lib/executor/once_test.go b/lib/executor/once_test.go
new file mode 100644
index 0000000..d7ecaee
--- /dev/null
+++ b/lib/executor/once_test.go
@@ -0,0 +1,69 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+	opts := lib.Options{
+		VUs:        null.IntFrom(10),
+		Iterations: null.IntFrom(100),
+		Duration:   types.NullDurationFrom(time.Minute),
+		Stages:     []lib.Stage{{Target: null.IntFrom(5)}},
+	}
+	got, err := ApplyOnce(opts)
+	require.NoError(t, err)
+	assert.False(t, got.VUs.Valid)
+	assert.False(t, got.Iterations.Valid)
+	assert.False(t, got.Duration.Valid)
+	assert.Nil(t, got.Stages)
+	require.Len(t, got.Scenarios, 1)
+	sic, ok := got.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+	require.True(t, ok)
+	assert.Equal(t, int64(1), sic.VUs.Int64)
+	assert.Equal(t, int64(1), sic.Iterations.Int64)
+}
+
+func TestApplyOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+	rv := NewRampingVUsConfig("web")
+	rv.Exec = null.StringFrom("fn")
+	rv.Env = map[string]string{"A": "b"}
+	rv.Tags = map[string]string{"t": "v"}
+	rv.StartVUs = null.IntFrom(20)
+	rv.StartTime = types.NullDurationFrom(time.Minute)
+	rv.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+
+	got, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"web": rv}})
+	require.NoError(t, err)
+	require.Len(t, got.Scenarios, 1)
+	sic, ok := got.Scenarios["web"].(SharedIterationsConfig)
+	require.True(t, ok)
+	assert.Equal(t, "web", sic.Name)
+	assert.Equal(t, "fn", sic.GetExec())
+	assert.Equal(t, rv.Env, sic.Env)
+	assert.Equal(t, rv.Tags, sic.Tags)
+	assert.Equal(t, rv.Options, sic.Options)
+	assert.Equal(t, int64(1), sic.VUs.Int64)
+	assert.Equal(t, int64(1), sic.Iterations.Int64)
+	assert.Zero(t, sic.StartTime.Duration)
+	assert.Empty(t, sic.Validate())
+}
+
+func TestApplyOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+	_, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+		"a": NewConstantVUsConfig("a"),
+		"b": NewConstantVUsConfig("b"),
+	}})
+	require.ErrorContains(t, err, "--once can run a single scenario only")
+}
