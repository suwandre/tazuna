@@ -0,0 +1,120 @@
+package cmd
+
+import (
+	"testing"
+
+	"github.com/spf13/pflag"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/errext"
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func onceTestFlags(t *testing.T, args ...string) *pflag.FlagSet {
+	t.Helper()
+	flags := pflag.NewFlagSet("", pflag.ContinueOnError)
+	flags.AddFlagSet(optionFlagSet())
+	flags.AddFlagSet(onceFlagSet())
+	require.NoError(t, flags.Parse(args))
+	return flags
+}
+
+func TestApplyOnceFlag(t *testing.T) {
+	t.Parallel()
+
+	t.Run("flag not defined or not set is a no-op", func(t *testing.T) {
+		t.Parallel()
+		conf := Config{Options: lib.Options{VUs: null.IntFrom(5)}}
+
+		got, err := applyOnceFlag(pflag.NewFlagSet("", pflag.ContinueOnError), conf)
+		require.NoError(t, err)
+		assert.Equal(t, conf, got)
+
+		got, err = applyOnceFlag(onceTestFlags(t), conf)
+		require.NoError(t, err)
+		assert.Equal(t, conf, got)
+	})
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		conf := Config{Options: lib.Options{
+			VUs:        null.IntFrom(5),
+			Iterations: null.IntFrom(50),
+			Duration:   types.NullDurationFrom(10),
+			Stages:     []lib.Stage{{Duration: types.NullDurationFrom(10)}},
+		}}
+
+		got, err := applyOnceFlag(onceTestFlags(t, "--once"), conf)
+		require.NoError(t, err)
+
+		assert.False(t, got.VUs.Valid)
+		assert.False(t, got.Iterations.Valid)
+		assert.False(t, got.Duration.Valid)
+		assert.Nil(t, got.Stages)
+		require.Len(t, got.Scenarios, 1)
+		sc, ok := got.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, "default", sc.GetExec())
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		original := executor.NewConstantVUsConfig("foo")
+		original.VUs = null.IntFrom(10)
+		original.Duration = types.NewNullDuration(60, true)
+		original.StartTime = types.NewNullDuration(30, true)
+		original.Exec = null.StringFrom("other")
+		original.Env = map[string]string{"A": "b"}
+		original.Tags = map[string]string{"c": "d"}
+		original.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		conf := Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{"foo": original}}}
+
+		got, err := applyOnceFlag(onceTestFlags(t, "--once"), conf)
+		require.NoError(t, err)
+
+		require.Len(t, got.Scenarios, 1)
+		sc, ok := got.Scenarios["foo"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "foo", sc.Name)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, "other", sc.GetExec())
+		assert.Equal(t, original.Env, sc.Env)
+		assert.Equal(t, original.Tags, sc.Tags)
+		assert.Equal(t, original.Options, sc.Options)
+		assert.False(t, sc.StartTime.Valid)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		conf := Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": executor.NewConstantVUsConfig("a"),
+			"b": executor.NewConstantVUsConfig("b"),
+		}}}
+
+		_, err := applyOnceFlag(onceTestFlags(t, "--once"), conf)
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+		var withCode errext.HasExitCode
+		require.ErrorAs(t, err, &withCode)
+		assert.Equal(t, exitcodes.InvalidConfig, withCode.ExitCode())
+	})
+
+	for _, flagArgs := range [][]string{
+		{"--vus", "2"}, {"--iterations", "3"}, {"--duration", "1s"}, {"--stage", "1s:2"},
+	} {
+		t.Run("conflicts with "+flagArgs[0], func(t *testing.T) {
+			t.Parallel()
+
+			_, err := applyOnceFlag(onceTestFlags(t, append([]string{"--once"}, flagArgs...)...), Config{})
+			require.ErrorContains(t, err, "--once cannot be combined with "+flagArgs[0])
+		})
+	}
+}
