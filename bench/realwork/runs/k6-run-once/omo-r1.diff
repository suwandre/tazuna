diff --git a/internal/cmd/tests/cmd_run_once_test.go b/internal/cmd/tests/cmd_run_once_test.go
new file mode 100644
index 0000000..3029c9d
--- /dev/null
+++ b/internal/cmd/tests/cmd_run_once_test.go
@@ -0,0 +1,160 @@
+package tests
+
+import (
+	"archive/tar"
+	"bytes"
+	"errors"
+	"io"
+	"path/filepath"
+	"testing"
+
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+const onceSingleScenarioScript = `
+	export const options = {
+		vus: 5,
+		scenarios: {
+			foo: {
+				executor: 'constant-vus',
+				vus: 10,
+				duration: '1h',
+				exec: 'other',
+				env: { FROM_SCENARIO: 'yes' },
+				tags: { scenario_tag: 'present' },
+			},
+		},
+	};
+
+	export function setup() { console.log('setup called'); }
+	export function teardown() { console.log('teardown called'); }
+	export default function () { console.log('default called'); }
+	export function other() { console.log('other called, env=' + __ENV.FROM_SCENARIO); }
+`
+
+func TestRunOnceWithoutScenarios(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `
+		export const options = { vus: 10, duration: '1h' };
+		export function setup() { console.log('setup called'); }
+		export function teardown() { console.log('teardown called'); }
+		export default function () { console.log('default called'); }
+	`, []string{"--once", "--log-output=stdout"}, 0)
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Equal(t, 1, bytes.Count([]byte(stdout), []byte("default called")))
+	assert.Contains(t, stdout, "setup called")
+	assert.Contains(t, stdout, "teardown called")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+}
+
+func TestRunOnceKeepsSingleScenarioConfig(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, onceSingleScenarioScript,
+		[]string{"--once", "--log-output=stdout", "--out", "json=results.json", "--no-usage-report"}, 0)
+
+	results := runAndReadResults(t, ts)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "other called, env=yes")
+	assert.NotContains(t, stdout, "default called")
+	assert.Contains(t, stdout, "setup called")
+	assert.Contains(t, stdout, "teardown called")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+
+	tagged := getSampleValues(t, results, "iterations",
+		map[string]string{"scenario": "foo", "scenario_tag": "present"})
+	assert.Len(t, tagged, 1)
+}
+
+func TestRunOnceMultipleScenariosFails(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `
+		export const options = {
+			scenarios: {
+				a: { executor: 'constant-vus', vus: 1, duration: '1s' },
+				b: { executor: 'constant-vus', vus: 1, duration: '1s' },
+			},
+		};
+		export default function () {}
+	`, []string{"--once"}, exitcodes.InvalidConfig)
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.True(t, testutils.LogContains(
+		ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once can run a single scenario only"))
+}
+
+func TestRunOnceConflictsWithShortcutFlags(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range []struct{ flag, value string }{
+		{"--vus", "2"},
+		{"--iterations", "10"},
+		{"--duration", "10s"},
+		{"--stage", "10s:5"},
+	} {
+		t.Run(tc.flag, func(t *testing.T) {
+			t.Parallel()
+
+			ts := getSingleFileTestState(t, `export default function () {}`,
+				[]string{"--once", tc.flag, tc.value}, exitcodes.InvalidConfig)
+
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.True(t, testutils.LogContains(
+				ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once cannot be combined with "+tc.flag))
+		})
+	}
+}
+
+func TestArchiveOnceKeepsSingleScenarioConfig(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(onceSingleScenarioScript), 0o644))
+	archivePath := filepath.Join(ts.Cwd, "archive.tar")
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", archivePath, "test.js"}
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	data, err := fsext.ReadFile(ts.FS, archivePath)
+	require.NoError(t, err)
+
+	var metadata []byte
+	tr := tar.NewReader(bytes.NewReader(data))
+	for {
+		hdr, err := tr.Next()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		require.NoError(t, err)
+		if hdr.Name == "metadata.json" {
+			metadata, err = io.ReadAll(tr)
+			require.NoError(t, err)
+		}
+	}
+	require.NotEmpty(t, metadata)
+
+	scenario := gjson.GetBytes(metadata, "options.scenarios.foo")
+	assert.Equal(t, "shared-iterations", scenario.Get("executor").String())
+	assert.EqualValues(t, 1, scenario.Get("vus").Int())
+	assert.EqualValues(t, 1, scenario.Get("iterations").Int())
+	assert.Equal(t, "other", scenario.Get("exec").String())
+	assert.Equal(t, "yes", scenario.Get("env.FROM_SCENARIO").String())
+	assert.Equal(t, "present", scenario.Get("tags.scenario_tag").String())
+	assert.False(t, gjson.GetBytes(metadata, "options.vus").Exists() && gjson.GetBytes(metadata, "options.vus").Type != gjson.Null)
+}
