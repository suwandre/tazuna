diff --git a/internal/cmd/once.go b/internal/cmd/once.go
new file mode 100644
index 0000000..fcb8e91
--- /dev/null
+++ b/internal/cmd/once.go
@@ -0,0 +1,88 @@
+package cmd
+
+import (
+	"fmt"
+	"maps"
+	"slices"
+	"strings"
+
+	"github.com/spf13/pflag"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/errext"
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+const onceFlagName = "once"
+
+// onceFlagSet returns a FlagSet with the --once flag.
+func onceFlagSet() *pflag.FlagSet {
+	flags := pflag.NewFlagSet("", 0)
+	flags.SortFlags = false
+	flags.Bool(
+		onceFlagName,
+		false,
+		"run the script with 1 VU and 1 iteration, preserving the scenario configuration (exec, env, tags, options)",
+	)
+	return flags
+}
+
+// applyOnceFlag transforms the consolidated config so the script runs with 1 VU and 1 iteration, if the --once
+// flag is set. It does nothing for commands that don't define the flag.
+//
+// It has to run after the config consolidation, since scenarios can come from any of the config sources.
+// The scenario is replaced by a shared-iterations one that keeps only its name, exec, env, tags and options.
+func applyOnceFlag(flags *pflag.FlagSet, conf Config) (Config, error) {
+	if flags.Lookup(onceFlagName) == nil {
+		return conf, nil
+	}
+	once, err := flags.GetBool(onceFlagName)
+	if err != nil {
+		return conf, err
+	}
+	if !once {
+		return conf, nil
+	}
+
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			return conf, errext.WithExitCodeIfNone(
+				fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name), exitcodes.InvalidConfig)
+		}
+	}
+
+	if len(conf.Scenarios) > 1 {
+		names := slices.Sorted(maps.Keys(conf.Scenarios))
+		return conf, errext.WithExitCodeIfNone(
+			fmt.Errorf("--%s can run a single scenario only, but the script defines %d: %s",
+				onceFlagName, len(names), strings.Join(names, ", ")),
+			exitcodes.InvalidConfig,
+		)
+	}
+
+	scenario := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	for _, existing := range conf.Scenarios {
+		scenario.Name = existing.GetName()
+		if exec := existing.GetExec(); exec != consts.DefaultFn {
+			scenario.Exec = null.StringFrom(exec)
+		}
+		scenario.Env = existing.GetEnv()
+		scenario.Tags = existing.GetTags()
+		scenario.Options = existing.GetScenarioOptions()
+	}
+	scenario.VUs = null.IntFrom(1)
+	scenario.Iterations = null.IntFrom(1)
+
+	// The execution shortcuts would conflict with the scenario when deriving the config.
+	conf.VUs = null.Int{}
+	conf.Iterations = null.Int{}
+	conf.Duration = types.NullDuration{}
+	conf.Stages = nil
+	conf.Scenarios = lib.ScenarioConfigs{scenario.Name: scenario}
+
+	return conf, nil
+}
diff --git a/internal/cmd/once_test.go b/internal/cmd/once_test.go
