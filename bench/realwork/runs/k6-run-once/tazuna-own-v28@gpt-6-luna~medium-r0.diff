+func applyOnceMode(flags *pflag.FlagSet, conf *Config) error {
+	for _, flag := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(flag) {
+			return fmt.Errorf("--once cannot be combined with --%s", flag)
+		}
+	}
+
+	if len(conf.Scenarios) > 1 {
+		return errors.New("--once can run a single scenario only")
+	}
+
+	var name string
+	var scenario lib.ExecutorConfig
+	for scenarioName, configured := range conf.Scenarios {
+		name, scenario = scenarioName, configured
+	}
+	if scenario == nil {
+		name = lib.DefaultScenarioName
+		scenario = executor.NewSharedIterationsConfig(name)
+	}
+
+	shared := executor.NewSharedIterationsConfig(name)
+	shared.Exec = null.StringFrom(scenario.GetExec())
+	shared.Env = scenario.GetEnv()
+	shared.Tags = scenario.GetTags()
+	shared.Options = scenario.GetScenarioOptions()
+	conf.Scenarios = lib.ScenarioConfigs{name: shared}
+	conf.VUs = null.Int{}
+	conf.Iterations = null.Int{}
+	conf.Duration = types.NullDuration{}
+	conf.Stages = nil
+	return nil
+}
