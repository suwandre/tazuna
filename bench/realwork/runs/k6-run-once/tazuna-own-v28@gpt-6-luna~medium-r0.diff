+func TestApplyOnceMode(t *testing.T) {
+	flags := pflag.NewFlagSet("", pflag.ContinueOnError)
+	flags.Bool("once", false, "")
+	conf := Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{
+		"scenario": executor.ConstantVUsConfig{
+			BaseConfig: executor.BaseConfig{
+				Name: "scenario", Type: "constant-vus", Exec: null.StringFrom("custom"),
+				Env: map[string]string{"KEY": "value"}, Tags: map[string]string{"tag": "value"},
+				Options: &lib.ScenarioOptions{},
+			},
+		},
+	}}}
+
+	require.NoError(t, applyOnceMode(flags, &conf))
+	require.Len(t, conf.Scenarios, 1)
+	scenario := conf.Scenarios["scenario"]
+	assert.Equal(t, "custom", scenario.GetExec())
+	assert.Equal(t, map[string]string{"KEY": "value"}, scenario.GetEnv())
+	assert.Equal(t, map[string]string{"tag": "value"}, scenario.GetTags())
+	assert.NotNil(t, scenario.GetScenarioOptions())
+	assert.Equal(t, "shared-iterations", scenario.GetType())
+}
+
+func TestApplyOnceModeErrors(t *testing.T) {
+	t.Run("multiple scenarios", func(t *testing.T) {
+		flags := pflag.NewFlagSet("", pflag.ContinueOnError)
+		conf := Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{
+			"one": executor.NewSharedIterationsConfig("one"),
+			"two": executor.NewSharedIterationsConfig("two"),
+		}}}
+		err := applyOnceMode(flags, &conf)
+		require.EqualError(t, err, "--once can run a single scenario only")
+	})
+
+	t.Run("shortcut option", func(t *testing.T) {
+		flags := pflag.NewFlagSet("", pflag.ContinueOnError)
+		flags.Int64("iterations", 0, "")
+		require.NoError(t, flags.Set("iterations", "2"))
+		err := applyOnceMode(flags, &Config{})
+		require.EqualError(t, err, "--once cannot be combined with --iterations")
+	})
+}
