+// onceConflictingFlags are the CLI flags that define the execution shape and therefore cannot be
+// combined with --once. They are checked in this order.
+var onceConflictingFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// applyOnce implements the --once flag. When it is set, the execution configuration is replaced by
+// a single shared-iterations scenario that runs 1 VU for 1 iteration. If the configuration has
+// exactly one scenario, the new scenario keeps its name, exec, env, tags and options. Otherwise, it
+// uses the default scenario name. The shortcut options (vus, iterations, duration, stages) are
+// cleared, so they can't conflict with the generated scenario. Setup and teardown are not affected.
+//
+// conf is returned unchanged when the flag is not set or when flags doesn't define it. The
+// original scenarios map is never modified.
+func applyOnce(conf Config, flags *pflag.FlagSet) (Config, error) {
+	if flags == nil || flags.Lookup("once") == nil {
+		return conf, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil {
+		return conf, err
+	}
+	if !once {
+		return conf, nil
+	}
+
+	for _, name := range onceConflictingFlags {
+		if flags.Changed(name) {
+			err := fmt.Errorf("--once cannot be combined with --%s", name)
+			return conf, errext.WithExitCodeIfNone(err, exitcodes.InvalidConfig)
+		}
+	}
+
+	if len(conf.Scenarios) > 1 {
+		names := slices.Sorted(maps.Keys(conf.Scenarios))
+		err := fmt.Errorf("--once can run a single scenario only, but the script defines %d scenarios: %s",
+			len(names), strings.Join(names, ", "))
+		return conf, errext.WithExitCodeIfNone(err, exitcodes.InvalidConfig)
+	}
+
+	onceScenario := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	onceScenario.VUs = null.IntFrom(1)
+	onceScenario.Iterations = null.IntFrom(1)
+	// There is at most one scenario here, so this loop runs zero or one times.
+	for name, sc := range conf.Scenarios {
+		onceScenario.Name = name
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			onceScenario.Exec = null.StringFrom(exec)
+		}
+		onceScenario.Env = maps.Clone(sc.GetEnv())
+		onceScenario.Tags = maps.Clone(sc.GetTags())
+		onceScenario.Options = sc.GetScenarioOptions()
+	}
+
+	conf.Scenarios = lib.ScenarioConfigs{onceScenario.Name: onceScenario}
+	conf.VUs = null.Int{}
+	conf.Iterations = null.Int{}
+	conf.Duration = types.NullDuration{}
+	conf.Stages = nil
+
+	return conf, nil
+}
