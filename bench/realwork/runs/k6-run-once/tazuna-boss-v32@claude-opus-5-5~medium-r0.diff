+// TestRunOnceRunsSingleScenarioOnceWithPreservedConfig verifies that --once runs the exec function
+// of the only scenario exactly once, with the scenario's env still applied.
+func TestRunOnceRunsSingleScenarioOnceWithPreservedConfig(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		import exec from 'k6/execution';
+
+		export const options = {
+			scenarios: {
+				foo: {
+					executor: 'constant-vus',
+					vus: 5,
+					duration: '10s',
+					exec: 'foo',
+					env: { MYVAR: 'x' },
+					tags: { t: 'y' },
+				},
+			},
+		};
+
+		export default function () {
+			console.log('default should not run');
+		}
+
+		export function foo() {
+			console.log('foo ' + exec.scenario.name + ' ' + __ENV.MYVAR);
+		}
+	`
+
+	ts := getSingleFileTestState(t, script, []string{"--once"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	var fooLines, defaultLines int
+	for _, entry := range ts.LoggerHook.Drain() {
+		switch entry.Message {
+		case "foo foo x":
+			fooLines++
+		case "default should not run":
+			defaultLines++
+		}
+	}
+	assert.Equal(t, 1, fooLines, "foo should run exactly once")
+	assert.Equal(t, 0, defaultLines, "default should not run")
+	assert.Contains(t, ts.Stdout.String(), "1 complete and 0 interrupted iterations")
+}
+
+// TestRunOnceWithMultipleScenariosFails verifies that --once is rejected for scripts that define
+// more than one scenario.
+func TestRunOnceWithMultipleScenariosFails(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				b: { executor: 'shared-iterations', vus: 1, iterations: 1 },
+				a: { executor: 'shared-iterations', vus: 1, iterations: 1 },
+			},
+		};
+
+		export default function () {}
+	`
+
+	ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.Contains(t, ts.Stderr.String(),
+		"--once can run a single scenario only, but the script defines 2 scenarios: a, b")
+}
