+package cmd
+
+import (
+	"testing"
+	"time"
+
+	"github.com/spf13/pflag"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/errext"
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("flag not set returns config unchanged", func(t *testing.T) {
+		t.Parallel()
+
+		flags := optionFlagSet()
+		conf := Config{Options: lib.Options{VUs: null.IntFrom(3)}}
+		result, err := applyOnce(conf, flags)
+		require.NoError(t, err)
+		assert.Equal(t, conf, result)
+	})
+
+	t.Run("nil flag set returns config unchanged", func(t *testing.T) {
+		t.Parallel()
+
+		conf := Config{Options: lib.Options{VUs: null.IntFrom(3)}}
+		result, err := applyOnce(conf, nil)
+		require.NoError(t, err)
+		assert.Equal(t, conf, result)
+	})
+
+	t.Run("flag set not defining once returns config unchanged", func(t *testing.T) {
+		t.Parallel()
+
+		flags := pflag.NewFlagSet("", pflag.ContinueOnError)
+		conf := Config{Options: lib.Options{VUs: null.IntFrom(3)}}
+		result, err := applyOnce(conf, flags)
+		require.NoError(t, err)
+		assert.Equal(t, conf, result)
+	})
+
+	t.Run("once=false returns config unchanged", func(t *testing.T) {
+		t.Parallel()
+
+		flags := optionFlagSet()
+		require.NoError(t, flags.Set("once", "false"))
+		conf := Config{Options: lib.Options{VUs: null.IntFrom(3)}}
+		result, err := applyOnce(conf, flags)
+		require.NoError(t, err)
+		assert.Equal(t, conf, result)
+	})
+
+	t.Run("no scenarios gives a default 1 VU 1 iteration scenario", func(t *testing.T) {
+		t.Parallel()
+
+		flags := optionFlagSet()
+		require.NoError(t, flags.Set("once", "true"))
+		conf := Config{Options: lib.Options{
+			Duration: types.NullDurationFrom(time.Minute),
+			Stages:   []lib.Stage{{Duration: types.NullDurationFrom(time.Second)}},
+		}}
+
+		result, err := applyOnce(conf, flags)
+		require.NoError(t, err)
+
+		require.Len(t, result.Scenarios, 1)
+		sc, ok := result.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, lib.DefaultScenarioName, sc.GetName())
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, consts.DefaultFn, sc.GetExec())
+		assert.False(t, result.Duration.Valid)
+		assert.Nil(t, result.Stages)
+		assert.False(t, result.VUs.Valid)
+		assert.False(t, result.Iterations.Valid)
+	})
+
+	t.Run("single scenario keeps its name, exec, env, tags and options", func(t *testing.T) {
+		t.Parallel()
+
+		flags := optionFlagSet()
+		require.NoError(t, flags.Set("once", "true"))
+
+		orig := executor.NewConstantVUsConfig("foo")
+		orig.VUs = null.IntFrom(5)
+		orig.Duration = types.NullDurationFrom(10 * time.Second)
+		orig.Exec = null.StringFrom("bar")
+		orig.Env = map[string]string{"MYVAR": "x"}
+		orig.Tags = map[string]string{"t": "y"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		origScenarios := lib.ScenarioConfigs{"foo": orig}
+		conf := Config{Options: lib.Options{Scenarios: origScenarios}}
+
+		result, err := applyOnce(conf, flags)
+		require.NoError(t, err)
+
+		require.Len(t, result.Scenarios, 1)
+		sc, ok := result.Scenarios["foo"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "foo", sc.GetName())
+		assert.Equal(t, "shared-iterations", sc.GetType())
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, "bar", sc.GetExec())
+		assert.Equal(t, map[string]string{"MYVAR": "x"}, sc.GetEnv())
+		assert.Equal(t, map[string]string{"t": "y"}, sc.GetTags())
+		assert.Equal(t, orig.Options, sc.GetScenarioOptions())
+
+		// The original scenarios must not be modified
+		assert.Equal(t, lib.ScenarioConfigs{"foo": orig}, origScenarios)
+	})
+
+	t.Run("scenario maps are cloned, not shared", func(t *testing.T) {
+		t.Parallel()
+
+		flags := optionFlagSet()
+		require.NoError(t, flags.Set("once", "true"))
+
+		orig := executor.NewConstantVUsConfig("foo")
+		orig.Env = map[string]string{"MYVAR": "x"}
+		orig.Tags = map[string]string{"t": "y"}
+		conf := Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{"foo": orig}}}
+
+		result, err := applyOnce(conf, flags)
+		require.NoError(t, err)
+
+		sc, ok := result.Scenarios["foo"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		sc.Env["MYVAR"] = "changed"
+		sc.Tags["t"] = "changed"
+		assert.Equal(t, "x", orig.Env["MYVAR"])
+		assert.Equal(t, "y", orig.Tags["t"])
+	})
+
+	conflictCases := []struct {
+		name string
+		set  map[string]string
+		want string
+	}{
+		{name: "vus", set: map[string]string{"vus": "2"}, want: "--once cannot be combined with --vus"},
+		{
+			name: "iterations",
+			set:  map[string]string{"iterations": "10"},
+			want: "--once cannot be combined with --iterations",
+		},
+		{name: "duration", set: map[string]string{"duration": "10s"}, want: "--once cannot be combined with --duration"},
+		{name: "stage", set: map[string]string{"stage": "10s:5"}, want: "--once cannot be combined with --stage"},
+		{
+			name: "first conflicting flag wins",
+			set:  map[string]string{"duration": "10s", "vus": "2"},
+			want: "--once cannot be combined with --vus",
+		},
+	}
+	for _, tc := range conflictCases {
+		t.Run("conflict: "+tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			flags := optionFlagSet()
+			require.NoError(t, flags.Set("once", "true"))
+			for k, v := range tc.set {
+				require.NoError(t, flags.Set(k, v))
+			}
+
+			_, err := applyOnce(Config{}, flags)
+			require.Error(t, err)
+			assert.Equal(t, tc.want, err.Error())
+			var ecerr errext.HasExitCode
+			require.ErrorAs(t, err, &ecerr)
+			assert.Equal(t, exitcodes.InvalidConfig, ecerr.ExitCode())
+		})
+	}
+
+	t.Run("multiple scenarios are rejected with sorted names", func(t *testing.T) {
+		t.Parallel()
+
+		flags := optionFlagSet()
+		require.NoError(t, flags.Set("once", "true"))
+		conf := Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{
+			"b": executor.NewSharedIterationsConfig("b"),
+			"a": executor.NewConstantVUsConfig("a"),
+		}}}
+
+		_, err := applyOnce(conf, flags)
+		require.Error(t, err)
+		assert.Equal(t,
+			"--once can run a single scenario only, but the script defines 2 scenarios: a, b",
+			err.Error())
+		var ecerr errext.HasExitCode
+		require.ErrorAs(t, err, &ecerr)
+		assert.Equal(t, exitcodes.InvalidConfig, ecerr.ExitCode())
+	})
+}
