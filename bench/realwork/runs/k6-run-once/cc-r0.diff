+package tests
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func logMessages(ts *GlobalTestState) []string {
+	var msgs []string
+	for _, e := range ts.LoggerHook.Drain() {
+		if e.Level == logrus.InfoLevel {
+			msgs = append(msgs, e.Message)
+		}
+	}
+	return msgs
+}
+
+func TestRunOnceWithoutScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {vus: 5, iterations: 20};
+		export default function () { console.log('default'); }
+		export function setup() { console.log('setup'); }
+		export function teardown() { console.log('teardown'); }
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.Equal(t, []string{"setup", "default", "teardown"}, logMessages(ts))
+	assert.Contains(t, ts.Stdout.String(), "1 iterations shared among 1 VUs")
+	assert.Contains(t, ts.Stdout.String(), "1 complete and 0 interrupted iterations")
+}
+
+func TestRunOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		import exec from 'k6/execution';
+
+		export const options = {
+			scenarios: {
+				only: {
+					executor: 'constant-vus',
+					vus: 5,
+					duration: '1h',
+					exec: 'custom',
+					env: {FOO: 'bar'},
+					tags: {team: 'a'},
+				},
+			},
+		};
+		export function custom() {
+			console.log(exec.scenario.name + ' ' + __ENV.FOO + ' ' + exec.vu.metrics.tags.team);
+		}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.Equal(t, []string{"only bar a"}, logMessages(ts))
+	assert.Contains(t, ts.Stdout.String(), "1 iterations shared among 1 VUs")
+	assert.Contains(t, ts.Stdout.String(), "1 complete and 0 interrupted iterations")
+}
+
+func TestRunOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				one: {executor: 'constant-vus', vus: 1, duration: '1m'},
+				two: {executor: 'constant-vus', vus: 1, duration: '1m'},
+			},
+		};
+		export default function () {}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.True(t, testutils.LogContains(
+		ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once can run a single scenario only"))
+}
+
+func TestRunOnceConflictingFlags(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name     string
+		flags    []string
+		expected string
+	}{
+		{"iterations", []string{"--iterations", "10"}, "--once cannot be combined with --iterations"},
+		{"vus", []string{"--vus", "2"}, "--once cannot be combined with --vus"},
+		{"duration", []string{"-d", "10s"}, "--once cannot be combined with --duration"},
+		{"stage", []string{"--stage", "10s:5"}, "--once cannot be combined with --stage"},
+		{
+			"multiple", []string{"-u", "2", "-i", "2"},
+			"--once cannot be combined with --vus, --iterations",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			ts := getSingleFileTestState(
+				t, `export default function () {}`, append([]string{"--once"}, tc.flags...), exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.True(t, testutils.LogContains(ts.LoggerHook.Drain(), logrus.ErrorLevel, tc.expected))
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	script := `
+		export const options = {
+			scenarios: {
+				only: {executor: 'constant-vus', vus: 5, duration: '1h', exec: 'custom', env: {FOO: 'bar'}},
+			},
+		};
+		export function custom() {}
+	`
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(script), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "test.js"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	require.NoError(t, testutils.Untar(t, ts.FS, "archive.tar", "tmp/"))
+	data, err := fsext.ReadFile(ts.FS, "tmp/metadata.json")
+	require.NoError(t, err)
+
+	md := string(data)
+	assert.Contains(t, md, `"executor": "shared-iterations"`)
+	assert.Contains(t, md, `"exec": "custom"`)
+	assert.Contains(t, md, `"FOO": "bar"`)
+	assert.False(t, strings.Contains(md, "constant-vus"))
+}
