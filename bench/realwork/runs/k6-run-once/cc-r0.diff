+// onceConflictingFlags are the execution shortcut flags that can't be combined with --once.
+var onceConflictingFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// isOnceSet returns whether the --once flag is registered in the flag set and was enabled.
+func isOnceSet(flags *pflag.FlagSet) (bool, error) {
+	if flags.Lookup("once") == nil {
+		return false, nil
+	}
+	return flags.GetBool("once")
+}
+
+// validateOnceFlag returns an error if --once was combined with any of the execution shortcut flags.
+func validateOnceFlag(flags *pflag.FlagSet) error {
+	once, err := isOnceSet(flags)
+	if err != nil || !once {
+		return err
+	}
+
+	var conflicts []string
+	for _, name := range onceConflictingFlags {
+		if flags.Changed(name) {
+			conflicts = append(conflicts, "--"+name)
+		}
+	}
+	if len(conflicts) > 0 {
+		return fmt.Errorf("--once cannot be combined with %s", strings.Join(conflicts, ", "))
+	}
+	return nil
+}
