@@ -0,0 +1,120 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts := lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second), Target: null.IntFrom(5)}},
+		}
+
+		result, err := ApplyOnce(opts)
+		require.NoError(t, err)
+
+		assert.False(t, result.VUs.Valid)
+		assert.False(t, result.Iterations.Valid)
+		assert.False(t, result.Duration.Valid)
+		assert.Nil(t, result.Stages)
+
+		require.Len(t, result.Scenarios, 1)
+		sc, ok := result.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.Exec.Valid)
+
+		// The result must be stable when it goes through the shortcuts derivation.
+		derived, err := DeriveScenariosFromShortcuts(result, nil)
+		require.NoError(t, err)
+		assert.Equal(t, result.Scenarios, derived.Scenarios)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		original := NewRampingVUsConfig("browser")
+		original.Exec = null.StringFrom("browserTest")
+		original.Env = map[string]string{"FOO": "bar"}
+		original.Tags = map[string]string{"team": "a"}
+		original.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		original.StartTime = types.NullDurationFrom(5 * time.Second)
+		original.GracefulStop = types.NullDurationFrom(time.Minute)
+		original.StartVUs = null.IntFrom(20)
+		opts := lib.Options{
+			VUs:       null.IntFrom(10),
+			Scenarios: lib.ScenarioConfigs{"browser": original},
+		}
+
+		result, err := ApplyOnce(opts)
+		require.NoError(t, err)
+
+		assert.False(t, result.VUs.Valid)
+		require.Len(t, result.Scenarios, 1)
+		sc, ok := result.Scenarios["browser"].(SharedIterationsConfig)
+		require.True(t, ok)
+
+		expected := NewSharedIterationsConfig("browser")
+		expected.VUs = null.IntFrom(1)
+		expected.Iterations = null.IntFrom(1)
+		expected.Exec = null.StringFrom("browserTest")
+		expected.Env = map[string]string{"FOO": "bar"}
+		expected.Tags = map[string]string{"team": "a"}
+		expected.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		assert.Equal(t, expected, sc)
+		assert.Empty(t, sc.Validate())
+
+		// The original options are not modified.
+		assert.Equal(t, lib.ScenarioConfigs{"browser": original}, opts.Scenarios)
+
+		derived, err := DeriveScenariosFromShortcuts(result, nil)
+		require.NoError(t, err)
+		assert.Equal(t, result.Scenarios, derived.Scenarios)
+	})
+
+	t.Run("single scenario with the default exec", func(t *testing.T) {
+		t.Parallel()
+
+		opts := lib.Options{
+			Scenarios: lib.ScenarioConfigs{"only": NewConstantVUsConfig("only")},
+		}
+
+		result, err := ApplyOnce(opts)
+		require.NoError(t, err)
+
+		sc, ok := result.Scenarios["only"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts := lib.Options{
+			Scenarios: lib.ScenarioConfigs{
+				"one": NewConstantVUsConfig("one"),
+				"two": NewConstantVUsConfig("two"),
+			},
+		}
+
+		_, err := ApplyOnce(opts)
+		require.ErrorIs(t, err, ErrOnceMultipleScenarios)
+		assert.Contains(t, err.Error(), "--once can run a single scenario only")
+	})
+}
