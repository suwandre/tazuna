+
+// ErrOnceMultipleScenarios is returned by ApplyOnce() when the options contain more than one scenario.
+var ErrOnceMultipleScenarios = ExecutionConflictError("--once can run a single scenario only")
+
+// ApplyOnce reduces the provided (already consolidated) options to a single run: 1 VU executing 1 iteration.
+//
+// If there are no scenarios, a default one running the default function is created. If there is exactly
+// one, it is replaced by a shared-iterations scenario that keeps the name, exec, env, tags and scenario
+// options of the original one, while everything else (executor type, startTime, gracefulStop, VUs,
+// iterations, duration, stages, etc.) is discarded. More than one scenario is an error.
+//
+// All of the execution shortcut options (vus, iterations, duration, stages) are discarded as well, so
+// that DeriveScenariosFromShortcuts() doesn't override the resulting scenario.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ErrOnceMultipleScenarios
+	}
+
+	name := lib.DefaultScenarioName
+	once := NewSharedIterationsConfig(name)
+	for scenarioName, original := range opts.Scenarios {
+		name = scenarioName
+		once = NewSharedIterationsConfig(name)
+		if exec := original.GetExec(); exec != consts.DefaultFn {
+			once.Exec = null.StringFrom(exec)
+		}
+		once.Env = original.GetEnv()
+		once.Tags = original.GetTags()
+		once.Options = original.GetScenarioOptions()
+	}
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{name: once}
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+
+	return opts, nil
+}
