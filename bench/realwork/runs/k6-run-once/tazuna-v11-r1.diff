+package tests
+
+import (
+	"bytes"
+	"encoding/json"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+const onceSingleScenarioScript = `
+export const options = {
+  scenarios: {
+    main: {
+      executor: 'constant-vus',
+      vus: 5,
+      duration: '1m',
+      exec: 'foo',
+      env: { WHO: 'scenario' },
+      tags: { mytag: 'scenario' },
+    },
+  },
+};
+export function foo() { console.log('foo ' + __ENV.WHO + ' ' + __VU + ' ' + __ITER); }
+export function setup() { console.log('setup'); }
+export function teardown() { console.log('teardown'); }
+`
+
+func runOnce(t *testing.T, script string, args []string, expExitCode exitcodes.ExitCode) *GlobalTestState {
+	t.Helper()
+	ts := getSingleFileTestState(t, script, append([]string{"--log-output=stdout"}, args...), expExitCode)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+	return ts
+}
+
+func TestRunOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	ts := runOnce(t, `export default function() { console.log('iter ' + __ITER); }`, []string{"--once"}, 0)
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Equal(t, 1, strings.Count(stdout, "iter 0"))
+}
+
+func TestRunOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	ts := runOnce(t, onceSingleScenarioScript, []string{"--once"}, 0)
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "main: 1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "foo scenario 1 0")
+	assert.Contains(t, stdout, "setup")
+	assert.Contains(t, stdout, "teardown")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+}
+
+func TestRunOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+export const options = { scenarios: {
+  a: { executor: 'shared-iterations', exec: 'foo' },
+  b: { executor: 'shared-iterations', exec: 'foo' },
+}};
+export function foo() {}`
+	ts := runOnce(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+	assert.Contains(t, ts.Stdout.String(), "--once can run a single scenario only")
+}
+
+func TestRunOnceConflictingFlags(t *testing.T) {
+	t.Parallel()
+
+	for _, flag := range [][]string{
+		{"--iterations", "10"}, {"--vus", "2"}, {"--duration", "10s"}, {"--stage", "1s:2"},
+	} {
+		t.Run(flag[0], func(t *testing.T) {
+			t.Parallel()
+			ts := runOnce(t, `export default function() {}`, append([]string{"--once"}, flag...), exitcodes.InvalidConfig)
+			assert.Contains(t, ts.Stdout.String(), "--once cannot be combined with "+flag[0])
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(onceSingleScenarioScript), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", filepath.Join(ts.Cwd, "out.tar"), "test.js"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	data, err := fsext.ReadFile(ts.FS, filepath.Join(ts.Cwd, "out.tar"))
+	require.NoError(t, err)
+	arc, err := lib.ReadArchive(bytes.NewReader(data))
+	require.NoError(t, err)
+
+	require.Len(t, arc.Options.Scenarios, 1)
+	raw, err := json.Marshal(arc.Options.Scenarios["main"])
+	require.NoError(t, err)
+	var sc map[string]any
+	require.NoError(t, json.Unmarshal(raw, &sc))
+	assert.Equal(t, "shared-iterations", sc["executor"])
+	assert.EqualValues(t, 1, sc["vus"])
+	assert.EqualValues(t, 1, sc["iterations"])
+	assert.Equal(t, "foo", sc["exec"])
+	assert.Equal(t, map[string]any{"WHO": "scenario"}, sc["env"])
+	assert.Equal(t, map[string]any{"mytag": "scenario"}, sc["tags"])
+}
