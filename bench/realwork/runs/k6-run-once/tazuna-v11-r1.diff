@@ -0,0 +1,100 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	requireOnlyScenario := func(t *testing.T, opts lib.Options, name string) SharedIterationsConfig {
+		t.Helper()
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios[name].(SharedIterationsConfig)
+		require.True(t, ok, "expected a shared-iterations scenario named %q", name)
+		assert.Equal(t, name, sc.Name)
+		assert.Equal(t, sharedIterationsType, sc.Type)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		return sc
+	}
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := ApplyOnce(lib.Options{Throw: null.BoolFrom(true)})
+		require.NoError(t, err)
+		sc := requireOnlyScenario(t, opts, lib.DefaultScenarioName)
+		assert.Equal(t, "default", sc.GetExec())
+		assert.Equal(t, null.BoolFrom(true), opts.Throw, "unrelated options are kept")
+	})
+
+	t.Run("empty scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{}})
+		require.NoError(t, err)
+		requireOnlyScenario(t, opts, lib.DefaultScenarioName)
+	})
+
+	t.Run("shortcuts are discarded", func(t *testing.T) {
+		t.Parallel()
+		opts, err := ApplyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second), Target: null.IntFrom(5)}},
+		})
+		require.NoError(t, err)
+		requireOnlyScenario(t, opts, lib.DefaultScenarioName)
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		assert.Nil(t, opts.Stages)
+
+		// the result must not conflict when derived afterwards
+		_, err = DeriveScenariosFromShortcuts(opts, nil)
+		require.NoError(t, err)
+	})
+
+	t.Run("single scenario keeps exec, env, tags and options", func(t *testing.T) {
+		t.Parallel()
+		original := NewRampingVUsConfig("browser")
+		original.Exec = null.StringFrom("myFunc")
+		original.Env = map[string]string{"FOO": "bar"}
+		original.Tags = map[string]string{"tag": "value"}
+		original.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		original.StartTime = types.NullDurationFrom(5 * time.Second)
+		original.GracefulStop = types.NullDurationFrom(time.Second)
+		original.StartVUs = null.IntFrom(20)
+		original.Stages = []Stage{{Duration: types.NullDurationFrom(time.Minute), Target: null.IntFrom(50)}}
+
+		opts, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"browser": original}})
+		require.NoError(t, err)
+
+		sc := requireOnlyScenario(t, opts, "browser")
+		assert.Equal(t, "myFunc", sc.GetExec())
+		assert.Equal(t, map[string]string{"FOO": "bar"}, sc.Env)
+		assert.Equal(t, map[string]string{"tag": "value"}, sc.Tags)
+		assert.Equal(t, original.Options, sc.Options)
+		assert.False(t, sc.StartTime.Valid)
+		assert.False(t, sc.GracefulStop.Valid)
+		assert.False(t, sc.MaxDuration.Valid)
+		assert.Empty(t, sc.Validate())
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": NewSharedIterationsConfig("a"),
+			"b": NewSharedIterationsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
