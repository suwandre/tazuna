+// onceIncompatibleFlags are the CLI flags that define the execution and thus can't be used with --once.
+var onceIncompatibleFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// isOnceRequested returns whether the --once flag is set for the command. It returns an error
+// if it's combined with any of the flags that define the execution.
+func isOnceRequested(cmd *cobra.Command) (bool, error) {
+	if cmd == nil || cmd.Flags().Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := cmd.Flags().GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceIncompatibleFlags {
+		if cmd.Flags().Changed(name) {
+			return false, fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+	return true, nil
+}
+
 // mergeRunTags accumulates RunTags from each layer in precedence order (lowest first).
 // On key collision, later (higher-priority) layers overwrite earlier ones.
 // Returns nil when every layer is empty to preserve the codebase's "tags":null serialization.
