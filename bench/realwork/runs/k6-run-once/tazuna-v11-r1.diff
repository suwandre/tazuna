index 0000000..5a59f02
--- /dev/null
+++ b/lib/executor/once.go
@@ -0,0 +1,50 @@
+package executor
+
+import (
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+// ApplyOnce makes the options run the script once, with 1 VU and 1 iteration, as requested by
+// the --once flag.
+//
+// If there are no scenarios, the default function is run. If there is a single scenario, it is
+// replaced by a shared-iterations one, preserving only its name, exec, env, tags and options.
+// Everything else, including the execution shortcut options, is discarded. More than one
+// scenario is an error, since it's not clear which one should run.
+//
+// It's meant to be called on the consolidated options, so the result doesn't depend on the layer
+// the original execution configuration came from.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	result := opts
+
+	scenario := NewSharedIterationsConfig(lib.DefaultScenarioName)
+	switch len(opts.Scenarios) {
+	case 0:
+	case 1:
+		for name, original := range opts.Scenarios {
+			scenario = NewSharedIterationsConfig(name)
+			if exec := original.GetExec(); exec != consts.DefaultFn {
+				scenario.Exec = null.StringFrom(exec)
+			}
+			scenario.Env = original.GetEnv()
+			scenario.Tags = original.GetTags()
+			scenario.Options = original.GetScenarioOptions()
+		}
+	default:
+		return opts, ExecutionConflictError("--once can run a single scenario only")
+	}
+	scenario.VUs = null.IntFrom(1)
+	scenario.Iterations = null.IntFrom(1)
+
+	result.Scenarios = lib.ScenarioConfigs{scenario.Name: scenario}
+	result.VUs = null.Int{}
+	result.Iterations = null.Int{}
+	result.Duration = types.NullDuration{}
+	result.Stages = nil
+
+	return result, nil
+}
