+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("default function", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		script := `
+			export const options = {vus: 5, duration: '1m'};
+			export default function () { console.log('ITER'); }`
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(script), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "--log-output=stdout", "test.js"}
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Equal(t, 1, strings.Count(ts.Stdout.String(), "ITER"))
+	})
+
+	t.Run("single scenario keeps exec and env", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		script := `
+			export const options = {scenarios: {s: {
+				executor: 'constant-vus', vus: 5, duration: '1m', exec: 'foo', env: {MYENV: 'val'},
+			}}};
+			export function foo() { console.log('FOO ' + __ENV.MYENV); }`
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(script), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "--log-output=stdout", "test.js"}
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Equal(t, 1, strings.Count(ts.Stdout.String(), "FOO val"))
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		script := `
+			export const options = {scenarios: {
+				a: {executor: 'shared-iterations'}, b: {executor: 'shared-iterations'},
+			}};
+			export default function () {}`
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(script), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "test.js"}
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+	})
+
+	t.Run("combined with shortcut flag", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		script := `export default function () {}`
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(script), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "--iterations", "10", "test.js"}
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with --iterations")
+	})
+}
