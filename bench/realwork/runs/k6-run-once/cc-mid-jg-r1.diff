+// isOnce returns whether the --once flag was set.
+func isOnce(flags *pflag.FlagSet) bool {
+	if flags.Lookup("once") == nil {
+		return false
+	}
+	once, err := flags.GetBool("once")
+	return err == nil && once
+}
+
+// validateOnceFlags checks that --once isn't combined with any of the
+// shortcut flags that also define the execution.
+func validateOnceFlags(flags *pflag.FlagSet) error {
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			return fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+	return nil
+}
