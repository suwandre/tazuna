+
+// ApplyOnce transforms the (consolidated) options so that the script runs
+// exactly once, with 1 VU and 1 iteration. If no scenarios are configured, the
+// default one is used. If there is a single scenario, its exec function, env,
+// tags and scenario options are preserved, but its executor is replaced by a
+// shared-iterations one, discarding all the other fields. Any shortcut options
+// (vus, iterations, duration, stages) are discarded. More than one scenario
+// results in an error.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ExecutionConflictError("--once can run a single scenario only")
+	}
+
+	name := lib.DefaultScenarioName
+	once := NewSharedIterationsConfig(name)
+	for scenarioName, sc := range opts.Scenarios {
+		name = scenarioName
+		once = NewSharedIterationsConfig(name)
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			once.Exec = null.StringFrom(exec)
+		}
+		once.Env = sc.GetEnv()
+		once.Tags = sc.GetTags()
+		once.Options = sc.GetScenarioOptions()
+	}
+
+	opts.Scenarios = lib.ScenarioConfigs{name: once}
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+
+	return opts, nil
+}
