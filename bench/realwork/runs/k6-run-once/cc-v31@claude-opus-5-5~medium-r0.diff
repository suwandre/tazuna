+func TestGetOnce(t *testing.T) {
+	t.Parallel()
+
+	testCases := []struct {
+		args   []string
+		once   bool
+		errMsg string
+	}{
+		{args: nil, once: false},
+		{args: []string{"--once"}, once: true},
+		{args: []string{"--once=false", "--iterations", "10"}, once: false},
+		{args: []string{"--once", "--no-setup"}, once: true},
+		{args: []string{"--once", "--vus", "1"}, errMsg: "--once cannot be combined with --vus"},
+		{args: []string{"--once", "-i", "10"}, errMsg: "--once cannot be combined with --iterations"},
+		{args: []string{"--once", "-d", "10s"}, errMsg: "--once cannot be combined with --duration"},
+		{args: []string{"--once", "-s", "10s:5"}, errMsg: "--once cannot be combined with --stage"},
+	}
+	for _, tc := range testCases {
+		t.Run(fmt.Sprint(tc.args), func(t *testing.T) {
+			t.Parallel()
+
+			flags := optionFlagSet()
+			require.NoError(t, flags.Parse(tc.args))
+			once, err := getOnce(flags)
+			if tc.errMsg != "" {
+				require.ErrorContains(t, err, tc.errMsg)
+				var ecerr errext.HasExitCode
+				require.ErrorAs(t, err, &ecerr)
+				assert.Equal(t, exitcodes.InvalidConfig, ecerr.ExitCode())
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tc.once, once)
+		})
+	}
+
+	t.Run("flag not defined", func(t *testing.T) {
+		t.Parallel()
+
+		once, err := getOnce(pflag.NewFlagSet("", pflag.ContinueOnError))
+		require.NoError(t, err)
+		assert.False(t, once)
+	})
+}
