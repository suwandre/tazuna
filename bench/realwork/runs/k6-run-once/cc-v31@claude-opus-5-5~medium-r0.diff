+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		conf, err := applyOnce(Config{Options: lib.Options{
+			VUs:      null.IntFrom(10),
+			Duration: types.NullDurationFrom(time.Hour),
+			Stages:   []lib.Stage{{Duration: types.NullDurationFrom(time.Minute), Target: null.IntFrom(5)}},
+		}})
+		require.NoError(t, err)
+
+		assert.False(t, conf.VUs.Valid)
+		assert.False(t, conf.Iterations.Valid)
+		assert.False(t, conf.Duration.Valid)
+		assert.Nil(t, conf.Stages)
+
+		exp := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+		exp.VUs = null.IntFrom(1)
+		exp.Iterations = null.IntFrom(1)
+		assert.Equal(t, lib.ScenarioConfigs{lib.DefaultScenarioName: exp}, conf.Scenarios)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		orig := executor.NewRampingVUsConfig("foo")
+		orig.StartTime = types.NullDurationFrom(time.Minute)
+		orig.GracefulStop = types.NullDurationFrom(time.Second)
+		orig.Exec = null.StringFrom("fn")
+		orig.Env = map[string]string{"a": "b"}
+		orig.Tags = map[string]string{"c": "d"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		orig.StartVUs = null.IntFrom(10)
+		orig.Stages = []executor.Stage{{Duration: types.NullDurationFrom(time.Hour), Target: null.IntFrom(50)}}
+
+		conf, err := applyOnce(Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{"foo": orig}}})
+		require.NoError(t, err)
+
+		exp := executor.NewSharedIterationsConfig("foo")
+		exp.VUs = null.IntFrom(1)
+		exp.Iterations = null.IntFrom(1)
