+package tests
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cloudapi/v6/v6test"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+const onceSingleScenarioScript = `
+	import exec from 'k6/execution';
+
+	export const options = {
+		scenarios: {
+			foo: {
+				executor: 'constant-vus',
+				vus: 5,
+				duration: '1h',
+				exec: 'fn',
+				env: { MY_VAR: 'from-scenario' },
+				tags: { my_tag: 'from-scenario' },
+			},
+		},
+	};
+
+	export function setup() { console.log('setup'); }
+
+	export function fn() {
+		console.log('fn ' + __ENV.MY_VAR + ' ' + exec.vu.metrics.tags['my_tag'] + ' ' + exec.scenario.name);
+	}
+
+	export function teardown() { console.log('teardown'); }
+`
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		ts := getSingleFileTestState(t, onceSingleScenarioScript, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		t.Log(stdout)
+		assert.Contains(t, stdout, "foo: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "exec: fn")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Contains(t, stdout, `msg=setup`)
+		assert.Contains(t, stdout, `msg="fn from-scenario from-scenario foo"`)
+		assert.Contains(t, stdout, `msg=teardown`)
+	})
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		script := `
+			export const options = { vus: 10, duration: '1h' };
+			export default function () { console.log('default ' + __VU + ' ' + __ITER); }
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		t.Log(stdout)
+		assert.Contains(t, stdout, "default: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Contains(t, stdout, `msg="default 1 0"`)
+	})
+
+	t.Run("env var vus is discarded", func(t *testing.T) {
+		t.Parallel()
+
+		ts := getSingleFileTestState(t, onceSingleScenarioScript, []string{"--once", "--log-output=stdout"}, 0)
+		ts.Env["K6_VUS"] = "3"
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		t.Log(stdout)
+		assert.Contains(t, stdout, "foo: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	})
+
+	t.Run("env var shortcuts are discarded", func(t *testing.T) {
+		t.Parallel()
+
+		script := `export default function () { console.log('default ' + __VU + ' ' + __ITER); }`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+		ts.Env["K6_VUS"] = "3"
+		ts.Env["K6_ITERATIONS"] = "6"
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		t.Log(stdout)
+		assert.Contains(t, stdout, "default: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		script := `
+			export const options = {
+				scenarios: {
+					a: { executor: 'shared-iterations', exec: 'fn' },
+					b: { executor: 'shared-iterations', exec: 'fn' },
+				},
+			};
+			export function fn() {}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.True(t, testutils.LogContains(
+			ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once can run a single scenario only, but the script has 2",
+		))
+	})
+
+	for _, flags := range [][]string{
+		{"--vus", "2"},
+		{"--iterations", "10"},
+		{"--duration", "10s"},
+		{"--stage", "10s:5"},
+	} {
+		t.Run("combined with "+flags[0], func(t *testing.T) {
+			t.Parallel()
+
+			ts := getSingleFileTestState(
+				t, onceSingleScenarioScript, append([]string{"--once"}, flags...), exitcodes.InvalidConfig,
+			)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.True(t, testutils.LogContains(
+				ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once cannot be combined with "+flags[0],
+			))
+		})
+	}
+}
