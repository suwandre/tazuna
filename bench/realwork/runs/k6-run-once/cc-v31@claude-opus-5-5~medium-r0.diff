+// onceConflictingFlags are the execution shortcut flags that can't be combined with --once.
+var onceConflictingFlags = []string{"vus", "duration", "iterations", "stage"} //nolint:gochecknoglobals
+
+// getOnce returns whether the --once flag is set, and an error if it was combined with any of
+// the execution shortcut flags. Commands that don't have the flag always return false.
+func getOnce(flags *pflag.FlagSet) (bool, error) {
+	if flags == nil || flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceConflictingFlags {
+		if flags.Changed(name) {
+			return false, errext.WithExitCodeIfNone(
+				fmt.Errorf("--once cannot be combined with --%s", name), exitcodes.InvalidConfig,
+			)
+		}
+	}
+	return true, nil
+}
+
+// applyOnce transforms the consolidated config so that it runs a single iteration with a single
+// VU. If the config has a single scenario, its exec, env, tags and options are preserved, but its
+// executor is replaced with a 1 VU, 1 iteration shared-iterations one. If there are no scenarios,
+// the default function is executed. Multiple scenarios are not supported.
+//
+// It is meant to be applied after the config layers are consolidated, since doing it earlier
+// would make the result depend on the convoluted consolidation precedence rules (#883, #2529).
+func applyOnce(conf Config) (Config, error) {
+	if len(conf.Scenarios) > 1 {
+		return conf, errext.WithExitCodeIfNone(
+			fmt.Errorf("--once can run a single scenario only, but the script has %d", len(conf.Scenarios)),
+			exitcodes.InvalidConfig,
+		)
+	}
+
+	sc := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	for name, orig := range conf.Scenarios {
+		sc = executor.NewSharedIterationsConfig(name)
+		if exec := orig.GetExec(); exec != consts.DefaultFn {
+			sc.Exec = null.StringFrom(exec)
+		}
+		sc.Env = orig.GetEnv()
+		sc.Tags = orig.GetTags()
+		sc.Options = orig.GetScenarioOptions()
+	}
+	sc.VUs = null.IntFrom(1)
+	sc.Iterations = null.IntFrom(1)
+
+	conf.VUs = null.NewInt(1, false)
+	conf.Iterations = null.NewInt(0, false)
+	conf.Duration = types.NewNullDuration(0, false)
+	conf.Stages = nil
+	conf.Scenarios = lib.ScenarioConfigs{sc.Name: sc}
+	return conf, nil
+}
