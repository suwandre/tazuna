+// onceArchiveScenarios is the subset of the archive metadata that --once is expected to change.
+type onceArchiveScenarios struct {
+	Options struct {
+		VUs        *int64                     `json:"vus"`
+		Iterations *int64                     `json:"iterations"`
+		Duration   *string                    `json:"duration"`
+		Scenarios  map[string]json.RawMessage `json:"scenarios"`
+	} `json:"options"`
+}
+
+func assertOnceArchiveMetadata(t *testing.T, metadataRaw []byte) {
+	t.Helper()
+
+	var metadata onceArchiveScenarios
+	require.NoError(t, json.Unmarshal(metadataRaw, &metadata))
+	assert.Nil(t, metadata.Options.Iterations)
+	assert.Nil(t, metadata.Options.Duration)
+	require.Len(t, metadata.Options.Scenarios, 1)
+	require.Contains(t, metadata.Options.Scenarios, "foo")
+	assert.JSONEq(t, `{
+		"executor": "shared-iterations",
+		"startTime": null,
+		"gracefulStop": null,
+		"env": {"MY_VAR": "from-scenario"},
+		"exec": "fn",
+		"tags": {"my_tag": "from-scenario"},
+		"vus": 1,
+		"iterations": 1,
+		"maxDuration": null
+	}`, string(metadata.Options.Scenarios["foo"]))
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(onceSingleScenarioScript), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "test.js"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	require.NoError(t, testutils.Untar(t, ts.FS, "archive.tar", "tmp/"))
+	metadataRaw, err := fsext.ReadFile(ts.FS, "tmp/metadata.json")
+	require.NoError(t, err)
+	assertOnceArchiveMetadata(t, metadataRaw)
+
+	// The archive should keep running once, without the flag.
+	data, err := fsext.ReadFile(ts.FS, "archive.tar")
+	require.NoError(t, err)
+
+	ts = NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "archive.tar"), data, 0o644))
+	ts.CmdArgs = []string{"k6", "run", "--log-output=stdout", "archive.tar"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	t.Log(stdout)
+	assert.Contains(t, stdout, "foo: 1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, `msg="fn from-scenario from-scenario foo"`)
+}
+
+func TestCloudRunOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(strings.Replace(
+		onceSingleScenarioScript, "export const options = {", "export const options = { cloud: { projectID: 1 },", 1,
+	)), 0o644))
+
+	var metadataRaw []byte
+	srv := v6test.NewServer(t, v6test.Config{
+		InspectArchive: func(req *http.Request) {
+			file, _, err := req.FormFile("script")
+			require.NoError(t, err)
+			data, err := io.ReadAll(file)
+			require.NoError(t, err)
+
+			tmpPath := filepath.Join(ts.Cwd, "archive_to_cloud.tar")
+			require.NoError(t, fsext.WriteFile(ts.FS, tmpPath, data, 0o644))
+			require.NoError(t, testutils.Untar(t, ts.FS, tmpPath, "tmp/"))
+			metadataRaw, err = fsext.ReadFile(ts.FS, "tmp/metadata.json")
+			require.NoError(t, err)
+		},
+	})
+
+	ts.CmdArgs = []string{"k6", "cloud", "run", "--once", "--log-output=stdout", "test.js"}
+	ts.Env["K6_SHOW_CLOUD_LOGS"] = "false"
+	ts.Env["K6_CLOUD_HOST_V6"] = srv.URL
+	ts.Env["K6_CLOUD_TOKEN"] = "foo"
+	ts.Env["K6_CLOUD_STACK_ID"] = "1"
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	t.Log(ts.Stdout.String())
+	require.NotNil(t, metadataRaw, "the archive wasn't uploaded")
+	assertOnceArchiveMetadata(t, metadataRaw)
+}
