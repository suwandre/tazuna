diff --git a/internal/cmd/tests/cmd_run_once_test.go b/internal/cmd/tests/cmd_run_once_test.go
new file mode 100644
index 0000000..92f1ebf
--- /dev/null
+++ b/internal/cmd/tests/cmd_run_once_test.go
@@ -0,0 +1,106 @@
+package tests
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+)
+
+func TestRunOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `
+		export const options = { vus: 5, iterations: 50 };
+		export default function () {}
+	`, []string{"--once", "--out", "json=results.json", "--no-usage-report"}, 0)
+
+	results := runAndReadResults(t, ts)
+
+	assert.Equal(t, float64(1), sum(getSampleValues(t, results, "iterations", nil)))
+}
+
+func TestRunOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `
+		import exec from 'k6/execution';
+
+		export const options = {
+			scenarios: {
+				one: {
+					executor: 'constant-vus',
+					vus: 5,
+					duration: '1h',
+					exec: 'other',
+					env: { FOO: 'bar' },
+					tags: { custom: 'tag' },
+				},
+			},
+		};
+
+		export function other() {
+			if (__ENV.FOO !== 'bar') {
+				throw new Error('scenario env is not preserved');
+			}
+			if (exec.scenario.name !== 'one') {
+				throw new Error('unexpected scenario name ' + exec.scenario.name);
+			}
+		}
+	`, []string{"--once", "--out", "json=results.json", "--no-usage-report"}, 0)
+
+	results := runAndReadResults(t, ts)
+
+	tags := map[string]string{"scenario": "one", "custom": "tag"}
+	assert.Equal(t, float64(1), sum(getSampleValues(t, results, "iterations", tags)))
+}
+
+func TestRunOnceRunsSetupAndTeardown(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `
+		export function setup() { console.log('setup-ran'); }
+		export default function () { console.log('default-ran'); }
+		export function teardown() { console.log('teardown-ran'); }
+	`, []string{"--once", "--log-output=stdout", "--no-usage-report"}, 0)
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "setup-ran")
+	assert.Equal(t, 1, strings.Count(stdout, "default-ran"))
+	assert.Contains(t, stdout, "teardown-ran")
+}
+
+func TestRunOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `
+		export const options = {
+			scenarios: {
+				a: { executor: 'per-vu-iterations', vus: 1, iterations: 1 },
+				b: { executor: 'per-vu-iterations', vus: 1, iterations: 1 },
+			},
+		};
+		export default function () {}
+	`, []string{"--once", "--no-usage-report"}, exitcodes.InvalidConfig)
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+}
+
+func TestRunOnceConflictingFlag(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `export default function () {}`,
+		[]string{"--once", "--iterations", "10", "--no-usage-report"}, exitcodes.InvalidConfig)
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	require.Contains(t, ts.Stderr.String(), "--once cannot be combined with --iterations")
+}
