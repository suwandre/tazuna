diff --git a/internal/cmd/once.go b/internal/cmd/once.go
new file mode 100644
index 0000000..61635f7
--- /dev/null
+++ b/internal/cmd/once.go
@@ -0,0 +1,86 @@
+package cmd
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/spf13/pflag"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/errext"
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+const onceFlagName = "once"
+
+// onceConflictingFlags are the execution shortcut flags that can't be combined with --once.
+var onceConflictingFlags = []string{"vus", "duration", "iterations", "stage"} //nolint:gochecknoglobals
+
+var errOnceMultipleScenarios = errors.New("--once can run a single scenario only")
+
+// onceFlagSet returns the FlagSet with the --once flag.
+func onceFlagSet() *pflag.FlagSet {
+	flags := pflag.NewFlagSet("", pflag.ContinueOnError)
+	flags.SortFlags = false
+	flags.Bool(onceFlagName, false,
+		"run the script once, with 1 VU and 1 iteration, preserving the configuration of a single scenario")
+	return flags
+}
+
+// isOnceMode reports whether the --once flag is set. It returns an error if the flag is combined with
+// any of the execution shortcut flags. Commands that don't define the flag are never in the once mode.
+func isOnceMode(flags *pflag.FlagSet) (bool, error) {
+	if flags.Lookup(onceFlagName) == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool(onceFlagName)
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceConflictingFlags {
+		if flags.Changed(name) {
+			return false, errext.WithExitCodeIfNone(
+				fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name),
+				exitcodes.InvalidConfig,
+			)
+		}
+	}
+	return true, nil
+}
+
+// applyOnceMode makes the consolidated config run with 1 VU and 1 iteration. The execution shortcut
+// options are discarded. If there is a single scenario, its exec, env, tags and scenario options
+// are preserved, but its executor is replaced with a shared-iterations one. Without scenarios, the
+// default scenario is used.
+func applyOnceMode(conf Config) (Config, error) {
+	if len(conf.Scenarios) > 1 {
+		return conf, errext.WithExitCodeIfNone(errOnceMultipleScenarios, exitcodes.InvalidConfig)
+	}
+
+	name := lib.DefaultScenarioName
+	once := executor.NewSharedIterationsConfig(name)
+	for scenarioName, sc := range conf.Scenarios {
+		name = scenarioName
+		once = executor.NewSharedIterationsConfig(name)
+		once.Env = sc.GetEnv()
+		once.Tags = sc.GetTags()
+		once.Options = sc.GetScenarioOptions()
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			once.Exec = null.StringFrom(exec)
+		}
+	}
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	conf.VUs = null.Int{}
+	conf.Iterations = null.Int{}
+	conf.Duration = types.NullDuration{}
+	conf.Stages = nil
+	conf.Scenarios = lib.ScenarioConfigs{name: once}
+
+	return conf, nil
+}
diff --git a/internal/cmd/once_test.go b/internal/cmd/once_test.go
new file mode 100644
index 0000000..2b6d56f
--- /dev/null
+++ b/internal/cmd/once_test.go
@@ -0,0 +1,146 @@
+package cmd
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestIsOnceMode(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		args    []string
+		once    bool
+		wantErr string
+	}{
+		{name: "not set", args: nil},
+		{name: "set", args: []string{"--once"}, once: true},
+		{name: "explicitly false", args: []string{"--once=false", "--iterations", "5"}},
+		{name: "with vus", args: []string{"--once", "--vus", "2"}, wantErr: "--once cannot be combined with --vus"},
+		{
+			name:    "with iterations",
+			args:    []string{"--once", "--iterations", "10"},
+			wantErr: "--once cannot be combined with --iterations",
+		},
+		{
+			name:    "with duration",
+			args:    []string{"--once", "-d", "10s"},
+			wantErr: "--once cannot be combined with --duration",
+		},
+		{
+			name:    "with stage",
+			args:    []string{"--once", "--stage", "1s:2"},
+			wantErr: "--once cannot be combined with --stage",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			flags := optionFlagSet()
+			flags.AddFlagSet(onceFlagSet())
+			require.NoError(t, flags.Parse(tc.args))
+
+			once, err := isOnceMode(flags)
+			if tc.wantErr != "" {
+				require.ErrorContains(t, err, tc.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tc.once, once)
+		})
+	}
+
+	t.Run("flag not defined", func(t *testing.T) {
+		t.Parallel()
+
+		once, err := isOnceMode(optionFlagSet())
+		require.NoError(t, err)
+		assert.False(t, once)
+	})
+}
+
+func TestApplyOnceMode(t *testing.T) {
+	t.Parallel()
+
+	requireSingleOnce := func(t *testing.T, conf Config, name string) executor.SharedIterationsConfig {
+		t.Helper()
+		require.Len(t, conf.Scenarios, 1)
+		sc, ok := conf.Scenarios[name].(executor.SharedIterationsConfig)
+		require.True(t, ok, "expected a shared-iterations scenario named %q", name)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		return sc
+	}
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		conf, err := applyOnceMode(Config{})
+		require.NoError(t, err)
+		sc := requireSingleOnce(t, conf, lib.DefaultScenarioName)
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("shortcut options are discarded", func(t *testing.T) {
+		t.Parallel()
+
+		conf, err := applyOnceMode(Config{Options: lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second)}},
+		}})
+		require.NoError(t, err)
+		requireSingleOnce(t, conf, lib.DefaultScenarioName)
+		assert.False(t, conf.VUs.Valid)
+		assert.False(t, conf.Iterations.Valid)
+		assert.False(t, conf.Duration.Valid)
+		assert.Nil(t, conf.Stages)
+	})
+
+	t.Run("single scenario keeps exec, env, tags and options", func(t *testing.T) {
+		t.Parallel()
+
+		orig := executor.NewRampingVUsConfig("browser")
+		orig.Exec = null.StringFrom("myFunc")
+		orig.Env = map[string]string{"A": "b"}
+		orig.Tags = map[string]string{"t": "v"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		orig.StartVUs = null.IntFrom(50)
+		orig.StartTime = types.NullDurationFrom(time.Minute)
+
+		conf, err := applyOnceMode(Config{Options: lib.Options{
+			Scenarios: lib.ScenarioConfigs{"browser": orig},
+		}})
+		require.NoError(t, err)
+		sc := requireSingleOnce(t, conf, "browser")
+		assert.Equal(t, "myFunc", sc.GetExec())
+		assert.Equal(t, orig.Env, sc.Env)
+		assert.Equal(t, orig.Tags, sc.Tags)
+		assert.Equal(t, orig.Options, sc.Options)
+		assert.False(t, sc.StartTime.Valid)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		_, err := applyOnceMode(Config{Options: lib.Options{
+			Scenarios: lib.ScenarioConfigs{
+				"a": executor.NewPerVUIterationsConfig("a"),
+				"b": executor.NewPerVUIterationsConfig("b"),
+			},
+		}})
+		require.ErrorIs(t, err, errOnceMultipleScenarios)
+	})
+}
