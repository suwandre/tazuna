diff --git a/internal/cmd/once.go b/internal/cmd/once.go
new file mode 100644
index 0000000..f4abe47
--- /dev/null
+++ b/internal/cmd/once.go
@@ -0,0 +1,84 @@
+package cmd
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/spf13/pflag"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+)
+
+const onceFlagName = "once"
+
+// onceIncompatibleFlags are the shortcut flags that define the amount of work
+// to execute, so they make no sense together with --once.
+var onceIncompatibleFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+var errOnceMultipleScenarios = errors.New("--once can run a single scenario only")
+
+func onceFlagSet() *pflag.FlagSet {
+	flags := pflag.NewFlagSet("", pflag.ContinueOnError)
+	flags.SortFlags = false
+	flags.Bool(onceFlagName, false,
+		"run the script with 1 VU and 1 iteration, preserving the scenario configuration (exec, env, tags, options)")
+	return flags
+}
+
+// isOnceRequested returns true if the --once flag was explicitly enabled. Commands
+// that don't define the flag are never in "once" mode.
+func isOnceRequested(flags *pflag.FlagSet) (bool, error) {
+	if flags.Lookup(onceFlagName) == nil {
+		return false, nil
+	}
+	return flags.GetBool(onceFlagName)
+}
+
+// validateOnceFlags returns an error if --once was combined with any of the shortcut flags.
+func validateOnceFlags(flags *pflag.FlagSet) error {
+	for _, name := range onceIncompatibleFlags {
+		if flags.Changed(name) {
+			return fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name)
+		}
+	}
+	return nil
+}
+
+// applyOnce transforms the consolidated options so the test runs with 1 VU and
+// 1 iteration. It must be applied after the config consolidation, so values from
+// any source (script, config file, environment) are discarded.
+//
+// If the script has no scenarios, a default one is created. If it has exactly one,
+// its exec, env, tags and options are preserved, while its executor is replaced
+// with a shared-iterations one. More than one scenario is an error.
+func applyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, errOnceMultipleScenarios
+	}
+
+	scenario := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	scenario.VUs = null.IntFrom(1)
+	scenario.Iterations = null.IntFrom(1)
+
+	for name, original := range opts.Scenarios {
+		scenario.Name = name
+		if exec := original.GetExec(); exec != consts.DefaultFn {
+			scenario.Exec = null.StringFrom(exec)
+		}
+		scenario.Env = original.GetEnv()
+		scenario.Tags = original.GetTags()
+		scenario.Options = original.GetScenarioOptions()
+	}
+
+	opts.Scenarios = lib.ScenarioConfigs{scenario.Name: scenario}
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration.Valid = false
+	opts.Duration.Duration = 0
+	opts.Stages = nil
+
+	return opts, nil
+}
diff --git a/internal/cmd/once_test.go b/internal/cmd/once_test.go
