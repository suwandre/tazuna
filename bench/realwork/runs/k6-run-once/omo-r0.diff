diff --git a/internal/cmd/tests/cmd_run_once_test.go b/internal/cmd/tests/cmd_run_once_test.go
new file mode 100644
index 0000000..f1653bf
--- /dev/null
+++ b/internal/cmd/tests/cmd_run_once_test.go
@@ -0,0 +1,160 @@
+package tests
+
+import (
+	"bytes"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+const onceSingleScenarioScript = `
+	import exec from 'k6/execution';
+
+	export const options = {
+		scenarios: {
+			custom: {
+				executor: 'constant-vus',
+				vus: 5,
+				duration: '1h',
+				exec: 'foo',
+				env: { FROM_SCENARIO: 'yes' },
+				tags: { mytag: 'myvalue' },
+			},
+		},
+	};
+
+	export function foo() {
+		console.log('foo ran in ' + exec.scenario.name + ' with ' + __ENV.FROM_SCENARIO);
+	}
+
+	export default function () {
+		throw new Error('default must not run');
+	}
+`
+
+func TestRunOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `
+		export const options = { vus: 10, iterations: 100 };
+		export default function () {}
+	`, []string{"--out", "json=results.json", "--once"}, 0)
+
+	results := runAndReadResults(t, ts)
+
+	assert.EqualValues(t, 1, sum(getSampleValues(t, results, "iterations", nil)))
+}
+
+func TestRunOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, onceSingleScenarioScript,
+		[]string{"--out", "json=results.json", "--once", "--log-output=stdout"}, 0)
+
+	results := runAndReadResults(t, ts)
+
+	assert.EqualValues(t, 1, sum(getSampleValues(t, results, "iterations", map[string]string{
+		"scenario": "custom", "mytag": "myvalue",
+	})))
+	assert.Contains(t, ts.Stdout.String(), "foo ran in custom with yes")
+}
+
+func TestRunOnceRunsSetupAndTeardown(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `
+		export function setup() { console.log('setup ran'); }
+		export function teardown() { console.log('teardown ran'); }
+		export default function () { console.log('default ran'); }
+	`, []string{"--once", "--log-output=stdout"}, 0)
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	out := ts.Stdout.String()
+	assert.Contains(t, out, "setup ran")
+	assert.Equal(t, 1, bytes.Count([]byte(out), []byte("default ran")))
+	assert.Contains(t, out, "teardown ran")
+}
+
+func TestRunOnceErrors(t *testing.T) {
+	t.Parallel()
+
+	multiScenario := `
+		export const options = { scenarios: {
+			a: { executor: 'per-vu-iterations' },
+			b: { executor: 'per-vu-iterations' },
+		} };
+		export default function () {}
+	`
+
+	for name, tc := range map[string]struct {
+		script string
+		flags  []string
+		expErr string
+	}{
+		"multiple scenarios": {multiScenario, []string{"--once"}, "--once can run a single scenario only"},
+		"iterations": {
+			"export default function () {}",
+			[]string{"--once", "--iterations", "10"},
+			"--once cannot be combined with --iterations",
+		},
+		"vus": {
+			"export default function () {}",
+			[]string{"--once", "--vus", "10"},
+			"--once cannot be combined with --vus",
+		},
+		"duration": {
+			"export default function () {}",
+			[]string{"--once", "--duration", "10s"},
+			"--once cannot be combined with --duration",
+		},
+		"stage": {
+			"export default function () {}",
+			[]string{"--once", "--stage", "10s:5"},
+			"--once cannot be combined with --stage",
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+
+			ts := getSingleFileTestState(t, tc.script, append(tc.flags, "--log-output=stdout"),
+				exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.Contains(t, ts.Stdout.String()+ts.Stderr.String(), tc.expErr)
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"),
+		[]byte(onceSingleScenarioScript), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", "archive.tar", "test.js"}
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	data, err := fsext.ReadFile(ts.FS, "archive.tar")
+	require.NoError(t, err)
+	arc, err := lib.ReadArchive(bytes.NewReader(data))
+	require.NoError(t, err)
+
+	require.Len(t, arc.Options.Scenarios, 1)
+	sc := arc.Options.Scenarios["custom"]
+	require.NotNil(t, sc)
+	assert.Equal(t, "shared-iterations", sc.GetType())
+	assert.Equal(t, "foo", sc.GetExec())
+	assert.Equal(t, map[string]string{"FROM_SCENARIO": "yes"}, sc.GetEnv())
+	assert.Equal(t, map[string]string{"mytag": "myvalue"}, sc.GetTags())
+	assert.False(t, arc.Options.VUs.Valid)
+	assert.False(t, arc.Options.Iterations.Valid)
+}
