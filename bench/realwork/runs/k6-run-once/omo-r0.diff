+package cmd
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts, err := applyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(10),
+			Stages:     []lib.Stage{{Target: null.IntFrom(5)}},
+		})
+		require.NoError(t, err)
+
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		assert.Nil(t, opts.Stages)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("single scenario keeps exec, env, tags and options", func(t *testing.T) {
+		t.Parallel()
+
+		original := executor.NewRampingVUsConfig("browser")
+		original.Exec = null.StringFrom("foo")
+		original.Env = map[string]string{"A": "b"}
+		original.Tags = map[string]string{"c": "d"}
+		original.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		original.StartVUs = null.IntFrom(7)
+		original.StartTime = types.NewNullDuration(5, true)
+
+		opts, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"browser": original}})
+		require.NoError(t, err)
+
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios["browser"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "browser", sc.GetName())
+		assert.Equal(t, "foo", sc.GetExec())
+		assert.Equal(t, original.Env, sc.GetEnv())
+		assert.Equal(t, original.Tags, sc.GetTags())
+		assert.Equal(t, original.Options, sc.GetScenarioOptions())
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.StartTime.Valid)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		_, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": executor.NewPerVUIterationsConfig("a"),
+			"b": executor.NewPerVUIterationsConfig("b"),
+		}})
+		require.ErrorIs(t, err, errOnceMultipleScenarios)
+	})
+}
+
+func TestValidateOnceFlags(t *testing.T) {
+	t.Parallel()
+
+	for _, tc := range []struct {
+		args []string
+		err  string
+	}{
+		{args: []string{"--once"}},
+		{args: []string{"--once", "--iterations", "10"}, err: "--once cannot be combined with --iterations"},
+		{args: []string{"--once", "-i", "10"}, err: "--once cannot be combined with --iterations"},
+		{args: []string{"--once", "--vus", "2"}, err: "--once cannot be combined with --vus"},
+		{args: []string{"--once", "--duration", "1s"}, err: "--once cannot be combined with --duration"},
+		{args: []string{"--once", "--stage", "1s:2"}, err: "--once cannot be combined with --stage"},
+	} {
+		t.Run(tc.err+"/"+tc.args[len(tc.args)-1], func(t *testing.T) {
+			t.Parallel()
+
+			flags := optionFlagSet()
+			flags.AddFlagSet(onceFlagSet())
+			require.NoError(t, flags.Parse(tc.args))
+
+			once, err := isOnceRequested(flags)
+			require.NoError(t, err)
+			assert.True(t, once)
+
+			err = validateOnceFlags(flags)
+			if tc.err == "" {
+				require.NoError(t, err)
+			} else {
+				require.EqualError(t, err, tc.err)
+			}
+		})
+	}
+}
