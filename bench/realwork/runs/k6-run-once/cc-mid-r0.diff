+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `
+			export const options = { vus: 5, iterations: 20 };
+			export function setup() { console.log("setup ran"); }
+			export default function () {}
+		`, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Contains(t, stdout, "setup ran")
+	})
+
+	t.Run("single scenario keeps exec and tags", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `
+			export const options = {
+				scenarios: {
+					foo: { executor: 'constant-vus', vus: 3, duration: '1m', exec: 'bar', tags: { a: 'b' } },
+				},
+			};
+			export function bar() { console.log("bar ran"); }
+		`, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "foo: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "exec: bar")
+		assert.Contains(t, stdout, "bar ran")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `
+			export const options = {
+				scenarios: {
+					a: { executor: 'shared-iterations' },
+					b: { executor: 'shared-iterations' },
+				},
+			};
+			export default function () {}
+		`, []string{"--once", "--log-output=stdout"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.Contains(t, ts.Stdout.String(), "--once can run a single scenario only")
+	})
+
+	t.Run("combined with shortcut flag", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `export default function () {}`,
+			[]string{"--once", "--iterations", "10", "--log-output=stdout"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.Contains(t, ts.Stdout.String(), "--once cannot be combined with --iterations")
+	})
+}
diff --git a/lib/executor/once.go b/lib/executor/once.go
new file mode 100644
index 0000000..7417019
--- /dev/null
+++ b/lib/executor/once.go
@@ -0,0 +1,52 @@
+package executor
+
+import (
+	"errors"
+
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+)
+
+// ErrOnceMultipleScenarios is returned when --once is used with more than one scenario.
+var ErrOnceMultipleScenarios = errors.New("--once can run a single scenario only")
+
+// ApplyOnce transforms the options so the script runs with 1 VU and 1 iteration.
+//
+// The scenario configuration is preserved as much as possible: the exec function, scenario options,
+// env and tags are kept, while the executor is replaced by a shared-iterations one with 1 VU and
+// 1 iteration. Everything else (vus, iterations, duration, stages, other executor fields)
+// is discarded. If there are no scenarios, the default one is created.
+//
+// It's meant to be applied after the config consolidation, so the result isn't affected by the
+// shortcut options coming from other config layers.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ErrOnceMultipleScenarios
+	}
+
+	name := lib.DefaultScenarioName
+	once := NewSharedIterationsConfig(name)
+	if len(opts.Scenarios) == 1 {
+		for n, sc := range opts.Scenarios {
+			name = n
+			once = NewSharedIterationsConfig(n)
+			once.Exec = null.NewString(sc.GetExec(), sc.GetExec() != consts.DefaultFn)
+			once.Env = sc.GetEnv()
+			once.Tags = sc.GetTags()
+			once.Options = sc.GetScenarioOptions()
+		}
+	}
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{name: once}
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration.Valid = false
+	opts.Duration.Duration = 0
+	opts.Stages = nil
+
+	return opts, nil
+}
