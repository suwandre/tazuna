+// onceFlagName is the name of the flag that runs the script with 1 VU and 1 iteration.
+const onceFlagName = "once"
+
+// onceIncompatibleFlags are the shortcut flags that can't be combined with --once.
+var onceIncompatibleFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// onceFlagSet returns a FlagSet with the --once flag.
+func onceFlagSet() *pflag.FlagSet {
+	flags := pflag.NewFlagSet("", 0)
+	flags.SortFlags = false
+	flags.Bool(onceFlagName, false, "run the script once, with 1 VU and 1 iteration, preserving the scenario configuration")
+	return flags
+}
+
+// applyOnceFlag transforms the options if the --once flag is set. It must be used after
+// the config consolidation.
+func applyOnceFlag(flags *pflag.FlagSet, opts lib.Options) (lib.Options, error) {
+	if flags.Lookup(onceFlagName) == nil {
+		return opts, nil
+	}
+	once, err := flags.GetBool(onceFlagName)
+	if err != nil || !once {
+		return opts, err
+	}
+	for _, name := range onceIncompatibleFlags {
+		if flags.Changed(name) {
+			return opts, fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name)
+		}
+	}
+	return executor.ApplyOnce(opts)
+}
+
