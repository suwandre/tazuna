@@ -0,0 +1,78 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	opts := lib.Options{
+		VUs:        null.IntFrom(10),
+		Iterations: null.IntFrom(100),
+		Duration:   types.NullDurationFrom(time.Minute),
+		Stages:     []lib.Stage{{Target: null.IntFrom(5)}},
+	}
+	res, err := ApplyOnce(opts)
+	require.NoError(t, err)
+
+	assert.False(t, res.VUs.Valid)
+	assert.False(t, res.Iterations.Valid)
+	assert.False(t, res.Duration.Valid)
+	assert.Nil(t, res.Stages)
+	require.Len(t, res.Scenarios, 1)
+	sc, ok := res.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+	require.True(t, ok)
+	assert.Equal(t, int64(1), sc.VUs.Int64)
+	assert.Equal(t, int64(1), sc.Iterations.Int64)
+	assert.Equal(t, "default", sc.GetExec())
+
+	// the derivation must not complain after that
+	_, err = DeriveScenariosFromShortcuts(res, logrus.New())
+	require.NoError(t, err)
+}
+
+func TestApplyOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	orig := NewRampingVUsConfig("foo")
+	orig.Exec = null.StringFrom("bar")
+	orig.Env = map[string]string{"A": "b"}
+	orig.Tags = map[string]string{"t": "v"}
+	orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+	orig.StartTime = types.NewNullDuration(time.Second, true)
+
+	res, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"foo": orig}})
+	require.NoError(t, err)
+	require.Len(t, res.Scenarios, 1)
+
+	sc, ok := res.Scenarios["foo"].(SharedIterationsConfig)
+	require.True(t, ok)
+	assert.Equal(t, "foo", sc.GetName())
+	assert.Equal(t, "bar", sc.GetExec())
+	assert.Equal(t, orig.Env, sc.GetEnv())
+	assert.Equal(t, orig.Tags, sc.GetTags())
+	assert.Equal(t, orig.Options, sc.GetScenarioOptions())
+	assert.Equal(t, int64(1), sc.VUs.Int64)
+	assert.Equal(t, int64(1), sc.Iterations.Int64)
+	assert.Zero(t, sc.GetStartTime())
+}
+
+func TestApplyOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	_, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+		"a": NewSharedIterationsConfig("a"),
+		"b": NewSharedIterationsConfig("b"),
+	}})
+	require.ErrorIs(t, err, ErrOnceMultipleScenarios)
+}
