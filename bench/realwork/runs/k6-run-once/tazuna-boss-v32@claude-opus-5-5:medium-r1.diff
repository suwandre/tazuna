+// applyOnceFlag applies the --once flag to the consolidated options, if the flag is
+// defined on the command and set. It rejects the flag when combined with the CLI
+// flags that define the execution shape, since --once overrides them.
+func applyOnceFlag(flags *pflag.FlagSet, opts lib.Options) (lib.Options, error) {
+	if flags == nil || flags.Lookup("once") == nil {
+		return opts, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil {
+		return opts, err
+	}
+	if !once {
+		return opts, nil
+	}
+
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			return opts, errext.WithExitCodeIfNone(
+				fmt.Errorf("--once cannot be combined with --%s", name), exitcodes.InvalidConfig)
+		}
+	}
+
+	opts, err = executor.ApplyOnce(opts)
+	return opts, errext.WithExitCodeIfNone(err, exitcodes.InvalidConfig)
+}
