+// onceShortcutConflicts lists the CLI shortcut flags that can't be combined with --once.
+var onceShortcutConflicts = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// onceRequested reports whether the --once flag is set on the command. It returns an error if
+// --once is combined with any of the execution shortcut flags.
+func onceRequested(flags *pflag.FlagSet) (bool, error) {
+	if flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceShortcutConflicts {
+		if flags.Changed(name) {
+			return false, fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+	return true, nil
+}
