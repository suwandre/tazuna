+
+// ErrOnceMultipleScenarios is returned by ApplyOnce when more than one scenario is configured.
+var ErrOnceMultipleScenarios = ExecutionConflictError("--once can run a single scenario only")
+
+// ApplyOnce turns the options into a single run: 1 VU and 1 iteration.
+//
+// If no scenarios are configured, a default one is created. If exactly one scenario is configured,
+// it is replaced with a shared-iterations executor with 1 VU and 1 iteration, preserving its name,
+// exec, env, tags and scenario options. All the other scenario fields and the shortcut options
+// (vus, iterations, duration, stages) are discarded. More than one scenario is an error.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ErrOnceMultipleScenarios
+	}
+
+	name := lib.DefaultScenarioName
+	once := NewSharedIterationsConfig(name)
+	for scenarioName, sc := range opts.Scenarios {
+		name = scenarioName
+		once = NewSharedIterationsConfig(name)
+		if execFn := sc.GetExec(); execFn != consts.DefaultFn {
+			once.Exec = null.StringFrom(execFn)
+		}
+		once.Env = sc.GetEnv()
+		once.Tags = sc.GetTags()
+		once.Options = sc.GetScenarioOptions()
+	}
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{name: once}
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+
+	return opts, nil
+}
