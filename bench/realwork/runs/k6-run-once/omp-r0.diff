@@ -0,0 +1,72 @@
+package executor
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := ApplyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NewNullDuration(0, true),
+			Stages:     []lib.Stage{{}},
+		})
+		require.NoError(t, err)
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		assert.Nil(t, opts.Stages)
+
+		sc, ok := opts.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		rv := NewRampingVUsConfig("mine")
+		rv.Exec = null.StringFrom("fn")
+		rv.Env = map[string]string{"A": "b"}
+		rv.Tags = map[string]string{"t": "v"}
+		rv.Options = &lib.ScenarioOptions{}
+		rv.StartTime = types.NewNullDuration(10, true)
+		rv.StartVUs = null.IntFrom(20)
+
+		opts, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"mine": rv}})
+		require.NoError(t, err)
+		require.Len(t, opts.Scenarios, 1)
+
+		sc, ok := opts.Scenarios["mine"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "mine", sc.Name)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.Equal(t, "fn", sc.GetExec())
+		assert.Equal(t, rv.Env, sc.Env)
+		assert.Equal(t, rv.Tags, sc.Tags)
+		assert.Same(t, rv.Options, sc.Options)
+		assert.False(t, sc.StartTime.Valid)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": NewSharedIterationsConfig("a"),
+			"b": NewSharedIterationsConfig("b"),
+		}})
+		assert.ErrorIs(t, err, ErrOnceMultipleScenarios)
+	})
+}
