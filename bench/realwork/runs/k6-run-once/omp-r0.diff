+package tests
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+)
+
+func sumIterations(t *testing.T, results []byte, tags map[string]string) float64 {
+	t.Helper()
+	var total float64
+	for _, v := range getSampleValues(t, results, "iterations", tags) {
+		total += v
+	}
+	return total
+}
+
+func TestRunOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = { vus: 5, iterations: 50 };
+		export default function () {}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--out", "json=results.json", "--no-usage-report", "--once"}, 0)
+	results := runAndReadResults(t, ts)
+
+	assert.Equal(t, 1.0, sumIterations(t, results, map[string]string{"scenario": "default"}))
+}
+
+func TestRunOnceSingleScenarioPreservesConfig(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		import exec from 'k6/execution';
+		export const options = {
+			scenarios: {
+				mine: {
+					executor: 'constant-vus',
+					vus: 10,
+					duration: '1h',
+					exec: 'other',
+					tags: { custom: 'yes' },
+					env: { FOO: 'bar' },
+				},
+			},
+		};
+		export function other() {
+			if (__ENV.FOO !== 'bar') { throw new Error('env not preserved: ' + __ENV.FOO); }
+			if (exec.scenario.name !== 'mine') { throw new Error('wrong scenario'); }
+		}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--out", "json=results.json", "--no-usage-report", "--once"}, 0)
+	results := runAndReadResults(t, ts)
+
+	assert.Equal(t, 1.0, sumIterations(t, results, map[string]string{"scenario": "mine", "custom": "yes"}))
+}
+
+func TestRunOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				a: { executor: 'shared-iterations', iterations: 2 },
+				b: { executor: 'shared-iterations', iterations: 2 },
+			},
+		};
+		export default function () {}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--no-usage-report", "--once"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+}
+
+func TestRunOnceConflictsWithShortcuts(t *testing.T) {
+	t.Parallel()
+
+	for _, flag := range [][]string{
+		{"--iterations", "10"},
+		{"--vus", "2"},
+		{"--duration", "1s"},
+		{"--stage", "1s:2"},
+	} {
+		t.Run(flag[0], func(t *testing.T) {
+			t.Parallel()
+
+			args := append([]string{"--no-usage-report", "--once"}, flag...)
+			ts := getSingleFileTestState(t, `export default function () {}`, args, exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with "+flag[0])
+		})
+	}
+}
