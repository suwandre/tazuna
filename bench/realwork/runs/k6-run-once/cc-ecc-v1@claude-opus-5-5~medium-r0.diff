+		})
+		require.NoError(t, err)
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		assert.Nil(t, opts.Stages)
+		require.Len(t, opts.Scenarios, 1)
+
+		sc, ok := opts.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, "default", sc.GetExec())
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("EmptyScenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := applyOnceMode(lib.Options{Scenarios: lib.ScenarioConfigs{}})
+		require.NoError(t, err)
+		require.Len(t, opts.Scenarios, 1)
+		assert.Contains(t, opts.Scenarios, lib.DefaultScenarioName)
+	})
+
+	t.Run("SingleScenario", func(t *testing.T) {
+		t.Parallel()
+		browserOpts := &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		ramping := executor.NewRampingArrivalRateConfig("ui")
+		ramping.Exec = null.StringFrom("uiTest")
+		ramping.Env = map[string]string{"FOO": "bar"}
+		ramping.Tags = map[string]string{"team": "frontend"}
+		ramping.Options = browserOpts
+		ramping.StartTime = types.NullDurationFrom(time.Minute)
+		ramping.PreAllocatedVUs = null.IntFrom(50)
+
+		opts, err := applyOnceMode(lib.Options{
+			Iterations: null.IntFrom(100),
+			Scenarios:  lib.ScenarioConfigs{"ui": ramping},
+		})
+		require.NoError(t, err)
+		assert.False(t, opts.Iterations.Valid)
+		require.Len(t, opts.Scenarios, 1)
+
+		sc, ok := opts.Scenarios["ui"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "ui", sc.GetName())
+		assert.Equal(t, "shared-iterations", sc.GetType())
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, null.StringFrom("uiTest"), sc.Exec)
+		assert.Equal(t, map[string]string{"FOO": "bar"}, sc.Env)
+		assert.Equal(t, map[string]string{"team": "frontend"}, sc.Tags)
+		assert.Same(t, browserOpts, sc.Options)
