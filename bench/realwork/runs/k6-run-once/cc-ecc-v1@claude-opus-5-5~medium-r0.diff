+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cloudapi/v6/v6test"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func TestRunOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = { vus: 10, duration: '1m' };
+		export function setup() { console.log('setup ran'); }
+		export default function () { console.log('default ran'); }
+		export function teardown() { console.log('teardown ran'); }
+	`
+	ts := getSingleFileTestState(t, script, []string{"-v", "--log-output=stdout", "--once"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	t.Log(stdout)
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Contains(t, stdout, "setup ran")
+	assert.Contains(t, stdout, "default ran")
+	assert.Contains(t, stdout, "teardown ran")
+	assert.NotContains(t, stdout, "overrode scenarios configuration")
+}
+
+func TestRunOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		import exec from 'k6/execution';
+
+		export const options = {
+			scenarios: {
+				my_scenario: {
+					executor: 'constant-arrival-rate',
+					rate: 100,
+					duration: '1h',
+					preAllocatedVUs: 50,
+					startTime: '10s',
+					exec: 'myExec',
+					env: { MY_VAR: 'my-value' },
+					tags: { my_tag: 'tag-value' },
+				},
+			},
+		};
+
+		export default function () { throw new Error('default should not run'); }
+
+		export function myExec() {
+			console.log('scenario=' + exec.scenario.name + ' executor=' + exec.scenario.executor +
+				' env=' + __ENV.MY_VAR + ' tag=' + exec.vu.tags['my_tag']);
+		}
+	`
+	ts := getSingleFileTestState(t, script, []string{"-v", "--log-output=stdout", "--once"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	t.Log(stdout)
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Contains(t, stdout, "scenario=my_scenario executor=shared-iterations env=my-value tag=tag-value")
+	assert.NotContains(t, stdout, "default should not run")
+}
+
+func TestRunOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				first: { executor: 'shared-iterations' },
+				second: { executor: 'per-vu-iterations' },
+			},
+		};
+		export default function () {}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only, but 2 were configured: first, second")
+}
+
+func TestRunOnceConflictingFlags(t *testing.T) {
+	t.Parallel()
+
+	for _, flag := range [][]string{
+		{"--vus", "2"},
+		{"--iterations", "10"},
+		{"--duration", "10s"},
+		{"--stage", "10s:5"},
+	} {
+		t.Run(flag[0], func(t *testing.T) {
+			t.Parallel()
+			ts := getSingleFileTestState(t, `export default function () {}`,
+				append([]string{"--once"}, flag...), exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with "+flag[0])
+		})
+	}
+}
+
+func TestCloudRunOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+
+	var inspected atomic.Bool
+	inspectArchive := func(req *http.Request) {
+		file, _, err := req.FormFile("script")
+		require.NoError(t, err)
+		data, err := io.ReadAll(file)
+		require.NoError(t, err)
+
+		tmpPath := filepath.Join(ts.Cwd, "archive_to_cloud.tar")
+		require.NoError(t, fsext.WriteFile(ts.FS, tmpPath, data, 0o644))
+		require.NoError(t, testutils.Untar(t, ts.FS, tmpPath, "tmp/"))
+
+		metadataRaw, err := fsext.ReadFile(ts.FS, "tmp/metadata.json")
+		require.NoError(t, err)
+
+		metadata := struct {
+			Options struct {
+				Scenarios map[string]struct {
+					Executor   string            `json:"executor"`
+					VUs        int64             `json:"vus"`
+					Iterations int64             `json:"iterations"`
+					Exec       string            `json:"exec"`
+					Env        map[string]string `json:"env"`
+				} `json:"scenarios"`
+			} `json:"options"`
+		}{}
+		require.NoError(t, json.Unmarshal(metadataRaw, &metadata))
+		require.Len(t, metadata.Options.Scenarios, 1)
+		sc, ok := metadata.Options.Scenarios["api"]
+		require.True(t, ok)
+		assert.Equal(t, "shared-iterations", sc.Executor)
+		assert.Equal(t, int64(1), sc.VUs)
+		assert.Equal(t, int64(1), sc.Iterations)
+		assert.Equal(t, "apiTest", sc.Exec)
+		assert.Equal(t, map[string]string{"FOO": "bar"}, sc.Env)
+		inspected.Store(true)
+	}
+
+	srv := v6test.NewServer(t, v6test.Config{InspectArchive: inspectArchive})
+
+	script := `
+		export const options = {
+			cloud: { projectID: 1 },
+			scenarios: {
+				api: { executor: 'constant-vus', vus: 20, duration: '5m', exec: 'apiTest', env: { FOO: 'bar' } },
+			},
+		};
+		export function apiTest() {}
+	`
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(script), 0o644))
+	ts.CmdArgs = []string{"k6", "cloud", "run", "--verbose", "--log-output=stdout", "--once", "test.js"}
+	ts.Env["K6_SHOW_CLOUD_LOGS"] = "false"
+	ts.Env["K6_CLOUD_HOST_V6"] = srv.URL
+	ts.Env["K6_CLOUD_TOKEN"] = "foo" // doesn't matter, we mock the cloud
+	ts.Env["K6_CLOUD_STACK_ID"] = "1"
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	t.Log(ts.Stdout.String())
+	assert.True(t, inspected.Load(), "the archive should have been uploaded and inspected")
+}
