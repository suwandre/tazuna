+// onceConflictingFlags are the execution shortcut flags that cannot be combined with --once.
+var onceConflictingFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// isOnceMode reports whether the --once flag is defined and enabled.
+func isOnceMode(flags *pflag.FlagSet) bool {
+	if flags.Lookup("once") == nil {
+		return false
+	}
+	once, err := flags.GetBool("once")
+	return err == nil && once
+}
+
+// checkOnceFlagConflicts returns an error if --once was combined with an execution shortcut flag.
+func checkOnceFlagConflicts(flags *pflag.FlagSet) error {
+	for _, name := range onceConflictingFlags {
+		if flags.Changed(name) {
+			return fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+	return nil
+}
+
+// applyOnceMode transforms the consolidated options so that the test runs with 1 VU and 1
+// iteration. If there is a single scenario, its exec, env, tags and options are preserved, but
+// its executor is replaced with a shared-iterations one. The vus, iterations, duration and stages
+// shortcut options, as well as any other scenario fields, are discarded. It must be applied after
+// all the config layers are consolidated, so that no layer can override it.
+func applyOnceMode(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		names := make([]string, 0, len(opts.Scenarios))
+		for name := range opts.Scenarios {
+			names = append(names, name)
+		}
+		slices.Sort(names)
+		return opts, fmt.Errorf(
+			"--once can run a single scenario only, but %d were configured: %s",
+			len(names), strings.Join(names, ", "),
+		)
+	}
+
+	sc := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	sc.VUs = null.IntFrom(1)
+	sc.Iterations = null.IntFrom(1)
+	for name, orig := range opts.Scenarios {
+		sc.Name = name
+		if exec := orig.GetExec(); exec != consts.DefaultFn {
+			sc.Exec = null.StringFrom(exec)
+		}
+		sc.Env = orig.GetEnv()
+		sc.Tags = orig.GetTags()
+		sc.Options = orig.GetScenarioOptions()
+	}
+
+	opts.Scenarios = lib.ScenarioConfigs{sc.Name: sc}
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	return opts, nil
+}
