@@ -0,0 +1,184 @@
+package tests
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
