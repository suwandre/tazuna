+}
+
+func TestCheckOnceFlagConflicts(t *testing.T) {
+	t.Parallel()
+
+	for _, args := range [][]string{
+		{"--once", "--vus", "2"},
+		{"--once", "--iterations", "10"},
+		{"--once", "--duration", "10s"},
+		{"--once", "--stage", "10s:5"},
+	} {
+		t.Run(args[1], func(t *testing.T) {
+			t.Parallel()
+			flags := optionFlagSet()
+			require.NoError(t, flags.Parse(args))
+			require.True(t, isOnceMode(flags))
+			err := checkOnceFlagConflicts(flags)
+			require.ErrorContains(t, err, "--once cannot be combined with "+args[1])
+		})
+	}
+
+	t.Run("NoConflicts", func(t *testing.T) {
+		t.Parallel()
+		flags := optionFlagSet()
+		require.NoError(t, flags.Parse([]string{"--once", "--no-setup"}))
+		require.True(t, isOnceMode(flags))
+		require.NoError(t, checkOnceFlagConflicts(flags))
+	})
+
+	t.Run("NotDefined", func(t *testing.T) {
+		t.Parallel()
+		assert.False(t, isOnceMode(configFlagSet()))
+	})
+}
