+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	fileName := "script.js"
+	testScript := []byte(`
+		export const options = {
+			iterations: 50,
+			scenarios: {
+				ui: { executor: 'constant-vus', vus: 10, duration: '1m', exec: 'ui', tags: { kind: 'ui' } },
+			},
+		};
+		export function ui() {}
+	`)
+	ts := tests.NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, fileName), testScript, 0o644))
+
+	ts.CmdArgs = []string{"k6", "archive", "--once", fileName}
+
+	newRootCommand(ts.GlobalState).execute()
+	require.NoError(t, testutils.Untar(t, ts.FS, "archive.tar", "tmp/"))
+
+	data, err := fsext.ReadFile(ts.FS, "tmp/metadata.json")
+	require.NoError(t, err)
+
+	metadata := struct {
+		Options struct {
+			Iterations *int64                     `json:"iterations"`
+			Scenarios  map[string]json.RawMessage `json:"scenarios"`
+		} `json:"options"`
+	}{}
+	require.NoError(t, json.Unmarshal(data, &metadata))
+
+	assert.Nil(t, metadata.Options.Iterations)
+	require.Len(t, metadata.Options.Scenarios, 1)
+	require.Contains(t, metadata.Options.Scenarios, "ui")
+
+	scenario := struct {
+		Executor   string            `json:"executor"`
+		VUs        int64             `json:"vus"`
+		Iterations int64             `json:"iterations"`
+		Exec       string            `json:"exec"`
+		Tags       map[string]string `json:"tags"`
+		Duration   *string           `json:"duration"`
+	}{}
+	require.NoError(t, json.Unmarshal(metadata.Options.Scenarios["ui"], &scenario))
+	assert.Equal(t, "shared-iterations", scenario.Executor)
+	assert.Equal(t, int64(1), scenario.VUs)
+	assert.Equal(t, int64(1), scenario.Iterations)
+	assert.Equal(t, "ui", scenario.Exec)
+	assert.Equal(t, map[string]string{"kind": "ui"}, scenario.Tags)
+	assert.Nil(t, scenario.Duration)
+}
