@@ -0,0 +1,145 @@
+package tests
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+const onceSingleScenarioScript = `
+	import exec from 'k6/execution';
+	export const options = {
+		scenarios: {
+			only: {
+				executor: 'constant-vus',
+				vus: 5,
+				duration: '10s',
+				exec: 'custom',
+				env: { FOO: 'bar' },
+				tags: { mytag: 'myvalue' },
+			},
+		},
+	};
+	export function setup() { console.log('SETUP'); }
+	export function teardown() { console.log('TEARDOWN'); }
+	export function custom() {
+		console.log('CUSTOM FOO=' + __ENV.FOO + ' scenario=' + exec.scenario.name);
+	}
+	export default function () { console.log('WRONG FUNCTION'); }
+`
+
+func TestRunOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `
+		export const options = { vus: 5, duration: '10s' };
+		export function setup() { console.log('SETUP'); }
+		export function teardown() { console.log('TEARDOWN'); }
+		export default function () { console.log('DEFAULT'); }
+	`, []string{"--once", "--log-output=stdout", "--no-usage-report"}, 0)
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Equal(t, 1, strings.Count(stdout, "DEFAULT"))
+	assert.Equal(t, 1, strings.Count(stdout, "SETUP"))
+	assert.Equal(t, 1, strings.Count(stdout, "TEARDOWN"))
+}
+
+func TestRunOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, onceSingleScenarioScript,
+		[]string{"--once", "--log-output=stdout", "--no-usage-report", "--out", "json=results.json"}, 0)
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Contains(t, stdout, "CUSTOM FOO=bar scenario=only")
+	assert.NotContains(t, stdout, "WRONG FUNCTION")
+	assert.Equal(t, 1, strings.Count(stdout, "SETUP"))
+	assert.Equal(t, 1, strings.Count(stdout, "TEARDOWN"))
+
+	results, err := fsext.ReadFile(ts.FS, "results.json")
+	require.NoError(t, err)
+	tags := map[string]string{"scenario": "only", "mytag": "myvalue"}
+	assert.Equal(t, float64(1), sum(getSampleValues(t, results, "iterations", tags)))
+}
+
+func TestRunOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `
+		export const options = { scenarios: {
+			a: { executor: 'shared-iterations' },
+			b: { executor: 'shared-iterations' },
+		} };
+		export default function () {}
+	`, []string{"--once", "--no-usage-report"}, exitcodes.InvalidConfig)
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+}
+
+func TestRunOnceIncompatibleFlags(t *testing.T) {
+	t.Parallel()
+
+	for flag, value := range map[string]string{
+		"--vus": "2", "--iterations": "10", "--duration": "5s", "--stage": "5s:2",
+	} {
+		t.Run(flag, func(t *testing.T) {
+			t.Parallel()
+
+			ts := getSingleFileTestState(t, `export default function () {}`,
+				[]string{"--once", flag, value, "--no-usage-report"}, exitcodes.InvalidConfig)
+
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with "+flag)
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, onceSingleScenarioScript, nil, 0)
+	arcPath := filepath.Join(ts.Cwd, "once.tar")
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", arcPath, "test.js"}
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	f, err := ts.FS.Open(arcPath)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = f.Close() })
+	arc, err := lib.ReadArchive(f)
+	require.NoError(t, err)
+
+	require.Len(t, arc.Options.Scenarios, 1)
+	sc := arc.Options.Scenarios["only"]
+	require.NotNil(t, sc)
+	assert.Equal(t, "shared-iterations", sc.GetType())
+	assert.Equal(t, "custom", sc.GetExec())
+	assert.Equal(t, map[string]string{"FOO": "bar"}, sc.GetEnv())
+	assert.Equal(t, map[string]string{"mytag": "myvalue"}, sc.GetTags())
+	assert.Contains(t, sc.GetDescription(mustExecTuple(t)), "1 iterations shared among 1 VUs")
+}
+
+func mustExecTuple(t *testing.T) *lib.ExecutionTuple {
+	t.Helper()
+	et, err := lib.NewExecutionTuple(nil, nil)
+	require.NoError(t, err)
+	return et
+}
diff --git a/lib/executor/once.go b/lib/executor/once.go
new file mode 100644
index 0000000..b442bde
--- /dev/null
+++ b/lib/executor/once.go
@@ -0,0 +1,55 @@
+package executor
+
+import (
+	"errors"
+	"maps"
+
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+// ErrOnceMultipleScenarios is returned by DeriveOnceScenario when more than one scenario is configured.
+var ErrOnceMultipleScenarios = errors.New("--once can run a single scenario only")
+
+// DeriveOnceScenario implements the --once mode: it replaces the execution
+// configuration with a single shared-iterations scenario running 1 iteration in 1 VU.
+//
+// If no scenario is configured, the default scenario (the `default` exported
+// function) is used. If exactly one scenario is configured, its name and its
+// exec, env, tags and scenario options are preserved, while its executor and
+// all of the executor-specific fields (vus, iterations, duration, stages,
+// startTime, gracefulStop, etc.) are discarded. More than one scenario is an
+// error.
+//
+// Any execution shortcuts (vus, iterations, duration, stages) in the passed
+// options are discarded as well, so the result can be safely passed to
+// DeriveScenariosFromShortcuts.
+func DeriveOnceScenario(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ErrOnceMultipleScenarios
+	}
+
+	once := NewSharedIterationsConfig(lib.DefaultScenarioName)
+	for name, sc := range opts.Scenarios {
+		once = NewSharedIterationsConfig(name)
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			once.Exec = null.StringFrom(exec)
+		}
+		once.Env = maps.Clone(sc.GetEnv())
+		once.Tags = maps.Clone(sc.GetTags())
+		once.Options = sc.GetScenarioOptions()
+	}
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	opts.VUs = null.NewInt(0, false)
+	opts.Iterations = null.NewInt(0, false)
+	opts.Duration = types.NewNullDuration(0, false)
+	opts.Stages = nil
+	opts.Scenarios = lib.ScenarioConfigs{once.GetName(): once}
+
+	return opts, nil
+}
