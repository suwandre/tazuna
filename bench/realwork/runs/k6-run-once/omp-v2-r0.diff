@@ -0,0 +1,82 @@
+package executor
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestDeriveOnceScenario(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios, shortcuts are discarded", func(t *testing.T) {
+		t.Parallel()
+
+		res, err := DeriveOnceScenario(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NewNullDuration(1, true),
+			Stages:     []lib.Stage{{Duration: types.NewNullDuration(1, true), Target: null.IntFrom(5)}},
+		})
+		require.NoError(t, err)
+
+		assert.False(t, res.VUs.Valid)
+		assert.False(t, res.Iterations.Valid)
+		assert.False(t, res.Duration.Valid)
+		assert.Nil(t, res.Stages)
+
+		require.Len(t, res.Scenarios, 1)
+		sc, ok := res.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.Exec.Valid)
+		assert.Empty(t, res.Validate())
+	})
+
+	t.Run("single scenario keeps exec, env, tags and options", func(t *testing.T) {
+		t.Parallel()
+
+		orig := NewRampingVUsConfig("custom")
+		orig.Exec = null.StringFrom("myFunc")
+		orig.Env = map[string]string{"A": "b"}
+		orig.Tags = map[string]string{"t": "v"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		orig.StartTime = types.NewNullDuration(5, true)
+		orig.GracefulStop = types.NewNullDuration(7, true)
+		orig.StartVUs = null.IntFrom(20)
+
+		res, err := DeriveOnceScenario(lib.Options{Scenarios: lib.ScenarioConfigs{"custom": orig}})
+		require.NoError(t, err)
+
+		require.Len(t, res.Scenarios, 1)
+		sc, ok := res.Scenarios["custom"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "custom", sc.GetName())
+		assert.Equal(t, sharedIterationsType, sc.GetType())
+		assert.Equal(t, "myFunc", sc.GetExec())
+		assert.Equal(t, orig.Env, sc.GetEnv())
+		assert.Equal(t, orig.Tags, sc.GetTags())
+		assert.Equal(t, orig.Options, sc.GetScenarioOptions())
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.StartTime.Valid)
+		assert.False(t, sc.GracefulStop.Valid)
+		assert.Empty(t, res.Validate())
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		_, err := DeriveOnceScenario(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": NewPerVUIterationsConfig("a"),
+			"b": NewPerVUIterationsConfig("b"),
+		}})
+		require.ErrorIs(t, err, ErrOnceMultipleScenarios)
+	})
+}
