+// onceIncompatibleFlags lists the execution shortcut flags that can't be combined with --once.
+var onceIncompatibleFlags = [...]string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// getOnce returns whether the --once flag was set. It returns an error if it
+// was combined with any of the execution shortcut flags. A flag set without a
+// "once" flag (e.g. the one of the inspect command) is treated as not set.
+func getOnce(flags *pflag.FlagSet) (bool, error) {
+	if flags == nil || flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceIncompatibleFlags {
+		if flags.Changed(name) {
+			return false, fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+	return true, nil
+}
