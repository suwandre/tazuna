diff --git a/internal/cmd/once.go b/internal/cmd/once.go
new file mode 100644
index 0000000..d47a71a
--- /dev/null
+++ b/internal/cmd/once.go
@@ -0,0 +1,67 @@
+package cmd
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/spf13/pflag"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+const onceFlagName = "once"
+
+// onceConflictingFlags are the shortcut flags that can't be combined with --once.
+var onceConflictingFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// validateOnceFlags returns an error if --once is combined with any shortcut flag.
+func validateOnceFlags(flags *pflag.FlagSet) error {
+	for _, name := range onceConflictingFlags {
+		if flags.Lookup(name) != nil && flags.Changed(name) {
+			return fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name)
+		}
+	}
+	return nil
+}
+
+// applyOnce transforms the consolidated options so the test runs with 1 VU and 1 iteration.
+// It keeps the exec, env, tags and options of a single scenario, replacing its executor with
+// shared-iterations. It must run after the config layers are consolidated.
+func applyOnce(opts lib.Options) (lib.Options, error) {
+	cfg := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	switch len(opts.Scenarios) {
+	case 0:
+	case 1:
+		for name, sc := range opts.Scenarios {
+			cfg = executor.NewSharedIterationsConfig(name)
+			if exec := sc.GetExec(); exec != "" {
+				cfg.Exec = null.StringFrom(exec)
+			}
+			cfg.Env = sc.GetEnv()
+			cfg.Tags = sc.GetTags()
+			cfg.Options = sc.GetScenarioOptions()
+		}
+	default:
+		names := make([]string, 0, len(opts.Scenarios))
+		for name := range opts.Scenarios {
+			names = append(names, name)
+		}
+		sort.Strings(names)
+		return opts, fmt.Errorf("--%s can run a single scenario only, but the script defines %d: %s",
+			onceFlagName, len(names), strings.Join(names, ", "))
+	}
+	cfg.VUs = null.IntFrom(1)
+	cfg.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{cfg.GetName(): cfg}
+	// Discard the shortcuts, otherwise they'd conflict with the scenario.
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	return opts, nil
+}
diff --git a/internal/cmd/once_test.go b/internal/cmd/once_test.go
new file mode 100644
index 0000000..b609eab
--- /dev/null
+++ b/internal/cmd/once_test.go
@@ -0,0 +1,68 @@
+package cmd
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := applyOnce(lib.Options{VUs: null.IntFrom(10), Duration: types.NullDurationFrom(5)})
+		require.NoError(t, err)
+		sc, ok := opts.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		require.Equal(t, int64(1), sc.VUs.Int64)
+		require.Equal(t, int64(1), sc.Iterations.Int64)
+		require.False(t, opts.VUs.Valid)
+		require.False(t, opts.Duration.Valid)
+	})
+
+	t.Run("single scenario keeps exec env tags", func(t *testing.T) {
+		t.Parallel()
+		orig := executor.NewConstantVUsConfig("foo")
+		orig.Exec = null.StringFrom("fn")
+		orig.Env = map[string]string{"A": "b"}
+		orig.Tags = map[string]string{"t": "v"}
+		orig.VUs = null.IntFrom(7)
+		opts, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"foo": orig}})
+		require.NoError(t, err)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios["foo"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		require.Equal(t, "fn", sc.Exec.String)
+		require.Equal(t, map[string]string{"A": "b"}, sc.Env)
+		require.Equal(t, map[string]string{"t": "v"}, sc.Tags)
+		require.Equal(t, int64(1), sc.VUs.Int64)
+		require.Equal(t, int64(1), sc.Iterations.Int64)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": executor.NewConstantVUsConfig("a"),
+			"b": executor.NewConstantVUsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
+
+func TestValidateOnceFlags(t *testing.T) {
+	t.Parallel()
+
+	fs := optionFlagSet()
+	require.NoError(t, fs.Parse([]string{"--once"}))
+	require.NoError(t, validateOnceFlags(fs))
+
+	fs = optionFlagSet()
+	require.NoError(t, fs.Parse([]string{"--once", "--iterations", "10"}))
+	require.ErrorContains(t, validateOnceFlags(fs), "--once cannot be combined with --iterations")
+}
