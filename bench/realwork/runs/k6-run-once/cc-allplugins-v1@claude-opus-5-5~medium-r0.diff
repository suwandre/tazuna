@@ -0,0 +1,121 @@
+package cmd
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts, err := applyOnce(lib.Options{
+			VUs:      null.IntFrom(10),
+			Duration: types.NullDurationFrom(time.Minute),
+		})
+		require.NoError(t, err)
+
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Duration.Valid)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, "default", sc.GetExec())
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		orig := executor.NewRampingVUsConfig("browser")
+		orig.Exec = null.StringFrom("browse")
+		orig.Env = map[string]string{"FOO": "bar"}
+		orig.Tags = map[string]string{"team": "qa"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		orig.StartTime = types.NullDurationFrom(time.Minute)
+		orig.Stages = []executor.Stage{{Duration: types.NullDurationFrom(time.Minute), Target: null.IntFrom(10)}}
+
+		opts, err := applyOnce(lib.Options{
+			Iterations: null.IntFrom(5),
+			Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second)}},
+			Scenarios:  lib.ScenarioConfigs{"browser": orig},
+		})
+		require.NoError(t, err)
+
+		assert.False(t, opts.Iterations.Valid)
+		assert.Nil(t, opts.Stages)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios["browser"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "browser", sc.GetName())
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, "browse", sc.GetExec())
+		assert.Equal(t, orig.Env, sc.GetEnv())
+		assert.Equal(t, orig.Tags, sc.GetTags())
+		assert.Equal(t, orig.Options, sc.GetScenarioOptions())
+		assert.Zero(t, sc.GetStartTime())
+		assert.Empty(t, sc.Validate())
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		_, err := applyOnce(lib.Options{
+			Scenarios: lib.ScenarioConfigs{
+				"a": executor.NewPerVUIterationsConfig("a"),
+				"b": executor.NewPerVUIterationsConfig("b"),
+			},
+		})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
+
+func TestApplyOnceFlag(t *testing.T) {
+	t.Parallel()
+
+	for _, args := range [][]string{
+		{"--once", "--vus", "2"},
+		{"--once", "--iterations", "10"},
+		{"--once", "--duration", "10s"},
+		{"--once", "--stage", "10s:2"},
+	} {
+		t.Run(args[1], func(t *testing.T) {
+			t.Parallel()
+
+			flags := optionFlagSet()
+			require.NoError(t, flags.Parse(args))
+			_, err := applyOnceFlag(flags, Config{})
+			require.ErrorContains(t, err, "--once cannot be combined with "+args[1])
+		})
+	}
+
+	t.Run("not set", func(t *testing.T) {
+		t.Parallel()
+
+		flags := optionFlagSet()
+		require.NoError(t, flags.Parse([]string{"--iterations", "10"}))
+		conf, err := applyOnceFlag(flags, Config{})
+		require.NoError(t, err)
+		assert.Nil(t, conf.Scenarios)
+	})
+
+	t.Run("flag not defined", func(t *testing.T) {
+		t.Parallel()
+
+		conf, err := applyOnceFlag(configFlagSet(), Config{})
+		require.NoError(t, err)
+		assert.Nil(t, conf.Scenarios)
+	})
+}
