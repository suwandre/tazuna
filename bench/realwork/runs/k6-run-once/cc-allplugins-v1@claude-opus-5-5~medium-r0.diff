+// applyOnceFlag transforms the consolidated configuration when the --once flag is set, so the
+// test runs with 1 VU and 1 iteration. It's applied after the config consolidation, so it
+// takes precedence over all of the config layers.
+func applyOnceFlag(flags *pflag.FlagSet, conf Config) (Config, error) {
+	if flags.Lookup("once") == nil {
+		return conf, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return conf, err
+	}
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			return conf, fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+
+	conf.Options, err = applyOnce(conf.Options)
+	return conf, err
+}
+
+// applyOnce replaces the scenarios with a single shared-iterations scenario that runs 1
+// iteration with 1 VU. If a scenario was configured, its exec, env, tags, and options are
+// preserved. All of the other execution options are discarded.
+func applyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, errors.New("--once can run a single scenario only")
+	}
+
+	scenario := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	scenario.VUs = null.IntFrom(1)
+	scenario.Iterations = null.IntFrom(1)
+	for name, sc := range opts.Scenarios {
+		scenario.Name = name
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			scenario.Exec = null.StringFrom(exec)
+		}
+		scenario.Env = sc.GetEnv()
+		scenario.Tags = sc.GetTags()
+		scenario.Options = sc.GetScenarioOptions()
+	}
+
+	opts.Scenarios = lib.ScenarioConfigs{scenario.Name: scenario}
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	return opts, nil
+}
