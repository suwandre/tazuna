@@ -0,0 +1,91 @@
+package tests
+
+import (
+	"testing"
+
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+)
+
+func TestRunOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = { vus: 10, duration: '1h' };
+		export function setup() { console.log('setup'); }
+		export default function () { console.log('iteration'); }
+		export function teardown() { console.log('teardown'); }
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	t.Log(stdout)
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Contains(t, stdout, `msg=setup`)
+	assert.Contains(t, stdout, `msg=teardown`)
+}
+
+func TestRunOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				custom: {
+					executor: 'constant-vus',
+					vus: 5,
+					duration: '1h',
+					exec: 'custom',
+					env: { FOO: 'bar' },
+				},
+			},
+		};
+		export function custom() { console.log('custom ' + __ENV.FOO); }
+		export default function () { throw new Error('default should not run'); }
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	t.Log(stdout)
+	assert.Contains(t, stdout, "custom: 1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "exec: custom")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Contains(t, stdout, `msg="custom bar"`)
+}
+
+func TestRunOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				a: { executor: 'per-vu-iterations' },
+				b: { executor: 'per-vu-iterations' },
+			},
+		};
+		export default function () {}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.True(t, testutils.LogContains(ts.LoggerHook.Drain(), logrus.ErrorLevel,
+		"--once can run a single scenario only"))
+}
+
+func TestRunOnceWithShortcutFlag(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `export default function () {}`,
+		[]string{"--once", "--iterations", "10"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.True(t, testutils.LogContains(ts.LoggerHook.Drain(), logrus.ErrorLevel,
+		"--once cannot be combined with --iterations"))
+}
