+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	fileName := "script.js"
+	testScript := []byte(`
+		export const options = {
+			vus: 10,
+			scenarios: {
+				custom: { executor: 'constant-vus', vus: 5, duration: '1h', exec: 'custom', tags: { a: 'b' } },
+			},
+		};
+		export function custom() {}
+	`)
+	ts := tests.NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, fileName), testScript, 0o644))
+
+	ts.CmdArgs = []string{"k6", "archive", "--once", fileName}
+
+	newRootCommand(ts.GlobalState).execute()
+	require.NoError(t, testutils.Untar(t, ts.FS, "archive.tar", "tmp/"))
+
+	data, err := fsext.ReadFile(ts.FS, "tmp/metadata.json")
+	require.NoError(t, err)
+
+	metadata := struct {
+		Options struct {
+			VUs       *int64 `json:"vus"`
+			Scenarios map[string]struct {
+				Executor   string            `json:"executor"`
+				VUs        int64             `json:"vus"`
+				Iterations int64             `json:"iterations"`
+				Exec       string            `json:"exec"`
+				Tags       map[string]string `json:"tags"`
+			} `json:"scenarios"`
+		} `json:"options"`
+	}{}
+	require.NoError(t, json.Unmarshal(data, &metadata))
+
+	require.Nil(t, metadata.Options.VUs)
+	require.Len(t, metadata.Options.Scenarios, 1)
+	sc := metadata.Options.Scenarios["custom"]
+	require.Equal(t, "shared-iterations", sc.Executor)
+	require.Equal(t, int64(1), sc.VUs)
+	require.Equal(t, int64(1), sc.Iterations)
+	require.Equal(t, "custom", sc.Exec)
+	require.Equal(t, map[string]string{"a": "b"}, sc.Tags)
+}
