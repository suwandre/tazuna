+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("default function", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			export const options = { vus: 5, iterations: 50 };
+			export function setup() { console.log('setup'); }
+			export default function () { console.log('default'); }
+			export function teardown() { console.log('teardown'); }
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Equal(t, 1, strings.Count(stdout, "msg=default"), stdout)
+		assert.Contains(t, stdout, "msg=setup")
+		assert.Contains(t, stdout, "msg=teardown")
+		assert.Contains(t, stdout, "iterations...........: 1 ")
+	})
+
+	t.Run("single scenario preserves exec env and tags", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			import exec from 'k6/execution';
+
+			export const options = {
+				scenarios: {
+					foo: {
+						executor: 'constant-vus',
+						vus: 10,
+						duration: '1m',
+						exec: 'other',
+						env: { MY_VAR: 'bar' },
+						tags: { mytag: 'baz' },
+					},
+				},
+			};
+			export default function () { console.log('wrong'); }
+			export function other() {
+				console.log('other ' + __ENV.MY_VAR + ' ' + exec.scenario.name + ' ' +
+					exec.vu.metrics.tags.mytag + ' ' + exec.test.options.scenarios.foo.executor);
+			}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Equal(t, 1, strings.Count(stdout, "msg=\"other "), stdout)
+		assert.Contains(t, stdout, "other bar foo baz shared-iterations")
+		assert.NotContains(t, stdout, "msg=wrong")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			export const options = {
+				scenarios: {
+					a: { executor: 'shared-iterations' },
+					b: { executor: 'shared-iterations' },
+				},
+			};
+			export default function () {}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.Contains(t, ts.Stderr.String()+ts.Stdout.String(), "--once can run a single scenario only")
+	})
+
+	for _, flag := range [][]string{
+		{"--iterations", "10"}, {"--vus", "2"}, {"--duration", "10s"}, {"--stage", "10s:5"},
+	} {
+		t.Run("conflicts with "+flag[0], func(t *testing.T) {
+			t.Parallel()
+			ts := getSingleFileTestState(t,
+				`export default function () {}`, append([]string{"--once"}, flag...), exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.Contains(t, ts.Stderr.String()+ts.Stdout.String(),
+				"--once cannot be combined with "+flag[0])
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	script := `
+		export const options = {
+			scenarios: { foo: { executor: 'constant-vus', vus: 10, duration: '1m', exec: 'other' } },
+		};
+		export function other() {}
+	`
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(script), 0o644))
+	archivePath := filepath.Join(ts.Cwd, "out.tar")
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", archivePath, "test.js"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	f, err := ts.FS.Open(archivePath)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = f.Close() })
+	arc, err := lib.ReadArchive(f)
+	require.NoError(t, err)
+
+	require.Len(t, arc.Options.Scenarios, 1)
+	sc, ok := arc.Options.Scenarios["foo"].(executor.SharedIterationsConfig)
+	require.True(t, ok, "expected a shared-iterations scenario, got %T", arc.Options.Scenarios["foo"])
+	assert.Equal(t, int64(1), sc.VUs.Int64)
+	assert.Equal(t, int64(1), sc.Iterations.Int64)
+	assert.Equal(t, "other", sc.GetExec())
+}
