+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestDeriveOnceScenario(t *testing.T) {
+	t.Parallel()
+
+	assertOnce := func(t *testing.T, opts lib.Options, name string) SharedIterationsConfig {
+		t.Helper()
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios[name].(SharedIterationsConfig)
+		require.True(t, ok, "expected a shared-iterations scenario named %q", name)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		assert.Nil(t, opts.Stages)
+		return sc
+	}
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := DeriveOnceScenario(lib.Options{})
+		require.NoError(t, err)
+		sc := assertOnce(t, opts, lib.DefaultScenarioName)
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("shortcuts are discarded", func(t *testing.T) {
+		t.Parallel()
+		opts, err := DeriveOnceScenario(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second)}},
+		})
+		require.NoError(t, err)
+		assertOnce(t, opts, lib.DefaultScenarioName)
+	})
+
+	t.Run("single scenario keeps its config", func(t *testing.T) {
+		t.Parallel()
+		orig := NewConstantArrivalRateConfig("foo")
+		orig.Exec = null.StringFrom("fn")
+		orig.Env = map[string]string{"A": "b"}
+		orig.Tags = map[string]string{"c": "d"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		orig.StartTime = types.NullDurationFrom(5 * time.Second)
+		orig.Duration = types.NullDurationFrom(time.Minute)
+
+		opts, err := DeriveOnceScenario(lib.Options{
+			Scenarios: lib.ScenarioConfigs{"foo": orig},
+			VUs:       null.IntFrom(3),
+		})
+		require.NoError(t, err)
+		sc := assertOnce(t, opts, "foo")
+		assert.Equal(t, "fn", sc.GetExec())
+		assert.Equal(t, orig.Env, sc.Env)
+		assert.Equal(t, orig.Tags, sc.Tags)
+		assert.Equal(t, orig.Options, sc.Options)
+		assert.Equal(t, sharedIterationsType, sc.GetType())
+		assert.Zero(t, sc.GetStartTime())
+		assert.Empty(t, sc.Validate())
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := DeriveOnceScenario(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": NewSharedIterationsConfig("a"),
+			"b": NewSharedIterationsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
