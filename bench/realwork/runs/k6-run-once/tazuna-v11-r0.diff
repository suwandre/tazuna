+// DeriveOnceScenario implements the `--once` mode. It reduces the execution
+// configuration to a single shared-iterations scenario with 1 VU and 1
+// iteration.
+//
+// If no scenarios are configured, the default scenario is used. If exactly one
+// scenario is configured, it is kept under its name, preserving its exec, env,
+// tags and options (e.g. browser), while the executor is replaced and all
+// executor-specific fields (VUs, iterations, duration, stages, startTime,
+// etc.) are discarded. Any shortcut options are cleared as well, so they won't
+// override the result when the scenarios are derived later on.
+//
+// It returns an error if more than one scenario is configured.
+func DeriveOnceScenario(opts lib.Options) (lib.Options, error) {
+	name := lib.DefaultScenarioName
+	sc := NewSharedIterationsConfig(name)
+
+	switch len(opts.Scenarios) {
+	case 0:
+	case 1:
+		for scName, orig := range opts.Scenarios {
+			name = scName
+			sc = NewSharedIterationsConfig(name)
+			if exec := orig.GetExec(); exec != consts.DefaultFn {
+				sc.Exec = null.StringFrom(exec)
+			}
+			sc.Env = orig.GetEnv()
+			sc.Tags = orig.GetTags()
+			sc.Options = orig.GetScenarioOptions()
+		}
+	default:
+		return opts, ExecutionConflictError(
+			"--once can run a single scenario only, but the script defines " +
+				strconv.Itoa(len(opts.Scenarios)) + " scenarios",
+		)
+	}
+
+	sc.VUs = null.IntFrom(1)
+	sc.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{name: sc}
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+
+	return opts, nil
+}
