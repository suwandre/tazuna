+// onceFlagName is the name of the flag that runs the script with 1 VU and 1 iteration.
+const onceFlagName = "once"
+
+// onceConflictingFlags are the shortcut flags that can't be combined with --once.
+var onceConflictingFlags = []string{"vus", "duration", "iterations", "stage"} //nolint:gochecknoglobals
+
+// onceFlagSet returns the FlagSet with the --once flag. It's separate from optionFlagSet() because
+// it's not an option that can be set from the script, the environment or the config file.
+func onceFlagSet() *pflag.FlagSet {
+	flags := pflag.NewFlagSet("", 0)
+	flags.SortFlags = false
+	flags.Bool(onceFlagName, false,
+		"run the script once, with 1 VU and 1 iteration, preserving the scenario configuration")
+	return flags
+}
+
+// getOnce returns whether --once was set. It's false for commands that don't have the flag.
+// It returns an error if --once is combined with one of the shortcut flags.
+func getOnce(flags *pflag.FlagSet) (bool, error) {
+	if flags.Lookup(onceFlagName) == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool(onceFlagName)
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceConflictingFlags {
+		if flags.Changed(name) {
+			return false, fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name)
+		}
+	}
+	return true, nil
+}
