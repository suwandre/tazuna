+// getOnceFlag reports whether the --once flag was set. It returns an error if --once is
+// combined with any of the execution shortcut flags.
+func getOnceFlag(flags *pflag.FlagSet) (bool, error) {
+	if flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			return false, errext.WithExitCodeIfNone(
+				fmt.Errorf("--once cannot be combined with --%s", name), exitcodes.InvalidConfig)
+		}
+	}
+	return true, nil
+}
+
+// applyOnce rewrites the execution options so the test runs with 1 VU and 1 iteration. The exec,
+// env, tags and options of the only scenario, if any, are preserved; everything else is discarded.
+func applyOnce(opts lib.Options) (lib.Options, error) {
+	ds := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	switch len(opts.Scenarios) {
+	case 0:
+	case 1:
+		for name, sc := range opts.Scenarios {
+			ds = executor.NewSharedIterationsConfig(name)
+			if exec := sc.GetExec(); exec != consts.DefaultFn {
+				ds.Exec = null.StringFrom(exec)
+			}
+			ds.Env = sc.GetEnv()
+			ds.Tags = sc.GetTags()
+			ds.Options = sc.GetScenarioOptions()
+		}
+	default:
+		return opts, errext.WithExitCodeIfNone(
+			errors.New("--once can run a single scenario only"), exitcodes.InvalidConfig)
+	}
+	ds.VUs = null.IntFrom(1)
+	ds.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{ds.Name: ds}
+	// Clear the shortcut options so DeriveScenariosFromShortcuts keeps the scenario as is.
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	return opts, nil
+}
