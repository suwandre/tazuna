@@ -500,3 +500,93 @@ func TestWriteDiskConfigTightensPreExistingDirectoryPermissions(t *testing.T) {
 	assert.True(t, finfo.IsDir())
 	assert.Equal(t, configDirMode, finfo.Mode().Perm())
 }
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts := lib.Options{
+			VUs:        null.IntFrom(5),
+			Iterations: null.IntFrom(10),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages: []lib.Stage{
+				{Duration: types.NullDurationFrom(time.Second), Target: null.IntFrom(2)},
+			},
+		}
+
+		res, err := applyOnce(opts)
+		require.NoError(t, err)
+
+		require.Len(t, res.Scenarios, 1)
+		sc, ok := res.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+
+		assert.False(t, res.VUs.Valid)
+		assert.False(t, res.Iterations.Valid)
+		assert.False(t, res.Duration.Valid)
+		assert.Nil(t, res.Stages)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		env := map[string]string{"A": "1"}
+		tags := map[string]string{"t": "v"}
+		scOpts := &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		opts := lib.Options{
+			Scenarios: lib.ScenarioConfigs{
+				"foo": executor.ConstantVUsConfig{
+					BaseConfig: executor.BaseConfig{
+						Name:      "foo",
+						Type:      "constant-vus",
+						Exec:      null.StringFrom("fn"),
+						Env:       env,
+						Tags:      tags,
+						Options:   scOpts,
+						StartTime: types.NullDurationFrom(time.Second),
+					},
+					VUs:      null.IntFrom(3),
+					Duration: types.NullDurationFrom(time.Minute),
+				},
+			},
+		}
+
+		res, err := applyOnce(opts)
+		require.NoError(t, err)
+
+		require.Len(t, res.Scenarios, 1)
+		sc, ok := res.Scenarios["foo"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, null.StringFrom("fn"), sc.Exec)
+		assert.Equal(t, env, sc.Env)
+		assert.Equal(t, tags, sc.Tags)
+		assert.Equal(t, scOpts, sc.Options)
+		assert.False(t, sc.StartTime.Valid)
+		assert.Equal(t, "shared-iterations", sc.Type)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts := lib.Options{
+			Scenarios: lib.ScenarioConfigs{
+				"a": executor.NewSharedIterationsConfig("a"),
+				"b": executor.NewSharedIterationsConfig("b"),
+			},
+		}
+
+		_, err := applyOnce(opts)
+		require.Error(t, err)
+		assert.ErrorContains(t, err, "--once can run a single scenario only")
+
+		var hasExitCode errext.HasExitCode
+		require.ErrorAs(t, err, &hasExitCode)
+		assert.Equal(t, exitcodes.InvalidConfig, hasExitCode.ExitCode())
+	})
+}
