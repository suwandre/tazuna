+func TestRunOnceDefault(t *testing.T) {
+	t.Parallel()
+
+	script := `export const options = { vus: 5, iterations: 10 }; export default function() {}`
+	ts := getSingleFileTestState(t, script, []string{"--once"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+}
+
+func TestRunOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				foo: {
+					executor: 'constant-vus',
+					vus: 3,
+					duration: '10s',
+					exec: 'fn',
+					env: { MYVAR: 'x' },
+					tags: { mytag: 'y' },
+				},
+			},
+		};
+		export function setup() { console.log('setup ran'); }
+		export function fn() { console.log('env=' + __ENV.MYVAR); }
+		export function teardown() { console.log('teardown ran'); }
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "foo: 1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "exec: fn")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+
+	logs := ts.LoggerHook.Drain()
+	assert.True(t, testutils.LogContains(logs, logrus.InfoLevel, "env=x"))
+	assert.True(t, testutils.LogContains(logs, logrus.InfoLevel, "setup ran"))
+	assert.True(t, testutils.LogContains(logs, logrus.InfoLevel, "teardown ran"))
+}
+
+func TestRunOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				a: { executor: 'shared-iterations', vus: 1, iterations: 1 },
+				b: { executor: 'shared-iterations', vus: 1, iterations: 1 },
+			},
+		};
+		export default function() {}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.True(t, testutils.LogContains(
+		ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once can run a single scenario only",
+	))
+}
+
