+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	const defaultScript = `
+export const options = { vus: 5, iterations: 50 };
+export function setup() { console.log("setup-ran"); }
+export default function () { console.log("default-ran"); }
+export function teardown() { console.log("teardown-ran"); }
+`
+	const singleScenario = `
+export const options = {
+  scenarios: { foo: { executor: 'constant-vus', vus: 5, duration: '1m', exec: 'fn', env: { MYENV: 'hello' } } },
+};
+export function fn() { console.log("fn-ran-" + __ENV.MYENV); }
+export default function () { console.log("default-ran"); }
+`
+	const twoScenarios = `
+export const options = {
+  scenarios: {
+    a: { executor: 'constant-vus', vus: 1, duration: '1s' },
+    b: { executor: 'constant-vus', vus: 1, duration: '1s' },
+  },
+};
+export default function () {}
+`
+
+	t.Run("default function", func(t *testing.T) {
+		t.Parallel()
+		ts := tests.NewGlobalTestState(t)
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "s.js"), []byte(defaultScript), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "s.js"}
+		newRootCommand(ts.GlobalState).execute()
+
+		stdout := ts.Stdout.String()
+		assert.Equal(t, 1, strings.Count(stdout+ts.Stderr.String(), "default-ran"))
+		assert.Contains(t, stdout+ts.Stderr.String(), "setup-ran")
+		assert.Contains(t, stdout+ts.Stderr.String(), "teardown-ran")
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		ts := tests.NewGlobalTestState(t)
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "s.js"), []byte(singleScenario), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "s.js"}
+		newRootCommand(ts.GlobalState).execute()
+
+		out := ts.Stdout.String() + ts.Stderr.String()
+		assert.Equal(t, 1, strings.Count(out, "fn-ran-hello"))
+		assert.NotContains(t, out, "default-ran")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := tests.NewGlobalTestState(t)
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "s.js"), []byte(twoScenarios), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "s.js"}
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+		newRootCommand(ts.GlobalState).execute()
+
+		assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+	})
+
+	t.Run("combined with shortcut", func(t *testing.T) {
+		t.Parallel()
+		ts := tests.NewGlobalTestState(t)
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "s.js"), []byte(defaultScript), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "--iterations", "10", "s.js"}
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+		newRootCommand(ts.GlobalState).execute()
+
+		assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with --iterations")
+	})
+}
