+// applyOnceFlag transforms the consolidated config if the --once flag is set.
+// It returns whether the flag was set.
+func applyOnceFlag(flags *pflag.FlagSet, conf *Config) (bool, error) {
+	if flags == nil || flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			return false, fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+
+	conf.Options, err = executor.ApplyOnce(conf.Options)
+	if err != nil {
+		return false, err
+	}
+	return true, nil
+}
