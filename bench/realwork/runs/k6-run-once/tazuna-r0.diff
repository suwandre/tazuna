+// ApplyOnce transforms the options so the script runs with 1 VU and 1 iteration.
+// If no scenarios are configured, the default one is used. If exactly one scenario
+// is configured, it is replaced by a shared-iterations executor (1 VU, 1 iteration)
+// that preserves only its exec, env, tags and options. Any execution shortcuts
+// (vus, iterations, duration, stages) are discarded.
+// More than one scenario is an error.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ExecutionConflictError("--once can run a single scenario only")
+	}
+
+	name := lib.DefaultScenarioName
+	once := NewSharedIterationsConfig(name)
+	for scName, sc := range opts.Scenarios {
+		name = scName
+		once = NewSharedIterationsConfig(name)
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			once.Exec = null.StringFrom(exec)
+		}
+		once.Env = sc.GetEnv()
+		once.Tags = sc.GetTags()
+		once.Options = sc.GetScenarioOptions()
+	}
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{name: once}
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	return opts, nil
+}
