+++ b/internal/cmd/once.go
@@ -0,0 +1,75 @@
+package cmd
+
+import (
+	"fmt"
+
+	"github.com/spf13/pflag"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+// validateOnceFlags returns an error if --once is set together with a shortcut flag.
+func validateOnceFlags(flags *pflag.FlagSet) error {
+	if !isOnce(flags) {
+		return nil
+	}
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			return fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+	return nil
+}
+
+func isOnce(flags *pflag.FlagSet) bool {
+	if flags.Lookup("once") == nil {
+		return false
+	}
+	once, err := flags.GetBool("once")
+	return err == nil && once
+}
+
+// applyOnce rewrites the consolidated options so the test runs with 1 VU and 1 iteration. It must be
+// applied after the config layers are consolidated, so script, file and environment settings are
+// taken into account.
+//
+// With no scenarios the default scenario is used. With a single scenario, its exec, env, tags and
+// options are preserved while the executor is replaced by shared-iterations and all the other
+// fields are discarded. More than one scenario is an error.
+func applyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, fmt.Errorf(
+			"--once can run a single scenario only, but the script defines %d", len(opts.Scenarios))
+	}
+
+	name := lib.DefaultScenarioName
+	var base executor.BaseConfig
+	for scName, sc := range opts.Scenarios {
+		name = scName
+		base = executor.BaseConfig{
+			Exec:    null.NewString(sc.GetExec(), sc.GetExec() != ""),
+			Env:     sc.GetEnv(),
+			Tags:    sc.GetTags(),
+			Options: sc.GetScenarioOptions(),
+		}
+	}
+
+	once := executor.NewSharedIterationsConfig(name)
+	once.Exec = base.Exec
+	once.Env = base.Env
+	once.Tags = base.Tags
+	once.Options = base.Options
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{name: once}
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+
+	return opts, nil
+}
diff --git a/internal/cmd/once_test.go b/internal/cmd/once_test.go
new file mode 100644
index 0000000..21b803c
--- /dev/null
+++ b/internal/cmd/once_test.go
@@ -0,0 +1,104 @@
+package cmd
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestValidateOnceFlags(t *testing.T) {
+	t.Parallel()
+
+	tests := map[string]struct {
+		args []string
+		err  string
+	}{
+		"no once":          {args: []string{"--iterations", "5"}},
+		"once alone":       {args: []string{"--once"}},
+		"once other flags": {args: []string{"--once", "--no-setup"}},
+		"once vus":         {args: []string{"--once", "--vus", "2"}, err: "--once cannot be combined with --vus"},
+		"once iterations": {
+			args: []string{"--once", "--iterations", "10"},
+			err:  "--once cannot be combined with --iterations",
+		},
+		"once duration": {args: []string{"--once", "-d", "1s"}, err: "--once cannot be combined with --duration"},
+		"once stage":    {args: []string{"--once", "--stage", "1s:2"}, err: "--once cannot be combined with --stage"},
+	}
+	for name, tc := range tests {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			flags := optionFlagSet()
+			require.NoError(t, flags.Parse(tc.args))
+			err := validateOnceFlags(flags)
+			if tc.err == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.EqualError(t, err, tc.err)
+		})
+	}
+}
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := applyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+		})
+		require.NoError(t, err)
+		derived, err := executor.DeriveScenariosFromShortcuts(opts, nil)
+		require.NoError(t, err)
+		require.Len(t, derived.Scenarios, 1)
+		sc, ok := derived.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		orig := executor.NewConstantVUsConfig("my")
+		orig.VUs = null.IntFrom(20)
+		orig.Duration = types.NullDurationFrom(time.Minute)
+		orig.StartTime = types.NullDurationFrom(5 * time.Second)
+		orig.Exec = null.StringFrom("foo")
+		orig.Env = map[string]string{"A": "b"}
+		orig.Tags = map[string]string{"t": "v"}
+		orig.Options = &lib.ScenarioOptions{}
+
+		opts, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"my": orig}})
+		require.NoError(t, err)
+		derived, err := executor.DeriveScenariosFromShortcuts(opts, nil)
+		require.NoError(t, err)
+		require.Len(t, derived.Scenarios, 1)
+		sc, ok := derived.Scenarios["my"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.Equal(t, "foo", sc.GetExec())
+		assert.Equal(t, orig.Env, sc.Env)
+		assert.Equal(t, orig.Tags, sc.Tags)
+		assert.Equal(t, orig.Options, sc.Options)
+		assert.False(t, sc.StartTime.Valid)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": executor.NewConstantVUsConfig("a"),
+			"b": executor.NewConstantVUsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
