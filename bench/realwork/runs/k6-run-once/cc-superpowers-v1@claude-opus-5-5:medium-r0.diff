@@ -317,6 +317,61 @@ func applyDefault(conf Config) Config {
 	return conf
 }
 
+// onceConflictingFlags are the CLI flags that can't be combined with --once.
+var onceConflictingFlags = []string{"vus", "duration", "iterations", "stage"} //nolint:gochecknoglobals
+
+// getOnceFlag returns whether the --once flag was set, and an error if it was combined with
+// any of the execution shortcut flags.
+func getOnceFlag(flags *pflag.FlagSet) (bool, error) {
+	if flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceConflictingFlags {
+		if flags.Changed(name) {
+			return false, fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+	return true, nil
+}
+
+// applyOnce transforms the consolidated options, so that the test is executed with 1 VU and
+// 1 iteration. If the script has a single scenario, its exec, env, tags and options are
+// preserved, but its executor is replaced with a shared-iterations one. Every other execution
+// option (vus, iterations, duration, stages, etc.) is discarded.
+func applyOnce(opts lib.Options) (lib.Options, error) {
+	scenario := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+
+	switch len(opts.Scenarios) {
+	case 0:
+		// Nothing to preserve, run the default function.
+	case 1:
+		for _, sc := range opts.Scenarios {
+			scenario.Name = sc.GetName()
+			scenario.Exec = null.StringFrom(sc.GetExec())
+			scenario.Env = sc.GetEnv()
+			scenario.Tags = sc.GetTags()
+			scenario.Options = sc.GetScenarioOptions()
+		}
+	default:
+		return opts, fmt.Errorf("--once can run a single scenario only, but %d scenarios were configured",
+			len(opts.Scenarios))
+	}
+
+	scenario.VUs = null.IntFrom(1)
+	scenario.Iterations = null.IntFrom(1)
+
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	opts.Scenarios = lib.ScenarioConfigs{scenario.Name: scenario}
+	return opts, nil
+}
