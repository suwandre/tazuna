+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := applyOnce(lib.Options{
+			VUs:      null.IntFrom(10),
+			Duration: types.NullDurationFrom(time.Minute),
+		})
+		require.NoError(t, err)
+
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Duration.Valid)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, "default", sc.GetExec())
+	})
+
+	t.Run("stages", func(t *testing.T) {
+		t.Parallel()
+		opts, err := applyOnce(lib.Options{
+			Stages: []lib.Stage{{Duration: types.NullDurationFrom(time.Minute), Target: null.IntFrom(10)}},
+		})
+		require.NoError(t, err)
+		assert.Nil(t, opts.Stages)
+		require.Len(t, opts.Scenarios, 1)
+		assert.IsType(t, executor.SharedIterationsConfig{}, opts.Scenarios[lib.DefaultScenarioName])
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		ramping := executor.NewRampingVUsConfig("browser")
+		ramping.StartVUs = null.IntFrom(5)
+		ramping.StartTime = types.NullDurationFrom(time.Minute)
+		ramping.Stages = []executor.Stage{{Duration: types.NullDurationFrom(time.Minute), Target: null.IntFrom(10)}}
+		ramping.Exec = null.StringFrom("browserTest")
+		ramping.Env = map[string]string{"FOO": "bar"}
+		ramping.Tags = map[string]string{"tag": "value"}
+		ramping.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+
+		opts, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"browser": ramping}})
+		require.NoError(t, err)
+
+		require.Len(t, opts.Scenarios, 1)
