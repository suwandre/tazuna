+func TestGetOnceFlag(t *testing.T) {
+	t.Parallel()
+
+	testCases := []struct {
+		args    []string
+		once    bool
+		wantErr string
+	}{
+		{args: nil, once: false},
+		{args: []string{"--once"}, once: true},
+		{args: []string{"--once", "--paused"}, once: true},
+		{args: []string{"--iterations", "10"}, once: false},
+		{args: []string{"--once", "--iterations", "10"}, wantErr: "--once cannot be combined with --iterations"},
+		{args: []string{"--once", "--vus", "10"}, wantErr: "--once cannot be combined with --vus"},
+		{args: []string{"--once", "--duration", "10s"}, wantErr: "--once cannot be combined with --duration"},
+		{args: []string{"--once", "--stage", "10s:10"}, wantErr: "--once cannot be combined with --stage"},
+	}
+
+	for _, tc := range testCases {
+		t.Run(strings.Join(tc.args, " "), func(t *testing.T) {
+			t.Parallel()
+			flags := optionFlagSet()
+			require.NoError(t, flags.Parse(tc.args))
+
+			once, err := getOnceFlag(flags)
+			if tc.wantErr != "" {
+				require.ErrorContains(t, err, tc.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tc.once, once)
+		})
+	}
+
+	t.Run("undefined flag", func(t *testing.T) {
+		t.Parallel()
+		once, err := getOnceFlag(pflag.NewFlagSet("", 0))
+		require.NoError(t, err)
+		assert.False(t, once)
+	})
+}
