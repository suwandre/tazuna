+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("default function", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			import exec from 'k6/execution';
+
+			export const options = { vus: 10, duration: '1m' };
+
+			export function setup() { console.log('setup'); }
+			export default function () {
+				console.log('iteration ' + exec.scenario.name + ' ' + exec.scenario.executor);
+			}
+			export function teardown() { console.log('teardown'); }
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--quiet"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		msgs := []string{}
+		for _, l := range ts.LoggerHook.Drain() {
+			msgs = append(msgs, l.Message)
+		}
+		assert.Equal(t, []string{"setup", "iteration default shared-iterations", "teardown"}, msgs)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			import exec from 'k6/execution';
+
+			export const options = {
+				scenarios: {
+					myscenario: {
+						executor: 'constant-arrival-rate',
+						rate: 100,
+						timeUnit: '1s',
+						duration: '1m',
+						preAllocatedVUs: 50,
+						startTime: '10s',
+						exec: 'myExec',
+						env: { MY_VAR: 'myvalue' },
+						tags: { mytag: 'mytagvalue' },
+					},
+				},
+			};
+
+			export default function () { console.log('wrong function'); }
+			export function myExec() {
+				console.log([exec.scenario.name, exec.scenario.executor, __ENV.MY_VAR, exec.vu.tags.mytag].join(' '));
+			}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--quiet"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		msgs := []string{}
+		for _, l := range ts.LoggerHook.Drain() {
+			msgs = append(msgs, l.Message)
+		}
+		assert.Equal(t, []string{"myscenario shared-iterations myvalue mytagvalue"}, msgs)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			export const options = {
+				scenarios: {
+					one: { executor: 'shared-iterations' },
+					two: { executor: 'shared-iterations' },
+				},
+			};
+			export default function () {}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+	})
+
+	t.Run("combined with shortcut flag", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `export default function () {}`,
+			[]string{"--once", "--iterations", "10"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with --iterations")
+	})
+}
