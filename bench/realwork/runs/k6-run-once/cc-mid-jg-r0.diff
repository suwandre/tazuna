+func TestOnceFlag(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		ts.CmdArgs = []string{"k6", "run", "--once", "-"}
+		ts.Stdin = bytes.NewBufferString(`export const options = {iterations: 5, vus: 3};
+export default function() {};`)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "default: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	})
+
+	t.Run("single scenario keeps exec", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		ts.CmdArgs = []string{"k6", "run", "--once", "-"}
+		ts.Stdin = bytes.NewBufferString(`export const options = {scenarios: {foo: {
+  executor: 'constant-vus', vus: 5, duration: '1h', exec: 'bar', tags: {a: 'b'}, env: {X: 'y'}}}};
+export function bar() { if (__ENV.X !== 'y') { throw new Error('missing env'); } }`)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "foo: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		ts.CmdArgs = []string{"k6", "run", "--once", "-"}
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+		ts.Stdin = bytes.NewBufferString(`export const options = {scenarios: {
+  a: {executor: 'constant-vus', vus: 1, duration: '1s'},
+  b: {executor: 'constant-vus', vus: 1, duration: '1s'}}};
+export default function() {};`)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+	})
+
+	t.Run("combined with shortcut", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		ts.CmdArgs = []string{"k6", "run", "--once", "--iterations", "10", "-"}
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+		ts.Stdin = bytes.NewBufferString(`export default function() {};`)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with --iterations")
+	})
+}
