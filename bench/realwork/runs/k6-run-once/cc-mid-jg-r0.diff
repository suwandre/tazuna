+++ b/lib/executor/execution_config_shortcuts_test.go
@@ -0,0 +1,70 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestDeriveOnceScenario(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := DeriveOnceScenario(lib.Options{
+			VUs:        null.IntFrom(5),
+			Iterations: null.IntFrom(10),
+			Duration:   types.NullDurationFrom(time.Minute),
+		})
+		require.NoError(t, err)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		assert.Nil(t, opts.Stages)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		orig := NewConstantVUsConfig("foo")
+		orig.VUs = null.IntFrom(10)
+		orig.Duration = types.NullDurationFrom(time.Hour)
+		orig.Exec = null.StringFrom("bar")
+		orig.Env = map[string]string{"A": "b"}
+		orig.Tags = map[string]string{"c": "d"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+
+		opts, err := DeriveOnceScenario(lib.Options{Scenarios: lib.ScenarioConfigs{"foo": orig}})
+		require.NoError(t, err)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios["foo"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "foo", sc.GetName())
+		assert.Equal(t, sharedIterationsType, sc.GetType())
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.Equal(t, "bar", sc.GetExec())
+		assert.Equal(t, orig.Env, sc.GetEnv())
+		assert.Equal(t, orig.Tags, sc.GetTags())
+		assert.Equal(t, orig.Options, sc.GetScenarioOptions())
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := DeriveOnceScenario(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": NewConstantVUsConfig("a"),
+			"b": NewConstantVUsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
