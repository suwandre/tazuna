+
+// DeriveOnceScenario implements the --once mode: it turns the configured
+// execution (if any) into a single shared-iterations scenario with 1 VU and
+// 1 iteration. The scenario's name, exec, env, tags, and options are preserved;
+// all the other executor fields, and the VUs, iterations, duration and stages
+// shortcut options, are discarded.
+//
+// It should be called on the consolidated options, before the shortcuts
+// derivation. Scripts with more than one scenario are not supported.
+func DeriveOnceScenario(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ExecutionConflictError("--once can run a single scenario only")
+	}
+
+	name := lib.DefaultScenarioName
+	once := NewSharedIterationsConfig(name)
+	for scName, sc := range opts.Scenarios { // at most one
+		name = scName
+		once = NewSharedIterationsConfig(name)
+		once.Env = sc.GetEnv()
+		once.Tags = sc.GetTags()
+		once.Options = sc.GetScenarioOptions()
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			once.Exec = null.StringFrom(exec)
+		}
+	}
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{name: once}
+	opts.VUs = null.NewInt(0, false)
+	opts.Iterations = null.NewInt(0, false)
+	opts.Duration = types.NewNullDuration(0, false)
+	opts.Stages = nil
+	return opts, nil
+}
diff --git a/lib/executor/execution_config_shortcuts_test.go b/lib/executor/execution_config_shortcuts_test.go
