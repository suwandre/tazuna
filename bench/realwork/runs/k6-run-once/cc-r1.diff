+package cmd
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+
+	"github.com/spf13/pflag"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/errext"
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+)
+
+const onceFlagName = "once"
+
+// onceFlagSet returns a FlagSet with the --once flag, for the commands that
+// can run (or package) a test with a single VU and a single iteration.
+func onceFlagSet() *pflag.FlagSet {
+	flags := pflag.NewFlagSet("", pflag.ContinueOnError)
+	flags.SortFlags = false
+	flags.Bool(onceFlagName, false, "run the script once, with 1 VU and 1 iteration, "+
+		"keeping the configuration of the scenario, if there is one")
+	return flags
+}
+
+// isOnceRequested reports whether the --once flag was set. It's safe to call for
+// flag sets that don't define the flag.
+func isOnceRequested(flags *pflag.FlagSet) (bool, error) {
+	if flags == nil || flags.Lookup(onceFlagName) == nil {
+		return false, nil
+	}
+	return flags.GetBool(onceFlagName)
+}
+
+// applyOnce transforms the consolidated config so the test runs with 1 VU and 1 iteration. It's
+// meant to be applied after the config consolidation, so the scenarios coming from any of the
+// sources (script, file, env) are taken into account.
+//
+//   - Without scenarios, the default scenario is replaced by a 1 VU, 1 iteration one.
+//   - With a single scenario, its executor is replaced by a shared-iterations one with 1 VU and 1
+//     iteration, and its name, exec, env, tags and options are preserved.
+//   - With multiple scenarios, it's an error.
+//
+// The vus, iterations, duration and stages options are discarded. It's an error to set any of them
+// with a CLI flag together with --once, as the intent would be ambiguous.
+func applyOnce(conf Config, cliOpts lib.Options) (Config, error) {
+	if err := checkOnceConflicts(cliOpts); err != nil {
+		return conf, err
+	}
+
+	opts := conf.Options
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration.Valid = false
+	opts.Stages = nil
+
+	switch len(opts.Scenarios) {
+	case 0:
+		opts.Scenarios = lib.ScenarioConfigs{
+			lib.DefaultScenarioName: newOnceScenario(executor.NewBaseConfig(
+				lib.DefaultScenarioName, "shared-iterations",
+			)),
+		}
+	case 1:
+		for name, sc := range opts.Scenarios {
+			base := executor.NewBaseConfig(name, "shared-iterations")
+			if exec := sc.GetExec(); exec != consts.DefaultFn { // GetExec() falls back to the default fn
+				base.Exec = null.StringFrom(exec)
+			}
+			base.Env = sc.GetEnv()
+			base.Tags = sc.GetTags()
+			base.Options = sc.GetScenarioOptions()
+			opts.Scenarios = lib.ScenarioConfigs{name: newOnceScenario(base)}
+		}
+	default:
+		names := make([]string, 0, len(opts.Scenarios))
+		for name := range opts.Scenarios {
+			names = append(names, name)
+		}
+		slices.Sort(names)
+		return conf, errext.WithExitCodeIfNone(
+			fmt.Errorf("--%s can run a single scenario only, but the script defines %d: %s",
+				onceFlagName, len(names), strings.Join(names, ", ")),
+			exitcodes.InvalidConfig,
+		)
+	}
+
+	conf.Options = opts
+	return conf, nil
+}
+
+func newOnceScenario(base executor.BaseConfig) executor.SharedIterationsConfig {
+	sc := executor.NewSharedIterationsConfig(base.Name)
+	sc.BaseConfig = base
+	sc.VUs = null.IntFrom(1)
+	sc.Iterations = null.IntFrom(1)
+	return sc
+}
+
+func checkOnceConflicts(cliOpts lib.Options) error {
+	var conflict string
+	switch {
+	case cliOpts.VUs.Valid:
+		conflict = "vus"
+	case cliOpts.Iterations.Valid:
+		conflict = "iterations"
+	case cliOpts.Duration.Valid:
+		conflict = "duration"
+	case cliOpts.Stages != nil:
+		conflict = "stage"
+	default:
+		return nil
+	}
+	return errext.WithExitCodeIfNone(
+		fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, conflict),
+		exitcodes.InvalidConfig,
+	)
+}
