diff --git a/internal/cmd/tests/cmd_run_once_test.go b/internal/cmd/tests/cmd_run_once_test.go
new file mode 100644
index 0000000..9996a74
--- /dev/null
+++ b/internal/cmd/tests/cmd_run_once_test.go
@@ -0,0 +1,126 @@
+package tests
+
+import (
+	"bytes"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		ts.CmdArgs = []string{"k6", "run", "--once", "-"}
+		ts.Stdin = bytes.NewBufferString(`
+			export const options = { vus: 5, iterations: 50 };
+			export default function() { console.log("default-ran"); }
+			export function setup() { console.log("setup-ran"); }
+			export function teardown() { console.log("teardown-ran"); }
+		`)
+
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Equal(t, 1, bytes.Count(ts.Stderr.Bytes(), []byte("default-ran")))
+		assert.Contains(t, ts.Stderr.String(), "setup-ran")
+		assert.Contains(t, ts.Stderr.String(), "teardown-ran")
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		ts.CmdArgs = []string{"k6", "run", "--once", "-"}
+		ts.Stdin = bytes.NewBufferString(`
+			export const options = {
+				scenarios: {
+					load: {
+						executor: 'constant-vus', vus: 10, duration: '1m',
+						exec: 'other', env: { WHO: 'scenario' }, tags: { mytag: 'myvalue' },
+					},
+				},
+			};
+			export default function() { console.log("default-ran"); }
+			export function other() { console.log("other-ran-" + __ENV.WHO); }
+		`)
+
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "load")
+		assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Equal(t, 1, bytes.Count(ts.Stderr.Bytes(), []byte("other-ran-scenario")))
+		assert.NotContains(t, ts.Stderr.String(), "default-ran")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := NewGlobalTestState(t)
+		ts.CmdArgs = []string{"k6", "run", "--once", "-"}
+		ts.Stdin = bytes.NewBufferString(`
+			export const options = { scenarios: {
+				a: { executor: 'constant-vus', vus: 1, duration: '1s' },
+				b: { executor: 'constant-vus', vus: 1, duration: '1s' },
+			} };
+			export default function() {}
+		`)
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+	})
+
+	for _, flag := range [][]string{
+		{"--iterations", "10"}, {"--vus", "2"}, {"--duration", "10s"}, {"--stage", "1s:2"},
+	} {
+		t.Run("conflicts with "+flag[0], func(t *testing.T) {
+			t.Parallel()
+			ts := NewGlobalTestState(t)
+			ts.CmdArgs = append([]string{"k6", "run", "--once"}, append(flag, "-")...)
+			ts.Stdin = bytes.NewBufferString(`export default function() {}`)
+			ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with "+flag[0])
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "script.js"), []byte(`
+		export const options = {
+			scenarios: { only: { executor: 'ramping-vus', stages: [{ duration: '1m', target: 10 }], exec: 'fn' } },
+		};
+		export function fn() {}
+	`), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", "-", "script.js"}
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	arc, err := lib.ReadArchive(ts.Stdout)
+	require.NoError(t, err)
+	require.Len(t, arc.Options.Scenarios, 1)
+	sc, ok := arc.Options.Scenarios["only"].(executor.SharedIterationsConfig)
+	require.True(t, ok, "unexpected scenario %#v", arc.Options.Scenarios["only"])
+	assert.Equal(t, "fn", sc.GetExec())
+	assert.Equal(t, int64(1), sc.VUs.Int64)
+	assert.Equal(t, int64(1), sc.Iterations.Int64)
+}
