new file mode 100644
index 0000000..5e8dd29
--- /dev/null
+++ b/internal/cmd/once_test.go
@@ -0,0 +1,122 @@
+package cmd
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/errext"
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		conf := Config{Options: lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages:     []lib.Stage{{Target: null.IntFrom(5)}},
+		}}
+		res, err := applyOnce(conf, lib.Options{})
+		require.NoError(t, err)
+
+		assert.False(t, res.VUs.Valid)
+		assert.False(t, res.Iterations.Valid)
+		assert.False(t, res.Duration.Valid)
+		assert.Nil(t, res.Stages)
+		require.Len(t, res.Scenarios, 1)
+		sc, ok := res.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "shared-iterations", sc.GetType())
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.Exec.Valid)
+
+		// the result must not conflict with the later derivation
+		derived, err := executor.DeriveScenariosFromShortcuts(res.Options, nil)
+		require.NoError(t, err)
+		assert.Equal(t, res.Scenarios, derived.Scenarios)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		ramping := executor.NewRampingVUsConfig("only")
+		ramping.Exec = null.StringFrom("other")
+		ramping.Env = map[string]string{"FOO": "bar"}
+		ramping.Tags = map[string]string{"tag": "value"}
+		ramping.StartTime = types.NewNullDuration(5*time.Second, true)
+		ramping.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		ramping.StartVUs = null.IntFrom(20)
+		ramping.Stages = []executor.Stage{{Duration: types.NullDurationFrom(time.Minute), Target: null.IntFrom(50)}}
+
+		conf := Config{Options: lib.Options{
+			VUs:       null.IntFrom(3),
+			Scenarios: lib.ScenarioConfigs{"only": ramping},
+		}}
+		res, err := applyOnce(conf, lib.Options{})
+		require.NoError(t, err)
+
+		assert.False(t, res.VUs.Valid)
+		require.Len(t, res.Scenarios, 1)
+		sc, ok := res.Scenarios["only"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "only", sc.GetName())
+		assert.Equal(t, "shared-iterations", sc.GetType())
+		assert.Equal(t, "other", sc.GetExec())
+		assert.Equal(t, map[string]string{"FOO": "bar"}, sc.GetEnv())
+		assert.Equal(t, map[string]string{"tag": "value"}, sc.GetTags())
+		assert.Equal(t, ramping.Options, sc.GetScenarioOptions())
+		assert.Zero(t, sc.GetStartTime())
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.Empty(t, sc.Validate())
+
+		_, err = executor.DeriveScenariosFromShortcuts(res.Options, nil)
+		require.NoError(t, err)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		conf := Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{
+			"b": executor.NewPerVUIterationsConfig("b"),
+			"a": executor.NewPerVUIterationsConfig("a"),
+		}}}
+		_, err := applyOnce(conf, lib.Options{})
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "--once can run a single scenario only")
+		assert.Contains(t, err.Error(), "a, b")
+		var ec errext.HasExitCode
+		require.ErrorAs(t, err, &ec)
+		assert.Equal(t, exitcodes.InvalidConfig, ec.ExitCode())
+	})
+
+	t.Run("conflicting CLI flags", func(t *testing.T) {
+		t.Parallel()
+		tests := map[string]lib.Options{
+			"vus":        {VUs: null.IntFrom(2)},
+			"iterations": {Iterations: null.IntFrom(10)},
+			"duration":   {Duration: types.NullDurationFrom(time.Second)},
+			"stage":      {Stages: []lib.Stage{{Target: null.IntFrom(1)}}},
+		}
+		for flag, cliOpts := range tests {
+			t.Run(flag, func(t *testing.T) {
+				t.Parallel()
+				_, err := applyOnce(Config{}, cliOpts)
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), "--once cannot be combined with --"+flag)
+				var ec errext.HasExitCode
+				require.ErrorAs(t, err, &ec)
+				assert.Equal(t, exitcodes.InvalidConfig, ec.ExitCode())
+			})
+		}
+	})
+}
