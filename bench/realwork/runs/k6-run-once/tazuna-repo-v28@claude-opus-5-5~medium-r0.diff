+// onceConflictingFlags are the execution shortcut flags that can't be combined with --once.
+var onceConflictingFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// applyOnceFlag transforms the consolidated config so that the test runs with 1 VU and 1
+// iteration, if the --once flag was set. It's applied after the config consolidation, so the
+// scenario configuration (exec, options, env, tags) from all config layers is preserved.
+func applyOnceFlag(flags *pflag.FlagSet, conf Config) (Config, error) {
+	if flags.Lookup("once") == nil {
+		return conf, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return conf, err
+	}
+	for _, name := range onceConflictingFlags {
+		if flags.Changed(name) {
+			err = fmt.Errorf("--once cannot be combined with --%s", name)
+			return conf, errext.WithExitCodeIfNone(err, exitcodes.InvalidConfig)
+		}
+	}
+
+	conf.Options, err = deriveOnceScenario(conf.Options)
+	if err != nil {
+		return conf, errext.WithExitCodeIfNone(err, exitcodes.InvalidConfig)
+	}
+	return conf, nil
+}
+
+// deriveOnceScenario replaces the execution configuration with a single shared-iterations
+// scenario with 1 VU and 1 iteration. The exec, options, env and tags of an explicitly
+// configured scenario are preserved, everything else is discarded.
+func deriveOnceScenario(opts lib.Options) (lib.Options, error) {
+	sc := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	switch len(opts.Scenarios) {
+	case 0:
+	case 1:
+		for name, orig := range opts.Scenarios {
+			sc = executor.NewSharedIterationsConfig(name)
+			sc.Env = orig.GetEnv()
+			sc.Tags = orig.GetTags()
+			sc.Options = orig.GetScenarioOptions()
+			if exec := orig.GetExec(); exec != consts.DefaultFn {
+				sc.Exec = null.StringFrom(exec)
+			}
+		}
+	default:
+		return opts, errors.New("--once can run a single scenario only")
+	}
+	sc.VUs = null.IntFrom(1)
+	sc.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{sc.Name: sc}
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	return opts, nil
+}
