@@ -0,0 +1,94 @@
+package tests
+
+import (
+	"testing"
+
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+)
+
+func TestRunOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = { vus: 10, duration: '30s' };
+		export function setup() { console.log('setup ran'); }
+		export default function() { console.log('default ran'); }
+		export function teardown() { console.log('teardown ran'); }
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	t.Log(stdout)
+	assert.Contains(t, stdout, "default: 1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Contains(t, stdout, "setup ran")
+	assert.Contains(t, stdout, "default ran")
+	assert.Contains(t, stdout, "teardown ran")
+}
+
+func TestRunOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		import exec from 'k6/execution';
+		export const options = {
+			scenarios: {
+				foo: {
+					executor: 'ramping-vus',
+					exec: 'bar',
+					env: { MY_VAR: 'my-value' },
+					tags: { my_tag: 'tag-value' },
+					stages: [{ duration: '1m', target: 10 }],
+				},
+			},
+		};
+		export function bar() {
+			console.log('bar ran ' + __ENV.MY_VAR + ' ' + exec.vu.metrics.tags['my_tag']);
+		}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	t.Log(stdout)
+	assert.Contains(t, stdout, "foo: 1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "exec: bar")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Contains(t, stdout, "bar ran my-value tag-value")
+}
+
+func TestRunOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				a: { executor: 'shared-iterations' },
+				b: { executor: 'shared-iterations' },
+			},
+		};
+		export default function() {}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.True(t, testutils.LogContains(
+		ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once can run a single scenario only"))
+}
+
+func TestRunOnceWithShortcutFlag(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `export default function() {}`,
+		[]string{"--once", "--iterations", "10"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.True(t, testutils.LogContains(
+		ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once cannot be combined with --iterations"))
+}
