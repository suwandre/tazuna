+func TestDeriveOnceScenario(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts := lib.Options{
+			VUs:      null.IntFrom(10),
+			Duration: types.NullDurationFrom(30 * time.Second),
+		}
+		result, err := deriveOnceScenario(opts)
+		require.NoError(t, err)
+		assert.False(t, result.VUs.Valid)
+		assert.False(t, result.Duration.Valid)
+		assert.False(t, result.Iterations.Valid)
+		assert.Nil(t, result.Stages)
+		require.Len(t, result.Scenarios, 1)
+		sc, ok := result.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		orig := executor.NewRampingVUsConfig("foo")
+		orig.Exec = null.StringFrom("bar")
+		orig.Env = map[string]string{"A": "1"}
+		orig.Tags = map[string]string{"t": "v"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		orig.StartTime = types.NullDurationFrom(time.Minute)
+		orig.Stages = []executor.Stage{{Duration: types.NullDurationFrom(time.Minute), Target: null.IntFrom(10)}}
+
+		result, err := deriveOnceScenario(lib.Options{
+			Scenarios: lib.ScenarioConfigs{"foo": orig},
+			Stages:    []lib.Stage{{Duration: types.NullDurationFrom(time.Second)}},
+		})
+		require.NoError(t, err)
+		assert.Nil(t, result.Stages)
+		require.Len(t, result.Scenarios, 1)
+		sc, ok := result.Scenarios["foo"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "foo", sc.Name)
+		assert.Equal(t, "shared-iterations", sc.Type)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, null.StringFrom("bar"), sc.Exec)
+		assert.Equal(t, orig.Env, sc.Env)
+		assert.Equal(t, orig.Tags, sc.Tags)
+		assert.Equal(t, orig.Options, sc.Options)
+		assert.False(t, sc.StartTime.Valid)
+		assert.Empty(t, sc.Validate())
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := deriveOnceScenario(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": executor.NewSharedIterationsConfig("a"),
+			"b": executor.NewSharedIterationsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
+
+func TestApplyOnceFlag(t *testing.T) {
+	t.Parallel()
+
+	conf := Config{Options: lib.Options{Iterations: null.IntFrom(5)}}
+
+	testCases := []struct {
+		args []string
+		err  string
+		once bool
+	}{
+		{args: nil},
+		{args: []string{"--once"}, once: true},
+		{args: []string{"--once", "--iterations", "10"}, err: "--once cannot be combined with --iterations"},
+		{args: []string{"--once", "--vus", "2"}, err: "--once cannot be combined with --vus"},
+		{args: []string{"--once", "-d", "1s"}, err: "--once cannot be combined with --duration"},
+		{args: []string{"--once", "-s", "1s:1"}, err: "--once cannot be combined with --stage"},
+	}
+	for _, tc := range testCases {
+		t.Run(strings.Join(tc.args, " "), func(t *testing.T) {
+			t.Parallel()
+			flags := optionFlagSet()
+			require.NoError(t, flags.Parse(tc.args))
+
+			result, err := applyOnceFlag(flags, conf)
+			if tc.err != "" {
+				require.ErrorContains(t, err, tc.err)
+				var ecerr errext.HasExitCode
+				require.ErrorAs(t, err, &ecerr)
+				assert.Equal(t, exitcodes.InvalidConfig, ecerr.ExitCode())
+				return
+			}
+			require.NoError(t, err)
+			if !tc.once {
+				assert.Equal(t, conf, result)
+				return
+			}
+			assert.False(t, result.Iterations.Valid)
+			require.Len(t, result.Scenarios, 1)
+		})
+	}
+}
