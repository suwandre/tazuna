+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	fileName := "script.js"
+	testScript := []byte(`
+		export const options = {
+			scenarios: {
+				foo: { executor: 'constant-vus', vus: 5, duration: '1m', exec: 'bar', tags: { a: 'b' } },
+			},
+		};
+		export function bar() {}
+	`)
+	ts := tests.NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, fileName), testScript, 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", fileName}
+
+	newRootCommand(ts.GlobalState).execute()
+	require.NoError(t, testutils.Untar(t, ts.FS, "archive.tar", "tmp/"))
+
+	data, err := fsext.ReadFile(ts.FS, "tmp/metadata.json")
+	require.NoError(t, err)
+
+	var metadata struct {
+		Options struct {
+			Scenarios map[string]map[string]any `json:"scenarios"`
+		} `json:"options"`
+	}
+	require.NoError(t, json.Unmarshal(data, &metadata))
+	require.Len(t, metadata.Options.Scenarios, 1)
+	foo := metadata.Options.Scenarios["foo"]
+	assert.Equal(t, "shared-iterations", foo["executor"])
+	assert.InDelta(t, 1, foo["vus"], 0)
+	assert.InDelta(t, 1, foo["iterations"], 0)
+	assert.Equal(t, "bar", foo["exec"])
+	assert.Equal(t, map[string]any{"a": "b"}, foo["tags"])
+	assert.NotContains(t, foo, "duration")
+}
