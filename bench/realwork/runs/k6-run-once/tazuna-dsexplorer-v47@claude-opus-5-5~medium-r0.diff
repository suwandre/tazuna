diff --git a/internal/cmd/tests/cmd_run_once_test.go b/internal/cmd/tests/cmd_run_once_test.go
new file mode 100644
index 0000000..187668d
--- /dev/null
+++ b/internal/cmd/tests/cmd_run_once_test.go
@@ -0,0 +1,109 @@
+package tests
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	logMessages := func(ts *GlobalTestState) []string {
+		var msgs []string
+		for _, e := range ts.LoggerHook.Drain() {
+			msgs = append(msgs, e.Message)
+		}
+		return msgs
+	}
+
+	t.Run("NoScenarios", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			export const options = { vus: 10, duration: '1h' };
+			export function setup() { console.log('setup'); }
+			export default function () { console.log('default'); }
+			export function teardown() { console.log('teardown'); }
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Equal(t, []string{"setup", "default", "teardown"}, logMessages(ts))
+	})
+
+	t.Run("SingleScenario", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			import exec from 'k6/execution';
+			export const options = {
+				scenarios: {
+					sc1: {
+						executor: 'constant-vus',
+						vus: 5,
+						duration: '1h',
+						exec: 'foo',
+						env: { MYVAR: 'myval' },
+						tags: { mytag: 'mytagval' },
+					},
+				},
+			};
+			export default function () { console.log('default'); }
+			export function foo() {
+				console.log(exec.scenario.name + ' ' + __ENV.MYVAR + ' ' + exec.vu.metrics.tags.mytag);
+			}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "sc1: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "exec: foo")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Equal(t, []string{"sc1 myval mytagval"}, logMessages(ts))
+	})
+
+	t.Run("MultipleScenarios", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			export const options = {
+				scenarios: {
+					sc1: { executor: 'per-vu-iterations' },
+					sc2: { executor: 'per-vu-iterations' },
+				},
+			};
+			export default function () {}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.True(t, outputContains(ts, "--once can run a single scenario only"))
+	})
+
+	t.Run("ShortcutFlag", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `export default function () {}`,
+			[]string{"--once", "--iterations", "10"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.True(t, outputContains(ts, "--once cannot be combined with --iterations"))
+	})
+}
+
+func outputContains(ts *GlobalTestState, msg string) bool {
+	if strings.Contains(ts.Stderr.String(), msg) {
+		return true
+	}
+	for _, e := range ts.LoggerHook.Drain() {
+		if strings.Contains(e.Message, msg) {
+			return true
+		}
+	}
+	return false
+}
