@@ -0,0 +1,132 @@
+package cmd
+
+import (
+	"testing"
+	"time"
+
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/errext"
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnceFlag(t *testing.T) {
+	t.Parallel()
+
+	t.Run("NotSet", func(t *testing.T) {
+		t.Parallel()
+		flags := optionFlagSet()
+		require.NoError(t, flags.Parse(nil))
+		conf := Config{Options: lib.Options{VUs: null.IntFrom(10)}}
+		result, err := applyOnceFlag(flags, conf)
+		require.NoError(t, err)
+		assert.Equal(t, conf, result)
+	})
+
+	t.Run("NilFlags", func(t *testing.T) {
+		t.Parallel()
+		conf := Config{Options: lib.Options{VUs: null.IntFrom(10)}}
+		result, err := applyOnceFlag(nil, conf)
+		require.NoError(t, err)
+		assert.Equal(t, conf, result)
+	})
+
+	t.Run("NoScenarios", func(t *testing.T) {
+		t.Parallel()
+		flags := optionFlagSet()
+		require.NoError(t, flags.Parse([]string{"--once"}))
+		conf := Config{Options: lib.Options{
+			VUs:      null.IntFrom(10),
+			Duration: types.NullDurationFrom(time.Minute),
+			Stages:   []lib.Stage{{Duration: types.NullDurationFrom(time.Second), Target: null.IntFrom(5)}},
+		}}
+		result, err := applyOnceFlag(flags, conf)
+		require.NoError(t, err)
+
+		assert.False(t, result.VUs.Valid)
+		assert.False(t, result.Iterations.Valid)
+		assert.False(t, result.Duration.Valid)
+		assert.Nil(t, result.Stages)
+		require.Len(t, result.Scenarios, 1)
+		sc, ok := result.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, "default", sc.GetExec())
+
+		derived, err := deriveAndValidateConfig(result, func(string) bool { return true }, logrus.New())
+		require.NoError(t, err)
+		assert.Equal(t, result.Scenarios, derived.Scenarios)
+	})
+
+	t.Run("SingleScenario", func(t *testing.T) {
+		t.Parallel()
+		flags := optionFlagSet()
+		require.NoError(t, flags.Parse([]string{"--once"}))
+
+		orig := executor.NewConstantVUsConfig("sc1")
+		orig.VUs = null.IntFrom(5)
+		orig.Duration = types.NullDurationFrom(time.Hour)
+		orig.StartTime = types.NullDurationFrom(time.Minute)
+		orig.Exec = null.StringFrom("foo")
+		orig.Env = map[string]string{"A": "B"}
+		orig.Tags = map[string]string{"C": "D"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+
+		conf := Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{"sc1": orig}}}
+		result, err := applyOnceFlag(flags, conf)
+		require.NoError(t, err)
+
+		require.Len(t, result.Scenarios, 1)
+		sc, ok := result.Scenarios["sc1"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "sc1", sc.Name)
+		assert.Equal(t, "shared-iterations", sc.Type)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, null.StringFrom("foo"), sc.Exec)
+		assert.Equal(t, orig.Env, sc.Env)
+		assert.Equal(t, orig.Tags, sc.Tags)
+		assert.Equal(t, orig.Options, sc.Options)
+		assert.False(t, sc.StartTime.Valid)
+
+		// the original config must not be modified
+		assert.IsType(t, executor.ConstantVUsConfig{}, conf.Scenarios["sc1"])
+	})
+
+	t.Run("MultipleScenarios", func(t *testing.T) {
+		t.Parallel()
+		flags := optionFlagSet()
+		require.NoError(t, flags.Parse([]string{"--once"}))
+		conf := Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{
+			"sc1": executor.NewPerVUIterationsConfig("sc1"),
+			"sc2": executor.NewPerVUIterationsConfig("sc2"),
+		}}}
+		_, err := applyOnceFlag(flags, conf)
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+		var ecerr errext.HasExitCode
+		require.ErrorAs(t, err, &ecerr)
+		assert.Equal(t, exitcodes.InvalidConfig, ecerr.ExitCode())
+	})
+
+	for _, args := range [][]string{
+		{"--vus", "1"}, {"-u", "2"}, {"--iterations", "10"}, {"-d", "10s"}, {"--stage", "1s:1"},
+	} {
+		t.Run("Conflict"+args[0], func(t *testing.T) {
+			t.Parallel()
+			flags := optionFlagSet()
+			require.NoError(t, flags.Parse(append([]string{"--once"}, args...)))
+			_, err := applyOnceFlag(flags, Config{})
+			require.ErrorContains(t, err, "--once cannot be combined with --")
+			var ecerr errext.HasExitCode
+			require.ErrorAs(t, err, &ecerr)
+			assert.Equal(t, exitcodes.InvalidConfig, ecerr.ExitCode())
+		})
+	}
+}
