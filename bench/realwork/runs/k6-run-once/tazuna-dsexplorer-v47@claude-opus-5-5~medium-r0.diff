@@ -317,6 +317,53 @@ func applyDefault(conf Config) Config {
 	return conf
 }
 
+// applyOnceFlag transforms the consolidated config when the --once flag is set, so that the
+// script runs with 1 VU and 1 iteration. The exec, env, tags and options of a single configured
+// scenario are preserved, while its executor is replaced with shared-iterations. All the other
+// scenario fields and the execution shortcut options are discarded.
+func applyOnceFlag(flags *pflag.FlagSet, conf Config) (Config, error) {
+	if flags == nil || flags.Lookup("once") == nil {
+		return conf, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return conf, err
+	}
+
+	// execution shortcut flags would override the scenarios, which defeats the purpose of --once
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			return conf, errext.WithExitCodeIfNone(
+				fmt.Errorf("--once cannot be combined with --%s", name), exitcodes.InvalidConfig)
+		}
+	}
+
+	if len(conf.Scenarios) > 1 {
+		return conf, errext.WithExitCodeIfNone(fmt.Errorf(
+			"--once can run a single scenario only, but the script has %d scenarios",
+			len(conf.Scenarios)), exitcodes.InvalidConfig)
+	}
+
+	sc := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	sc.VUs = null.IntFrom(1)
+	sc.Iterations = null.IntFrom(1)
+	for name, ec := range conf.Scenarios {
+		sc.Name = name
+		sc.Exec = null.StringFrom(ec.GetExec())
+		sc.Env = ec.GetEnv()
+		sc.Tags = ec.GetTags()
+		sc.Options = ec.GetScenarioOptions()
+	}
+
+	result := conf
+	result.Scenarios = lib.ScenarioConfigs{sc.Name: sc}
+	result.VUs = null.Int{}
+	result.Iterations = null.Int{}
+	result.Duration = types.NullDuration{}
+	result.Stages = nil
+	return result, nil
+}
