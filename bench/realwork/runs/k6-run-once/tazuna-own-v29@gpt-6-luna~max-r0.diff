@@ -0,0 +1,66 @@
+package cmd
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/spf13/pflag"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+	"gopkg.in/guregu/null.v3"
+)
+
+// applyOnce transforms consolidated options into a single-iteration scenario.
+func applyOnce(test *loadedTest, config *Config, flags *pflag.FlagSet) error {
+	if !flags.Changed("once") {
+		return nil
+	}
+	for _, shortcut := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(shortcut) {
+			return fmt.Errorf("--once cannot be combined with --%s", shortcut)
+		}
+	}
+	options := &config.Options
+	if options.VUs.Valid || options.Iterations.Valid || options.Duration.Valid || len(options.Stages) > 0 {
+		return fmt.Errorf("--once cannot be combined with execution shortcut options")
+	}
+	if len(options.Scenarios) > 1 {
+		return fmt.Errorf("--once can run a single scenario only")
+	}
+	if len(options.Scenarios) == 0 {
+		if !test.initRunner.IsExecutable("default") {
+			return fmt.Errorf("--once requires a default function or a single scenario")
+		}
+		scenario := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+		options.Scenarios = lib.ScenarioConfigs{lib.DefaultScenarioName: scenario}
+	} else {
+		for name, existing := range options.Scenarios {
+			base := executor.NewSharedIterationsConfig(name)
+			switch scenario := existing.(type) {
+			case executor.SharedIterationsConfig:
+				base.BaseConfig = scenario.BaseConfig
+			case executor.PerVUIterationsConfig:
+				base.BaseConfig = scenario.BaseConfig
+			case executor.ConstantVUsConfig:
+				base.BaseConfig = scenario.BaseConfig
+			case executor.RampingVUsConfig:
+				base.BaseConfig = scenario.BaseConfig
+			case *executor.ConstantArrivalRateConfig:
+				base.BaseConfig = scenario.BaseConfig
+			case *executor.RampingArrivalRateConfig:
+				base.BaseConfig = scenario.BaseConfig
+			}
+			base.VUs = null.IntFrom(1)
+			base.Iterations = null.IntFrom(1)
+			base.MaxDuration = types.NewNullDuration(10*time.Minute, false)
+			options.Scenarios[name] = base
+		}
+	}
+	options.VUs = null.Int{}
+	options.Iterations = null.Int{}
+	options.Duration = types.NullDuration{}
+	options.Stages = nil
+	return nil
+}
