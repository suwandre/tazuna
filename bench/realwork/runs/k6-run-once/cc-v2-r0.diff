+	"go.k6.io/k6/v2/internal/lib/testutils"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	const noScenarios = `
+		export const options = { vus: 5, duration: '1h' };
+		export default function () { console.log('default called'); }
+		export function setup() { console.log('setup called'); }
+		export function teardown() { console.log('teardown called'); }`
+
+	const singleScenario = `
+		import exec from 'k6/execution';
+		export const options = {
+			scenarios: {
+				only: {
+					executor: 'constant-vus', vus: 10, duration: '1h',
+					exec: 'custom', env: { FOO: 'bar' }, tags: { mytag: 'myvalue' },
+				},
+			},
+		};
+		export function custom() {
+			console.log('custom called ' + __ENV.FOO + ' ' + exec.scenario.name);
+		}
+		export default function () { console.log('default called'); }`
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, noScenarios, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "default: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Contains(t, stdout, "setup called")
+		assert.Contains(t, stdout, "default called")
+		assert.Contains(t, stdout, "teardown called")
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, singleScenario, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "only: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Contains(t, stdout, "custom called bar only")
+		assert.NotContains(t, stdout, "default called")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			export const options = { scenarios: {
+				a: { executor: 'per-vu-iterations' }, b: { executor: 'per-vu-iterations' },
+			} };
+			export default function () {}`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"},
+			exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.Contains(t, ts.Stdout.String(), "--once can run a single scenario only")
+	})
+
+	for _, flag := range [][]string{
+		{"--iterations", "10"}, {"--vus", "2"}, {"--duration", "10s"}, {"--stage", "10s:5"},
+	} {
+		t.Run("conflicts with "+flag[0], func(t *testing.T) {
+			t.Parallel()
+			ts := getSingleFileTestState(t, noScenarios,
+				append([]string{"--once", "--log-output=stdout"}, flag...), exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.Contains(t, ts.Stdout.String(), "--once cannot be combined with "+flag[0])
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: { only: { executor: 'constant-vus', vus: 10, duration: '1h', exec: 'custom' } },
+		};
+		export function custom() {}`
+
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(script), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", "archive.tar", "test.js"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	require.NoError(t, testutils.Untar(t, ts.FS, "archive.tar", "tmp/"))
+	metadataRaw, err := fsext.ReadFile(ts.FS, "tmp/metadata.json")
+	require.NoError(t, err)
+
+	var metadata struct {
+		Options struct {
+			Scenarios map[string]map[string]any `json:"scenarios"`
+		} `json:"options"`
+	}
+	require.NoError(t, json.Unmarshal(metadataRaw, &metadata))
+	require.Len(t, metadata.Options.Scenarios, 1)
+	sc := metadata.Options.Scenarios["only"]
+	assert.Equal(t, "shared-iterations", sc["executor"])
+	assert.EqualValues(t, 1, sc["vus"])
+	assert.EqualValues(t, 1, sc["iterations"])
+	assert.Equal(t, "custom", sc["exec"])
+	assert.NotContains(t, sc, "duration")
+}
