+// applyOnceFlag reduces the consolidated config to a single scenario running with 1 VU and 1
+// iteration if the --once flag is set. It's applied after the config consolidation, so it overrides
+// whatever the script, the config file or the environment variables had set, and it's a no-op for
+// the commands that don't have the flag.
+func applyOnceFlag(flags *pflag.FlagSet, conf Config) (Config, error) {
+	if flags.Lookup(onceFlagName) == nil {
+		return conf, nil
+	}
+	once, err := flags.GetBool(onceFlagName)
+	if err != nil {
+		return conf, err
+	}
+	if !once {
+		return conf, nil
+	}
+
+	for _, name := range onceConflictingFlags {
+		if flags.Lookup(name) != nil && flags.Changed(name) {
+			return conf, errext.WithExitCodeIfNone(
+				fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name),
+				exitcodes.InvalidConfig,
+			)
+		}
+	}
+
+	conf.Options, err = executor.ApplyOnce(conf.Options)
+	return conf, errext.WithExitCodeIfNone(err, exitcodes.InvalidConfig)
+}
