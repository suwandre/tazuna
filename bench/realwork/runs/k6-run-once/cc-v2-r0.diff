+// ApplyOnce reduces the scenarios configuration in opts to a single scenario
+// that runs exactly once, with 1 VU and 1 iteration, as the `--once` flag requires.
+//
+// If no scenarios are configured, the default scenario is created. If there is
+// a single scenario, its executor is replaced by a shared-iterations one, while
+// its name, exec, env, tags and scenario options are preserved. All the other
+// fields, including the execution shortcut options (vus, iterations, duration
+// and stages), are discarded. More than one scenario is an error.
+//
+// It must be called on the consolidated options, before any shortcut derivation.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	once := NewSharedIterationsConfig(lib.DefaultScenarioName)
+
+	switch len(opts.Scenarios) {
+	case 0:
+	case 1:
+		for scName, sc := range opts.Scenarios {
+			once = NewSharedIterationsConfig(scName)
+			if exec := sc.GetExec(); exec != consts.DefaultFn {
+				once.Exec = null.StringFrom(exec)
+			}
+			once.Env = sc.GetEnv()
+			once.Tags = sc.GetTags()
+			once.Options = sc.GetScenarioOptions()
+		}
+	default:
+		return opts, ExecutionConflictError(
+			fmt.Sprintf("--once can run a single scenario only, but %d scenarios are configured", len(opts.Scenarios)),
+		)
+	}
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{once.GetName(): once}
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+
+	return opts, nil
+}
