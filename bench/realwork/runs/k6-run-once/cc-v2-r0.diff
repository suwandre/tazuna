+package executor
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	requireSingleOnce := func(t *testing.T, opts lib.Options, name string) SharedIterationsConfig {
+		t.Helper()
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios[name].(SharedIterationsConfig)
+		require.True(t, ok, "expected a shared-iterations scenario named %q", name)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		assert.Nil(t, opts.Stages)
+		return sc
+	}
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := ApplyOnce(lib.Options{})
+		require.NoError(t, err)
+		sc := requireSingleOnce(t, opts, lib.DefaultScenarioName)
+		assert.Equal(t, "default", sc.GetExec())
+	})
+
+	t.Run("shortcut options are discarded", func(t *testing.T) {
+		t.Parallel()
+		opts, err := ApplyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(10),
+			Stages:     []lib.Stage{{Duration: types.NullDurationFrom(10)}},
+		})
+		require.NoError(t, err)
+		requireSingleOnce(t, opts, lib.DefaultScenarioName)
+
+		derived, err := DeriveScenariosFromShortcuts(opts, nil)
+		require.NoError(t, err)
+		requireSingleOnce(t, derived, lib.DefaultScenarioName)
+	})
+
+	t.Run("single scenario is preserved", func(t *testing.T) {
+		t.Parallel()
+		ramping := NewRampingVUsConfig("browser")
+		ramping.Exec = null.StringFrom("browserTest")
+		ramping.Env = map[string]string{"FOO": "bar"}
+		ramping.Tags = map[string]string{"tag": "value"}
+		ramping.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		ramping.StartTime = types.NullDurationFrom(5)
+		ramping.StartVUs = null.IntFrom(7)
+
+		opts, err := ApplyOnce(lib.Options{
+			Scenarios: lib.ScenarioConfigs{"browser": ramping},
+			VUs:       null.IntFrom(10),
+		})
+		require.NoError(t, err)
+		sc := requireSingleOnce(t, opts, "browser")
+		assert.Equal(t, "browserTest", sc.GetExec())
+		assert.Equal(t, ramping.Env, sc.GetEnv())
+		assert.Equal(t, ramping.Tags, sc.GetTags())
+		assert.Equal(t, ramping.Options, sc.GetScenarioOptions())
+		assert.False(t, sc.StartTime.Valid)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": NewPerVUIterationsConfig("a"),
+			"b": NewPerVUIterationsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
