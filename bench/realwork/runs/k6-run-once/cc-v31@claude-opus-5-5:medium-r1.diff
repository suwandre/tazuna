@@ -0,0 +1,152 @@
+package cmd
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestIsOnceEnabled(t *testing.T) {
+	t.Parallel()
+
+	testCases := []struct {
+		name    string
+		args    []string
+		want    bool
+		wantErr string
+	}{
+		{name: "not set", args: nil, want: false},
+		{name: "set", args: []string{"--once"}, want: true},
+		{name: "explicitly disabled", args: []string{"--once=false", "--iterations", "10"}, want: false},
+		{name: "with vus", args: []string{"--once", "--vus", "2"}, wantErr: "--once cannot be combined with --vus"},
+		{
+			name: "with iterations", args: []string{"--once", "-i", "10"},
+			wantErr: "--once cannot be combined with --iterations",
+		},
+		{
+			name: "with duration", args: []string{"--once", "--duration", "1s"},
+			wantErr: "--once cannot be combined with --duration",
+		},
+		{
+			name: "with stages", args: []string{"--once", "--stage", "1s:1"},
+			wantErr: "--once cannot be combined with --stage",
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			flags := optionFlagSet()
+			require.NoError(t, flags.Parse(tc.args))
+
+			got, err := isOnceEnabled(flags)
+			if tc.wantErr != "" {
+				require.ErrorContains(t, err, tc.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tc.want, got)
+		})
+	}
+
+	t.Run("flag not defined", func(t *testing.T) {
+		t.Parallel()
+
+		got, err := isOnceEnabled(runtimeOptionFlagSet(false))
+		require.NoError(t, err)
+		assert.False(t, got)
+	})
+}
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	assertOnceScenario := func(t *testing.T, conf Config, name string) executor.SharedIterationsConfig {
+		t.Helper()
+
+		assert.False(t, conf.VUs.Valid)
+		assert.False(t, conf.Iterations.Valid)
+		assert.False(t, conf.Duration.Valid)
+		assert.Nil(t, conf.Stages)
+		require.Len(t, conf.Scenarios, 1)
+		require.Contains(t, conf.Scenarios, name)
+
+		sc, ok := conf.Scenarios[name].(executor.SharedIterationsConfig)
+		require.True(t, ok, "expected shared-iterations, got %T", conf.Scenarios[name])
+		assert.Equal(t, name, sc.Name)
+		assert.Equal(t, "shared-iterations", sc.Type)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Empty(t, conf.Validate())
+		return sc
+	}
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		conf, err := applyOnce(Config{Options: lib.Options{
+			VUs:      null.IntFrom(10),
+			Duration: types.NullDurationFrom(time.Minute),
+		}})
+		require.NoError(t, err)
+		sc := assertOnceScenario(t, conf, lib.DefaultScenarioName)
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("stages", func(t *testing.T) {
+		t.Parallel()
+
+		conf, err := applyOnce(Config{Options: lib.Options{
+			Stages: []lib.Stage{{Duration: types.NullDurationFrom(time.Minute), Target: null.IntFrom(10)}},
+		}})
+		require.NoError(t, err)
+		assertOnceScenario(t, conf, lib.DefaultScenarioName)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		orig := executor.NewConstantArrivalRateConfig("browser_test")
+		orig.Exec = null.StringFrom("browserTest")
+		orig.Env = map[string]string{"FOO": "bar"}
+		orig.Tags = map[string]string{"tag": "value"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		orig.StartTime = types.NullDurationFrom(time.Minute)
+		orig.Rate = null.IntFrom(100)
+		orig.Duration = types.NullDurationFrom(time.Hour)
+		orig.PreAllocatedVUs = null.IntFrom(50)
+
+		conf, err := applyOnce(Config{Options: lib.Options{
+			Scenarios: lib.ScenarioConfigs{orig.Name: orig},
+		}})
+		require.NoError(t, err)
+
+		sc := assertOnceScenario(t, conf, "browser_test")
+		assert.Equal(t, null.StringFrom("browserTest"), sc.Exec)
+		assert.Equal(t, orig.Env, sc.Env)
+		assert.Equal(t, orig.Tags, sc.Tags)
+		assert.Equal(t, orig.Options, sc.Options)
+		assert.False(t, sc.StartTime.Valid)
+		assert.Zero(t, sc.GetStartTime())
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		_, err := applyOnce(Config{Options: lib.Options{
+			Scenarios: lib.ScenarioConfigs{
+				"one": executor.NewPerVUIterationsConfig("one"),
+				"two": executor.NewPerVUIterationsConfig("two"),
+			},
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
