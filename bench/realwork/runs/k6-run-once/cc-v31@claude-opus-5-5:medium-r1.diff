@@ -0,0 +1,112 @@
+package tests
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		script := `
+			import exec from 'k6/execution';
+
+			export const options = { vus: 10, duration: '1h' };
+
+			export function setup() { console.log('setup'); }
+
+			export default function () {
+				console.log('default ' + exec.scenario.name + ' ' + exec.scenario.executor);
+			}
+
+			export function teardown() { console.log('teardown'); }
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		t.Log(stdout)
+		assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Contains(t, stdout, "default default shared-iterations")
+		assert.Contains(t, stdout, "msg=setup")
+		assert.Contains(t, stdout, "msg=teardown")
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		script := `
+			import exec from 'k6/execution';
+
+			export const options = {
+				scenarios: {
+					my_scenario: {
+						executor: 'constant-arrival-rate',
+						exec: 'myExec',
+						rate: 100,
+						duration: '1h',
+						preAllocatedVUs: 10,
+						startTime: '1h',
+						env: { MY_VAR: 'my_value' },
+						tags: { my_tag: 'tag_value' },
+					},
+				},
+			};
+
+			export function myExec() {
+				console.log('myExec ' + exec.scenario.name + ' ' + exec.scenario.executor + ' ' +
+					__ENV.MY_VAR + ' ' + exec.vu.metrics.tags['my_tag']);
+			}
+
+			export default function () {
+				console.log('default called');
+			}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		t.Log(stdout)
+		assert.Contains(t, stdout, "my_scenario: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "exec: myExec")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Contains(t, stdout, "myExec my_scenario shared-iterations my_value tag_value")
+		assert.NotContains(t, stdout, "default called")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		script := `
+			export const options = {
+				scenarios: {
+					one: { executor: 'per-vu-iterations' },
+					two: { executor: 'per-vu-iterations' },
+				},
+			};
+			export default function () {}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+	})
+
+	t.Run("combined with shortcut flags", func(t *testing.T) {
+		t.Parallel()
+
+		script := `export default function () {}`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--iterations", "10"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with --iterations")
+	})
+}
