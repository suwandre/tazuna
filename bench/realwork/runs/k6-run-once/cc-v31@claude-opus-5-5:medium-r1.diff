diff --git a/internal/cmd/once.go b/internal/cmd/once.go
new file mode 100644
index 0000000..b0a53d2
--- /dev/null
+++ b/internal/cmd/once.go
@@ -0,0 +1,76 @@
+package cmd
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/spf13/pflag"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/errext"
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+const onceFlagName = "once"
+
+// onceConflictingFlags are the execution shortcut flags that can't be used together with --once.
+var onceConflictingFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// isOnceEnabled reports whether the --once flag is present in the flag set and enabled. It returns
+// an error if --once is combined with any of the execution shortcut flags.
+func isOnceEnabled(flags *pflag.FlagSet) (bool, error) {
+	if flags.Lookup(onceFlagName) == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool(onceFlagName)
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceConflictingFlags {
+		if flags.Changed(name) {
+			return false, errext.WithExitCodeIfNone(
+				fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name),
+				exitcodes.InvalidConfig,
+			)
+		}
+	}
+	return true, nil
+}
+
+// applyOnce transforms the consolidated configuration so that the test runs with 1 VU and
+// 1 iteration. The execution shortcut options (vus, iterations, duration, stages) are discarded.
+// If no scenarios are configured, a default shared-iterations scenario is created. If a single
+// scenario is configured, its executor is replaced with shared-iterations, preserving its name,
+// exec, env, tags and options. Multiple scenarios are not supported.
+func applyOnce(conf Config) (Config, error) {
+	if len(conf.Scenarios) > 1 {
+		return conf, errext.WithExitCodeIfNone(
+			errors.New("--once can run a single scenario only"),
+			exitcodes.InvalidConfig,
+		)
+	}
+
+	sc := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	for name, orig := range conf.Scenarios {
+		sc = executor.NewSharedIterationsConfig(name)
+		sc.Env = orig.GetEnv()
+		sc.Tags = orig.GetTags()
+		sc.Options = orig.GetScenarioOptions()
+		if exec := orig.GetExec(); exec != consts.DefaultFn {
+			sc.Exec = null.StringFrom(exec)
+		}
+	}
+	sc.VUs = null.IntFrom(1)
+	sc.Iterations = null.IntFrom(1)
+
+	conf.VUs = null.Int{}
+	conf.Iterations = null.Int{}
+	conf.Duration = types.NullDuration{}
+	conf.Stages = nil
+	conf.Scenarios = lib.ScenarioConfigs{sc.Name: sc}
+	return conf, nil
+}
