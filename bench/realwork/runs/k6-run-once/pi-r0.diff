+// isOnceRequested reports whether the --once flag is set, and returns an error
+// if it is combined with any of the execution shortcut flags.
+func isOnceRequested(flags *pflag.FlagSet) (bool, error) {
+	if flags.Lookup(onceFlagName) == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool(onceFlagName)
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			return false, fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name)
+		}
+	}
+	return true, nil
+}
+
+// applyOnce transforms the consolidated options so the script runs with 1 VU and
+// 1 iteration. The only scenario (or the default one, if there are no scenarios)
+// is replaced with a shared-iterations executor, preserving its exec, env, tags
+// and options, and discarding any other executor-specific field.
+func applyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, fmt.Errorf("--%s can run a single scenario only, but the script defines %d scenarios",
+			onceFlagName, len(opts.Scenarios))
+	}
+
+	name := lib.DefaultScenarioName
+	base := executor.NewBaseConfig(name, "shared-iterations")
+	for n, sc := range opts.Scenarios {
+		name = n
+		base = executor.NewBaseConfig(name, "shared-iterations")
+		base.Exec = null.NewString(sc.GetExec(), sc.GetExec() != "")
+		base.Env = sc.GetEnv()
+		base.Tags = sc.GetTags()
+		base.Options = sc.GetScenarioOptions()
+	}
+
+	sic := executor.NewSharedIterationsConfig(name)
+	sic.BaseConfig = base
+	sic.VUs = null.IntFrom(1)
+	sic.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{name: sic}
+	// Discard the shortcut options, as they conflict with the scenarios.
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	return opts, nil
+}
