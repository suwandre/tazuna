+// onceFlagName is the name of the flag that runs the script with 1 VU and 1 iteration.
+const onceFlagName = "once"
+
+// onceFlagSet returns the flag set with the --once flag. It is added only to the
+// commands that support the single-run execution mode.
+func onceFlagSet() *pflag.FlagSet {
+	flags := pflag.NewFlagSet("", 0)
+	flags.SortFlags = false
+	flags.Bool(onceFlagName, false,
+		"run the script once, with 1 VU and 1 iteration, preserving the scenario configuration (exec, env, tags, options)")
+	return flags
+}
