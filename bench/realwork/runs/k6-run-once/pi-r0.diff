+package cmd
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := applyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(10),
+		})
+		require.NoError(t, err)
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		require.Len(t, opts.Scenarios, 1)
+		sic, ok := opts.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sic.VUs.Int64)
+		assert.Equal(t, int64(1), sic.Iterations.Int64)
+		assert.False(t, sic.Exec.Valid)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		rvc := executor.NewRampingVUsConfig("foo")
+		rvc.Exec = null.StringFrom("fn")
+		rvc.Env = map[string]string{"A": "b"}
+		rvc.Tags = map[string]string{"t": "v"}
+		rvc.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		rvc.StartTime = types.NullDurationFrom(5)
+
+		opts, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"foo": rvc}})
+		require.NoError(t, err)
+		require.Len(t, opts.Scenarios, 1)
+		sic, ok := opts.Scenarios["foo"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "shared-iterations", sic.GetType())
+		assert.Equal(t, "fn", sic.GetExec())
+		assert.Equal(t, rvc.Env, sic.GetEnv())
+		assert.Equal(t, rvc.Tags, sic.GetTags())
+		assert.Equal(t, rvc.Options, sic.GetScenarioOptions())
+		assert.False(t, sic.StartTime.Valid)
+		assert.Equal(t, int64(1), sic.VUs.Int64)
+		assert.Equal(t, int64(1), sic.Iterations.Int64)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": executor.NewPerVUIterationsConfig("a"),
+			"b": executor.NewPerVUIterationsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
