+package tests
+
+import (
+	"encoding/json"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	script := `
+export const options = {
+  scenarios: {
+    foo: { executor: 'constant-vus', vus: 5, duration: '10s', exec: 'foo', env: {MYENV: 'bar'} },
+  },
+};
+export function foo() { console.log('ran foo ' + __ENV.MYENV); }
+export function setup() { console.log('setup ran'); }
+export function teardown() { console.log('teardown ran'); }
+`
+	ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "setup ran")
+	assert.Contains(t, stdout, "teardown ran")
+	assert.Equal(t, 1, strings.Count(stdout, "ran foo bar"))
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+}
+
+func TestRunOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+export const options = { vus: 10, duration: '10s' };
+export default function () { console.log('ran default'); }
+`
+	ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Equal(t, 1, strings.Count(stdout, "ran default"))
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+}
+
+func TestRunOnceErrors(t *testing.T) {
+	t.Parallel()
+
+	multi := `
+export const options = { scenarios: {
+  a: { executor: 'constant-vus', vus: 1, duration: '1s' },
+  b: { executor: 'constant-vus', vus: 1, duration: '1s' },
+} };
+export default function () {}
+`
+	simple := `export default function () {}`
+	tcs := []struct {
+		name, script, errMsg string
+		flags                []string
+	}{
+		{"multiple scenarios", multi, "--once can run a single scenario only", nil},
+		{"with iterations", simple, "--once cannot be combined with --iterations", []string{"--iterations", "10"}},
+		{"with vus", simple, "--once cannot be combined with --vus", []string{"-u", "10"}},
+		{"with duration", simple, "--once cannot be combined with --duration", []string{"-d", "10s"}},
+		{"with stage", simple, "--once cannot be combined with --stage", []string{"-s", "1s:2"}},
+	}
+	for _, tc := range tcs {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			flags := append([]string{"--once", "--log-output=stdout"}, tc.flags...)
+			ts := getSingleFileTestState(t, tc.script, flags, exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+			assert.Contains(t, ts.Stdout.String(), tc.errMsg)
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	script := `
+export const options = { vus: 10, duration: '10s' };
+export default function () {}
+`
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "script.js"), []byte(script), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "script.js"}
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+	require.NoError(t, testutils.Untar(t, ts.FS, "archive.tar", "tmp/"))
+
+	data, err := fsext.ReadFile(ts.FS, "tmp/metadata.json")
+	require.NoError(t, err)
+	var md struct {
+		Options struct {
+			Scenarios map[string]struct {
+				Executor   string `json:"executor"`
+				VUs        int    `json:"vus"`
+				Iterations int    `json:"iterations"`
+			} `json:"scenarios"`
+			Duration *string `json:"duration"`
+		} `json:"options"`
+	}
+	require.NoError(t, json.Unmarshal(data, &md))
+	require.Len(t, md.Options.Scenarios, 1)
+	sc := md.Options.Scenarios["default"]
+	assert.Equal(t, "shared-iterations", sc.Executor)
+	assert.Equal(t, 1, sc.VUs)
+	assert.Equal(t, 1, sc.Iterations)
+	assert.Nil(t, md.Options.Duration)
+}
