+package tests
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+const onceDefaultScript = `
+	export const options = { vus: 5, duration: '1h' };
+	export function setup() { console.log('setup-ran'); }
+	export default function () { console.log('default-ran'); }
+	export function teardown() { console.log('teardown-ran'); }
+`
+
+const onceSingleScenarioScript = `
+	export const options = {
+		scenarios: {
+			only: {
+				executor: 'constant-vus',
+				vus: 5,
+				duration: '1h',
+				exec: 'custom',
+				env: { FOO: 'bar' },
+				tags: { team: 'a' },
+			},
+		},
+	};
+	export function custom() { console.log('custom-ran-' + __ENV.FOO); }
+`
+
+const onceMultiScenarioScript = `
+	export const options = {
+		scenarios: {
+			a: { executor: 'shared-iterations', vus: 1, iterations: 1 },
+			b: { executor: 'shared-iterations', vus: 1, iterations: 1 },
+		},
+	};
+	export default function () {}
+`
+
+func TestRunOnceWithoutScenarios(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, onceDefaultScript, []string{"--once", "--no-usage-report", "--log-output=stdout"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Equal(t, 1, bytes.Count([]byte(stdout), []byte("default-ran")))
+	assert.Contains(t, stdout, "setup-ran")
+	assert.Contains(t, stdout, "teardown-ran")
+}
+
+func TestRunOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, onceSingleScenarioScript,
+		[]string{"--once", "--no-usage-report", "--log-output=stdout", "--out", "json=results.json"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Contains(t, stdout, "custom-ran-bar")
+
+	results, err := fsext.ReadFile(ts.FS, "results.json")
+	require.NoError(t, err)
+	tagged := getSampleValues(t, results, "iterations", map[string]string{"team": "a", "scenario": "only"})
+	assert.Equal(t, float64(1), sum(tagged))
+}
+
+func TestRunOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, onceMultiScenarioScript, []string{"--once"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.True(t, testutils.LogContains(ts.LoggerHook.Drain(), logrus.ErrorLevel,
+		"--once can run a single scenario only"))
+}
+
+func TestRunOnceWithShortcutFlag(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, onceDefaultScript, []string{"--once", "--iterations", "10"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.True(t, testutils.LogContains(ts.LoggerHook.Drain(), logrus.ErrorLevel,
+		"--once cannot be combined with --iterations"))
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, "/test.js", []byte(onceSingleScenarioScript), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", "/out.tar", "/test.js"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	data, err := fsext.ReadFile(ts.FS, "/out.tar")
+	require.NoError(t, err)
+	arc, err := lib.ReadArchive(bytes.NewReader(data))
+	require.NoError(t, err)
+
+	require.Len(t, arc.Options.Scenarios, 1)
+	sc, ok := arc.Options.Scenarios["only"].(executor.SharedIterationsConfig)
+	require.True(t, ok, "expected shared-iterations, got %T", arc.Options.Scenarios["only"])
+	assert.Equal(t, int64(1), sc.VUs.Int64)
+	assert.Equal(t, int64(1), sc.Iterations.Int64)
+	assert.Equal(t, "custom", sc.GetExec())
+	assert.Equal(t, map[string]string{"FOO": "bar"}, sc.GetEnv())
+	assert.Equal(t, map[string]string{"team": "a"}, sc.GetTags())
+}
