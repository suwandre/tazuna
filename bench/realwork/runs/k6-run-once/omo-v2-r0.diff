+package cmd
+
+import (
+	"testing"
+	"time"
+
+	"github.com/sirupsen/logrus"
+	"github.com/spf13/pflag"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestIsOnceEnabled(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		args    []string
+		once    bool
+		wantErr string
+	}{
+		{name: "not set", args: nil},
+		{name: "shortcuts without once", args: []string{"--iterations", "10", "-u", "2"}},
+		{name: "once", args: []string{"--once"}, once: true},
+		{name: "once=false", args: []string{"--once=false", "--iterations", "10"}},
+		{name: "with iterations", args: []string{"--once", "--iterations", "10"}, once: true,
+			wantErr: "--once cannot be combined with --iterations"},
+		{name: "with short iterations", args: []string{"--once", "-i", "10"}, once: true,
+			wantErr: "--once cannot be combined with --iterations"},
+		{name: "with vus", args: []string{"--once", "--vus", "2"}, once: true,
+			wantErr: "--once cannot be combined with --vus"},
+		{name: "with duration", args: []string{"--once", "--duration", "1s"}, once: true,
+			wantErr: "--once cannot be combined with --duration"},
+		{name: "with stage", args: []string{"--once", "--stage", "1s:2"}, once: true,
+			wantErr: "--once cannot be combined with --stage"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			flags := pflag.NewFlagSet("", pflag.ContinueOnError)
+			flags.AddFlagSet(optionFlagSet())
+			flags.AddFlagSet(onceFlagSet())
+			require.NoError(t, flags.Parse(tc.args))
+
+			once, err := isOnceEnabled(flags)
+			assert.Equal(t, tc.once, once)
+			if tc.wantErr != "" {
+				require.EqualError(t, err, tc.wantErr)
+				return
+			}
+			require.NoError(t, err)
+		})
+	}
+
+	t.Run("flag not defined", func(t *testing.T) {
+		t.Parallel()
+
+		flags := optionFlagSet()
+		require.NoError(t, flags.Parse([]string{"--iterations", "10"}))
+		once, err := isOnceEnabled(flags)
+		require.NoError(t, err)
+		assert.False(t, once)
+	})
+}
+
+func TestApplyOnceWithoutScenarios(t *testing.T) {
+	t.Parallel()
+
+	conf := Config{Options: lib.Options{
+		VUs:        null.IntFrom(10),
+		Iterations: null.IntFrom(100),
+		Duration:   types.NullDurationFrom(time.Minute),
+		Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second), Target: null.IntFrom(5)}},
+	}}
+
+	got, err := applyOnce(conf)
+	require.NoError(t, err)
+	assert.Equal(t, null.IntFrom(1), got.VUs)
+	assert.Equal(t, null.IntFrom(1), got.Iterations)
+	assert.False(t, got.Duration.Valid)
+	assert.Nil(t, got.Stages)
+	assert.Nil(t, got.Scenarios)
+
+	derived, err := executor.DeriveScenariosFromShortcuts(got.Options, logrus.New())
+	require.NoError(t, err)
+	require.Len(t, derived.Scenarios, 1)
+	sc, ok := derived.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+	require.True(t, ok)
+	assert.Equal(t, null.IntFrom(1), sc.VUs)
+	assert.Equal(t, null.IntFrom(1), sc.Iterations)
+}
+
+func TestApplyOnceSingleScenario(t *testing.T) {
+	t.Parallel()
+
+	scenarioOpts := &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+	ramping := executor.NewRampingVUsConfig("only")
+	ramping.Exec = null.StringFrom("custom")
+	ramping.Env = map[string]string{"FOO": "bar"}
+	ramping.Tags = map[string]string{"team": "a"}
+	ramping.Options = scenarioOpts
+	ramping.StartTime = types.NullDurationFrom(5 * time.Second)
+	ramping.StartVUs = null.IntFrom(7)
+	ramping.Stages = []executor.Stage{{Duration: types.NullDurationFrom(time.Minute), Target: null.IntFrom(50)}}
+
+	conf := Config{Options: lib.Options{
+		VUs:       null.IntFrom(10),
+		Duration:  types.NullDurationFrom(time.Minute),
+		Scenarios: lib.ScenarioConfigs{"only": ramping},
+	}}
+
+	got, err := applyOnce(conf)
+	require.NoError(t, err)
+
+	require.Len(t, got.Scenarios, 1)
+	sc, ok := got.Scenarios["only"].(executor.SharedIterationsConfig)
+	require.True(t, ok, "expected shared-iterations, got %T", got.Scenarios["only"])
+	assert.Equal(t, "only", sc.GetName())
+	assert.Equal(t, null.IntFrom(1), sc.VUs)
+	assert.Equal(t, null.IntFrom(1), sc.Iterations)
+	assert.Equal(t, "custom", sc.GetExec())
+	assert.Equal(t, map[string]string{"FOO": "bar"}, sc.GetEnv())
+	assert.Equal(t, map[string]string{"team": "a"}, sc.GetTags())
+	assert.Same(t, scenarioOpts, sc.GetScenarioOptions())
+	assert.Zero(t, sc.GetStartTime())
+
+	assert.False(t, got.VUs.Valid)
+	assert.False(t, got.Iterations.Valid)
+	assert.False(t, got.Duration.Valid)
+	assert.Nil(t, got.Stages)
+	_, err = executor.DeriveScenariosFromShortcuts(got.Options, logrus.New())
+	require.NoError(t, err)
+
+	assert.Contains(t, conf.Scenarios, "only")
+	_, isRamping := conf.Scenarios["only"].(executor.RampingVUsConfig)
+	assert.True(t, isRamping)
+}
+
+func TestApplyOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	conf := Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{
+		"a": executor.NewSharedIterationsConfig("a"),
+		"b": executor.NewSharedIterationsConfig("b"),
+	}}}
+
+	_, err := applyOnce(conf)
+	require.ErrorContains(t, err, "--once can run a single scenario only")
+}
