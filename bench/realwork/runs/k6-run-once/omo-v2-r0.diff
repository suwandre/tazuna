+const onceFlagName = "once"
+
+// onceIncompatibleFlags are the execution shortcut flags that can't be combined with --once.
+var onceIncompatibleFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// onceFlagSet returns a FlagSet with the --once flag.
+func onceFlagSet() *pflag.FlagSet {
+	flags := pflag.NewFlagSet("", 0)
+	flags.SortFlags = false
+	flags.Bool(onceFlagName, false,
+		"run the script once, with 1 VU and 1 iteration, preserving the scenario configuration")
+	return flags
+}
+
+// isOnceEnabled checks if the --once flag is defined and set, and that it isn't combined with
+// any of the execution shortcut flags.
+func isOnceEnabled(flags *pflag.FlagSet) (bool, error) {
+	if flags == nil || flags.Lookup(onceFlagName) == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool(onceFlagName)
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceIncompatibleFlags {
+		if flags.Changed(name) {
+			return true, fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name)
+		}
+	}
+	return true, nil
+}
+
+// applyOnce transforms the consolidated config so the script runs with 1 VU and 1 iteration.
+// Without scenarios, the execution shortcuts are replaced so that the default scenario is derived
+// later. A single scenario keeps its exec, env, tags and options, but it's replaced with a
+// shared-iterations executor; all of its other fields are discarded.
+func applyOnce(conf Config) (Config, error) {
+	if len(conf.Scenarios) > 1 {
+		return conf, fmt.Errorf("--%s can run a single scenario only, but the script defines %d scenarios",
+			onceFlagName, len(conf.Scenarios))
+	}
+
+	for name, sc := range conf.Scenarios {
+		once := executor.NewSharedIterationsConfig(name)
+		once.VUs = null.IntFrom(1)
+		once.Iterations = null.IntFrom(1)
+		once.Exec = null.StringFrom(sc.GetExec())
+		once.Env = sc.GetEnv()
+		once.Tags = sc.GetTags()
+		once.Options = sc.GetScenarioOptions()
+		conf.Scenarios = lib.ScenarioConfigs{name: once}
+
+		// The shortcuts would conflict with the scenario when deriving.
+		conf.VUs = null.Int{}
+		conf.Iterations = null.Int{}
+	}
+	if len(conf.Scenarios) == 0 {
+		conf.VUs = null.IntFrom(1)
+		conf.Iterations = null.IntFrom(1)
+	}
+	conf.Duration = types.NullDuration{}
+	conf.Stages = nil
+
+	return conf, nil
+}
