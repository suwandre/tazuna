diff --git a/internal/cmd/once.go b/internal/cmd/once.go
new file mode 100644
index 0000000..8fd005a
--- /dev/null
+++ b/internal/cmd/once.go
@@ -0,0 +1,70 @@
+package cmd
+
+import (
+	"fmt"
+
+	"github.com/spf13/pflag"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+const onceFlagName = "once"
+
+// onceConflictingFlags are the shortcut flags that can't be combined with --once.
+var onceConflictingFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// isOnceRequested returns true if the --once flag is defined and set. It returns an
+// error if --once is combined with any of the execution shortcut flags.
+func isOnceRequested(flags *pflag.FlagSet) (bool, error) {
+	if flags == nil || flags.Lookup(onceFlagName) == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool(onceFlagName)
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceConflictingFlags {
+		if flags.Changed(name) {
+			return false, fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name)
+		}
+	}
+	return true, nil
+}
+
+// applyOnce transforms the (already consolidated) options so the script runs a
+// single scenario with 1 VU and 1 iteration. The scenario's exec, env, tags and
+// options are preserved, while its executor is replaced by shared-iterations.
+func applyOnce(opts lib.Options) (lib.Options, error) {
+	var scenario executor.SharedIterationsConfig
+
+	switch len(opts.Scenarios) {
+	case 0:
+		scenario = executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	case 1:
+		for name, sc := range opts.Scenarios {
+			scenario = executor.NewSharedIterationsConfig(name)
+			scenario.Exec = null.NewString(sc.GetExec(), sc.GetExec() != "")
+			scenario.Env = sc.GetEnv()
+			scenario.Tags = sc.GetTags()
+			scenario.Options = sc.GetScenarioOptions()
+		}
+	default:
+		return opts, fmt.Errorf("--%s can run a single scenario only, but the script defines %d scenarios",
+			onceFlagName, len(opts.Scenarios))
+	}
+
+	scenario.VUs = null.IntFrom(1)
+	scenario.Iterations = null.IntFrom(1)
+
+	// Clear any shortcut options so they don't conflict with the scenario.
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	opts.Scenarios = lib.ScenarioConfigs{scenario.Name: scenario}
+
+	return opts, nil
+}
diff --git a/internal/cmd/once_test.go b/internal/cmd/once_test.go
new file mode 100644
index 0000000..0a9f253
--- /dev/null
+++ b/internal/cmd/once_test.go
@@ -0,0 +1,99 @@
+package cmd
+
+import (
+	"testing"
+
+	"github.com/spf13/pflag"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := applyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(10),
+		})
+		require.NoError(t, err)
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("single scenario preserves exec, env, tags and options", func(t *testing.T) {
+		t.Parallel()
+		orig := executor.NewConstantVUsConfig("foo")
+		orig.VUs = null.IntFrom(50)
+		orig.Duration = types.NullDurationFrom(60)
+		orig.Exec = null.StringFrom("myFn")
+		orig.Env = map[string]string{"A": "b"}
+		orig.Tags = map[string]string{"t": "v"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		orig.StartTime = types.NullDurationFrom(5)
+
+		opts, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"foo": orig}})
+		require.NoError(t, err)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios["foo"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "foo", sc.Name)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.Equal(t, "myFn", sc.Exec.String)
+		assert.Equal(t, orig.Env, sc.Env)
+		assert.Equal(t, orig.Tags, sc.Tags)
+		assert.Equal(t, orig.Options, sc.Options)
+		assert.False(t, sc.StartTime.Valid)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": executor.NewConstantVUsConfig("a"),
+			"b": executor.NewConstantVUsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
+
+func TestIsOnceRequested(t *testing.T) {
+	t.Parallel()
+
+	parse := func(args ...string) *pflag.FlagSet {
+		flags := optionFlagSet()
+		require.NoError(t, flags.Parse(args))
+		return flags
+	}
+
+	ok, err := isOnceRequested(parse())
+	require.NoError(t, err)
+	assert.False(t, ok)
+
+	ok, err = isOnceRequested(parse("--once"))
+	require.NoError(t, err)
+	assert.True(t, ok)
+
+	ok, err = isOnceRequested(nil)
+	require.NoError(t, err)
+	assert.False(t, ok)
+
+	for _, f := range [][]string{{"--vus", "2"}, {"--iterations", "10"}, {"--duration", "1s"}, {"--stage", "1s:2"}} {
+		_, err = isOnceRequested(parse(append([]string{"--once"}, f...)...))
+		require.ErrorContains(t, err, "--once cannot be combined with --"+f[0][2:])
+	}
+}
