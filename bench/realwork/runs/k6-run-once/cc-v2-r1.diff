@@ -0,0 +1,116 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		got, err := ApplyOnce(lib.Options{})
+		require.NoError(t, err)
+
+		require.Len(t, got.Scenarios, 1)
+		sc, ok := got.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("shortcuts are discarded", func(t *testing.T) {
+		t.Parallel()
+
+		got, err := ApplyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second), Target: null.IntFrom(5)}},
+			Scenarios:  lib.ScenarioConfigs{},
+			NoSetup:    null.BoolFrom(true),
+		})
+		require.NoError(t, err)
+
+		assert.False(t, got.VUs.Valid)
+		assert.False(t, got.Iterations.Valid)
+		assert.False(t, got.Duration.Valid)
+		assert.Nil(t, got.Stages)
+		assert.Equal(t, null.BoolFrom(true), got.NoSetup, "unrelated options are preserved")
+
+		// the result must be usable by the regular derivation without conflicts
+		derived, err := DeriveScenariosFromShortcuts(got, nil)
+		require.NoError(t, err)
+		assert.Equal(t, got.Scenarios, derived.Scenarios)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		browser := &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		original := NewRampingVUsConfig("ui")
+		original.Exec = null.StringFrom("browserTest")
+		original.Env = map[string]string{"FOO": "bar"}
+		original.Tags = map[string]string{"team": "a"}
+		original.Options = browser
+		original.StartTime = types.NullDurationFrom(5 * time.Second)
+		original.GracefulStop = types.NullDurationFrom(time.Minute)
+		original.StartVUs = null.IntFrom(20)
+		original.Stages = []Stage{{Duration: types.NullDurationFrom(time.Minute), Target: null.IntFrom(50)}}
+
+		got, err := ApplyOnce(lib.Options{
+			Scenarios: lib.ScenarioConfigs{"ui": original},
+			NoSetup:   null.BoolFrom(true),
+		})
+		require.NoError(t, err)
+
+		require.Len(t, got.Scenarios, 1)
+		sc, ok := got.Scenarios["ui"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "ui", sc.GetName())
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.Equal(t, "browserTest", sc.GetExec())
+		assert.Equal(t, map[string]string{"FOO": "bar"}, sc.GetEnv())
+		assert.Equal(t, map[string]string{"team": "a"}, sc.GetTags())
+		assert.Same(t, browser, sc.GetScenarioOptions())
+		assert.Zero(t, sc.GetStartTime())
+		assert.Equal(t, null.BoolFrom(true), got.NoSetup)
+		assert.Empty(t, sc.Validate())
+	})
+
+	t.Run("single scenario without exec", func(t *testing.T) {
+		t.Parallel()
+
+		got, err := ApplyOnce(lib.Options{
+			Scenarios: lib.ScenarioConfigs{"load": NewConstantVUsConfig("load")},
+		})
+		require.NoError(t, err)
+
+		sc, ok := got.Scenarios["load"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.False(t, sc.Exec.Valid)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		_, err := ApplyOnce(lib.Options{
+			Scenarios: lib.ScenarioConfigs{
+				"a": NewConstantVUsConfig("a"),
+				"b": NewConstantVUsConfig("b"),
+			},
+		})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
