+
+// ApplyOnce turns the provided (already consolidated) options into a configuration that runs the
+// script exactly once: a single shared-iterations scenario with 1 VU and 1 iteration.
+//
+// If the script has no scenarios, the default scenario is used. If it has exactly one scenario, it
+// is replaced with a shared-iterations one that keeps the exec, env, tags and scenario options
+// (e.g. browser) of the original. Everything else is discarded, including the vus, iterations,
+// duration and stages shortcut options. More than one scenario is an error.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	name := lib.DefaultScenarioName
+	once := NewSharedIterationsConfig(name)
+
+	switch len(opts.Scenarios) {
+	case 0:
+	case 1:
+		for scenarioName, sc := range opts.Scenarios {
+			name = scenarioName
+			once = NewSharedIterationsConfig(name)
+			if exec := sc.GetExec(); exec != consts.DefaultFn {
+				once.Exec = null.StringFrom(exec)
+			}
+			once.Env = sc.GetEnv()
+			once.Tags = sc.GetTags()
+			once.Options = sc.GetScenarioOptions()
+		}
+	default:
+		return opts, ExecutionConflictError(fmt.Sprintf(
+			"--once can run a single scenario only, but the script defines %d scenarios", len(opts.Scenarios),
+		))
+	}
+
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	opts.Scenarios = lib.ScenarioConfigs{name: once}
+
+	return opts, nil
+}
