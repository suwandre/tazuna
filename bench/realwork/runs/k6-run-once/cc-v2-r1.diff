+package tests
+
+import (
+	"archive/tar"
+	"bytes"
+	"encoding/json"
+	"io"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+const onceSingleScenarioScript = `
+export const options = {
+	scenarios: {
+		api: {
+			executor: 'constant-vus',
+			vus: 10,
+			duration: '1h',
+			exec: 'other',
+			env: { FOO: 'bar' },
+			tags: { team: 'a' },
+		},
+	},
+};
+
+export function setup() { console.log('setup-ran'); }
+export function teardown() { console.log('teardown-ran'); }
+export function other() { console.log('other-ran FOO=' + __ENV.FOO); }
+export default function () { console.log('default-ran'); }
+`
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		ts := getSingleFileTestState(t, `
+			export function setup() { console.log('setup-ran'); }
+			export function teardown() { console.log('teardown-ran'); }
+			export default function () { console.log('default-ran'); }
+		`, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "default: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Contains(t, stdout, "setup-ran")
+		assert.Contains(t, stdout, "default-ran")
+		assert.Contains(t, stdout, "teardown-ran")
+	})
+
+	t.Run("script shortcuts are discarded", func(t *testing.T) {
+		t.Parallel()
+
+		ts := getSingleFileTestState(t, `
+			export const options = { vus: 5, duration: '1h' };
+			export default function () {}
+		`, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "default: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		ts := getSingleFileTestState(t, onceSingleScenarioScript, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "api: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Contains(t, stdout, "setup-ran")
+		assert.Contains(t, stdout, "other-ran FOO=bar")
+		assert.NotContains(t, stdout, "default-ran")
+		assert.Contains(t, stdout, "teardown-ran")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		ts := getSingleFileTestState(t, `
+			export const options = {
+				scenarios: {
+					a: { executor: 'constant-vus', vus: 1, duration: '1s' },
+					b: { executor: 'constant-vus', vus: 1, duration: '1s' },
+				},
+			};
+			export default function () {}
+		`, []string{"--once"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		assert.Contains(t, ts.Stderr.String()+ts.Stdout.String(), "--once can run a single scenario only")
+	})
+
+	for _, flag := range [][]string{
+		{"--iterations", "10"}, {"--vus", "2"}, {"--duration", "10s"}, {"--stage", "10s:2"}, {"-i", "10"},
+	} {
+		t.Run("incompatible with "+flag[0], func(t *testing.T) {
+			t.Parallel()
+
+			ts := getSingleFileTestState(t, `export default function () {}`,
+				append([]string{"--once"}, flag...), exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.Contains(t, ts.Stderr.String()+ts.Stdout.String(), "--once cannot be combined with")
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(onceSingleScenarioScript), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", "-", "test.js"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	tr := tar.NewReader(bytes.NewReader(ts.Stdout.Bytes()))
+	var metadata []byte
+	for {
+		hdr, err := tr.Next()
+		if err == io.EOF {
+			break
+		}
+		require.NoError(t, err)
+		if hdr.Name == "metadata.json" {
+			metadata, err = io.ReadAll(tr)
+			require.NoError(t, err)
+		}
+	}
+	require.NotEmpty(t, metadata)
+
+	var meta struct {
+		Options struct {
+			VUs       *int64                     `json:"vus"`
+			Duration  *string                    `json:"duration"`
+			Scenarios map[string]json.RawMessage `json:"scenarios"`
+		} `json:"options"`
+	}
+	require.NoError(t, json.Unmarshal(metadata, &meta))
+	assert.Nil(t, meta.Options.VUs)
+	assert.Nil(t, meta.Options.Duration)
+	require.Len(t, meta.Options.Scenarios, 1)
+
+	var sc map[string]any
+	require.NoError(t, json.Unmarshal(meta.Options.Scenarios["api"], &sc))
+	assert.Equal(t, "shared-iterations", sc["executor"])
+	assert.EqualValues(t, 1, sc["vus"])
+	assert.EqualValues(t, 1, sc["iterations"])
+	assert.Equal(t, "other", sc["exec"])
+	assert.Equal(t, map[string]any{"FOO": "bar"}, sc["env"])
+	assert.Equal(t, map[string]any{"team": "a"}, sc["tags"])
+}
