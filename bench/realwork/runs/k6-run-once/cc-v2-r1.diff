+func TestGetOnce(t *testing.T) {
+	t.Parallel()
+
+	testCases := []struct {
+		args   []string
+		once   bool
+		errMsg string
+	}{
+		{args: nil},
+		{args: []string{"--once"}, once: true},
+		{args: []string{"--once=false", "--iterations", "5"}},
+		{args: []string{"--iterations", "5"}},
+		{args: []string{"--once", "--iterations", "5"}, errMsg: "--once cannot be combined with --iterations"},
+		{args: []string{"--once", "-i", "5"}, errMsg: "--once cannot be combined with --iterations"},
+		{args: []string{"--once", "--vus", "1"}, errMsg: "--once cannot be combined with --vus"},
+		{args: []string{"--once", "--duration", "5s"}, errMsg: "--once cannot be combined with --duration"},
+		{args: []string{"--once", "--stage", "5s:1"}, errMsg: "--once cannot be combined with --stage"},
+	}
+
+	for _, tc := range testCases {
+		t.Run(strings.Join(tc.args, " "), func(t *testing.T) {
+			t.Parallel()
+
+			flags := optionFlagSet()
+			require.NoError(t, flags.Parse(tc.args))
+
+			once, err := getOnce(flags)
+			if tc.errMsg != "" {
+				require.EqualError(t, err, tc.errMsg)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tc.once, once)
+		})
+	}
+
+	t.Run("flag set without --once", func(t *testing.T) {
+		t.Parallel()
+
+		once, err := getOnce(runtimeOptionFlagSet(false))
+		require.NoError(t, err)
+		assert.False(t, once)
+	})
+}
