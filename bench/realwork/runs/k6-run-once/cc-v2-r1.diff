+// onceIncompatibleFlags are the shortcut flags that replace the scenarios, so they can't be used with --once.
+var onceIncompatibleFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// getOnce returns whether the --once flag is set. It returns an error if it is combined with any of
+// the execution shortcut flags. A flag set without the --once flag is treated as if it was not set.
+func getOnce(flags *pflag.FlagSet) (bool, error) {
+	if flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceIncompatibleFlags {
+		if flags.Changed(name) {
+			return false, fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+	return true, nil
+}
