+package tests
+
+import (
+	"testing"
+
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		script := `
+			import { Counter } from 'k6/metrics';
+			const calls = new Counter('calls');
+
+			export const options = { vus: 10, iterations: 100 };
+
+			export function setup() { console.log('setup'); }
+			export default function () { calls.add(1); }
+			export function teardown() { console.log('teardown'); }
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		t.Log(stdout)
+		assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Contains(t, stdout, "msg=setup")
+		assert.Contains(t, stdout, "msg=teardown")
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		script := `
+			import exec from 'k6/execution';
+
+			export const options = {
+				scenarios: {
+					myscenario: {
+						executor: 'constant-arrival-rate',
+						rate: 100,
+						duration: '1h',
+						preAllocatedVUs: 50,
+						exec: 'myfunc',
+						env: { MYENV: 'myvalue' },
+						tags: { mytag: 'mytagvalue' },
+					},
+				},
+			};
+
+			export function myfunc() {
+				console.log('exec=' + exec.scenario.name + ',env=' + __ENV.MYENV +
+					',tag=' + exec.vu.tags['mytag']);
+			}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		t.Log(stdout)
+		assert.Contains(t, stdout, "myscenario: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "exec: myfunc")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Contains(t, stdout, `msg="exec=myscenario,env=myvalue,tag=mytagvalue"`)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		script := `
+			export const options = {
+				scenarios: {
+					sc1: { executor: 'per-vu-iterations' },
+					sc2: { executor: 'per-vu-iterations' },
+				},
+			};
+			export default function () {}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.True(t, testutils.LogContains(
+			ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once can run a single scenario only"))
+	})
+
+	for _, flag := range [][]string{
+		{"--iterations", "10"},
+		{"--vus", "2"},
+		{"--duration", "1s"},
+		{"--stage", "1s:1"},
+	} {
+		t.Run("conflicting flag "+flag[0], func(t *testing.T) {
+			t.Parallel()
+
+			flags := append([]string{"--once"}, flag...)
+			ts := getSingleFileTestState(t, `export default function () {}`, flags, exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+			assert.True(t, testutils.LogContains(
+				ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once cannot be combined with "+flag[0]))
+		})
+	}
+}
diff --git a/lib/executor/once.go b/lib/executor/once.go
new file mode 100644
index 0000000..2aa5c9a
--- /dev/null
+++ b/lib/executor/once.go
@@ -0,0 +1,48 @@
+package executor
+
+import (
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+// ApplyOnce transforms the given (already consolidated) options, so that the
+// test is executed with exactly 1 VU and 1 iteration.
+//
+// If no scenarios are configured, a default shared-iterations scenario is
+// created. If a single scenario is configured, its executor is replaced with a
+// shared-iterations one, preserving the scenario name, exec, env, tags and
+// scenario options (e.g. browser options), while discarding everything else.
+// Multiple scenarios are not supported and result in an error.
+//
+// The execution shortcut options (vus, iterations, duration, stages) are
+// discarded, so they don't conflict with the resulting scenario.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ExecutionConflictError("--once can run a single scenario only")
+	}
+
+	sc := NewSharedIterationsConfig(lib.DefaultScenarioName)
+	for name, orig := range opts.Scenarios {
+		sc = NewSharedIterationsConfig(name)
+		sc.Env = orig.GetEnv()
+		sc.Tags = orig.GetTags()
+		sc.Options = orig.GetScenarioOptions()
+		if exec := orig.GetExec(); exec != consts.DefaultFn {
+			sc.Exec = null.StringFrom(exec)
+		}
+	}
+	sc.VUs = null.IntFrom(1)
+	sc.Iterations = null.IntFrom(1)
+
+	result := opts
+	result.VUs = null.NewInt(1, false)
+	result.Iterations = null.Int{}
+	result.Duration = types.NullDuration{}
+	result.Stages = nil
+	result.Scenarios = lib.ScenarioConfigs{sc.GetName(): sc}
+
+	return result, nil
+}
