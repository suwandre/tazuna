+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	testScript := []byte(`
+		export const options = {
+			scenarios: {
+				sc: {
+					executor: 'constant-vus',
+					vus: 10,
+					duration: '1h',
+					exec: 'myfunc',
+					env: { MYENV: 'myvalue' },
+				},
+			},
+		};
+		export function myfunc() {}
+	`)
