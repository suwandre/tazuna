+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts := lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second), Target: null.IntFrom(5)}},
+		}
+		result, err := ApplyOnce(opts)
+		require.NoError(t, err)
+
+		assert.False(t, result.VUs.Valid)
+		assert.False(t, result.Iterations.Valid)
+		assert.False(t, result.Duration.Valid)
+		assert.Nil(t, result.Stages)
+		require.Len(t, result.Scenarios, 1)
+		sc, ok := result.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, "default", sc.GetExec())
+
+		// the result should not be affected by the shortcut derivation
+		derived, err := DeriveScenariosFromShortcuts(result, nil)
+		require.NoError(t, err)
+		assert.Equal(t, result.Scenarios, derived.Scenarios)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		orig := NewConstantArrivalRateConfig("myscenario")
+		orig.Rate = null.IntFrom(100)
+		orig.Duration = types.NullDurationFrom(time.Hour)
+		orig.PreAllocatedVUs = null.IntFrom(50)
+		orig.StartTime = types.NullDurationFrom(time.Minute)
+		orig.Exec = null.StringFrom("myfunc")
+		orig.Env = map[string]string{"MYENV": "myvalue"}
+		orig.Tags = map[string]string{"mytag": "mytagvalue"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+
+		result, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"myscenario": orig}})
+		require.NoError(t, err)
+		require.Len(t, result.Scenarios, 1)
+
+		sc, ok := result.Scenarios["myscenario"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "myscenario", sc.Name)
+		assert.Equal(t, sharedIterationsType, sc.Type)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, null.StringFrom("myfunc"), sc.Exec)
+		assert.Equal(t, orig.Env, sc.Env)
+		assert.Equal(t, orig.Tags, sc.Tags)
+		assert.Equal(t, orig.Options, sc.Options)
+		assert.Zero(t, sc.GetStartTime())
+		assert.Empty(t, sc.Validate())
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		_, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"sc1": NewPerVUIterationsConfig("sc1"),
+			"sc2": NewPerVUIterationsConfig("sc2"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
