diff --git a/lib/executor/once.go b/lib/executor/once.go
new file mode 100644
index 0000000..3292ceb
--- /dev/null
+++ b/lib/executor/once.go
@@ -0,0 +1,56 @@
+package executor
+
+import (
+	"errors"
+
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+)
+
+// ErrOnceMultipleScenarios is returned when --once is used with a script that defines
+// more than one scenario.
+var ErrOnceMultipleScenarios = errors.New("--once can run a single scenario only")
+
+// ApplyOnce transforms the options so that the script runs with 1 VU and 1 iteration.
+//
+// If there are no scenarios, a default one is created. If there is a single scenario, it is
+// replaced by a shared-iterations executor with 1 VU and 1 iteration, preserving its name,
+// exec function, env, tags and scenario options (e.g. browser). All the other fields are
+// discarded, as well as the shortcut options (vus, iterations, duration, stages), as they
+// are superseded by the generated scenario.
+//
+// It is expected to be called on the consolidated config, so all the config layers are
+// already merged.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ErrOnceMultipleScenarios
+	}
+
+	name := lib.DefaultScenarioName
+	cfg := NewSharedIterationsConfig(name)
+
+	for n, sc := range opts.Scenarios {
+		name = n
+		cfg = NewSharedIterationsConfig(name)
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			cfg.Exec = null.StringFrom(exec)
+		}
+		cfg.Env = sc.GetEnv()
+		cfg.Tags = sc.GetTags()
+		cfg.Options = sc.GetScenarioOptions()
+	}
+
+	cfg.VUs = null.IntFrom(1)
+	cfg.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{name: cfg}
+	opts.VUs = null.NewInt(0, false)
+	opts.Iterations = null.NewInt(0, false)
+	opts.Duration.Valid = false
+	opts.Duration.Duration = 0
+	opts.Stages = nil
+
+	return opts, nil
+}
