@@ -0,0 +1,85 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := ApplyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+		})
+		require.NoError(t, err)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+
+		// the result must be accepted by the shortcuts derivation
+		_, err = DeriveScenariosFromShortcuts(opts, nil)
+		require.NoError(t, err)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		orig := NewRampingVUsConfig("sc")
+		orig.Exec = null.StringFrom("fn")
+		orig.Env = map[string]string{"A": "b"}
+		orig.Tags = map[string]string{"t": "v"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		orig.StartTime = types.NullDurationFrom(time.Second)
+
+		opts, err := ApplyOnce(lib.Options{
+			Scenarios: lib.ScenarioConfigs{"sc": orig},
+			Stages:    []lib.Stage{{Duration: types.NullDurationFrom(time.Second)}},
+		})
+		require.NoError(t, err)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios["sc"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "sc", sc.GetName())
+		assert.Equal(t, "fn", sc.GetExec())
+		assert.Equal(t, orig.Env, sc.GetEnv())
+		assert.Equal(t, orig.Tags, sc.GetTags())
+		assert.Equal(t, orig.Options, sc.GetScenarioOptions())
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.False(t, sc.Exec.Valid && sc.Exec.String == "")
+		assert.Zero(t, sc.GetStartTime())
+		assert.Nil(t, opts.Stages)
+	})
+
+	t.Run("default exec stays unset", func(t *testing.T) {
+		t.Parallel()
+		opts, err := ApplyOnce(lib.Options{
+			Scenarios: lib.ScenarioConfigs{"sc": NewConstantVUsConfig("sc")},
+		})
+		require.NoError(t, err)
+		assert.False(t, opts.Scenarios["sc"].(SharedIterationsConfig).Exec.Valid)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": NewConstantVUsConfig("a"), "b": NewConstantVUsConfig("b"),
+		}})
+		require.ErrorIs(t, err, ErrOnceMultipleScenarios)
+	})
+}
