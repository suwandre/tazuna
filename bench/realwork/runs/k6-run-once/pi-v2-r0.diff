+package cmd
+
+import (
+	"encoding/json"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd/tests"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := tests.NewGlobalTestState(t)
+		script := `
+export const options = { vus: 5, duration: '1h' };
+export default function () { console.log('iteration-marker'); }`
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "script.js"), []byte(script), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "--log-output=stdout", "script.js"}
+
+		newRootCommand(ts.GlobalState).execute()
+
+		assert.Equal(t, 1, strings.Count(ts.Stdout.String(), "iteration-marker"))
+		assert.Contains(t, ts.Stdout.String(), "1 complete")
+	})
+
+	t.Run("single scenario keeps exec, env and tags", func(t *testing.T) {
+		t.Parallel()
+		ts := tests.NewGlobalTestState(t)
+		script := `
+export const options = {
+  scenarios: {
+    sc: {
+      executor: 'constant-vus', vus: 10, duration: '1h',
+      exec: 'other', env: { FOO: 'bar' }, tags: { mytag: 'myvalue' },
+    },
+  },
+};
+export function other() { console.log('other-marker ' + __ENV.FOO); }
+export default function () { console.log('default-marker'); }
+export function setup() { console.log('setup-marker'); }
+export function teardown() { console.log('teardown-marker'); }`
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "script.js"), []byte(script), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "--log-output=stdout", "script.js"}
+
+		newRootCommand(ts.GlobalState).execute()
+
+		out := ts.Stdout.String()
+		assert.Equal(t, 1, strings.Count(out, "other-marker bar"))
+		assert.NotContains(t, out, "default-marker")
+		assert.Contains(t, out, "setup-marker")
+		assert.Contains(t, out, "teardown-marker")
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := tests.NewGlobalTestState(t)
+		script := `
+export const options = { scenarios: {
+  a: { executor: 'constant-vus', vus: 1, duration: '1s' },
+  b: { executor: 'constant-vus', vus: 1, duration: '1s' },
+} };
+export default function () {}`
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "script.js"), []byte(script), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "script.js"}
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+
+		newRootCommand(ts.GlobalState).execute()
+
+		assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+	})
+
+	for _, flag := range []string{"--iterations=10", "--vus=2", "--duration=1s", "--stage=1s:1"} {
+		t.Run("conflicts with "+flag, func(t *testing.T) {
+			t.Parallel()
+			ts := tests.NewGlobalTestState(t)
+			require.NoError(t, fsext.WriteFile(
+				ts.FS, filepath.Join(ts.Cwd, "script.js"), []byte(`export default function () {}`), 0o644))
+			ts.CmdArgs = []string{"k6", "run", "--once", flag, "script.js"}
+			ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+
+			newRootCommand(ts.GlobalState).execute()
+
+			name := strings.SplitN(flag, "=", 2)[0]
+			assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with "+name)
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := tests.NewGlobalTestState(t)
+	script := `
+export const options = { scenarios: { sc: {
+  executor: 'ramping-vus', stages: [{ duration: '1m', target: 10 }],
+  exec: 'other', env: { FOO: 'bar' }, tags: { mytag: 'myvalue' },
+} } };
+export function other() {}`
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "script.js"), []byte(script), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "script.js"}
+
+	newRootCommand(ts.GlobalState).execute()
+	require.NoError(t, testutils.Untar(t, ts.FS, "archive.tar", "tmp/"))
+
+	data, err := fsext.ReadFile(ts.FS, "tmp/metadata.json")
+	require.NoError(t, err)
+	var metadata struct {
+		Options struct {
+			Scenarios map[string]map[string]any `json:"scenarios"`
+		} `json:"options"`
+	}
+	require.NoError(t, json.Unmarshal(data, &metadata))
+	require.Len(t, metadata.Options.Scenarios, 1)
+	sc := metadata.Options.Scenarios["sc"]
+	assert.Equal(t, "shared-iterations", sc["executor"])
+	assert.EqualValues(t, 1, sc["vus"])
+	assert.EqualValues(t, 1, sc["iterations"])
+	assert.Equal(t, "other", sc["exec"])
+	assert.Equal(t, map[string]any{"FOO": "bar"}, sc["env"])
+	assert.Equal(t, map[string]any{"mytag": "myvalue"}, sc["tags"])
+	assert.NotContains(t, sc, "stages")
+}
