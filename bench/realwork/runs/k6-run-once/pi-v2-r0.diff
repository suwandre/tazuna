+// onceIncompatibleFlags are the shortcut flags that can't be combined with --once.
+var onceIncompatibleFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// isOnceRequested reports whether the --once flag was set on the command, and returns an
+// error if it was combined with any of the execution shortcut flags.
+func isOnceRequested(cmd *cobra.Command) (bool, error) {
+	if cmd == nil {
+		return false, nil
+	}
+	flags := cmd.Flags()
+	if flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceIncompatibleFlags {
+		if flags.Lookup(name) != nil && flags.Changed(name) {
+			return false, fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+	return true, nil
+}
