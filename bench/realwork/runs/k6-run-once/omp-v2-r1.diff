new file mode 100644
index 0000000..e97da42
--- /dev/null
+++ b/internal/cmd/once.go
@@ -0,0 +1,86 @@
+package cmd
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/spf13/pflag"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/errext"
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+const onceFlagName = "once"
+
+// onceIncompatibleFlags are the execution shortcut flags that --once replaces.
+var onceIncompatibleFlags = [...]string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+var errOnceMultipleScenarios = errors.New("--once can run a single scenario only")
+
+// isOnce reports whether the --once flag is defined in the flag set and set to true.
+func isOnce(flags *pflag.FlagSet) bool {
+	if flags.Lookup(onceFlagName) == nil {
+		return false
+	}
+	once, err := flags.GetBool(onceFlagName)
+	return err == nil && once
+}
+
+// validateOnceFlags returns an error if --once was combined with any of the
+// execution shortcut flags.
+func validateOnceFlags(flags *pflag.FlagSet) error {
+	for _, name := range onceIncompatibleFlags {
+		if flags.Changed(name) {
+			return errext.WithExitCodeIfNone(
+				fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name),
+				exitcodes.InvalidConfig,
+			)
+		}
+	}
+	return nil
+}
+
+// applyOnce rewrites the execution configuration of the consolidated options so
+// the script runs with 1 VU and 1 iteration, while preserving the scenario
+// configuration that isn't related to the load profile (exec, env, tags and
+// scenario options, e.g. the browser ones).
+//
+// With no scenarios, the default function is run. With a single scenario,
+// its executor is replaced by a shared-iterations one. More than one scenario
+// is an error. The execution shortcuts (vus, iterations, duration, stages)
+// are discarded.
+func applyOnce(opts lib.Options) (lib.Options, error) {
+	scenario := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+
+	switch len(opts.Scenarios) {
+	case 0:
+	case 1:
+		for name, sc := range opts.Scenarios {
+			scenario.Name = name
+			scenario.Env = sc.GetEnv()
+			scenario.Tags = sc.GetTags()
+			scenario.Options = sc.GetScenarioOptions()
+			if exec := sc.GetExec(); exec != consts.DefaultFn {
+				scenario.Exec = null.StringFrom(exec)
+			}
+		}
+	default:
+		return opts, errext.WithExitCodeIfNone(errOnceMultipleScenarios, exitcodes.InvalidConfig)
+	}
+
+	scenario.VUs = null.IntFrom(1)
+	scenario.Iterations = null.IntFrom(1)
+
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	opts.Scenarios = lib.ScenarioConfigs{scenario.Name: scenario}
+
+	return opts, nil
+}
diff --git a/internal/cmd/once_test.go b/internal/cmd/once_test.go
new file mode 100644
index 0000000..d7d9c51
--- /dev/null
+++ b/internal/cmd/once_test.go
@@ -0,0 +1,237 @@
+package cmd
+
+import (
+	"encoding/json"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/errext"
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd/tests"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/fsext"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios runs the default function once", func(t *testing.T) {
+		t.Parallel()
+
+		opts, err := applyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second)}},
+		})
+		require.NoError(t, err)
+
+		assert.Equal(t, lib.Options{Scenarios: lib.ScenarioConfigs{
+			lib.DefaultScenarioName: onceScenario(lib.DefaultScenarioName),
+		}}, opts)
+	})
+
+	t.Run("single scenario keeps exec, env, tags and options", func(t *testing.T) {
+		t.Parallel()
+
+		original := executor.NewConstantVUsConfig("api")
+		original.VUs = null.IntFrom(20)
+		original.Duration = types.NullDurationFrom(time.Hour)
+		original.StartTime = types.NullDurationFrom(time.Minute)
+		original.GracefulStop = types.NullDurationFrom(time.Minute)
+		original.Exec = null.StringFrom("apiFn")
+		original.Env = map[string]string{"A": "b"}
+		original.Tags = map[string]string{"c": "d"}
+		original.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+
+		opts, err := applyOnce(lib.Options{
+			Scenarios: lib.ScenarioConfigs{"api": original},
+			VUs:       null.IntFrom(3),
+		})
+		require.NoError(t, err)
+
+		expected := onceScenario("api")
+		expected.Exec = null.StringFrom("apiFn")
+		expected.Env = original.Env
+		expected.Tags = original.Tags
+		expected.Options = original.Options
+		assert.Equal(t, lib.Options{Scenarios: lib.ScenarioConfigs{"api": expected}}, opts)
+	})
+
+	t.Run("single scenario with the default exec does not set it explicitly", func(t *testing.T) {
+		t.Parallel()
+
+		original := executor.NewRampingVUsConfig("ramp")
+		original.Exec = null.StringFrom("default")
+
+		opts, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"ramp": original}})
+		require.NoError(t, err)
+		assert.Equal(t, onceScenario("ramp"), opts.Scenarios["ramp"])
+	})
+
+	t.Run("multiple scenarios are rejected", func(t *testing.T) {
+		t.Parallel()
+
+		_, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": executor.NewPerVUIterationsConfig("a"),
+			"b": executor.NewPerVUIterationsConfig("b"),
+		}})
+		require.ErrorIs(t, err, errOnceMultipleScenarios)
+
+		var withCode errext.HasExitCode
+		require.ErrorAs(t, err, &withCode)
+		assert.Equal(t, exitcodes.InvalidConfig, withCode.ExitCode())
+	})
+}
+
+func onceScenario(name string) executor.SharedIterationsConfig {
+	sc := executor.NewSharedIterationsConfig(name)
+	sc.VUs = null.IntFrom(1)
+	sc.Iterations = null.IntFrom(1)
+	return sc
+}
+
+const onceTestScript = `
+	export const options = {
+		vus: 7,
+		iterations: 70,
+	};
+
+	export function setup() { console.log('setup-ran'); }
+	export function teardown() { console.log('teardown-ran'); }
+	export default function () { console.log('default-ran'); }
+`
+
+const onceScenarioTestScript = `
+	export const options = {
+		scenarios: {
+			api: {
+				executor: 'constant-vus',
+				vus: 5,
+				duration: '1h',
+				exec: 'api',
+				env: { GREETING: 'hello' },
+				tags: { team: 'blue' },
+			},
+		},
+	};
+
+	export function setup() { console.log('setup-ran'); }
+	export function teardown() { console.log('teardown-ran'); }
+	export function api() { console.log('api-ran ' + __ENV.GREETING); }
+`
+
+func runOnceTest(t *testing.T, script string, args ...string) *tests.GlobalTestState {
+	t.Helper()
+
+	ts := tests.NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "script.js"), []byte(script), 0o644))
+	ts.CmdArgs = append(append([]string{"k6"}, args...), "script.js")
+	return ts
+}
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("default function", func(t *testing.T) {
+		t.Parallel()
+
+		ts := runOnceTest(t, onceTestScript, "run", "--once", "--log-output=stdout")
+		newRootCommand(ts.GlobalState).execute()
+
+		stdout := ts.Stdout.String()
+		assert.Equal(t, 1, strings.Count(stdout, "default-ran"), stdout)
+		assert.Equal(t, 1, strings.Count(stdout, "setup-ran"), stdout)
+		assert.Equal(t, 1, strings.Count(stdout, "teardown-ran"), stdout)
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		ts := runOnceTest(t, onceScenarioTestScript, "run", "--once", "--log-output=stdout", "--out", "json=results.json")
+		newRootCommand(ts.GlobalState).execute()
+
+		stdout := ts.Stdout.String()
+		assert.Equal(t, 1, strings.Count(stdout, "api-ran hello"), stdout)
+		assert.Equal(t, 1, strings.Count(stdout, "setup-ran"), stdout)
+		assert.Equal(t, 1, strings.Count(stdout, "teardown-ran"), stdout)
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+
+		results, err := fsext.ReadFile(ts.FS, "results.json")
+		require.NoError(t, err)
+		assert.Contains(t, string(results), `"scenario":"api"`)
+		assert.Contains(t, string(results), `"team":"blue"`)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		script := `
+			export const options = { scenarios: {
+				a: { executor: 'per-vu-iterations' },
+				b: { executor: 'per-vu-iterations' },
+			} };
+			export default function () {}
+		`
+		ts := runOnceTest(t, script, "run", "--once")
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+		newRootCommand(ts.GlobalState).execute()
+
+		assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+	})
+
+	for _, flag := range []string{"--iterations=10", "--vus=2", "--duration=1s", "--stage=1s:2"} {
+		t.Run("incompatible with "+flag, func(t *testing.T) {
+			t.Parallel()
+
+			ts := runOnceTest(t, onceTestScript, "run", "--once", flag)
+			ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+			newRootCommand(ts.GlobalState).execute()
+
+			name, _, _ := strings.Cut(flag, "=")
+			assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with "+name)
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := runOnceTest(t, onceScenarioTestScript, "archive", "--once")
+	newRootCommand(ts.GlobalState).execute()
+	require.NoError(t, testutils.Untar(t, ts.FS, "archive.tar", "tmp/"))
+
+	data, err := fsext.ReadFile(ts.FS, "tmp/metadata.json")
+	require.NoError(t, err)
+
+	var metadata struct {
+		Options struct {
+			VUs        *int64                    `json:"vus"`
+			Iterations *int64                    `json:"iterations"`
+			Scenarios  map[string]map[string]any `json:"scenarios"`
+		} `json:"options"`
+	}
+	require.NoError(t, json.Unmarshal(data, &metadata))
+
+	assert.Nil(t, metadata.Options.VUs)
+	assert.Nil(t, metadata.Options.Iterations)
+	require.Len(t, metadata.Options.Scenarios, 1)
+	api := metadata.Options.Scenarios["api"]
+	assert.Equal(t, "shared-iterations", api["executor"])
+	assert.EqualValues(t, 1, api["vus"])
+	assert.EqualValues(t, 1, api["iterations"])
+	assert.Equal(t, "api", api["exec"])
+	assert.Equal(t, map[string]any{"GREETING": "hello"}, api["env"])
+	assert.Equal(t, map[string]any{"team": "blue"}, api["tags"])
+	assert.NotContains(t, api, "duration")
+}
