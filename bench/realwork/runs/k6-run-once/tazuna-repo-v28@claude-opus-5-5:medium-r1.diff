+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		conf := Config{Options: lib.Options{
+			VUs:      null.IntFrom(10),
+			Duration: types.NullDurationFrom(30 * time.Second),
+		}}
+		result, err := applyOnce(conf)
+		require.NoError(t, err)
+
+		assert.False(t, result.VUs.Valid)
+		assert.False(t, result.Duration.Valid)
+		require.Len(t, result.Scenarios, 1)
+		sc, ok := result.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+
+		derived, err := deriveAndValidateConfig(result, func(string) bool { return true }, nil)
+		require.NoError(t, err)
+		assert.Equal(t, result.Scenarios, derived.Scenarios)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		ramping := executor.NewRampingVUsConfig("browser")
+		ramping.Exec = null.StringFrom("browserTest")
+		ramping.Env = map[string]string{"FOO": "bar"}
+		ramping.Tags = map[string]string{"type": "ui"}
+		ramping.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		ramping.StartTime = types.NullDurationFrom(time.Minute)
+		ramping.Stages = []executor.Stage{{Duration: types.NullDurationFrom(time.Minute), Target: null.IntFrom(50)}}
+
+		conf := Config{Options: lib.Options{
+			Iterations: null.IntFrom(5),
+			Scenarios:  lib.ScenarioConfigs{"browser": ramping},
+		}}
+		result, err := applyOnce(conf)
+		require.NoError(t, err)
+
+		assert.False(t, result.Iterations.Valid)
+		require.Len(t, result.Scenarios, 1)
+		sc, ok := result.Scenarios["browser"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "browser", sc.Name)
+		assert.Equal(t, "browserTest", sc.GetExec())
+		assert.Equal(t, map[string]string{"FOO": "bar"}, sc.Env)
+		assert.Equal(t, map[string]string{"type": "ui"}, sc.Tags)
+		assert.Equal(t, ramping.Options, sc.Options)
+		assert.False(t, sc.StartTime.Valid)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+
+		derived, err := deriveAndValidateConfig(result, func(string) bool { return true }, nil)
+		require.NoError(t, err)
+		assert.Equal(t, result.Scenarios, derived.Scenarios)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		conf := Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": executor.NewSharedIterationsConfig("a"),
+			"b": executor.NewSharedIterationsConfig("b"),
+		}}}
+		_, err := applyOnce(conf)
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+		var ecerr errext.HasExitCode
+		require.ErrorAs(t, err, &ecerr)
+		assert.Equal(t, exitcodes.InvalidConfig, ecerr.ExitCode())
+	})
+}
+
+func TestCheckOnceFlagConflicts(t *testing.T) {
+	t.Parallel()
+
+	for _, args := range [][]string{
+		{"--iterations", "10"}, {"--vus", "2"}, {"--duration", "10s"}, {"--stage", "10s:5"},
+	} {
+		t.Run(args[0], func(t *testing.T) {
+			t.Parallel()
+			flags := optionFlagSet()
+			require.NoError(t, flags.Parse(append([]string{"--once"}, args...)))
+			err := checkOnceFlagConflicts(flags)
+			require.ErrorContains(t, err, "--once cannot be combined with "+args[0])
+		})
+	}
+
+	flags := optionFlagSet()
+	require.NoError(t, flags.Parse([]string{"--once", "--no-setup"}))
+	require.NoError(t, checkOnceFlagConflicts(flags))
+}
