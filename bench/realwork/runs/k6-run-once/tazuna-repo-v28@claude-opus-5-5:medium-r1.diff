+package tests
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	testCases := []struct {
+		name        string
+		script      string
+		args        []string
+		expExitCode exitcodes.ExitCode
+		expStdout   []string
+		expLog      string
+		expStderr   []string
+	}{
+		{
+			name: "no scenarios",
+			script: `
+				export const options = { vus: 10, duration: '1m' };
+				export function setup() { console.log('setup ran'); }
+				export default function() { console.log('default ran'); }
+				export function teardown() { console.log('teardown ran'); }
+			`,
+			expStdout: []string{
+				"default: 1 iterations shared among 1 VUs",
+				"1 complete and 0 interrupted iterations",
+			},
+			expStderr: []string{"setup ran", "default ran", "teardown ran"},
+		},
+		{
+			name: "single scenario",
+			script: `
+				import { check } from 'k6';
+				import exec from 'k6/execution';
+				export const options = {
+					scenarios: {
+						myscenario: {
+							executor: 'constant-vus', vus: 5, duration: '1m', startTime: '10s',
+							exec: 'myexec', env: { FOO: 'bar' }, tags: { mytag: 'myvalue' },
+						},
+					},
+					thresholds: { 'checks{mytag:myvalue}': ['rate==1'] },
+				};
+				export function myexec() {
+					check(null, {
+						'env preserved': () => __ENV.FOO === 'bar',
+						'tag preserved': () => exec.vu.metrics.tags.mytag === 'myvalue',
+						'scenario name preserved': () => exec.scenario.name === 'myscenario',
+					});
+				}
+			`,
+			expStdout: []string{
+				"myscenario: 1 iterations shared among 1 VUs",
+				"exec: myexec",
+				"1 complete and 0 interrupted iterations",
+			},
+		},
+		{
+			name: "multiple scenarios",
+			script: `
+				export const options = {
+					scenarios: {
+						a: { executor: 'shared-iterations' },
+						b: { executor: 'shared-iterations' },
+					},
+				};
+				export default function() {}
+			`,
+			expExitCode: exitcodes.InvalidConfig,
+			expLog:      "--once can run a single scenario only",
+		},
+		{
+			name:        "combined with iterations",
+			script:      `export default function() {}`,
+			args:        []string{"--iterations", "10"},
+			expExitCode: exitcodes.InvalidConfig,
+			expLog:      "--once cannot be combined with --iterations",
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+
+			ts := NewGlobalTestState(t)
+			require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "script.js"), []byte(tc.script), 0o644))
+			ts.CmdArgs = append([]string{"k6", "run", "--once", "script.js"}, tc.args...)
+			ts.ExpectedExitCode = int(tc.expExitCode)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			stdout := ts.Stdout.String()
+			for _, s := range tc.expStdout {
+				assert.Contains(t, stdout, s)
+			}
+			for _, s := range tc.expStderr {
+				assert.Contains(t, ts.Stderr.String(), s)
+			}
+			if tc.expLog != "" {
+				assert.Contains(t, ts.Stderr.String(), tc.expLog)
+			}
+			if tc.expExitCode == 0 {
+				assert.NotContains(t, stdout, "✗")
+			}
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	script := `
+		export const options = {
+			scenarios: { s: { executor: 'constant-vus', vus: 5, duration: '1m', exec: 'fn' } },
+		};
+		export function fn() {}
+	`
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "script.js"), []byte(script), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "script.js"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	require.NoError(t, testutils.Untar(t, ts.FS, "archive.tar", "tmp/"))
+	data, err := fsext.ReadFile(ts.FS, "tmp/metadata.json")
+	require.NoError(t, err)
+
+	scenarios := gjson.GetBytes(data, "options.scenarios").Map()
+	require.Len(t, scenarios, 1)
+	assert.Equal(t, "shared-iterations", scenarios["s"].Get("executor").String())
+	assert.Equal(t, "fn", scenarios["s"].Get("exec").String())
+	assert.Equal(t, int64(1), scenarios["s"].Get("vus").Int())
+	assert.Equal(t, int64(1), scenarios["s"].Get("iterations").Int())
+}
