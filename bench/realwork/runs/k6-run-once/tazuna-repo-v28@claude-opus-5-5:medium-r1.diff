@@ -328,6 +328,58 @@ func deriveAndValidateConfig(
 	return result, errext.WithExitCodeIfNone(err, exitcodes.InvalidConfig)
 }
 
+// onceConflictingFlags are the execution shortcut flags that can't be combined with --once.
+var onceConflictingFlags = []string{"vus", "duration", "iterations", "stage"} //nolint:gochecknoglobals
+
+// checkOnceFlagConflicts returns an error if --once is combined with any execution shortcut flag.
+func checkOnceFlagConflicts(flags *pflag.FlagSet) error {
+	for _, name := range onceConflictingFlags {
+		if flags.Lookup(name) != nil && flags.Changed(name) {
+			return errext.WithExitCodeIfNone(
+				fmt.Errorf("--once cannot be combined with --%s", name), exitcodes.InvalidConfig)
+		}
+	}
+	return nil
+}
+
+// applyOnce transforms an already consolidated config, so that the test runs with exactly 1 VU
+// and 1 iteration. The exec function, env, tags and scenario options (e.g. browser) of the single
+// scenario are preserved, while its executor is replaced with a shared-iterations one. All the
+// execution shortcut options (vus, iterations, duration, stages) are discarded.
+//
+// It must be applied after the config consolidation, so the transformed scenario can't be merged
+// with the scenarios from other config layers.
+func applyOnce(conf Config) (Config, error) {
+	if len(conf.Scenarios) > 1 {
+		return conf, errext.WithExitCodeIfNone(
+			fmt.Errorf("--once can run a single scenario only, but the script defines %d scenarios",
+				len(conf.Scenarios)),
+			exitcodes.InvalidConfig,
+		)
+	}
+
+	sc := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	for name, ec := range conf.Scenarios {
+		sc.Name = name
+		sc.Env = ec.GetEnv()
+		if exec := ec.GetExec(); exec != "" {
+			sc.Exec = null.StringFrom(exec)
+		}
+		sc.Tags = ec.GetTags()
+		sc.Options = ec.GetScenarioOptions()
+	}
+	sc.VUs = null.IntFrom(1)
+	sc.Iterations = null.IntFrom(1)
+
+	conf.VUs = null.Int{}
+	conf.Iterations = null.Int{}
+	conf.Duration = types.NullDuration{}
+	conf.Stages = nil
+	conf.Scenarios = lib.ScenarioConfigs{sc.Name: sc}
+
+	return conf, nil
+}
