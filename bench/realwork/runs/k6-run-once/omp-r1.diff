@@ -0,0 +1,80 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios discards shortcuts", func(t *testing.T) {
+		t.Parallel()
+		opts, err := ApplyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second)}},
+		})
+		require.NoError(t, err)
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		assert.Nil(t, opts.Stages)
+
+		require.Len(t, opts.Scenarios, 1)
+		sic, ok := opts.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sic.VUs)
+		assert.Equal(t, null.IntFrom(1), sic.Iterations)
+		assert.False(t, sic.Exec.Valid)
+		assert.Empty(t, sic.Validate())
+	})
+
+	t.Run("single scenario keeps identity, drops the rest", func(t *testing.T) {
+		t.Parallel()
+		cvus := NewConstantVUsConfig("mine")
+		cvus.VUs = null.IntFrom(7)
+		cvus.Duration = types.NullDurationFrom(time.Hour)
+		cvus.StartTime = types.NullDurationFrom(time.Minute)
+		cvus.GracefulStop = types.NullDurationFrom(time.Minute)
+		cvus.Exec = null.StringFrom("fn")
+		cvus.Env = map[string]string{"A": "b"}
+		cvus.Tags = map[string]string{"c": "d"}
+		cvus.Options = &lib.ScenarioOptions{}
+
+		opts, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"mine": cvus}})
+		require.NoError(t, err)
+
+		require.Len(t, opts.Scenarios, 1)
+		sic, ok := opts.Scenarios["mine"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "mine", sic.Name)
+		assert.Equal(t, sharedIterationsType, sic.Type)
+		assert.Equal(t, null.StringFrom("fn"), sic.Exec)
+		assert.Equal(t, cvus.Env, sic.Env)
+		assert.Equal(t, cvus.Tags, sic.Tags)
+		assert.Same(t, cvus.Options, sic.Options)
+		assert.Equal(t, null.IntFrom(1), sic.VUs)
+		assert.Equal(t, null.IntFrom(1), sic.Iterations)
+		assert.False(t, sic.StartTime.Valid)
+		assert.False(t, sic.GracefulStop.Valid)
+		assert.False(t, sic.MaxDuration.Valid)
+	})
+
+	t.Run("multiple scenarios fail", func(t *testing.T) {
+		t.Parallel()
+		_, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": NewSharedIterationsConfig("a"),
+			"b": NewSharedIterationsConfig("b"),
+		}})
+		require.ErrorIs(t, err, ErrOnceMultipleScenarios)
+	})
+}
