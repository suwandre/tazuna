+// onceIncompatibleFlags are the shortcut flags that define the execution shape and thus can't be
+// combined with --once.
+var onceIncompatibleFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// isOnceSet returns whether the --once flag was set, and an error if it was combined with any of
+// the execution shortcut flags. Flag sets without the --once flag are treated as not setting it.
+func isOnceSet(flags *pflag.FlagSet) (bool, error) {
+	if flags == nil || flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range onceIncompatibleFlags {
+		if flags.Changed(name) {
+			return false, errext.WithExitCodeIfNone(
+				fmt.Errorf("--once cannot be combined with --%s", name), exitcodes.InvalidConfig)
+		}
+	}
+	return true, nil
+}
