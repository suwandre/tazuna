+package tests
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func TestOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = { vus: 5, duration: '1m' };
+		export function setup() { console.log('setup-ran'); }
+		export default function () { console.log('default-ran'); }
+		export function teardown() { console.log('teardown-ran'); }
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout", "--out", "json=results.json"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Equal(t, 1, strings.Count(stdout, "default-ran"))
+	assert.Equal(t, 1, strings.Count(stdout, "setup-ran"))
+	assert.Equal(t, 1, strings.Count(stdout, "teardown-ran"))
+
+	jsonResults, err := fsext.ReadFile(ts.FS, "results.json")
+	require.NoError(t, err)
+	assert.Equal(t, float64(1), sum(getSampleValues(t, jsonResults, "iterations", map[string]string{"scenario": "default"})))
+}
+
+func TestOnceSingleScenarioPreservesConfig(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				mine: {
+					executor: 'constant-vus',
+					vus: 10,
+					duration: '1h',
+					startTime: '1h',
+					exec: 'other',
+					env: { FOO: 'bar' },
+					tags: { custom: 'tag' },
+				},
+			},
+		};
+		export function other() { console.log('other-ran ' + __ENV.FOO); }
+		export default function () { console.log('default-ran'); }
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once", "--log-output=stdout", "--out", "json=results.json"}, 0)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Equal(t, 1, strings.Count(stdout, "other-ran bar"))
+	assert.Equal(t, 0, strings.Count(stdout, "default-ran"))
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+
+	jsonResults, err := fsext.ReadFile(ts.FS, "results.json")
+	require.NoError(t, err)
+	tags := map[string]string{"scenario": "mine", "custom": "tag"}
+	assert.Equal(t, float64(1), sum(getSampleValues(t, jsonResults, "iterations", tags)))
+}
+
+func TestOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				a: { executor: 'shared-iterations' },
+				b: { executor: 'shared-iterations' },
+			},
+		};
+		export default function () {}
+	`
+	ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.True(t, testutils.LogContains(ts.LoggerHook.Drain(), logrus.ErrorLevel, "--once can run a single scenario only"))
+}
+
+func TestOnceCombinedWithShortcutFlags(t *testing.T) {
+	t.Parallel()
+
+	for flag, args := range map[string][]string{
+		"vus":        {"--vus", "2"},
+		"iterations": {"--iterations", "10"},
+		"duration":   {"--duration", "10s"},
+		"stage":      {"--stage", "10s:5"},
+	} {
+		t.Run(flag, func(t *testing.T) {
+			t.Parallel()
+
+			ts := getSingleFileTestState(t, `export default function () {}`,
+				append([]string{"--once"}, args...), exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.True(t, testutils.LogContains(ts.LoggerHook.Drain(), logrus.ErrorLevel,
+				"--once cannot be combined with --"+flag))
+		})
+	}
+}
diff --git a/lib/executor/once.go b/lib/executor/once.go
new file mode 100644
index 0000000..e7b7f8b
--- /dev/null
+++ b/lib/executor/once.go
@@ -0,0 +1,48 @@
+package executor
+
+import (
+	"errors"
+
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+// ErrOnceMultipleScenarios is returned by ApplyOnce when more than one scenario is configured.
+var ErrOnceMultipleScenarios = errors.New("--once can run a single scenario only")
+
+// ApplyOnce turns the provided consolidated options into a single run: one VU executing one
+// iteration. If there is no scenario configured, the default one is created. If there is exactly
+// one scenario, its executor is replaced with a shared-iterations one that keeps the scenario's
+// name, exec, env, tags and options, and drops every other field. The shortcut options (vus,
+// iterations, duration and stages) are discarded as well.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ErrOnceMultipleScenarios
+	}
+
+	name := lib.DefaultScenarioName
+	sic := NewSharedIterationsConfig(name)
+	for scenarioName, sc := range opts.Scenarios {
+		name = scenarioName
+		sic = NewSharedIterationsConfig(name)
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			sic.Exec = null.StringFrom(exec)
+		}
+		sic.Env = sc.GetEnv()
+		sic.Tags = sc.GetTags()
+		sic.Options = sc.GetScenarioOptions()
+	}
+	sic.VUs = null.IntFrom(1)
+	sic.Iterations = null.IntFrom(1)
+
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	opts.Scenarios = lib.ScenarioConfigs{name: sic}
+
+	return opts, nil
+}
