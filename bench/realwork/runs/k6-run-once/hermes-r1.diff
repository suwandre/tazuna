diff --git a/internal/cmd/once.go b/internal/cmd/once.go
new file mode 100644
index 0000000..e839400
--- /dev/null
+++ b/internal/cmd/once.go
@@ -0,0 +1,55 @@
+package cmd
+
+import (
+	"fmt"
+
+	"github.com/spf13/pflag"
+
+	"go.k6.io/k6/v2/errext"
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+)
+
+const onceFlagName = "once"
+
+// onceIncompatibleFlags are the shortcut flags that can't be combined with --once.
+var onceIncompatibleFlags = []string{"vus", "duration", "iterations", "stage"} //nolint:gochecknoglobals
+
+func onceFlagSet() *pflag.FlagSet {
+	flags := pflag.NewFlagSet("", pflag.ContinueOnError)
+	flags.SortFlags = false
+	flags.Bool(onceFlagName, false,
+		"run the script once, with 1 VU and 1 iteration, preserving the scenario configuration (if any)")
+	return flags
+}
+
+// applyOnceFlag applies the --once flag, if it's set, to the consolidated options.
+// It has to be called after the config layers were consolidated.
+func applyOnceFlag(flags *pflag.FlagSet, opts lib.Options) (lib.Options, error) {
+	if flags == nil || flags.Lookup(onceFlagName) == nil {
+		return opts, nil
+	}
+	once, err := flags.GetBool(onceFlagName)
+	if err != nil {
+		return opts, err
+	}
+	if !once {
+		return opts, nil
+	}
+
+	for _, name := range onceIncompatibleFlags {
+		if flags.Changed(name) {
+			return opts, errext.WithExitCodeIfNone(
+				fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name),
+				exitcodes.InvalidConfig,
+			)
+		}
+	}
+
+	opts, err = executor.ApplyOnce(opts)
+	if err != nil {
+		return opts, errext.WithExitCodeIfNone(err, exitcodes.InvalidConfig)
+	}
+	return opts, nil
+}
