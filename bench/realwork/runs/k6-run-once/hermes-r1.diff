@@ -0,0 +1,103 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts, err := ApplyOnce(lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NullDurationFrom(time.Minute),
+			Stages:     []lib.Stage{{Duration: types.NullDurationFrom(time.Second)}},
+		})
+		require.NoError(t, err)
+
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		assert.Nil(t, opts.Stages)
+
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, lib.DefaultScenarioName, sc.Name)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.False(t, sc.Exec.Valid)
+		assert.Empty(t, sc.Validate())
+
+		// The result must be left untouched by DeriveScenariosFromShortcuts.
+		derived, err := DeriveScenariosFromShortcuts(opts, logrus.New())
+		require.NoError(t, err)
+		assert.Equal(t, opts.Scenarios, derived.Scenarios)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+
+		orig := NewRampingVUsConfig("my_scenario")
+		orig.Exec = null.StringFrom("myFunc")
+		orig.Env = map[string]string{"A": "b"}
+		orig.Tags = map[string]string{"c": "d"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		orig.StartTime = types.NullDurationFrom(10 * time.Second)
+		orig.StartVUs = null.IntFrom(5)
+		orig.Stages = []Stage{{Duration: types.NullDurationFrom(time.Minute), Target: null.IntFrom(10)}}
+
+		opts, err := ApplyOnce(lib.Options{
+			Scenarios: lib.ScenarioConfigs{"my_scenario": orig},
+		})
+		require.NoError(t, err)
+
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios["my_scenario"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "my_scenario", sc.Name)
+		assert.Equal(t, sharedIterationsType, sc.Type)
+		assert.Equal(t, "myFunc", sc.Exec.String)
+		assert.Equal(t, map[string]string{"A": "b"}, sc.Env)
+		assert.Equal(t, map[string]string{"c": "d"}, sc.Tags)
+		assert.Equal(t, orig.Options, sc.Options)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.Zero(t, sc.StartTime.Duration)
+		assert.Empty(t, sc.Validate())
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		_, err := ApplyOnce(lib.Options{
+			Scenarios: lib.ScenarioConfigs{
+				"a": NewPerVUIterationsConfig("a"),
+				"b": NewPerVUIterationsConfig("b"),
+			},
+		})
+		require.Error(t, err)
+		assert.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+
+	t.Run("explicitly empty scenarios", func(t *testing.T) {
+		t.Parallel()
+
+		opts, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{}})
+		require.NoError(t, err)
+		require.Len(t, opts.Scenarios, 1)
+		assert.Contains(t, opts.Scenarios, lib.DefaultScenarioName)
+	})
+}
