diff --git a/internal/cmd/tests/cmd_run_once_test.go b/internal/cmd/tests/cmd_run_once_test.go
new file mode 100644
index 0000000..eacb767
--- /dev/null
+++ b/internal/cmd/tests/cmd_run_once_test.go
@@ -0,0 +1,163 @@
+package tests
+
+import (
+	"archive/tar"
+	"bytes"
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func TestRunOnceNoScenarios(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `
+		export const options = { vus: 5, iterations: 20 };
+		export function setup() { console.log("setup-ran"); }
+		export function teardown() { console.log("teardown-ran"); }
+		export default function () { console.log("default-ran"); }
+	`, []string{"--once", "--log-output=stdout", "--no-usage-report"}, 0)
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Contains(t, stdout, "setup-ran")
+	assert.Contains(t, stdout, "teardown-ran")
+	assert.Equal(t, 1, countOccurrences(stdout, "default-ran"))
+}
+
+func TestRunOnceSingleScenarioPreservesConfig(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `
+		import exec from 'k6/execution';
+		export const options = {
+			scenarios: {
+				my_scenario: {
+					executor: 'constant-vus',
+					vus: 5,
+					duration: '1m',
+					exec: 'other',
+					env: { FOO: 'bar' },
+					tags: { mytag: 'myvalue' },
+				},
+			},
+		};
+		export function other() {
+			console.log("other-ran", __ENV.FOO, exec.scenario.name);
+		}
+		export default function () { console.log("default-ran"); }
+	`, []string{"--once", "--log-output=stdout", "--no-usage-report", "--out", "json=results.json"}, 0)
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	stdout := ts.Stdout.String()
+	assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+	assert.Equal(t, 1, countOccurrences(stdout, "other-ran bar my_scenario"))
+	assert.NotContains(t, stdout, "default-ran")
+
+	results, err := fsext.ReadFile(ts.FS, "results.json")
+	require.NoError(t, err)
+	samples := getSampleValues(t, results, "iterations", map[string]string{"mytag": "myvalue"})
+	assert.Equal(t, 1.0, sum(samples))
+}
+
+func TestRunOnceMultipleScenarios(t *testing.T) {
+	t.Parallel()
+
+	ts := getSingleFileTestState(t, `
+		export const options = {
+			scenarios: {
+				a: { executor: 'per-vu-iterations' },
+				b: { executor: 'per-vu-iterations' },
+			},
+		};
+		export default function () {}
+	`, []string{"--once", "--no-usage-report"}, exitcodes.InvalidConfig)
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+}
+
+func TestRunOnceIncompatibleFlags(t *testing.T) {
+	t.Parallel()
+
+	for _, flag := range [][]string{
+		{"--iterations", "10"}, {"--vus", "2"}, {"--duration", "10s"}, {"--stage", "10s:5"},
+	} {
+		t.Run(flag[0], func(t *testing.T) {
+			t.Parallel()
+
+			args := append([]string{"--once", "--no-usage-report"}, flag...)
+			ts := getSingleFileTestState(t, `export default function () {}`, args, exitcodes.InvalidConfig)
+
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with "+flag[0])
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, ts.Cwd+"/test.js", []byte(`
+		export const options = {
+			scenarios: { s: { executor: 'constant-vus', vus: 5, duration: '1m', exec: 'other' } },
+		};
+		export function other() {}
+	`), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", "archive.tar", "test.js"}
+
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	data, err := fsext.ReadFile(ts.FS, "archive.tar")
+	require.NoError(t, err)
+
+	var metadata struct {
+		Options struct {
+			VUs       *int64                    `json:"vus"`
+			Duration  *string                   `json:"duration"`
+			Scenarios map[string]map[string]any `json:"scenarios"`
+		} `json:"options"`
+	}
+	tr := tar.NewReader(bytes.NewReader(data))
+	for {
+		hdr, err := tr.Next()
+		require.NoError(t, err, "metadata.json not found in the archive")
+		if hdr.Name != "metadata.json" {
+			continue
+		}
+		require.NoError(t, json.NewDecoder(tr).Decode(&metadata))
+		break
+	}
+
+	assert.Nil(t, metadata.Options.VUs)
+	assert.Nil(t, metadata.Options.Duration)
+	require.Len(t, metadata.Options.Scenarios, 1)
+	sc := metadata.Options.Scenarios["s"]
+	assert.Equal(t, "shared-iterations", sc["executor"])
+	assert.Equal(t, "other", sc["exec"])
+	assert.EqualValues(t, 1, sc["vus"])
+	assert.EqualValues(t, 1, sc["iterations"])
+}
+
+func countOccurrences(s, substr string) int {
+	n := 0
+	for i := 0; i+len(substr) <= len(s); i++ {
+		if s[i:i+len(substr)] == substr {
+			n++
+		}
+	}
+	return n
+}
diff --git a/lib/executor/execution_config_once.go b/lib/executor/execution_config_once.go
new file mode 100644
index 0000000..306a4e4
--- /dev/null
+++ b/lib/executor/execution_config_once.go
@@ -0,0 +1,53 @@
+package executor
+
+import (
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+// ApplyOnce transforms the given options so the script runs a single scenario
+// with 1 VU and 1 iteration. It is the implementation of the `--once` flag.
+//
+// If no scenarios are defined, the default scenario (running the default
+// exported function) is used. If exactly one scenario is defined, it is
+// replaced by a shared-iterations executor that keeps only the scenario's
+// exec, env, tags and scenario options (e.g. browser options). Everything else
+// in the scenario is discarded, as are the vus, iterations, duration and
+// stages shortcut options. More than one scenario is an error.
+//
+// This must be applied after all the config layers have been consolidated, so
+// that it is not affected by any of them.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ExecutionConflictError("--once can run a single scenario only")
+	}
+
+	name := lib.DefaultScenarioName
+	once := NewSharedIterationsConfig(name)
+
+	for scenarioName, sc := range opts.Scenarios {
+		name = scenarioName
+		once = NewSharedIterationsConfig(name)
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			once.Exec = null.StringFrom(exec)
+		}
+		once.Env = sc.GetEnv()
+		once.Tags = sc.GetTags()
+		once.Options = sc.GetScenarioOptions()
+	}
+
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	result := opts
+	result.Scenarios = lib.ScenarioConfigs{name: once}
+	result.VUs = null.Int{}
+	result.Iterations = null.Int{}
+	result.Duration = types.NullDuration{}
+	result.Stages = nil
+
+	return result, nil
+}
