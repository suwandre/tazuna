@@ -0,0 +1,130 @@
+package cmd
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/errext"
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts, err := applyOnce(lib.Options{
+			VUs:      null.IntFrom(10),
+			Duration: types.NullDurationFrom(30_000_000_000),
+			Stages:   []lib.Stage{{Duration: types.NullDurationFrom(1), Target: null.IntFrom(5)}},
+		})
+		require.NoError(t, err)
+
+		assert.False(t, opts.VUs.Valid)
+		assert.False(t, opts.Iterations.Valid)
+		assert.False(t, opts.Duration.Valid)
+		assert.Nil(t, opts.Stages)
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.False(t, sc.Exec.Valid)
+
+		// The derivation must keep the transformed scenario as is.
+		derived, err := executor.DeriveScenariosFromShortcuts(opts, nil)
+		require.NoError(t, err)
+		assert.Equal(t, opts.Scenarios, derived.Scenarios)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		orig := executor.NewRampingVUsConfig("browser")
+		orig.Exec = null.StringFrom("browserTest")
+		orig.Env = map[string]string{"FOO": "bar"}
+		orig.Tags = map[string]string{"type": "browser"}
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		orig.StartTime = types.NullDurationFrom(10_000_000_000)
+		orig.Stages = []executor.Stage{{Duration: types.NullDurationFrom(1), Target: null.IntFrom(50)}}
+
+		opts, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"browser": orig}})
+		require.NoError(t, err)
+
+		require.Len(t, opts.Scenarios, 1)
+		sc, ok := opts.Scenarios["browser"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "browser", sc.Name)
+		assert.Equal(t, null.IntFrom(1), sc.VUs)
+		assert.Equal(t, null.IntFrom(1), sc.Iterations)
+		assert.Equal(t, null.StringFrom("browserTest"), sc.Exec)
+		assert.Equal(t, orig.Env, sc.Env)
+		assert.Equal(t, orig.Tags, sc.Tags)
+		assert.Equal(t, orig.Options, sc.Options)
+		assert.False(t, sc.StartTime.Valid)
+		assert.Empty(t, sc.Validate())
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := applyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": executor.NewPerVUIterationsConfig("a"),
+			"b": executor.NewPerVUIterationsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
+
+func TestApplyOnceFlag(t *testing.T) {
+	t.Parallel()
+
+	conf := Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{
+		"a": executor.NewConstantVUsConfig("a"),
+	}}}
+
+	t.Run("not set", func(t *testing.T) {
+		t.Parallel()
+		flags := optionFlagSet()
+		require.NoError(t, flags.Parse([]string{}))
+		got, err := applyOnceFlag(flags, conf)
+		require.NoError(t, err)
+		assert.Equal(t, conf, got)
+	})
+
+	t.Run("no flag defined", func(t *testing.T) {
+		t.Parallel()
+		got, err := applyOnceFlag(configFlagSet(), conf)
+		require.NoError(t, err)
+		assert.Equal(t, conf, got)
+	})
+
+	t.Run("set", func(t *testing.T) {
+		t.Parallel()
+		flags := optionFlagSet()
+		require.NoError(t, flags.Parse([]string{"--once"}))
+		got, err := applyOnceFlag(flags, conf)
+		require.NoError(t, err)
+		require.Len(t, got.Scenarios, 1)
+		assert.IsType(t, executor.SharedIterationsConfig{}, got.Scenarios["a"])
+	})
+
+	for _, args := range [][]string{
+		{"--vus", "2"}, {"--iterations", "10"}, {"--duration", "10s"}, {"--stage", "10s:5"},
+	} {
+		t.Run("conflict "+args[0], func(t *testing.T) {
+			t.Parallel()
+			flags := optionFlagSet()
+			require.NoError(t, flags.Parse(append([]string{"--once"}, args...)))
+			_, err := applyOnceFlag(flags, conf)
+			require.ErrorContains(t, err, "--once cannot be combined with "+args[0])
+			var ecerr errext.HasExitCode
+			require.ErrorAs(t, err, &ecerr)
+			assert.Equal(t, exitcodes.InvalidConfig, ecerr.ExitCode())
+		})
+	}
+}
