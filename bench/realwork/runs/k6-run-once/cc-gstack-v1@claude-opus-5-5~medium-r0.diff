+
+// onceConflictingFlags are the execution shortcut flags that can't be combined with --once.
+var onceConflictingFlags = []string{"vus", "iterations", "duration", "stage"} //nolint:gochecknoglobals
+
+// applyOnceFlag transforms the consolidated config when the --once flag is set, so that the
+// script, or its single scenario, runs with 1 VU and 1 iteration. It's applied after the config
+// consolidation, so the transformation doesn't interfere with how the config layers are merged.
+func applyOnceFlag(flags *pflag.FlagSet, conf Config) (Config, error) {
+	if flags == nil || flags.Lookup("once") == nil {
+		return conf, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return conf, err
+	}
+	for _, name := range onceConflictingFlags {
+		if flags.Changed(name) {
+			return conf, errext.WithExitCodeIfNone(
+				fmt.Errorf("--once cannot be combined with --%s", name), exitcodes.InvalidConfig,
+			)
+		}
+	}
+
+	conf.Options, err = applyOnce(conf.Options)
+	return conf, errext.WithExitCodeIfNone(err, exitcodes.InvalidConfig)
+}
+
+// applyOnce replaces the configured execution with a single shared-iterations scenario with 1 VU
+// and 1 iteration. The exec, env, tags and options of the original scenario, if any, are kept,
+// while the execution shortcut options and all other scenario fields are discarded.
+func applyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, fmt.Errorf("--once can run a single scenario only, but %d scenarios are configured",
+			len(opts.Scenarios))
+	}
+
+	scenario := executor.NewSharedIterationsConfig(lib.DefaultScenarioName)
+	for name, sc := range opts.Scenarios {
+		scenario = executor.NewSharedIterationsConfig(name)
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			scenario.Exec = null.StringFrom(exec)
+		}
+		scenario.Env = sc.GetEnv()
+		scenario.Tags = sc.GetTags()
+		scenario.Options = sc.GetScenarioOptions()
+	}
+	scenario.VUs = null.IntFrom(1)
+	scenario.Iterations = null.IntFrom(1)
+
+	opts.VUs = null.Int{}
+	opts.Iterations = null.Int{}
+	opts.Duration = types.NullDuration{}
+	opts.Stages = nil
+	opts.Scenarios = lib.ScenarioConfigs{scenario.GetName(): scenario}
+	return opts, nil
+}
