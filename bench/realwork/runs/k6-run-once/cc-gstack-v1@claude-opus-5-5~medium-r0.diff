@@ -0,0 +1,225 @@
+package tests
+
+import (
+	"archive/tar"
+	"bytes"
+	"encoding/json"
+	"io"
+	"net/http"
+	"path/filepath"
+	"testing"
+
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cloudapi/v6/v6test"
+	"go.k6.io/k6/v2/internal/cmd"
+	"go.k6.io/k6/v2/internal/lib/testutils"
+	"go.k6.io/k6/v2/lib/fsext"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			export const options = { vus: 10, duration: '1h' };
+			export function setup() { console.log('setup'); }
+			export default function () { console.log('default'); }
+			export function teardown() { console.log('teardown'); }
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Equal(t, []string{"setup", "default", "teardown"}, logMessages(ts.LoggerHook.Drain()))
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			import exec from 'k6/execution';
+			export const options = {
+				scenarios: {
+					my_scenario: {
+						executor: 'constant-vus',
+						vus: 5,
+						duration: '1h',
+						startTime: '10s',
+						exec: 'myExec',
+						env: { FOO: 'bar' },
+						tags: { mytag: 'myvalue' },
+					},
+				},
+			};
+			export function myExec() {
+				console.log(JSON.stringify({
+					scenario: exec.scenario.name,
+					executor: exec.scenario.executor,
+					foo: __ENV.FOO,
+					tag: exec.vu.tags.mytag,
+				}));
+			}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, 0)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+		stdout := ts.Stdout.String()
+		assert.Contains(t, stdout, "my_scenario: 1 iterations shared among 1 VUs")
+		assert.Contains(t, stdout, "exec: myExec")
+		assert.Contains(t, stdout, "1 complete and 0 interrupted iterations")
+		assert.Equal(t, []string{
+			`{"scenario":"my_scenario","executor":"shared-iterations","foo":"bar","tag":"myvalue"}`,
+		}, logMessages(ts.LoggerHook.Drain()))
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			export const options = {
+				scenarios: {
+					a: { executor: 'per-vu-iterations' },
+					b: { executor: 'per-vu-iterations' },
+				},
+			};
+			export default function () {}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.True(t, testutils.LogContains(ts.LoggerHook.Drain(), logrus.ErrorLevel,
+			"--once can run a single scenario only"))
+	})
+
+	for _, flag := range []string{"--iterations=10", "--vus=2", "--duration=1s", "--stage=1s:1"} {
+		t.Run("combined with "+flag, func(t *testing.T) {
+			t.Parallel()
+			ts := getSingleFileTestState(t, `export default function () {}`,
+				[]string{"--once", flag}, exitcodes.InvalidConfig)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+			assert.True(t, testutils.LogContains(ts.LoggerHook.Drain(), logrus.ErrorLevel,
+				"--once cannot be combined with"))
+		})
+	}
+}
+
+func TestArchiveOnce(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			scenarios: {
+				my_scenario: {
+					executor: 'ramping-vus',
+					stages: [{ duration: '1h', target: 100 }],
+					exec: 'myExec',
+				},
+			},
+		};
+		export function myExec() { console.log('myExec'); }
+	`
+	ts := NewGlobalTestState(t)
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(script), 0o644))
+	ts.CmdArgs = []string{"k6", "archive", "--once", "-O", "-", "test.js"}
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	metadata := readArchiveMetadata(t, ts.Stdout.Bytes())
+	var meta struct {
+		Options struct {
+			Scenarios map[string]map[string]any `json:"scenarios"`
+		} `json:"options"`
+	}
+	require.NoError(t, json.Unmarshal(metadata, &meta))
+	require.Len(t, meta.Options.Scenarios, 1)
+	sc := meta.Options.Scenarios["my_scenario"]
+	assert.Equal(t, "shared-iterations", sc["executor"])
+	assert.EqualValues(t, 1, sc["vus"])
+	assert.EqualValues(t, 1, sc["iterations"])
+	assert.Equal(t, "myExec", sc["exec"])
+
+	// Running the archive should run the single iteration without --once.
+	ts2 := NewGlobalTestState(t)
+	ts2.CmdArgs = []string{"k6", "run", "-"}
+	ts2.Stdin = bytes.NewBuffer(ts.Stdout.Bytes())
+	cmd.ExecuteWithGlobalState(ts2.GlobalState)
+	assert.Contains(t, ts2.Stdout.String(), "1 complete and 0 interrupted iterations")
+	assert.Equal(t, []string{"myExec"}, logMessages(ts2.LoggerHook.Drain()))
+}
+
+func logMessages(entries []logrus.Entry) []string {
+	msgs := make([]string, 0, len(entries))
+	for _, e := range entries {
+		msgs = append(msgs, e.Message)
+	}
+	return msgs
+}
+
+func readArchiveMetadata(t *testing.T, data []byte) []byte {
+	t.Helper()
+	tr := tar.NewReader(bytes.NewReader(data))
+	for {
+		hdr, err := tr.Next()
+		require.NoError(t, err)
+		if hdr.Name == "metadata.json" {
+			b, err := io.ReadAll(tr)
+			require.NoError(t, err)
+			return b
+		}
+	}
+}
+
+func TestCloudRunOnce(t *testing.T) {
+	t.Parallel()
+
+	script := `
+		export const options = {
+			cloud: { projectID: 123 },
+			scenarios: {
+				my_scenario: { executor: 'constant-vus', vus: 50, duration: '1h', exec: 'myExec' },
+			},
+		};
+		export function myExec() {}
+	`
+
+	ts := NewGlobalTestState(t)
+	var metadata []byte
+	srv := v6test.NewServer(t, v6test.Config{
+		InspectArchive: func(req *http.Request) {
+			file, _, err := req.FormFile("script")
+			if !assert.NoError(t, err) {
+				return
+			}
+			data, err := io.ReadAll(file)
+			if assert.NoError(t, err) {
+				metadata = readArchiveMetadata(t, data)
+			}
+		},
+	})
+
+	require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "test.js"), []byte(script), 0o644))
+	ts.CmdArgs = []string{"k6", "cloud", "run", "--once", "test.js"}
+	ts.Env["K6_SHOW_CLOUD_LOGS"] = "false"
+	ts.Env["K6_CLOUD_HOST_V6"] = srv.URL
+	ts.Env["K6_CLOUD_TOKEN"] = "foo"
+	ts.Env["K6_CLOUD_STACK_ID"] = "1"
+	cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+	require.NotNil(t, metadata)
+	var meta struct {
+		Options struct {
+			Scenarios map[string]map[string]any `json:"scenarios"`
+		} `json:"options"`
+	}
+	require.NoError(t, json.Unmarshal(metadata, &meta))
+	require.Len(t, meta.Options.Scenarios, 1)
+	sc := meta.Options.Scenarios["my_scenario"]
+	assert.Equal(t, "shared-iterations", sc["executor"])
+	assert.EqualValues(t, 1, sc["vus"])
+	assert.EqualValues(t, 1, sc["iterations"])
+	assert.Equal(t, "myExec", sc["exec"])
+	assert.NotContains(t, sc, "duration")
+}
