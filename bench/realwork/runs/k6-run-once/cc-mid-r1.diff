@@ -0,0 +1,79 @@
+package executor
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		opts := lib.Options{
+			VUs:        null.IntFrom(10),
+			Iterations: null.IntFrom(100),
+			Duration:   types.NewNullDuration(time.Minute, true),
+			Stages:     []lib.Stage{{Target: null.IntFrom(5)}},
+		}
+		res, err := ApplyOnce(opts)
+		require.NoError(t, err)
+		assert.False(t, res.VUs.Valid)
+		assert.False(t, res.Iterations.Valid)
+		assert.False(t, res.Duration.Valid)
+		assert.Nil(t, res.Stages)
+		require.Len(t, res.Scenarios, 1)
+		sc, ok := res.Scenarios[lib.DefaultScenarioName].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.Equal(t, "default", sc.GetExec())
+
+		// the result must survive the usual derivation untouched
+		derived, err := DeriveScenariosFromShortcuts(res, nil)
+		require.NoError(t, err)
+		assert.Equal(t, res.Scenarios, derived.Scenarios)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		orig := NewConstantVUsConfig("mine")
+		orig.VUs = null.IntFrom(20)
+		orig.Duration = types.NewNullDuration(time.Minute, true)
+		orig.Exec = null.StringFrom("foo")
+		orig.Env = map[string]string{"A": "b"}
+		orig.Tags = map[string]string{"t": "v"}
+		orig.StartTime = types.NewNullDuration(time.Second, true)
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+
+		res, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{"mine": orig}})
+		require.NoError(t, err)
+		require.Len(t, res.Scenarios, 1)
+		sc, ok := res.Scenarios["mine"].(SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "mine", sc.GetName())
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+		assert.Equal(t, "foo", sc.GetExec())
+		assert.Equal(t, orig.Env, sc.GetEnv())
+		assert.Equal(t, orig.Tags, sc.GetTags())
+		assert.Equal(t, orig.Options, sc.GetScenarioOptions())
+		assert.Zero(t, sc.GetStartTime())
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := ApplyOnce(lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": NewPerVUIterationsConfig("a"),
+			"b": NewPerVUIterationsConfig("b"),
+		}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
