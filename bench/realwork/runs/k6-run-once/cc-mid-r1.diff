@@ -0,0 +1,64 @@
+package tests
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			export const options = { vus: 5, duration: '1m' };
+			export default function () {}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--out", "json=results.json"}, 0)
+		results := runAndReadResults(t, ts)
+		assert.Equal(t, 1.0, sum(getSampleValues(t, results, "iterations", nil)))
+	})
+
+	t.Run("single scenario keeps exec and tags", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			export const options = {
+				scenarios: {
+					s: { executor: 'constant-vus', vus: 10, duration: '1m', exec: 'foo', tags: { mytag: 'x' } },
+				},
+			};
+			export function foo() {}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once", "--out", "json=results.json"}, 0)
+		results := runAndReadResults(t, ts)
+		assert.Equal(t, 1.0, sum(getSampleValues(t, results, "iterations", map[string]string{"mytag": "x", "scenario": "s"})))
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		script := `
+			export const options = {
+				scenarios: {
+					a: { executor: 'per-vu-iterations' },
+					b: { executor: 'per-vu-iterations' },
+				},
+			};
+			export default function () {}
+		`
+		ts := getSingleFileTestState(t, script, []string{"--once"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+	})
+
+	t.Run("combined with shortcut flag", func(t *testing.T) {
+		t.Parallel()
+		ts := getSingleFileTestState(t, `export default function () {}`,
+			[]string{"--once", "--iterations", "10"}, exitcodes.InvalidConfig)
+		cmd.ExecuteWithGlobalState(ts.GlobalState)
+		assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with --iterations")
+	})
+}
