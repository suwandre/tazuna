+// isOnceRequested reports whether the --once flag was set, and returns an error
+// if it was combined with any of the shortcut flags that it conflicts with.
+func isOnceRequested(cmd *cobra.Command) (bool, error) {
+	if cmd == nil {
+		return false, nil
+	}
+	flags := cmd.Flags()
+	if flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			return false, fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+	return true, nil
+}
