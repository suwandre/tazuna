+
+// ApplyOnce transforms the (already consolidated) options so the script runs
+// with exactly 1 VU and 1 iteration, preserving the configuration of the
+// scenario, if any. The executor is replaced with a shared-iterations one, and
+// everything but the scenario's name, exec, env, tags and options is discarded,
+// as are the vus, iterations, duration and stages shortcuts.
+//
+// It returns an error if more than one scenario is configured.
+func ApplyOnce(opts lib.Options) (lib.Options, error) {
+	if len(opts.Scenarios) > 1 {
+		return opts, ExecutionConflictError("--once can run a single scenario only")
+	}
+
+	name := lib.DefaultScenarioName
+	once := NewSharedIterationsConfig(name)
+	for scName, sc := range opts.Scenarios {
+		name = scName
+		once = NewSharedIterationsConfig(name)
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			once.Exec = null.StringFrom(exec)
+		}
+		once.Env = sc.GetEnv()
+		once.Tags = sc.GetTags()
+		once.Options = sc.GetScenarioOptions()
+	}
+	once.VUs = null.IntFrom(1)
+	once.Iterations = null.IntFrom(1)
+
+	opts.Scenarios = lib.ScenarioConfigs{name: once}
+	opts.VUs = null.NewInt(0, false)
+	opts.Iterations = null.NewInt(0, false)
+	opts.Duration = types.NewNullDuration(0, false)
+	opts.Stages = nil
+
+	return opts, nil
+}
