+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	const script = `
+export const options = {
+  scenarios: {
+    one: { executor: 'constant-vus', vus: 5, duration: '1h', exec: 'foo', tags: { custom: 'yes' } },
+  },
+};
+export function foo() { console.log("RUNNING_FOO"); }
+export function setup() { console.log("RUNNING_SETUP"); }
+export function teardown() { console.log("RUNNING_TEARDOWN"); }
+`
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		ts := tests.NewGlobalTestState(t)
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "s.js"), []byte(script), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "s.js"}
+		newRootCommand(ts.GlobalState).execute()
+
+		out := ts.Stdout.String() + ts.Stderr.String()
+		assert.Equal(t, 1, strings.Count(out, "RUNNING_FOO"))
+		assert.Contains(t, out, "RUNNING_SETUP")
+		assert.Contains(t, out, "RUNNING_TEARDOWN")
+	})
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := tests.NewGlobalTestState(t)
+		src := `export default function () { console.log("RUNNING_DEFAULT"); }`
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "s.js"), []byte(src), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "s.js"}
+		newRootCommand(ts.GlobalState).execute()
+
+		out := ts.Stdout.String() + ts.Stderr.String()
+		assert.Equal(t, 1, strings.Count(out, "RUNNING_DEFAULT"))
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		ts := tests.NewGlobalTestState(t)
+		src := `export const options = { scenarios: {
+  a: { executor: 'constant-vus', vus: 1, duration: '1s' },
+  b: { executor: 'constant-vus', vus: 1, duration: '1s' } } };
+export default function () {}`
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "s.js"), []byte(src), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "s.js"}
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+		newRootCommand(ts.GlobalState).execute()
+
+		assert.Contains(t, ts.Stderr.String(), "--once can run a single scenario only")
+	})
+
+	t.Run("combined with shortcut flags", func(t *testing.T) {
+		t.Parallel()
+		ts := tests.NewGlobalTestState(t)
+		src := `export default function () {}`
+		require.NoError(t, fsext.WriteFile(ts.FS, filepath.Join(ts.Cwd, "s.js"), []byte(src), 0o644))
+		ts.CmdArgs = []string{"k6", "run", "--once", "--iterations", "10", "s.js"}
+		ts.ExpectedExitCode = int(exitcodes.InvalidConfig)
+		newRootCommand(ts.GlobalState).execute()
+
+		assert.Contains(t, ts.Stderr.String(), "--once cannot be combined with --iterations")
+	})
+}
