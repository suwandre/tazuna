+// isOnceRequested reports whether the --once flag was set, returning an error
+// if it was combined with any of the shortcut execution flags.
+func isOnceRequested(flags *pflag.FlagSet) (bool, error) {
+	if flags.Lookup("once") == nil {
+		return false, nil
+	}
+	once, err := flags.GetBool("once")
+	if err != nil || !once {
+		return false, err
+	}
+	for _, name := range []string{"vus", "iterations", "duration", "stage"} {
+		if flags.Changed(name) {
+			return false, fmt.Errorf("--once cannot be combined with --%s", name)
+		}
+	}
+	return true, nil
+}
