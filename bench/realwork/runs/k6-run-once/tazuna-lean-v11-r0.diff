+package cmd
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/spf13/pflag"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/errext"
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/lib/consts"
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+)
+
+const onceFlagName = "once"
+
+// onceIncompatibleFlags are the execution shortcut flags that can't be combined with --once.
+var onceIncompatibleFlags = []string{"vus", "duration", "iterations", "stage"} //nolint:gochecknoglobals
+
+// isOnceMode returns true if the --once flag is defined and set.
+func isOnceMode(flags *pflag.FlagSet) bool {
+	if flags == nil || flags.Lookup(onceFlagName) == nil {
+		return false
+	}
+	once, err := flags.GetBool(onceFlagName)
+	return err == nil && once
+}
+
+// validateOnceFlags checks that --once isn't combined with any execution shortcut flag.
+func validateOnceFlags(flags *pflag.FlagSet) error {
+	for _, name := range onceIncompatibleFlags {
+		if flags.Changed(name) {
+			return errext.WithExitCodeIfNone(
+				fmt.Errorf("--%s cannot be combined with --%s", onceFlagName, name),
+				exitcodes.InvalidConfig,
+			)
+		}
+	}
+	return nil
+}
+
+// applyOnce transforms the consolidated config so the script runs with 1 VU and 1 iteration.
+//
+// The scenario (if any) keeps its exec function, env, tags and scenario options. The executor
+// is replaced by shared-iterations, and every other field is discarded, including the execution
+// shortcut options (vus, iterations, duration, stages).
+func applyOnce(conf Config) (Config, error) {
+	if len(conf.Scenarios) > 1 {
+		return conf, errext.WithExitCodeIfNone(
+			errors.New("--once can run a single scenario only"), exitcodes.InvalidConfig,
+		)
+	}
+
+	name := lib.DefaultScenarioName
+	scenario := executor.NewSharedIterationsConfig(name)
+	for n, sc := range conf.Scenarios {
+		name = n
+		scenario = executor.NewSharedIterationsConfig(name)
+		if exec := sc.GetExec(); exec != consts.DefaultFn {
+			scenario.Exec = null.StringFrom(exec)
+		}
+		scenario.Env = sc.GetEnv()
+		scenario.Tags = sc.GetTags()
+		scenario.Options = sc.GetScenarioOptions()
+	}
+	scenario.VUs = null.IntFrom(1)
+	scenario.Iterations = null.IntFrom(1)
+
+	conf.Scenarios = lib.ScenarioConfigs{name: scenario}
+	conf.VUs = null.Int{}
+	conf.Iterations = null.Int{}
+	conf.Duration.Valid = false
+	conf.Duration.Duration = 0
+	conf.Stages = nil
+
+	return conf, nil
+}
