+package cmd
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/guregu/null.v3"
+
+	"go.k6.io/k6/v2/lib"
+	"go.k6.io/k6/v2/lib/executor"
+	"go.k6.io/k6/v2/lib/types"
+)
+
+func TestApplyOnce(t *testing.T) {
+	t.Parallel()
+
+	t.Run("no scenarios", func(t *testing.T) {
+		t.Parallel()
+		conf := Config{Options: lib.Options{
+			VUs: null.IntFrom(5), Iterations: null.IntFrom(10),
+			Duration: types.NullDurationFrom(time.Minute), Stages: []lib.Stage{{}},
+		}}
+		res, err := applyOnce(conf)
+		require.NoError(t, err)
+		assert.False(t, res.VUs.Valid || res.Iterations.Valid || res.Duration.Valid)
+		assert.Nil(t, res.Stages)
+		sc, ok := res.Scenarios[lib.DefaultScenarioName].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+	})
+
+	t.Run("single scenario", func(t *testing.T) {
+		t.Parallel()
+		orig := executor.NewConstantVUsConfig("sc")
+		orig.VUs = null.IntFrom(10)
+		orig.Exec = null.StringFrom("foo")
+		orig.Env = map[string]string{"A": "b"}
+		orig.Tags = map[string]string{"t": "v"}
+		orig.StartTime = types.NullDurationFrom(time.Second)
+		orig.Options = &lib.ScenarioOptions{Browser: map[string]any{"type": "chromium"}}
+		res, err := applyOnce(Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{"sc": orig}}})
+		require.NoError(t, err)
+		require.Len(t, res.Scenarios, 1)
+		sc, ok := res.Scenarios["sc"].(executor.SharedIterationsConfig)
+		require.True(t, ok)
+		assert.Equal(t, "sc", sc.GetName())
+		assert.Equal(t, "foo", sc.GetExec())
+		assert.Equal(t, orig.Env, sc.GetEnv())
+		assert.Equal(t, orig.Tags, sc.GetTags())
+		assert.Equal(t, orig.Options, sc.GetScenarioOptions())
+		assert.Zero(t, sc.GetStartTime())
+		assert.Equal(t, int64(1), sc.VUs.Int64)
+		assert.Equal(t, int64(1), sc.Iterations.Int64)
+	})
+
+	t.Run("multiple scenarios", func(t *testing.T) {
+		t.Parallel()
+		_, err := applyOnce(Config{Options: lib.Options{Scenarios: lib.ScenarioConfigs{
+			"a": executor.NewSharedIterationsConfig("a"),
+			"b": executor.NewSharedIterationsConfig("b"),
+		}}})
+		require.ErrorContains(t, err, "--once can run a single scenario only")
+	})
+}
