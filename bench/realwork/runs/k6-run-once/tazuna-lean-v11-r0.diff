diff --git a/internal/cmd/tests/cmd_run_once_test.go b/internal/cmd/tests/cmd_run_once_test.go
new file mode 100644
index 0000000..e4d47eb
--- /dev/null
+++ b/internal/cmd/tests/cmd_run_once_test.go
@@ -0,0 +1,88 @@
+package tests
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"go.k6.io/k6/v2/errext/exitcodes"
+	"go.k6.io/k6/v2/internal/cmd"
+)
+
+func TestRunOnce(t *testing.T) {
+	t.Parallel()
+
+	tests := map[string]struct {
+		script   string
+		flags    []string
+		expLogs  []string
+		expError string
+	}{
+		"no scenarios": {
+			script: `
+				export const options = { vus: 5, iterations: 20 };
+				export function setup() { console.log('setup'); }
+				export default function () { console.log('default'); }
+				export function teardown() { console.log('teardown'); }`,
+			flags:   []string{"--once"},
+			expLogs: []string{"setup", "default", "teardown"},
+		},
+		"single scenario keeps exec, env and tags": {
+			script: `
+				export const options = {
+					scenarios: {
+						sc: {
+							executor: 'constant-vus', vus: 10, duration: '1m',
+							exec: 'foo', env: { FOO: 'bar' }, tags: { mytag: 'myvalue' },
+						},
+					},
+				};
+				export function foo() { console.log('foo ' + __ENV.FOO + ' ' + exec.vu.tags.mytag); }
+				export default function () { console.log('default'); }
+				import exec from 'k6/execution';`,
+			flags:   []string{"--once"},
+			expLogs: []string{"foo bar myvalue"},
+		},
+		"multiple scenarios": {
+			script: `
+				export const options = { scenarios: {
+					a: { executor: 'shared-iterations' },
+					b: { executor: 'shared-iterations' },
+				} };
+				export default function () {}`,
+			flags:    []string{"--once"},
+			expError: "--once can run a single scenario only",
+		},
+		"shortcut flag": {
+			script:   `export default function () {}`,
+			flags:    []string{"--once", "--iterations", "10"},
+			expError: "--once cannot be combined with --iterations",
+		},
+	}
+
+	for name, tc := range tests {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+
+			code := exitcodes.ExitCode(0)
+			if tc.expError != "" {
+				code = exitcodes.InvalidConfig
+			}
+			args := append([]string{"--quiet", "--log-format=raw"}, tc.flags...)
+			ts := getSingleFileTestState(t, tc.script, args, code)
+			cmd.ExecuteWithGlobalState(ts.GlobalState)
+
+			if tc.expError != "" {
+				assert.Contains(t, ts.LoggerHook.Drain()[0].Message, tc.expError)
+				return
+			}
+
+			var logs []string
+			for _, e := range ts.LoggerHook.Drain() {
+				logs = append(logs, e.Message)
+			}
+			assert.Equal(t, tc.expLogs, logs)
+			assert.Contains(t, ts.Stdout.String(), "iterations...........: 1 ")
+		})
+	}
+}
