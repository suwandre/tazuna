diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..3191938 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,96 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+A:{{ partial "early.html" 1 }}
+B:{{ partial "early.html" 2 }}
+C:{{ partial "none.html" . }}|{{ partial "none.html" . | printf "%T" }}
+D:{{ partial "nested.html" . }}
+E:{{ partial "range.html" . }}
+F:{{ partial "pipe.html" . }}
+G:{{ partial "falsy.html" . | printf "%T" }}
+H:{{ partial "cmd.html" 2 }}
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}
+  {{ return "one" }}
+{{ end }}
+{{ return "other" }}
+-- layouts/_partials/none.html --
+output
+{{ if false }}{{ return "x" }}{{ end }}
+-- layouts/_partials/nested.html --
+{{ with partial "early.html" 1 }}{{ . }}-{{ end }}{{ return "nested" }}
+-- layouts/_partials/range.html --
+{{ range seq 5 }}{{ if eq . 3 }}{{ return . }}{{ end }}{{ end }}
+{{ return "not reached" }}
+-- layouts/_partials/pipe.html --
+{{ "piped" | return }}
+{{ return "not reached" }}
+-- layouts/_partials/falsy.html --
+{{ return }}
+-- layouts/_partials/cmd.html --
+{{ return add . 40 }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"A:one",
+		"B:other",
+		"C:|&lt;nil&gt;",
+		"D:nested",
+		"E:3",
+		"F:piped",
+		"G:&lt;nil&gt;",
+		"H:42",
+	)
+}
+
+func TestReturnEarlyInNonPartials(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- content/p1.md --
+---
+title: P1
+---
+-- layouts/home.html --
+Before
+{{ return }}
+After
+-- layouts/page.html --
+{{ if .Title }}Page: {{ .Title }}{{ return }}{{ end }}
+After
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContentExact("public/index.html", "Before\n")
+	b.AssertFileContentExact("public/p1/index.html", "Page: P1")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ partial "foo.html" }}
+-- layouts/_partials/foo.html --
+{{ 1 | return 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "expected at most 1 argument")
+}
