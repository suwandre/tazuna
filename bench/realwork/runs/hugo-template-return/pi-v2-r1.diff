+// returnFunc stops the execution of the current template, with an optional return value.
+func returnFunc(args ...any) (string, error) {
+	if len(args) > 1 {
+		return "", fmt.Errorf("return: expected at most 1 argument, got %d", len(args))
+	}
+	ret := &texttemplate.ReturnError{}
+	if len(args) == 1 {
+		ret.Value = args[0]
+	}
+	return "", ret
+}
