+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+A:{{ partial "first-even.html" (slice 1 3 4 6) }}
+B:{{ partial "first-even.html" (slice 1 3) }}
+C:{{ if eq (partial "noval.html" .) nil }}nil{{ end }}
+D:{{ partial "multi.html" . }}
+E:{{ partial "sub.html" . }}
+F:{{ partial "flat.html" 5 }}
+-- layouts/_partials/first-even.html --
+before
+{{ range . }}
+  {{ if math.ModBool . 2 }}{{ return . }}{{ end }}
+{{ end }}
+after
+-- layouts/_partials/noval.html --
+before
+{{ return }}
+after
+-- layouts/_partials/multi.html --
+{{ with "x" }}{{ return (printf "%s-%d" . 42) }}{{ end }}
+unreachable
+-- layouts/_partials/sub.html --
+{{ template "inner" . }}sub-after
+{{ define "inner" }}inner-before{{ return }}inner-after{{ end }}
+-- layouts/_partials/flat.html --
+{{ return add . 1 }}
+`
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"A:4",
+		"B:before",
+		"C:nil",
+		"D:x-42",
+		"E:inner-beforesub-after",
+		"F:6",
+	)
+}
+
+func TestReturnInRegularTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+Before.
+{{ with site.Title }}{{ else }}{{ return }}{{ end }}
+After.
+-- layouts/_shortcodes/sc.html --
+SC-before.{{ return }}SC-after.
+-- content/_index.md --
+-- content/p1.md --
+---
+title: P1
+---
+{{< sc >}}Rest.
+-- layouts/page.html --
+{{ .Content }}|Page-before|{{ return }}Page-after
+`
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Before.", "! After.")
+	b.AssertFileContent("public/p1/index.html", "SC-before.Rest.", "Page-before", "! Page-after", "! SC-after")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ partial "p.html" . }}
+-- layouts/_partials/p.html --
+{{ 1 | return 2 }}
+`
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "return: expected at most 1 argument, got 2")
+}
