diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..eab5747 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,95 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarlyInPartial(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+1:{{ partial "first-even" (slice 1 3 4 5) }}
+2:{{ partial "first-even" (slice 1 3) | strings.TrimSpace }}|
+3:{{ partial "sum" (slice 1 2 3) }}
+4:{{ partialCached "first-even" (slice 2) }}
+5:{{ partial "return-nil" . | printf "%T" }}
+6:{{ partial "chained" 3 }}
+7:{{ partial "bare" true }}|{{ partial "bare" false }}|
+-- layouts/_partials/first-even.html --
+{{ range . }}
+  {{ if math.ModBool . 2 }}
+    {{ return . }}
+  {{ end }}
+{{ end }}
+no even
+-- layouts/_partials/sum.html --
+{{ return add (index . 0) (index . 1) }}
+unreachable
+-- layouts/_partials/return-nil.html --
+{{ return nil }}
+-- layouts/_partials/bare.html --
+Before.{{ if . }}{{ return }}{{ end }}After.
+-- layouts/_partials/chained.html --
+{{ return (add . 1) | add 10 }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"1:4",
+		"2:no even|",
+		"3:3",
+		"4:2",
+		"5:&lt;nil&gt;",
+		"6:4",
+		"7:Before.|Before.After.\n|",
+	)
+}
+
+func TestReturnEarlyInTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+disableKinds = ["section", "taxonomy", "term", "rss", "sitemap"]
+-- content/p1.md --
+---
+title: P1
+---
+-- layouts/home.html --
+Home before.
+{{ return }}
+Home after.
+-- layouts/page.html --
+{{ define "main" }}Main before.{{ if .Title }}{{ return }}{{ end }}Main after.{{ end }}
+-- layouts/baseof.html --
+<body>{{ block "main" . }}{{ end }}</body>{{ partial "p.html" . }}
+-- layouts/_partials/p.html --
+{{- template "inner" . }}|After inner.{{ return "from partial" }}
+{{- define "inner" }}Inner before.{{ return "ignored" }}Inner after.{{ end }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Home before.", "! Home after.")
+	b.AssertFileContentExact("public/p1/index.html", "<body>Main before.</body>from partial")
+	b.AssertFileContent("public/p1/index.html", "! Main after.", "! Inner", "! After inner.")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ partial "p.html" . }}
+-- layouts/_partials/p.html --
+{{ 1 | return 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.ErrorMatches, `(?s).*return: expected at most 1 argument, got 2.*`)
+}
