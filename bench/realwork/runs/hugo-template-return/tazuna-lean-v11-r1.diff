+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "http://example.com/"
+-- layouts/_partials/early.html --
+{{ if . }}{{ return "early" }}{{ end }}
+not reached
+{{ return "late" }}
+-- layouts/_partials/nested.html --
+{{ range seq 5 }}{{ if eq . 3 }}{{ return . }}{{ end }}{{ end }}
+{{ return "none" }}
+-- layouts/_partials/noarg.html --
+{{ return }}
+-- layouts/_partials/nooutput.html --
+output
+-- layouts/_shortcodes/sc.html --
+before{{ return }}after
+-- layouts/home.html --
+a: {{ partial "early.html" true }}
+b: {{ partial "early.html" false }}
+c: {{ partial "nested.html" . }}
+d: {{ partial "noarg.html" . | printf "%v" }}
+e: {{ partial "nooutput.html" . }}
+f: {{ with partial "noarg.html" . }}yes{{ else }}no{{ end }}
+Before
+{{ return }}
+After
+-- layouts/page.html --
+Page before{{ return }}Page after
+-- content/p1.md --
+---
+title: p1
+---
+{{< sc >}}
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/index.html", "a: early", "b: late", "c: 3", "d: &lt;nil&gt;", "e: output", "f: no", "Before")
+	b.AssertFileContentExact("public/p1/index.html", "Page before")
+}
