+package parse
+
+import "slices"
+
+// WrapArgsInPipe replaces c.Args[from:] with a single pipe
+// containing one command with those arguments.
+func (c *CommandNode) WrapArgsInPipe(from int) {
+	cmd := &CommandNode{tr: c.tr, NodeType: NodeCommand, Pos: c.Args[from].Position(), Args: slices.Clone(c.Args[from:])}
+	pipe := &PipeNode{tr: c.tr, NodeType: NodePipe, Pos: cmd.Pos, Cmds: []*CommandNode{cmd}}
+	c.Args = append(c.Args[:from:from], pipe)
+}
