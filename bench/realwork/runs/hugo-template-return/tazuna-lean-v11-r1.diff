+// returnWithValue stops the execution of the current template,
+// optionally with a value (used by partials).
+func returnWithValue(args ...any) (any, error) {
+	switch len(args) {
+	case 0:
+		return nil, &texttemplate.ReturnError{}
+	case 1:
+		return nil, &texttemplate.ReturnError{Value: args[0]}
+	default:
+		return nil, fmt.Errorf("return takes at most 1 argument, got %d", len(args))
+	}
+}
