diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..715af0b 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,98 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+a: {{ partial "first.html" (slice 1 2 3) }}
+b: {{ partial "first.html" (slice 0 0) }}
+c: {{ partial "pipe.html" 5 }}
+d: {{ partial "bare.html" . | printf "%T" }}
+e: {{ partial "nilvalue.html" . | printf "%v" }}
+f: {{ partial "tmpl.html" . }}
+g: {{ partial "noreturn.html" . }}
+h: {{ partial "dot.html" "mydot" }}
+-- layouts/_partials/first.html --
+output ignored
+{{ range . }}
+  {{ if . }}{{ return . }}{{ end }}
+{{ end }}
+{{ return "none" }}
+-- layouts/_partials/pipe.html --
+{{ . | add 1 | return }}
+unreachable
+-- layouts/_partials/bare.html --
+{{ return }}
+-- layouts/_partials/nilvalue.html --
+{{ return nil }}
+-- layouts/_partials/tmpl.html --
+{{ template "inner" . }}
+{{ return "outer" }}
+{{ define "inner" }}{{ return "inner" }}{{ end }}
+-- layouts/_partials/noreturn.html --
+{{ if false }}{{ return 1 }}{{ end }}
+-- layouts/_partials/dot.html --
+{{ with . }}{{ return (printf "%s-%s" . $) }}{{ end }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"a: 1",
+		"b: none",
+		"c: 6",
+		"d: &lt;nil&gt;",
+		"e: &lt;nil&gt;",
+		"f: inner",
+		"g: \n",
+		"h: mydot-mydot",
+	)
+}
+
+func TestReturnEarlyNonPartial(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- content/p1.md --
+---
+title: p1
+---
+-- layouts/home.html --
+Home before.
+{{ if .IsHome }}{{ return }}{{ end }}
+Home after.
+-- layouts/page.html --
+Page before.
+{{ range seq 3 }}{{ if eq . 2 }}{{ return "ignored" }}{{ end }}Item {{ . }}.{{ end }}
+Page after.
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Home before.", "! Home after.")
+	b.AssertFileContentExact("public/p1/index.html", "Page before.\nItem 1.")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ partial "foo.html" . }}
+-- layouts/_partials/foo.html --
+{{ return 1 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "expected at most 1 argument")
+}
