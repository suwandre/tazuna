+
+// See golang/go#53015.
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- layouts/baseof.html --
+Base start|{{ block "main" . }}{{ end }}|Base end
+-- layouts/home.html --
+{{ define "main" }}Main start|{{ if true }}{{ return }}{{ end }}Main end{{ end }}
+-- layouts/page.html --
+Page start|{{ range seq 3 }}{{ . }}|{{ if eq . 2 }}{{ return }}{{ end }}{{ end }}Page end
+-- layouts/_partials/value.html --
+{{ range . }}{{ if eq . 2 }}{{ return (printf "v%d" .) }}{{ end }}{{ end }}
+{{ return "none" }}
+-- layouts/_partials/novalue.html --
+{{ if . }}{{ return 42 }}{{ end }}
+-- layouts/_partials/render.html --
+Render start|{{ return }}Render end
+-- layouts/_partials/try.html --
+{{ with try (return 1) }}{{ end }}Not reached
+-- content/p1.md --
+---
+title: p1
+---
+-- layouts/section.html --
+Value: {{ partial "value.html" (slice 1 2 3) }}|{{ partial "value.html" (slice 1) }}|
+NoValue: {{ partial "novalue.html" true }}|{{ partial "novalue.html" false | printf "%v" }}|
+Render: {{ partial "render.html" . }}|
+Try: {{ partial "try.html" . | printf "%v" }}|
+-- content/s1/_index.md --
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Base start|Main start||Base end")
+	b.AssertFileContent("public/p1/index.html", "Page start|1|2|")
+	b.AssertFileContent("public/p1/index.html", "! Page end")
+	b.AssertFileContent("public/s1/index.html",
+		"Value: v2|none|",
+		"NoValue: 42|&lt;nil&gt;|",
+		"Render: Render start||",
+		"Try: 1|",
+	)
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/home.html --
+{{ 2 | return 1 }}
+`
+
+	_, err := hugolib.TestE(t, files)
+	qt.Assert(t, err, qt.ErrorMatches, `(?s).*return takes at most 1 argument, got 2.*`)
+}
