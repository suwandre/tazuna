+// See https://github.com/golang/go/issues/53015
+func TestReturn(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+disableKinds = ["taxonomy", "term", "page", "rss", "sitemap"]
+-- layouts/baseof.html --
+Header|{{ block "main" . }}{{ end }}|Footer
+-- layouts/home.html --
+{{ define "main" }}
+Main1|
+{{ $n := 0 }}
+{{ range seq 5 }}{{ $n = . }}{{ if eq . 3 }}{{ return }}{{ end }}{{ end }}
+Main2:{{ $n }}|
+{{ end }}
+-- layouts/section.html --
+Section1|
+{{ partial "nested.html" }}|
+Even: {{ partial "even.html" 4 }}|{{ partial "even.html" 3 }}|
+Cached: {{ partialCached "even.html" 6 6 }}|
+Nil: {{ eq (partial "nil.html") nil }}|
+Output: {{ partial "output.html" }}|
+NoReturn: {{ partial "noreturn.html" }}|
+Section2|
+{{ return 32 }}
+Section3|
+-- layouts/_partials/even.html --
+{{ if math.ModBool . 2 }}{{ return true }}{{ end }}
+{{ return false }}
+-- layouts/_partials/nil.html --
+{{ return nil }}
+-- layouts/_partials/output.html --
+Before{{ if true }}{{ return }}{{ end }}After
+-- layouts/_partials/noreturn.html --
+NoReturnOutput
+-- layouts/_partials/nested.html --
+{{ define "inner" }}Inner1|{{ return 42 }}Inner2|{{ end }}
+Nested1|{{ template "inner" }}Nested2|
+-- content/s1/_index.md --
+---
+title: S1
+---
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Header|\nMain1|", "|Footer", "! Main2")
+	b.AssertFileContent("public/s1/index.html",
+		"Section1|",
+		"Nested1|Inner1|Nested2|",
+		"Even: true|false|",
+		"Cached: true|",
+		"Nil: true|",
+		"Output: Before|",
+		"NoReturn: NoReturnOutput|",
+		"Section2|",
+		"! Inner2", "! After", "! Section3", "! 32",
+	)
+}
+
+func TestReturnErrors(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+disableKinds = ["taxonomy", "term", "page", "rss", "sitemap", "section"]
+-- layouts/home.html --
+Before|{{ RETURN }}
+`
+
+	b, err := hugolib.TestE(t, strings.ReplaceAll(files, "RETURN", "return 1 2"))
+	b.Assert(err, qt.ErrorMatches, `(?s).*home.html:1:17.*can't give argument to non-function 1`)
+
+	b, err = hugolib.TestE(t, strings.ReplaceAll(files, "RETURN", "templates.Return 1 2"))
+	b.Assert(err, qt.ErrorMatches, `(?s).*return takes at most 1 argument, got 2`)
+
+	b = hugolib.Test(t, strings.ReplaceAll(files, "RETURN", `$v := try (return 1) }}{{ "After"`))
+	b.AssertFileContent("public/index.html", "Before|", "! After")
+}
