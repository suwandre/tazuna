+// Return stops execution of the current template.
+// In partials, the optional value is returned to the caller;
+// without a value, the output rendered so far is returned.
+func (ns *Namespace) Return(args ...any) (any, error) {
+	switch len(args) {
+	case 0:
+		return nil, &texttemplate.ReturnError{}
+	case 1:
+		return nil, &texttemplate.ReturnError{Value: args[0], HasValue: true}
+	default:
+		return nil, fmt.Errorf("return takes at most 1 argument, got %d", len(args))
+	}
+}
