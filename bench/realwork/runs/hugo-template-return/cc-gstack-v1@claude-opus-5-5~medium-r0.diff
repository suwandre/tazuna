+// ReturnError is returned by the return template func to stop
+// execution of the current template.
+type ReturnError struct {
+	Value    any
+	HasValue bool
+}
+
+func (e *ReturnError) Error() string {
+	return "return"
+}
+
+// recoverReturn stores a ReturnError in errp; any other panic is re-panicked.
+func recoverReturn(errp *error) {
+	if r := recover(); r != nil {
+		re, ok := r.(*ReturnError)
+		if !ok {
+			panic(r)
+		}
+		*errp = re
+	}
+}
+
+// walkTemplate is walkTemplateOld, but a return in the invoked template
+// only stops that template.
+func (s *state) walkTemplate(dot reflect.Value, t *parse.TemplateNode) {
+	defer func() {
+		if r := recover(); r != nil {
+			if _, ok := r.(*ReturnError); !ok {
+				panic(r)
+			}
+		}
+	}()
+	s.walkTemplateOld(dot, t)
