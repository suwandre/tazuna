+// Return ends the execution of the current template, with an optional return value.
+func (ns *Namespace) Return(args ...any) (any, error) {
+	var v any
+	if len(args) > 0 {
+		v = args[0]
+	}
+	return nil, &texttemplate.ReturnError{Value: v}
+}
