index 79a92f1..d79a8bf 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,49 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+Early: {{ partial "early.html" true }}|{{ partial "early.html" false }}
+Nil: {{ partial "nil.html" . | printf "%T" }}
+Fallthrough: {{ partial "fallthrough.html" . | strings.TrimSpace }}
+Piped: {{ partial "piped.html" "x" }}
+Range: {{ partial "range.html" (slice 1 2 3 4) }}
+{{ template "tmpl" }}
+Before.
+{{ if true }}{{ return }}{{ end }}
+After.
+{{ define "tmpl" }}A{{ return }}B{{ end }}
+-- layouts/_partials/early.html --
+{{ if . }}{{ return "early" }}{{ end }}
+{{ return "late" }}
+-- layouts/_partials/nil.html --
+{{ return }}
+-- layouts/_partials/fallthrough.html --
+{{ if false }}{{ return 1 }}{{ end }}
+output
+-- layouts/_partials/piped.html --
+{{ . | upper | return }}
+-- layouts/_partials/range.html --
+{{ range . }}{{ if gt . 2 }}{{ return . }}{{ end }}{{ end }}
+{{ return "none" }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"Early: early|late",
+		"Nil: &lt;nil&gt;",
+		"Fallthrough: output",
+		"Piped: X",
+		"Range: 3",
+		"A\nBefore.",
+		"! AB",
+		"! After.",
+	)
+}
