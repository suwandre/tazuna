+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- content/p1.md --
+---
+title: "P1"
+---
+{{< sc >}}
+-- layouts/home.html --
+Before.
+{{ if true }}{{ return }}{{ end }}
+After.
+-- layouts/page.html --
+Page:{{ .Content }}|
+early:{{ partial "early.html" 5 }}|
+late:{{ partial "early.html" 1 }}|
+loop:{{ partial "loop.html" (slice 1 2 3 4) }}|
+falsy:{{ partial "falsy.html" false }}|
+nil:{{ partial "bare.html" . }}|
+dot:{{ partial "dot.html" "arg" }}|
+pipe:{{ partial "pipe.html" "arg" }}|
+render:{{ partial "render.html" true }}|{{ partial "render.html" false }}|
+tmpl:{{ partial "tmpl.html" . }}|
+-- layouts/_partials/early.html --
+{{ if gt . 3 }}{{ return "big" }}{{ end }}
+{{ return "small" }}
+-- layouts/_partials/loop.html --
+{{ range . }}{{ if eq . 3 }}{{ return . }}{{ end }}{{ end }}
+{{ return 0 }}
+-- layouts/_partials/falsy.html --
+{{ return . }}
+-- layouts/_partials/bare.html --
+{{ return }}
+{{ return "not reached" }}
+-- layouts/_partials/dot.html --
+{{ with "other" }}{{ return (printf "%s-%s" $ .) }}{{ end }}
+-- layouts/_partials/pipe.html --
+{{ return . | upper | printf "%s!" }}
+-- layouts/_partials/render.html --
+Rendered
+{{- if . }}{{ return }}{{ end -}}
+.Not reached
+-- layouts/_shortcodes/sc.html --
+SC{{ return }}Not reached
+-- layouts/_partials/tmpl.html --
+{{- define "t" }}T1{{ return 1 }}T2{{ end -}}
+{{ template "t" }}-after
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Before.")
+	b.AssertFileContent("public/index.html", "! After.")
+	b.AssertFileContent("public/p1/index.html",
+		"Page:SC\n|",
+		"early:big|",
+		"late:small|",
+		"loop:3|",
+		"falsy:false|",
+		"nil:|",
+		"dot:arg-other|",
+		"pipe:ARG!|",
+		"render:Rendered|Rendered.Not reached|",
+		"tmpl:T1-after|",
+	)
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/home.html --
+{{ partial "p.html" . }}
+-- layouts/_partials/p.html --
+{{ return 1 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.ErrorMatches, `(?s).*can't give argument to non-function 1.*`)
+}
