+package partials_test
+
+import (
+	"testing"
+
+	"github.com/gohugoio/hugo/hugolib"
+)
+
+// See issue 53015.
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["page", "section", "taxonomy", "term", "RSS", "sitemap", "robotsTXT", "404"]
+-- layouts/home.html --
+A:{{ partial "early.html" 1 }}|B:{{ partial "early.html" 2 }}|C:{{ partial "piped.html" . }}|D:{{ partial "nil.html" . }}|E:{{ partial "nested.html" . }}|
+Before{{ if site.Title }}{{ else }}{{ return }}{{ end }}After
+{{ range seq 3 }}{{ if eq . 2 }}{{ return }}{{ end }}R{{ . }}{{ end }}
+NotReached
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ return "other" }}
+-- layouts/_partials/piped.html --
+{{ return "a b" | strings.ToUpper }}
+-- layouts/_partials/nil.html --
+{{ return }}
+-- layouts/_partials/nested.html --
+{{ $v := partial "early.html" 1 }}
+{{ with $v }}{{ return (printf "got %s" .) }}{{ end }}
+{{ return "unreachable" }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"A:one|B:other|C:A B|D:|E:got one|",
+		"Before",
+	)
+	b.AssertFileContent("public/index.html", "! After", "! NotReached")
+}
