@@ -586,3 +586,60 @@ page.html.d
 
 	b.AssertFileContent("public/p1/index.b", "page.html.b")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "http://example.com/"
+-- layouts/_partials/early.html --
+{{ if . }}{{ return "early" }}{{ end }}
+{{ return "late" }}
+-- layouts/_partials/nested.html --
+{{ range seq 5 }}{{ if eq . 3 }}{{ return . }}{{ end }}{{ end }}
+{{ return "none" }}
+-- layouts/_partials/novalue.html --
+Before.{{ if . }}{{ return }}{{ end }}After.
+-- layouts/_partials/nil.html --
+Output.{{ return nil }}
+-- layouts/_partials/falsy.html --
+{{ return false }}
+-- layouts/_partials/deferred.html --
+{{ return "x" }}Not rendered.
+-- layouts/home.html --
+early: {{ partial "early.html" true }}|{{ partial "early.html" false }}
+nested: {{ partial "nested.html" . }}
+novalue: {{ partial "novalue.html" true }}|{{ partial "novalue.html" false }}
+nil: {{ partial "nil.html" . }}|
+falsy: {{ partial "falsy.html" . }}
+deferred: {{ partial "deferred.html" . }}
+{{ if true }}Before return.{{ return }}{{ end }}
+After return.
+-- layouts/single.html --
+Single before.
+{{ with .Title }}{{ return }}{{ end }}
+Single after.
+-- content/p1.md --
+---
+title: P1
+---
+-- content/p2.md --
+---
+title: ""
+---
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"early: early|late",
+		"nested: 3",
+		"novalue: Before.|Before.After.",
+		"nil: |",
+		"falsy: false",
+		"deferred: x",
+		"Before return.",
+		"! After return.",
+	)
+	b.AssertFileContent("public/p1/index.html", "Single before.", "! Single after.")
+}
