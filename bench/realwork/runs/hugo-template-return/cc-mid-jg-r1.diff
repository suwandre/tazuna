 	c.Assert(got, qt.Contains, "Method: v2 v1")
 }
+
+func TestReturnError(t *testing.T) {
+	c := qt.New(t)
+
+	funcs := FuncMap{
+		"try": func(v any) any { return v },
+		"return": func(args ...any) (any, error) {
+			r := &ReturnError{}
+			if len(args) > 0 {
+				r.Value = args[0]
+				r.HasValue = true
+			}
+			return nil, r
+		},
+	}
+
+	execute := func(tmpl string) (string, error) {
+		templ, err := New("").Funcs(funcs).Parse(tmpl)
+		c.Assert(err, qt.IsNil)
+		var b bytes.Buffer
+		err = templ.Execute(&b, []int{1, 2, 3})
+		return b.String(), err
+	}
+
+	var returnErr *ReturnError
+
+	s, err := execute(`a{{ range . }}{{ if eq . 2 }}{{ return . }}{{ end }}{{ . }}{{ end }}b`)
+	c.Assert(err, qt.ErrorAs, &returnErr)
+	c.Assert(returnErr.Value, qt.Equals, 2)
+	c.Assert(returnErr.HasValue, qt.IsTrue)
+	c.Assert(s, qt.Equals, "a1")
+
+	s, err = execute(`a{{ return }}b`)
+	c.Assert(err, qt.ErrorAs, &returnErr)
+	c.Assert(returnErr.HasValue, qt.IsFalse)
+	c.Assert(s, qt.Equals, "a")
+
+	// try must not swallow an early return.
+	_, err = execute(`{{ with try (return 1) }}{{ end }}b`)
+	c.Assert(err, qt.ErrorAs, &returnErr)
+}
