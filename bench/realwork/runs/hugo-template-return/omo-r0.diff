+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+v1: {{ partial "early.html" 1 }}
+v2: {{ partial "early.html" 2 }}
+v3: {{ partial "early.html" 3 }}
+v4: {{ partial "nil.html" . | printf "%T" }}
+v5: {{ partial "range.html" . }}
+v6: {{ partial "falsy.html" . | printf "%v" }}
+v7: {{ partial "outer.html" . }}
+{{ if true }}before{{ return }}{{ end }}
+not rendered
+-- layouts/_partials/early.html --
+{{- if eq . 1 }}{{ return "one" }}{{ end -}}
+{{- if eq . 2 }}{{ return (printf "two-%d" .) }}{{ end -}}
+rendered
+-- layouts/_partials/nil.html --
+{{ return }}
+-- layouts/_partials/range.html --
+{{ range seq 5 }}{{ if eq . 3 }}{{ return . }}{{ end }}{{ end }}
+-- layouts/_partials/falsy.html --
+{{ return false }}
+-- layouts/_partials/outer.html --
+{{ template "inner" . }}|after-inner|{{ return "outer" }}
+{{ define "inner" }}inner{{ return "ignored" }}not rendered{{ end }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"v1: one",
+		"v2: two-2",
+		"v3: rendered",
+		"v4: &lt;nil&gt;",
+		"v5: 3",
+		"v6: false",
+		"v7: outer",
+		"before",
+	)
+	b.AssertFileContent("public/index.html", "! not rendered")
+}
+
 // See Issue #10789
