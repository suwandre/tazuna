@@ -335,3 +335,99 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+Home start.
+{{ with partial "early.html" 1 }}early:{{ . }}{{ end }}|
+{{ with partial "early.html" 0 }}early:{{ . }}{{ else }}falsy{{ end }}|
+{{ $v := partial "loop.html" (slice 1 2 3 4) }}loop:{{ $v }}|
+{{ $v := partialCached "cached.html" . }}cached:{{ $v }}|
+{{ $v := partial "noval.html" . }}noval:{{ if eq $v nil }}nil{{ end }}|
+{{ $v := partial "dollar.html" 5 }}dollar:{{ $v }}|
+{{ $v := partial "falls-through.html" . }}falls:{{ $v }}|
+{{ partial "nested.html" . }}
+{{ if true }}{{ return }}{{ end }}
+Home not reached.
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}
+  {{ return "one" }}
+{{ end }}
+{{ return 0 }}
+-- layouts/_partials/loop.html --
+{{ $x := 0 }}
+{{ range . }}
+  {{ if gt . 2 }}{{ return $x }}{{ end }}
+  {{ $x = . }}
+{{ end }}
+{{ return "end" }}
+-- layouts/_partials/cached.html --
+{{ return "c" }}
+-- layouts/_partials/noval.html --
+Output is discarded.
+{{ return }}
+-- layouts/_partials/dollar.html --
+{{ with 7 }}{{ return add . $ }}{{ end }}
+-- layouts/_partials/falls-through.html --
+{{ if false }}{{ return "never" }}{{ end }}
+Falls through.
+-- layouts/_partials/nested.html --
+Nested start.|{{ partial "early.html" 1 }}|Nested end.
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"Home start.",
+		"early:one|",
+		"falsy|",
+		"loop:2|",
+		"cached:c|",
+		"noval:nil|",
+		"dollar:12|",
+		"Falls through.|",
+		"Nested start.|one|Nested end.",
+	)
+	b.AssertFileContent("public/index.html", "! Home not reached.")
+}
+
+func TestReturnPipeline(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ partial "p1.html" 3 }}|{{ partial "p2.html" . }}|
+{{ range seq 3 }}{{ . }}{{ if eq . 2 }}{{ return }}{{ end }}{{ end }}
+After.
+-- layouts/_partials/p1.html --
+{{ return add . 1 | string }}
+-- layouts/_partials/p2.html --
+{{ return (slice 1 2) | len }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "4|2|", "12", "! After.")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ partials.Return 1 2 }}
+`
+
+	_, err := hugolib.TestE(t, files)
+	b := qt.New(t)
+	b.Assert(err, qt.ErrorMatches, `(?s).*return takes at most one argument, got 2.*`)
+}
