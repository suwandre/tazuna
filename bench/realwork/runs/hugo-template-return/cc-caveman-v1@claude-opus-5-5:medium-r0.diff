+
+func TestReturnEarlyInPartial(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "page", "rss", "sitemap", "section"]
+-- layouts/home.html --
+Found: {{ partial "find.html" 3 }}|
+NotFound: {{ partial "find.html" 42 | printf "%v" }}|
+Falsy: {{ partial "falsy.html" . | printf "%#v" }}|
+Piped: {{ partial "piped.html" "a" }}|
+Dot: {{ partial "dot.html" "d" }}|
+Cached: {{ partialCached "find.html" 2 2 }}|
+NoValue: {{ partial "novalue.html" . }}|
+NoValueText: {{ (partial "novalue.html" .) | printf "%T" }}|
+Nested: {{ partial "nested.html" 4 }}|
+-- layouts/_partials/find.html --
+{{ range seq 5 }}
+  {{ if eq . $ }}
+    {{ return (printf "found %d" .) }}
+  {{ end }}
+{{ end }}
+-- layouts/_partials/falsy.html --
+{{ if true }}{{ return false }}{{ end }}
+{{ return true }}
+-- layouts/_partials/piped.html --
+{{ . | printf "piped %s" | return }}
+-- layouts/_partials/dot.html --
+{{ with "other" }}{{ return $ }}{{ end }}
+-- layouts/_partials/novalue.html --
+Before.{{ if true }}{{ return }}{{ end }}After.
+-- layouts/_partials/nested.html --
+{{ $v := partial "find.html" . }}
+{{ return (printf "nested %s" $v) }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"Found: found 3|",
+		"NotFound: &lt;nil&gt;|",
+		"Falsy: false|",
+		"Piped: piped a|",
+		"Dot: d|",
+		"Cached: found 2|",
+		"NoValue: Before.|",
+		"NoValueText: template.HTML|",
+		"Nested: nested found 4|",
+	)
+}
+
+func TestReturnEarlyInTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap", "section"]
+-- content/p1.md --
+---
+title: "P1"
+draft: false
+---
+-- content/p2.md --
+---
+title: "P2"
+params:
+  hide: true
+---
+-- layouts/baseof.html --
+Header|{{ block "main" . }}{{ end }}|Footer
+-- layouts/page.html --
+{{ define "main" }}Main:{{ if .Params.hide }}{{ return }}{{ end }}{{ .Title }}{{ end }}
+-- layouts/home.html --
+Home.{{ template "foo" "a" }}{{ template "foo" "b" }}{{ range site.RegularPages }}{{ if eq .Title "P2" }}{{ return }}{{ end }}{{ .Title }}.{{ end }}After.
+{{ define "foo" }}{{ . }}{{ return "ignored" }}Not rendered.{{ end }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Home.ab")
+	b.AssertFileContent("public/index.html", "! After", "! Not rendered", "! ignored")
+	b.AssertFileContent("public/p1/index.html", "Header|Main:P1|Footer")
+	b.AssertFileContent("public/p2/index.html", "Header|Main:|Footer")
+}
+
+func TestReturnEarlyInShortcode(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "home", "rss", "sitemap", "section"]
+-- content/p1.md --
+---
+title: "P1"
+---
+{{< sc "a" >}}|{{< sc "" >}}|
+-- layouts/page.html --
+{{ .Content }}
+-- layouts/_shortcodes/sc.html --
+{{ with .Get 0 }}{{ . }}{{ else }}{{ return }}{{ end }}.
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/p1/index.html", "a.\n|\n|")
+}
+
+func TestReturnInTry(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "page", "rss", "sitemap", "section"]
+-- layouts/home.html --
+{{ partial "p.html" . }}
+-- layouts/_partials/p.html --
+{{ $x := try (return "early") }}{{ return "late" }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "early")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "page", "rss", "sitemap", "section"]
+-- layouts/home.html --
+{{ partial "p.html" . }}
+-- layouts/_partials/p.html --
+{{ $x := 1 }}{{ $x | return 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.ErrorMatches, `(?s).*return takes at most one argument, got 2.*`)
+}
