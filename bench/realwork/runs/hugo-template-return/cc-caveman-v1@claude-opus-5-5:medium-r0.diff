+// Return stops execution of the current template.
+// The optional value is used as the result of a partial.
+func (ns *Namespace) Return(args ...any) (any, error) {
+	if len(args) > 1 {
+		return nil, fmt.Errorf("return takes at most one argument, got %d", len(args))
+	}
+	r := &texttemplate.ReturnError{}
+	if len(args) == 1 {
+		r.Value = args[0]
+	}
+	return nil, r
+}
