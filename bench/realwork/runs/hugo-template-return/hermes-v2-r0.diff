+
+func TestReturn(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+early: {{ partial "early.html" 1 }}|{{ partial "early.html" 2 }}
+range: {{ partial "range.html" (slice 1 2 3 4) }}
+bare: {{ partial "bare.html" . }}
+falsy: {{ printf "%v %T" (partial "falsy.html" .) (partial "falsy.html" .) }}
+dot: {{ partial "dot.html" "ctx" }}
+text: {{ partial "text.txt" . }}
+cached: {{ partialCached "early.html" 2 2 }}
+nested: {{ partial "nested.html" . }}
+command: {{ partial "command.html" 40 }}
+try: {{ with try (partial "try.html" .) }}{{ .Value }}{{ end }}
+no return: {{ partial "noreturn.html" . }}
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+not one
+{{ return "other" }}
+-- layouts/_partials/range.html --
+{{ range . }}{{ if gt . 2 }}{{ return . }}{{ end }}{{ end }}
+{{ return "none" }}
+-- layouts/_partials/bare.html --
+rendered{{ return }}not rendered
+-- layouts/_partials/falsy.html --
+{{ return false }}
+-- layouts/_partials/dot.html --
+{{ return (printf "%v|%v" . $) }}
+-- layouts/_partials/text.txt --
+{{ return "text" }}
+-- layouts/_partials/nested.html --
+{{ $v := partial "early.html" 1 }}{{ return (printf "%s-%s" $v (partial "early.html" 3)) }}
+-- layouts/_partials/command.html --
+{{ return add . 2 | string }}
+-- layouts/_partials/try.html --
+{{ return "tried" }}
+-- layouts/_partials/noreturn.html --
+output
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"early: one|other",
+		"range: 3",
+		"bare: rendered\n",
+		"falsy: false bool",
+		"dot: ctx|ctx",
+		"text: text",
+		"cached: other",
+		"nested: one-other",
+		"command: 42",
+		"try: tried",
+		"no return: output",
+	)
+}
+
+func TestReturnInRegularTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+Before
+{{ if true }}{{ return }}{{ end }}
+After
+-- layouts/page.html --
+{{ define "main" }}
+In main
+{{ with .Title }}{{ return "ignored" }}{{ end }}
+After return in main
+{{ end }}
+-- layouts/baseof.html --
+<body>{{ block "main" . }}{{ end }}</body>
+-- content/p1.md --
+---
+title: P1
+---
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Before")
+	b.AssertFileExists("public/index.html", true)
+	b.AssertFileContentExact("public/p1/index.html", "<body>\nIn main\n</body>")
+	b.AssertFileContent("public/index.html", "! After")
+	b.AssertFileContent("public/p1/index.html", "! After return")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ partial "p.html" . }}
+-- layouts/_partials/p.html --
+{{ 1 | return 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.ErrorMatches, `(?s).*return: expects at most 1 argument, got 2.*`)
+}
