+// ReturnError is the sentinel error that terminates template execution
+// early, see the return keyword. It is returned from ExecuteWithContext
+// when a template returns, so the caller can pick up Value, if any.
+type ReturnError struct {
+	Value    any
+	HasValue bool
+}
+
+func (e *ReturnError) Error() string {
+	return "template return"
+}
+
+// recoverReturn stores a return panic in errp and passes on any other.
+func recoverReturn(errp *error) {
+	if r := recover(); r != nil {
+		re, ok := r.(*ReturnError)
+		if !ok {
+			panic(r)
+		}
+		*errp = re
+	}
+}
+
+// walkTemplate makes a return inside a template invoked with
+// template or block leave only that template.
+func (s *state) walkTemplate(dot reflect.Value, t *parse.TemplateNode) {
+	defer func() {
+		if r := recover(); r != nil {
+			if _, ok := r.(*ReturnError); !ok {
+				panic(r)
+			}
+		}
+	}()
+	s.walkTemplateOld(dot, t)
+}
