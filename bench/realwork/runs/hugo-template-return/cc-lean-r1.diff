+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+Before
+{{ if true }}{{ return }}{{ end }}
+After
+`
+
+	b := hugolib.Test(t, files)
+	b.AssertFileContent("public/index.html", "Before")
+	b.AssertFileContentExact("public/index.html", "Before\n")
+}
+
+func TestReturnEarlyPartials(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+early: {{ partial "early.html" . }}|
+nil: {{ printf "%T" (partial "early-nil.html" .) }}|
+bare1: {{ partial "early-bare.html" true | strings.TrimSpace }}|
+bare2: {{ partial "early-bare.html" false | strings.TrimSpace }}|
+mid1: {{ partial "mid.html" 42 }}|
+mid2: {{ partial "mid.html" false }}|
+nested: {{ partial "nested.html" . }}|
+slice: {{ partial "slice.html" . }}|
+cached: {{ partialCached "early.html" . }}|
+falsy: {{ with partial "zero.html" }}yes{{ else }}no{{ end }}|
+-- layouts/_partials/early.html --
+{{ range seq 10 }}{{ if eq . 3 }}{{ return . }}{{ end }}{{ end }}
+unreachable
+-- layouts/_partials/early-nil.html --
+{{ return nil }}
+-- layouts/_partials/early-bare.html --
+bare-before
+{{ if . }}{{ return }}{{ end }}
+bare-after
+-- layouts/_partials/mid.html --
+{{ $v := "a" }}{{ if . }}{{ $v = "b" }}{{ return (printf "%s-%v" $v .) }}{{ end }}
+{{ return "default" }}
+-- layouts/_partials/nested.html --
+{{ $x := partial "early.html" }}{{ return (add $x 100) }}
+-- layouts/_partials/slice.html --
+{{ return (slice 1 2 3) }}
+-- layouts/_partials/zero.html --
+{{ return 0 }}
+`
+
+	b := hugolib.Test(t, files)
+	b.AssertFileContent("public/index.html",
+		"early: 3|",
+		"nil: &lt;nil&gt;|",
+		"bare1: bare-before|",
+		"bare2: bare-before\n\nbare-after|",
+		"mid1: b-42|",
+		"mid2: default|",
+		"nested: 103|",
+		"slice: [1 2 3]|",
+		"cached: 3|",
+		"falsy: no|",
