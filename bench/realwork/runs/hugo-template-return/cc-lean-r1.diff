+// WrapArgsInPipe replaces the arguments from index from with a single parenthesized
+// pipeline containing a command made up of those arguments, so that
+// "a b c d" with from=1 becomes "a (b c d)".
+// Added for Hugo.
+func (c *CommandNode) WrapArgsInPipe(from int) {
+	if from < 0 || from >= len(c.Args) {
+		return
+	}
+	inner := c.tr.newCommand(c.Args[from].Position())
+	inner.Args = append([]Node(nil), c.Args[from:]...)
+	pipe := c.tr.newPipeline(inner.Pos, 0, nil)
+	pipe.append(inner)
+	c.Args = append(c.Args[:from:from], pipe)
+}
+
 func (c *CommandNode) append(arg Node) {
 	c.Args = append(c.Args, arg)
 }
