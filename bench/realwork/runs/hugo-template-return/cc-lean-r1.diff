@@ -202,3 +203,28 @@ func (ti *CurrentTemplateInfo) Ancestors() CurrentTemplateInfos {
 	}
 	return ancestors
 }
+
+// ReturnError is a sentinel error produced by the template "return" function.
+// It stops the execution of the current template; it is trapped by the template
+// executor, which treats it as a successful early exit. When the template is
+// executed as a partial, the optional Value becomes the result of the partial.
+type ReturnError struct {
+	// Value is the (optional) value passed to return.
+	Value any
+
+	// HasValue is true if a value was passed to return.
+	HasValue bool
+}
+
+func (e *ReturnError) Error() string {
+	return "return called outside of a template execution context"
+}
+
+// IsReturnError reports whether err is, or wraps, a *ReturnError and returns it if so.
+func IsReturnError(err error) (*ReturnError, bool) {
+	var re *ReturnError
+	if errors.As(err, &re) {
+		return re, true
+	}
+	return nil, false
+}
