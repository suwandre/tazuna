+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "http://example.com/"
+-- layouts/_partials/early.html --
+{{ if . }}
+  {{ return "early" }}
+{{ end }}
+{{ range seq 3 }}
+  {{ if eq . 2 }}{{ return (printf "range:%d" .) }}{{ end }}
+{{ end }}
+{{ return "late" }}
+-- layouts/_partials/falsy.html --
+{{ return false }}
+-- layouts/_partials/nilval.html --
+{{ return nil }}
+-- layouts/_partials/noval.html --
+Before.{{ return }}After.
+-- layouts/_partials/pipe.html --
+{{ "piped" | return }}
+-- layouts/_partials/dot.html --
+{{ return (printf "%v|%v" . $) }}
+-- layouts/_partials/nested.html --
+{{ return (printf "nested:%v" (partial "early.html" false)) }}
+-- layouts/_shortcodes/sc.html --
+Before.{{ return }}After.
+-- content/_index.md --
+---
+title: Home
+---
+Content {{< sc >}} done.
+-- layouts/home.html --
+early: {{ partial "early.html" true }}
+range: {{ partial "early.html" false }}
+falsy: {{ partial "falsy.html" . }}
+nil: {{ printf "%T" (partial "nilval.html" .) }}
+noval: {{ partial "noval.html" . }}
+pipe: {{ partial "pipe.html" . }}
+dot: {{ partial "dot.html" "x" }}
+nested: {{ partial "nested.html" . }}
+cached: {{ partialCached "early.html" true }}
+Content: {{ .Content }}
+Start.
+{{ if true }}{{ return }}{{ end }}
+End.
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"early: early",
+		"range: range:2",
+		"falsy: false",
+		"nil: &lt;nil&gt;",
+		"noval: Before.",
+		"pipe: piped",
+		"dot: x|x",
+		"nested: nested:range:2",
+		"cached: early",
+		"Content: <p>Content Before. done.</p>",
+		"Start.",
+	)
+	b.AssertFileContent("public/index.html", "! After.", "! End.")
+}
+
