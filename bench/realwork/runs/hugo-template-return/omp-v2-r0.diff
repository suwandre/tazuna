 }
+
+func TestReturnEarlyInTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+disableKinds = ["page", "section", "taxonomy", "term", "rss", "sitemap", "robotsTXT", "404"]
+-- layouts/home.html --
+before
+{{ range seq 3 }}{{ if eq . 2 }}{{ return }}{{ end }}{{ . }}{{ end }}
+after
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContentExact("public/index.html", "before\n1")
+}
+
+func TestReturnInPartial(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+disableKinds = ["page", "section", "taxonomy", "term", "rss", "sitemap", "robotsTXT", "404"]
+-- layouts/home.html --
+early: {{ partial "early.html" 1 }}|{{ partial "early.html" 0 }}
+cached: {{ partialCached "early.html" 1 }}
+falsy: {{ partial "falsy.html" . | printf "%T" }}
+nothing: {{ partial "nothing.html" . | printf "%T" }}
+nested: {{ partial "nested.html" . }}
+output: {{ partial "output.html" . }}
+-- layouts/_partials/early.html --
+{{ if . }}{{ return "yes" }}{{ end }}
+{{ return "no" }}
+-- layouts/_partials/falsy.html --
+{{ return false }}
+-- layouts/_partials/nothing.html --
+ignored
+{{ return }}
+-- layouts/_partials/nested.html --
+{{ range seq 5 }}{{ if eq . 3 }}{{ return (printf "found %d" .) }}{{ end }}{{ end }}
+unreachable
+-- layouts/_partials/output.html --
+output
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"early: yes|no",
+		"cached: yes",
+		"falsy: bool",
+		"nothing: &lt;nil&gt;",
+		"nested: found 3",
+		"output: output",
+	)
+}
+
+func TestReturnInDefinedTemplateExitsOnlyThatTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+disableKinds = ["page", "section", "taxonomy", "term", "rss", "sitemap", "robotsTXT", "404"]
+-- layouts/home.html --
+{{ template "foo" . }}|after
+{{ define "foo" }}a{{ return }}b{{ end }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "a|after")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ templates.Return 1 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "return takes at most 1 argument")
+}
