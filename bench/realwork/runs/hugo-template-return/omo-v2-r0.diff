diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..31aa7e6 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,91 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarlyInPartial(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+neg:{{ partial "sign.html" -1 }}|pos:{{ partial "sign.html" 1 }}|
+first:{{ partial "first.html" (slice 1 2 3 4) }}|
+nil:{{ partial "nil.html" . | printf "%T" }}|
+bare:{{ partial "bare.html" . }}|
+falsy:{{ if partial "falsy.html" . }}yes{{ else }}no{{ end }}|
+cached:{{ partialCached "sign.html" -1 }}|
+-- layouts/_partials/sign.html --
+{{ if lt . 0 }}{{ return "negative" }}{{ end }}
+{{ return "positive" }}
+-- layouts/_partials/first.html --
+{{ range . }}{{ if gt . 2 }}{{ return . }}{{ end }}{{ end }}
+{{ return "none" }}
+-- layouts/_partials/nil.html --
+{{ return nil }}
+-- layouts/_partials/bare.html --
+before{{ return }}after
+-- layouts/_partials/falsy.html --
+{{ return false }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"neg:negative|pos:positive|",
+		"first:3|",
+		"nil:&lt;nil&gt;|",
+		"bare:|",
+		"falsy:no|",
+		"cached:negative|",
+	)
+}
+
+func TestReturnEarlyInTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- content/p1.md --
+---
+title: p1
+---
+-- content/p2.md --
+---
+title: p2
+params:
+  skip: true
+---
+-- layouts/home.html --
+home|{{ partial "inner.html" . }}|after partial
+-- layouts/page.html --
+start|{{ if .Params.skip }}{{ return }}{{ end }}|{{ .Title }}|end
+-- layouts/_partials/inner.html --
+{{ return "x" }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "home|x|after partial")
+	b.AssertFileContent("public/p1/index.html", "start||p1|end")
+	b.AssertFileContentExact("public/p2/index.html", "start|")
+	b.AssertFileContent("public/p2/index.html", "! end")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ partial "p.html" . }}
+-- layouts/_partials/p.html --
+{{ return 1 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "return takes at most one argument")
+}
