+// ReturnError is the sentinel error produced by the return template function.
+// It stops the execution of the current template and is returned from
+// ExecuteWithContext, carrying the (optional) return value.
+type ReturnError struct {
+	Value any
+}
+
+func (e *ReturnError) Error() string {
+	return "return"
+}
+
 func (t *Template) executeWithState(state *state, value reflect.Value) (err error) {
 	defer errRecover(&err)
+	defer func() {
+		if r := recover(); r != nil {
+			if re, ok := r.(*ReturnError); ok {
+				err = re
+				return
+			}
+			panic(r)
+		}
+	}()
 	if t.Tree == nil || t.Root == nil {
 		state.errorf("%q is an incomplete or empty template", t.Name())
 	}
@@ -413,6 +434,11 @@ func (s *state) evalCall(dot, fun reflect.Value, isBuiltin bool, node parse.Node
 	// If we have an error that is not nil, stop execution and return that
 	// error to the caller.
 	if err != nil {
+		// Added for Hugo. Unwind to the template's executeWithState.
+		var re *ReturnError
+		if errors.As(err, &re) {
+			panic(re)
+		}
 		s.at(node)
 		s.errorf("error calling %s: %w", name, err)
 	}
