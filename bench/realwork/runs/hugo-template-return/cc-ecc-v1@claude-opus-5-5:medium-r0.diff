@@ -335,3 +335,97 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap", "404"]
+-- layouts/home.html --
+Even: {{ partial "even.html" 2 }}|{{ partial "even.html" 3 }}|
+Range: {{ partial "range.html" (slice 1 2 3 4) }}|
+Unwrapped: {{ partial "unwrapped.html" 1 }}|
+Falsy: {{ with partial "falsy.html" . }}truthy{{ else }}falsy{{ end }}|
+Nil: {{ printf "%v" (partial "nil.html" .) }}|
+NoValue: {{ partial "novalue.html" true }}|{{ partial "novalue.html" false }}|
+Define: {{ partial "define.html" . }}|
+Try: {{ with try (partial "even.html" 4) }}{{ .Value }}{{ end }}|
+{{ if true }}{{ return }}{{ end }}
+After return.
+-- layouts/_partials/even.html --
+{{ if eq (mod . 2) 0 }}
+  {{ return true }}
+{{ end }}
+{{ return false }}
+-- layouts/_partials/range.html --
+{{ range . }}
+  {{ if eq . 3 }}
+    {{ return . }}
+  {{ end }}
+{{ end }}
+{{ return 0 }}
+-- layouts/_partials/unwrapped.html --
+{{ if true }}{{ return add . 42 | printf "%d!" }}{{ end }}
+-- layouts/_partials/falsy.html --
+{{ return "" }}
+-- layouts/_partials/nil.html --
+{{ return nil }}
+-- layouts/_partials/novalue.html --
+{{- "before" -}}
+{{- if . }}{{ return }}{{ end -}}
+{{- "after" -}}
+-- layouts/_partials/define.html --
+{{- template "inner" . -}}
+{{- "after" -}}
+{{- define "inner" }}{{ "inner" }}{{ return }}{{ "notrendered" }}{{ end -}}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"Even: true|false|",
+		"Range: 3|",
+		"Unwrapped: 43!|",
+		"Falsy: falsy|",
+		"Nil: &lt;nil&gt;|",
+		"NoValue: before|beforeafter|",
+		"Define: innerafter|",
+		"Try: true|",
+		"! After return.",
+		"! notrendered",
+	)
+}
+
+func TestReturnEarlyInBlock(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap", "404"]
+-- layouts/baseof.html --
+Header|{{ block "main" . }}{{ end }}|Footer
+-- layouts/home.html --
+{{ define "main" }}Main{{ if true }}{{ return }}{{ end }}After{{ end }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Header|Main|Footer")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap", "404"]
+-- layouts/home.html --
+{{ partial "p.html" . }}
+-- layouts/_partials/p.html --
+{{ templates.Return 1 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.ErrorMatches, `(?s).*return takes at most 1 argument, got 2.*`)
+}
