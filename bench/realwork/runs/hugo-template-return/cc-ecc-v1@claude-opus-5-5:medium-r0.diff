+// Return stops execution of the current template.
+// In partials, the optional value is returned to the caller instead of the rendered output.
+func (ns *Namespace) Return(args ...any) (any, error) {
+	if len(args) > 1 {
+		return nil, fmt.Errorf("return takes at most 1 argument, got %d", len(args))
+	}
+	re := &texttemplate.ReturnError{}
+	if len(args) == 1 {
+		re.Value, re.HasValue = args[0], true
+	}
+	return nil, re
+}
+
