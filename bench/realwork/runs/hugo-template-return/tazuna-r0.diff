+// Added for Hugo. This file contains Hugo related addons.
+// All the other files in this package are auto generated.
+
+// WrapArgsInPipe replaces the arguments of the command from index i with a
+// single parenthesized pipeline holding them, so {{ f a b c }} with i = 1
+// becomes {{ f (a b c) }}. The new nodes belong to the same tree and
+// position as c, so error messages point to the original source.
+func (c *CommandNode) WrapArgsInPipe(i int) {
+	if i < 0 || i >= len(c.Args) {
+		return
+	}
+	cmd := &CommandNode{tr: c.tr, NodeType: NodeCommand, Pos: c.Args[i].Position(), Args: append([]Node(nil), c.Args[i:]...)}
+	pipe := &PipeNode{tr: c.tr, NodeType: NodePipe, Pos: cmd.Pos, Cmds: []*CommandNode{cmd}}
+	c.Args = append(c.Args[:i:i], pipe)
+}
