+// ReturnError is the sentinel error produced by the "return" template keyword.
+// It terminates the execution of the current template, and is trapped by the
+// template executor. Value is the optional return value, used by partials.
+type ReturnError struct {
+	Value any
+}
+
+func (e *ReturnError) Error() string {
+	return "return called outside of a template execution"
+}
+
+// AsReturnError reports whether err is, or wraps, a *ReturnError.
+func AsReturnError(err error) (*ReturnError, bool) {
+	var re *ReturnError
+	if errors.As(err, &re) {
+		return re, true
+	}
+	return nil, false
+}
