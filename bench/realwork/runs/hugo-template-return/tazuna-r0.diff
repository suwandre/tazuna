+// Return terminates the execution of the current template. If a value is
+// provided, it will be the return value when used in a partial.
+// This is implemented with a sentinel error that is trapped by the template executor.
+func (ns *Namespace) Return(args ...any) (any, error) {
+	re := &tpl.ReturnError{}
+	if len(args) > 0 {
+		re.Value = args[0]
+	}
+	return nil, re
+}
