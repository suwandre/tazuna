 }
+
+func TestReturnInRegularTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["page", "section", "taxonomy", "term", "RSS", "sitemap", "robotsTXT", "404"]
+-- layouts/home.html --
+Before.
+{{ range seq 3 -}}
+{{ if eq . 2 }}{{ return }}{{ end -}}
+Item {{ . }}.
+{{ end -}}
+After.
+`
+	b := hugolib.Test(t, files)
+	b.AssertFileContent("public/index.html", "Before.", "Item 1.")
+	b.AssertFileContentExact("public/index.html", "Before.\nItem 1.\n")
+}
+
+func TestReturnPartialValues(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["page", "section", "taxonomy", "term", "RSS", "sitemap", "robotsTXT", "404"]
+-- layouts/home.html --
+early: {{ partial "early.html" true }}|{{ partial "early.html" false | strings.TrimSpace }}
+novalue: {{ printf "%T" (partial "novalue.html" .) }}
+nested: {{ partial "nested.html" . }}
+viatemplate: {{ partial "viatemplate.html" . }}
+falsy: {{ partial "falsy.html" . }}
+dot: {{ partial "dot.html" (dict "a" "A" "b" "B") }}
+range: {{ partial "range.html" (slice 1 2 3) }}
+cached: {{ partialCached "last.html" . }}
+templatesreturn: {{ partial "templatesreturn.html" . }}
+-- layouts/_partials/early.html --
+{{ if . }}{{ return "early" }}{{ end }}
+Not early.
+-- layouts/_partials/novalue.html --
+Output before.
+{{ return }}
+Output after.
+-- layouts/_partials/nested.html --
+{{ return (printf "%v/%v" (partial "early.html" true) (partial "early.html" false | strings.TrimSpace)) }}
+-- layouts/_partials/viatemplate.html --
+{{ template "inner" . }}
+Not reached.
+{{ define "inner" }}{{ return (slice 1 2) }}{{ end }}
+-- layouts/_partials/falsy.html --
+{{ return 0 }}
+-- layouts/_partials/dot.html --
+{{ with .a }}{{ return (printf "%s-%s" . $.b) }}{{ end }}
+-- layouts/_partials/last.html --
+{{ return "last" }}
+-- layouts/_partials/range.html --
+{{ range . }}{{ if eq . 2 }}{{ return . }}{{ end }}{{ end }}
+none
+-- layouts/_partials/templatesreturn.html --
+{{ templates.Return "viafullname" }}
+Not reached.
+`
+	b := hugolib.Test(t, files)
+	b.AssertFileContent("public/index.html",
+		"early: early|Not early.",
+		"novalue: &lt;nil&gt;",
+		"nested: early/Not early.",
+		"viatemplate: [1 2]",
+		"falsy: 0",
+		"dot: A-B",
+		"range: 2",
+		"cached: last",
+		"templatesreturn: viafullname",
+	)
+}
