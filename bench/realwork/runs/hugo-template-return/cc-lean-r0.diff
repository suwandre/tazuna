+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["page", "section", "taxonomy", "term", "rss", "sitemap", "404"]
+-- layouts/home.html --
+Start.
+{{ partial "early.html" 1 }}|{{ partial "early.html" 2 }}|{{ partial "novalue.html" . }}|{{ partial "noreturn.html" . }}
+{{ partial "pipe.html" 42 }}|{{ partial "range.html" (slice 1 2 3 4) }}
+{{ template "inner" . }}After template.
+{{ if true }}Early.{{ return }}{{ end }}
+Not reached.
+{{ define "inner" }}Inner.{{ return }}Inner not reached.{{ end }}
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ return "other" }}
+-- layouts/_partials/novalue.html --
+Output is discarded.{{ return }}
+-- layouts/_partials/noreturn.html --
+Just output.
+-- layouts/_partials/pipe.html --
+{{ return add . 1 | string }}
+-- layouts/_partials/range.html --
+{{ range . }}{{ if eq . 3 }}{{ return (printf "found %d" .) }}{{ end }}{{ end }}
+{{ return "not found" }}
+`
+
+	b := hugolib.Test(t, files)
+	b.AssertFileContent("public/index.html",
+		"Start.", "one|other||Just output.", "43|found 3", "Inner.After template.", "Early.")
+	b.AssertFileContent("public/index.html", "! Not reached", "! Inner not reached")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/home.html --
+{{ return 1 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "return: expected at most 1 argument")
 }
 
