+// ReturnError is a sentinel error used to implement the "return" keyword.
+// It is raised by the "return" function and trapped by the template execution,
+// which stops executing the current template.
+// Value is the optional value to return, e.g. from a partial.
+type ReturnError struct {
+	Value any
+}
+
+func (e *ReturnError) Error() string {
+	return "template: return called outside of a template execution"
+}
+
+// AsReturnError reports whether err is, or wraps, a *ReturnError.
+func AsReturnError(err error) (*ReturnError, bool) {
+	var re *ReturnError
+	if errors.As(err, &re) {
+		return re, true
+	}
+	return nil, false
+}
+
 // newErrorWithCause creates a new error with the given cause.
 func newErrorWithCause(err error) *TryError {
 	return &TryError{Err: err, Cause: herrors.Cause(err)}
