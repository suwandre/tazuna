+func TestTemplateExecutorReturn(t *testing.T) {
+	c := qt.New(t)
+
+	funcs := FuncMap{
+		"try": func(v any) any { return v },
+		"return": func(args ...any) (any, error) {
+			if len(args) == 0 {
+				return nil, &ReturnError{}
+			}
+			return nil, &ReturnError{Value: args[0], HasValue: true}
+		},
+	}
+
+	execute := func(templ string) (*ReturnError, string, error) {
+		data := [][]int{{1, 2, 3}}
+		t, err := New("").Funcs(funcs).Parse(templ)
+		c.Assert(err, qt.IsNil)
+		var b bytes.Buffer
+		ret, err := NewExecuter(&plainExecHelper{}).ExecuteWithContextAndReturn(context.Background(), t, &b, data)
+		return ret, b.String(), err
+	}
+
+	ret, out, err := execute(`a{{ return 42 }}b`)
+	c.Assert(err, qt.IsNil)
+	c.Assert(ret, qt.DeepEquals, &ReturnError{Value: 42, HasValue: true})
+	c.Assert(out, qt.Equals, "a")
+
+	ret, out, err = execute(`a{{ return }}b`)
+	c.Assert(err, qt.IsNil)
+	c.Assert(ret, qt.DeepEquals, &ReturnError{})
+	c.Assert(out, qt.Equals, "a")
+
+	ret, out, err = execute(`{{ range (index . 0) }}{{ if eq . 2 }}{{ return . }}{{ end }}{{ . }}{{ end }}`)
+	c.Assert(err, qt.IsNil)
+	c.Assert(ret.Value, qt.Equals, 2)
+	c.Assert(out, qt.Equals, "1")
+
+	// No return.
+	ret, out, err = execute(`a`)
+	c.Assert(err, qt.IsNil)
+	c.Assert(ret == nil, qt.IsTrue)
+	c.Assert(out, qt.Equals, "a")
+
+	// A return in an invoked template only ends that template.
+	ret, out, err = execute(`{{ define "t" }}x{{ return 1 }}y{{ end }}a{{ template "t" }}b`)
+	c.Assert(err, qt.IsNil)
+	c.Assert(ret == nil, qt.IsTrue)
+	c.Assert(out, qt.Equals, "axb")
+
+	// try must not swallow return.
+	ret, out, err = execute(`a{{ $v := try (return 1) }}b`)
+	c.Assert(err, qt.IsNil)
+	c.Assert(ret.Value, qt.Equals, 1)
+	c.Assert(out, qt.Equals, "a")
+
+	// The plain Execute does not fail on return.
+	templ, err := New("").Funcs(funcs).Parse(`a{{ return 1 }}b`)
+	c.Assert(err, qt.IsNil)
+	var b bytes.Buffer
+	c.Assert(templ.Execute(&b, nil), qt.IsNil)
+	c.Assert(b.String(), qt.Equals, "a")
+}
