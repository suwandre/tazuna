+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+P1: {{ partial "p1.html" 1 }}|{{ partial "p1.html" 2 }}
+P2: {{ partial "p2.html" . }}
+P3: {{ partial "p3.html" . }}
+P4: {{ partial "p4.html" . }}
+P5: {{ partial "p5.html" . }}
+P6: {{ partialCached "p1.html" 1 }}
+P7: {{ partial "p6.html" . }}
+{{ template "early" . }}
+After template.
+{{ if true }}
+Early home.
+{{ return }}
+{{ end }}
+Not reached.
+{{ define "early" }}Early inline.{{ return }}Not reached inline.{{ end }}
+-- layouts/_partials/p1.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ return "other" }}
+-- layouts/_partials/p2.html --
+{{ range seq 10 }}{{ if eq . 3 }}{{ return . }}{{ end }}{{ end }}
+{{ return "none" }}
+-- layouts/_partials/p3.html --
+Rendered{{ return }} not reached.
+-- layouts/_partials/p4.html --
+{{ return nil }}
+-- layouts/_partials/p5.html --
+{{ return add 1 2 }}
+-- layouts/_partials/p6.html --
+{{ $v := try (return "tried") }}
+Not reached.
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"P1: one|other",
+		"P2: 3",
+		"P3: Rendered",
+		"P4: \n",
+		"P5: 3",
+		"P6: one",
+		"P7: tried",
+		"Early inline.",
+		"After template.",
+		"Early home.",
+	)
+	b.AssertFileContent("public/index.html", "! Not reached")
+}
