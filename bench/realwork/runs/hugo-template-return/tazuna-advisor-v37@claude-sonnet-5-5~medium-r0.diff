--- a/hugolib/template_test.go
+++ b/hugolib/template_test.go
@@ -586,3 +586,42 @@ page.html.d
 
 	b.AssertFileContent("public/p1/index.b", "page.html.b")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "http://example.com/"
+-- layouts/home.html --
+Before.
+{{ if true }}{{ return }}{{ end }}
+After.
+-- layouts/_partials/early.html --
+A.{{ if . }}{{ return "early" }}{{ end }}B.
+-- layouts/_partials/early-nil.html --
+A.{{ range seq 3 }}{{ if eq . 2 }}{{ return nil }}{{ end }}{{ . }}{{ end }}B.
+-- layouts/_partials/early-noval.html --
+A.{{ with . }}{{ return }}{{ end }}B.
+-- layouts/_partials/falsy.html --
+{{ return false }}
+-- layouts/_partials/tmpl.html --
+{{ template "inner" . }}Outer.
+{{ define "inner" }}Inner.{{ return }}Never.{{ end }}
+-- layouts/page.html --
+{{ partial "early.html" true }}|{{ partial "early.html" false }}|{{ partial "early-nil.html" . }}|{{ partial "early-noval.html" 1 }}|{{ partial "early-noval.html" 0 }}|{{ partial "falsy.html" . }}|{{ partialCached "early.html" true }}|{{ partial "tmpl.html" . }}
+{{ with try (partial "early.html" true) }}{{ .Value }}{{ end }}
+-- content/p1.md --
+---
+title: p1
+---
+`
+
+	b := Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Before.")
+	b.AssertFileContentExact("public/index.html", "Before.\n")
+	b.AssertFileContent("public/p1/index.html",
+		"early|A.B.||A.|A.B.|false|early|Inner.Outer.",
+	)
+}
