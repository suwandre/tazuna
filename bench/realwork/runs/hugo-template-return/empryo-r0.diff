diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..4e16711 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,107 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarlyRegularTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+Before.
+{{ if true }}
+{{ return }}
+{{ end }}
+After.
+-- layouts/page.html --
+Page before.
+{{ range seq 3 }}{{ if eq . 2 }}{{ return "ignored" }}{{ end }}R{{ . }}.{{ end }}
+Page after.
+-- content/p1.md --
+---
+title: p1
+---
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Before.")
+	b.AssertFileContentExact("public/index.html", "Before.\n")
+	b.AssertFileContent("public/p1/index.html", "Page before.", "R1.")
+	b.AssertFileContentExact("public/p1/index.html", "Page before.\nR1.")
+}
+
+func TestReturnEarlyInPartial(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+a: {{ partial "early.html" 1 }}
+b: {{ partial "early.html" 2 }}
+c: {{ partial "range.html" (slice 1 2 3 4) }}
+d: {{ partial "bare.html" . }}
+e: {{ partial "falsy.html" . | printf "%t" }}
+f: {{ partialCached "early.html" 1 1 }}
+g: {{ partial "dollar.html" "dollar" }}
+h: {{ partial "template.html" . }}
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}
+  {{ return "one" }}
+{{ end }}
+{{ return "other" }}
+-- layouts/_partials/range.html --
+{{ range . }}
+  {{ if gt . 2 }}
+    {{ return . }}
+  {{ end }}
+{{ end }}
+{{ return "none" }}
+-- layouts/_partials/bare.html --
+Output.
+{{ return }}
+Not rendered.
+-- layouts/_partials/falsy.html --
+{{ return false }}
+Not reached.
+-- layouts/_partials/dollar.html --
+{{ with "inner" }}{{ return printf "%s-%s-%s" . $ . }}{{ end }}
+-- layouts/_partials/template.html --
+{{ template "inner" . }}
+After inner.
+{{ define "inner" }}
+{{ return "ignored" }}
+{{ end }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"a: one",
+		"b: other",
+		"c: 3",
+		"d: Output.",
+		"e: false",
+		"f: one",
+		"g: inner-dollar-inner",
+		"After inner.",
+	)
+}
+
+func TestReturnInvalidArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ return 1 2 }}
+`
+
+	_, err := hugolib.TestE(t, files)
+	b := qt.New(t)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "can't give argument to non-function 1")
+}
