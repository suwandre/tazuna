index 79a92f1..20d27e7 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,53 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+Start.
+{{ partial "cond.html" 1 }}|{{ partial "cond.html" 2 }}|{{ partial "cond.html" 3 }}
+{{ partial "range.html" (slice 1 2 3 4) }}
+{{ with partial "noval.html" }}truthy{{ else }}falsy{{ end }}
+{{ partial "nested.html" . }}
+{{ partialCached "cached.html" "a" }}
+{{ if true }}Before return.{{ return }}{{ end }}
+This should not be rendered.
+-- layouts/_partials/cond.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ if eq . 2 }}{{ return "two" }}{{ end }}
+{{ return "other" | upper }}
+-- layouts/_partials/range.html --
+{{ range . }}
+  {{ if gt . 2 }}{{ return . }}{{ end }}
+{{ end }}
+{{ return "none" }}
+-- layouts/_partials/noval.html --
+Output is discarded.
+{{ return }}
+-- layouts/_partials/nested.html --
+{{ template "inner" . }}
+{{ return "not reached" }}
+{{ define "inner" }}{{ return "from inner" }}{{ end }}
+-- layouts/_partials/cached.html --
+{{ return (printf "cached-%s" .) }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"Start.",
+		"one|two|OTHER",
+		"3",
+		"falsy",
+		"from inner",
+		"cached-a",
+		"Before return.",
+	)
+	b.AssertFileContentExact("public/index.html", "Start.\none|two|OTHER\n3\nfalsy\nfrom inner\ncached-a\nBefore return.")
+	b.AssertFileContent("public/index.html", "! This should not be rendered")
+}
