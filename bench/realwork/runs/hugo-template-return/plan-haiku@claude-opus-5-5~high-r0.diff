+// ReturnError is used to stop the execution of the current template early,
+// optionally with a value.
+type ReturnError struct {
+	Value    any
+	HasValue bool
+}
+
+func (*ReturnError) Error() string { return "return" }
+
+// recoverReturn stops a panic caused by return, storing it in errp if it has a value.
+// Any other panic is propagated.
+func recoverReturn(errp *error) {
+	r := recover()
+	if r == nil {
+		return
+	}
+	rerr, ok := r.(*ReturnError)
+	if !ok {
+		panic(r)
+	}
+	if errp != nil && rerr.HasValue {
+		*errp = rerr
+	}
+}
