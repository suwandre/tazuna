+
+func TestReturn(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- layouts/baseof.html --
+{{ block "main" . }}{{ end }}|footer
+-- layouts/home.html --
+{{ define "main" }}
+find: {{ partial "find.html" (slice 1 2 3 4) }}|
+findnone: {{ partial "find.html" (slice 5 6) }}|
+cached: {{ partialCached "find.html" (slice 3) "k" }}|
+render: {{ partial "render.html" "foo" }}|
+renderempty: {{ partial "render.html" "" }}|
+dollar: {{ partial "dollar.html" (dict "v" 42) }}|
+dict: {{ (partial "dict.html" 2).a }}|
+main|{{ if true }}{{ return }}{{ end }}notrendered
+{{ end }}
+-- layouts/page.html --
+{{ .Content }}
+-- layouts/_partials/find.html --
+{{ range . }}{{ if eq . 3 }}{{ return . }}{{ end }}{{ end }}
+{{ return 0 }}
+-- layouts/_partials/render.html --
+{{ if not . }}empty{{ return }}{{ end }}value: {{ . }}
+-- layouts/_partials/dollar.html --
+{{ with .v }}{{ return $.v }}{{ end }}
+-- layouts/_partials/dict.html --
+{{ return dict "a" (add . 40) }}
+-- layouts/_shortcodes/sc.html --
+sc-before|{{ return }}sc-after
+-- content/p1.md --
+---
+title: p1
+---
+{{< sc >}}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"find: 3|", "findnone: 0|", "cached: 3|",
+		"render: value: foo", "renderempty: empty|", "dollar: 42|", "dict: 42|",
+		"main|", "|footer", "! notrendered")
+	b.AssertFileContent("public/p1/index.html", "sc-before|", "! sc-after")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/home.html --
+{{ partial "p.html" . }}
+-- layouts/_partials/p.html --
+{{ 2 | return 1 }}
+`
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "return takes at most one argument")
+}
