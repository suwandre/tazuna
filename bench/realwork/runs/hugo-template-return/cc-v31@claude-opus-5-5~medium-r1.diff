+// Return stops the execution of the current template.
+// In partials, the optional argument is used as the return value.
+func (ns *Namespace) Return(args ...any) (any, error) {
+	if len(args) > 1 {
+		return nil, fmt.Errorf("return takes at most one argument, got %d", len(args))
+	}
+	re := &texttemplate.ReturnError{}
+	if len(args) == 1 {
+		re.Value = args[0]
+	}
+	return nil, re
+}
