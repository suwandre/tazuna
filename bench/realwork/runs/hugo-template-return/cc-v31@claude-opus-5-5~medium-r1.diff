+// See https://github.com/golang/go/issues/53015.
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- layouts/baseof.html --
+Header|{{ block "main" . }}{{ end }}|Footer
+-- layouts/home.html --
+{{ define "main" }}Main|{{ if true }}{{ return }}{{ end }}AfterReturn{{ end }}
+-- layouts/page.html --
+Page|{{ template "sub" . }}|AfterSub|{{ return }}AfterReturn
+{{ define "sub" }}Sub|{{ return 42 }}AfterSubReturn{{ end }}
+-- layouts/section.html --
+{{ range seq 3 }}{{ . }}|{{ if eq . 2 }}{{ return }}{{ end }}{{ end }}AfterRange
+-- layouts/_partials/classify.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ range seq 5 }}{{ if eq . 3 }}{{ return "three" }}{{ end }}{{ end }}
+{{ return "other" }}
+-- layouts/_partials/piped.html --
+{{ . | add 1 | return }}
+-- layouts/_partials/noreturn.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+-- layouts/_partials/render.html --
+Before|{{ if . }}{{ return }}{{ end }}After
+-- content/p.md --
+---
+title: p
+---
+-- content/s/_index.md --
+---
+title: s
+---
+-- layouts/_partials/all.html --
+{{ return dict "classify1" (partial "classify" 1) "classify2" (partial "classify" 2) "piped" (partial "piped" 41) "noreturn" (partial "noreturn" 2) }}
+-- layouts/404.html --
+{{ $m := partial "all" . }}classify1: {{ $m.classify1 }}|classify2: {{ $m.classify2 }}|piped: {{ $m.piped }}|noreturn: {{ $m.noreturn }}|
+render: {{ partial "render" true }}|{{ partial "render" false }}|
+cached: {{ partialCached "classify" 1 1 }}|
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Header|Main||Footer")
+	b.AssertFileContent("public/p/index.html", "Page|Sub||AfterSub|")
+	b.AssertFileContent("public/s/index.html", "1|2|")
+	b.AssertFileContent("public/404.html",
+		"classify1: one|classify2: three|piped: 42|noreturn: |",
+		"render: Before||Before|After|",
+		"cached: one|",
+	)
+	b.AssertFileContentExact("public/index.html", "Header|Main||Footer")
+	b.AssertFileContent("public/p/index.html", "! AfterReturn", "! AfterSubReturn")
+	b.AssertFileContent("public/s/index.html", "! AfterRange", "! 3|")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- layouts/home.html --
+{{ 1 | return 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.ErrorMatches, `(?s).*return takes at most one argument, got 2.*`)
+}
