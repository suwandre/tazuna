+	}
+	if len(n.Args) > 2 {
+		cmd := &parse.CommandNode{NodeType: parse.NodeCommand, Pos: n.Args[1].Position(), Args: n.Args[1:]}
+		pipe := &parse.PipeNode{NodeType: parse.NodePipe, Pos: cmd.Pos, Cmds: []*parse.CommandNode{cmd}}
+		n.Args = []parse.Node{n.Args[0], pipe}
+	}
+	if c.t.category == CategoryPartial && (len(n.Args) > 1 || piped) {
+		c.t.ParseInfo.HasReturn = true
+	}
 }
