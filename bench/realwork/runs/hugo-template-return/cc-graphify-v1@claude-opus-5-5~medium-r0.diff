+// ReturnError is a sentinel error used to stop template execution early.
+// It's returned by the "return" template func.
+type ReturnError struct {
+	Value    any
+	HasValue bool
+}
+
+func (e *ReturnError) Error() string {
+	return "return"
+}
+
+// recoverReturn recovers a ReturnError panic and stores it in errp.
+func recoverReturn(errp *error) {
+	if r := recover(); r != nil {
+		re, ok := r.(*ReturnError)
+		if !ok {
+			panic(r)
+		}
+		*errp = re
+	}
+}
