+// See issue 53015 in golang/go.
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "http://example.com/"
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ range seq 5 }}{{ if eq . 3 }}{{ return "three" }}{{ end }}{{ end }}
+{{ return "other" }}
+-- layouts/_partials/novalue.html --
+before|{{ if . }}{{ return }}{{ end }}after|
+-- layouts/_partials/nested.html --
+{{ return (printf "nested-%v" (partial "early.html" .)) }}
+-- layouts/_partials/try.html --
+{{ $r := try (return "fromtry") }}
+{{ return "nottry" }}
+-- layouts/_partials/pipe.html --
+{{ return printf "%s-%s" "a" "b" | upper }}
+-- layouts/baseof.html --
+Base: {{ block "main" . }}{{ end }}|End.
+-- layouts/home.html --
+{{ define "main" }}
+Early: {{ partial "early.html" 1 }}|{{ partial "early.html" 2 }}|
+Novalue: {{ partial "novalue.html" true }}{{ partial "novalue.html" false }}
+Nested: {{ partial "nested.html" 1 }}|
+Try: {{ partial "try.html" . }}|
+Pipe: {{ partial "pipe.html" }}|
+Template: {{ template "inline" . }}|
+{{ return }}
+Not rendered.
+{{ end }}
+{{ define "inline" }}inline{{ return }}Not rendered.{{ end }}
+-- layouts/page.html --
+Page: {{ .Title }}|{{ return }}Not rendered.
+-- content/p1.md --
+---
+title: p1
+---
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"Early: one|three|",
+		"Novalue: before|before|after|",
+		"Nested: nested-one|",
+		"Try: fromtry|",
+		"Pipe: A-B|",
+		"Template: inline|",
+		"|End.",
+	)
+	b.AssertFileContent("public/index.html", "! Not rendered.")
+	b.AssertFileContent("public/p1/index.html", "Page: p1|", "! Not rendered.")
+}
+
