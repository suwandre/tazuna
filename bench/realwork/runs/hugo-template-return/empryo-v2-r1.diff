diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..06fb77c 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,100 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarlyInPartial(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+A: {{ partial "early.html" 1 }}
+B: {{ partial "early.html" 2 }}
+C: {{ partial "early.html" 3 }}
+D: {{ partial "noarg.html" . | printf "%T" }}
+E: {{ partial "range.html" (slice 1 2 3 4) }}
+F: {{ partial "nested.html" . }}
+G: {{ partialCached "early.html" 1 }}
+H: {{ partial "pipe.html" 5 }}
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ if eq . 2 }}
+  {{ return (printf "two-%d" .) }}
+{{ end }}
+{{ return "other" }}
+not reached
+-- layouts/_partials/noarg.html --
+output
+{{ return }}
+not reached
+-- layouts/_partials/range.html --
+{{ range . }}{{ if gt . 2 }}{{ return . }}{{ end }}{{ end }}
+{{ return "none" }}
+-- layouts/_partials/nested.html --
+{{ with partial "early.html" 1 }}{{ return (printf "nested-%s" .) }}{{ end }}
+{{ return "fail" }}
+-- layouts/_partials/pipe.html --
+{{ . | add 1 | return }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"A: one",
+		"B: two-2",
+		"C: other",
+		"D: &lt;nil&gt;",
+		"E: 3",
+		"F: nested-one",
+		"G: one",
+		"H: 6",
+	)
+}
+
+func TestReturnEarlyInRegularTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+disableKinds = ["taxonomy", "term", "section", "rss", "sitemap"]
+-- content/p1.md --
+---
+title: p1
+---
+-- layouts/home.html --
+Home before
+{{ return }}
+Home after
+-- layouts/page.html --
+{{ if .Title }}Page before{{ return "ignored" }}{{ end }}
+Page after
+-- layouts/_partials/p.html --
+{{ partial "inner.html" . }}|after inner
+-- layouts/_partials/inner.html --
+inner{{ return 42 }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Home before")
+	b.AssertFileContent("public/p1/index.html", "Page before")
+	b.AssertFileContentExact("public/index.html", "Home before\n")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ return 1 2 }}
+`
+
+	_, err := hugolib.TestE(t, files)
+	if err == nil || !strings.Contains(err.Error(), "return takes at most one argument") {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
