diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..a83add7 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,47 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+A
+{{ if true }}{{ return }}{{ end }}
+B
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContentExact("public/index.html", "A\n")
+}
+
+func TestReturnEarlyPartialValues(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ with partial "early" 5 }}EARLY:{{ . }}{{ end }}
+{{ with partial "last" 2 }}LAST:{{ . }}{{ end }}
+{{ with partial "none" }}NONE:{{ . | safeHTML }}{{ end }}
+{{ with 42 | partial "piped" }}PIPED:{{ . }}{{ end }}
+-- layouts/_partials/early.html --
+{{ range seq 10 }}{{ if ge . $ }}{{ return . }}{{ end }}{{ end }}
+{{ return "unreachable" }}
+-- layouts/_partials/last.html --
+{{ return (mul . 21) }}
+-- layouts/_partials/none.html --
+not returned
+-- layouts/_partials/piped.html --
+{{ . | return }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "EARLY:5", "LAST:42", "NONE:not returned", "PIPED:42")
+}
