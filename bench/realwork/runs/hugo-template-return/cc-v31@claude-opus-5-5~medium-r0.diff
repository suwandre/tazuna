index 79a92f1..ca3c945 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,49 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "page", "section", "rss", "sitemap"]
+enableRobotsTXT = true
+-- layouts/baseof.html --
+Base start|{{ block "main" . }}{{ end }}|Base end
+-- layouts/home.html --
+{{ define "main" }}Main start|{{ template "early" 1 }}|{{ template "early" 2 }}|{{ if true }}{{ return }}{{ end }}Main end{{ end }}
+{{ define "early" }}Early start {{ . }}|{{ if eq . 1 }}{{ return }}{{ end }}Early end {{ . }}{{ end }}
+-- layouts/_partials/value.html --
+{{ range seq 5 }}{{ if eq . 3 }}{{ return . }}{{ end }}{{ end }}
+{{ return 42 }}
+-- layouts/_partials/nil.html --
+{{ return nil }}
+-- layouts/_partials/false.html --
+{{ with false }}{{ else }}{{ return false }}{{ end }}{{ return true }}
+-- layouts/_partials/output.html --
+<p>{{ . }}</p>{{ if eq . "a" }}{{ return }}{{ end }}<p>after</p>
+-- layouts/_partials/try.html --
+{{ $v := try (partial "value.html") }}{{ return $v.Value }}
+-- layouts/robots.txt --
+{{ partial "output.html" "a" }}|{{ partial "output.html" "b" }}|{{ partialCached "value.html" . }}|{{ partial "nil.html" | printf "%v" }}|{{ partial "false.html" }}|{{ partial "try.html" }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Base start|Main start|Early start 1||Early start 2|Early end 2||Base end")
+	b.AssertFileContent("public/robots.txt", "<p>a</p>|<p>b</p><p>after</p>|3|<nil>|false|3")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/home.html --
+{{ 2 | return 1 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.ErrorMatches, `(?s).*return takes at most 1 argument, got 2.*`)
+}
