+func TestTemplateReturn(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "http://example.com/"
+-- layouts/home.html --
+Home before.{{ if . }}{{ try (return "ignored") }}{{ end }}Home after.
+-- layouts/single.html --
+Single before.
+{{ template "inner" . }}
+Single after.
+{{ define "inner" }}Inner before.{{ if .Params.stop }}{{ return }}{{ end }}Inner after.{{ end }}
+-- content/stop.md --
+---
+title: Stop
+stop: true
+---
+-- content/continue.md --
+---
+title: Continue
+stop: false
+---
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Home before.", "! Home after.")
+	b.AssertFileContent("public/stop/index.html", "Single before.", "Inner before.", "! Inner after.", "! Single after.")
+	b.AssertFileContent("public/continue/index.html", "Single before.", "Inner before.", "Inner after.", "Single after.")
+}
+
+func TestPartialWithEarlyReturn(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "http://example.com/"
+-- layouts/_partials/early.html --
+start{{ if . }}{{ return "yes" }}{{ else }}{{ return "no" }}{{ end }}end
+-- layouts/_partials/conditional.html --
+start{{ if . }}{{ return "yes" }}{{ end }}end
+-- layouts/_partials/empty.html --
+before{{ return }}after
+-- layouts/home.html --
+early: {{ partial "early.html" true }}|{{ partial "early.html" false }}|
+conditional: {{ partial "conditional.html" true }}|{{ partial "conditional.html" false }}|
+empty: {{ if partial "empty.html" . }}not nil{{ else }}nil{{ end }}
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"early: yes|no|",
+		"conditional: yes|startend|",
+		"empty: nil",
+	)
+}
+
