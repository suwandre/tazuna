+
+func TestReturnEarlyInPage(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+before
+{{ if true }}{{ return }}{{ end }}
+after
+-- layouts/page.html --
+{{ range seq 3 }}{{ . }}{{ if eq . 2 }}{{ return }}{{ end }}{{ end }}
+after
+-- layouts/_shortcodes/sc.html --
+sc-before
+{{ return }}
+sc-after
+-- content/p1.md --
+---
+title: p1
+---
+{{< sc >}}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "before")
+	b.AssertFileContent("public/p1/index.html", "12")
+	b.AssertFileContent("public/index.html", "! after")
+	b.AssertFileContent("public/p1/index.html", "! after")
+}
+
+func TestReturnInPartialNotLast(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+a: {{ partial "early.html" 1 }}
+b: {{ partial "early.html" 2 }}
+c: {{ partial "novalue.html" . }}
+d: {{ partial "nested.html" . }}
+e: {{ partialCached "early.html" 1 }}
+f: {{ partial "html.html" . }}
+g: {{ partial "cmd.html" . }}
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ range seq 3 }}{{ if eq . 2 }}{{ return (printf "range%d" .) }}{{ end }}{{ end }}
+{{ return "unreachable" }}
+-- layouts/_partials/novalue.html --
+output is ignored
+{{ if false }}{{ return 1 }}{{ end }}
+-- layouts/_partials/nested.html --
+{{ $v := partial "early.html" 2 }}
+{{ return (printf "nested-%s" $v) }}
+-- layouts/_partials/cmd.html --
+{{ return add 1 2 }}
+-- layouts/_partials/html.html --
+{{ return ("<b>x</b>" | safeHTML) }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"a: one",
+		"b: range2",
+		"c: \n",
+		"d: nested-range2",
+		"e: one",
+		"f: <b>x</b>",
+		"g: 3",
+	)
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ templates.Return 1 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "return: expected at most 1 argument, got 2")
+}
