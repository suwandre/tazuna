+// Return stops the execution of the current template, optionally with a value.
+// In a partial, that value is what the partial returns.
+// It is implemented by returning an error that is trapped by the template store.
+func (ns *Namespace) Return(args ...any) (string, error) {
+	switch len(args) {
+	case 0:
+		return "", &tpl.ReturnError{}
+	case 1:
+		return "", &tpl.ReturnError{Value: args[0]}
+	default:
+		return "", fmt.Errorf("return: expected at most 1 argument, got %d", len(args))
+	}
+}
