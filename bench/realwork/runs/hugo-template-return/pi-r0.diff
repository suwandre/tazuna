diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..d32f70e 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,31 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+Home:{{ partial "early.html" 1 }}|{{ partial "early.html" 2 }}|{{ partial "early.html" 3 }}|{{ partial "novalue.html" . }}|{{ partial "falsy.html" . }}|{{ partial "plain.html" . }}
+{{ if true }}{{ return }}{{ end }}
+NOT RENDERED
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ range slice 1 2 3 }}{{ if eq . $ }}{{ return (printf "range-%d" .) }}{{ end }}{{ end }}
+not reached
+-- layouts/_partials/novalue.html --
+output ignored{{ return }}
+-- layouts/_partials/falsy.html --
+{{ return false }}
+-- layouts/_partials/plain.html --
+plain
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Home:one|range-2|range-3||false|plain")
+	b.AssertFileContent("public/index.html", "! NOT RENDERED", "! not reached")
+}
