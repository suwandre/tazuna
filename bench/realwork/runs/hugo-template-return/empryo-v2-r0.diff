+// Return stops the execution of the current template. If a value is given,
+// it is returned as the result when called from a partial.
+// Without a value, a partial returns whatever it has rendered so far.
+func (ns *Namespace) Return(args ...any) (any, error) {
+	if len(args) > 1 {
+		return nil, fmt.Errorf("return: expected at most 1 argument, got %d", len(args))
+	}
+	r := &texttemplate.ReturnError{}
+	if len(args) == 1 {
+		r.Value = args[0]
+		r.HasValue = true
+	}
+	return nil, r
+}
