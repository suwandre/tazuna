+
+func TestReturn(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+disableKinds = ['page','section','taxonomy','term','rss','sitemap','404']
+-- layouts/home.html --
+home-start
+{{ if true }}{{ return }}{{ end }}
+home-not-reached
+-- layouts/_partials/value.html --
+before
+{{ if .ok }}{{ return "early" }}{{ end }}
+after
+{{ return "late" }}
+-- layouts/_partials/nil.html --
+{{ return nil }}
+-- layouts/_partials/novalue.html --
+a{{ if . }}{{ return }}{{ end }}b
+-- layouts/_partials/nested.html --
+{{ range seq 5 }}{{ if eq . 2 }}{{ return (printf "range-%d" .) }}{{ end }}{{ end }}not-reached
+-- layouts/_partials/dot.html --
+{{ with .a }}{{ return (printf "%s-%s" . $.b) }}{{ end }}
+-- layouts/_partials/pipe.html --
+{{ "piped" | return }}
+-- layouts/_partials/inner.html --
+{{ partial "value.html" (dict "ok" true) }}-{{ return "outer" }}
+-- layouts/shortcodes/sc.html --
+sc-start{{ return }}sc-end
+-- layouts/_partials/html.html --
+<div>{{ if . }}{{ return "x" }}{{ end }}</div>
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "home-start")
+	b.AssertFileContent("public/index.html", "! home-not-reached")
+
+	files = `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+disableKinds = ['page','section','taxonomy','term','rss','sitemap','404']
+-- layouts/home.html --
+1: {{ partial "value.html" (dict "ok" true) }}|
+2: {{ partial "value.html" (dict "ok" false) }}|
+3: {{ partial "nil.html" . }}|
+4: {{ partial "novalue.html" true }}|
+5: {{ partial "novalue.html" false }}|
+6: {{ partial "nested.html" . }}|
+7: {{ partial "dot.html" (dict "a" "A" "b" "B") }}|
+8: {{ partial "pipe.html" . }}|
+9: {{ partial "inner.html" . }}|
+10: {{ partialCached "value.html" (dict "ok" true) }}|
+11: {{ partial "html.html" true }}|
+12: {{ partial "html.html" false }}|
+13: {{ (partial "value.html" (dict "ok" true)) | upper }}|
+-- layouts/_partials/value.html --
+before
+{{ if .ok }}{{ return "early" }}{{ end }}
+after
+{{ return "late" }}
+-- layouts/_partials/nil.html --
+{{ return nil }}
+-- layouts/_partials/novalue.html --
+a{{ if . }}{{ return }}{{ end }}b
+-- layouts/_partials/nested.html --
+{{ range seq 5 }}{{ if eq . 2 }}{{ return (printf "range-%d" .) }}{{ end }}{{ end }}not-reached
+-- layouts/_partials/dot.html --
+{{ with .a }}{{ return (printf "%s-%s" . $.b) }}{{ end }}
+-- layouts/_partials/pipe.html --
+{{ "piped" | return }}
+-- layouts/_partials/inner.html --
+{{ partial "value.html" (dict "ok" true) }}-{{ return "outer" }}
+-- layouts/_partials/html.html --
+<div>{{ if . }}{{ return "x" }}{{ end }}</div>
+`
+	b = hugolib.Test(t, files)
+	b.AssertFileContent("public/index.html",
+		"1: early|",
+		"2: late|",
+		"3: |",
+		"4: a|",
+		"5: ab|",
+		"6: range-2|",
+		"7: A-B|",
+		"8: piped|",
+		"9: outer|",
+		"10: early|",
+		"11: x|",
+		"12: <div></div>|",
+		"13: EARLY|",
+	)
+}
+
+func TestReturnShortcodeAndBlock(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+disableKinds = ['section','taxonomy','term','rss','sitemap','404']
+-- content/p1.md --
+---
+title: p1
+---
+a {{< sc >}} b
+-- layouts/page.html --
+page:{{ .Content }}:end
+-- layouts/home.html --
+home
+-- layouts/_shortcodes/sc.html --
+sc-start{{ return }}sc-end
+`
+
+	b := hugolib.Test(t, files)
+	b.AssertFileContent("public/p1/index.html", "sc-start", "! sc-end", "b", "page:", ":end")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ return 1 2 }}
+`
+
+	_, err := hugolib.TestE(t, files)
+	if err == nil {
+		t.Fatal("expected error")
+	}
+}
