+func TestReturnEarlyExit(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "http://example.com/"
+disableKinds = ["section", "taxonomy", "term", "rss", "sitemap", "robotsTXT", "404"]
+-- content/p1.md --
+-- layouts/page.html --
+Before
+{{ range seq 3 }}{{ if eq . 2 }}{{ return }}{{ end }}[{{ . }}]{{ end }}
+After
+-- layouts/home.html --
+bare: {{ partial "bare.html" false }}|{{ partial "bare.html" true }}
+value: {{ partial "value.html" . }}
+nil: {{ partial "nilvalue.html" . | default "empty" }}
+unreached: {{ partial "unreached.html" false }}|{{ partial "unreached.html" true }}
+pipe: {{ partial "pipe.html" "piped" }}
+sub: {{ partial "sub.html" . }}
+with: {{ partial "with.html" (dict "name" "foo") }}
+command: {{ partial "command.html" . }}
+-- layouts/_partials/bare.html --
+A{{ if . }}{{ return }}{{ end }}B
+-- layouts/_partials/value.html --
+output discarded
+{{ range seq 5 }}{{ if eq . 3 }}{{ return . }}{{ end }}{{ end }}
+{{ return "not reached" }}
+-- layouts/_partials/nilvalue.html --
+output discarded{{ return nil }}
+-- layouts/_partials/unreached.html --
+{{ if . }}{{ return "returned" }}{{ end }}rendered
+-- layouts/_partials/pipe.html --
+{{ . | return }}
+-- layouts/_partials/sub.html --
+{{ template "inner" . }}after inner
+{{ define "inner" }}inner|{{ return }}not reached{{ end }}
+-- layouts/_partials/with.html --
+{{ with . }}{{ return .name }}{{ end }}
+-- layouts/_partials/command.html --
+{{ return printf "%s-%d" "a" 42 }}
+`
+
+	b := Test(t, files)
+	b.AssertFileContentExact("public/p1/index.html", "Before\n[1]")
+	b.AssertFileContent("public/index.html", `
+bare: AB|A
+value: 3
+nil: empty
+unreached: rendered
+|returned
+pipe: piped
+sub: inner|after inner
+with: foo
+command: a-42
+`)
+}
+
