+// ReturnError is raised by the return keyword to exit the current template.
+// It is returned from the Executer, and swallowed when exiting a nested template.
+type ReturnError struct {
+	Value    any
+	HasValue bool
+}
+
+func (e *ReturnError) Error() string {
+	return "return called outside of a template"
+}
+
+// walkReturnable walks the template, consuming any return.
+func (s *state) walkReturnable(dot reflect.Value, root *parse.ListNode) {
+	defer func() {
+		if r := recover(); r != nil {
+			if _, ok := r.(*ReturnError); !ok {
+				panic(r)
+			}
+		}
+	}()
+	s.walk(dot, root)
+}
