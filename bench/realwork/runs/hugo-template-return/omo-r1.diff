diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..d3d7c58 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,55 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarlyInTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+before
+{{ range seq 5 }}{{ if eq . 3 }}{{ return }}{{ end }}{{ . }}{{ end }}
+after
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "before", "12")
+	b.AssertFileContent("public/index.html", "! after")
+}
+
+func TestReturnInPartial(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+1:{{ partial "early.html" 1 }}
+2:{{ partial "early.html" 2 }}
+3:{{ partial "early.html" 3 }}
+4:{{ partial "piped.html" . }}
+5:{{ with partial "empty.html" . }}not-empty{{ else }}empty{{ end }}
+6:{{ partial "nested.html" . }}
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ if eq . 2 }}{{ range slice . }}{{ return (printf "two-%d" .) }}{{ end }}{{ end }}
+output
+-- layouts/_partials/piped.html --
+{{ "piped" | return }}
+unreachable
+-- layouts/_partials/empty.html --
+{{ return }}
+-- layouts/_partials/nested.html --
+{{ template "inner" . }}
+{{ return "outer" }}
+{{ define "inner" }}{{ return "inner" }}unreachable{{ end }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "1:one", "2:two-2", "3:", "4:piped", "5:empty", "6:outer")
+	b.AssertFileContent("public/index.html", "! unreachable")
+}
