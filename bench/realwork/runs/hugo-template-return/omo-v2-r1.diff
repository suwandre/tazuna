diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..3dd57fb 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,54 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarlyInTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+BEFORE
+{{ if true }}{{ return }}{{ end }}
+AFTER
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "BEFORE")
+	b.AssertFileContent("public/index.html", "! AFTER")
+}
+
+func TestReturnEarlyInPartial(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+a: {{ partial "a.html" 1 }}
+b: {{ partial "a.html" 2 }}
+c: {{ partial "a.html" 3 }}
+d: {{ partial "a.html" 4 }}
+e: {{ partial "a.html" 5 | printf "%T" }}
+-- layouts/_partials/a.html --
+SKIPPED
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ if eq . 2 }}{{ return false }}{{ end }}
+{{ range slice 10 20 30 }}{{ if eq . 20 }}{{ if eq $ 3 }}{{ return . }}{{ end }}{{ end }}{{ end }}
+{{ if eq . 5 }}{{ return }}{{ end }}
+rendered:{{ . }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"a: one",
+		"b: false",
+		"c: 20",
+		"d: rendered:4",
+		"e: <nil>",
+	)
+	b.AssertFileContent("public/index.html", "! SKIPPED")
+}
