+// ReturnError is a sentinel error used to signal an early return from a template,
+// with an optional value.
+type ReturnError struct {
+	Value    any
+	HasValue bool
+}
+
+func (*ReturnError) Error() string {
+	return "return"
+}
+
+// returnRecover stops the panic from a return statement.
+// If the return statement has a value, the *ReturnError is stored in errp.
+func returnRecover(errp *error) {
+	if r := recover(); r != nil {
+		re, ok := r.(*ReturnError)
+		if !ok {
+			panic(r)
+		}
+		if re.HasValue {
+			*errp = re
+		}
+	}
+}
+
+// walkTemplate is like walkTemplateOld, but a return statement only returns from the invoked template.
+func (s *state) walkTemplate(dot reflect.Value, t *parse.TemplateNode) {
+	defer func() {
+		if r := recover(); r != nil {
+			if _, ok := r.(*ReturnError); !ok {
+				panic(r)
+			}
+		}
+	}()
+	s.walkTemplateOld(dot, t)
+}
