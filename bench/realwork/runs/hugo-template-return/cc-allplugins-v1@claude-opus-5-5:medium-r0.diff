+func TestTemplateReturn(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "page", "rss", "sitemap"]
+-- layouts/home.html --
+Early: {{ partial "early.html" 1 }}|{{ partial "early.html" 2 }}|
+Range: {{ partial "range.html" (slice 1 2 3 4) }}|
+NoValue: {{ partial "novalue.html" . }}|
+Falsy: {{ with partial "falsy.html" . }}{{ else }}falsy{{ end }}|
+Nested: {{ partial "nested.html" . }}|
+Pipe: {{ partial "pipe.html" 1 }}|
+Template: {{ template "tpl" 1 }}{{ template "tpl" 2 }}|
+Try: {{ with try (partial "early.html" 1) }}{{ .Value }}{{ end }}|
+{{ if true }}{{ return }}{{ end }}
+After return.
+{{ define "tpl" }}{{ if eq . 1 }}{{ return }}{{ end }}tpl{{ . }}{{ end }}
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ return "other" }}
+-- layouts/_partials/range.html --
+{{ range . }}{{ if eq . 3 }}{{ return . }}{{ end }}{{ end }}
+{{ return 0 }}
+-- layouts/_partials/novalue.html --
+<p>before</p>{{ return }}<p>after</p>
+-- layouts/_partials/pipe.html --
+{{ return add . 41 | string }}
+-- layouts/_partials/falsy.html --
+{{ return false }}
+-- layouts/_partials/nested.html --
+{{ $v := partial "early.html" 2 }}{{ return printf "nested-%s" $v }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"Early: one|other|",
+		"Range: 3|",
+		"NoValue: <p>before</p>|",
+		"Falsy: falsy|",
+		"Nested: nested-other|",
+		"Pipe: 42|",
+		"Template: tpl2|",
+		"Try: one|",
+		"! After return.",
+	)
+}
