diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..87afeb0 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,65 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+Start
+{{ partial "first.html" 1 }}|
+{{ partial "first.html" 2 }}|
+{{ with partial "falsy.html" 0 }}truthy{{ else }}falsy{{ end }}|
+{{ partial "noreturn.html" . }}|
+{{ partial "nested.html" . }}|
+{{ with partial "bare.html" . }}truthy{{ else }}nil{{ end }}|
+{{ partial "last.html" . }}|
+{{ partial "range.html" . }}|
+{{ partial "withtemplate.html" . }}|
+{{ if true }}
+{{ return }}
+{{ end }}
+NOT_RENDERED
+-- layouts/_partials/first.html --
+{{ if eq . 1 }}
+{{ return "one" }}
+{{ end }}
+{{ return "other" }}
+NOT_RETURNED
+-- layouts/_partials/falsy.html --
+{{ with . }}{{ return "x" }}{{ end }}
+-- layouts/_partials/noreturn.html --
+Hello
+{{ if false }}{{ return "no" }}{{ end }}
+-- layouts/_partials/nested.html --
+{{ $v := partial "first.html" 1 }}{{ return (printf "nested-%s" $v) }}
+-- layouts/_partials/bare.html --
+{{ return }}
+-- layouts/_partials/last.html --
+{{ $a := "last" }}
+{{ return $a }}
+-- layouts/_partials/range.html --
+{{ range seq 5 }}{{ if eq . 3 }}{{ return . }}{{ end }}{{ end }}
+-- layouts/_partials/withtemplate.html --
+{{ template "inner" . }}
+NOT_RETURNED
+{{ define "inner" }}{{ return "from template" }}{{ end }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"Start",
+		"one|",
+		"other|",
+		"falsy|",
+		"nested-one|",
+		"last|",
+		"3|",
+		"from template|",
+	)
+	b.AssertFileContentExact("public/index.html", "Start\none|\nother|\nfalsy|\n|\nnested-one|\nnil|\nlast|\n3|\nfrom template|\n")
+}
