index 920d96f..473eb0a 100644
--- a/tpl/internal/go_templates/texttemplate/hugo_template_test.go
+++ b/tpl/internal/go_templates/texttemplate/hugo_template_test.go
@@ -93,3 +93,31 @@ Method: {{ .Hello1 "v1" }}
 	c.Assert(got, qt.Contains, "Map: av")
 	c.Assert(got, qt.Contains, "Method: v2 v1")
 }
+
+func TestReturnError(t *testing.T) {
+	c := qt.New(t)
+
+	funcs := FuncMap{
+		"ret": func(v any) (any, error) { return nil, &ReturnError{Value: v} },
+		"seq": func() []int { return []int{1, 2, 3} },
+		"try": func(v any) any { return v },
+	}
+
+	templ, err := New("").Funcs(funcs).Parse(`A{{ range seq }}{{ if eq . 2 }}{{ ret "done" }}{{ end }}{{ . }}{{ end }}B`)
+	c.Assert(err, qt.IsNil)
+
+	var b bytes.Buffer
+	err = templ.Execute(&b, nil)
+	var re *ReturnError
+	c.Assert(err, qt.ErrorAs, &re)
+	c.Assert(re.Value, qt.Equals, "done")
+	c.Assert(b.String(), qt.Equals, "A1")
+
+	// try must not swallow it.
+	templ, err = New("").Funcs(funcs).Parse(`A{{ try (ret 1) }}B`)
+	c.Assert(err, qt.IsNil)
+	b.Reset()
+	err = templ.Execute(&b, nil)
+	c.Assert(err, qt.ErrorAs, &re)
+	c.Assert(b.String(), qt.Equals, "A")
+}
