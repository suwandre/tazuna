+
+func TestReturnEarlyInPage(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["page", "section", "taxonomy", "term", "sitemap", "RSS"]
+-- layouts/baseof.html --
+<main>{{ block "main" . }}{{ end }}</main>
+<footer>footer</footer>
+-- layouts/home.html --
+{{ define "main" }}
+before
+{{ range seq 3 }}{{ if eq . 2 }}{{ return }}{{ end }}r{{ . }}{{ end }}
+after
+{{ end }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "<main>\nbefore\nr1", "</main>\n<footer>footer</footer>")
+	b.AssertFileContent("public/index.html", "! after", "! r2")
+}
+
+func TestReturnInTemplateCall(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["page", "section", "taxonomy", "term", "sitemap", "RSS"]
+-- layouts/home.html --
+{{ template "t" . }}|done
+{{ define "t" }}a{{ return 42 }}b{{ end }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "a|done")
+	b.AssertFileContent("public/index.html", "! b")
+}
+
+func TestReturnInPartial(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["page", "section", "taxonomy", "term", "sitemap", "RSS"]
+-- layouts/home.html --
+cond1: {{ partial "cond.html" 1 }}
+cond2: {{ partial "cond.html" 2 }}
+cmd: {{ partial "cmd.html" . }}
+falsy: {{ with partial "falsy.html" . }}truthy{{ else }}falsy{{ end }}
+range: {{ partial "range.html" (seq 5) }}
+bare: {{ partial "bare.html" . }}
+bare-html: {{ partial "bare-html.html" . }}
+try: {{ partial "try.html" . }}
+-- layouts/_partials/cond.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{- return "other" }}
+-- layouts/_partials/cmd.html --
+{{ return add 1 2 }}
+-- layouts/_partials/falsy.html --
+{{ return false }}
+-- layouts/_partials/range.html --
+{{ range . }}{{ if gt . 2 }}{{ return . }}{{ end }}{{ end }}
+-- layouts/_partials/bare.html --
+x{{ return }}YYY
+-- layouts/_partials/bare-html.html --
+<b>x</b>{{ return }}<i>YYY</i>
+-- layouts/_partials/try.html --
+{{ with try (return "tried") }}{{ end }}not reached
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"cond1: one",
+		"cond2: other",
+		"cmd: 3",
+		"falsy: falsy",
+		"range: 3",
+		"bare: x\n",
+		"bare-html: <b>x</b>",
+		"try: tried",
+	)
+	b.AssertFileContent("public/index.html", "! YYY", "! not reached")
+}
