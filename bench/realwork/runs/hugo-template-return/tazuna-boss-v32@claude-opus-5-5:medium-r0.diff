+package templates_test
+
+import (
+	"testing"
+
+	qt "github.com/frankban/quicktest"
+	"github.com/gohugoio/hugo/hugolib"
+)
+
+func TestReturnPartialEarlyAndMultiple(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/_partials/p.html --
+{{ if . }}{{ return "a" }}{{ end }}{{ return "b" }}
+-- layouts/_partials/multi.html --
+{{ if . }}{{ return "x" }}{{ else }}{{ return "y" }}{{ end }}{{ return "z" }}
+-- layouts/home.html --
+{{ partial "p.html" true }}|{{ partial "p.html" false }}|{{ partial "multi.html" true }}|{{ partial "multi.html" false }}
+`
+	b := hugolib.Test(t, files)
+	b.AssertFileContentExact("public/index.html", "a|b|x|y")
+}
+
+func TestReturnPartialInRangeAndWith(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/_partials/range.html --
+{{ range . }}{{ if eq . 2 }}{{ return . }}{{ end }}{{ end }}never
+-- layouts/_partials/with.html --
+{{ with . }}{{ return "w:" }}{{ end }}{{ return "empty" }}
+-- layouts/home.html --
+{{ partial "range.html" (slice 1 2 3) }}|{{ partial "range.html" (slice 1) }}|{{ partial "with.html" "x" }}|{{ partial "with.html" "" }}
+`
+	b := hugolib.Test(t, files)
+	b.AssertFileContentExact("public/index.html", "2|never|w:|empty")
+}
+
+func TestReturnPartialWithoutValueReturnsRendered(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/_partials/n.html --
+A{{ if . }}{{ return }}{{ end }}B
+-- layouts/home.html --
+[{{ partial "n.html" true }}][{{ partial "n.html" false }}]
+`
+	b := hugolib.Test(t, files)
+	b.AssertFileContentExact("public/index.html", "[A][AB]")
+}
+
+func TestReturnPartialFalsyAndNilValues(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/_partials/v.html --
+{{ return . }}
+-- layouts/_partials/nil.html --
+{{ return nil }}
+-- layouts/home.html --
+{{ partial "v.html" 0 }}|{{ partial "v.html" false }}|{{ partial "v.html" "" }}|{{ if partial "nil.html" }}yes{{ else }}no{{ end }}
+`
+	b := hugolib.Test(t, files)
+	b.AssertFileContentExact("public/index.html", "0|false||no")
+}
+
+func TestReturnInRegularTemplateStopsOutput(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/home.html --
+A{{ if true }}{{ return }}{{ end }}B
+`
+	b := hugolib.Test(t, files)
+	b.AssertFileContentExact("public/index.html", "A")
+}
+
+func TestReturnInBlockStopsOnlyThatTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- content/p.md --
+---
+title: p
+---
+-- layouts/baseof.html --
+<main>{{ block "main" . }}{{ end }}</main><footer>f</footer>
+-- layouts/page.html --
+{{ define "main" }}before{{ return }}after{{ end }}
+`
+	b := hugolib.Test(t, files)
+	b.AssertFileContentExact("public/p/index.html", "<main>before</main><footer>f</footer>")
+}
+
+func TestReturnInsideTryIsNotSwallowed(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/_partials/t.html --
+{{ try (return "t") }}never
+-- layouts/home.html --
+{{ partial "t.html" }}
+`
+	b := hugolib.Test(t, files)
+	b.AssertFileContentExact("public/index.html", "t")
+}
+
+func TestReturnTooManyArgsErrors(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/home.html --
+{{ return 1 2 }}
+`
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "return takes 0 or 1 arguments, got 2")
+}
+
+func TestReturnPartialCached(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/_partials/c.html --
+{{ return (printf "c:%v" .) }}
+-- layouts/home.html --
+{{ partialCached "c.html" "x" "v" }}|{{ partialCached "c.html" "x" "v" }}
+`
+	b := hugolib.Test(t, files)
+	b.AssertFileContentExact("public/index.html", "c:x|c:x")
+}
