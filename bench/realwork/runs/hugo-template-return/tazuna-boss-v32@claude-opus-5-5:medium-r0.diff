+// ReturnError is used to stop template execution early, optionally with a value.
+type ReturnError struct {
+	Value    any
+	HasValue bool
+}
+
+func (*ReturnError) Error() string { return "return" }
+
+// walkWithReturn walks node and traps a ReturnError.
+func (s *state) walkWithReturn(dot reflect.Value, node parse.Node) (ret *ReturnError) {
+	defer func() {
+		if r := recover(); r != nil {
+			var ok bool
+			if ret, ok = r.(*ReturnError); !ok {
+				panic(r)
+			}
+		}
+	}()
+	s.walk(dot, node)
+	return
+}
+
+// walkTemplate is walkTemplateOld with the return trapped, so a return only stops the invoked template.
+func (s *state) walkTemplate(dot reflect.Value, t *parse.TemplateNode) {
+	s.at(t)
+	tmpl := s.tmpl.Lookup(t.Name)
+	if tmpl == nil {
+		s.errorf("template %q not defined", t.Name)
+	}
+	if s.depth == maxExecDepth {
+		s.errorf("exceeded maximum template depth (%v)", maxExecDepth)
+	}
+	// Variables declared by the pipeline persist.
+	dot = s.evalPipeline(dot, t.Pipe)
+	newState := *s
+	newState.depth++
+	newState.tmpl = tmpl
+	// No dynamic scoping: template invocations inherit no variables.
+	newState.vars = []variable{{"$", dot}}
+	newState.walkWithReturn(dot, tmpl.Root)
+}
