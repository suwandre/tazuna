+// Return stops the execution of the current template, optionally returning a value (partials only).
+func (ns *Namespace) Return(args ...any) (any, error) {
+	switch len(args) {
+	case 0:
+		return nil, &texttemplate.ReturnError{}
+	case 1:
+		return nil, &texttemplate.ReturnError{Value: args[0], HasValue: true}
+	default:
+		return nil, fmt.Errorf("return takes 0 or 1 arguments, got %d", len(args))
+	}
+}
