diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..06daebb 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,110 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarlyInPartial(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+neg: {{ partial "sign" -5 }}
+pos: {{ partial "sign" 5 }}
+zero: {{ partial "sign" 0 }}
+nested: {{ partial "first" (slice 1 2 3 4) }}
+fallthrough: {{ with partial "maybe" false }}truthy{{ else }}falsy{{ end }}
+noarg: {{ partial "noarg" . }}|
+piped: {{ partial "piped" 2 }}
+-- layouts/_partials/sign.html --
+{{ if lt . 0 }}
+  {{ return "negative" }}
+{{ end }}
+{{ if gt . 0 }}
+  {{ return "positive" }}
+{{ end }}
+{{ return "zero" }}
+unreachable
+-- layouts/_partials/first.html --
+{{ range . }}
+  {{ if gt . 2 }}{{ return . }}{{ end }}
+{{ end }}
+-- layouts/_partials/maybe.html --
+{{ if . }}{{ return "yes" }}{{ end }}
+output that is discarded
+-- layouts/_partials/noarg.html --
+output that is discarded
+{{ return }}
+-- layouts/_partials/piped.html --
+{{ add . 40 | return }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"neg: negative",
+		"pos: positive",
+		"zero: zero",
+		"nested: 3",
+		"fallthrough: falsy",
+		"noarg: |",
+		"piped: 42",
+	)
+}
+
+func TestReturnInTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/baseof.html --
+<main>{{ block "main" . }}{{ end }}</main>
+<footer>footer</footer>
+-- layouts/home.html --
+{{ define "main" }}
+before
+{{ template "inner" . }}
+{{ if true }}{{ return }}{{ end }}
+unreachable
+{{ end }}
+{{ define "inner" }}
+inner before
+{{ return 42 }}
+inner unreachable
+{{ end }}
+-- layouts/_partials/p.html --
+{{ template "inner" . }}
+{{ return "outer" }}
+{{ define "inner" }}{{ return "inner" }}{{ end }}
+-- layouts/page.html --
+partial: {{ partial "p.html" . }}
+{{ $r := try (return 1) }}
+unreachable
+-- content/p1.md --
+---
+title: p1
+---
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "before", "inner before", "<footer>footer</footer>", "! unreachable")
+	b.AssertFileContent("public/p1/index.html", "partial: outer", "! unreachable")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ partial "p.html" . }}
+-- layouts/_partials/p.html --
+{{ 1 | return 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.ErrorMatches, `(?s).*return takes at most 1 argument.*`)
+}
