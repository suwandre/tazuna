diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..3b781fd 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,75 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+Before
+{{ if true }}{{ return }}{{ end }}
+After
+-- layouts/_partials/range.html --
+{{ range . }}{{ if gt . 1 }}{{ return . }}{{ end }}{{ end }}
+{{ return "none" }}
+-- layouts/_partials/pipe.html --
+{{ . | upper | return }}
+-- layouts/_partials/nil.html --
+{{ return }}
+-- layouts/_partials/fallthrough.html --
+{{ if . }}{{ return "yes" }}{{ end }}
+text
+-- layouts/_partials/nested.html --
+{{ partial "range.html" . }}
+{{ return (printf "nested:%v" (partial "range.html" .)) }}
+-- layouts/page.html --
+range: {{ partial "range.html" (slice 1 2 3) }}|
+none: {{ partial "range.html" (slice 1) }}|
+pipe: {{ partial "pipe.html" "abc" }}|
+nil: {{ if partial "nil.html" . }}set{{ else }}unset{{ end }}|
+fallthrough-yes: {{ partial "fallthrough.html" true }}|
+fallthrough-no: {{ if partial "fallthrough.html" false }}set{{ else }}unset{{ end }}|
+nested: {{ partial "nested.html" (slice 5) }}|
+cached: {{ partialCached "range.html" (slice 7) "a" }}|
+Not reached
+{{ return }}
+-- content/p.md --
+---
+title: P
+---
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Before")
+	b.AssertFileContentExact("public/index.html", "Before\n")
+	b.AssertFileContent("public/p/index.html",
+		"range: 2|",
+		"none: none|",
+		"pipe: ABC|",
+		"nil: unset|",
+		"fallthrough-yes: yes|",
+		"fallthrough-no: unset|",
+		"nested: nested:5|",
+		"cached: 7|",
+	)
+	b.AssertFileContentExact("public/p/index.html", "cached: 7|\nNot reached")
+}
+
+func TestReturnTooManyArguments(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ 1 | return 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "expected at most 1 argument")
+}
