+// ReturnError is a sentinel error used to implement the Hugo "return" keyword.
+// When a template function returns (or wraps) a *ReturnError, execution of the
+// current template stops without any error being reported. The error is
+// handed back to the caller of the execution, which may use Value (e.g. partials).
+type ReturnError struct {
+	// Value is the optional value given to return.
+	Value any
+}
+
+func (e *ReturnError) Error() string {
+	return "return"
+}
+
 // newErrorWithCause creates a new error with the given cause.
 func newErrorWithCause(err error) *TryError {
 	return &TryError{Err: err, Cause: herrors.Cause(err)}
@@ -296,6 +321,9 @@ func (s *state) evalCall(dot, fun reflect.Value, isBuiltin bool, node parse.Node
 	if name == "try" {
 		defer func() {
 			if r := recover(); r != nil {
+				if _, ok := r.(*ReturnError); ok {
+					panic(r)
+				}
 				// Cause: herrors.Cause(err)
 				if err, ok := r.(error); ok {
 					val = reflect.ValueOf(TryValue{Value: nil, Err: newErrorWithCause(err)})
@@ -413,6 +441,11 @@ func (s *state) evalCall(dot, fun reflect.Value, isBuiltin bool, node parse.Node
 	// If we have an error that is not nil, stop execution and return that
 	// error to the caller.
 	if err != nil {
+		// Added for Hugo. Unwind to the top of the execution.
+		var returnErr *ReturnError
+		if errors.As(err, &returnErr) {
+			panic(returnErr)
+		}
 		s.at(node)
 		s.errorf("error calling %s: %w", name, err)
 	}
diff --git a/tpl/partials/init.go b/tpl/partials/init.go
index 7d45f0e..aa5d2cc 100644
--- a/tpl/partials/init.go
+++ b/tpl/partials/init.go
@@ -15,13 +15,34 @@ package partials
 
 import (
 	"context"
+	"fmt"
 
 	"github.com/gohugoio/hugo/deps"
 	"github.com/gohugoio/hugo/tpl/internal"
+	texttemplate "github.com/gohugoio/hugo/tpl/internal/go_templates/texttemplate"
 )
 
 const namespaceName = "partials"
 
+// returnFunc implements the return keyword.
+// The sentinel error is trapped in the template execution.
+func returnFunc(args ...any) (any, error) {
+	if len(args) > 1 {
+		return nil, fmt.Errorf("return: expected at most 1 argument, got %d", len(args))
+	}
+	var v any
+	if len(args) == 1 {
+		v = args[0]
+	}
+	return nil, &texttemplate.ReturnError{Value: v}
+}
+
+// returnNoopFunc replaces return in template blocks where it must not stop the execution.
+// See tplimpl's partial decorator handling.
+func returnNoopFunc(args ...any) string {
+	return ""
+}
+
 func init() {
 	f := func(d *deps.Deps) *internal.TemplateFuncsNamespace {
 		ctx := New(d)
@@ -43,13 +64,19 @@ func init() {
 			[][2]string{},
 		)
 
-		// TODO(bep) we need the return to be a valid identifiers, but
-		// should consider another way of adding it.
-		ns.AddMethodMapping(func() string { return "" },
+		// return stops the execution of the current template. The optional
+		// argument is the value returned from a partial. This is implemented by
+		// returning a sentinel error that is trapped in the template execution.
+		ns.AddMethodMapping(returnFunc,
 			[]string{"return"},
 			[][2]string{},
 		)
 
+		ns.AddMethodMapping(returnNoopFunc,
+			[]string{"_returnNoop"},
+			[][2]string{},
+		)
+
 		return ns
 	}
 
