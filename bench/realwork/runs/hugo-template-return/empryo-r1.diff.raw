+// neutralizeReturn replaces any return keyword in n with a function that does nothing.
+// Blocks that wrap a partial decorator are also compiled to a partial of their own,
+// where return works as normal, so we do not descend into those.
+func (c *templateTransformContext) neutralizeReturn(n parse.Node) {
+	switch x := n.(type) {
+	case *parse.ListNode:
+		if x != nil {
+			for _, node := range x.Nodes {
+				c.neutralizeReturn(node)
+			}
+		}
+	case *parse.ActionNode:
+		c.neutralizeReturn(x.Pipe)
+	case *parse.IfNode:
+		c.neutralizeReturn(x.Pipe)
+		c.neutralizeReturn(x.List)
+		c.neutralizeReturn(x.ElseList)
+	case *parse.RangeNode:
+		c.neutralizeReturn(x.Pipe)
+		c.neutralizeReturn(x.List)
+		c.neutralizeReturn(x.ElseList)
+	case *parse.WithNode:
+		c.neutralizeReturn(x.Pipe)
+		if len(x.Pipe.Cmds) != 1 || !c.isWithPartial(x.Pipe.Cmds[0].Args) {
+			c.neutralizeReturn(x.List)
+		}
+		c.neutralizeReturn(x.ElseList)
+	case *parse.PipeNode:
+		if x != nil {
+			for _, cmd := range x.Cmds {
+				c.neutralizeReturn(cmd)
+			}
+		}
+	case *parse.CommandNode:
+		if x == nil || len(x.Args) == 0 {
+			return
+		}
+		if ident, ok := x.Args[0].(*parse.IdentifierNode); ok && ident.Ident == "return" {
+			ident.Ident = "_returnNoop"
+			if len(x.Args) > 2 {
+				// The shorthand form, {{ return add 1 2 }}, is handled by the template executor.
+				x.Args = x.Args[:1]
+				return
+			}
+		}
+		for _, arg := range x.Args {
+			if pn, ok := arg.(*parse.PipeNode); ok {
+				c.neutralizeReturn(pn)
+			}
+		}
 	}
-
-	c.returnNode = n
-	// Remove the "return" identifiers
-	c.returnNode.Args = c.returnNode.Args[1:]
-
-	return false
 }
