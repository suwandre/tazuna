diff --git a/tpl/partials/partials_integration_test.go b/tpl/partials/partials_integration_test.go
index 79a92f1..610a810 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,73 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarlyInTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+Before
+{{ if true }}
+{{ return }}
+{{ end }}
+After
+-- layouts/_partials/early.html --
+A
+{{ if . }}
+  {{ return "early" }}
+{{ end }}
+B
+{{ return "late" }}
+-- layouts/_partials/nested.html --
+{{ range . }}
+  {{ if eq . 2 }}
+    {{ return (printf "found %d" .) }}
+  {{ end }}
+{{ end }}
+{{ return "not found" }}
+-- layouts/_partials/bare.html --
+{{ return }}
+-- layouts/_partials/text.txt --
+{{ return "x" }}
+-- layouts/_partials/outputonly.html --
+<b>{{ . }}</b>
+-- layouts/page.html --
+Before
+{{ partial "early.html" true }}|{{ partial "early.html" false }}
+{{ partial "nested.html" (slice 1 2 3) }}|{{ partial "nested.html" (slice 1) }}
+bare:{{ with partial "bare.html" . }}NOT EMPTY{{ else }}EMPTY{{ end }}
+{{ "piped" | return }}
+After
+-- content/p1.md --
+---
+title: P1
+---
+`
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Before")
+	b.AssertFileContent("public/index.html", "! After")
+	b.AssertFileContent("public/p1/index.html", "Before", "early|late", "found 2|not found", "bare:EMPTY")
+	b.AssertFileContent("public/p1/index.html", "! piped", "! After")
+}
+
+// A return inside the block of a partial decorator that is run in place (the partial
+// does not call inner) must not stop the enclosing template.
+func TestReturnInDecoratorBlockNotCallingInner(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/_partials/noinner.html --
+{{ return "value" }}
+-- layouts/home.html --
+Start:{{ with partial "noinner.html" . }}{{ return . }}{{ end }}:End
+`
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Start::End")
+}
