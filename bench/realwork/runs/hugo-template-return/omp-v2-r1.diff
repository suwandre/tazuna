+
+func TestReturnEarlyInPartial(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+a: {{ partial "find.html" (slice 1 2 3) }}
+b: {{ partial "find.html" (slice 4 5 6) }}
+c: {{ partial "nilvalue.html" . | printf "%v" | safeHTML }}
+d: {{ partial "novalue.html" 0 }}|
+e: {{ partial "novalue.html" 1 }}|
+f: {{ partialCached "find.html" (slice 2 3) }}
+g: {{ partial "inline-define.html" . }}
+h: {{ partial "falsy.html" . | printf "%v" }}
+-- layouts/_partials/find.html --
+{{ range . }}
+  {{ if eq . 2 }}{{ return "found" }}{{ end }}
+{{ end }}
+{{ return "not found" }}
+-- layouts/_partials/nilvalue.html --
+{{ return nil }}
+-- layouts/_partials/novalue.html --
+{{ if eq . 0 }}{{ return }}{{ end }}
+rendered
+-- layouts/_partials/inline-define.html --
+{{ template "helper" . }}after helper
+{{ define "helper" }}in helper|{{ return }}not rendered{{ end }}
+-- layouts/_partials/falsy.html --
+{{ return 0 }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"a: found",
+		"b: not found",
+		"c: <nil>",
+		"d: |",
+		"e: \nrendered|",
+		"f: found",
+		"g: in helper|after helper",
+		"h: 0",
+	)
+}
+
+func TestReturnInRegularTemplate(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/baseof.html --
+<main>{{ block "main" . }}{{ end }}</main>
+-- layouts/home.html --
+{{ define "main" }}before{{ if true }}{{ return }}{{ end }}after{{ end }}
+-- layouts/section.html --
+top{{ return }}hidden
+-- content/s/_index.md --
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "<main>before</main>", "! after")
+	b.AssertFileContent("public/s/index.html", "top", "! hidden")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ return 1 2 }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "return takes at most one argument")
+}
+
+func TestReturnValueOutsidePartial(t *testing.T) {
+	t.Parallel()
+
+	for _, tt := range []struct{ name, layout string }{
+		{"top", `{{ return 1 }}`},
+		{"template", `{{ template "t" . }}{{ define "t" }}{{ return 1 }}{{ end }}`},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+` + tt.layout
+
+			b, err := hugolib.TestE(t, files)
+			b.Assert(err, qt.IsNotNil)
+			b.Assert(err.Error(), qt.Contains, "return with a value is only supported in partial templates")
+		})
+	}
+}
+
+func TestReturnNotLastInPipeline(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ return "even" | strings.ToUpper }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "return must be the last command in a pipeline")
+}
