+// ReturnError is the sentinel returned by the "return" keyword.
+// It ends the execution of the current template. Value is only meaningful if HasValue is set.
+type ReturnError struct {
+	Value    any
+	HasValue bool
+}
+
+func (e *ReturnError) Error() string {
+	return "return outside of template execution"
+}
+
+// ErrReturnValueNotInPartial is the error for a "return" with a value outside a partial template.
+var ErrReturnValueNotInPartial = errors.New("return with a value is only supported in partial templates")
+
+// walkReturnable walks the template body and consumes any "return" issued within it.
+func (s *state) walkReturnable(dot reflect.Value, root *parse.ListNode) {
+	defer func() {
+		if r := recover(); r != nil {
+			re, ok := r.(*ReturnError)
+			if !ok {
+				panic(r)
+			}
+			if re.HasValue {
+				s.errorf("%w", ErrReturnValueNotInPartial)
+			}
+		}
+	}()
+	s.walk(dot, root)
+}
+
