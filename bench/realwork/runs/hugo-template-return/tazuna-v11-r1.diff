+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "http://example.com/"
+-- layouts/home.html --
+Before
+{{ partial "early.html" 1 }}|{{ partial "early.html" 2 }}|{{ partial "early.html" 3 }}
+{{ partial "noval.html" . }}|{{ partial "inrange.html" (slice 1 2 3 4) }}
+{{ template "sub" . }}
+{{ partial "outer.html" . }}
+{{ if true }}{{ return }}{{ end }}
+NOTREACHED
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ with . }}{{ if eq . 2 }}{{ return (printf "two-%d" .) }}{{ end }}{{ end }}
+{{ return "other" }}
+-- layouts/_partials/noval.html --
+{{ return }}
+-- layouts/_partials/inrange.html --
+{{ range . }}{{ if eq . 3 }}{{ return . }}{{ end }}{{ end }}
+{{ return "none" }}
+-- layouts/_partials/outer.html --
+{{ $v := partial "early.html" 1 }}
+{{ return (printf "outer-%s" $v) }}
+{{ define "sub" }}sub-before{{ return }}sub-after{{ end }}
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"Before",
+		"one|two-2|other",
+		"\n|3\n",
+		"sub-before\nouter-one",
+		"! NOTREACHED",
+		"! sub-after",
+	)
+}
+
