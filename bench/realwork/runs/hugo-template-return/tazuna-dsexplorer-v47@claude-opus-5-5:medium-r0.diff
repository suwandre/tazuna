+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = "http://example.com/"
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- layouts/_partials/sign.tpl --
+{{ if lt . 0 }}{{ return "negative" }}{{ end }}
+{{ range seq 3 }}{{ if eq . 2 }}{{ return "zero-or-positive" }}{{ end }}{{ end }}
+{{ return "unreachable" }}
+-- layouts/_partials/novalue.html --
+before{{ if . }}{{ return }}{{ end }}after
+-- layouts/_partials/noreturn.html --
+<b>no return</b>
+-- layouts/_partials/try.tpl --
+{{ $x := try (return 42) }}{{ return "unreachable" }}
+-- layouts/_partials/cached.tpl --
+{{ return (dict "v" .) }}
+-- layouts/_partials/nested.tpl --
+{{ $a := partial "sign.tpl" -1 }}{{ template "inner" }}{{ return (printf "%s-%s" $a "outer") }}
+{{ define "inner" }}{{ return "inner" }}{{ end }}
+-- layouts/home.html --
+sign: {{ partial "sign.tpl" -5 }}|{{ partial "sign.tpl" 5 }}|
+novalue: {{ partial "novalue.html" true }}|{{ partial "novalue.html" false }}|
+noreturn: {{ partial "noreturn.html" }}|
+try: {{ partial "try.tpl" }}|
+cached: {{ (partialCached "cached.tpl" 32).v }}|{{ (partialCached "cached.tpl" 32).v }}|
+nested: {{ partial "nested.tpl" }}|
+{{ template "early" . }}after template|
+{{ if true }}{{ range seq 3 }}{{ with . }}{{ return }}{{ end }}{{ end }}{{ end }}
+Not rendered.
+{{ define "early" }}in template{{ return }}not rendered{{ end }}
+-- layouts/page.html --
+Page.{{ if not .Params.show }}{{ return }}{{ end }}
+Title: {{ .Title }}
+-- content/p1.md --
+---
+title: "P1"
+show: true
+---
+-- content/p2.md --
+---
+title: "P2"
+---
+`
+	b := Test(t, files)
+
+	b.AssertFileContent("public/index.html",
+		"sign: negative|zero-or-positive|",
+		"novalue: before|beforeafter|",
+		"noreturn: <b>no return</b>|",
+		"try: 42|",
+		"cached: 32|32|",
+		"nested: negative-outer|",
+		"in templateafter template|",
+		"! Not rendered",
+		"! not rendered",
+	)
+	b.AssertFileContent("public/p1/index.html", "Title: P1")
+	b.AssertFileContent("public/p2/index.html", "Page.", "! Title")
+}
