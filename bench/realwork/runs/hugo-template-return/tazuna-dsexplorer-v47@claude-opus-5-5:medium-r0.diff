+// ReturnError is returned from a template function to stop
+// execution of the current template.
+type ReturnError struct {
+	Value    any
+	HasValue bool
+}
+
+func (*ReturnError) Error() string {
+	return "return"
+}
+
+// ReturnValueSetter may be implemented by the writer passed to ExecuteWithContext
+// to receive the value of a top level return.
+type ReturnValueSetter interface {
+	SetReturnValue(v any)
+}
+
+func (s *state) recoverReturn(top bool) {
+	r := recover()
+	if r == nil {
+		return
+	}
+	ret, ok := r.(*ReturnError)
+	if !ok {
+		panic(r)
+	}
+	if top && ret.HasValue {
+		if w, ok := s.wr.(ReturnValueSetter); ok {
+			w.SetReturnValue(ret.Value)
+		}
+	}
+}
