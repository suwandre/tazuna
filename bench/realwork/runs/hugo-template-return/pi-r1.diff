index 79a92f1..9ea4522 100644
--- a/tpl/partials/partials_integration_test.go
+++ b/tpl/partials/partials_integration_test.go
@@ -335,3 +335,62 @@ BAR
 
 	b.AssertFileContent("public/index.html", "OO:BAR")
 }
+
+func TestReturnEarly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- content/p1.md --
+---
+title: P1
+---
+-- layouts/home.html --
+Home: {{ partial "early.html" 1 }}|{{ partial "early.html" 2 }}|{{ partial "early.html" 0 }}|{{ partial "dot.html" "x" }}|{{ partial "novalue.html" . }}|{{ partial "fallthrough.html" . }}
+{{ template "inner" . }}
+After inner
+{{ define "inner" }}
+Inner start
+{{ return }}
+Inner end
+{{ end }}
+-- layouts/page.html --
+Before
+{{ if .Title }}{{ return }}{{ end }}
+After
+-- layouts/_partials/early.html --
+{{ if eq . 1 }}{{ return "one" }}{{ end }}
+{{ if eq . 2 }}{{ return (slice "two") }}{{ end }}
+{{ return "other" }}
+-- layouts/_partials/dot.html --
+{{ range slice . }}{{ if eq . "x" }}{{ return (printf "%s-%s" . $) }}{{ end }}{{ end }}
+{{ return "not reached" }}
+-- layouts/_partials/novalue.html --
+Output.
+{{ if . }}{{ return }}{{ end }}
+Not reached.
+-- layouts/_partials/fallthrough.html --
+{{ if not . }}{{ return "x" }}{{ end }}
+`
+
+	b := hugolib.Test(t, files)
+
+	b.AssertFileContent("public/index.html", "Home: one|[two]|other|x-x||", "Inner start", "After inner", "! Inner end", "! Not reached")
+	b.AssertFileContentExact("public/p1/index.html", "Before\n")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+baseURL = 'http://example.com/'
+-- layouts/home.html --
+{{ return "a" "b" }}
+`
+
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "expected at most 1 argument")
+}
