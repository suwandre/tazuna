+// ReturnError is the sentinel error returned by the "return" template function.
+// It stops the execution of the current template, optionally with a value.
+type ReturnError struct {
+	Value any
+}
+
+func (e *ReturnError) Error() string {
+	return "return outside of template execution"
+}
+
+// recoverReturn stops a ReturnError panic from propagating further up.
+// It must be deferred directly.
+func recoverReturn() {
+	if r := recover(); r != nil {
+		if _, ok := r.(*ReturnError); !ok {
+			panic(r)
+		}
+	}
+}
