+
+func TestReturnInPage(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/home.html --
+Before.
+{{ if true }}{{ return }}{{ end }}
+After.
+`
+	b := hugolib.Test(t, files)
+	b.AssertFileContentExact("public/index.html", "Before.\n")
+}
+
+func TestReturnInPartial(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/_partials/early.html --
+{{ if . }}{{ return "early" }}{{ end }}
+{{ return "late" }}
+-- layouts/_partials/loop.html --
+{{ range . }}{{ if gt . 1 }}{{ return . }}{{ end }}{{ end }}
+{{ return "none" }}
+-- layouts/_partials/bare.html --
+Output.
+{{ if . }}{{ return }}{{ end }}
+Not reached.
+-- layouts/_partials/nil.html --
+{{ return nil }}
+-- layouts/_partials/pipe.html --
+{{ "piped" | return }}
+-- layouts/_partials/func.html --
+{{ if . }}{{ return add 1 2 }}{{ end }}
+{{ return 0 }}
+-- layouts/_partials/block.html --
+{{ block "inner" . }}{{ return "from block" }}{{ end }}
+{{ return "from partial" }}
+-- layouts/home.html --
+early: {{ partial "early.html" true }}
+late: {{ partial "early.html" false }}
+loop: {{ partial "loop.html" (slice 1 2 3) }}
+loopnone: {{ partial "loop.html" (slice 1) }}
+bare: {{ partial "bare.html" true | strings.TrimSpace }}
+nil: {{ partial "nil.html" . }}|
+pipe: {{ partial "pipe.html" . }}
+func: {{ partial "func.html" true }}
+block: {{ partial "block.html" . }}
+cached: {{ partialCached "early.html" true }}
+`
+	b := hugolib.Test(t, files)
+	b.AssertFileContent("public/index.html",
+		"early: early",
+		"late: late",
+		"loop: 2",
+		"loopnone: none",
+		"bare: Output.",
+		"nil: |",
+		"pipe: piped",
+		"func: 3",
+		"block: from partial",
+		"cached: early",
+	)
+}
+
+func TestReturnInTemplateCall(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/baseof.html --
+<main>{{ block "main" . }}{{ end }}</main>
+-- layouts/home.html --
+{{ define "main" }}
+A.
+{{ template "sub" . }}
+B.
+{{ if true }}{{ return }}{{ end }}
+C.
+{{ end }}
+{{ define "sub" }}
+S1.
+{{ return }}
+S2.
+{{ end }}
+`
+	b := hugolib.Test(t, files)
+	b.AssertFileContent("public/index.html", "A.", "S1.", "B.", "</main>")
+	b.AssertFileContentExact("public/index.html", "<main>\nA.\n\nS1.\n\nB.\n</main>")
+}
+
+func TestReturnTooManyArgs(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+-- layouts/home.html --
+{{ templates.Return 1 2 }}
+`
+	b, err := hugolib.TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, "return takes at most 1 argument, got 2")
+}
