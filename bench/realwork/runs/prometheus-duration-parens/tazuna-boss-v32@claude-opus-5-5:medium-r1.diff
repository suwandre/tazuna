diff --git a/promql/promqltest/testdata/duration_expression.test b/promql/promqltest/testdata/duration_expression.test
index d135d62..dbf92f3 100644
--- a/promql/promqltest/testdata/duration_expression.test
+++ b/promql/promqltest/testdata/duration_expression.test
@@ -249,3 +249,36 @@ load 1s
 # For an instant query (start == end), range() = 0s, offset 0s.
 eval instant at 50s metric1_total offset range()
 	metric1_total{} 50
+
+# Parenthesised plain literals evaluate the same as bare literals.
+clear
+
+load 1m
+	metric_paren 0+1x100
+
+# Offset: (5m) and 5m both look up the sample at 700s.
+eval instant at 1000s metric_paren offset 5m
+	metric_paren 11
+
+eval instant at 1000s metric_paren offset (5m)
+	metric_paren 11
+
+# Negative offset: (-5m) and -5m both look up the sample at 1300s.
+eval instant at 1000s metric_paren offset -5m
+	metric_paren 21
+
+eval instant at 1000s metric_paren offset -(5m)
+	metric_paren 21
+
+# Range: [(5m)] and [5m] both cover the samples from 720s to 960s.
+eval instant at 1000s sum_over_time(metric_paren[5m])
+	{} 70
+
+eval instant at 1000s sum_over_time(metric_paren[(5m)])
+	{} 70
+
+# Plain seconds literal in parentheses.
+eval instant at 1000s metric_paren offset (300)
+	metric_paren 11
+
+clear
