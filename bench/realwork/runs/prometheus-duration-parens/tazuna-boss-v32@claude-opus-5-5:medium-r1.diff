+	}
+}
+
+// constantDurationValue returns the value of a duration expression that is made
+// up only of number literals, parentheses and unary signs, such as 5, (5),
+// -(5) or +(-5). It reports false for any other expression.
+func constantDurationValue(node Node) (float64, bool) {
+	switch e := node.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil {
+			return 0, false
