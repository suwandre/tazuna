+// wrapNumberLiteral wraps a number literal that was parenthesised in a duration
+// expression into a Wrapped unary-plus *DurationExpr, so that the parentheses
+// survive a round trip through String().
+func wrapNumberLiteral(nl *NumberLiteral, start, end posrange.Pos) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: start,
+		EndPos:   end,
+	}
+}
+
+// durationNumberLiteral returns the number literal held by n, looking through
+// the wrapper created by wrapNumberLiteral.
+func durationNumberLiteral(n Node) (*NumberLiteral, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e, true
+	case *DurationExpr:
+		if e.Wrapped && e.Op == ADD && e.LHS == nil {
+			nl, ok := e.RHS.(*NumberLiteral)
+			return nl, ok
+		}
+	}
+	return nil, false
+}
+
