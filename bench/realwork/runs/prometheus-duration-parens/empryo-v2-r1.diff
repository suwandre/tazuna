+// wrapDurationLiteral represents a parenthesised duration literal as a unary
+// plus *DurationExpr with Wrapped set, so that the parentheses survive a
+// round-trip through String(). *NumberLiteral has no Wrapped field.
+func wrapDurationLiteral(nl *NumberLiteral, start posrange.Pos) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: start,
+	}
+}
+
+// constantDuration returns the value of a duration expression made only of
+// number literals and unary plus/minus, as produced for parenthesised literals.
+func constantDuration(n Node) (float64, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil || (e.Op != ADD && e.Op != SUB) {
+			return 0, false
+		}
+		v, ok := constantDuration(e.RHS)
+		if e.Op == SUB {
+			v = -v
+		}
+		return v, ok
+	}
+	return 0, false
+}
+
