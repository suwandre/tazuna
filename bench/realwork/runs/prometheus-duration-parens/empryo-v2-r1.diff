+package parser
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestParenthesisedDurationLiteralRoundTrip(t *testing.T) {
+	p := NewParser(Options{ExperimentalDurationExpr: true})
+	for in, want := range map[string]string{
+		"foo offset (5)":        "foo offset (5)",
+		"foo offset +(5)":       "foo offset (5)",
+		"foo offset -(5)":       "foo offset -(5)",
+		"foo offset (5m)":       "foo offset (5m)",
+		"foo[(5s)]":             "foo[(5s)]",
+		"foo[(5):(1)]":          "foo[(5):(1)]",
+		"(5)":                   "(5)",
+		"-(5)":                  "-(5)",
+		"foo offset (5m + 1m)":  "foo offset (5m + 1m)",
+		"foo offset -(5m + 1m)": "foo offset -(5m + 1m)",
+		"foo[(5s + 1s)]":        "foo[(5s + 1s)]",
+		"foo offset (5m) + 1":   "foo offset (5m) + 1",
+	} {
+		e, err := p.ParseExpr(in)
+		require.NoError(t, err, in)
+		require.Equal(t, want, e.String(), in)
+
+		// Printed form must be stable.
+		e2, err := p.ParseExpr(e.String())
+		require.NoError(t, err, in)
+		require.Equal(t, want, e2.String(), in)
+	}
+
+	for _, in := range []string{"foo[(0)]", "foo[-(5)]"} {
+		_, err := p.ParseExpr(in)
+		require.ErrorContains(t, err, "duration must be greater than 0", in)
+	}
+}
