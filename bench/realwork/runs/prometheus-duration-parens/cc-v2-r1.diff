+// wrapDurationLiteral wraps a number literal in a parenthesised *DurationExpr
+// (a unary plus), so that the parentheses survive in the AST. *NumberLiteral
+// has no Wrapped field and is otherwise reduced to a plain time.Duration.
+func wrapDurationLiteral(nl *NumberLiteral) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: nl.PosRange.Start,
+	}
+}
+
+// parenDurationExpr handles a parenthesised duration expression. It sets the
+// Wrapped flag on *DurationExpr nodes and wraps number literals into a
+// *DurationExpr, so that the parentheses are preserved.
+func (p *parser) parenDurationExpr(expr Node) Node {
+	switch e := expr.(type) {
+	case *DurationExpr:
+		e.Wrapped = true
+		return e
+	case *NumberLiteral:
+		return wrapDurationLiteral(e)
+	default:
+		return expr
+	}
+}
+
+// constantDuration returns the value in seconds of a duration expression that
+// consists only of a number literal, optionally wrapped in parentheses and
+// unary operators. The second return value is false for any other expression.
+func constantDuration(expr Node) (float64, bool) {
+	switch e := expr.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || (e.Op != ADD && e.Op != SUB) || e.RHS == nil {
+			return 0, false
+		}
+		v, ok := constantDuration(e.RHS)
+		if e.Op == SUB {
+			v = -v
+		}
+		return v, ok
+	default:
+		return 0, false
+	}
+}
