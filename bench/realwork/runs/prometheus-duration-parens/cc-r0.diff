 	switch e := expr.(type) {
 	case *DurationExpr:
@@ -1232,6 +1265,21 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 		}
 		return e
 	case *NumberLiteral:
+		if wrapped {
+			e.Wrapped = true
+		}
+		if e.Wrapped && op.Typ == SUB {
+			// Keep the sign outside of the parentheses, e.g. "-(5)".
+			if durationLiteralOutOfRange(-e.Val) {
+				p.addParseErrf(op.PositionRange(), "duration out of range")
+				return &NumberLiteral{Val: 0}
+			}
+			return &DurationExpr{
+				Op:       SUB,
+				RHS:      e,
+				StartPos: op.Pos,
