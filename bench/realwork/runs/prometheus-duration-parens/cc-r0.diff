@@ -1214,9 +1214,42 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// asDurationExpr converts a parenthesised *NumberLiteral into a *DurationExpr
+// so that the parentheses are preserved in fields which can only hold a
+// *DurationExpr (e.g. OriginalOffsetExpr or RangeExpr). Other nodes are
+// returned unchanged.
+func asDurationExpr(n Node) Node {
+	if nl, ok := n.(*NumberLiteral); ok && nl.Wrapped {
+		return &DurationExpr{Op: ADD, RHS: nl, StartPos: nl.PosRange.Start}
+	}
+	return n
+}
+
+// constantDurationValue returns the value in seconds of a number literal,
+// optionally with a unary sign applied, and false for any other node.
+func constantDurationValue(n Node) (float64, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || (e.Op != ADD && e.Op != SUB) {
+			return 0, false
+		}
+		nl, ok := e.RHS.(*NumberLiteral)
+		if !ok {
+			return 0, false
+		}
+		if e.Op == SUB {
+			return -nl.Val, true
+		}
+		return nl.Val, true
+	}
+	return 0, false
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
-// (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
+// (parenthesised form), the Wrapped flag is set on the node.
