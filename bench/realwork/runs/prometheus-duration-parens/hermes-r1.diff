+// wrapDurationLiteral wraps a number literal in a parenthesised unary-plus
+// *DurationExpr, so that the parentheses survive a round-trip through
+// Expr.String(). *NumberLiteral has no Wrapped field of its own.
+func wrapDurationLiteral(nl *NumberLiteral) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: nl.PosRange.Start,
+		EndPos:   nl.PosRange.End,
+	}
+}
+
+// constDurationSeconds returns the value in seconds of a *NumberLiteral, or of
+// a *DurationExpr that only consists of unary operators applied to a number
+// literal (i.e. the result of wrapDurationLiteral and negations thereof). The
+// boolean is false for any other node.
+func constDurationSeconds(n Node) (float64, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil || (e.Op != ADD && e.Op != SUB) {
+			return 0, false
+		}
+		v, ok := constDurationSeconds(e.RHS)
+		if e.Op == SUB {
+			v = -v
+		}
+		return v, ok
+	}
+	return 0, false
+}
+
+// durationFromNode returns the time.Duration of a *NumberLiteral or of a
+// constant *DurationExpr (see constDurationSeconds). The boolean is false if
+// the value is only known at evaluation time.
+func durationFromNode(n Node) (time.Duration, bool) {
+	v, ok := constDurationSeconds(n)
+	if !ok {
+		return 0, false
+	}
+	return time.Duration(math.Round(v * float64(time.Second))), true
+}
