+// wrapNumberLiteralInParens preserves parentheses around a plain number
+// literal in a duration expression. A *NumberLiteral has no Wrapped field, so
+// it is represented as a wrapped unary plus *DurationExpr, which prints (and
+// evaluates) as the literal itself. Other nodes are returned unchanged.
+func wrapNumberLiteralInParens(n Node, startPos posrange.Pos) Node {
+	nl, ok := n.(*NumberLiteral)
+	if !ok {
+		return n
+	}
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: startPos,
+	}
+}
+
+// parenthesizedNumberLiteral returns the number literal inside a node created
+// by wrapNumberLiteralInParens, if n is such a node.
+func parenthesizedNumberLiteral(n Node) (*NumberLiteral, bool) {
+	de, ok := n.(*DurationExpr)
+	if !ok || !de.Wrapped || de.Op != ADD || de.LHS != nil {
+		return nil, false
+	}
+	nl, ok := de.RHS.(*NumberLiteral)
+	return nl, ok
+}
+
