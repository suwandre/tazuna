+func TestDurationVisitorParenthesisedLiterals(t *testing.T) {
+	p := parser.NewParser(parser.Options{ExperimentalDurationExpr: true})
+
+	expr, err := p.ParseExpr(`rate(metric[(5m)] offset -(5))`)
+	require.NoError(t, err)
+	require.NoError(t, parser.Walk(&durationVisitor{}, expr, nil))
+
+	ms := expr.(*parser.Call).Args[0].(*parser.MatrixSelector)
+	require.Equal(t, 5*time.Minute, ms.Range)
+	require.Equal(t, -5*time.Second, ms.VectorSelector.(*parser.VectorSelector).OriginalOffset)
+	require.Equal(t, `rate(metric[(5m)] offset -(5))`, expr.String())
+}
