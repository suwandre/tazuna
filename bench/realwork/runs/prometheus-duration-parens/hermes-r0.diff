+// wrapNumberLiteral represents a parenthesised number literal in a duration
+// expression. As *NumberLiteral has no Wrapped field, the literal is held by a
+// wrapped unary plus *DurationExpr, which prints as "(literal)".
+func wrapNumberLiteral(nl *NumberLiteral, start posrange.Pos) *DurationExpr {
+	return &DurationExpr{Op: ADD, RHS: nl, Wrapped: true, StartPos: start}
+}
+
+// literalDurationValue returns the value in seconds of a duration expression
+// that only consists of a (possibly parenthesised or negated) number literal.
+func literalDurationValue(n Node) (float64, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil || (e.Op != ADD && e.Op != SUB) {
+			return 0, false
+		}
+		v, ok := literalDurationValue(e.RHS)
+		if e.Op == SUB {
+			v = -v
+		}
+		return v, ok
+	}
+	return 0, false
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
 // (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
