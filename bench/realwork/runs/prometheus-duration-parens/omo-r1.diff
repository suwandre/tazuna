+// durationExprFromNumberLiteral wraps a parenthesised number literal in a
+// unary-plus *DurationExpr so that its parentheses survive in a field that can
+// only hold a *DurationExpr. Any other node is returned unchanged.
+func durationExprFromNumberLiteral(n Node) Node {
+	if nl, ok := n.(*NumberLiteral); ok && nl.Wrapped {
+		return &DurationExpr{Op: ADD, RHS: nl, StartPos: nl.PosRange.Start}
+	}
+	return n
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
-// (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
+// (parenthesised form), the Wrapped flag is set on the node.
 func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) Node {
 	switch e := expr.(type) {
 	case *DurationExpr:
@@ -1232,6 +1242,21 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 		}
 		return e
 	case *NumberLiteral:
+		if wrapped {
+			e.Wrapped = true
+		}
+		if e.Wrapped {
+			// Keep the parentheses: a negated value would print as "(-5)".
+			if op.Typ == SUB {
+				return &DurationExpr{
+					Op:       SUB,
+					RHS:      e,
+					StartPos: op.Pos,
+				}
+			}
+			e.PosRange.Start = op.Pos
+			return e
+		}
