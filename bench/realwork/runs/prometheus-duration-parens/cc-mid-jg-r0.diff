+// wrapNumberLiteral represents a parenthesised *NumberLiteral as a unary plus
+// *DurationExpr with Wrapped set, since *NumberLiteral cannot record its
+// parentheses and they would otherwise be lost on round-trip.
+func wrapNumberLiteral(nl *NumberLiteral, start posrange.Pos) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: start,
+	}
+}
+
+// wrappedNumberLiteralValue returns the value of a node built by
+// wrapNumberLiteral, optionally negated by a unary minus.
+func wrappedNumberLiteralValue(n Node) (float64, bool) {
+	de, ok := n.(*DurationExpr)
+	if !ok {
+		return 0, false
+	}
+	if de.Op == SUB && de.LHS == nil {
+		val, ok := wrappedNumberLiteralValue(de.RHS)
+		return -val, ok
+	}
+	if de.Op != ADD || de.LHS != nil || !de.Wrapped {
+		return 0, false
+	}
+	nl, ok := de.RHS.(*NumberLiteral)
+	if !ok {
+		return 0, false
+	}
+	return nl.Val, true
+}
+
