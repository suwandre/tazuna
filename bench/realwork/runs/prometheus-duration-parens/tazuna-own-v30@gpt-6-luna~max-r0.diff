+func TestDurationVisitorParenthesizedLiterals(t *testing.T) {
+	p := parser.NewParser(parser.Options{ExperimentalDurationExpr: true})
+	tests := []struct {
+		query          string
+		expectedOffset time.Duration
+	}{
+		{query: "metric[(5)] offset (5)", expectedOffset: 5 * time.Second},
+		{query: "metric[(5)] offset +(5)", expectedOffset: 5 * time.Second},
+		{query: "metric[(5)] offset -(5)", expectedOffset: -5 * time.Second},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.query, func(t *testing.T) {
+			expr, err := p.ParseExpr(tt.query)
+			require.NoError(t, err)
+
+			err = parser.Walk(&durationVisitor{}, expr, nil)
+			require.NoError(t, err)
+
+			matrixSelector, ok := expr.(*parser.MatrixSelector)
+			require.True(t, ok)
+			require.Equal(t, 5*time.Second, matrixSelector.Range)
+			vectorSelector := matrixSelector.VectorSelector.(*parser.VectorSelector)
+			require.Equal(t, tt.expectedOffset, vectorSelector.OriginalOffset)
+		})
+	}
+}
