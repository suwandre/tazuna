+// wrapDurationExpr retains parentheses around a duration expression, representing
+// a number literal as a unary-positive expression when needed.
+func wrapDurationExpr(expr Expr) *DurationExpr {
+	switch e := expr.(type) {
+	case *DurationExpr:
+		e.Wrapped = true
+		return e
+	case *NumberLiteral:
+		e.Duration = true
+		return &DurationExpr{
+			Op:       ADD,
+			RHS:      e,
+			Wrapped:  true,
+			StartPos: e.PositionRange().Start,
+		}
+	default:
+		panic(fmt.Sprintf("unexpected duration expression type %T", expr))
+	}
+}
+
+// durationExprNumber returns the value of a literal or unary duration expression.
+func durationExprNumber(expr Expr) (float64, bool) {
+	switch e := expr.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil {
+			return 0, false
+		}
+		val, ok := durationExprNumber(e.RHS)
+		if !ok {
+			return 0, false
+		}
+		switch e.Op {
+		case ADD:
+			return val, true
+		case SUB:
+			return -val, true
+		}
+	}
+	return 0, false
+}
