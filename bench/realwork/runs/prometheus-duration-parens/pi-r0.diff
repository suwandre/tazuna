+// wrapDurationExpr marks a duration expression as wrapped in parentheses.
+// A plain *NumberLiteral has no Wrapped field, so it is represented as a
+// unary-plus *DurationExpr (which prints as its operand) with Wrapped set.
+// lparenPos is the position of the opening parenthesis.
+func wrapDurationExpr(e Expr, lparenPos posrange.Pos) Expr {
+	if nl, ok := e.(*NumberLiteral); ok {
+		return &DurationExpr{Op: ADD, RHS: nl, Wrapped: true, StartPos: lparenPos}
+	}
+	if de, ok := e.(*DurationExpr); ok {
+		de.Wrapped = true
+	}
+	return e
+}
+
+// constantDurationValue returns the value of n, in seconds, if it is a number
+// literal, possibly with unary operators and parentheses applied.
+func constantDurationValue(n Node) (float64, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil || (e.Op != ADD && e.Op != SUB) {
+			return 0, false
+		}
+		v, ok := constantDurationValue(e.RHS)
+		if e.Op == SUB {
+			v = -v
+		}
+		return v, ok
+	}
+	return 0, false
+}
