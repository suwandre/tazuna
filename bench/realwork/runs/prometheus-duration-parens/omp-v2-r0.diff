+// marker, so it is wrapped in a unary plus *DurationExpr.
+func wrapDurationExprInParens(open Item, expr Node) Node {
+	switch e := expr.(type) {
+	case *DurationExpr:
+		e.Wrapped = true
+		return e
+	case *NumberLiteral:
+		return &DurationExpr{
