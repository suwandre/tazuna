diff --git a/promql/parser/parse.go b/promql/parser/parse.go
index a56f16a..3b1d510 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1214,15 +1214,66 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapDurationExpr marks a duration expression node as wrapped in parentheses
+// so that the parentheses are preserved when the expression is printed. A
+// *NumberLiteral has no such flag, so it is wrapped in a unary positive
+// *DurationExpr with the Wrapped flag set. This is only done if experimental
+// duration expressions are enabled, as otherwise the literal must stay a
+// plain *NumberLiteral (e.g. for "foo offset -(5)").
+func (p *parser) wrapDurationExpr(expr Node) Node {
+	switch e := expr.(type) {
+	case *DurationExpr:
+		e.Wrapped = true
+		return e
+	case *NumberLiteral:
+		if !p.options.ExperimentalDurationExpr {
+			return e
+		}
+		return &DurationExpr{
+			Op:       ADD,
+			RHS:      e,
+			Wrapped:  true,
+			StartPos: e.PosRange.Start,
+		}
+	default:
+		return expr
+	}
+}
+
+// durationLiteralValue returns the value of a duration expression node if it
+// is a *NumberLiteral, optionally wrapped in parentheses and unary operators.
+// It reports false for any other node.
+func durationLiteralValue(expr Node) (float64, bool) {
+	switch e := expr.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil {
+			return 0, false
+		}
+		val, ok := durationLiteralValue(e.RHS)
+		if !ok {
+			return 0, false
+		}
+		switch e.Op {
+		case ADD:
+			return val, true
+		case SUB:
+			return -val, true
+		}
+	}
+	return 0, false
+}
+
