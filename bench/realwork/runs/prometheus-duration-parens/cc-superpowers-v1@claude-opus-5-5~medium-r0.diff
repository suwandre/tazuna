+// wrapDurationNumberLiteral returns a unary positive *DurationExpr with the
+// Wrapped flag set around a parenthesised number literal, so that the
+// parentheses are preserved when the expression is printed.
+func wrapDurationNumberLiteral(nl *NumberLiteral) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: nl.PosRange.Start,
+	}
+}
+
+// constantDurationValue returns the value of a duration expression if it is a
+// number literal, optionally wrapped in parentheses and unary operators.
+// Otherwise it returns false.
+func constantDurationValue(e Expr) (float64, bool) {
+	switch n := e.(type) {
+	case *NumberLiteral:
+		return n.Val, true
+	case *DurationExpr:
+		if n.LHS != nil || n.RHS == nil {
+			return 0, false
+		}
+		val, ok := constantDurationValue(n.RHS)
+		if !ok {
+			return 0, false
+		}
+		switch n.Op {
+		case ADD:
+			return val, true
+		case SUB:
+			return -val, true
+		}
+	}
+	return 0, false
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
