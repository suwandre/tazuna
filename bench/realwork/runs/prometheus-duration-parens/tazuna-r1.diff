+// wrapNumberLiteral wraps a number literal in a parenthesised *DurationExpr so
+// that the parentheses survive a round-trip through Expr.String(), as
+// *NumberLiteral has no way of recording them. The result is represented as a
+// unary plus applied to the literal; lparen is the position of the opening
+// parenthesis.
+func wrapNumberLiteral(nl *NumberLiteral, lparen posrange.Pos) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: lparen,
+	}
+}
+
+// unwrapNumberLiteral returns the number literal held by n, looking through
+// the wrapper created by wrapNumberLiteral. It returns false if n is not a
+// (possibly parenthesised) number literal.
+func unwrapNumberLiteral(n Node) (*NumberLiteral, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e, true
+	case *DurationExpr:
+		if e.Wrapped && e.Op == ADD && e.LHS == nil {
+			nl, ok := e.RHS.(*NumberLiteral)
+			return nl, ok
+		}
+	}
+	return nil, false
+}
+
