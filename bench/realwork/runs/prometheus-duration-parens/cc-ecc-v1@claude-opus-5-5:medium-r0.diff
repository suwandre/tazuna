@@ -1214,15 +1214,57 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapDurationExpr marks a duration expression node as wrapped in parentheses.
+// A *NumberLiteral has no Wrapped field, so it is wrapped in a unary ADD
+// *DurationExpr to preserve the parentheses when the expression is printed.
+func wrapDurationExpr(expr Node) Node {
+	switch e := expr.(type) {
+	case *DurationExpr:
+		e.Wrapped = true
+		return e
+	case *NumberLiteral:
+		return &DurationExpr{
+			Op:       ADD,
+			RHS:      e,
+			StartPos: e.PosRange.Start,
+			Wrapped:  true,
+		}
+	default:
+		return expr
+	}
+}
+
+// durationLiteralValue returns the value of a duration expression node that
+// is a number literal, optionally wrapped in parentheses and unary operators,
+// such as "5m", "(5m)" or "-(5m)". It reports false for any other node.
+func durationLiteralValue(expr Node) (float64, bool) {
+	switch e := expr.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil {
+			return 0, false
+		}
+		v, ok := durationLiteralValue(e.RHS)
+		switch e.Op {
+		case ADD:
+			return v, ok
+		case SUB:
+			return -v, ok
+		}
+	}
+	return 0, false
+}
+
