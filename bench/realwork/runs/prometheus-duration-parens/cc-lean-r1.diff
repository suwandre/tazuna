index a56f16a..be07927 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1214,6 +1214,18 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapNumberLiteral represents a parenthesised number literal in a duration
+// expression as a unary plus *DurationExpr with Wrapped set, so that the
+// parentheses survive a round-trip through String().
+func wrapNumberLiteral(nl *NumberLiteral, start posrange.Pos) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: start,
+	}
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
 // (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
@@ -1232,6 +1244,13 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 		}
 		return e
 	case *NumberLiteral:
+		if wrapped {
+			if durationLiteralOutOfRange(e.Val) {
+				p.addParseErrf(op.PositionRange(), "duration out of range")
+				return &NumberLiteral{Val: 0}
+			}
+			return p.applyUnaryOpToDurationExpr(op, wrapNumberLiteral(e, op.Pos), false)
+		}
 		if op.Typ == SUB {
 			e.Val *= -1
 		}
