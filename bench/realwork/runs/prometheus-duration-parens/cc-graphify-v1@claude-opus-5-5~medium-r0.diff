diff --git a/promql/parser/parse.go b/promql/parser/parse.go
index a56f16a..75435d0 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1214,6 +1214,47 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapDurationNumberLiteral wraps a *NumberLiteral that appears in parentheses
+// in a duration expression context into a parenthesised unary plus
+// *DurationExpr, so that the parentheses are preserved when the expression is
+// printed. lparen is the position of the opening parenthesis. Other nodes are
+// returned unchanged.
+func wrapDurationNumberLiteral(n Node, lparen posrange.Pos) Node {
+	nl, ok := n.(*NumberLiteral)
+	if !ok {
+		return n
+	}
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		StartPos: lparen,
+		Wrapped:  true,
+	}
+}
+
+// durationLiteralValue returns the value of a duration expression node if it is
+// a *NumberLiteral, optionally wrapped in parentheses and unary operators. It
+// is used to report errors for constant durations at parse time.
+func durationLiteralValue(n Node) (float64, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil || (e.Op != ADD && e.Op != SUB) {
+			return 0, false
+		}
+		val, ok := durationLiteralValue(e.RHS)
+		if !ok {
+			return 0, false
+		}
+		if e.Op == SUB {
+			val = -val
+		}
+		return val, true
+	}
+	return 0, false
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
 // (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
