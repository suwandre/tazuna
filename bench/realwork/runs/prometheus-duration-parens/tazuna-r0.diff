diff --git a/promql/parser/parse.go b/promql/parser/parse.go
index a56f16a..143dc4d 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1214,6 +1214,27 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// asDurationExpr returns the *DurationExpr form of a duration node. A
+// parenthesised *NumberLiteral is represented as a unary plus *DurationExpr
+// so that the parentheses are retained in the AST. It returns nil for any
+// other node type.
+func asDurationExpr(n Node) *DurationExpr {
+	switch e := n.(type) {
+	case *DurationExpr:
+		return e
+	case *NumberLiteral:
+		if e.Wrapped {
+			return &DurationExpr{
+				Op:       ADD,
+				RHS:      e,
+				StartPos: e.PosRange.Start,
+				EndPos:   e.PosRange.End,
+			}
+		}
+	}
+	return nil
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
 // (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
@@ -1232,6 +1253,20 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 		}
 		return e
 	case *NumberLiteral:
+		if wrapped || e.Wrapped {
+			// Keep the parenthesised literal intact so that the parentheses
+			// survive a round trip. A negation is kept as a separate node.
+			e.Wrapped = true
+			if op.Typ == SUB {
+				return &DurationExpr{
+					Op:       SUB,
+					RHS:      e,
+					StartPos: op.Pos,
+				}
+			}
+			e.PosRange.Start = op.Pos
+			return e
+		}
 		if op.Typ == SUB {
 			e.Val *= -1
 		}
