diff --git a/promql/parser/parse.go b/promql/parser/parse.go
index a56f16a..f5dc946 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1214,10 +1214,26 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapNumberLiteral wraps a parenthesised number literal in a unary-plus
+// *DurationExpr so that the parentheses survive a String() round-trip, as
+// *NumberLiteral has no Wrapped field.
+func wrapNumberLiteral(nl *NumberLiteral) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: nl.PosRange.Start,
+	}
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
-// (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
+// (parenthesised form), the Wrapped flag is set on *DurationExpr nodes and
+// *NumberLiteral nodes are wrapped in a *DurationExpr so the parentheses survive.
 func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) Node {
+	if nl, ok := expr.(*NumberLiteral); ok && wrapped {
+		expr = wrapNumberLiteral(nl)
+	}
 	switch e := expr.(type) {
 	case *DurationExpr:
 		if wrapped {
