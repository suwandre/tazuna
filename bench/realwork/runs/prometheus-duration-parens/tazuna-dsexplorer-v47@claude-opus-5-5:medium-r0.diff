+// wrapDurationLiteral wraps a parenthesised number literal in a duration
+// expression context into a unary '+' *DurationExpr with the Wrapped flag set,
+// so that the parentheses are preserved when the expression is printed.
+func wrapDurationLiteral(nl *NumberLiteral) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: nl.PosRange.Start,
+	}
+}
+
+// durationLiteralValue returns the value of a duration expression node that
+// consists only of a number literal, optionally wrapped in parentheses and
+// unary operators. It returns false for any other node.
+func durationLiteralValue(n Node) (float64, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil || (e.Op != ADD && e.Op != SUB) {
+			return 0, false
+		}
+		val, ok := durationLiteralValue(e.RHS)
+		if e.Op == SUB {
+			val = -val
+		}
+		return val, ok
+	default:
+		return 0, false
+	}
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
-// (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
