@@ -1214,6 +1214,18 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapDurationLiteral represents a parenthesised duration literal as a
+// wrapped unary plus *DurationExpr, since *NumberLiteral cannot record
+// parentheses.
+func wrapDurationLiteral(nl *NumberLiteral) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: nl.PosRange.Start,
+	}
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
 // (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
@@ -1232,6 +1244,19 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 		}
 		return e
 	case *NumberLiteral:
+		if wrapped {
+			// The literal was already range checked when it was parsed and
+			// negation cannot push it out of range.
+			w := wrapDurationLiteral(e)
+			if op.Typ == SUB {
+				return &DurationExpr{
+					Op:       SUB,
+					RHS:      w,
+					StartPos: op.Pos,
+				}
+			}
+			return w
+		}
 		if op.Typ == SUB {
 			e.Val *= -1
 		}
