diff --git a/promql/parser/parse.go b/promql/parser/parse.go
index a56f16a..b833208 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1239,6 +1239,30 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 			p.addParseErrf(op.PositionRange(), "duration out of range")
 			return &NumberLiteral{Val: 0}
 		}
+		if wrapped {
+			// A *NumberLiteral cannot record the parentheses, so wrap it in a
+			// unary plus *DurationExpr to preserve them on round-trip. The sign
+			// is kept outside the parentheses, as written.
+			if op.Typ == SUB {
+				e.Val *= -1
+			}
+			inner := &DurationExpr{
+				Op:       ADD,
+				RHS:      e,
+				Wrapped:  true,
+				StartPos: e.PosRange.Start,
+				EndPos:   e.PosRange.End,
+			}
+			p.experimentalDurationExpr(inner)
+			if op.Typ == SUB {
+				return &DurationExpr{
+					Op:       SUB,
+					RHS:      inner,
+					StartPos: op.Pos,
+				}
+			}
+			return inner
+		}
 		e.PosRange.Start = op.Pos
 		return e
 	default:
