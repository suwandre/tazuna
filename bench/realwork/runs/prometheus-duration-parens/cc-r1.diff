+	require.Equal(t, 5*time.Minute, ms.Range)
+	require.Equal(t, -5*time.Second, ms.VectorSelector.(*parser.VectorSelector).OriginalOffset)
+	require.Equal(t, `foo[(5m)] offset -(5)`, expr.String())
+}
