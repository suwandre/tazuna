+// wrapDurationExpr marks a duration expression node as parenthesised. A
+// *NumberLiteral has no Wrapped field, so it is first turned into a unary plus
+// *DurationExpr, which prints as the bare literal. startPos is the position of
+// the opening parenthesis.
+func wrapDurationExpr(expr Node, startPos posrange.Pos) Node {
+	switch e := expr.(type) {
+	case *DurationExpr:
+		e.Wrapped = true
+		return e
+	case *NumberLiteral:
+		return &DurationExpr{
+			Op:       ADD,
+			RHS:      e,
+			Wrapped:  true,
+			StartPos: startPos,
+		}
+	default:
+		return expr
+	}
+}
