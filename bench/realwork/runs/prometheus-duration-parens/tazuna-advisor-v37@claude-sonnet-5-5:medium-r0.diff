 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
 // (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
@@ -1232,6 +1277,19 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 		}
 		return e
 	case *NumberLiteral:
+		if wrapped {
+			// Keep the parentheses so that they survive a round trip.
+			inner := wrapDurationLiteral(e)
+			if op.Typ == SUB {
+				return &DurationExpr{
+					Op:       SUB,
+					RHS:      inner,
+					StartPos: op.Pos,
+				}
+			}
+			inner.StartPos = op.Pos
+			return inner
