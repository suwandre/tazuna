+// wrapDurationLiteral returns a parenthesised unary plus around a number
+// literal. A *NumberLiteral cannot carry a Wrapped flag, so this is how
+// parentheses around a plain duration are represented.
+func wrapDurationLiteral(n *NumberLiteral) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      n,
+		Wrapped:  true,
+		StartPos: n.PosRange.Start,
+	}
+}
+
+// wrapParenDuration marks a parenthesised duration expression as wrapped.
+func wrapParenDuration(e Node) Node {
+	switch e := e.(type) {
+	case *DurationExpr:
+		e.Wrapped = true
+		return e
+	case *NumberLiteral:
+		return wrapDurationLiteral(e)
+	default:
+		return e
+	}
+}
+
+// constantDurationValue returns the value of a duration expression consisting
+// only of a number literal with optional unary signs and parentheses.
+func constantDurationValue(e Node) (float64, bool) {
+	switch e := e.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || (e.Op != ADD && e.Op != SUB) {
+			return 0, false
+		}
+		v, ok := constantDurationValue(e.RHS)
+		if e.Op == SUB {
+			v = -v
+		}
+		return v, ok
+	default:
+		return 0, false
+	}
+}
+
