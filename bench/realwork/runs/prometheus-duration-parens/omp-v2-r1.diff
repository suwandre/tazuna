+// parentheses through Expr.String(). parenPos is the position of the opening
+// parenthesis.
+func wrapDurationExpr(e Expr, parenPos posrange.Pos) *DurationExpr {
+	if de, ok := e.(*DurationExpr); ok {
+		de.Wrapped = true
+		return de
+	}
+	return &DurationExpr{Op: ADD, RHS: e, Wrapped: true, StartPos: parenPos}
+}
+
+// constantDuration returns the value in seconds of a duration expression made
+// only of number literals and unary plus/minus, including parenthesised ones.
+// It reports false for any other expression.
