+// wrapDurationExpr marks a duration expression as wrapped in parentheses.
+// A *NumberLiteral has no Wrapped field, so it is represented as a wrapped unary
+// plus *DurationExpr, which preserves the parentheses when printing.
+func (p *parser) wrapDurationExpr(expr Node, start posrange.Pos) Node {
+	switch e := expr.(type) {
+	case *DurationExpr:
+		e.Wrapped = true
+		return e
+	case *NumberLiteral:
+		return &DurationExpr{Op: ADD, RHS: e, Wrapped: true, StartPos: start}
+	default:
+		return expr
+	}
+}
