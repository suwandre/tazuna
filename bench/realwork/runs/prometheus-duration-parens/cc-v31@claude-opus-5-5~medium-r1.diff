@@ -1214,15 +1214,61 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapDurationExpr marks a duration expression node as wrapped in parentheses.
+// A *NumberLiteral has no Wrapped field, so it is wrapped in a unary positive
+// *DurationExpr to preserve the parentheses when the expression is printed.
+func wrapDurationExpr(expr Node) Node {
+	switch e := expr.(type) {
+	case *DurationExpr:
+		e.Wrapped = true
+		return e
+	case *NumberLiteral:
+		return &DurationExpr{
+			Op:       ADD,
+			RHS:      e,
+			Wrapped:  true,
+			StartPos: e.PosRange.Start,
+		}
+	default:
+		return expr
+	}
+}
+
+// constantDurationValue returns the value of a duration expression node that
+// is a number literal, optionally wrapped in parentheses and unary operators,
+// e.g. "5", "(5)" or "-(5)". It allows the parser to validate such values the
+// same way as plain number literals.
+func constantDurationValue(expr Node) (float64, bool) {
+	switch e := expr.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil {
+			return 0, false
+		}
+		v, ok := constantDurationValue(e.RHS)
+		if !ok {
+			return 0, false
+		}
+		switch e.Op {
+		case ADD:
+			return v, true
+		case SUB:
+			return -v, true
+		}
+	}
+	return 0, false
+}
+
