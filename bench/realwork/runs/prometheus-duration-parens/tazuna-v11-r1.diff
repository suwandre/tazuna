 	}
 }
 
+// wrapParenthesisedDuration marks a parenthesised duration expression so that
+// the parentheses survive a round trip through Expr.String(). A
+// *NumberLiteral has no Wrapped field, so it is represented as a wrapped unary
+// plus *DurationExpr, which evaluates to the same value. Any other node is
+// returned as is, with Wrapped set for *DurationExpr nodes.
+func wrapParenthesisedDuration(expr Node, open, closing Item) Node {
+	switch e := expr.(type) {
+	case *DurationExpr:
+		e.Wrapped = true
+		return e
+	case *NumberLiteral:
+		return &DurationExpr{
+			Op:       ADD,
+			RHS:      e,
+			Wrapped:  true,
+			StartPos: open.Pos,
+			EndPos:   closing.PositionRange().End,
+		}
+	default:
+		return expr
+	}
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
-// (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
+// (parenthesised form), the Wrapped flag is set on *DurationExpr nodes, and
+// *NumberLiteral nodes are converted to a wrapped *DurationExpr so that the
+// parentheses are preserved.
 func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) Node {
 	switch e := expr.(type) {
 	case *DurationExpr:
@@ -1232,6 +1257,22 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 		}
 		return e
 	case *NumberLiteral:
+		if wrapped {
+			inner := &DurationExpr{
+				Op:       ADD,
+				RHS:      e,
+				Wrapped:  true,
+				StartPos: e.PosRange.Start,
+			}
+			if op.Typ == SUB {
+				return &DurationExpr{
+					Op:       SUB,
+					RHS:      inner,
+					StartPos: op.Pos,
+				}
+			}
+			return inner
+		}
 		if op.Typ == SUB {
