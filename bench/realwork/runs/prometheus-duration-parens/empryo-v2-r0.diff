+// constantDuration returns the value in seconds of n when it is a plain number
+// literal, possibly wrapped in parentheses and/or unary signs, and so needs no
+// evaluation.
+func constantDuration(n Node) (float64, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil {
+			return 0, false
+		}
+		v, ok := constantDuration(e.RHS)
+		if !ok {
+			return 0, false
+		}
+		switch e.Op {
+		case ADD:
+			return v, true
+		case SUB:
+			return -v, true
+		}
+	}
+	return 0, false
+}
+
+// wrapDurationLiteral turns a number literal into a unary-plus *DurationExpr
+// flagged as parenthesised, since *NumberLiteral cannot record its parentheses.
+func wrapDurationLiteral(nl *NumberLiteral, start posrange.Pos) *DurationExpr {
+	return &DurationExpr{Op: ADD, RHS: nl, Wrapped: true, StartPos: start}
+}
