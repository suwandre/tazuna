+// wrapDurationLiteral returns a parenthesised unary-plus *DurationExpr around
+// nl. A *NumberLiteral cannot carry the Wrapped flag, and the parser folds
+// plain literals into time.Duration fields, so this keeps the parentheses
+// around a literal visible in the AST and in Expr.String().
+func wrapDurationLiteral(nl *NumberLiteral) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: nl.PosRange.Start,
+	}
+}
+
+// isZeroDurationLiteral reports whether e is a zero *NumberLiteral, possibly
+// wrapped in parentheses by wrapDurationLiteral.
+func isZeroDurationLiteral(e Node) bool {
+	if de, ok := e.(*DurationExpr); ok && de.Wrapped && de.Op == ADD && de.LHS == nil {
+		e = de.RHS
+	}
+	nl, ok := e.(*NumberLiteral)
+	return ok && nl.Val == 0
+}
