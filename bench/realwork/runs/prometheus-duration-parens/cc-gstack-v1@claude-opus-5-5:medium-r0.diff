diff --git a/promql/parser/parse.go b/promql/parser/parse.go
index a56f16a..5775729 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1214,15 +1214,61 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapDurationExpr marks a duration expression node as wrapped in parentheses.
+// A *NumberLiteral cannot carry that information itself, so it is wrapped in a
+// unary positive *DurationExpr with the Wrapped flag set in order to preserve
+// the parentheses when the expression is printed.
+func wrapDurationExpr(expr Node) Node {
+	switch e := expr.(type) {
+	case *DurationExpr:
+		e.Wrapped = true
+		return e
+	case *NumberLiteral:
+		return &DurationExpr{
+			Op:       ADD,
+			RHS:      e,
+			StartPos: e.PosRange.Start,
+			Wrapped:  true,
+		}
+	default:
+		return expr
+	}
+}
+
+// constantDurationValue returns the value of a duration expression consisting
+// only of a number literal, optionally wrapped in parentheses and unary
+// operators. The second return value is false for any other expression.
+func constantDurationValue(expr Node) (float64, bool) {
+	switch e := expr.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil {
+			return 0, false
+		}
+		val, ok := constantDurationValue(e.RHS)
+		if !ok {
+			return 0, false
+		}
+		switch e.Op {
+		case ADD:
+			return val, true
+		case SUB:
+			return -val, true
+		}
+	}
+	return 0, false
+}
+
