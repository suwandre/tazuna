+// wrapNumberLiteral wraps a number literal in a parenthesised unary plus
+// duration expression. This lets a literal in parentheses, such as "(5)",
+// round-trip through String(), as NumberLiteral has no Wrapped flag.
+func wrapNumberLiteral(nl *NumberLiteral) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: nl.PosRange.Start,
+	}
+}
+
