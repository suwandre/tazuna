@@ -1214,15 +1214,51 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapDurationExpr marks a parenthesised duration expression as wrapped so
+// that its parentheses are preserved when printed. A *NumberLiteral has no
+// Wrapped field, so it is wrapped in a unary ADD *DurationExpr instead.
+func wrapDurationExpr(expr Node) Node {
+	switch e := expr.(type) {
+	case *DurationExpr:
+		e.Wrapped = true
+		return e
+	case *NumberLiteral:
+		return &DurationExpr{
+			Op:       ADD,
+			RHS:      e,
+			Wrapped:  true,
+			StartPos: e.PosRange.Start,
+		}
+	default:
+		return expr
+	}
+}
+
+// durationLiteral returns the number literal of a duration expression node
+// that is either a *NumberLiteral or a parenthesised *NumberLiteral as
+// produced by wrapDurationExpr.
+func durationLiteral(expr Node) (*NumberLiteral, bool) {
+	switch e := expr.(type) {
+	case *NumberLiteral:
+		return e, true
+	case *DurationExpr:
+		if e.Wrapped && e.Op == ADD && e.LHS == nil {
+			return durationLiteral(e.RHS)
+		}
+	}
+	return nil, false
+}
+
