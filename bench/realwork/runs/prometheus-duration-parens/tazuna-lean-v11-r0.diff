diff --git a/promql/parser/parse.go b/promql/parser/parse.go
index a56f16a..e8f1182 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1208,6 +1208,27 @@ func durationLiteralOutOfRange(val float64) bool {
 	return val > 1<<63/1e9 || val < -(1<<63)/1e9
 }
 
+// constantDurationValue returns the value of a duration expression that only
+// consists of a number literal with optional unary operators and parentheses.
+// The second return value is false for any other kind of expression.
+func constantDurationValue(expr Node) (float64, bool) {
+	switch e := expr.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || (e.Op != ADD && e.Op != SUB) || e.RHS == nil {
+			return 0, false
+		}
+		v, ok := constantDurationValue(e.RHS)
+		if e.Op == SUB {
+			v = -v
+		}
+		return v, ok
+	default:
+		return 0, false
+	}
+}
+
 func (p *parser) experimentalDurationExpr(e Expr) {
 	if !p.options.ExperimentalDurationExpr {
 		p.addParseErrf(e.PositionRange(), "experimental duration expression is not enabled")
@@ -1232,6 +1253,29 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 		}
 		return e
 	case *NumberLiteral:
+		if wrapped {
+			// Keep the parentheses around a plain literal by representing it
+			// as a wrapped unary plus, as a NumberLiteral cannot be wrapped.
+			if durationLiteralOutOfRange(e.Val) || (op.Typ == SUB && durationLiteralOutOfRange(-e.Val)) {
+				p.addParseErrf(op.PositionRange(), "duration out of range")
+				return &NumberLiteral{Val: 0}
+			}
+			inner := &DurationExpr{
+				Op:       ADD,
+				RHS:      e,
+				Wrapped:  true,
+				StartPos: e.PosRange.Start,
+			}
+			if op.Typ == SUB {
+				return &DurationExpr{
+					Op:       SUB,
+					RHS:      inner,
+					StartPos: op.Pos,
+				}
+			}
+			inner.StartPos = op.Pos
+			return inner
+		}
 		if op.Typ == SUB {
 			e.Val *= -1
 		}
