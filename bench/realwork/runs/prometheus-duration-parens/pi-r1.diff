diff --git a/promql/parser/parse.go b/promql/parser/parse.go
index a56f16a..82574fc 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1214,6 +1214,49 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapNumberLiteralInParens preserves the parentheses around a plain number
+// literal in a duration expression. As *NumberLiteral has no Wrapped field, the
+// literal is wrapped in a unary plus *DurationExpr with Wrapped set. Any other
+// node is returned unchanged. lparenPos is the position of the opening
+// parenthesis.
+func (*parser) wrapNumberLiteralInParens(n Node, lparenPos posrange.Pos) Node {
+	nl, ok := n.(*NumberLiteral)
+	if !ok {
+		return n
+	}
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: lparenPos,
+	}
+}
+
+// constantDurationValue returns the value of a duration expression that
+// consists only of a number literal, optionally wrapped in parentheses and
+// unary operators.
+func constantDurationValue(n Node) (float64, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil {
+			return 0, false
+		}
+		v, ok := constantDurationValue(e.RHS)
+		if !ok {
+			return 0, false
+		}
+		switch e.Op {
+		case ADD:
+			return v, true
+		case SUB:
+			return -v, true
+		}
+	}
+	return 0, false
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
 // (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
