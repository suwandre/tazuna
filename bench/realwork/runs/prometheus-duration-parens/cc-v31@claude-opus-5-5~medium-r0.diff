diff --git a/promql/parser/parse.go b/promql/parser/parse.go
index a56f16a..ef814e0 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1214,15 +1214,58 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapDurationExpr marks a duration expression as wrapped in parentheses so
+// that the parentheses are preserved when the expression is printed. A
+// *NumberLiteral has no Wrapped field, so it is wrapped in a unary ADD
+// *DurationExpr, which evaluates to the value of the literal.
+func wrapDurationExpr(e Expr) Expr {
+	switch n := e.(type) {
+	case *DurationExpr:
+		n.Wrapped = true
+		return n
+	case *NumberLiteral:
+		return &DurationExpr{
+			Op:       ADD,
+			RHS:      n,
+			Wrapped:  true,
+			StartPos: n.PosRange.Start,
+		}
+	default:
+		return e
+	}
+}
+
+// constDurationValue returns the value of a duration expression that consists
+// only of a number literal, optionally wrapped in parentheses and unary
+// operators. It returns false if the expression is not such a constant.
+func constDurationValue(e Expr) (float64, bool) {
+	switch n := e.(type) {
+	case *NumberLiteral:
+		return n.Val, true
+	case *DurationExpr:
+		if n.LHS != nil {
+			return 0, false
+		}
+		switch n.Op {
+		case ADD:
+			return constDurationValue(n.RHS)
+		case SUB:
+			val, ok := constDurationValue(n.RHS)
+			return -val, ok
+		}
+	}
+	return 0, false
+}
+
