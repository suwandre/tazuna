--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1214,6 +1214,40 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapDurationLiteral wraps a number literal that was enclosed in parentheses
+// in a unary plus *DurationExpr with the Wrapped flag set, so that the
+// parentheses are preserved by Expr.String(). The start position is the
+// position of the opening parenthesis (or of the unary operator).
+func wrapDurationLiteral(nl *NumberLiteral, start posrange.Pos) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: start,
+	}
+}
+
+// literalDurationValue returns the value in seconds of a duration expression
+// that consists only of a number literal, optionally wrapped in parentheses
+// and/or prefixed with unary operators. It reports false for any other
+// expression.
+func literalDurationValue(e Expr) (float64, bool) {
+	switch n := e.(type) {
+	case *NumberLiteral:
+		return n.Val, true
+	case *DurationExpr:
+		if n.LHS != nil || (n.Op != ADD && n.Op != SUB) || n.RHS == nil {
+			return 0, false
+		}
+		val, ok := literalDurationValue(n.RHS)
+		if n.Op == SUB {
+			val = -val
+		}
+		return val, ok
+	}
+	return 0, false
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
 // (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
@@ -1232,6 +1266,22 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 		}
 		return e
 	case *NumberLiteral:
+		if wrapped {
+			// Keep the literal as is and preserve the parentheses.
+			if durationLiteralOutOfRange(e.Val) {
+				p.addParseErrf(op.PositionRange(), "duration out of range")
+				return &NumberLiteral{Val: 0}
+			}
+			w := wrapDurationLiteral(e, op.Pos)
+			if op.Typ == SUB {
+				return &DurationExpr{
+					Op:       SUB,
+					RHS:      w,
+					StartPos: op.Pos,
+				}
+			}
+			return w
+		}
 		if op.Typ == SUB {
 			e.Val *= -1
 		}
