@@ -1214,13 +1214,53 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapParenNumberLiteral wraps a *NumberLiteral that was written inside
+// parentheses in a unary plus *DurationExpr with the Wrapped flag set. This
+// keeps the parentheses in the printed form, e.g. "foo offset (5)", which a
+// bare *NumberLiteral would lose. The unary plus evaluates to its operand and
+// is never printed on its own.
+func wrapParenNumberLiteral(nl *NumberLiteral, lparen, rparen Item) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: lparen.Pos,
+		EndPos:   rparen.Pos + 1,
+	}
+}
+
+// constantDurationValue returns the value in seconds of a duration expression
+// that is a plain number with optional unary operators and parentheses, such
+// as "5", "(5)" or "-(+(5))". It reports false for any other expression.
+func constantDurationValue(expr Expr) (float64, bool) {
+	switch e := expr.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil || (e.Op != ADD && e.Op != SUB) {
+			return 0, false
+		}
+		val, ok := constantDurationValue(e.RHS)
+		if e.Op == SUB {
+			val = -val
+		}
+		return val, ok
+	}
+	return 0, false
+}
+
