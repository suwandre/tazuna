diff --git a/promql/parser/parse.go b/promql/parser/parse.go
index a56f16a..0d7407b 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1214,6 +1214,19 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapNumberLiteral returns a parenthesised form of a plain number literal in a
+// duration expression position. As *NumberLiteral cannot carry the Wrapped
+// flag, it is represented as a unary plus *DurationExpr, which prints as just
+// its operand. start is the position of the opening parenthesis.
+func wrapNumberLiteral(nl *NumberLiteral, start posrange.Pos) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: start,
+	}
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
 // (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
@@ -1232,6 +1245,19 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 		}
 		return e
 	case *NumberLiteral:
+		if wrapped {
+			// A *NumberLiteral cannot carry the Wrapped flag, so keep the
+			// parentheses by using a wrapped *DurationExpr.
+			if durationLiteralOutOfRange(e.Val) {
+				p.addParseErrf(op.PositionRange(), "duration out of range")
+				return &NumberLiteral{Val: 0}
+			}
+			inner := wrapNumberLiteral(e, op.Pos)
+			if op.Typ == SUB {
+				return &DurationExpr{Op: SUB, RHS: inner, StartPos: op.Pos}
+			}
+			return inner
+		}
 		if op.Typ == SUB {
 			e.Val *= -1
 		}
