+// wrapNumberLiteral returns a unary ADD *DurationExpr with the Wrapped flag set
+// around a parenthesised number literal, so that the parentheses are preserved
+// when the expression is printed.
+func wrapNumberLiteral(nl *NumberLiteral) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: nl.PosRange.Start,
+	}
+}
+
+// durationLiteralValue returns the value in seconds of a duration expression
+// node that consists only of a number literal, optionally wrapped in
+// parentheses and unary operators. It returns false for any other node.
+func durationLiteralValue(n Node) (float64, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil {
+			return 0, false
+		}
+		val, ok := durationLiteralValue(e.RHS)
+		if !ok {
+			return 0, false
+		}
+		switch e.Op {
+		case ADD:
+			return val, true
+		case SUB:
+			return -val, true
+		}
+	}
+	return 0, false
+}
+
