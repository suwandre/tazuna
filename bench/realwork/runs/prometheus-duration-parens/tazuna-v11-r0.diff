index a56f16a..951ee1a 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1214,9 +1214,35 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// constantDuration returns the value in seconds of a duration expression node
+// consisting only of a number literal, possibly wrapped in parentheses and
+// unary operators. It returns false for any other node.
+func constantDuration(n Node) (float64, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil {
+			return 0, false
+		}
+		val, ok := constantDuration(e.RHS)
+		if !ok {
+			return 0, false
+		}
+		switch e.Op {
+		case ADD:
+			return val, true
+		case SUB:
+			return -val, true
+		}
+	}
+	return 0, false
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
-// (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
+// (parenthesised form), the Wrapped flag is set on *DurationExpr nodes and a
+// *NumberLiteral is wrapped in a parenthesised *DurationExpr.
 func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) Node {
 	switch e := expr.(type) {
 	case *DurationExpr:
@@ -1232,6 +1258,15 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 		}
 		return e
 	case *NumberLiteral:
+		if wrapped {
+			// Keep the parentheses around the number literal. The literal was
+			// already range checked when it was parsed.
+			inner := &DurationExpr{Op: ADD, RHS: e, Wrapped: true, StartPos: op.Pos}
+			if op.Typ == SUB {
+				return &DurationExpr{Op: SUB, RHS: inner, StartPos: op.Pos}
+			}
+			return inner
+		}
 		if op.Typ == SUB {
 			e.Val *= -1
 		}
