diff --git a/promql/parser/parse.go b/promql/parser/parse.go
index a56f16a..54ac1da 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1214,6 +1214,40 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// wrapNumberLiteral wraps a parenthesised number literal in a *DurationExpr
+// so that the parentheses survive in the AST and in Expr.String(). A
+// *NumberLiteral has no Wrapped field, and selectors store plain literals as a
+// time.Duration, which would drop the parentheses. The result is encoded as a
+// unary plus, which evaluates to the literal itself.
+func wrapNumberLiteral(lparen Item, nl *NumberLiteral) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: lparen.Pos,
+	}
+}
+
+// constantDurationValue returns the value of e if it consists only of unary
+// operators applied to a number literal, as produced for parenthesised
+// literals such as "(5)" or "-(5)".
+func constantDurationValue(e Expr) (float64, bool) {
+	switch n := e.(type) {
+	case *NumberLiteral:
+		return n.Val, true
+	case *DurationExpr:
+		if n.LHS != nil || n.RHS == nil || (n.Op != ADD && n.Op != SUB) {
+			return 0, false
+		}
+		v, ok := constantDurationValue(n.RHS)
+		if n.Op == SUB {
+			v = -v
+		}
+		return v, ok
+	}
+	return 0, false
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
 // (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
