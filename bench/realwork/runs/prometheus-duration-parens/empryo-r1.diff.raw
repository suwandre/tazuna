diff --git a/promql/parser/generated_parser.y b/promql/parser/generated_parser.y
index da9bc93..bebddab 100644
--- a/promql/parser/generated_parser.y
+++ b/promql/parser/generated_parser.y
@@ -1402,6 +1402,10 @@ paren_duration_expr : LEFT_PAREN duration_expr RIGHT_PAREN
                                 $$ = durationExpr
                                 break
                             }
+                            if nl, ok := $2.(*NumberLiteral); ok {
+                                $$ = wrapDurationLiteral(nl)
+                                break
+                            }
                             $$ = $2
                         }
                 ;
diff --git a/promql/parser/generated_parser.y.go b/promql/parser/generated_parser.y.go
index 846d830..e9b8281 100644
--- a/promql/parser/generated_parser.y.go
+++ b/promql/parser/generated_parser.y.go
@@ -2546,6 +2546,10 @@ yydefault:
 				yyVAL.node = durationExpr
 				break
 			}
+			if nl, ok := yyDollar[2].node.(*NumberLiteral); ok {
+				yyVAL.node = wrapDurationLiteral(nl)
+				break
+			}
 			yyVAL.node = yyDollar[2].node
 		}
 	}
diff --git a/promql/parser/parse.go b/promql/parser/parse.go
index a56f16a..2a92fbf 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1232,6 +1232,24 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 		}
 		return e
 	case *NumberLiteral:
+		if wrapped {
+			// A NumberLiteral cannot carry parentheses, so represent the
+			// wrapped literal as a *DurationExpr to keep them on round-trip.
+			if durationLiteralOutOfRange(e.Val) {
+				p.addParseErrf(op.PositionRange(), "duration out of range")
+				return &NumberLiteral{Val: 0}
+			}
+			de := wrapDurationLiteral(e)
+			if op.Typ == SUB {
+				return &DurationExpr{
+					Op:       SUB,
+					RHS:      de,
+					StartPos: op.Pos,
+				}
+			}
+			de.StartPos = op.Pos
+			return de
+		}
 		if op.Typ == SUB {
 			e.Val *= -1
 		}
@@ -1247,6 +1265,17 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 	}
 }
 
+// wrapDurationLiteral represents a parenthesised duration literal as a
+// wrapped unary-plus *DurationExpr, since *NumberLiteral has no Wrapped field.
+func wrapDurationLiteral(nl *NumberLiteral) *DurationExpr {
+	return &DurationExpr{
+		Op:       ADD,
+		RHS:      nl,
+		Wrapped:  true,
+		StartPos: nl.PosRange.Start,
+	}
+}
+
