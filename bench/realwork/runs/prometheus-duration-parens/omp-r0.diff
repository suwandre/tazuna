diff --git a/promql/parser/parse.go b/promql/parser/parse.go
index a56f16a..6af16c7 100644
--- a/promql/parser/parse.go
+++ b/promql/parser/parse.go
@@ -1214,6 +1214,25 @@ func (p *parser) experimentalDurationExpr(e Expr) {
 	}
 }
 
+// constantDurationValue returns the value in seconds of n if it is a number
+// literal, optionally wrapped in parentheses and/or unary operators.
+func constantDurationValue(n Node) (float64, bool) {
+	switch e := n.(type) {
+	case *NumberLiteral:
+		return e.Val, true
+	case *DurationExpr:
+		if e.LHS != nil || e.RHS == nil || (e.Op != ADD && e.Op != SUB) {
+			return 0, false
+		}
+		v, ok := constantDurationValue(e.RHS)
+		if e.Op == SUB {
+			v = -v
+		}
+		return v, ok
+	}
+	return 0, false
+}
+
 // applyUnaryOpToDurationExpr applies a unary operator to a duration expression
 // node, which may be a *DurationExpr or a *NumberLiteral. When wrapped is true
 // (parenthesised form), the Wrapped flag is set on *DurationExpr nodes.
@@ -1232,6 +1251,11 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
 		}
 		return e
 	case *NumberLiteral:
+		if wrapped {
+			// Keep the parentheses around a plain literal by wrapping it in a
+			// unary plus, then apply the operator on top.
+			return p.applyUnaryOpToDurationExpr(op, &DurationExpr{Op: ADD, RHS: e, Wrapped: true, StartPos: op.Pos}, false)
+		}
 		if op.Typ == SUB {
 			e.Val *= -1
 		}
