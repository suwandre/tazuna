{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tazuna",
  "version": "0.1.99",
  "identifier": "dev.tazuna.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run sidecar && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tazuna",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' tzplugin: http://tzplugin.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src tzwidget: http://tzwidget.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tazuna"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzMzc2NUU4MEI0RTlEMTIKUldRU25VNEw2R1UzZ3hRL1U3MFRDSmpGTE1CRXlxRUFSOG40NkNUS25YdUdQeHdWL0ZYZmh4U1QK",
      "endpoints": [
        "https://github.com/suwandre/tazuna/releases/download/desktop-latest/latest.json"
      ]
    }
  }
}
